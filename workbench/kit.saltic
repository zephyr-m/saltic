-- kit — общее у проверок workbench на Saltic (same, same-source, hosts):
-- строка со временем, запуск через bash, файлы по байтам, сортировка.
--
-- line(zone, text) — напечатать "[ЧЧ:ММ:СС] text"; zone — io.clock.zone()
-- shell(script, args, folder) -> код выхода `bash -c script args…`
--     (args — $0, $1…; stdout ребёнка — в трубу и пропадает, stderr — общий)
-- exists(path) -> yes/no; size(path) -> байты, 0 — нет файла
-- same_file(left, right) -> yes, если оба есть и совпадают побайтово
-- first_difference(left, right) -> номер первого другого байта (с 1)
-- tail(path, count) -> последние count строк файла без строк "warning…"
-- sorted(items) -> строки по возрастанию байтов; before(left, right) -> yes/no
-- base_name(path) -> имя файла без папки и ".saltic"
-- seconds_since(start) -> "41.5": секунды с start (time.now()), до десятых;
--     tenths_since(start) -> 415 — то же числом десятых
-- number_after(text, prefix) -> число (текстом, с точкой) сразу за prefix в
--     первой строке, где он есть; "" — нигде
-- remembered(store, value) -> что лежало в файле store (нет — value), value записан
-- shelf_size() -> байты компилятора с полки (bootstrap/names.sh), 0 — нет

use io
use io.file
use core.str
use core.time
use core.group
use core.bytes
use core.process

skill line(zone, text) {
    @shown_1 = time.text(time.now() + zone)
    io.show("[{shown_1}] {text}")
    out none
}

skill shell(script, args, folder) {
    @done = process.capture(group.concat(["bash", "-c", script], args), folder, [])
    out done.code
}

skill exists(path) {
    @buffer = file.read_bytes(path) rescue |err| { out no }
    out yes
}

skill size(path) {
    @buffer = file.read_bytes(path) rescue |err| { out 0 }
    out bytes.count(buffer)
}

skill same_file(left, right) {
    @a = file.read_bytes(left) rescue |err| { out no }
    @b = file.read_bytes(right) rescue |err| { out no }
    ((bytes.count(a) == bytes.count(b)) == no) { out no }
    drum (bytes.count(a)) {
        ((bytes.get(a, beat) == bytes.get(b, beat)) == no) { out no }
    }
    out yes
}

skill first_difference(left, right) {
    @a = file.read_bytes(left)
    @b = file.read_bytes(right)
    @count = bytes.count(a)
    (bytes.count(b) < count) { count = bytes.count(b) }
    drum (count) {
        ((bytes.get(a, beat) == bytes.get(b, beat)) == no) { out beat + 1 }
    }
    out count + 1
}

skill tail(path, count) {
    @text = file.read(path) rescue |err| { out [] }
    @kept = []
    drum (str.lines(text)) {
        (str.starts_with(beat, "warning") == no) { kept = group.add(kept, beat) }
    }
    @start = group.count(kept) - count
    (start < 0) { start = 0 }
    out group.slice(kept, start, group.count(kept))
}

skill before(left, right) {
    @shorter = str.bytes(left)
    (str.bytes(right) < shorter) { shorter = str.bytes(right) }
    drum (shorter) {
        @a = str.byte(left, beat)
        @b = str.byte(right, beat)
        (a < b) { out yes }
        (a > b) { out no }
    }
    out str.bytes(left) < str.bytes(right)
}

skill sorted(items) {
    @result = []
    drum (items) {
        @item = beat
        @placed = []
        @put = no
        drum (result) {
            (put == no) {
                (before(item, beat) == yes) {
                    placed = group.add(placed, item)
                    put = yes
                }
            }
            placed = group.add(placed, beat)
        }
        (put == no) { placed = group.add(placed, item) }
        result = placed
    }
    out result
}

skill base_name(path) {
    @start = 0
    drum (str.bytes(path)) {
        (str.get(path, beat) == "/") { start = beat + 1 }
    }
    @end = str.bytes(path)
    (str.ends_with(path, ".saltic") == yes) { end = end - 7 }
    out str.slice(path, start, end)
}

skill seconds_since(start) {
    @spent = time.now() - start
    (spent < 0) { spent = spent + time.DAY_MILLISECONDS }
    @tenths = (spent + 50) / 100
    @whole = tenths / 10
    @part = tenths - whole * 10
    out "{whole}.{part}"
}

skill number_after(text, prefix) {
    drum (str.lines(text)) {
        @line = beat
        @at = 0 - 1
        @room = str.bytes(line) - str.bytes(prefix) + 1
        (room < 0) { room = 0 }
        drum (room) {
            (at < 0) {
                (str.starts_at(line, prefix, beat) == yes) { at = beat + str.bytes(prefix) }
            }
        }
        (at >= 0) {
            @end = at
            always {
                (end == str.bytes(line)) { leave }
                @ch = str.get(line, end)
                @digit = str.is_digit(ch)
                (ch == ".") { digit = yes }
                (digit == no) { leave }
                end = end + 1
            }
            out str.slice(line, at, end)
        }
    }
    out ""
}

skill remembered(store, value) {
    @last = file.read(store) rescue |err| { "" }
    @previous = str.lines(last)
    file.write(store, "{value}\n")
    (group.count(previous) == 0) { out value }
    out group.get(previous, 0)
}

skill shelf_size() {
    @found = process.capture(["bash", "-c", "source bootstrap/names.sh && saltic_bootstrap_compiler"], "", [])
    @lines = str.lines(found.output)
    (group.count(lines) == 0) { out 0 }
    out size(group.get(lines, 0))
}

skill tenths_since(start) {
    @spent = time.now() - start
    (spent < 0) { spent = spent + time.DAY_MILLISECONDS }
    out (spent + 50) / 100
}
