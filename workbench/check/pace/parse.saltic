-- parse — замер разбора для workbench/check/pace: читает файл и разбирает его
-- ROUNDS раз подряд с местами узлов, как toolchain; печатает число узлов, чтобы
-- разбор нельзя было выбросить.
--
-- program(path) -> none; ROUNDS

use io
use io.file
use core.group
use selfhost.parser.syntax

ROUNDS = 20

program(path) {
    @source = file.read(path)
    @total = 0
    drum (ROUNDS) {
        @parsed = syntax.parse_string_loc(source, path)
        total = total + group.count(parsed.ast)
    }
    io.show("разбор: узлов {total}")
    out none
}
