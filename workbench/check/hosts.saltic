-- hosts — какие ветки global-check идут в этот раз: родного хоста или чужих
-- (под QEMU). Чужие — при SALTIC_FOREIGN=1 (`just hosts`, перед релизом),
-- иначе родные (`just global-check`); решение автора 22.11.2026.
--
-- foreign_mode() -> yes, если просили чужие хосты
-- foreign_tests(host, suites) -> yes, если набор тестов — чужого хоста: не
--     x86_64 или программы под чужие процессоры (cross) на нём
-- chosen(branches) -> ветки, у которых foreign совпадает с foreign_mode()

use core.group
use core.process

skill foreign_mode() {
    drum (process.environment()) {
        (beat == "SALTIC_FOREIGN=1") { out yes }
    }
    out no
}

skill foreign_tests(host, suites) {
    (suites == "cross") { out yes }
    out ((host == "x86_64") == no)
}

skill chosen(branches) {
    @wanted = foreign_mode()
    @picked = []
    drum (branches) {
        (beat.foreign == wanted) { picked = group.add(picked, beat) }
    }
    out picked
}
