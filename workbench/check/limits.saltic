-- limits — лимиты канона архитектуры (docs/process/Code_Architecture_канон_для_агентов.md):
-- не больше LIMIT_CODE строк кода в рукописном .saltic (пустые и `--` не в
-- счёт) и не больше LIMIT_HEADER строк шапки (всё до первой строки кода); шапка —
-- мягко: длинная печатается предупреждением и не роняет проверку.
-- Смотрит файлы из git (git ls-files), кроме .archive/ и папок generated/.
-- Известные нарушения — в KNOWN («путь строк_кода строк_шапки», правит
-- автор): им можно не расти, но не ухудшаться. Новое или выросшее — ошибка
-- LimitsBroken (код 1). Вместо workbench/limits.sh (в .archive/); вызывается
-- `just limits` и global-check.
-- Немота запрещена (закон автора 16.11.2026): вывод программы в никуда — путь
-- MUTE в .saltic, justfile, скриптах .sh и workflows — ошибка Muted (код 1),
-- без исключений и без KNOWN. Вывод — в журнал-файл или на экран.
-- Столбиком (решения автора 19.11.2026): литерал Box с полями, тело цикла и
-- out — на своих строках; известные — в limits-columns.txt (limits/columns).
--
-- Tally { checked, old, new, grown, long, mute } — итог; long — длинных шапок,
--     mute — файлов с немотой; замер и сверка — limits/canon
-- program() — проверить все файлы, напечатать нарушения и итог
-- Внутри: check(tally, known, rows, path); silent(tally, path) — поиск немоты

use io
use io.file
use core.str
use core.group
use core.process
use workbench.check.limits.canon
use workbench.check.limits.columns

Tally = Box {
    checked = 0,
    old = 0,
    new = 0,
    grown = 0,
    long = 0,
    mute = 0
}

MUTE = str.concat("/dev/", "null")
SCRIPTS = ["justfile", "*.sh", ".github/workflows/*.yml"]

skill silent(tally, path) {
    @lines = str.lines(file.read(path))
    @found = no
    drum (group.count(lines)) {
        (str.contains(group.get(lines, beat), MUTE) == yes) {
            @number = beat + 1
            io.show("немота: {path}:{number} — вывод в никуда; пиши в журнал или на экран")
            found = yes
        }
    }
    (found == yes) { tally.mute = tally.mute + 1 }
    out none
}

skill check(tally, known, rows, path) {
    tally.checked = tally.checked + 1
    @text = file.read(path)
    @flat = rows.verdict(path, text)
    (str.starts_with(flat, "новое") == yes) {
        io.show("лимиты канона: {path} — {flat}")
        tally.new = tally.new + 1
    }
    (str.starts_with(flat, "выросло") == yes) {
        io.show("лимиты канона: {path} — {flat}")
        tally.grown = tally.grown + 1
    }
    @note = canon.header_note(text)
    (str.bytes(note) > 0) {
        io.show("лимиты канона: {path} — {note}, предупреждение")
        tally.long = tally.long + 1
    }
    @said = canon.verdict(path, text, known)
    (str.starts_with(said, "новое") == yes) {
        io.show("лимиты канона: {path} — {said}")
        tally.new = tally.new + 1
        out none
    }
    (str.starts_with(said, "выросло") == yes) {
        io.show("лимиты канона: {path} — {said}")
        tally.grown = tally.grown + 1
        out none
    }
    @size = canon.measure(text)
    (size.code > canon.LIMIT_CODE) { tally.old = tally.old + 1 }
    out none
}

program() {
    io.show("лимиты канона: код до {canon.LIMIT_CODE} строк, шапка до {canon.LIMIT_HEADER} строк (мягко)")
    @known = canon.known()
    @rows = Columns {}
    rows.load()
    @listed = process.capture(["git", "ls-files", "*.saltic"], "", [])
    @tally = Tally {}
    drum (str.lines(listed.output)) {
        @path = beat
        @skip = str.starts_with(path, ".archive/")
        (str.contains(path, "/generated/") == yes) { skip = yes }
        (skip == no) {
            check(tally, known, rows, path)
            silent(tally, path)
        }
    }
    @scripts = process.capture(group.concat(["git", "ls-files"], SCRIPTS), "", [])
    drum (str.lines(scripts.output)) {
        (str.starts_with(beat, ".archive/") == no) { silent(tally, beat) }
    }
    io.show("лимиты канона: файлов {tally.checked}, известных нарушений {tally.old}, новых {tally.new}, выросших {tally.grown}, длинных шапок {tally.long}, с немотой {tally.mute}")
    (tally.new > 0) { out error.LimitsBroken }
    (tally.grown > 0) { out error.LimitsBroken }
    (tally.mute > 0) { out error.Muted }
    out none
}
