-- limits — лимиты канона архитектуры (docs/process/Code_Architecture_канон_для_агентов.md):
-- не больше LIMIT_CODE строк кода в рукописном .saltic (пустые и `--` не в
-- счёт) и не больше LIMIT_HEADER строк шапки (всё до первой строки кода).
-- Смотрит файлы из git (git ls-files), кроме .archive/ и папок generated/.
-- Известные нарушения — в KNOWN («путь строк_кода строк_шапки», правит
-- автор): им можно не расти, но не ухудшаться. Новое или выросшее — ошибка
-- LimitsBroken (код 1). Вместо workbench/limits.sh (в .archive/); вызывается
-- `just limits` и global-check.
--
-- Tally { checked, old, new, grown } — итог; замер и сверка — limits/canon
-- program() — проверить все файлы, напечатать нарушения и итог
-- Внутри: check(tally, known, path)

use io
use io.file
use core.str
use core.group
use core.process
use workbench.check.limits.canon

Tally = Box {
    checked = 0,
    old = 0,
    new = 0,
    grown = 0
}

skill check(tally, known, path) {
    tally.checked = tally.checked + 1
    @said = canon.verdict(path, file.read(path), known)
    (str.starts_with(said, "новое") == yes) {
        io.show("лимиты канона: {path} — {said}")
        tally.new = tally.new + 1
        out none
    }
    (str.starts_with(said, "выросло") == yes) {
        io.show("лимиты канона: {path} — {said}")
        tally.grown = tally.grown + 1
        out none
    }
    @size = canon.measure(file.read(path))
    (size.code > canon.LIMIT_CODE) { tally.old = tally.old + 1 }
    ((size.code > canon.LIMIT_CODE) == no) {
        (size.header > canon.LIMIT_HEADER) { tally.old = tally.old + 1 }
    }
    out none
}

program() {
    io.show("лимиты канона: код до {canon.LIMIT_CODE} строк, шапка до {canon.LIMIT_HEADER} строк")
    @known = canon.known()
    @listed = process.capture(["git", "ls-files", "*.saltic"], "", [])
    @tally = Tally {}
    drum (str.lines(listed.output)) {
        @path = beat
        @skip = str.starts_with(path, ".archive/")
        (str.contains(path, "/generated/") == yes) { skip = yes }
        (skip == no) { check(tally, known, path) }
    }
    io.show("лимиты канона: файлов {tally.checked}, известных нарушений {tally.old}, новых {tally.new}, выросших {tally.grown}")
    (tally.new > 0) { out error.LimitsBroken }
    (tally.grown > 0) { out error.LimitsBroken }
    out none
}
