-- stamp — время в начале каждой строки вывода команды: обёртка для чужих
-- программ (bootstrap/stamp.sh, что звал её из bash-скриптов, — в .archive/).
-- Команда — одна строка для bash -c (2>&1 дописывает вызывающий). Строки читаются
-- на лету (core.process.lines), время — местное (пояс io.clock читается раз).
-- Код выхода: 0 — команда прошла; иначе — ошибка StampedFailed (код 1).
--
-- program(command) — запустить, напечатать "[ЧЧ:ММ:СС] строка"

use io
use io.clock
use core.time
use core.process

Reading = Box {
    ended = no
}

program(command) {
    @feed = process.lines(["bash", "-c", command], "", [])
    @reading = Reading {}
    @zone = clock.zone()
    always {
        @line = feed.next() rescue |err| {
            reading.ended = yes
            ""
        }
        (reading.ended == yes) { leave }
        @shown_1 = time.text(time.now() + zone)
        io.show("[{shown_1}] {line}")
    }
    (feed.code() == 0) { out none }
    out error.StampedFailed
}
