-- stamp — время в начале каждой строки вывода наших скриптов (вместо цикла
-- read в bootstrap/stamp.sh; тот собирает stamp и зовёт его, а без часов в
-- компиляторе полки остаётся при своём цикле). Команда — одна строка для
-- bash -c (stamp.sh сам кавычит аргументы и дописывает 2>&1). Строки читаются
-- на лету (core.process.lines), время — местное (пояс io.clock читается раз).
-- Код выхода: 0 — команда прошла; иначе — ошибка StampedFailed (код 1).
--
-- program(command) — запустить, напечатать "[ЧЧ:ММ:СС] строка"

use io
use io.clock
use core.time
use core.process

Reading = Box {
    ended = no
}

program(command) {
    @feed = process.lines(["bash", "-c", command], "")
    @reading = Reading {}
    @zone = clock.zone()
    always {
        @line = feed.next() rescue |err| {
            reading.ended = yes
            ""
        }
        (reading.ended == yes) { leave }
        io.show("[", time.text(time.now() + zone), "] ", line)
    }
    (feed.code() == 0) { out none }
    out error.StampedFailed
}
