-- global-check — одна проверка всего (`just global-check`): сперва по очереди
-- сборка проверок, лимиты канона и самосборка полки, затем разом ветки —
-- тесты на rv32i, x86-64 и rv64, тесты ОС, платформы, самосборка на RV64,
-- кодировщик x86. Каждая ветка пишет журнал WORK/<имя>.log, конец — код в
-- <имя>.log.code. Вид — карточки: пиксельный логотип, рамки «подготовка»,
-- «проверки разом», «итог»; под веткой её случаи, у случая отрезок на общей
-- шкале времени (где начался, где кончился). Случаи тестов — из строк
-- «случаи:» / «случай:» в журнале tests/run.saltic, у RV64 и кодировщика — шаги по
-- их строкам (RV64_STEPS, GOLDEN_STEPS). В терминале блок веток перерисован раз
-- в секунду; не влезает в экран — под веткой только идущий случай, целиком —
-- в конце. В CI (CI или SALTIC_PLAIN) — без цвета и перерисовки, раз в
-- HEARTBEAT строка «идут» (правило автора: программа не крутится молча).
-- Упало — хвост журнала под случаем и ошибка GlobalCheckFailed.
-- Вместо workbench/global-check.sh и hosts.saltic (в .archive/).
--
-- Step { name, marker, seen, start } — случай ветки; start — десятые секунды
-- Branch { name, proc, what, script, env, log, done, code, tenths, cases, steps } — ветка; env — поверх своего
-- program() — вся проверка
-- Внутри: prep_wait — шаг подготовки со спиннером, scan — случаи из журнала,
--     branch_rows — строки ветки, wait_all — живой блок, summary — итог,
--     save_receipt — чек картинкой в RECEIPTS (workbench.receipt); вид —
--     workbench.cards, общее — workbench.kit

use io
use io.file
use io.clock
use core.str
use core.time
use core.group
use core.process
use workbench.kit
use workbench.cards
use workbench.receipt
use bootstrap.names

WORK = ".cache/build/workbench"
RECEIPTS = "чеки"
HEARTBEAT = 10
NIX = "nix --extra-experimental-features \"nix-command flakes\" develop --command"
TOOLS = [["limits", "workbench/limits.saltic"], ["tests", "tests/run.saltic"], ["refresh", "bootstrap/refresh.saltic"], ["refresh-rv64", "bootstrap/refresh-rv64.saltic"], ["x86-encoder-golden", "workbench/x86-encoder-golden.saltic"]]
TESTS = [["rv32i", "all", "все тесты"], ["x86_64", "all", "все тесты"], ["x86_64", "os", "ОС"], ["rv64", "all", "все тесты"], ["rv32i", "platforms", "платформы"]]
RV64_STEPS = [["собирает компилятор под RV64", "stage1"], ["собирает себя под qemu-riscv64", "stage2 и stage3"], ["проверяю fixed point", "fixed point"], ["сверяю с эталоном", "сверка с полкой"]]
GOLDEN_STEPS = [["шаг 1:", "GNU as"], ["шаг 2:", "сборка команд"], ["шаг 3:", "сверка"]]
CASES = "случаи: "
CASE = "случай: "
TAIL = 6

Step = Box {
    name = "",
    marker = "",
    seen = no,
    start = 0
}

Branch = Box {
    name = "",
    proc = "",
    what = "",
    script = "",
    env = [],
    log = "",
    done = no,
    code = 0,
    tenths = 0,
    cases = no,
    steps = []
}

Run = Box {
    zone = 0,
    started = 0,
    failed = 0,
    look = cards.Look {},
    screen = 24,
    drawn = 0,
    kept = []
}

skill show(run, text) {
    io.show(text)
    run.kept = group.add(run.kept, text)
    out none
}

skill again(run, text) {
    (run.look.plain == yes) { out show(run, text) }
    @escape = str.from_byte(27)
    io.show("{escape}[1A{escape}[2K{text}")
    run.kept = group.add(run.kept, text)
    out none
}

skill show_logo(run) {
    @moment = time.text(time.now() + run.zone)
    drum (cards.logo_lines(run.look, moment)) { show(run, beat) }
    out none
}

skill launch(branches) {
    drum (branches) {
        @branch = beat
        process.run(["rm", "-f", branch.log, "{branch.log}.code"], "", [])
        @wrapped = "{branch.script} > \"$0\" 2>&1; echo $? > \"$0.code\""
        @bash = process.locate("bash")
        process.open(bash, ["bash", "-c", wrapped, branch.log], "", no, process.environment_with(branch.env), no)
    }
    out branches
}

skill poll(branch) {
    (branch.done == yes) { out no }
    @text = file.read("{branch.log}.code") rescue |err| { out no }
    @lines = str.lines(text)
    (group.count(lines) == 0) { out no }
    @code = 0
    @digits = group.get(lines, 0)
    drum (str.bytes(digits)) { code = code * 10 + str.byte(digits, beat) - 48 }
    branch.code = code
    branch.done = yes
    out yes
}

skill failure_lines(run, log) {
    @kept = []
    drum (kit.tail(log, 1000)) {
        @useful = yes
        (str.contains(beat, "[ok]") == yes) { useful = no }
        (str.bytes(beat) == 0) { useful = no }
        (useful == yes) { kept = group.add(kept, beat) }
    }
    @start = group.count(kept) - TAIL
    (start < 0) { start = 0 }
    @result = []
    @edge = cards.paint(run.look, cards.CORAL, "╎ ")
    drum (group.count(kept) - start) {
        @text = cards.paint(run.look, cards.GRAY, cards.clipped(group.get(kept, start + beat), cards.CARD - 16))
        result = group.add(result, "        {edge}{text}")
    }
    @where = cards.paint(run.look, cards.GRAY, cards.clipped("журнал: {log}", cards.CARD - 16))
    out group.add(result, "        {edge}{where}")
}

skill prep_row(run, state, label, detail, tenths) {
    @mark = cards.mark_of(run.look, state)
    @name = cards.padded(label, 18)
    (str.bytes(detail) > 0) {
        @rest = cards.paint(run.look, cards.GRAY, detail)
        out "{mark} {name}{rest}"
    }
    @spent = cards.right(cards.time_of(run.look, tenths, state, yes), cards.CARD - 24)
    out "{mark} {name}{spent}"
}

skill prep_wait(run, label, branches) {
    launch(branches)
    @started = time.now()
    (run.look.plain == no) { io.show(cards.card_line(run.look, prep_row(run, "run", label, "", 0))) }
    @ticks = 0
    always {
        @left = 0
        drum (branches) {
            poll(beat)
            (beat.done == no) { left = left + 1 }
        }
        (left == 0) { leave }
        process.run(["sleep", "1"], "", [])
        ticks = ticks + 1
        run.look.tick = run.look.tick + 1
        @spent = kit.tenths_since(started)
        (run.look.plain == no) { again(run, cards.card_line(run.look, prep_row(run, "run", label, "", spent))) }
        (run.look.plain == yes) {
            (ticks % HEARTBEAT == 0) {
                @whole = spent / 10
                io.show(cards.card_line(run.look, "⏳ {label} — идёт {whole} с"))
            }
        }
    }
    @failed = 0
    drum (branches) {
        ((beat.code == 0) == no) { failed = failed + 1 }
    }
    run.failed = run.failed + failed
    out kit.tenths_since(started)
}

skill finish_prep(run, state, label, detail, tenths) {
    @text = cards.card_line(run.look, prep_row(run, state, label, detail, tenths))
    (run.look.plain == no) { out again(run, text) }
    out show(run, text)
}

skill show_lines(run, lines) {
    drum (lines) { show(run, cards.card_line(run.look, beat)) }
    out none
}

skill show_failure(run, log) {
    show_lines(run, failure_lines(run, log))
    show(run, cards.card_bottom(run.look))
    out none
}

skill preparation(run) {
    show(run, cards.card_top(run.look, "подготовка"))
    @builds = []
    @compiler = names.native_compiler()
    drum (TOOLS) {
        @name = group.get(beat, 0)
        @source = group.get(beat, 1)
        builds = group.add(builds, Branch { name = name, script = "\"{compiler}\" {source} {WORK}/{name}.part 536870912 x86_64", log = "{WORK}/build-{name}.log" })
    }
    @built = prep_wait(run, "сборка проверок", builds)
    drum (builds) {
        (beat.code == 0) {
            @part = "{WORK}/{beat.name}.part"
            names.finish(part, "x86_64")
            process.run(["mv", "-f", part, "{WORK}/{beat.name}"], "", [])
        }
    }
    (run.failed > 0) {
        finish_prep(run, "fail", "сборка проверок", "", built)
        drum (builds) {
            ((beat.code == 0) == no) { show_lines(run, failure_lines(run, beat.log)) }
        }
        show(run, cards.card_bottom(run.look))
        out error.GlobalCheckFailed
    }
    finish_prep(run, "ok", "сборка проверок", "", built)

    @limits = Branch { name = "limits", script = "{WORK}/limits", log = "{WORK}/limits.log" }
    prep_wait(run, "лимиты канона", [limits])
    @found = file.read(limits.log) rescue |err| { "" }
    @files = kit.number_after(found, "файлов ")
    @known = kit.number_after(found, "нарушений ")
    @fresh = kit.number_after(found, "новых ")
    @grown = kit.number_after(found, "выросших ")
    @counts = "новых {fresh} · известных {known} · файлов {files}"
    (str.bytes(grown) > 0) {
        ((grown == "0") == no) { counts = "{counts} · выросших {grown}" }
    }
    ((limits.code == 0) == no) {
        finish_prep(run, "fail", "лимиты канона", counts, 0)
        show_failure(run, limits.log)
        out error.GlobalCheckFailed
    }
    finish_prep(run, "ok", "лимиты канона", counts, 0)

    @refresh = Branch { name = "refresh", script = "{WORK}/refresh \"\"", env = ["SALTIC_STAMPED=1"], log = "{WORK}/refresh.log" }
    @spent = prep_wait(run, "самосборка", [refresh])
    ((refresh.code == 0) == no) {
        finish_prep(run, "fail", "самосборка", "", spent)
        show_failure(run, refresh.log)
        out error.GlobalCheckFailed
    }
    @text = file.read(refresh.log) rescue |err| { "" }
    @seconds = kit.number_after(text, "новый компилятор собрал себя за ")
    @memory = kit.number_after(text, "память самосборки ")
    @bytes = cards.spaced(kit.size(names.bootstrap_compiler()))
    @was_seconds = kit.remembered("{WORK}/self-build-seconds", seconds)
    @was_memory = kit.remembered("{WORK}/self-build-memory", memory)
    @was_bytes = kit.remembered("{WORK}/self-build-size", bytes)
    finish_prep(run, "ok", "самосборка", "{seconds} с · {memory} МБ · {bytes} байт", 0)
    @same = yes
    ((was_seconds == seconds) == no) { same = no }
    ((was_memory == memory) == no) { same = no }
    ((was_bytes == bytes) == no) { same = no }
    (same == no) {
        @before = cards.paint(run.look, cards.GRAY, "было {was_seconds} с · {was_memory} МБ · {was_bytes} байт")
        show(run, cards.card_line(run.look, "                    {before}"))
    }
    show(run, cards.card_line(run.look, cards.compilers_row(run.look, text)))
    show(run, cards.card_bottom(run.look))
    out none
}

skill scan(branch, now) {
    @text = file.read(branch.log) rescue |err| { out none }
    drum (str.lines(text)) {
        @line = beat
        (branch.cases == yes) {
            (group.count(branch.steps) == 0) {
                (str.starts_with(line, CASES) == yes) {
                    drum (str.split(str.slice(line, str.bytes(CASES), str.bytes(line)), " ")) {
                        branch.steps = group.add(branch.steps, Step { name = beat, marker = "{CASE}{beat}" })
                    }
                }
            }
            (str.starts_with(line, CASE) == yes) {
                drum (branch.steps) {
                    (beat.seen == no) {
                        (beat.marker == line) {
                            beat.seen = yes
                            beat.start = now
                        }
                    }
                }
            }
        }
        (branch.cases == no) {
            drum (branch.steps) {
                (beat.seen == no) {
                    (str.contains(line, beat.marker) == yes) {
                        beat.seen = yes
                        beat.start = now
                    }
                }
            }
        }
    }
    out none
}

skill step_finish(branch, index, now) {
    @count = group.count(branch.steps)
    drum (count - index - 1) {
        @later = group.get(branch.steps, index + 1 + beat)
        (later.seen == yes) { out later.start }
    }
    (branch.done == yes) { out branch.tenths }
    out now
}

skill last_seen(branch) {
    @result = 0 - 1
    drum (group.count(branch.steps)) {
        @item = group.get(branch.steps, beat)
        (item.seen == yes) { result = beat }
    }
    out result
}

skill step_state(branch, index, last) {
    @item = group.get(branch.steps, index)
    (item.seen == no) {
        (branch.done == yes) { out "skip" }
        out "wait"
    }
    (index == last) {
        (branch.done == no) { out "run" }
        ((branch.code == 0) == no) { out "fail" }
    }
    out "ok"
}

skill branch_state(branch) {
    (branch.done == no) { out "run" }
    ((branch.code == 0) == no) { out "fail" }
    out "ok"
}

skill branch_rows(run, branch, now, full) {
    @state = branch_state(branch)
    @spent = branch.tenths
    (branch.done == no) { spent = now }
    @mark = cards.mark_of(run.look, state)
    @proc = cards.padded(cards.bold(run.look, branch.proc), 7)
    @what = cards.padded(cards.bold(run.look, branch.what), 11)
    @line = cards.bar(run.look, spent, state)
    @spent_text = cards.right(cards.time_of(run.look, spent, state, yes), 10)
    @rows = ["{mark} {proc} {what} {line} {spent_text}"]
    @last = last_seen(branch)
    @count = group.count(branch.steps)
    @tail_shown = no
    drum (count) {
        @index = beat
        @item = group.get(branch.steps, index)
        @child = step_state(branch, index, last)
        @wanted = full
        (child == "run") { wanted = yes }
        (wanted == yes) {
            @joint = "├ "
            (index == count - 1) { joint = "└ " }
            (full == no) { joint = "└ " }
            @edge = cards.paint(run.look, cards.DIM, "  {joint}")
            @child_mark = cards.mark_of(run.look, child)
            @tint = cards.GRAY
            (child == "run") { tint = cards.WHITE }
            @name = cards.padded(cards.paint(run.look, tint, item.name), 16)
            @finish = step_finish(branch, index, now)
            @strip = cards.span(run.look, item.start, finish, child)
            @took = cards.right(cards.time_of(run.look, finish - item.start, child, no), 9)
            rows = group.add(rows, "{edge}{child_mark} {name}{strip}  {took}")
            (child == "fail") {
                rows = group.concat(rows, failure_lines(run, branch.log))
                tail_shown = yes
            }
        }
    }
    (state == "fail") {
        (tail_shown == no) { rows = group.concat(rows, failure_lines(run, branch.log)) }
    }
    out rows
}

skill block(run, branches, now, full) {
    @rows = [cards.card_top(run.look, "проверки разом")]
    @before = 0
    drum (branches) {
        @own = branch_rows(run, beat, now, full)
        (before > 1) { rows = group.add(rows, cards.card_line(run.look, "")) }
        (before == 1) {
            (group.count(own) > 1) { rows = group.add(rows, cards.card_line(run.look, "")) }
        }
        drum (own) { rows = group.add(rows, cards.card_line(run.look, beat)) }
        before = group.count(own)
    }
    out group.add(rows, cards.card_bottom(run.look))
}

skill draw(run, rows) {
    @escape = str.from_byte(27)
    @lines = rows
    @missing = run.drawn - group.count(rows)
    (missing < 0) { missing = 0 }
    drum (missing) { lines = group.add(lines, "") }
    @first = yes
    drum (lines) {
        @text = "{escape}[2K{beat}"
        (first == yes) {
            (run.drawn > 0) { text = "{escape}[{run.drawn}A{text}" }
            first = no
        }
        io.show(text)
    }
    run.drawn = group.count(lines)
    out none
}

skill live_block(run, branches, now) {
    @rows = block(run, branches, now, yes)
    (group.count(rows) + 2 > run.screen) { rows = block(run, branches, now, no) }
    out draw(run, rows)
}

skill wait_all(run, branches) {
    @started = time.now()
    @ticks = 0
    always {
        @now = kit.tenths_since(started)
        @left = []
        drum (branches) {
            @branch = beat
            scan(branch, now)
            (poll(branch) == yes) {
                branch.tenths = now
                ((branch.code == 0) == no) { run.failed = run.failed + 1 }
                (run.look.plain == yes) {
                    @state = branch_state(branch)
                    @mark = cards.mark_of(run.look, state)
                    @took = cards.seconds_text(now)
                    io.show("{mark} {branch.proc} {branch.what} — {took}")
                }
            }
            (branch.done == no) { left = group.add(left, "{branch.proc} {branch.what}") }
        }
        (run.look.plain == no) { live_block(run, branches, now) }
        (group.count(left) == 0) { leave }
        process.run(["sleep", "1"], "", [])
        ticks = ticks + 1
        run.look.tick = run.look.tick + 1
        (run.look.plain == yes) {
            (ticks % HEARTBEAT == 0) {
                @whole = kit.tenths_since(started) / 10
                @running = str.join(left, ", ")
                io.show("⏳ идут ({whole} с): {running}")
            }
        }
    }
    @rows = block(run, branches, 0, yes)
    (run.look.plain == no) { draw(run, rows) }
    (run.look.plain == yes) { drum (rows) { io.show(beat) } }
    run.kept = group.concat(run.kept, rows)
    out branches
}

skill steps_of(pairs) {
    @result = []
    drum (pairs) { result = group.add(result, Step { name = group.get(beat, 1), marker = group.get(beat, 0) }) }
    out result
}

skill check_branches() {
    @result = []
    drum (TESTS) {
        @host = group.get(beat, 0)
        @tests = group.get(beat, 1)
        @proc = host
        (host == "x86_64") { proc = "x86-64" }
        @script = "{NIX} {WORK}/tests {tests}"
        @env = ["SALTIC_TEST_HOST={host}", "SALTIC_STAMPED=1"]
        result = group.add(result, Branch { name = "{proc} {tests}", proc = proc, what = group.get(beat, 2), script = script, env = env, log = "{WORK}/check-{host}-{tests}.log", cases = yes })
    }
    result = group.add(result, Branch { name = "rv64 самосборка", proc = "rv64", what = "самосборка", script = "{WORK}/refresh-rv64 \"\"", env = ["SALTIC_STAMPED=1"], log = "{WORK}/check-rv64-self.log", steps = steps_of(RV64_STEPS) })
    result = group.add(result, Branch { name = "x86-64 кодировщик", proc = "x86-64", what = "кодировщик", script = "{WORK}/x86-encoder-golden \"\"", env = ["SALTIC_STAMPED=1"], log = "{WORK}/check-x86-golden.log", steps = steps_of(GOLDEN_STEPS) })
    out result
}

skill summary(run, done) {
    @checks = 0
    @slowest = group.get(done, 0)
    drum (done) {
        @branch = beat
        @text = file.read(branch.log) rescue |err| { "" }
        drum (str.lines(text)) {
            (str.contains(beat, "FAIL]") == yes) { checks = checks + 1 }
        }
        (branch.tenths > slowest.tenths) { slowest = branch }
    }
    @total = group.count(done)
    @head = "{total} из {total}"
    @state = "ok"
    (run.failed > 0) {
        head = "упала {run.failed} из {total}"
        state = "fail"
    }
    @mark = cards.mark_of(run.look, state)
    @whole = cards.seconds_text(kit.tenths_since(run.started))
    @longest = cards.seconds_text(slowest.tenths)
    @rest = cards.paint(run.look, cards.GRAY, " · {whole} · дольше всех — {slowest.proc} {slowest.what} {longest}")
    show(run, cards.card_top(run.look, "итог"))
    show(run, cards.card_line(run.look, "{mark} {head}{rest}"))
    (checks > 0) { show(run, cards.card_line(run.look, cards.paint(run.look, cards.CORAL, "  упавших проверок: {checks}"))) }
    show(run, cards.card_bottom(run.look))
    out none
}

skill save_receipt(run) {
    (run.look.plain == yes) { out none }
    @stamp = process.capture(["date", "+%Y-%m-%d_%H-%M-%S"], "", [])
    @moment = group.get(str.lines(stamp.output), 0)
    @head = process.capture(["git", "rev-parse", "--short", "HEAD"], "", [])
    @commit = group.get(str.lines(head.output), 0)
    @changes = process.capture(["git", "status", "--porcelain", "--untracked-files=no"], "", [])
    (str.bytes(changes.output) > 0) { commit = "{commit} + правки" }
    @verdict = "зелёный"
    (run.failed > 0) { verdict = "красный" }
    @footer = cards.paint(run.look, cards.GRAY, "  {moment} · {commit} · {verdict}")
    @path = "{RECEIPTS}/{moment}_{verdict}.png"
    process.run(["mkdir", "-p", RECEIPTS], "", [])
    @started = time.now()
    receipt.save(group.add(group.add(run.kept, ""), footer), path)
    @spent = cards.seconds_text(kit.tenths_since(started))
    io.show(cards.paint(run.look, cards.GRAY, "  чек: {path} ({spent})"))
    out none
}

program() {
    @run = Run {}
    run.zone = clock.zone()
    run.started = time.now()
    run.look.plain = cards.plain_mode()
    (run.look.plain == no) { run.screen = cards.screen_rows() }
    process.run(["mkdir", "-p", WORK], "", [])
    show_logo(run)
    @prepared = preparation(run) rescue |err| {
        io.show("  подготовка упала: {err}")
        run.failed = run.failed + 1
        save_receipt(run)
        out error.GlobalCheckFailed
    }
    (run.look.plain == no) { show(run, "") }
    @done = wait_all(run, launch(check_branches()))
    summary(run, done)
    save_receipt(run)
    (run.failed > 0) { out error.GlobalCheckFailed }
    out none
}
