-- same-source — проверка правки исходников без изменения смысла: каждая
-- программа собирается одним и тем же компилятором из HEAD (worktree в HEAD_DIR)
-- и из рабочего дерева, результаты обязаны совпасть побайтово. Компилятор —
-- родной x86-64 с полки (saltic_native_compiler из bootstrap/names.sh). Образ
-- ОС собирает qemu-virt toolchain под qemu-riscv32 (через nix develop), поэтому
-- он сравнивается его же сборками. Разошлось — размеры и первый другой байт,
-- не собралось — последняя строка журнала; итог — ошибка SourcesDiffer (код 1).
-- Вместо workbench/same-source.sh (в .archive/); вызывается `just same-source`.
--
-- program() — собрать ENTRIES и программы из TEST_DIRS, напечатать итог по каждой
-- Внутри: say(run, text), sources() -> пути, verdict(run, out, name, source,
--     must), explain(run, base); must — обязана собраться (образ ОС), иначе
--     пустые обе — «не программа»; общее — workbench.kit

use io.file
use io.clock
use core.str
use core.group
use core.process
use workbench.kit

WORK = ".cache/build/workbench/same-source"
HEAD_DIR = ".cache/build/workbench/same-source/head"
OUT_DIR = ".cache/build/workbench/same-source/out"
HEAP = "67108864"
TOOLCHAIN_HEAP = "536870912"
ENTRIES = ["soul/seed/selfhost/toolchain.saltic", "soul/canonical/main.saltic", "os/target/qemu_virt/toolchain.saltic"]
TEST_DIRS = ["soul/seed/tests", "tests"]

Run = Box {
    zone = 0,
    failed = no
}

skill say(run, text) {
    out kit.line(run.zone, text)
}

skill sources() {
    @all = ENTRIES
    drum (TEST_DIRS) {
        @folder = beat
        @found = []
        drum (file.list(folder)) {
            (str.ends_with(beat, ".saltic") == yes) { found = group.add(found, "{folder}/{beat}") }
        }
        all = group.concat(all, kit.sorted(found))
    }
    out all
}

skill last_log_line(path) {
    @lines = kit.tail(path, 1)
    (group.count(lines) == 0) { out "" }
    out group.get(lines, 0)
}

skill explain(run, base) {
    drum (["head", "work"]) {
        (kit.size("{base}.{beat}") == 0) {
            @line = last_log_line("{base}.{beat}.log")
            say(run, "    {beat} не собрался: {line}")
            out none
        }
    }
    @head = kit.size("{base}.head")
    @work = kit.size("{base}.work")
    say(run, "    размер: head {head}, work {work} байт")
    @at = kit.first_difference("{base}.head", "{base}.work")
    say(run, "    первое расхождение: байт {at}")
    out none
}

skill verdict(run, out_dir, name, source, must) {
    @base = "{out_dir}/{name}"
    @head = kit.size("{base}.head")
    @work = kit.size("{base}.work")
    (head + work == 0) {
        (must == no) {
            say(run, "не программа: {source}")
            out none
        }
    }
    (head > 0) {
        (work > 0) {
            (kit.same_file("{base}.head", "{base}.work") == yes) {
                say(run, "одинаково: {source}")
                out none
            }
        }
    }
    say(run, "РАЗЛИЧАЕТСЯ: {source}")
    explain(run, base)
    run.failed = yes
    out none
}

skill name_of(source) {
    @text = str.slice(source, 0, str.bytes(source) - 7)
    @name = ""
    drum (str.bytes(text)) {
        @ch = str.get(text, beat)
        (ch == "/") { ch = "_" }
        name = str.concat(name, ch)
    }
    out name
}

program() {
    @run = Run {}
    run.zone = clock.zone()
    process.run(["mkdir", "-p", WORK], "", [])
    process.run(["rm", "-rf", HEAD_DIR, OUT_DIR], "", [])
    process.run(["mkdir", "-p", OUT_DIR], "", [])
    @found = process.capture(["bash", "-c", "source bootstrap/names.sh && realpath \"$(saltic_native_compiler)\""], "", [])
    ((found.code == 0) == no) { out error.NoNativeCompiler }
    @compiler = str.slice(found.output, 0, str.bytes(found.output) - 1)
    kit.shell("git worktree remove --force \"$0\" >/dev/null 2>&1", [HEAD_DIR], "")
    @added = kit.shell("git worktree add --detach \"$0\" HEAD >/dev/null 2>&1", [HEAD_DIR], "")
    ((added == 0) == no) {
        say(run, "не удалось создать worktree HEAD")
        out error.NoWorktree
    }
    @where = process.capture(["realpath", OUT_DIR], "", [])
    @out_dir = str.slice(where.output, 0, str.bytes(where.output) - 1)
    @compile = "\"$0\" \"$1\" \"$2\" \"$3\" rv32i > \"$4\" 2>&1"
    drum (sources()) {
        @source = beat
        @name = name_of(source)
        @heap = HEAP
        (str.ends_with(source, "/toolchain.saltic") == yes) { heap = TOOLCHAIN_HEAP }
        @base = "{out_dir}/{name}"
        kit.shell(compile, [compiler, source, "{base}.head", heap, "{base}.head.log"], HEAD_DIR)
        kit.shell(compile, [compiler, source, "{base}.work", heap, "{base}.work.log"], "")
        kit.shell("chmod +x \"$0\" \"$1\" 2>/dev/null", ["{base}.head", "{base}.work"], "")
        verdict(run, out_dir, name, source, no)
    }
    @toolchain = "{out_dir}/os_target_qemu_virt_toolchain"
    @image = "{out_dir}/os"
    @inner = "(cd \"$0\" && qemu-riscv32 -B 0x100000000 \"$1.head\" os/main.saltic \"$2.head\" \"$3\" > \"$2.head.log\" 2>&1); qemu-riscv32 -B 0x100000000 \"$1.work\" os/main.saltic \"$2.work\" \"$3\" > \"$2.work.log\" 2>&1"
    @nix = "nix --extra-experimental-features \"nix-command flakes\" develop --command bash -c \"$4\" \"$0\" \"$1\" \"$2\" \"$3\" 2>/dev/null"
    kit.shell(nix, [HEAD_DIR, toolchain, image, HEAP, inner], "")
    verdict(run, out_dir, "os", "os/main.saltic", yes)
    kit.shell("git worktree remove --force \"$0\" >/dev/null 2>&1", [HEAD_DIR], "")
    (run.failed == yes) { out error.SourcesDiffer }
    out none
}
