{
  "$schema": "vscode://schemas/color-theme",
  "name": "Saltic Тема 1 · светлая",
  "type": "light",
  "semanticHighlighting": false,
  "colors": {
    "focusBorder": "#1f95a888",
    "foreground": "#2b231e",
    "descriptionForeground": "#7d6858",
    "errorForeground": "#c24a28",
    "widget.shadow": "#3c281424",
    "selection.background": "#0b7d8f33",
    "icon.foreground": "#7d6858",
    "editor.background": "#fbf6ef",
    "editor.foreground": "#2b231e",
    "editorLineNumber.foreground": "#a8978a",
    "editorLineNumber.activeForeground": "#7d6858",
    "editor.lineHighlightBackground": "#f5ede3",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#0b7d8f2e",
    "editor.inactiveSelectionBackground": "#0b7d8f1a",
    "editor.selectionHighlightBackground": "#0b7d8f1f",
    "editor.wordHighlightBackground": "#7547c022",
    "editor.wordHighlightStrongBackground": "#4f7a1222",
    "editor.findMatchBackground": "#b4600c55",
    "editor.findMatchHighlightBackground": "#b4600c26",
    "editorCursor.foreground": "#1f95a8",
    "editorWhitespace.foreground": "#d3c4b2",
    "editorIndentGuide.background1": "#e3d6c6",
    "editorIndentGuide.activeBackground1": "#c9b8a5",
    "editorBracketMatch.background": "#0b7d8f22",
    "editorBracketMatch.border": "#0b7d8f55",
    "editorBracketHighlight.foreground1": "#2b231e",
    "editorBracketHighlight.foreground2": "#2b231e",
    "editorBracketHighlight.foreground3": "#2b231e",
    "editorError.foreground": "#c24a28",
    "editorWarning.foreground": "#b4600c",
    "editorInfo.foreground": "#1f95a8",
    "editorGutter.background": "#fbf6ef",
    "editorRuler.foreground": "#e3d6c6",
    "editorOverviewRuler.border": "#00000000",
    "editorWidget.background": "#f3eadf",
    "editorWidget.border": "#e3d6c6",
    "editorHoverWidget.background": "#f3eadf",
    "editorHoverWidget.border": "#e3d6c6",
    "editorSuggestWidget.background": "#f3eadf",
    "editorSuggestWidget.border": "#e3d6c6",
    "editorSuggestWidget.selectedBackground": "#eadfd0",
    "editorSuggestWidget.highlightForeground": "#4f7a12",
    "editorGroupHeader.tabsBackground": "#f3eadf",
    "editorGroupHeader.tabsBorder": "#e3d6c6",
    "editorGroup.border": "#e3d6c6",
    "tab.activeBackground": "#fbf6ef",
    "tab.activeForeground": "#2b231e",
    "tab.activeBorderTop": "#1f95a8",
    "tab.inactiveBackground": "#f3eadf",
    "tab.inactiveForeground": "#7d6858",
    "tab.border": "#e3d6c6",
    "tab.hoverBackground": "#f3eadf",
    "tab.unfocusedActiveBorderTop": "#1f95a866",
    "breadcrumb.background": "#fbf6ef",
    "breadcrumb.foreground": "#7d6858",
    "breadcrumb.focusForeground": "#2b231e",
    "sideBar.background": "#f3eadf",
    "sideBar.foreground": "#2b231e",
    "sideBar.border": "#e3d6c6",
    "sideBarTitle.foreground": "#7d6858",
    "sideBarSectionHeader.background": "#f3eadf",
    "sideBarSectionHeader.foreground": "#7d6858",
    "sideBarSectionHeader.border": "#e3d6c6",
    "list.activeSelectionBackground": "#eadfd0",
    "list.activeSelectionForeground": "#2b231e",
    "list.inactiveSelectionBackground": "#eadfd0",
    "list.hoverBackground": "#f3eadf",
    "list.focusOutline": "#00000000",
    "list.highlightForeground": "#4f7a12",
    "tree.indentGuidesStroke": "#e3d6c6",
    "activityBar.background": "#f3eadf",
    "activityBar.foreground": "#2b231e",
    "activityBar.inactiveForeground": "#a8978a",
    "activityBar.border": "#e3d6c6",
    "activityBar.activeBorder": "#1f95a8",
    "activityBarBadge.background": "#1f95a8",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#f3eadf",
    "titleBar.activeForeground": "#2b231e",
    "titleBar.inactiveBackground": "#f3eadf",
    "titleBar.inactiveForeground": "#a8978a",
    "titleBar.border": "#e3d6c6",
    "statusBar.background": "#f3eadf",
    "statusBar.foreground": "#7d6858",
    "statusBar.border": "#e3d6c6",
    "statusBar.noFolderBackground": "#f3eadf",
    "statusBar.debuggingBackground": "#b4600c",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.remoteBackground": "#4f7a12",
    "statusBarItem.remoteForeground": "#ffffff",
    "panel.background": "#f3eadf",
    "panel.border": "#e3d6c6",
    "panelTitle.activeForeground": "#2b231e",
    "panelTitle.inactiveForeground": "#a8978a",
    "panelTitle.activeBorder": "#1f95a8",
    "terminal.background": "#fbf6ef",
    "terminal.foreground": "#2b231e",
    "terminalCursor.foreground": "#1f95a8",
    "terminal.ansiBlack": "#2b231e",
    "terminal.ansiRed": "#c24a28",
    "terminal.ansiGreen": "#4f7a12",
    "terminal.ansiYellow": "#9a6a12",
    "terminal.ansiBlue": "#1f95a8",
    "terminal.ansiMagenta": "#7547c0",
    "terminal.ansiCyan": "#0b7d8f",
    "terminal.ansiWhite": "#7d6858",
    "terminal.ansiBrightBlack": "#a8978a",
    "terminal.ansiBrightRed": "#1f95a8",
    "terminal.ansiBrightGreen": "#4f7a12",
    "terminal.ansiBrightYellow": "#b4600c",
    "terminal.ansiBrightBlue": "#0b7d8f",
    "terminal.ansiBrightMagenta": "#9264d4",
    "terminal.ansiBrightCyan": "#0b7d8f",
    "terminal.ansiBrightWhite": "#5a4a3f",
    "input.background": "#eadfd0",
    "input.border": "#e3d6c6",
    "input.foreground": "#2b231e",
    "input.placeholderForeground": "#a8978a",
    "inputOption.activeBorder": "#1f95a8",
    "dropdown.background": "#eadfd0",
    "dropdown.border": "#e3d6c6",
    "dropdown.foreground": "#2b231e",
    "button.background": "#4f7a12",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#5f8d1a",
    "button.secondaryBackground": "#eadfd0",
    "button.secondaryForeground": "#2b231e",
    "badge.background": "#1f95a8",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#1f95a8",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#d3c4b288",
    "scrollbarSlider.hoverBackground": "#c9b8a5aa",
    "scrollbarSlider.activeBackground": "#d8c8b6cc",
    "minimap.background": "#fbf6ef",
    "menu.background": "#f3eadf",
    "menu.foreground": "#2b231e",
    "menu.selectionBackground": "#eadfd0",
    "menu.border": "#e3d6c6",
    "quickInput.background": "#f3eadf",
    "quickInputList.focusBackground": "#eadfd0",
    "pickerGroup.foreground": "#1f95a8",
    "notifications.background": "#f3eadf",
    "notifications.border": "#e3d6c6",
    "textLink.foreground": "#1f95a8",
    "textLink.activeForeground": "#0b7d8f",
    "gitDecoration.modifiedResourceForeground": "#9a6a12",
    "gitDecoration.untrackedResourceForeground": "#4f7a12",
    "gitDecoration.deletedResourceForeground": "#c24a28",
    "gitDecoration.ignoredResourceForeground": "#a8978a",
    "editorGutter.modifiedBackground": "#9a6a12",
    "editorGutter.addedBackground": "#4f7a12",
    "editorGutter.deletedBackground": "#c24a28"
  },
  "tokenColors": [
    {
      "scope": [
        "source.saltic"
      ],
      "settings": {
        "foreground": "#2b231e"
      }
    },
    {
      "scope": [
        "comment.line.double-dash.saltic"
      ],
      "settings": {
        "foreground": "#857262",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.import.saltic"
      ],
      "settings": {
        "foreground": "#b4600c"
      }
    },
    {
      "scope": [
        "entity.name.namespace.saltic"
      ],
      "settings": {
        "foreground": "#2b231e"
      }
    },
    {
      "scope": [
        "keyword.control.saltic",
        "keyword.declaration.saltic",
        "keyword.operator.saltic",
        "keyword.operator.assignment.saltic"
      ],
      "settings": {
        "foreground": "#857262"
      }
    },
    {
      "scope": [
        "keyword.control.skill.saltic"
      ],
      "settings": {
        "foreground": "#4f7a12"
      }
    },
    {
      "scope": [
        "entity.name.function.saltic"
      ],
      "settings": {
        "foreground": "#2b231e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.call.saltic"
      ],
      "settings": {
        "foreground": "#4f7a12"
      }
    },
    {
      "scope": [
        "keyword.declaration.box.saltic",
        "keyword.declaration.enum.saltic",
        "entity.name.type.saltic",
        "storage.type.saltic"
      ],
      "settings": {
        "foreground": "#7547c0"
      }
    },
    {
      "scope": [
        "entity.name.type.box.saltic",
        "entity.name.type.enum.saltic"
      ],
      "settings": {
        "foreground": "#2b231e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.other.enum.saltic"
      ],
      "settings": {
        "foreground": "#9264d4"
      }
    },
    {
      "scope": [
        "punctuation.definition.variable.saltic",
        "variable.other.saltic",
        "variable.parameter.saltic"
      ],
      "settings": {
        "foreground": "#0b7d8f"
      }
    },
    {
      "scope": [
        "variable.other.declaration.saltic"
      ],
      "settings": {
        "foreground": "#2b231e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.other.property.saltic"
      ],
      "settings": {
        "foreground": "#2b231e"
      }
    },
    {
      "scope": [
        "keyword.control.rescue.saltic",
        "meta.rescue.parameter.saltic",
        "meta.rescue.parameter.saltic variable.parameter.saltic",
        "punctuation.definition.parameters.begin.saltic",
        "punctuation.definition.parameters.end.saltic",
        "support.type.error.saltic",
        "entity.name.exception.saltic"
      ],
      "settings": {
        "foreground": "#c24a28"
      }
    },
    {
      "scope": [
        "string.quoted.double.saltic",
        "constant.numeric.saltic",
        "constant.language.answer.saltic",
        "constant.language.none.saltic",
        "variable.other.constant.saltic"
      ],
      "settings": {
        "foreground": "#9a6a12"
      }
    },
    {
      "scope": [
        "constant.character.escape.saltic"
      ],
      "settings": {
        "foreground": "#b4600c"
      }
    },
    {
      "scope": [
        "punctuation.section.interpolation.begin.saltic",
        "punctuation.section.interpolation.end.saltic",
        "meta.interpolation.saltic variable.other.saltic"
      ],
      "settings": {
        "foreground": "#0b7d8f"
      }
    },
    {
      "scope": [
        "punctuation.separator.pipe.saltic"
      ],
      "settings": {
        "foreground": "#857262"
      }
    }
  ]
}
