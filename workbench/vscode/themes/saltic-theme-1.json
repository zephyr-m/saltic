{
  "$schema": "vscode://schemas/color-theme",
  "name": "Saltic Тема 1",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "focusBorder": "#63c1cf88",
    "foreground": "#f1e6d8",
    "descriptionForeground": "#b3a090",
    "errorForeground": "#f39b7d",
    "widget.shadow": "#0000005a",
    "selection.background": "#5ccfe033",
