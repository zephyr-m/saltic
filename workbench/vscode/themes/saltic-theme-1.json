    "editorBracketMatch.background": "#5ccfe022",
    "editorBracketMatch.border": "#5ccfe055",
    "editorBracketHighlight.foreground1": "#f1e6d8",
    "editorBracketHighlight.foreground2": "#f1e6d8",
    "editorBracketHighlight.foreground3": "#f1e6d8",
    "editorError.foreground": "#f39b7d",
    "editorWarning.foreground": "#f0a35e",
    "editorInfo.foreground": "#63c1cf",
    "editorGutter.background": "#2b231e",
    "editorRuler.foreground": "#3a2f28",
    "editorOverviewRuler.border": "#00000000",
    "editorWidget.background": "#221c18",
    "editorWidget.border": "#3a2f28",
    "editorHoverWidget.background": "#221c18",
    "editorHoverWidget.border": "#3a2f28",
    "editorSuggestWidget.background": "#221c18",
    "editorSuggestWidget.border": "#3a2f28",
    "editorSuggestWidget.selectedBackground": "#2f2621",
    "editorSuggestWidget.highlightForeground": "#b4d86b",
    "editorGroupHeader.tabsBackground": "#221c18",
    "editorGroupHeader.tabsBorder": "#3a2f28",
    "editorGroup.border": "#3a2f28",
    "tab.activeBackground": "#2b231e",
    "tab.activeForeground": "#f1e6d8",
    "tab.activeBorderTop": "#f1967a",
    "tab.inactiveBackground": "#221c18",
    "tab.inactiveForeground": "#b3a090",
    "tab.border": "#3a2f28",
    "tab.hoverBackground": "#352b25",
    "tab.unfocusedActiveBorderTop": "#f1967a66",
    "breadcrumb.background": "#2b231e",
    "breadcrumb.foreground": "#b3a090",
    "breadcrumb.focusForeground": "#f1e6d8",
    "sideBar.background": "#221c18",
    "sideBar.foreground": "#f1e6d8",
    "sideBar.border": "#3a2f28",
    "sideBarTitle.foreground": "#b3a090",
    "sideBarSectionHeader.background": "#221c18",
    "sideBarSectionHeader.foreground": "#b3a090",
    "sideBarSectionHeader.border": "#3a2f28",
    "list.activeSelectionBackground": "#2f2621",
    "list.activeSelectionForeground": "#f1e6d8",
    "list.inactiveSelectionBackground": "#2f2621",
    "list.hoverBackground": "#352b25",
    "list.focusOutline": "#00000000",
    "list.highlightForeground": "#b4d86b",
    "tree.indentGuidesStroke": "#3a2f28",
    "activityBar.background": "#221c18",
    "activityBar.foreground": "#f1e6d8",
    "activityBar.inactiveForeground": "#6f5f53",
    "activityBar.border": "#3a2f28",
    "activityBar.activeBorder": "#f1967a",
    "activityBarBadge.background": "#f1967a",
    "activityBarBadge.foreground": "#1f1a15",
    "titleBar.activeBackground": "#221c18",
    "titleBar.activeForeground": "#f1e6d8",
    "titleBar.inactiveBackground": "#221c18",
    "titleBar.inactiveForeground": "#6f5f53",
    "titleBar.border": "#3a2f28",
    "statusBar.background": "#221c18",
    "statusBar.foreground": "#b3a090",
    "statusBar.border": "#3a2f28",
    "statusBar.noFolderBackground": "#221c18",
    "statusBar.debuggingBackground": "#f0a35e",
    "statusBar.debuggingForeground": "#1f1a15",
    "statusBarItem.remoteBackground": "#b4d86b",
    "statusBarItem.remoteForeground": "#1f1a15",
    "panel.background": "#221c18",
    "panel.border": "#3a2f28",
    "panelTitle.activeForeground": "#f1e6d8",
    "panelTitle.inactiveForeground": "#6f5f53",
    "panelTitle.activeBorder": "#f1967a",
    "terminal.background": "#2b231e",
    "terminal.foreground": "#f1e6d8",
    "terminalCursor.foreground": "#f1967a",
    "terminal.ansiBlack": "#221c18",
    "terminal.ansiRed": "#f39b7d",
    "terminal.ansiGreen": "#b4d86b",
    "terminal.ansiYellow": "#eac98f",
    "terminal.ansiBlue": "#63c1cf",
    "terminal.ansiMagenta": "#c7a6f0",
    "terminal.ansiCyan": "#5ccfe0",
    "terminal.ansiWhite": "#f1e6d8",
    "terminal.ansiBrightBlack": "#6f5f53",
    "terminal.ansiBrightRed": "#f1967a",
    "terminal.ansiBrightGreen": "#b4d86b",
    "terminal.ansiBrightYellow": "#f0a35e",
    "terminal.ansiBrightBlue": "#5ccfe0",
    "terminal.ansiBrightMagenta": "#e2cffb",
    "terminal.ansiBrightCyan": "#5ccfe0",
    "terminal.ansiBrightWhite": "#fffaf3",
    "input.background": "#2f2621",
    "input.border": "#3a2f28",
    "input.foreground": "#f1e6d8",
    "input.placeholderForeground": "#6f5f53",
    "inputOption.activeBorder": "#63c1cf",
    "dropdown.background": "#2f2621",
    "dropdown.border": "#3a2f28",
    "dropdown.foreground": "#f1e6d8",
    "button.background": "#b4d86b",
    "button.foreground": "#1f1a15",
    "button.hoverBackground": "#c4e47f",
    "button.secondaryBackground": "#2f2621",
    "button.secondaryForeground": "#f1e6d8",
    "badge.background": "#f1967a",
    "badge.foreground": "#1f1a15",
    "progressBar.background": "#63c1cf",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#4a3d3488",
    "scrollbarSlider.hoverBackground": "#5a4a3faa",
    "scrollbarSlider.activeBackground": "#6a584bcc",
    "minimap.background": "#2b231e",
    "menu.background": "#221c18",
    "menu.foreground": "#f1e6d8",
    "menu.selectionBackground": "#2f2621",
    "menu.border": "#3a2f28",
    "quickInput.background": "#221c18",
    "quickInputList.focusBackground": "#2f2621",
    "pickerGroup.foreground": "#63c1cf",
    "notifications.background": "#221c18",
    "notifications.border": "#3a2f28",
    "textLink.foreground": "#63c1cf",
    "textLink.activeForeground": "#5ccfe0",
    "gitDecoration.modifiedResourceForeground": "#eac98f",
    "gitDecoration.untrackedResourceForeground": "#b4d86b",
    "gitDecoration.deletedResourceForeground": "#f39b7d",
    "gitDecoration.ignoredResourceForeground": "#6f5f53",
    "editorGutter.modifiedBackground": "#eac98f",
    "editorGutter.addedBackground": "#b4d86b",
    "editorGutter.deletedBackground": "#f39b7d"
  },
  "tokenColors": [
    {
      "scope": [
        "source.saltic"
      ],
      "settings": {
        "foreground": "#f1e6d8"
      }
    },
    {
      "scope": [
        "comment.line.double-dash.saltic"
      ],
      "settings": {
        "foreground": "#a8968a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control.import.saltic"
      ],
      "settings": {
        "foreground": "#f0a35e"
      }
    },
    {
      "scope": [
        "entity.name.namespace.saltic"
      ],
      "settings": {
        "foreground": "#f1e6d8"
      }
    },
    {
      "scope": [
        "keyword.control.saltic",
        "keyword.declaration.saltic",
        "keyword.operator.saltic",
        "keyword.operator.assignment.saltic"
      ],
      "settings": {
        "foreground": "#a8968a"
      }
    },
    {
      "scope": [
        "keyword.control.skill.saltic"
      ],
      "settings": {
        "foreground": "#b4d86b"
      }
    },
    {
      "scope": [
        "entity.name.function.saltic"
      ],
      "settings": {
        "foreground": "#f1e6d8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function.call.saltic"
      ],
      "settings": {
        "foreground": "#b4d86b"
      }
    },
    {
      "scope": [
        "keyword.declaration.box.saltic",
        "keyword.declaration.enum.saltic",
        "entity.name.type.saltic",
        "storage.type.saltic"
      ],
      "settings": {
        "foreground": "#c7a6f0"
      }
    },
    {
      "scope": [
        "entity.name.type.box.saltic",
        "entity.name.type.enum.saltic"
      ],
      "settings": {
        "foreground": "#f1e6d8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.other.enum.saltic"
      ],
      "settings": {
        "foreground": "#e2cffb"
      }
    },
    {
      "scope": [
        "punctuation.definition.variable.saltic",
        "variable.other.saltic",
        "variable.parameter.saltic"
      ],
      "settings": {
        "foreground": "#5ccfe0"
      }
    },
    {
      "scope": [
        "variable.other.declaration.saltic"
      ],
      "settings": {
        "foreground": "#f1e6d8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.other.property.saltic"
      ],
      "settings": {
        "foreground": "#f1e6d8"
      }
    },
    {
      "scope": [
        "keyword.control.rescue.saltic",
        "meta.rescue.parameter.saltic",
        "meta.rescue.parameter.saltic variable.parameter.saltic",
        "punctuation.definition.parameters.begin.saltic",
        "punctuation.definition.parameters.end.saltic",
        "support.type.error.saltic",
        "entity.name.exception.saltic"
      ],
      "settings": {
        "foreground": "#f39b7d"
      }
    },
    {
      "scope": [
        "string.quoted.double.saltic",
        "constant.numeric.saltic",
        "constant.language.answer.saltic",
        "constant.language.none.saltic",
        "variable.other.constant.saltic"
      ],
      "settings": {
        "foreground": "#eac98f"
      }
    },
    {
      "scope": [
        "constant.character.escape.saltic"
      ],
      "settings": {
        "foreground": "#f0a35e"
      }
    },
    {
      "scope": [
        "punctuation.section.interpolation.begin.saltic",
        "punctuation.section.interpolation.end.saltic",
        "meta.interpolation.saltic variable.other.saltic"
      ],
      "settings": {
        "foreground": "#5ccfe0"
      }
    },
    {
      "scope": [
        "punctuation.separator.pipe.saltic"
      ],
      "settings": {
        "foreground": "#a8968a"
      }
    }
  ]
}
