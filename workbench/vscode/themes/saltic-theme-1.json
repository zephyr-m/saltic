    "editorLineNumber.foreground": "#6f5f53",
    "editorLineNumber.activeForeground": "#b3a090",
    "editor.lineHighlightBackground": "#352b25",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#5ccfe02e",
    "editor.inactiveSelectionBackground": "#5ccfe01a",
    "editor.selectionHighlightBackground": "#5ccfe01f",
    "editor.wordHighlightBackground": "#c7a6f022",
    "editor.wordHighlightStrongBackground": "#b4d86b22",
    "editor.findMatchBackground": "#f0a35e55",
    "editor.findMatchHighlightBackground": "#f0a35e26",
    "editorCursor.foreground": "#f1967a",
    "editorWhitespace.foreground": "#4a3d34",
    "editorIndentGuide.background1": "#3a2f28",
