-- lens — Saltic смотрит на свой код. Запуск из корня репозитория:
--   check <файл>  — разбор и чекер без сборки: «ok» или «код|строка|столбец|текст»
--   api <модуль>  — шапка модуля и всё верхнего уровня
--   find <имя>    — где определено и где встречается
--   goto <файл:строка:столбец> — куда ведёт имя под курсором (lens/jump):
--                   строки «путь:строка:столбец», строка с единицы, столбец
--                   в буквах с нуля; не нашлось — ничего
-- Что видно в коде — lens/look. Агент зовёт lens через сервер MCP
-- workbench/agent/mcp (инструменты saltic_*).
--
-- program(command, subject) — команда и её предмет

use io
use io.file
use core.str
use core.group
use os.text.parse
use workbench.agent.lens.look
use workbench.agent.lens.jump

skill say(lines) {
    drum (lines) { io.show(beat) }
    out none
}

program(command, subject) {
    (command == "check") { out say(look.check(subject)) }
    (command == "api") {
        @seeker = jump.Jump {}
        @path = seeker.module_file(subject) rescue |err| {
            io.show("модуль не найден: {subject}")
            out none
        }
        out say(look.api(path))
    }
    (command == "find") { out say(look.find(subject)) }
    (command == "goto") {
        @parts = str.split(subject, ":")
        (group.count(parts) < 3) {
            io.show("goto: нужно файл:строка:столбец, а пришло {subject}")
            out none
        }
        @source = group.get(parts, 0)
        @aiming = jump.Jump {
            path = source
        }
        aiming.rows = str.rows(file.read(source))
        @line = parse.parse_size(group.get(parts, 1))
        @column = parse.parse_size(group.get(parts, 2))
        drum (aiming.places(line, column)) {
            io.show("{beat.path}:{beat.line}:{beat.column}")
        }
        out none
    }
    io.show("lens: check <файл> | api <модуль> | find <имя> | goto <файл:строка:столбец>")
    out none
}
