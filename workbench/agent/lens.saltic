-- lens — Saltic смотрит на свой код. Запуск из корня репозитория:
--   check <файл>  — разбор и чекер без сборки: «ok» или «код|строка|столбец|текст»
--   api <модуль>  — шапка модуля и всё верхнего уровня
--   find <имя>    — где определено и где встречается
-- Что видно в коде — lens/look. Агент зовёт lens через сервер MCP
-- workbench/agent/mcp (инструменты saltic_*).
--
-- program(command, subject) — команда и её предмет

use io
use workbench.agent.lens.look

skill say(lines) {
    drum (lines) { io.show(beat) }
    out none
}

program(command, subject) {
    (command == "check") { out say(look.check(subject)) }
    (command == "api") {
        @path = look.path_of(subject) rescue |err| {
            io.show("модуль не найден: {subject}")
            out none
        }
        out say(look.api(path))
    }
    (command == "find") { out say(look.find(subject)) }
    io.show("lens: check <файл> | api <модуль> | find <имя>")
    out none
}
