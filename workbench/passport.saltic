-- passport — паспорт адаптера или библиотеки реестра: JSON-объект «поле →
-- текст» в <путь>.passport.json (решение автора 17.11.2026, раньше — строки
-- «поле: текст»). Читают сверка реестра (workbench/registry) и tarantul.
--
-- SUFFIX — окончание файла паспорта
-- read(path) -> json.Value паспорта; нет файла — NoPassport, не JSON или не
--     объект — BadPassport (причина — в io.show)
-- field(passport, key) -> текст поля или "" (нет поля)

use io
use io.file
use craft.protocols.data.json
use craft.protocols.data.json.value
use craft.protocols.data.json.reader
use os.target.uefi_x86_64.network.mrpc

SUFFIX = ".passport.json"

skill read(path) {
    @text = file.read(path) rescue |err| { out error.NoPassport }
    @parsed = reader.parse(text)
    (parsed.ok == no) {
        io.show("паспорт {path}: не JSON — {parsed.message} (знак {parsed.index})")
        out error.BadPassport
    }
    (value.is_kind(parsed.value, json.JsonKind.OBJECT) == no) {
        io.show("паспорт {path}: ждала объект «поле → текст»")
        out error.BadPassport
    }
    out parsed.value
}

skill field(passport, key) {
    @found = value.get(passport, key)
    (found.found == no) { out "" }
    out mrpc.plain(found.value)
}
