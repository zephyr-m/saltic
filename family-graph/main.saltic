use seed
use craft.testing

Parent = "parent"
Spouse = "spouse"

Node = Box {
    id = ""
    name = ""
}

Edge = Box {
    from = ""
    kind = ""
    to = ""
}

Graph = Box {
    nodes = []
    edges = []
}

skill has_node(graph, id) {
    @index = 0
    @count = seed.group.count(graph.nodes)
    drum (count) {
        @candidate = seed.group.item(graph.nodes, index)
        (candidate.id == id) {
            out yes
        }
        index = index + 1
    }
    out no
}

skill find_node(graph, id) {
    @index = 0
    @count = seed.group.count(graph.nodes)
    drum (count) {
        @candidate = seed.group.item(graph.nodes, index)
        (candidate.id == id) {
            out candidate
        }
        index = index + 1
    }
    out error.NodeNotFound
}

skill remember(graph, id, name) {
    (has_node(graph, id) == yes) {
        out error.NodeAlreadyExists
    }
    graph.nodes = seed.group.add(graph.nodes, Node { id = id name = name })
    out graph
}

skill has_edge(graph, from, kind, to) {
    @index = 0
    @count = seed.group.count(graph.edges)
    drum (count) {
        @edge = seed.group.item(graph.edges, index)
        (edge.from == from) {
            (edge.kind == kind) {
                (edge.to == to) {
                    out yes
                }
            }
        }
        index = index + 1
    }
    out no
}

skill link(graph, from, kind, to) {
    (has_node(graph, from) == no) {
        out error.NodeNotFound
    }
    (has_node(graph, to) == no) {
        out error.NodeNotFound
    }
    (has_edge(graph, from, kind, to) == yes) {
        out error.EdgeAlreadyExists
    }
    graph.edges = seed.group.add(graph.edges, Edge {
        from = from
        kind = kind
        to = to
    })
    out graph
}

skill nodes_have(nodes, id) {
    @index = 0
    @count = seed.group.count(nodes)
    drum (count) {
        @candidate = seed.group.item(nodes, index)
        (candidate.id == id) {
            out yes
        }
        index = index + 1
    }
    out no
}

skill nodes_add(nodes, candidate) {
    (nodes_have(nodes, candidate.id) == yes) {
        out nodes
    }
    out seed.group.add(nodes, candidate)
}

skill parents_of(graph, id) {
    @subject = find_node(graph, id)
    @result = []
    @index = 0
    @count = seed.group.count(graph.edges)
    drum (count) {
        @edge = seed.group.item(graph.edges, index)
        (edge.kind == Parent) {
            (edge.to == id) {
                result = nodes_add(result, find_node(graph, edge.from))
            }
        }
        index = index + 1
    }
    out result
}

skill children_of(graph, id) {
    @subject = find_node(graph, id)
    @result = []
    @index = 0
    @count = seed.group.count(graph.edges)
    drum (count) {
        @edge = seed.group.item(graph.edges, index)
        (edge.kind == Parent) {
            (edge.from == id) {
                result = nodes_add(result, find_node(graph, edge.to))
            }
        }
        index = index + 1
    }
    out result
}

skill spouses_of(graph, id) {
    @subject = find_node(graph, id)
    @result = []
    @index = 0
    @count = seed.group.count(graph.edges)
    drum (count) {
        @edge = seed.group.item(graph.edges, index)
        (edge.kind == Spouse) {
            (edge.from == id) {
                result = nodes_add(result, find_node(graph, edge.to))
            }
            (edge.to == id) {
                result = nodes_add(result, find_node(graph, edge.from))
            }
        }
        index = index + 1
    }
    out result
}

skill siblings_of(graph, id) {
    @subject = find_node(graph, id)
    @result = []
    @parents = parents_of(graph, id)
    @parent_index = 0
    @parent_count = seed.group.count(parents)
    drum (parent_count) {
        @current_parent = seed.group.item(parents, parent_index)
        @children = children_of(graph, current_parent.id)
        @child_index = 0
        @child_count = seed.group.count(children)
        drum (child_count) {
            @candidate = seed.group.item(children, child_index)
            ((candidate.id == id) == no) {
                result = nodes_add(result, candidate)
            }
            child_index = child_index + 1
        }
        parent_index = parent_index + 1
    }
    out result
}

skill grandparents_of(graph, id) {
    @subject = find_node(graph, id)
    @result = []
    @parents = parents_of(graph, id)
    @parent_index = 0
    @parent_count = seed.group.count(parents)
    drum (parent_count) {
        @current_parent = seed.group.item(parents, parent_index)
        @grandparents = parents_of(graph, current_parent.id)
        @grandparent_index = 0
        @grandparent_count = seed.group.count(grandparents)
        drum (grandparent_count) {
            result = nodes_add(result, seed.group.item(grandparents, grandparent_index))
            grandparent_index = grandparent_index + 1
        }
        parent_index = parent_index + 1
    }
    out result
}

skill ancestors_of(graph, id) {
    @subject = find_node(graph, id)
    @result = []
    @frontier = parents_of(graph, id)
    @limit = seed.group.count(graph.nodes)
    @round = 0
    drum (limit) {
        @next = []
        @index = 0
        @count = seed.group.count(frontier)
        drum (count) {
            @candidate = seed.group.item(frontier, index)
            (nodes_have(result, candidate.id) == no) {
                result = nodes_add(result, candidate)
                @more = parents_of(graph, candidate.id)
                @more_index = 0
                @more_count = seed.group.count(more)
                drum (more_count) {
                    @ancestor = seed.group.item(more, more_index)
                    (nodes_have(result, ancestor.id) == no) {
                        (nodes_have(next, ancestor.id) == no) {
                            next = nodes_add(next, ancestor)
                        }
                    }
                    more_index = more_index + 1
                }
            }
            index = index + 1
        }
        frontier = next
        round = round + 1
    }
    out result
}

skill is_ancestor(graph, ancestor_id, person_id) {
    out nodes_have(ancestors_of(graph, person_id), ancestor_id)
}

skill cousins_of(graph, id) {
    @subject = find_node(graph, id)
    @result = []
    @parents = parents_of(graph, id)
    @parent_index = 0
    @parent_count = seed.group.count(parents)
    drum (parent_count) {
        @current_parent = seed.group.item(parents, parent_index)
        @aunts = siblings_of(graph, current_parent.id)
        @aunt_index = 0
        @aunt_count = seed.group.count(aunts)
        drum (aunt_count) {
            @aunt = seed.group.item(aunts, aunt_index)
            @children = children_of(graph, aunt.id)
            @child_index = 0
            @child_count = seed.group.count(children)
            drum (child_count) {
                @candidate = seed.group.item(children, child_index)
                ((candidate.id == id) == no) {
                    result = nodes_add(result, candidate)
                }
                child_index = child_index + 1
            }
            aunt_index = aunt_index + 1
        }
        parent_index = parent_index + 1
    }
    out result
}

skill bind_parent(graph, parent_id, child_id) {
    (parent_id == child_id) {
        out error.FamilyCycle
    }
    (has_node(graph, parent_id) == no) {
        out error.NodeNotFound
    }
    (has_node(graph, child_id) == no) {
        out error.NodeNotFound
    }
    (is_ancestor(graph, child_id, parent_id) == yes) {
        out error.FamilyCycle
    }
    out link(graph, parent_id, Parent, child_id)
}

skill bind_spouses(graph, left_id, right_id) {
    (left_id == right_id) {
        out error.FamilyCycle
    }
    (has_edge(graph, left_id, Spouse, right_id) == yes) {
        out error.EdgeAlreadyExists
    }
    (has_edge(graph, right_id, Spouse, left_id) == yes) {
        out error.EdgeAlreadyExists
    }
    out link(graph, left_id, Spouse, right_id)
}

skill is_parent(graph, parent_id, child_id) {
    out has_edge(graph, parent_id, Parent, child_id)
}

skill is_spouse(graph, left_id, right_id) {
    (has_edge(graph, left_id, Spouse, right_id) == yes) {
        out yes
    }
    out has_edge(graph, right_id, Spouse, left_id)
}

skill is_sibling(graph, left_id, right_id) {
    out nodes_have(siblings_of(graph, left_id), right_id)
}

skill is_grandparent(graph, grandparent_id, person_id) {
    out nodes_have(grandparents_of(graph, person_id), grandparent_id)
}

skill is_cousin(graph, left_id, right_id) {
    out nodes_have(cousins_of(graph, left_id), right_id)
}

skill show_nodes(title, nodes) {
    seed.io.show(title, ":")
    @index = 0
    @count = seed.group.count(nodes)
    drum (count) {
        @person = seed.group.item(nodes, index)
        seed.io.show("  ", person.name, " [", person.id, "]")
        index = index + 1
    }
    out none
}

skill example_family() {
    @graph = Graph {}

    graph = remember(graph, "vera", "Vera")
    graph = remember(graph, "pavel", "Pavel")
    graph = remember(graph, "anna", "Anna")
    graph = remember(graph, "maksim", "Maksim")
    graph = remember(graph, "oleg", "Oleg")
    graph = remember(graph, "roman", "Roman")
    graph = remember(graph, "irina", "Irina")
    graph = remember(graph, "lena", "Lena")
    graph = remember(graph, "kirill", "Kirill")
    graph = remember(graph, "sofia", "Sofia")

    graph = bind_spouses(graph, "vera", "pavel")
    graph = bind_parent(graph, "vera", "anna")
    graph = bind_parent(graph, "pavel", "anna")
    graph = bind_parent(graph, "vera", "maksim")
    graph = bind_parent(graph, "pavel", "maksim")

    graph = bind_spouses(graph, "anna", "oleg")
    graph = bind_parent(graph, "anna", "lena")
    graph = bind_parent(graph, "oleg", "lena")

    graph = bind_spouses(graph, "anna", "roman")
    graph = bind_parent(graph, "anna", "kirill")
    graph = bind_parent(graph, "roman", "kirill")

    graph = bind_spouses(graph, "maksim", "irina")
    graph = bind_parent(graph, "maksim", "sofia")
    graph = bind_parent(graph, "irina", "sofia")

    out graph
}

program() {
    @graph = example_family()
    @suite = testing.test_new()

    suite = testing.test_equal(suite, "graph: nodes", seed.group.count(graph.nodes), 10)
    suite = testing.test_equal(suite, "graph: edges", seed.group.count(graph.edges), 14)
    suite = testing.test_yes(suite, "family: Anna is Lena parent", is_parent(graph, "anna", "lena"))
    suite = testing.test_yes(suite, "family: Anna and Oleg are spouses", is_spouse(graph, "anna", "oleg"))
    suite = testing.test_yes(suite, "family: Lena and Kirill are siblings", is_sibling(graph, "lena", "kirill"))
    suite = testing.test_yes(suite, "family: Vera is Lena grandparent", is_grandparent(graph, "vera", "lena"))
    suite = testing.test_yes(suite, "family: Vera is Lena ancestor", is_ancestor(graph, "vera", "lena"))
    suite = testing.test_yes(suite, "family: Lena and Sofia are cousins", is_cousin(graph, "lena", "sofia"))

    show_nodes("Anna spouses", spouses_of(graph, "anna"))
    show_nodes("Lena siblings", siblings_of(graph, "lena"))
    show_nodes("Lena grandparents", grandparents_of(graph, "lena"))
    show_nodes("Lena ancestors", ancestors_of(graph, "lena"))
    show_nodes("Lena cousins", cousins_of(graph, "lena"))

    out testing.test_finish(suite)
}
