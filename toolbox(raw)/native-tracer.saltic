use seed
use craft.tracer.model
use craft.tracer.elf

HEADER_SIZE = 32
EVENT_SIZE = 12
EVENT_CAPACITY = 4096
STACK_CAPACITY = 64
RING_OFFSET = 32
STACK_OFFSET = 49184
TRACE_SIZE = 49440
VISIBLE_EVENTS = 64

Word = Box {
    b0 = 0
    b1 = 0
    b2 = 0
    b3 = 0
}

Output = Box {
    chunks = []
}

skill output_add(output, text) {
    @carry = text
    @chunks = []
    @index = 0
    @count = seed.group.count(output.chunks)
    @active = yes
    drum (count) {
        @chunk = seed.group.at(output.chunks, index)
        (active == no) { chunks = seed.group.add(chunks, chunk) }
        (active == yes) {
            (seed.str.len(chunk) == 0) {
                chunks = seed.group.add(chunks, carry)
                active = no
            }
            (seed.str.len(chunk) > 0) {
                chunks = seed.group.add(chunks, "")
                carry = seed.str.add(chunk, carry)
            }
        }
        index = index + 1
    }
    (active == yes) { chunks = seed.group.add(chunks, carry) }
    out Output { chunks = chunks }
}

skill output_text(output) {
    @text = ""
    @count = seed.group.count(output.chunks)
    @index = count - 1
    drum (count) {
        @chunk = seed.group.at(output.chunks, index)
        (seed.str.len(chunk) > 0) { text = seed.str.add(text, chunk) }
        index = index - 1
    }
    out text
}

skill instrumentation() {
    out "
.section .text
.balign 4
rt_native_trace_alloc:
  la t0, rt_native_trace_cursor
  lw t1, 0(t0)
  li t2, 4096
  bltu t1, t2, .L_native_trace_alloc_index
  addi t1, zero, 0
.L_native_trace_alloc_index:
  slli t2, t1, 3
  slli t3, t1, 2
  add t2, t2, t3
  la t3, rt_native_trace_ring
  add t3, t3, t2
  sw a1, 0(t3)
  sw a2, 4(t3)
  sw a0, 8(t3)
  addi t1, t1, 1
  li t2, 4096
  bne t1, t2, .L_native_trace_alloc_cursor
  addi t1, zero, 0
.L_native_trace_alloc_cursor:
  sw t1, 0(t0)
  la t0, rt_native_trace_total
  lw t1, 0(t0)
  addi t1, t1, 1
  sw t1, 0(t0)
  jalr zero, 0(ra)

rt_native_trace_dump:
  la t0, rt_native_trace_header
  addi t1, zero, 1
  sw t1, 0(t0)
  la t1, rt_native_trace_cursor
  lw t1, 0(t1)
  sw t1, 4(t0)
  la t1, rt_native_trace_total
  lw t1, 0(t1)
  sw t1, 8(t0)
  sw s1, 12(t0)
  sw s2, 16(t0)
  sw a0, 20(t0)
  li t1, 4096
  sw t1, 28(t0)
  la t1, rt_native_trace_stack
  addi t3, zero, 0
  addi t4, a1, 0
  la t5, _start
  la t6, rt_native_trace_alloc
.L_native_trace_stack_scan:
  bgeu t4, s0, .L_native_trace_stack_frames
  addi a3, zero, 64
  beq t3, a3, .L_native_trace_stack_done
  lw a3, 0(t4)
  bltu a3, t5, .L_native_trace_stack_scan_next
  bgeu a3, t6, .L_native_trace_stack_scan_next
  sw a3, 0(t1)
  addi t1, t1, 4
  addi t3, t3, 1
.L_native_trace_stack_scan_next:
  addi t4, t4, 4
  j .L_native_trace_stack_scan
.L_native_trace_stack_frames:
  addi t4, s0, 0
.L_native_trace_stack:
  beq t4, zero, .L_native_trace_stack_done
  addi t5, zero, 64
  beq t3, t5, .L_native_trace_stack_done
  lw t5, -4(t4)
  sw t5, 0(t1)
  addi t1, t1, 4
  addi t3, t3, 1
  lw t5, -8(t4)
  bgeu t4, t5, .L_native_trace_stack_done
  addi t4, t5, 0
  j .L_native_trace_stack
.L_native_trace_stack_done:
  sw t3, 24(t0)
  addi a0, zero, 2
  la a1, rt_native_trace_header
  li a2, 49440
  addi a7, zero, 64
  ecall
  jalr zero, 0(ra)

.section .bss
.balign 8
rt_native_trace_header:
  .space 32
rt_native_trace_ring:
  .space 49152
rt_native_trace_stack:
  .space 256
rt_native_trace_cursor:
  .word 0
rt_native_trace_total:
  .word 0
.section .text
"
}

skill alloc_hook() {
    out "  addi sp, sp, -32
  sw ra, 28(sp)
  sw a0, 24(sp)
  sw a1, 20(sp)
  sw a2, 16(sp)
  addi a1, ra, 0
  addi a2, s1, 0
  call rt_native_trace_alloc
  lw a2, 16(sp)
  lw a1, 20(sp)
  lw a0, 24(sp)
  lw ra, 28(sp)
  addi sp, sp, 32
"
}

skill failure_hook() {
    out "  addi sp, sp, -16
  sw ra, 12(sp)
  addi a0, ra, 0
  addi a1, sp, 16
  call rt_native_trace_dump
  lw ra, 12(sp)
  addi sp, sp, 16
"
}

skill native_trace_support() {
    @text = ".macro SALTIC_NATIVE_TRACE_ALLOC_HOOK\n"
    text = seed.str.add(text, alloc_hook())
    text = seed.str.add(text, ".endm\n\n.macro SALTIC_NATIVE_TRACE_FAILURE_HOOK\n")
    text = seed.str.add(text, failure_hook())
    text = seed.str.add(text, ".endm\n")
    out seed.str.add(text, instrumentation())
}

Instrument = Box {
    output = Output {}
    alloc_found = no
    failure_found = no
}

skill instrument_line(state, line) {
    state.output = output_add(state.output, seed.str.add(line, "\n"))
    (line == "rt_alloc:") {
        state.output = output_add(state.output, alloc_hook())
        state.alloc_found = yes
    }
    (line == "rt_out_of_memory:") {
        state.output = output_add(state.output, failure_hook())
        state.failure_found = yes
    }
    out state
}

skill instrument(source) {
    @state = Instrument {}
    @start = 0
    @index = 0
    @length = seed.str.len(source)
    drum (length) {
        (seed.str.at(source, index) == "\n") {
            @line = seed.str.slice(source, start, index)
            state = instrument_line(state, line)
            start = index + 1
        }
        index = index + 1
    }
    (start < length) {
        state = instrument_line(state, seed.str.slice(source, start, length))
    }
    (state.alloc_found == no) { out error.NativeTraceAllocatorMissing }
    (state.failure_found == no) { out error.NativeTraceFailureMissing }
    state.output = output_add(state.output, instrumentation())
    out output_text(state.output)
}

skill byte(source, offset) {
    out seed.str.byte(source, offset)
}

skill native_trace_word(source, offset) {
    out Word {
        b0 = byte(source, offset)
        b1 = byte(source, offset + 1)
        b2 = byte(source, offset + 2)
        b3 = byte(source, offset + 3)
    }
}

skill small(value) {
    (value.b3 > 15) { out 0 - 1 }
    out value.b0 + value.b1 * 256 + value.b2 * 65536 + value.b3 * 16777216
}

skill byte_bits(value) {
    @text = ""
    @weight = 128
    drum (8) {
        (value < weight) { text = seed.str.add(text, "0") }
        (value > weight - 1) {
            text = seed.str.add(text, "1")
            value = value - weight
        }
        weight = weight / 2
    }
    out text
}

skill word_bits(value) {
    @text = byte_bits(value.b3)
    text = seed.str.add(text, " ")
    text = seed.str.add(text, byte_bits(value.b2))
    text = seed.str.add(text, " ")
    text = seed.str.add(text, byte_bits(value.b1))
    text = seed.str.add(text, " ")
    out seed.str.add(text, byte_bits(value.b0))
}

skill display_name(name) {
    (seed.str.starts_with(name, "saltic_") == yes) {
        out seed.str.slice(name, 7, seed.str.len(name))
    }
    out name
}

skill containing(table, address) {
    @best = model.Symbol {}
    @index = 0
    @count = seed.group.count(table.symbols)
    drum (count) {
        @symbol = seed.group.at(table.symbols, index)
        (symbol.address < address + 1) {
            @inside = no
            (symbol.size > 0) {
                (address < symbol.address + symbol.size) { inside = yes }
            }
            (inside == yes) { out symbol }
            (best.present == no) { best = symbol }
            (best.present == yes) {
                (symbol.address > best.address) { best = symbol }
            }
        }
        index = index + 1
    }
    out best
}

skill symbol_text(table, address) {
    @symbol = containing(table, address)
    (symbol.present == no) { out "неизвестная функция" }
    out display_name(symbol.name)
}

skill show_allocation(source, table, sequence, index) {
    @offset = RING_OFFSET + index * EVENT_SIZE
    @caller = small(native_trace_word(source, offset))
    @heap = native_trace_word(source, offset + 4)
    @size_word = native_trace_word(source, offset + 8)
    @size = small(size_word)
    @size_text = word_bits(size_word)
    (size > 0 - 1) { size_text = seed.num.text(size) }
    seed.io.show(sequence, " память ", word_bits(heap), " +", size_text, " ← ", symbol_text(table, caller))
    out none
}

skill render(elf_path, trace_path) {
    @binary = seed.file.read(elf_path) rescue |failure| {
        out error.NativeTraceElfReadFailed
    }
    @source = elf.image(binary)
    @table = elf.symbols(source)
    (table.ok == no) { out error.NativeTraceSymbolsMissing }
    @trace = seed.file.read(trace_path) rescue |failure| {
        out error.NativeTraceReadFailed
    }
    (seed.str.len(trace) < TRACE_SIZE) { out error.NativeTraceTruncated }
    @version = small(native_trace_word(trace, 0))
    (version == 1) {
        @cursor = small(native_trace_word(trace, 4))
        @total = small(native_trace_word(trace, 8))
        @heap = native_trace_word(trace, 12)
        @limit = native_trace_word(trace, 16)
        @caller = small(native_trace_word(trace, 20))
        @frame_count = small(native_trace_word(trace, 24))
        @capacity = small(native_trace_word(trace, 28))
        (capacity == EVENT_CAPACITY) {
            seed.io.show("нативная трассировка компилятора")
            seed.io.show("куча: ", word_bits(heap), " из ", word_bits(limit))
            seed.io.show("остановка: ", symbol_text(table, caller))

            @available = total
            (available > capacity) { available = capacity }
            @visible = available
            (visible > VISIBLE_EVENTS) { visible = VISIBLE_EVENTS }
            @start = cursor - visible
            (start < 0) { start = start + capacity }
            @event_index = 0
            drum (visible) {
                @physical = start + event_index
                (physical > capacity - 1) { physical = physical - capacity }
                show_allocation(trace, table, total - visible + event_index + 1, physical)
                event_index = event_index + 1
            }

            seed.io.show("стек Saltic:")
            @frame_index = 0
            drum (frame_count) {
                @address = small(native_trace_word(trace, STACK_OFFSET + frame_index * 4))
                seed.io.show("  ", frame_index, " ", symbol_text(table, address))
                frame_index = frame_index + 1
            }
            out none
        }
    }
    out error.NativeTraceInvalid
}

program(mode, first, second) {
    (mode == "support") {
        seed.file.write(second, native_trace_support())
        seed.io.show("нативная трассировка: опорный код создан")
        out none
    }
    (mode == "instrument") {
        @source = seed.file.read(first) rescue |failure| {
            out error.NativeTraceAssemblyReadFailed
        }
        @result = instrument(source) rescue |failure| {
            out failure
        }
        seed.file.write(second, result)
        seed.io.show("нативная трассировка: инструментирован ", first)
        out none
    }
    (mode == "render") {
        out render(first, second)
    }
    out error.NativeTraceMode
}
