-- slider — ползунок JTML без дерева: положение в пределах, шаг стрелкой,
-- положение по щелчку и рисунок (дорожка, заполненная часть, ручка).
-- Числа целые; шаг — двадцатая часть пределов, не меньше 1.
--
-- HEIGHT — высота ползунка в пикселях; KEY_LEFT, KEY_RIGHT — скан-коды evdev
-- clamp(level, least, most) -> level в пределах
-- step(level, least, most, code) -> новое положение по стрелке; иная клавиша —
--     то же положение
-- at(x, left, width, least, most) -> положение под точкой x
-- draw(screen, x, y, width, level, least, most, focused) — рисунок; в фокусе —
--     рамка вокруг

use os.drivers.graphics

HEIGHT = 24
TRACK = 4
KNOB = 8
KEY_LEFT = 105
KEY_RIGHT = 106
STEPS = 20

skill clamp(level, least, most) {
    (level < least) { out least }
    (level > most) { out most }
    out level
}

skill step(level, least, most, code) {
    @size = (most - least) / STEPS
    (size < 1) { size = 1 }
    (code == KEY_LEFT) { out clamp(level - size, least, most) }
    (code == KEY_RIGHT) { out clamp(level + size, least, most) }
    out level
}

skill at(x, left, width, least, most) {
    (width < 1) { out least }
    out clamp(least + (x - left) * (most - least) / width, least, most)
}

skill draw(screen, x, y, width, level, least, most, focused) {
    @span = most - least
    (span < 1) { span = 1 }
    @filled = (clamp(level, least, most) - least) * width / span
    @middle = y + HEIGHT / 2
    graphics.graphics_rect(screen, x, y, width, HEIGHT, graphics.Ink.BACKGROUND)
    graphics.graphics_frame(screen, x, middle - TRACK / 2, width, TRACK, 1, graphics.Ink.FOREGROUND)
    graphics.graphics_rect(screen, x, middle - TRACK / 2, filled, TRACK, graphics.Ink.FOREGROUND)
    graphics.graphics_rect(screen, x + filled - KNOB / 2, y + 2, KNOB, HEIGHT - 4, graphics.Ink.FOREGROUND)
    (focused == yes) { graphics.graphics_frame(screen, x - 3, y - 1, width + 6, HEIGHT + 2, 1, graphics.Ink.FOREGROUND) }
    out none
}
