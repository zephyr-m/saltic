-- atom — четыре атома JTML, из которых собирается любой интерфейс (атомарный
-- дизайн, решение автора 08.11.2026): BOX компонует и хранит в себе что
-- угодно (колонка или ряд с отступами, рамкой и grow), TEXT — текст, FIELD —
-- поле для текста, SLIDER — ползунок. Кнопки, вкладки, флажки — не атомы, а
-- сборки из этих четырёх; рисующего кода у них нет.
--
-- Kind — UNKNOWN, BOX, TEXT, FIELD, SLIDER; Flow — COLUMN, ROW; Align — START,
--     CENTER, END
-- Node { kind, id, value, align, flow, width, height, grow, padding, gap,
--     border, children, level, least, most } — value — текст TEXT и FIELD;
--     level, least, most — положение и пределы SLIDER; tone — имя цвета из
--     палитры экрана (у TEXT — буквы, у BOX — рамка или заливка), "" — свой
-- frame(flow, width, height, grow, padding, gap, border, children) -> BOX
-- form(children) / row(children) / space(grow) -> BOX
-- text(value) / label(value, align) / target_text(id, value) -> TEXT
-- field(id, value) / field_grow(id, value) -> FIELD
-- slider(id, level, least, most) -> SLIDER, растягивается по главной оси

DEFAULT_GAP = 20

Kind = enum {
    UNKNOWN,
    BOX,
    TEXT,
    FIELD,
    SLIDER
}

Flow = enum {
    COLUMN,
    ROW
}

Align = enum {
    START,
    CENTER,
    END
}

Node = Box {
    kind = Kind.UNKNOWN,
    id = "",
    value = "",
    align = Align.START,
    flow = Flow.COLUMN,
    width = 0,
    height = 0,
    grow = 0,
    padding = 0,
    gap = 0,
    border = 0,
    children = [],
    level = 0,
    least = 0,
    most = 100,
    tone = ""
}

skill frame(flow, width, height, grow, padding, gap, border, children) {
    out Node {
        kind = Kind.BOX,
        flow = flow,
        width = width,
        height = height,
        grow = grow,
        padding = padding,
        gap = gap,
        border = border,
        children = children
    }
}

skill form(children) {
    out frame(Flow.COLUMN, 0, 0, 0, 0, DEFAULT_GAP, 0, children)
}

skill row(children) {
    out frame(Flow.ROW, 0, 0, 0, 0, DEFAULT_GAP, 0, children)
}

skill space(grow) {
    out frame(Flow.COLUMN, 0, 0, grow, 0, 0, 0, [])
}

skill text(value) {
    out Node { kind = Kind.TEXT, value = value }
}

skill target_text(id, value) {
    out Node { kind = Kind.TEXT, id = id, value = value }
}

skill label(value, align) {
    out Node { kind = Kind.TEXT, value = value, align = align }
}

skill field(id, value) {
    out Node { kind = Kind.FIELD, id = id, value = value }
}

skill field_grow(id, value) {
    out Node { kind = Kind.FIELD, id = id, value = value, grow = 1 }
}

skill slider(id, level, least, most) {
    out Node { kind = Kind.SLIDER, id = id, level = level, least = least, most = most, grow = 1 }
}
