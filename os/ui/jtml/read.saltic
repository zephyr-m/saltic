-- read — текст JTML в дерево атомов (jtml/atom). Узел — объект с одним
-- ключом-тегом, тегов ровно четыре:
--   {"box": {"flow": "row" | "column", "width", "height", "grow", "padding",
--            "gap", "border", "tone", "children": [узлы]}}
--   {"text": {"value", "id", "align": "start" | "center" | "end", "grow", "tone"}}
--   {"field": {"id", "value", "grow"}}
--   {"slider": {"id", "value", "min", "max"}}
-- Пропущенное свойство — умолчание атома (gap у box — atom.DEFAULT_GAP). Иной
-- тег — ошибка UnknownAtom: компонент собирают из атомов, а не рисуют кодом.
--
-- page(source) -> atom.Node корня; BadJtml (reader), UnknownAtom, NotAtom
-- node(value) -> atom.Node из прочитанного reader.Value
-- Внутри: prop, words, amount, children_of — свойства объекта

use core.group
use os.ui.jtml.atom
use os.ui.jtml.reader

skill page(source) {
    out node(reader.read_jtml(source))
}

skill prop(props, name) {
    drum (group.count(props.keys)) {
        (group.get(props.keys, beat) == name) { out group.get(props.items, beat) }
    }
    out reader.Value {}
}

skill words(props, name, fallback) {
    @found = prop(props, name)
    (found.kind == reader.Kind.WORDS) { out found.words }
    out fallback
}

skill amount(props, name, fallback) {
    @found = prop(props, name)
    (found.kind == reader.Kind.AMOUNT) { out found.amount }
    out fallback
}

skill children_of(props) {
    @found = prop(props, "children")
    @nodes = []
    (found.kind == reader.Kind.JTML_ARRAY) {
        drum (group.count(found.items)) { nodes = group.add(nodes, node(group.get(found.items, beat))) }
    }
    out nodes
}

skill node(value) {
    ((value.kind == reader.Kind.JTML_OBJECT) == no) { out error.NotAtom }
    @tag = group.get(value.keys, 0)
    @props = group.get(value.items, 0)
    (tag == "box") {
        @flow = atom.Flow.COLUMN
        (words(props, "flow", "column") == "row") { flow = atom.Flow.ROW }
        @made = atom.frame(flow, amount(props, "width", 0), amount(props, "height", 0), amount(props, "grow", 0), amount(props, "padding", 0), amount(props, "gap", atom.DEFAULT_GAP), amount(props, "border", 0), children_of(props))
        made.tone = words(props, "tone", "")
        out made
    }
    (tag == "text") {
        @align = atom.Align.START
        (words(props, "align", "") == "center") { align = atom.Align.CENTER }
        (words(props, "align", "") == "end") { align = atom.Align.END }
        out atom.Node { kind = atom.Kind.TEXT, id = words(props, "id", ""), value = words(props, "value", ""), align = align, grow = amount(props, "grow", 0), tone = words(props, "tone", "") }
    }
    (tag == "field") {
        out atom.Node { kind = atom.Kind.FIELD, id = words(props, "id", ""), value = words(props, "value", ""), grow = amount(props, "grow", 0) }
    }
    (tag == "slider") {
        out atom.slider(words(props, "id", ""), amount(props, "value", 0), amount(props, "min", 0), amount(props, "max", 100))
    }
    out error.UnknownAtom
}
