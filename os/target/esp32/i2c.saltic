-- i2c — железный I2C0 ESP32, ведущий, 800 кГц от шины APB 80 МГц: SDA — GPIO
-- 23, SCL — GPIO 22 через матрицу GPIO, ножки — открытый сток. Передача — до
-- CHUNK байт за раз: байты в FIFO, команды RSTART, WRITE, STOP, старт, ждём
-- конца. Регистры GPIO, IO_MUX и I2C — по адресам шины AHB (0x6000_xxxx): по
-- 0x3FF4_xxxx блок GPIO на нашей загрузке молчит (проверено на DevKit).
-- Прежний драйвер ногодрыгом — .archive/os/target/esp32/i2c-pins.saltic.
--
-- setup() — тактирование I2C0, ножки, частота, FIFO; сначала recover()
-- recover() — девять тактов SCL и STOP вручную: ведомый, застрявший на
--     полубайте (ESP сбросили посреди передачи, экран — нет), отпускает SDA
-- send(bytes) -> yes, если ведомый ответил на все байты (нет ответа или
--     таймаут шины — no); bytes — группа чисел, первое — адрес ведомого со
--     сдвигом (0x3C → 120)
-- begin() / push(byte) / finish(count) -> yes/no — то же по байту, без группы:
--     до CHUNK байт между begin и finish; нет ни конца, ни отказа за PATIENCE
--     опросов — шина и блок заново (setup) и no; fifo() -> address FIFO — писать
--     байты самому: mem.store32(fifo, 0, байт)
-- gpio() / io_mux() -> address блоков (берёт и blink)
-- Внутри: i2c(), dport(), put(base, offset, value), get(base, offset) -> u32,
--     bit(value, mask) -> yes/no

use core.address
use core.usize
use core.u32
use core.mem
use core.bits32
use core.group

CHUNK = 32
CLOCK_ENABLE = 192
I2C0 = 128
CTR = 4
MASTER = 275
START = 307
TIMEOUT = 12
FIFO_CONF = 24
FIFO_RESET = 12288
FIFO = 28
INT_RAW = 32
INT_CLEAR = 36
EVERYTHING = 131071
DONE = 128
NACK = 1024
LATE = 256
COMMAND = 88
RSTART = 0
WRITE = 2048
STOP = 6144
CHECK_ACK = 256
PATIENCE = 20000
TIMINGS = [[0, 50], [56, 50], [48, 20], [52, 20], [64, 50], [68, 50], [72, 50], [76, 50], [80, 15], [84, 15]]
ENABLE_SET = 36
OPEN_DRAIN = 4
PIN_SCL = 224
PIN_SDA = 228
OUT_SELECT_SCL = 1416
OUT_SELECT_SDA = 1420
IN_SELECT_SCL = 420
IN_SELECT_SDA = 424
SCL_SIGNAL = 29
SDA_SIGNAL = 30
FROM_MATRIX = 128
MUX_SCL = 128
MUX_SDA = 140
MUX_GPIO = 8960
BOTH_PINS = 12582912
SCL_PIN = 4194304
SDA_PIN = 8388608
OUT_SET = 8
OUT_CLEAR = 12
SIMPLE_OUTPUT = 256

skill gpio() {
    out address.from(1610629120)
}

skill io_mux() {
    out address.from(1610649600)
}

skill i2c() {
    out address.from(1610690560)
}

skill dport() {
    out address.from(1072693248)
}

skill put(base, offset, value) {
    out mem.store32(base, usize.from(offset), u32.from(value))
}

skill get(base, offset) {
    out mem.load32(base, usize.from(offset))
}

skill bit(value, mask) {
    (bits32.and(bits32.from(value), bits32.from(mask)) == bits32.from(0)) { out no }
    out yes
}

skill recover() {
    put(gpio(), OUT_SELECT_SCL, SIMPLE_OUTPUT)
    put(gpio(), OUT_SELECT_SDA, SIMPLE_OUTPUT)
    put(gpio(), OUT_SET, BOTH_PINS)
    put(gpio(), ENABLE_SET, BOTH_PINS)
    drum (9) {
        put(gpio(), OUT_CLEAR, SCL_PIN)
        put(gpio(), OUT_SET, SCL_PIN)
    }
    put(gpio(), OUT_CLEAR, SDA_PIN)
    put(gpio(), OUT_CLEAR, SCL_PIN)
    put(gpio(), OUT_SET, SCL_PIN)
    out put(gpio(), OUT_SET, SDA_PIN)
}

skill setup() {
    @clocks = get(dport(), CLOCK_ENABLE)
    (bit(clocks, I2C0) == no) { mem.store32(dport(), usize.from(CLOCK_ENABLE), clocks + u32.from(I2C0)) }
    put(io_mux(), MUX_SCL, MUX_GPIO)
    put(io_mux(), MUX_SDA, MUX_GPIO)
    put(gpio(), PIN_SCL, OPEN_DRAIN)
    put(gpio(), PIN_SDA, OPEN_DRAIN)
    recover()
    put(gpio(), OUT_SELECT_SCL, SCL_SIGNAL)
    put(gpio(), OUT_SELECT_SDA, SDA_SIGNAL)
    put(gpio(), IN_SELECT_SCL, 22 + FROM_MATRIX)
    put(gpio(), IN_SELECT_SDA, 23 + FROM_MATRIX)
    put(gpio(), ENABLE_SET, BOTH_PINS)
    put(i2c(), CTR, MASTER)
    drum (TIMINGS) { put(i2c(), group.get(beat, 0), group.get(beat, 1)) }
    put(i2c(), TIMEOUT, 1048575)
    put(i2c(), FIFO_CONF, FIFO_RESET)
    out put(i2c(), FIFO_CONF, 0)
}

skill begin() {
    put(i2c(), FIFO_CONF, FIFO_RESET)
    out put(i2c(), FIFO_CONF, 0)
}

skill push(byte) {
    out put(i2c(), FIFO, byte)
}

skill fifo() {
    out address.add(i2c(), usize.from(FIFO))
}

skill finish(count) {
    put(i2c(), COMMAND, RSTART)
    put(i2c(), COMMAND + 4, WRITE + CHECK_ACK + count)
    put(i2c(), COMMAND + 8, STOP)
    put(i2c(), INT_CLEAR, EVERYTHING)
    put(i2c(), CTR, START)
    @waited = 0
    always {
        @raw = get(i2c(), INT_RAW)
        (bit(raw, NACK + LATE) == yes) {
            put(i2c(), CTR, MASTER)
            out no
        }
        (bit(raw, DONE) == yes) { leave }
        waited = waited + 1
        (waited > PATIENCE) {
            setup()
            out no
        }
    }
    out yes
}

skill send(bytes) {
    begin()
    drum (bytes) { push(beat) }
    out finish(group.count(bytes))
}
