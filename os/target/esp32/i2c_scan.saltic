-- i2c_scan — кто отвечает на шине I2C (SDA — 23, SCL — 22): все адреса
-- 8…119, давшие ACK. Отвечают все — линия SDA прилипла к нулю.

use io
use os.target.esp32.i2c

program() {
    i2c.setup()
    @found = 0
    drum (112) {
        @address = beat + 8
        (i2c.send([address * 2]) == yes) {
            io.show("ответил адрес {address}")
            found = found + 1
        }
    }
    io.show("ответили: {found}")
    out none
}
