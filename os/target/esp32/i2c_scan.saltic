-- i2c_scan — кто отвечает на шине I2C (SDA — 23, SCL — 22): уровень SDA в
-- покое и все адреса 8…119, давшие ACK. Отвечают все — SDA прилипла к нулю.

use io
use os.target.esp32.i2c

program() {
    i2c.setup()
    @idle = "0 — прилипла"
    (i2c.sda_high() == yes) { idle = "1 — свободна" }
    io.show("SDA в покое: {idle}")
    @found = 0
    drum (112) {
        @address = beat + 8
        i2c.start()
        @ack = i2c.write(address * 2)
        i2c.stop()
        (ack == yes) {
            io.show("ответил адрес {address}")
            found = found + 1
        }
    }
    io.show("ответили: {found}")
    out none
}
