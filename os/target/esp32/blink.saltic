-- blink — синий светодиод DevKit на GPIO 2: горит и гаснет по счётчику
-- тактов (time.now на ESP32 — такты ядра, 160 МГц). GPIO — по адресам AHB,
-- как в i2c.

use io
use core.time
use core.usize
use core.u32
use core.mem
use os.target.esp32.i2c

LED = 4
OUT_SET = 8
OUT_CLEAR = 12
ENABLE_SET = 36
OUT_SELECT_LED = 1336
MUX_LED = 64
MUX_GPIO = 8192
SIMPLE_OUTPUT = 256
HALF = 80000000

skill pause(ticks) {
    @start = time.now()
    always {
        (time.elapsed(start, time.now()) >= ticks) { leave }
    }
    out none
}

program() {
    mem.store32(i2c.io_mux(), usize.from(MUX_LED), u32.from(MUX_GPIO))
    mem.store32(i2c.gpio(), usize.from(OUT_SELECT_LED), u32.from(SIMPLE_OUTPUT))
    mem.store32(i2c.gpio(), usize.from(ENABLE_SET), u32.from(LED))
    io.show("мигаю светодиодом на GPIO 2")
    always {
        mem.store32(i2c.gpio(), usize.from(OUT_SET), u32.from(LED))
        pause(HALF)
        mem.store32(i2c.gpio(), usize.from(OUT_CLEAR), u32.from(LED))
        pause(HALF)
    }
    out none
}
