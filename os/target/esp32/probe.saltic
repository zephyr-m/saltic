-- probe — программа для проверки бэкенда на плате: группа из 40, рекурсия,
-- Box с отрицательным полем, деление и остаток, склейка текста. Эталон вывода —
-- tests/expected/esp32-probe.txt, гоняет workbench/check/esp32.

use io
use core.group

Point = Box {
    x = 0,
    y = 0
}

skill sum(items) {
    @total = 0
    drum (group.count(items)) { total = total + group.get(items, beat) }
    out total
}

skill fact(n) {
    (n < 2) { out 1 }
    out n * fact(n - 1)
}

program() {
    @items = []
    drum (40) { items = group.add(items, beat * 3) }
    @total = sum(items)
    io.show("сумма {total}")
    @f = fact(10)
    io.show("факториал {f}")
    @p = Point { x = 7, y = 0 - 5 }
    io.show("точка {p.x} {p.y}")
    @q = 1000 / 7
    @r = 1000 % 7
    io.show("деление {q} остаток {r}")
    @text = "ab"
    drum (3) { text = "{text}{text}" }
    io.show("текст {text}")
    out none
}
