-- toolchain — сборка программы Saltic в образ ESP32.
-- Запуск: toolchain <исходник> <выход.bin> <куча байт>

use core.str
use core.group
use io
use io.file
use compiler.architect
use compiler.checker
use compiler.gorn
use compiler.gorn.backend.xtensa.lx6
use compiler.gorn.backend.xtensa.lx6.asm
use compiler.gorn.machine.wide
use compiler.gorn.platform.esp32

skill show_diagnostics(diagnostics) {
    drum (group.count(diagnostics)) {
        @item = group.get(diagnostics, beat)
        io.show("{item.code}|{item.line}|{item.col}|{item.message}")
    }
    out none
}

program(source_path, output_path, heap_text) {
    @plan = Architect {}
    io.show("esp32: читаю {source_path}")
    @loaded = plan.gather(source_path)
    plan.told(loaded)
    (group.count(loaded.diagnostics) > 0) {
        show_diagnostics(loaded.diagnostics)
        out error.ParseFailed
    }
    io.show("esp32: проверяю")
    @inspector = Checker {}
    @checked = inspector.check_file(loaded.ast, source_path)
    (group.count(checked.diagnostics) > 0) {
        show_diagnostics(checked.diagnostics)
        out error.CheckFailed
    }
    (str.starts_with(heap_text, "-") == yes) { out error.ValueOutsideRange }
    @heap_size = wide.from_decimal(heap_text)
    io.show("esp32: собираю")
    @machine = gorn.compile_machine(checked.tree, heap_size, lx6.Executor {}, esp32.Esp32 {})
    io.show("esp32: пишу {output_path}")
    @writer = asm.Assembler {}
    @blob = writer.image_of(machine)
    file.write_bytes(output_path, blob)
    out none
}
