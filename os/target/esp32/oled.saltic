-- oled — текст на экране SSD1306 (I2C: SDA — GPIO 23, SCL — GPIO 22, VCC —
-- 3V3, GND). Экран не ответил — пишет в UART, что проверить.

use io
use os.target.esp32.ssd1306

program() {
    (ssd1306.start() == no) {
        io.show("экран не ответил: проверь SDA — 23, SCL — 22, VCC — 3V3, GND")
        out none
    }
    ssd1306.lines(["Привет, Зэф!", "", "Saltic на ESP32", "Xtensa LX6", "", "экран SSD1306", "I2C ногодрыгом"])
    io.show("экран: текст выведен")
    out none
}
