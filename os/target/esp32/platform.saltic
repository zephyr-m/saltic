-- platform — голое железо ESP32-D0WD. Вход ставит стек, гасит сторожей
-- TIMG0 и RTC, переводит ядро с кварца 40 МГц на PLL 160 МГц (CPU_PER_CONF = 1,
-- CLK_CONF: источник PLL; RTC — по адресу AHB), шина APB — 80 МГц, делитель
-- UART0 на 115200 от неё, печатает «S» —
-- платформа жива, обнуляет BSS. write пишет FIFO UART0. Свободной DRAM около
-- 180 КБ на всё: ARENA_BYTES и HEAP_BYTES — арена и куча по умолчанию.
-- exit крутится на месте. now — 28-битный счётчик тактов ядра числом Saltic.

use selfhost.abi
use selfhost.compiler.backend
use selfhost.compiler.platform
use selfhost.compiler.backend.xtensa.asm

ARENA_BYTES = 16384
HEAP_BYTES = 65536

skill pack(b0, b1, b2, b3) {
    out b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

skill stack_top() { out pack(0, 224, 253, 63) }
skill timg_prot() { out pack(100, 240, 245, 63) }
skill timg_cfg() { out pack(72, 240, 245, 63) }
skill rtc_prot() { out pack(164, 128, 244, 63) }
skill rtc_cfg() { out pack(140, 128, 244, 63) }
skill wdt_key() { out pack(161, 58, 216, 80) }
skill uart_status() { out pack(28, 0, 244, 63) }
skill uart_fifo() { out pack(0, 0, 244, 63) }
skill uart_clk() { out pack(20, 0, 244, 63) }
skill uart_div() { out pack(182, 2, 112, 0) }
skill cpu_per_conf() { out pack(60, 0, 240, 63) }
skill clk_conf() { out pack(112, 128, 0, 96) }
skill clk_pll() { out pack(16, 50, 0, 8) }

skill putc(compiler, mark, byte) {
    @e = compiler.executor
    @wait = ".L_xt_putc_{mark}"
    compiler = e.label(compiler, wait)
    compiler = e.load_immediate(compiler, backend.SCRATCH0, uart_status())
    compiler = e.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = e.shift_right_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH1, 16)
    compiler = e.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 128)
    compiler = e.branch_nonzero(compiler, backend.SCRATCH1, wait)
    compiler = e.load_immediate(compiler, backend.SCRATCH1, byte)
    compiler = e.load_immediate(compiler, backend.SCRATCH0, uart_fifo())
    out e.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
}

MISSING = ["key", "file_read", "file_write", "file_write_program", "firmware", "call", "process_pipe", "process_wait", "process_read", "process_close", "process_executable", "environment", "file_list", "process_open", "process_input", "process_write", "log_open", "read_line"]

skill unlock(compiler, prot, cfg) {
    @e = compiler.executor
    compiler = e.load_immediate(compiler, backend.SCRATCH0, prot)
    compiler = e.load_immediate(compiler, backend.SCRATCH1, wdt_key())
    compiler = e.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = e.load_immediate(compiler, backend.SCRATCH0, cfg)
    compiler = e.load_immediate(compiler, backend.SCRATCH1, 0)
    out e.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
}

skill write_loop(compiler) {
    @e = compiler.executor
    compiler = e.label(compiler, "rt_platform_write")
    compiler = e.move(compiler, backend.SCRATCH2, backend.ARG2)
    compiler = e.label(compiler, ".L_xt_write")
    compiler = e.branch_zero(compiler, backend.ARG2, ".L_xt_write_done")
    compiler = e.label(compiler, ".L_xt_wait")
    compiler = e.load_immediate(compiler, backend.SCRATCH0, uart_status())
    compiler = e.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = e.shift_right_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH1, 16)
    compiler = e.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 128)
    compiler = e.branch_nonzero(compiler, backend.SCRATCH1, ".L_xt_wait")
    compiler = e.load_byte(compiler, backend.SCRATCH1, backend.ERROR, 0)
    compiler = e.load_immediate(compiler, backend.SCRATCH0, uart_fifo())
    compiler = e.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = e.add_immediate(compiler, backend.ERROR, backend.ERROR, 1)
    compiler = e.add_immediate(compiler, backend.ARG2, backend.ARG2, 0 - 1)
    compiler = e.jump(compiler, ".L_xt_write")
    compiler = e.label(compiler, ".L_xt_write_done")
    compiler = e.move(compiler, backend.VALUE, backend.SCRATCH2)
    compiler = e.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out e.ret(compiler)
}

Platform = Box {
    name = "esp32",
    arena_bytes = ARENA_BYTES,
    default_heap_bytes = HEAP_BYTES

    skill append(compiler) {
        @e = compiler.executor
        compiler = e.label(compiler, "platform_start")
        compiler = e.load_immediate(compiler, backend.STACK, stack_top())
        compiler = unlock(compiler, timg_prot(), timg_cfg())
        compiler = unlock(compiler, rtc_prot(), rtc_cfg())
        compiler = e.load_immediate(compiler, backend.SCRATCH0, cpu_per_conf())
        compiler = e.load_immediate(compiler, backend.SCRATCH1, 1)
        compiler = e.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
        compiler = e.load_immediate(compiler, backend.SCRATCH0, clk_conf())
        compiler = e.load_immediate(compiler, backend.SCRATCH1, clk_pll())
        compiler = e.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
        compiler = e.load_immediate(compiler, backend.SCRATCH0, uart_clk())
        compiler = e.load_immediate(compiler, backend.SCRATCH1, uart_div())
        compiler = e.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
        compiler = putc(compiler, "s", 83)
        compiler = putc(compiler, "n", 10)
        compiler = e.load_address(compiler, backend.VALUE, asm.BSS_START, 0)
        compiler = e.load_address(compiler, backend.ERROR, asm.BSS_SIZE, 0)
        compiler = e.label(compiler, ".L_xt_zero")
        compiler = e.branch_zero(compiler, backend.ERROR, ".L_xt_zero_done")
        compiler = e.store_zero(compiler, backend.VALUE, 0)
        compiler = e.add_immediate(compiler, backend.VALUE, backend.VALUE, 4)
        compiler = e.add_immediate(compiler, backend.ERROR, backend.ERROR, 0 - 4)
        compiler = e.jump(compiler, ".L_xt_zero")
        compiler = e.label(compiler, ".L_xt_zero_done")
        compiler = e.add_immediate(compiler, backend.STACK, backend.STACK, 0 - 16)
        compiler = e.load_immediate(compiler, backend.SCRATCH0, 1)
        compiler = e.store(compiler, backend.SCRATCH0, backend.STACK, 0)
        compiler = e.load_address(compiler, backend.SCRATCH0, "xt_argv0", 0)
        compiler = e.store(compiler, backend.SCRATCH0, backend.STACK, 4)
        compiler = e.store_zero(compiler, backend.STACK, 8)
        compiler = e.store_zero(compiler, backend.STACK, 12)
        compiler = e.jump(compiler, "_start")
        compiler = e.data_label(compiler, backend.RODATA, "xt_argv0")
        compiler = e.data_text(compiler, backend.RODATA, "saltic")
        compiler = write_loop(compiler)
        compiler = e.label(compiler, "rt_platform_exit")
        compiler = e.label(compiler, ".L_xt_hang")
        compiler = e.jump(compiler, ".L_xt_hang")
        compiler = e.label(compiler, platform.WAIT)
        compiler = e.wait(compiler)
        compiler = e.load_immediate(compiler, backend.VALUE, abi.NONE)
        compiler = e.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
        compiler = e.ret(compiler)
        compiler = e.label(compiler, platform.NOW)
        compiler = e.read_cycles(compiler)
        compiler = e.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        compiler = e.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
        compiler = e.ret(compiler)
        compiler = platform.append_heap_reserve(compiler)
        drum (MISSING) { compiler = platform.emit_unsupported(compiler, beat) }
        out compiler
    }
}
