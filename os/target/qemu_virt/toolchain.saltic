-- toolchain — сборщик bare-metal ELF для qemu-virt (RV32I): разбор, проверка,
-- компиляция и дописывание платформенного кода (os.target.qemu_virt.platform).
-- Запуск: toolchain <исходник> <выход> <куча>; куча — десятичное число байт.
-- Если образ больше 1 МБ — пересобирает с дальними вызовами.
--
-- program(source_path, output_path, heap_text) — точка входа; ParseFailed,
--     CheckFailed, ValueOutsideRange (куча с минусом), WriteFailed
-- show_diagnostics(diagnostics) — печатает код|строка|колонка|сообщение

use core.str
use core.group
use io
use selfhost.parser
use selfhost.checker
use selfhost.compiler
use selfhost.compiler.backend.rv32i
use selfhost.compiler.backend.rv32i.machine.image
use os.target.qemu_virt.platform
use selfhost.machine.wide

skill show_diagnostics(diagnostics) {
    @index = 0
    @count = group.count(diagnostics)
    drum (count) {
        @item = group.get(diagnostics, index)
        io.show("{item.code}|{item.line}|{item.col}|{item.message}")
        index = index + 1
    }
    out none
}

program(source_path, output_path, heap_text) {
    io.show("qemu-virt: читаю {source_path}")
    @loaded = parser.load_modules(source_path, ".")
    (group.count(loaded.diagnostics) > 0) {
        show_diagnostics(loaded.diagnostics)
        out error.ParseFailed
    }

    io.show("qemu-virt: проверяю")
    @checked = checker.check_file(loaded.ast, source_path)
    (group.count(checked.diagnostics) > 0) {
        show_diagnostics(checked.diagnostics)
        out error.CheckFailed
    }

    (str.starts_with(heap_text, "-") == yes) { out error.ValueOutsideRange }
    @heap_size = wide.from_decimal(heap_text)
    io.show("qemu-virt: собираю")
    @machine = compiler.compile_machine(checked.tree, heap_size, rv32i.Executor {}, platform.Platform {})
    machine = platform.append(machine)
    io.show("qemu-virt: пишу {output_path}")
    image.write(output_path, machine) rescue |failure| {
        io.show("qemu-virt: код больше 1 МБ, собираю с дальними вызовами")
        @far = compiler.compile_machine(checked.tree, heap_size, rv32i.Executor { far_calls = yes }, platform.Platform {})
        far = platform.append(far)
        image.write(output_path, far) rescue |again| { out error.WriteFailed }
        out none
    }
    out none
}
