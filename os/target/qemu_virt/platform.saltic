-- platform — машинный код платформы qemu-virt для RV32I: вход, ловушка,
-- вывод в UART 16550 (0x10000000), выход через SiFive test (0x100000).
-- Всё дописывается в цель компилятора (rv32i.emit); точка входа становится
-- platform_start, адрес загрузки 0x80000000. Программа видит argv ["saltic"].
-- Системные вызовы через ecall: 64 — write, 93/94 — exit; прочие ловушки
-- печатают причину и адрес в UART и выходят с ошибкой.
--
-- Platform { name } — платформа договора (compiler/platform): append(compiler) —
--     wait через wfi, куча — свой bss (platform.append_heap_reserve), остальное
--     (key, файлы, now, firmware, call) — NotSupported
-- append(target) -> target — вся платформа целиком (вход, ловушка, UART); вход из toolchain
-- append_entry(target, boot_trampoline) / append_trap / append_uart_bits /
--     append_direct_write / append_direct_exit / append_trap_write /
--     append_exit / append_data(target) -> target — части по отдельности
-- show_banner() — печатает приветствие (для smoke)

use io
use selfhost.abi
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.codec
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.machine.word
use selfhost.compiler.backend
use selfhost.compiler.platform

UART_BASE_UPPER = 65536
UART_LSR = 5
UART_TX_READY = 32
QEMU_TEST_UPPER = 256
QEMU_EXIT_OK = 21845
QEMU_EXIT_ERROR = 13107
STACK_TOP_UPPER = 557056

UNSUPPORTED = ["key", "file_read", "file_write", "now", "firmware", "call"]

Platform = Box {
    name = "qemu_virt"

    skill append(compiler) {
        @executor = compiler.executor
        compiler = executor.label(compiler, platform.WAIT)
        compiler = executor.wait(compiler)
        compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
        compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
        compiler = executor.ret(compiler)
        compiler = platform.append_heap_reserve(compiler)
        out platform.append_unsupported(compiler, UNSUPPORTED)
    }
}

skill append_entry(target, boot_trampoline) {
    target = rv32i.label(target, layout.Section.CODE, "platform_start")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LUI, registers.SP, registers.ZERO, registers.ZERO, STACK_TOP_UPPER))
    target = rv32i.relative_address(target, registers.T0, "platform_trap", 0)
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.CSRRW, registers.ZERO, registers.T0, registers.ZERO, 773))
    target = rv32i.relative_address(target, registers.A1, "platform_argv", 0)
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 1))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 0))
    target = rv32i.relative_address(target, registers.T0, "platform_name", 0)
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.SP, registers.T0, 4))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.SP, registers.ZERO, 8))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.SP, registers.ZERO, 12))
    (boot_trampoline == yes) {
        target = rv32i.relative_address(target, registers.T0, "_start", 8)
        out rv32i.emit(target, rv32i.operation(instruction.Kind.JALR, registers.ZERO, registers.T0, registers.ZERO, 0))
    }
    out rv32i.jump(target, registers.ZERO, "_start")
}

skill append_trap(target) {
    target = rv32i.label(target, layout.Section.CODE, "platform_trap")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.CSRRS, registers.T0, registers.ZERO, registers.ZERO, 834))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, 11))
    target = rv32i.branch(target, instruction.Kind.BNE, registers.T0, registers.T1, "platform_report_trap")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, 64))
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.A7, registers.T0, "platform_write")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, 93))
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.A7, registers.T0, "platform_exit")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, 94))
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.A7, registers.T0, "platform_exit")

    target = rv32i.label(target, layout.Section.CODE, "platform_report_trap")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.CSRRS, registers.T1, registers.ZERO, registers.ZERO, 833))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.SP, registers.T0, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.SP, registers.T1, 4))
    target = rv32i.relative_address(target, registers.A1, "platform_trap_cause", 0)
    target = rv32i.relative_address(target, registers.A2, "platform_trap_cause_end", 0)
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SUB, registers.A2, registers.A2, registers.A1, 0))
    target = rv32i.call(target, "rt_platform_write")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 0))
    target = rv32i.call(target, "platform_uart_bits")
    target = rv32i.relative_address(target, registers.A1, "platform_trap_address", 0)
    target = rv32i.relative_address(target, registers.A2, "platform_trap_address_end", 0)
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SUB, registers.A2, registers.A2, registers.A1, 0))
    target = rv32i.call(target, "rt_platform_write")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 4))
    target = rv32i.call(target, "platform_uart_bits")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16))
    out rv32i.jump(target, registers.ZERO, "platform_exit_error")
}

skill append_uart_bits(target) {
    target = rv32i.label(target, layout.Section.CODE, "platform_uart_bits")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 32))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LUI, registers.T4, registers.ZERO, registers.ZERO, UART_BASE_UPPER))
    target = rv32i.label(target, layout.Section.CODE, ".L_platform_bits_loop")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SRLI, registers.T2, registers.A0, registers.ZERO, 31))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T2, registers.T2, registers.ZERO, 48))
    target = rv32i.label(target, layout.Section.CODE, ".L_platform_bits_wait")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LBU, registers.T3, registers.T4, registers.ZERO, UART_LSR))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ANDI, registers.T3, registers.T3, registers.ZERO, UART_TX_READY))
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.T3, registers.ZERO, ".L_platform_bits_wait")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SB, registers.ZERO, registers.T4, registers.T2, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, 1))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T5, registers.T5, registers.ZERO, -1))
    target = rv32i.branch(target, instruction.Kind.BNE, registers.T5, registers.ZERO, ".L_platform_bits_loop")
    target = rv32i.label(target, layout.Section.CODE, ".L_platform_bits_newline_wait")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LBU, registers.T3, registers.T4, registers.ZERO, UART_LSR))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ANDI, registers.T3, registers.T3, registers.ZERO, UART_TX_READY))
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.T3, registers.ZERO, ".L_platform_bits_newline_wait")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 10))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SB, registers.ZERO, registers.T4, registers.T2, 0))
    out rv32i.emit(target, rv32i.operation(instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0))
}

skill append_direct_write(target) {
    target = rv32i.label(target, layout.Section.CODE, "rt_platform_write")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T0, registers.A1, registers.ZERO, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T1, registers.A2, registers.ZERO, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LUI, registers.T4, registers.ZERO, registers.ZERO, UART_BASE_UPPER))
    target = rv32i.label(target, layout.Section.CODE, ".L_platform_direct_write_loop")
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_platform_direct_write_done")
    target = rv32i.label(target, layout.Section.CODE, ".L_platform_direct_uart_wait")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LBU, registers.T2, registers.T4, registers.ZERO, UART_LSR))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ANDI, registers.T2, registers.T2, registers.ZERO, UART_TX_READY))
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.T2, registers.ZERO, ".L_platform_direct_uart_wait")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LBU, registers.T2, registers.T0, registers.ZERO, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SB, registers.ZERO, registers.T4, registers.T2, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, 1))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, -1))
    target = rv32i.jump(target, registers.ZERO, ".L_platform_direct_write_loop")
    target = rv32i.label(target, layout.Section.CODE, ".L_platform_direct_write_done")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.A0, registers.A2, registers.ZERO, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR))
    out rv32i.emit(target, rv32i.operation(instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0))
}

skill append_direct_exit(target) {
    target = rv32i.label(target, layout.Section.CODE, "rt_platform_exit")
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.A0, registers.ZERO, "platform_exit_ok")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 8))
    target = rv32i.relative_address(target, registers.A1, "platform_exit_failure", 0)
    target = rv32i.relative_address(target, registers.A2, "platform_exit_failure_end", 0)
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SUB, registers.A2, registers.A2, registers.A1, 0))
    target = rv32i.call(target, "rt_platform_write")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 8))
    target = rv32i.call(target, "platform_uart_bits")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16))
    out rv32i.jump(target, registers.ZERO, "platform_exit_error")
}

skill append_trap_write(target) {
    target = rv32i.label(target, layout.Section.CODE, "platform_write")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T0, registers.A1, registers.ZERO, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T1, registers.A2, registers.ZERO, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T3, registers.A2, registers.ZERO, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LUI, registers.T4, registers.ZERO, registers.ZERO, UART_BASE_UPPER))
    target = rv32i.label(target, layout.Section.CODE, ".L_platform_write_loop")
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_platform_write_done")
    target = rv32i.label(target, layout.Section.CODE, ".L_platform_uart_wait")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LBU, registers.T2, registers.T4, registers.ZERO, UART_LSR))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ANDI, registers.T2, registers.T2, registers.ZERO, UART_TX_READY))
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.T2, registers.ZERO, ".L_platform_uart_wait")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LBU, registers.T2, registers.T0, registers.ZERO, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SB, registers.ZERO, registers.T4, registers.T2, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, 1))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, -1))
    target = rv32i.jump(target, registers.ZERO, ".L_platform_write_loop")
    target = rv32i.label(target, layout.Section.CODE, ".L_platform_write_done")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.A0, registers.T3, registers.ZERO, 0))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.CSRRS, registers.T0, registers.ZERO, registers.ZERO, 833))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, 4))
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.CSRRW, registers.ZERO, registers.T0, registers.ZERO, 833))
    out rv32i.emit(target, rv32i.operation(instruction.Kind.MRET, registers.ZERO, registers.ZERO, registers.ZERO, 0))
}

skill append_exit(target) {
    target = rv32i.label(target, layout.Section.CODE, "platform_exit")
    target = rv32i.branch(target, instruction.Kind.BEQ, registers.A0, registers.ZERO, "platform_exit_ok")
    target = rv32i.label(target, layout.Section.CODE, "platform_exit_error")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LUI, registers.T0, registers.ZERO, registers.ZERO, QEMU_TEST_UPPER))
    target = rv32i.load_immediate(target, registers.T1, QEMU_EXIT_ERROR)
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.T0, registers.T1, 0))
    target = rv32i.jump(target, registers.ZERO, "platform_halt")
    target = rv32i.label(target, layout.Section.CODE, "platform_exit_ok")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.LUI, registers.T0, registers.ZERO, registers.ZERO, QEMU_TEST_UPPER))
    target = rv32i.load_immediate(target, registers.T1, QEMU_EXIT_OK)
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.SW, registers.ZERO, registers.T0, registers.T1, 0))
    target = rv32i.label(target, layout.Section.CODE, "platform_halt")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.WFI, registers.ZERO, registers.ZERO, registers.ZERO, 0))
    out rv32i.jump(target, registers.ZERO, "platform_halt")
}

skill append_data(target) {
    target = layout.align_section(target, layout.Section.RODATA, 4)
    target = rv32i.label(target, layout.Section.RODATA, "platform_name")
    target = layout.append_section_text(target, layout.Section.RODATA, "saltic", yes)
    target = rv32i.label(target, layout.Section.RODATA, "platform_trap_cause")
    target = layout.append_section_text(target, layout.Section.RODATA, "ловушка процессора, причина: ", no)
    target = rv32i.label(target, layout.Section.RODATA, "platform_trap_cause_end")
    target = rv32i.label(target, layout.Section.RODATA, "platform_trap_address")
    target = layout.append_section_text(target, layout.Section.RODATA, "адрес остановки: ", no)
    target = rv32i.label(target, layout.Section.RODATA, "platform_trap_address_end")
    target = rv32i.label(target, layout.Section.RODATA, "platform_exit_failure")
    target = layout.append_section_text(target, layout.Section.RODATA, "системный выход с ошибкой: ", no)
    target = rv32i.label(target, layout.Section.RODATA, "platform_exit_failure_end")
    target = layout.align_section(target, layout.Section.DATA, 4)
    target = rv32i.label(target, layout.Section.DATA, "platform_argv")
    target = layout.append_label_address(target, layout.Section.DATA, "platform_name", 0)
    out layout.append_section_word(target, layout.Section.DATA, word.from_bytes(0, 0, 0, 0))
}

skill append(target) {
    @program_code_size = target.code.length
    @boot_trampoline = program_code_size > 0
    target.load_address = layout.word_address(0, 0, 0, 128)
    target.low_memory_size = 0
    target.entry = "platform_start"
    target.resolved = no
    target = append_entry(target, boot_trampoline)
    target = append_trap(target)
    target = append_uart_bits(target)
    target = append_direct_write(target)
    target = append_direct_exit(target)
    target = append_trap_write(target)
    target = append_exit(target)
    target = append_data(target)
    (boot_trampoline == yes) {
        @upper = codec.signed_value(layout.relative_high(program_code_size), 20)
        @high = codec.encode_kind(instruction.Kind.AUIPC, registers.T0, registers.ZERO, registers.ZERO, upper)
        @low = codec.encode_kind(instruction.Kind.JALR, registers.ZERO, registers.T0, registers.ZERO, layout.relative_low(program_code_size))
        target = layout.set_section_word(target, layout.Section.CODE, 0, high)
        target = layout.set_section_word(target, layout.Section.CODE, 4, low)
    }
    out target
}

skill show_banner() {
    io.show("Saltic работает прямо на RV32I")
    out none
}
