-- hello — первая программа Saltic на телефоне: фон и «Привет, Зэф!» шрифтом
-- Spleen 16×32, увеличенным под ширину окна, ниже — подпись помельче. Окно
-- даёт платформа через cpu.firmware: 0 — адрес пикселей RGBA_8888, 1 —
-- ширина, 2 — высота, 3 — шаг строки в пикселях. Печать уходит в журнал.

use io
use core.str
use core.cpu
use core.mem
use core.u32
use core.group
use core.usize
use core.address
use os.fonts.spleen
use os.drivers.font

skill background() {
    out u32.from(4281211678)
}

skill ink() {
    out u32.from(4293978336)
}

skill accent() {
    out u32.from(4284924157)
}

Canvas = Box {
    bits = 0,
    width = 0,
    height = 0,
    stride = 0
}

skill block(canvas, x, y, size, color) {
    @base = address.from(canvas.bits)
    @paint = color
    drum (size) {
        @row = (y + beat) * canvas.stride + x
        drum (size) { mem.store32(base, usize.from((row + beat) * 4), paint) }
    }
    out none
}

skill text(canvas, x, y, words, scale, color) {
    @at = 0
    @left = x
    drum (str.bytes(words)) {
        (at < str.bytes(words)) {
            @code = font.font_decode(words, at)
            @glyph = group.get(spleen.GLYPHS_16X32, font.font_glyph_index(code.value))
            drum (32) {
                @row = beat
                @bits = group.get(glyph, row)
                @mask = 32768
                drum (16) {
                    (bits / mask % 2 == 1) { block(canvas, left + beat * scale, y + row * scale, scale, color) }
                    mask = mask / 2
                }
            }
            left = left + 16 * scale
            at = at + code.width
        }
    }
    out none
}

program() {
    @canvas = Canvas { bits = cpu.firmware(0), width = cpu.firmware(1), height = cpu.firmware(2), stride = cpu.firmware(3) }
    io.show("окно {canvas.width}×{canvas.height}, шаг {canvas.stride}")
    @base = address.from(canvas.bits)
    @paint = background()
    drum (canvas.height) {
        @row = beat * canvas.stride
        drum (canvas.width) { mem.store32(base, usize.from((row + beat) * 4), paint) }
    }
    @scale = canvas.width / (14 * 16)
    (scale < 1) { scale = 1 }
    @top = canvas.height / 3
    text(canvas, scale * 16, top, "Привет, Зэф!", scale, ink())
    @small = scale / 2
    (small < 1) { small = 1 }
    text(canvas, scale * 16, top + 40 * scale, "Saltic на Android", small, accent())
    io.show("кадр готов")
    out none
}
