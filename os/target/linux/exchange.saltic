-- exchange — биржа Acer в окне Wayland на этом компьютере: те же рынок и
-- страница (programs/exchange: Box Market и Page из блоков и жителей библиотеки), те же атомы и шрифты
-- TTF, только файлы шрифтов читаются с диска хоста. Рынок делает такт раз в
-- TICK кругов по PAUSE мс; окно закрыли — выход.
--
-- program() — вход
-- Внутри: face(path) -> Typeface из файла

use io.file
use core.bytes
use core.group
use core.socket
use registry.libraries.uiengine.jtml
use registry.libraries.uiengine.jtml.read
use os.target.linux.screen
use registry.libraries.uiengine.draw.atoms
use registry.libraries.uiengine.draw.typeface
use os.target.uefi_x86_64.programs.exchange.page
use os.target.uefi_x86_64.programs.exchange.market
use registry.libraries.uiengine.themes

REGULAR = "os/fonts/inter/Inter-Regular.ttf"
BOLD = "os/fonts/inter/Inter-Bold.ttf"
MONO = "os/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
PAUSE = 50
TICK = 20

skill face(path) {
    out typeface.from_bytes(file.read_bytes(path))
}

program() {
    @host = screen.open()
    (group.count(host) == 0) { out none }
    @canvas = group.get(host, 0)
    @link = group.get(host, 1)
    @palette = atoms.with_faces(themes.named("soft", canvas), face(REGULAR), face(BOLD), face(MONO))
    @quotes = market.Market {}
    @view = page.Page {}
    @packet = bytes.new(8192)
    @hold = bytes.new(4096)
    @joined = bytes.new(12288)
    @rounds = 0
    always {
        (rounds % TICK == 0) {
            quotes.step()
            view.follow(quotes)
            @tree = atoms.fitted(read.page(view.jtml()), no, palette)
            atoms.draw(canvas, jtml.mount(canvas, tree), palette)
            screen.present(link)
        }
        (link.way_closed == yes) { leave }
        (link.way_failed == yes) { leave }
        screen.pump(link, packet, hold, joined)
        socket.sleep(PAUSE)
        rounds = rounds + 1
    }
    out none
}
