-- salticide — SalticIDE с сайта в окне Wayland. Страница та же, что на Acer:
-- programs/salticide/page, рисунок atoms.draw в адаптер os.target.linux.screen.
-- Щелчок закрывает окно.

use core.bytes
use core.group
use core.socket
use os.ui.jtml
use os.target.linux.screen
use os.target.uefi_x86_64.screen.atoms
use os.target.uefi_x86_64.programs.salticide.page

program() {
    @host = screen.open()
    (group.count(host) == 0) { out none }
    @face = group.get(host, 0)
    @link = group.get(host, 1)
    @runtime = jtml.mount(face, atoms.measured(page.tree(), no))
    atoms.draw(face, runtime, atoms.palette_site(face))
    screen.present(link)
    @packet = bytes.new(8192)
    @hold = bytes.new(4096)
    @joined = bytes.new(12288)
    always {
        (link.way_closed == yes) { leave }
        (link.way_failed == yes) { leave }
        screen.pump(link, packet, hold, joined)
        socket.sleep(50)
    }
    out none
}
