-- devices — живой опрос железа для экрана «Устройства» Полигона, каждый не
-- дольше секунды (закон автора об ответе): ноутбук — сам о себе (/proc:
-- память, ядра, нагрузка; /etc/hostname), Acer — один вопрос info агенту по
-- кабелю (mRPC, taskdesk/wire), телефон — adb devices, ESP32 — есть ли
-- /dev/ttyUSB0. Не ответил — так и сказано, с причиной: состояние «нет связи».
--
-- Device { name, kind, state, tone, first, second, alive } — что показать
-- survey() -> [ноутбук, Acer, телефон, ESP32] — группа Device
-- laptop() / acer() / phone() / esp32() -> Device
-- Внутри: field(text, name) -> число из строки /proc/meminfo «name: N kB»;
--     number(text) -> целое из первых цифр

use core.str
use core.group
use core.process
use io.file
use craft.protocols.data.json.value
use os.target.uefi_x86_64.network.mrpc
use os.target.linux.taskdesk.wire

ACER = "10.0.0.2"
ACER_PORT = 5555
ADB = "/nix/store/f8idcxknf68aa5r584jrywgybfsw67gs-android-tools-35.0.2/bin/adb"
SERIAL = "ttyUSB0"

Device = Box {
    name = "",
    kind = "",
    state = "",
    tone = "quiet",
    first = "",
    second = "",
    alive = no
}

skill number(text) {
    @result = 0
    @started = no
    drum (str.bytes(text)) {
        @code = str.byte(text, beat)
        @digit = no
        (code >= 48) {
            (code <= 57) { digit = yes }
        }
        (digit == yes) {
            result = result * 10 + code - 48
            started = yes
        }
        (digit == no) {
            (started == yes) { out result }
        }
    }
    out result
}

skill field(text, name) {
    drum (str.lines(text)) {
        (str.starts_with(beat, name) == yes) { out number(beat) }
    }
    out 0
}

skill laptop() {
    @memory = file.read("/proc/meminfo")
    @total = field(memory, "MemTotal") / 1048576
    @free = field(memory, "MemAvailable") / 1048576
    @cores = 0
    drum (str.lines(file.read("/proc/cpuinfo"))) {
        (str.starts_with(beat, "processor") == yes) { cores = cores + 1 }
    }
    @load = group.get(str.split(file.read("/proc/loadavg"), " "), 0)
    @host = group.get(str.lines(file.read("/etc/hostname")), 0)
    @used = total - free
    out Device { name = "Ноутбук", kind = "x86-64 · Linux · {host}", state = "это я", tone = "accent", first = "память {used} из {total} ГБ", second = "ядер {cores} · нагрузка {load}", alive = yes }
}

skill acer() {
    @seen = Device { name = "Acer E5-575G", kind = "x86-64 · UEFI · агент Saltic", state = "нет связи", tone = "down", first = "{ACER}:{ACER_PORT} молчит", second = "кабель LAN · mRPC" }
    @link = wire.open(ACER, ACER_PORT) rescue |err| { out seen }
    @answer = wire.ask(link, "info", "")
    (answer.ok == no) {
        seen.first = "молчит дольше секунды"
        out seen
    }
    @agent = value.get(answer.data, "agent")
    @version = mrpc.plain(agent.value)
    @heap = value.get(answer.data, "heap")
    @used = value.get(heap.value, "used")
    @kb = mrpc.plain(used.value)
    seen.state = "в сети"
    seen.tone = "up"
    seen.kind = "x86-64 · UEFI · агент {version}"
    seen.first = "агент {version} · куча {kb} КБ"
    seen.second = "{ACER} · кабель LAN · mRPC"
    seen.alive = yes
    out seen
}

skill phone() {
    @seen = Device { name = "POCO X6 Pro", kind = "arm64 · Android", state = "нет связи", tone = "down", first = "adb не видит телефон", second = "USB · отладка" }
    @asked = process.capture([ADB, "devices"], "", []) rescue |err| {
        seen.first = "adb не запустился"
        out seen
    }
    drum (str.lines(asked.output)) {
        (str.ends_with(beat, "device") == yes) {
            @serial = group.get(str.split(beat, "\t"), 0)
            seen.state = "в сети"
            seen.tone = "up"
            seen.first = "adb: {serial}"
            seen.alive = yes
        }
    }
    out seen
}

skill esp32() {
    @seen = Device { name = "ESP32 DevKit", kind = "xtensa · LX6", state = "не подключена", tone = "quiet", first = "/dev/{SERIAL} нет", second = "USB · последовательный порт" }
    (group.contains(file.list("/dev"), SERIAL) == yes) {
        seen.state = "на проводе"
        seen.tone = "up"
        seen.first = "/dev/{SERIAL} на месте"
        seen.alive = yes
    }
    out seen
}

skill survey() {
    out [laptop(), acer(), phone(), esp32()]
}
