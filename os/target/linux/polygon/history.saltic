-- history — настоящая история коммитов репозитория для экрана «Сборки»
-- Полигона: субъект Commits сам читает git log за WEEKS недель (дата коммита —
-- день, ГГГГ-ММ-ДД; сегодня — date +%F) и сам считает о себе итоги. Дни —
-- номер от 1970-01-01, неделя — с понедельника; сетка — WEEKS столбцов по 7
-- дней, последний — с сегодняшним днём. Не прочиталось — trouble словами.
--
-- Commits { first, today, counts, trouble } — первый день сетки, сегодня,
--     коммитов по дням сетки (дни после сегодня — ноль), причина сбоя или ""
--     refresh() — прочитать git log заново; total() / active() — коммитов и
--     дней с коммитами; streak() — самая длинная серия дней подряд;
--     best() -> [номер в сетке, коммитов] — лучший день; at(index) — день
--     сетки номером от 1970-01-01; count(index) — коммитов в нём
-- day_of(text) -> номер дня по "ГГГГ-ММ-ДД"; civil(day) -> [год, месяц, день]
-- weekday(day) -> 0 — понедельник … 6 — воскресенье
-- Внутри: number(text) -> целое из цифр

use core.str
use core.group
use core.process

WEEKS = 53
EPOCH_SHIFT = 719468
ERA = 146097


skill number(text) {
    @value = 0
    drum (str.bytes(text)) { value = value * 10 + str.byte(text, beat) - 48 }
    out value
}

skill day_of(text) {
    @year = number(str.slice(text, 0, 4))
    @month = number(str.slice(text, 5, 7))
    @day = number(str.slice(text, 8, 10))
    (month <= 2) { year = year - 1 }
    @era = year / 400
    @of_era = year - era * 400
    @shifted = month + 9
    (month > 2) { shifted = month - 3 }
    @of_year = (153 * shifted + 2) / 5 + day - 1
    @of_cycle = of_era * 365 + of_era / 4 - of_era / 100 + of_year
    out era * ERA + of_cycle - EPOCH_SHIFT
}

skill civil(day) {
    @shifted = day + EPOCH_SHIFT
    @era = shifted / ERA
    @of_cycle = shifted - era * ERA
    @of_era = (of_cycle - of_cycle / 1460 + of_cycle / 36524 - of_cycle / 146096) / 365
    @year = of_era + era * 400
    @of_year = of_cycle - (365 * of_era + of_era / 4 - of_era / 100)
    @spot = (5 * of_year + 2) / 153
    @date = of_year - (153 * spot + 2) / 5 + 1
    @month = spot + 3
    (spot >= 10) { month = spot - 9 }
    (month <= 2) { year = year + 1 }
    out [year, month, date]
}

skill weekday(day) {
    out (day + 3) % 7
}

Commits = Box {
    first = 0,
    today = 0,
    counts = [],
    trouble = ""

    skill refresh() {
        @asked = process.capture(["date", "+%F"], "", []) rescue |err| {
            trouble = "date не ответил — {err}"
            out none
        }
        today = day_of(asked.output)
        first = today - (WEEKS - 1) * 7 - weekday(today)
        @log = process.capture(["git", "log", "--since={WEEKS} weeks ago", "--format=%cd", "--date=short"], "", []) rescue |err| {
            trouble = "git не запустился — {err}"
            out none
        }
        ((log.code == 0) == no) {
            trouble = "git log ответил кодом {log.code} — не репозиторий?"
            out none
        }
        @made = []
        drum (WEEKS * 7) { made = group.add(made, 0) }
        drum (str.lines(log.output)) {
            (str.bytes(beat) >= 10) {
                @spot = day_of(beat) - first
                (spot >= 0) {
                    (spot < WEEKS * 7) { made = group.replaced(made, spot, group.get(made, spot) + 1) }
                }
            }
        }
        counts = made
        trouble = ""
        out none
    }

    skill at(index) {
        out first + index
    }

    skill count(index) {
        out group.get(counts, index)
    }

    skill total() {
        @sum = 0
        drum (counts) { sum = sum + beat }
        out sum
    }

    skill active() {
        @days = 0
        drum (counts) {
            (beat > 0) { days = days + 1 }
        }
        out days
    }

    skill streak() {
        @longest = 0
        @run = 0
        drum (today - first + 1) {
            run = run + 1
            (group.get(counts, beat) == 0) { run = 0 }
            (run > longest) { longest = run }
        }
        out longest
    }

    skill best() {
        @spot = 0
        @most = 0
        drum (group.count(counts)) {
            (group.get(counts, beat) > most) {
                most = group.get(counts, beat)
                spot = beat
            }
        }
        out [spot, most]
    }
}
