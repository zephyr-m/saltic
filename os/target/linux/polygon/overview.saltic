-- overview — экран «Обзор» Полигона, субъект Overview: образец платформы из
-- docs/site/private/PLATFORM-DEMO.html — главные числа, устройства с
-- полосками, последние сборки. Все данные — образец и так подписаны (метка
-- вверху и подпись таблицы); живые данные — в «Сборках» и «Устройствах».
--
-- Overview { track } — ширина дорожки полоски устройства в точках
--     jtml() -> список JTML экрана
-- Внутри: shelf(flow, gap, items) — box-полка с детьми

use core.group
use registry.libraries.uiengine.jtml.calls

SPARK = [10, 16, 12, 22, 18, 26, 34]
DEVICES = [["Acer E5-575G", "x86-64 · UEFI · агент 56", "в сети", "up", "память", "2.9 из 7.9 ГБ", 37, "accent", "диск Saltic", "66 из 510 МБ", 13, "accent"], ["POCO X6 Pro", "arm64 · Android · gaze", "в сети", "up", "камера", "230 кадров", 62, "accent", "сеть взгляда", "4 мс на кадр", 20, "mustard"], ["ESP32 DevKit", "xtensa · LX6 · задача 20", "IllegalInstruction", "down", "код", "158 из 128 КБ", 100, "down", "куча", "21 из 64 КБ", 33, "accent"], ["Ноутбук", "x86-64 · NixOS · полка 300", "собирает", "accent", "процессор", "8 потоков", 86, "mustard", "память", "11 из 32 ГБ", 34, "accent"]]
BUILDS = [["global-check", "все", "идёт", "accent", "Зэф", "4:12"], ["esp32-console", "xtensa", "провал", "down", "Claude", "0:24"], ["agent 56", "x86-64-uefi", "прошло", "up", "Claude", "1:03"], ["salticide", "x86-64", "прошло", "up", "Claude", "0:48"], ["gaze", "arm64-android", "ждёт", "quiet", "Fable", "—"]]

skill shelf(flow, gap, items) {
    @inside = calls.join(items)
    out "\{\"box\": \{\"flow\": \"{flow}\", \"gap\": {gap}, \"children\": [{inside}]\}\}"
}

Overview = Box {
    track = 248

    skill jtml() {
            @bars = []
            drum (SPARK) {
                @tone = "accent_rim"
                (beat == 34) { tone = "accent" }
                bars = group.add(bars, calls.call("bar", [["width", "22"], ["height", "{beat}"], ["tone", calls.quoted(tone)], ["radius", "3"]]))
            }
            @spark = calls.call("spark", [["bars", calls.listed(bars)]])
            @stats = shelf("row", 14, [calls.call("stat-panel", [["label", calls.quoted("проверок прошло")], ["value", calls.quoted("17 522")], ["tone", calls.quoted("accent")], ["size", "64"], ["note", calls.quoted("из 24 884 · осталось ~2 мин")], ["grow", "2"]]), calls.call("stat-panel", [["label", calls.quoted("прошло")], ["value", calls.quoted("21")], ["tone", calls.quoted("up")], ["size", "34"], ["note", calls.quoted("за сутки")], ["grow", "1"], ["extra", spark]]), calls.call("stat-panel", [["label", calls.quoted("провал")], ["value", calls.quoted("2")], ["tone", calls.quoted("down")], ["size", "34"], ["note", calls.quoted("jtml, esp32")], ["grow", "1"]]), calls.call("stat-panel", [["label", calls.quoted("полка")], ["value", calls.quoted("300")], ["tone", calls.quoted("mustard")], ["size", "34"], ["note", calls.quoted("300:82:281")], ["grow", "1"]])])
            @cards = []
            drum (DEVICES) {
                @one = group.get(beat, 6) * track / 100
                @two = group.get(beat, 10) * track / 100
                cards = group.add(cards, calls.call("device-card", [["name", calls.quoted(group.get(beat, 0))], ["kind", calls.quoted(group.get(beat, 1))], ["state", calls.quoted(group.get(beat, 2))], ["tone", calls.quoted(group.get(beat, 3))], ["grow", "1"], ["one", calls.quoted(group.get(beat, 4))], ["one_value", calls.quoted(group.get(beat, 5))], ["one_fill", "{one}"], ["one_tone", calls.quoted(group.get(beat, 7))], ["two", calls.quoted(group.get(beat, 8))], ["two_value", calls.quoted(group.get(beat, 9))], ["two_fill", "{two}"], ["two_tone", calls.quoted(group.get(beat, 11))]]))
            }
            @rows = [calls.call("build-head", [])]
            drum (BUILDS) { rows = group.add(rows, calls.call("build-row", [["name", calls.quoted(group.get(beat, 0))], ["target", calls.quoted(group.get(beat, 1))], ["state", calls.quoted(group.get(beat, 2))], ["tone", calls.quoted(group.get(beat, 3))], ["author", calls.quoted(group.get(beat, 4))], ["time", calls.quoted(group.get(beat, 5))]])) }
            @table = calls.call("console-panel", [["title", calls.quoted("последние сборки")], ["note", calls.quoted("образец")], ["radius", "16"], ["children", calls.listed([shelf("column", 0, rows)])]])
            @head = calls.call("page-head", [["title", calls.quoted("Обзор")], ["note", calls.quoted("Сборки и железо за сегодня")], ["badge", calls.quoted("идёт global-check")], ["tone", calls.quoted("accent")]])
            out calls.listed([head, stats, calls.call("section-head", [["text", calls.quoted("устройства")]]), shelf("row", 14, cards), table])

    }
}
