-- person — человек витрины «Круги», субъект Person: инициалы и цвет —
-- кружок-аватар.
--
-- Person { letters, tone } — jtml() -> житель avatar

use tarantul.uiengine.jtml.calls

Person = Box {
    letters = "",
    tone = "accent"

    skill jtml() {
        out calls.call("avatar", [["letters", calls.quoted(letters)], ["tone", calls.quoted(tone)]])
    }
}
