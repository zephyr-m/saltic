-- status — состояние витрины «Круги», субъект Status: слово и цвет смысла —
-- точка с ободком и подпись.
--
-- Status { name, tone } — jtml() -> точка и подпись рядом

use tarantul.uiengine.jtml.calls

Status = Box {
    name = "",
    tone = "up"

    skill jtml() {
        @dot = calls.call("status-dot", [["tone", calls.quoted(tone)]])
        @word = calls.call("words", [["text", calls.quoted(name)], ["tone", calls.quoted("quiet")]])
        out "\{\"box\": \{\"flow\": \"row\", \"gap\": 8, \"align\": \"center\", \"children\": [{dot}, {word}]\}\}"
    }
}
