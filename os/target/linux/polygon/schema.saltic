-- schema — экран «Устройства» Полигона: схема железа автора по живому опросу
-- (devices.survey): ноутбук в центре, Acer слева (кабель LAN), телефон справа
-- (USB, adb), ESP32 снизу (USB, последовательный порт); карточки и провода
-- стоят свободно (at) на сцене STAGE_HIGH точек. Провод голубой, если
-- устройство ответило, иначе — линия. Под схемой — сколько на связи и сколько
-- занял опрос. Щелчок по карточке (NODE и номер) — опросить заново.
--
-- screen(found, took, wide) -> список JTML: шапка, сцена, итоги; found —
--     группа devices.Device (пусто — ещё не опрошено), took — мс опроса,
--     wide — ширина содержимого
-- Внутри: node(device, index, x, y) — карточка; wired(device) -> тон провода

use core.str
use core.group
use registry.libraries.uiengine.jtml.calls
use os.target.linux.polygon.devices

NODE = "node-"
ICONS = ["laptop", "server", "smartphone", "cpu"]
CARD_WIDE = 280
CARD_HIGH = 126
STAGE_HIGH = 470
ROW = 40
WIRE = 2

skill wired(device) {
    (device.alive == yes) { out "accent_mid" }
    out "line"
}

skill node(device, index, x, y) {
    out calls.call("device-node", [["id", calls.quoted("{NODE}{index}")], ["x", "{x}"], ["y", "{y}"], ["icon", calls.quoted(group.get(ICONS, index))], ["name", calls.quoted(device.name)], ["kind", calls.quoted(device.kind)], ["state", calls.quoted(device.state)], ["tone", calls.quoted(device.tone)], ["first", calls.quoted(device.first)], ["second", calls.quoted(device.second)]])
}

skill wire(x, y, width, height, tone) {
    out calls.call("wire", [["x", "{x}"], ["y", "{y}"], ["width", "{width}"], ["height", "{height}"], ["tone", calls.quoted(tone)]])
}

skill label(x, y, text) {
    out calls.call("wire-label", [["x", "{x}"], ["y", "{y}"], ["text", calls.quoted(text)]])
}

skill screen(found, took, wide) {
    (group.count(found) < 4) {
        @waiting = calls.call("page-head", [["title", calls.quoted("Устройства")], ["note", calls.quoted("опрашиваю железо — не дольше секунды на каждое")], ["badge", calls.quoted("опрос")], ["tone", calls.quoted("accent")]])
        out calls.listed([waiting])
    }
    @mine = group.get(found, 0)
    @acer = group.get(found, 1)
    @phone = group.get(found, 2)
    @board = group.get(found, 3)
    @middle = (wide - CARD_WIDE) / 2
    @right = wide - CARD_WIDE
    @lane = ROW + CARD_HIGH / 2
    @drop = ROW + CARD_HIGH + 160
    @parts = []
    parts = group.add(parts, wire(CARD_WIDE, lane, middle - CARD_WIDE, WIRE, wired(acer)))
    parts = group.add(parts, wire(middle + CARD_WIDE, lane, right - middle - CARD_WIDE, WIRE, wired(phone)))
    parts = group.add(parts, wire(middle + CARD_WIDE / 2, ROW + CARD_HIGH, WIRE, drop - ROW - CARD_HIGH, wired(board)))
    parts = group.add(parts, label(CARD_WIDE + 16, lane - 22, "кабель LAN · mRPC"))
    parts = group.add(parts, label(middle + CARD_WIDE + 16, lane - 22, "USB · adb"))
    parts = group.add(parts, label(middle + CARD_WIDE / 2 + 14, ROW + CARD_HIGH + 60, "USB · /dev/ttyUSB0"))
    parts = group.add(parts, node(acer, 1, 0, ROW))
    parts = group.add(parts, node(mine, 0, middle, ROW))
    parts = group.add(parts, node(phone, 2, right, ROW))
    parts = group.add(parts, node(board, 3, middle, drop))
    @inside = calls.join(parts)
    @stage = "\{\"box\": \{\"height\": {STAGE_HIGH}, \"gap\": 0, \"children\": [{inside}]\}\}"
    @alive = 0
    drum (found) {
        (beat.alive == yes) { alive = alive + 1 }
    }
    @head = calls.call("page-head", [["title", calls.quoted("Устройства")], ["note", calls.quoted("живой опрос — щёлкни по карточке, чтобы спросить заново")], ["badge", calls.quoted("на связи {alive} из 4 · {took} мс")], ["tone", calls.quoted("up")]])
    out calls.listed([head, stage])
}
