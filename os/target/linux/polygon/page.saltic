-- page — экран «Полигона Saltic» (docs/site/private/PLATFORM-DEMO.html) из
-- жителей UIEngine: дек polygon-deck 4-го этажа, в его ячейках — жители 3-го
-- (меню, шапка, главные числа, карточки устройств, таблица сборок). Данные
-- «Обзора» — образец, так и подписаны; «Сборки» и «Устройства» — живые, метка
-- вверху — по разделу. Меню слева настоящее: щелчок выбирает раздел;
-- наполнены «Обзор», «Сборки» (настоящий календарь коммитов — builds) и
-- «Устройства» (живая схема железа — schema, опрос — devices), у
-- прочих — честное «раздел пока пуст». Ниже в
-- меню — темы UIEngine (themes.NAMES): щелчок перекрашивает экран.
--
-- Polygon { section, theme, worn, activity, trouble } — выбранный раздел
--     (имя из SECTIONS), выбранная тема и та, в которой экран нарисован сейчас
--     (окно сверяет), история коммитов (history.Activity, кладёт окно) и
--     причина, если её прочитать не вышло; found, took, asking — опрос
--     железа (группа devices.Device, сколько мс, пора ли спросить: окно
--     опрашивает и кладёт сюда)
-- tip(id, x, y) -> JTML подсказки над наведённым (builds.tip) или ""
-- choose(id) -> yes, если id — пункт меню (MENU и имя раздела) или темы
--     (PAINT и имя темы)
-- jtml() -> текст JTML экрана
-- Внутри: shelf(flow, gap, items) -> box-полка с детьми; side() — меню;
--     overview() — содержимое «Обзора»; empty(title) — пустой раздел

use core.str
use core.group
use registry.libraries.uiengine.jtml.calls
use registry.libraries.uiengine.themes
use os.target.linux.polygon.builds
use os.target.linux.polygon.history
use os.target.linux.polygon.schema

MENU = "menu-"
PAINT = "theme-"
CONTENT_WIDE = 1159
SECTIONS = [["overview", "layout-grid", "Обзор", ""], ["builds", "code", "Сборки", "24"], ["devices", "monitor", "Устройства", "4"], ["packages", "package", "Пакеты", "9"]]
PROJECTS = [["esp32-console", "circle", "esp32-console", ""], ["saltic", "circle", "saltic", ""]]
SPARK = [10, 16, 12, 22, 18, 26, 34]
TRACK = 248
DEVICES = [["Acer E5-575G", "x86-64 · UEFI · агент 56", "в сети", "up", "память", "2.9 из 7.9 ГБ", 37, "accent", "диск Saltic", "66 из 510 МБ", 13, "accent"], ["POCO X6 Pro", "arm64 · Android · gaze", "в сети", "up", "камера", "230 кадров", 62, "accent", "сеть взгляда", "4 мс на кадр", 20, "mustard"], ["ESP32 DevKit", "xtensa · LX6 · задача 20", "IllegalInstruction", "down", "код", "158 из 128 КБ", 100, "down", "куча", "21 из 64 КБ", 33, "accent"], ["Ноутбук", "x86-64 · NixOS · полка 300", "собирает", "accent", "процессор", "8 потоков", 86, "mustard", "память", "11 из 32 ГБ", 34, "accent"]]
BUILDS = [["global-check", "все", "идёт", "accent", "Зэф", "4:12"], ["esp32-console", "xtensa", "провал", "down", "Claude", "0:24"], ["agent 56", "x86-64-uefi", "прошло", "up", "Claude", "1:03"], ["salticide", "x86-64", "прошло", "up", "Claude", "0:48"], ["gaze", "arm64-android", "ждёт", "quiet", "Fable", "—"]]

skill shelf(flow, gap, items) {
    @inside = calls.join(items)
    out "\{\"box\": \{\"flow\": \"{flow}\", \"gap\": {gap}, \"children\": [{inside}]\}\}"
}

skill menu_row(id, icon, text, count, current) {
    @kind = "menu-row"
    (current == yes) { kind = "menu-row-current" }
    out calls.call(kind, [["id", calls.quoted("{MENU}{id}")], ["icon", calls.quoted(icon)], ["text", calls.quoted(text)], ["count", calls.quoted(count)]])
}

Polygon = Box {
    section = "overview",
    theme = "soft",
    worn = "soft",
    activity = history.Activity {},
    trouble = "",
    found = [],
    took = 0,
    asking = no

    skill tip(id, x, y) {
        ((section == "builds") == no) { out "" }
        ((trouble == "") == no) { out "" }
        out builds.tip(activity, id, x, y)
    }

    skill choose(id) {
        (str.starts_with(id, PAINT) == yes) {
            theme = str.slice(id, str.bytes(PAINT), str.bytes(id))
            out yes
        }
        (str.starts_with(id, schema.NODE) == yes) {
            asking = yes
            out yes
        }
        (str.starts_with(id, MENU) == no) { out no }
        section = str.slice(id, str.bytes(MENU), str.bytes(id))
        (section == "devices") {
            (group.count(found) == 0) { asking = yes }
        }
        out yes
    }

    skill side() {
        @rows = [calls.call("brand", [["letter", calls.quoted("S")], ["name", calls.quoted("Полигон Saltic")]])]
        drum (SECTIONS) { rows = group.add(rows, menu_row(group.get(beat, 0), group.get(beat, 1), group.get(beat, 2), group.get(beat, 3), group.get(beat, 0) == section)) }
        rows = group.add(rows, calls.call("section-head", [["text", calls.quoted("проекты")]]))
        drum (PROJECTS) { rows = group.add(rows, menu_row(group.get(beat, 0), group.get(beat, 1), group.get(beat, 2), group.get(beat, 3), group.get(beat, 0) == section)) }
        rows = group.add(rows, calls.call("section-head", [["text", calls.quoted("темы")]]))
        drum (themes.NAMES) {
            @kind = "menu-row"
            (beat == theme) { kind = "menu-row-current" }
            rows = group.add(rows, calls.call(kind, [["id", calls.quoted("{PAINT}{beat}")], ["icon", calls.quoted("palette")], ["text", calls.quoted(beat)], ["count", calls.quoted("")]]))
        }
        rows = group.add(rows, "\{\"box\": \{\"grow\": 1, \"gap\": 0\}\}")
        rows = group.add(rows, calls.call("side-foot", [["text", calls.quoted("Обзор — образец")], ["note", calls.quoted("Сборки, Устройства — живые")]]))
        out calls.listed(rows)
    }

    skill overview() {
        @bars = []
        drum (SPARK) {
            @tone = "accent_rim"
            (beat == 34) { tone = "accent" }
            bars = group.add(bars, calls.call("bar", [["width", "22"], ["height", "{beat}"], ["tone", calls.quoted(tone)], ["radius", "3"]]))
        }
        @spark = calls.call("spark", [["bars", calls.listed(bars)]])
        @stats = shelf("row", 14, [calls.call("stat-panel", [["label", calls.quoted("проверок прошло")], ["value", calls.quoted("17 522")], ["tone", calls.quoted("accent")], ["size", "64"], ["note", calls.quoted("из 24 884 · осталось ~2 мин")], ["grow", "2"]]), calls.call("stat-panel", [["label", calls.quoted("прошло")], ["value", calls.quoted("21")], ["tone", calls.quoted("up")], ["size", "34"], ["note", calls.quoted("за сутки")], ["grow", "1"], ["extra", spark]]), calls.call("stat-panel", [["label", calls.quoted("провал")], ["value", calls.quoted("2")], ["tone", calls.quoted("down")], ["size", "34"], ["note", calls.quoted("jtml, esp32")], ["grow", "1"]]), calls.call("stat-panel", [["label", calls.quoted("полка")], ["value", calls.quoted("300")], ["tone", calls.quoted("mustard")], ["size", "34"], ["note", calls.quoted("300:82:281")], ["grow", "1"]])])
        @cards = []
        drum (DEVICES) {
            @one = group.get(beat, 6) * TRACK / 100
            @two = group.get(beat, 10) * TRACK / 100
            cards = group.add(cards, calls.call("device-card", [["name", calls.quoted(group.get(beat, 0))], ["kind", calls.quoted(group.get(beat, 1))], ["state", calls.quoted(group.get(beat, 2))], ["tone", calls.quoted(group.get(beat, 3))], ["grow", "1"], ["one", calls.quoted(group.get(beat, 4))], ["one_value", calls.quoted(group.get(beat, 5))], ["one_fill", "{one}"], ["one_tone", calls.quoted(group.get(beat, 7))], ["two", calls.quoted(group.get(beat, 8))], ["two_value", calls.quoted(group.get(beat, 9))], ["two_fill", "{two}"], ["two_tone", calls.quoted(group.get(beat, 11))]]))
        }
        @rows = [calls.call("build-head", [])]
        drum (BUILDS) { rows = group.add(rows, calls.call("build-row", [["name", calls.quoted(group.get(beat, 0))], ["target", calls.quoted(group.get(beat, 1))], ["state", calls.quoted(group.get(beat, 2))], ["tone", calls.quoted(group.get(beat, 3))], ["author", calls.quoted(group.get(beat, 4))], ["time", calls.quoted(group.get(beat, 5))]])) }
        @table = calls.call("console-panel", [["title", calls.quoted("последние сборки")], ["note", calls.quoted("образец")], ["radius", "16"], ["children", calls.listed([shelf("column", 0, rows)])]])
        @head = calls.call("page-head", [["title", calls.quoted("Обзор")], ["note", calls.quoted("Сборки и железо за сегодня")], ["badge", calls.quoted("идёт global-check")], ["tone", calls.quoted("accent")]])
        out calls.listed([head, stats, calls.call("section-head", [["text", calls.quoted("устройства")]]), shelf("row", 14, cards), table])
    }

    skill empty(title) {
        @head = calls.call("page-head", [["title", calls.quoted(title)], ["note", calls.quoted("раздел пока пуст — наполнен только «Обзор»")], ["badge", calls.quoted("пусто")], ["tone", calls.quoted("quiet")]])
        out calls.listed([head])
    }

    skill jtml() {
        @title = section
        drum (group.concat(SECTIONS, PROJECTS)) {
            (group.get(beat, 0) == section) { title = group.get(beat, 2) }
        }
        @badge = "образец"
        @tone = "mustard"
        (section == "builds") { badge = "живые данные" }
        (section == "devices") { badge = "живые данные" }
        (badge == "живые данные") { tone = "up" }
        @top = calls.call("crumbs", [["path", calls.quoted("полигон / {title}")], ["badge", calls.quoted(badge)], ["tone", calls.quoted(tone)]])
        @content = overview()
        ((section == "overview") == no) { content = empty(title) }
        (section == "devices") { content = schema.screen(found, took, CONTENT_WIDE) }
        (section == "builds") {
            content = builds.screen(activity)
            ((trouble == "") == no) { content = empty("Сборки: {trouble}") }
        }
        out calls.call("polygon-deck", [["side", side()], ["top", top], ["content", content]])
    }
}
