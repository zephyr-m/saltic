-- run — сборка-образец «Обзора», субъект Run: что собиралось, под какую цель,
-- чем кончилось, кто запустил и сколько шло — строка таблицы сборок.
--
-- Run { name, target, state, tone, author, time } — jtml() -> build-row

use tarantul.uiengine.jtml.calls

Run = Box {
    name = "",
    target = "",
    state = "",
    tone = "quiet",
    author = "",
    time = ""

    skill jtml() {
        out calls.call("build-row", [["name", calls.quoted(name)], ["target", calls.quoted(target)], ["state", calls.quoted(state)], ["tone", calls.quoted(tone)], ["author", calls.quoted(author)], ["time", calls.quoted(time)]])
    }
}
