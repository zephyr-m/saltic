-- toolchain — сборщик модуля WASM. Запуск из корня репозитория:
-- toolchain <исходник> <выход.wasm> <куча>
-- Куча — байты программы в bss, кратно 8. Числа программы — 29 бит.

use core.str
use core.group
use io
use io.file
use selfhost.parser
use selfhost.checker
use selfhost.compiler
use selfhost.compiler.backend.wasm
use selfhost.compiler.backend.wasm.lower
use os.target.wasm.platform
use selfhost.machine.wide

skill show_diagnostics(diagnostics) {
    @index = 0
    @count = group.count(diagnostics)
    drum (count) {
        @item = group.get(diagnostics, index)
        io.show("{item.code}|{item.line}|{item.col}|{item.message}")
        index = index + 1
    }
    out none
}

program(source_path, output_path, heap_text) {
    io.show("wasm: читаю {source_path}")
    @loaded = parser.load_modules(source_path, ".")
    (group.count(loaded.diagnostics) > 0) {
        show_diagnostics(loaded.diagnostics)
        out error.ParseFailed
    }
    io.show("wasm: проверяю")
    @checked = checker.check_file(loaded.ast, source_path)
    (group.count(checked.diagnostics) > 0) {
        show_diagnostics(checked.diagnostics)
        out error.CheckFailed
    }
    (str.starts_with(heap_text, "-") == yes) { out error.ValueOutsideRange }
    @heap_size = wide.from_decimal(heap_text)
    io.show("wasm: собираю")
    @machine = compiler.compile_machine(checked.tree, heap_size, wasm.Executor {}, platform.Platform {})
    @image = lower.image_of(machine) rescue |failure| { out error.WasmLink }
    io.show("wasm: пишу {output_path}")
    file.write_bytes(output_path, image) rescue |failure| { out error.WriteFailed }
    out none
}
