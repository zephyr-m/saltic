-- line — rt_platform_read_line: одна строка stdin без перевода строки.
-- Конец ввода и сбой чтения — File. Длиннее 65536 байт — остаток следующим вызовом.

use compiler.abi
use compiler.gorn.backend
use compiler.gorn.platform
use compiler.gorn.backend.wasm.asm
use compiler.gorn.backend.rv32i.runtime.tails

LIMIT = 65536
NEWLINE = 10
CARRIAGE = 13
IOV = 2048

skill frame(words) {
    out LIMIT + words.bytes * 3
}

skill pull(billet) {
    @executor = billet.executor
    billet = executor.load_immediate(billet, backend.SCRATCH5, IOV)
    billet = executor.store(billet, backend.ERROR, backend.SCRATCH5, 0)
    billet = executor.store(billet, backend.ARG2, backend.SCRATCH5, 4)
    billet = executor.store_zero(billet, backend.SCRATCH5, 8)
    billet = executor.move(billet, backend.ERROR, backend.SCRATCH5)
    billet = executor.add_immediate(billet, backend.ARG3, backend.SCRATCH5, 8)
    billet = executor.load_immediate(billet, backend.ARG2, 1)
    out executor.wasi(billet, asm.WASI_READ)
}

skill emit(billet) {
    @executor = billet.executor
    @words = billet.words
    @size = frame(words)
    billet = executor.label(billet, platform.READ_LINE)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -size)
    billet = executor.store(billet, backend.RETURN, backend.STACK, 0)
    billet = executor.load_immediate(billet, backend.SCRATCH0, 0)
    billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes)
    billet = executor.label(billet, ".L_wa_line_next")
    billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes)
    billet = executor.load_immediate(billet, backend.SCRATCH1, LIMIT)
    billet = executor.branch_greater_equal(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_wa_line_done")
    billet = executor.add_immediate(billet, backend.SCRATCH1, backend.STACK, words.bytes * 2)
    billet = executor.add(billet, backend.ERROR, backend.SCRATCH1, backend.SCRATCH0)
    billet = executor.load_immediate(billet, backend.VALUE, 0)
    billet = executor.load_immediate(billet, backend.ARG2, 1)
    billet = pull(billet)
    billet = executor.branch_nonzero(billet, backend.ERROR, ".L_wa_line_fail")
    billet = executor.branch_zero(billet, backend.VALUE, ".L_wa_line_end")
    billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes)
    billet = executor.add_immediate(billet, backend.SCRATCH1, backend.STACK, words.bytes * 2)
    billet = executor.add(billet, backend.SCRATCH2, backend.SCRATCH1, backend.SCRATCH0)
    billet = executor.load_byte(billet, backend.SCRATCH3, backend.SCRATCH2, 0)
    billet = executor.load_immediate(billet, backend.SCRATCH4, NEWLINE)
    billet = executor.branch_equal(billet, backend.SCRATCH3, backend.SCRATCH4, ".L_wa_line_done")
    billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, 1)
    billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes)
    billet = executor.jump(billet, ".L_wa_line_next")
    billet = executor.label(billet, ".L_wa_line_end")
    billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes)
    billet = executor.branch_zero(billet, backend.SCRATCH0, ".L_wa_line_fail")
    billet = executor.label(billet, ".L_wa_line_done")
    billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes)
    billet = executor.add_immediate(billet, backend.SCRATCH1, backend.STACK, words.bytes * 2)
    billet = executor.branch_zero(billet, backend.SCRATCH0, ".L_wa_line_cut")
    billet = executor.add(billet, backend.SCRATCH2, backend.SCRATCH1, backend.SCRATCH0)
    billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, -1)
    billet = executor.load_byte(billet, backend.SCRATCH3, backend.SCRATCH2, 0)
    billet = executor.load_immediate(billet, backend.SCRATCH4, CARRIAGE)
    billet = executor.branch_not_equal(billet, backend.SCRATCH3, backend.SCRATCH4, ".L_wa_line_cut")
    billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, -1)
    billet = executor.label(billet, ".L_wa_line_cut")
    billet = executor.add(billet, backend.SCRATCH2, backend.SCRATCH1, backend.SCRATCH0)
    billet = executor.store_byte_zero(billet, backend.SCRATCH2, 0)
    billet = executor.move(billet, backend.VALUE, backend.SCRATCH1)
    billet = executor.call(billet, "rt_cstring")
    billet = executor.load(billet, backend.RETURN, backend.STACK, 0)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, size)
    billet = tails.ok(billet)
    billet = executor.label(billet, ".L_wa_line_fail")
    billet = executor.load(billet, backend.RETURN, backend.STACK, 0)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, size)
    billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
    billet = executor.load_immediate(billet, backend.ERROR, abi.ERROR_FILE)
    out executor.ret(billet)
}
