-- platform — WASI для wasm32. write, exit, now и куча в bss.
-- Остальные rt_platform_* отвечают NotSupported. Вход platform_start ставит
-- стек на метку asm.STACK_TOP (вершину подставляет lower после раскладки),
-- кладёт на него [argc, argv…, 0, 0] из args_get WASI и прыгает на _start.

use compiler.abi
use compiler.memory.model
use compiler.gorn.backend
use compiler.gorn.platform
use compiler.gorn.backend.wasm.wasm32
use compiler.gorn.backend.wasm.wasm32.asm
use compiler.gorn.backend.runtime.tails
use os.target.wasm.platform.files
use os.target.wasm.platform.line

FRAME = 16

UNSUPPORTED = ["key", "file_write_program", "wait", "firmware", "call", "process_pipe", "process_wait", "process_read", "process_close", "process_executable", "environment", "file_list", "process_open", "process_input", "process_write", "log_open", "stack"]

Platform = Box {
    name = "wasm",
    arena_bytes = model.ARENA_BYTES,
    default_heap_bytes = model.DEFAULT_HEAP_BYTES

    skill append(billet) {
        billet = emit_start(billet)
        billet = emit_write(billet)
        billet = emit_exit(billet)
        billet = emit_now(billet)
        billet = files.emit(billet)
        billet = line.emit(billet)
        billet = platform.append_heap_reserve(billet)
        drum (UNSUPPORTED) { billet = platform.emit_unsupported(billet, beat) }
        out billet
    }
}

skill emit_start(billet) {
    @executor = billet.executor
    billet = executor.label(billet, "platform_start")
    billet = executor.load_address(billet, backend.STACK, asm.STACK_TOP, 0)
    billet = executor.wasi(billet, asm.WASI_ARGS)
    out executor.jump(billet, "_start")
}

skill emit_write(billet) {
    @executor = billet.executor
    billet = executor.label(billet, platform.WRITE)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -FRAME)
    billet = executor.store(billet, backend.ERROR, backend.STACK, 0)
    billet = executor.store(billet, backend.ARG2, backend.STACK, 4)
    billet = executor.store_zero(billet, backend.STACK, 8)
    billet = executor.move(billet, backend.ERROR, backend.STACK)
    billet = executor.add_immediate(billet, backend.ARG3, backend.STACK, 8)
    billet = executor.load_immediate(billet, backend.ARG2, 1)
    billet = executor.wasi(billet, asm.WASI_WRITE)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, FRAME)
    billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(billet)
}

skill emit_exit(billet) {
    @executor = billet.executor
    billet = executor.label(billet, platform.EXIT)
    out executor.wasi(billet, asm.WASI_EXIT)
}

skill emit_now(billet) {
    @executor = billet.executor
    billet = executor.label(billet, platform.NOW)
    billet = executor.wasi(billet, asm.WASI_NOW)
    billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    out tails.ok(billet)
}
