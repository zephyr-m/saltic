use core.str
use core.group
use os.target.uefi_x86_64.firmware
use os.target.uefi_x86_64.graphics
use os.target.uefi_x86_64.tint
use os.target.uefi_x86_64.typeset
use os.target.uefi_x86_64.sans

HEIGHT = 28
RADIUS = 6
PADDING = 12
GAP = 8
SAMPLES = 4
FULL = 16
CARD_RADIUS = 10
CAPTION_WIDTH = 80

Look = Box {
    fill = tint.Rgb {},
    ink = tint.Rgb {},
    edge = tint.Rgb {},
    framed = no
}

skill coverage(column, row, radius) {
    @limit = 64 * radius * radius
    @inside = 0
    drum (SAMPLES) {
        @dx = 8 * column + 2 * beat + 1 - 8 * radius
        drum (SAMPLES) {
            @dy = 8 * row + 2 * beat + 1 - 8 * radius
            (dx * dx + dy * dy < limit + 1) { inside = inside + 1 }
        }
    }
    out inside
}

skill rounded(screen, x, y, width, height, radius, color, under) {
    @solid = tint.paint(screen, color)
    drum (height) {
        @row = beat
        @from_edge = row
        (row > height - radius - 1) { from_edge = height - 1 - row }
        pick {
            (from_edge < radius) {
                drum (radius) {
                    @shade = tint.paint(screen, tint.mix(under, color, coverage(beat, from_edge, radius), FULL))
                    graphics.fill(screen, x + beat, y + row, 1, 1, shade)
                    graphics.fill(screen, x + width - 1 - beat, y + row, 1, 1, shade)
                }
                graphics.fill(screen, x + radius, y + row, width - 2 * radius, 1, solid)
            }
            { graphics.fill(screen, x, y + row, width, 1, solid) }
        }
    }
    out none
}

skill button_width(label) {
    out typeset.measure(label) + 2 * PADDING
}

skill draw_button(screen, x, y, label, look, under) {
    @width = button_width(label)
    pick {
        (look.framed == yes) {
            rounded(screen, x, y, width, HEIGHT, RADIUS, look.edge, under)
            rounded(screen, x + 1, y + 1, width - 2, HEIGHT - 2, RADIUS - 1, look.fill, look.edge)
        }
        { rounded(screen, x, y, width, HEIGHT, RADIUS, look.fill, under) }
    }
    typeset.draw_text(screen, x + PADDING, y + (HEIGHT - sans.LINE) / 2, label, look.ink)
    out x + width + GAP
}

skill primary() {
    out Look { fill = tint.zinc_900(), ink = tint.paper() }
}

skill secondary() {
    out Look { fill = tint.zinc_100(), ink = tint.zinc_900() }
}

skill outline() {
    out Look { fill = tint.white(), ink = tint.zinc_900(), edge = tint.zinc_200(), framed = yes }
}

skill destructive() {
    out Look { fill = tint.red_500(), ink = tint.white() }
}

skill ghost() {
    out Look { fill = tint.white(), ink = tint.zinc_900() }
}

skill hovered(look, under, strength) {
    out Look { fill = tint.mix(under, look.fill, strength, FULL), ink = look.ink, edge = look.edge, framed = look.framed }
}

skill disabled(look, under) {
    out Look { fill = tint.mix(under, look.fill, 8, FULL), ink = tint.mix(under, look.ink, 8, FULL), edge = tint.mix(under, look.edge, 8, FULL), framed = look.framed }
}

skill caption(screen, x, y, text) {
    typeset.draw_text(screen, x, y + (HEIGHT - sans.LINE) / 2, text, tint.zinc_500())
    out none
}

skill demo() {
    @screen = graphics.open(firmware.guest_base())
    @card = tint.white()
    @left = 40
    @top = 500
    rounded(screen, left, top, 640, 144, CARD_RADIUS, tint.zinc_200(), tint.paper())
    rounded(screen, left + 1, top + 1, 638, 142, CARD_RADIUS - 1, card, tint.zinc_200())
    typeset.draw_text(screen, left + 16, top + 12, "Кнопка", tint.zinc_900())
    typeset.draw_text(screen, left + 16, top + 32, "Первый компонент UIEngine в духе shadcn. Шрифт Noto Sans 14 px со сглаживанием.", tint.zinc_500())
    @x = left + 16
    @row = top + 64
    caption(screen, x, row, "варианты")
    x = x + CAPTION_WIDTH
    x = draw_button(screen, x, row, "Сохранить", primary(), card)
    x = draw_button(screen, x, row, "Отмена", secondary(), card)
    x = draw_button(screen, x, row, "Подробнее", outline(), card)
    x = draw_button(screen, x, row, "Удалить", destructive(), card)
    x = draw_button(screen, x, row, "Пропустить", ghost(), card)
    x = left + 16
    row = row + HEIGHT + 8
    caption(screen, x, row, "состояния")
    x = x + CAPTION_WIDTH
    x = draw_button(screen, x, row, "Обычная", primary(), card)
    x = draw_button(screen, x, row, "Наведена", hovered(primary(), card, 13), card)
    x = draw_button(screen, x, row, "Выключена", disabled(primary(), card), card)
    x = draw_button(screen, x, row, "Рамка наведена", Look { fill = tint.zinc_100(), ink = tint.zinc_900(), edge = tint.zinc_200(), framed = yes }, card)
    out "нарисовал компактную карточку: кнопки 28 px, поля 12"
}

skill variants_card(screen, left, top, title) {
    @card = tint.white()
    rounded(screen, left, top, 680, 124, CARD_RADIUS, tint.zinc_200(), tint.paper())
    rounded(screen, left + 1, top + 1, 678, 122, CARD_RADIUS - 1, card, tint.zinc_200())
    typeset.draw_text(screen, left + 24, top + 20, title, tint.zinc_900())
    @x = left + 24
    @row = top + 64
    caption(screen, x, row, "варианты")
    x = x + CAPTION_WIDTH
    x = draw_button(screen, x, row, "Сохранить", primary(), card)
    x = draw_button(screen, x, row, "Отмена", secondary(), card)
    x = draw_button(screen, x, row, "Подробнее", outline(), card)
    x = draw_button(screen, x, row, "Удалить", destructive(), card)
    x = draw_button(screen, x, row, "Пропустить", ghost(), card)
    out none
}
