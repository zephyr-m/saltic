-- notes — маленькие текстовые файлы программ в \SALTIC: сохранить текст
-- под именем и прочитать его обратно (UTF-8, до 32 КБ). Файл пишется целиком
-- заново, старый сначала удаляется. Буфер — в арене программы со смещения
-- 131072, программа не должна занимать это место сама.
--
-- save_note(base, name, text) -> байт записано; WriteFailed
-- load_note(base, name) -> текст; нет файла — ""

use core.str
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.utf8
use os.target.uefi_x86_64.storage.files

FOLDER = "SALTIC"
FILE_DELETE = 24
MODE_READ_WRITE = 3
NOTE_BUFFER = 131072
NOTE_LIMIT = 32768

skill note_buffer(base) {
    out firmware.add(firmware.arena(base), NOTE_BUFFER)
}

skill drop_note(base, folder, name) {
    @child_at = firmware.scratch(base, files.SCRATCH_POINTER)
    @opened = firmware.call(base, firmware.pointer(folder, base, files.FILE_OPEN), [folder, child_at, files.wide_name(base, name), firmware.number(MODE_READ_WRITE), firmware.number(0)])
    (opened.failed == yes) { out none }
    @old = firmware.pointer(child_at, base, 0)
    out firmware.call(base, firmware.pointer(old, base, FILE_DELETE), [old])
}

skill save_note(base, name, text) {
    @written = utf8.encode(text)
    @buffer = note_buffer(base)
    drum (group.count(written)) { firmware.write8(buffer, base, beat, group.get(written, beat)) }
    @root = files.saltic_root(base)
    @folder = files.create(base, root, FOLDER, files.DIRECTORY)
    drop_note(base, folder, name)
    @file = files.create(base, folder, name, 0)
    @size_at = firmware.scratch(base, files.SCRATCH_SIZE)
    firmware.write64(size_at, base, 0, firmware.number(group.count(written)))
    @done = firmware.call(base, firmware.pointer(file, base, files.FILE_WRITE), [file, size_at, buffer])
    firmware.call(base, firmware.pointer(file, base, files.FILE_FLUSH), [file])
    files.close_file(base, file)
    files.close_file(base, folder)
    files.close_file(base, root)
    (done.failed == yes) { out error.WriteFailed }
    out group.count(written)
}

skill load_note(base, name) {
    @root = files.saltic_root(base)
    @file = files.open_child(base, root, str.add("SALTIC\\", name)) rescue |err| {
        files.close_file(base, root)
        out ""
    }
    @buffer = note_buffer(base)
    @size_at = firmware.scratch(base, files.SCRATCH_SIZE)
    firmware.write64(size_at, base, 0, firmware.number(NOTE_LIMIT))
    @asked = firmware.call(base, firmware.pointer(file, base, files.FILE_READ), [file, size_at, buffer])
    files.close_file(base, file)
    files.close_file(base, root)
    (asked.failed == yes) { out "" }
    @size = firmware.read16(size_at, base, 0)
    @found = []
    drum (size) { found = group.add(found, firmware.read8(buffer, base, beat)) }
    out utf8.decode(found, 0, size)
}
