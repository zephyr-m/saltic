-- geometry — геометрия рисунков (паутина, пейзаж, пластилин): синус и
-- косинус в фиксированной точке, целый корень, нарезка нитей на куски. Углы
-- и направления — в долях ONE (16.16): 61-битное число держит произведение
-- двух таких величин без переполнения.
-- Координаты — целые пиксели.
--
-- ONE, PI, TURN — единица, π и 2π в долях ONE
-- sine(angle) / cosine(angle) -> доли ONE; angle — от 0 до TURN
-- root(value) -> целый квадратный корень
-- Piece { x0, y0, x1, y1, ink } — кусок пути паука; ink 0 — идёт без нити
-- line(plan, x0, y0, x1, y1, ink, step) -> plan с отрезком, нарезанным по step
-- curve(plan, from, to, pull, ink, step) -> plan с дугой из from в to через
--     контрольную точку pull (точки — [x, y]): четыре отрезка квадратичной кривой
-- sag(x0, y0, x1, y1, hx, hy, percent) -> [cx, cy] — середина, оттянутая к
--     центру (hx, hy) на percent процентов

use core.group

ONE = 65536
PI = 205887
TURN = 411775
TERMS = 8

Piece = Box {
    x0 = 0,
    y0 = 0,
    x1 = 0,
    y1 = 0,
    ink = 0
}

skill sine(angle) {
    @x = angle
    (x > PI) { x = x - TURN }
    @term = x
    @sum = x
    drum (TERMS) {
        @k = beat + 1
        term = -term * x / ONE * x / ONE / (2 * k * (2 * k + 1))
        sum = sum + term
    }
    out sum
}

skill cosine(angle) {
    @shifted = angle + PI / 2
    (shifted > TURN) { shifted = shifted - TURN }
    out sine(shifted)
}

skill root(value) {
    (value < 2) { out value }
    @guess = value
    @next = (value + 1) / 2
    always {
        (next >= guess) { leave }
        guess = next
        next = (guess + value / guess) / 2
    }
    out guess
}

skill line(plan, x0, y0, x1, y1, ink, step) {
    @dx = x1 - x0
    @dy = y1 - y0
    @count = root(dx * dx + dy * dy) / step + 1
    @fx = x0
    @fy = y0
    drum (count) {
        @tx = x0 + dx * (beat + 1) / count
        @ty = y0 + dy * (beat + 1) / count
        plan = group.add(plan, Piece { x0 = fx, y0 = fy, x1 = tx, y1 = ty, ink = ink })
        fx = tx
        fy = ty
    }
    out plan
}

skill curve(plan, from, to, pull, ink, step) {
    @x0 = group.get(from, 0)
    @y0 = group.get(from, 1)
    @x1 = group.get(to, 0)
    @y1 = group.get(to, 1)
    @cx = group.get(pull, 0)
    @cy = group.get(pull, 1)
    @fx = x0
    @fy = y0
    drum (4) {
        @k = beat + 1
        @rest = 4 - k
        @tx = (rest * rest * x0 + 2 * rest * k * cx + k * k * x1) / 16
        @ty = (rest * rest * y0 + 2 * rest * k * cy + k * k * y1) / 16
        plan = line(plan, fx, fy, tx, ty, ink, step)
        fx = tx
        fy = ty
    }
    out plan
}

skill sag(x0, y0, x1, y1, hx, hy, percent) {
    @mx = (x0 + x1) / 2
    @my = (y0 + y1) / 2
    out [mx + (hx - mx) * percent / 100, my + (hy - my) * percent / 100]
}
