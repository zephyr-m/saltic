-- graphics — кадровый буфер прошивки (GOP) и задний буфер с дельтой.
-- Пиксель — 32 бита, адрес — (y * stride + x) * 4 от memory. Задний буфер —
-- такой же Screen в обычной памяти: всё рисуется в него, а present копирует
-- в видеопамять только изменившиеся куски строк (CopyMem прошивки). Запись в
-- видеопамять в разы дороже записи в ОЗУ, и экран не мигает.
--
-- Screen — ширина, высота, stride, формат, frame (Phys), memory (для core.mem)
-- open(base) -> Screen видеопамяти — средняя половина ширины; NoGraphics.
--     Левая четверть — сетевой журнал (network/netlog), правая — системная
--     панель (screen/system_panel); программы их не видят и рисуют от нуля
-- open_whole(base) -> Screen всего экрана: панели и снимок
-- side_width(width) -> ширина боковой панели из полной ширины
-- color(screen, red, green, blue) -> пиксель
-- fill(screen, x, y, width, height, value) — прямоугольник
-- format_name(screen) -> текст
-- Frames — front (видеопамять), back (рисовать сюда), last (что сейчас на экране)
-- open_frames(base) -> Frames; MemoryExhausted
-- present(frames) -> текст «строк N, пикселей M» — показать дельту
-- close_frames(frames) — вернуть буферы прошивке (перед выходом)
-- Буферы берутся в окне программы (uefi.pages_in_window): ниже базы их не видно.

use core.mem
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.uefi

BOOT_LOCATE_PROTOCOL = 320
GOP_GUID = [222, 169, 66, 144, 220, 35, 56, 74, 150, 251, 122, 222, 208, 128, 81, 106]
GOP_MODE = 24
MODE_INFO = 8
MODE_FRAME = 24
INFO_WIDTH = 4
INFO_HEIGHT = 8
INFO_FORMAT = 12
INFO_STRIDE = 32
FORMAT_RGB = 0
FORMAT_BGR = 1
PIXEL_BYTES = 4
PAGE_BYTES = 4096
BOOT_COPY_MEM = 352
SIDE_SHARE = 4

Screen = Box {
    width = 0,
    height = 0,
    stride = 0,
    format = 0,
    frame = firmware.Phys {},
    memory = []
}

skill open(base) {
    @screen = open_whole(base)
    @left = side_width(screen.width)
    screen.frame = firmware.add(screen.frame, left * PIXEL_BYTES)
    screen.memory = firmware.guest(screen.frame, base)
    screen.width = screen.width - 2 * left
    out screen
}

skill side_width(width) {
    out width / SIDE_SHARE
}

skill open_whole(base) {
    @guid_at = firmware.scratch(base, 32)
    drum (16) { firmware.write8(guid_at, base, beat, group.get(GOP_GUID, beat)) }
    @found_at = firmware.scratch(base, 64)
    @services = uefi.boot_services(base)
    @located = firmware.call(base, firmware.pointer(services, base, BOOT_LOCATE_PROTOCOL), [guid_at, firmware.number(0), found_at])
    (located.failed == yes) { out error.NoGraphics }
    @protocol = firmware.pointer(found_at, base, 0)
    @mode = firmware.pointer(protocol, base, GOP_MODE)
    @info = firmware.pointer(mode, base, MODE_INFO)
    @frame = firmware.pointer(mode, base, MODE_FRAME)
    out Screen {
        width = firmware.read16(info, base, INFO_WIDTH),
        height = firmware.read16(info, base, INFO_HEIGHT),
        stride = firmware.read16(info, base, INFO_STRIDE),
        format = firmware.read16(info, base, INFO_FORMAT),
        frame = frame,
        memory = firmware.guest(frame, base)
    }
}

skill color(screen, red, green, blue) {
    (screen.format == FORMAT_RGB) { out blue * 65536 + green * 256 + red }
    out red * 65536 + green * 256 + blue
}

skill fill(screen, x, y, width, height, value) {
    drum (height) {
        @row = ((y + beat) * screen.stride + x) * PIXEL_BYTES
        drum (width) { mem.store32(screen.memory, row + beat * PIXEL_BYTES, value) }
    }
    out none
}

skill format_name(screen) {
    (screen.format == FORMAT_RGB) { out "RGB" }
    (screen.format == FORMAT_BGR) { out "BGR" }
    out "особый ({screen.format})"
}

Frames = Box {
    front = Screen {},
    back = Screen {},
    last = Screen {},
    pages = 0
}

skill buffer_pages(front) {
    out (front.stride * front.height * PIXEL_BYTES + PAGE_BYTES - 1) / PAGE_BYTES
}

skill buffer_like(base, front) {
    @place = uefi.pages_in_window(base, buffer_pages(front))
    out Screen { width = front.width, height = front.height, stride = front.stride, format = front.format, frame = place, memory = firmware.guest(place, base) }
}

skill copy_span(base, to, from, y, left, count) {
    @offset = (y * to.stride + left) * PIXEL_BYTES
    @copy = firmware.pointer(uefi.boot_services(base), base, BOOT_COPY_MEM)
    out firmware.call(base, copy, [firmware.add(to.frame, offset), firmware.add(from.frame, offset), firmware.number(count * PIXEL_BYTES)])
}

skill open_frames(base) {
    @front = open(base)
    @frames = Frames { front = front, back = buffer_like(base, front), last = buffer_like(base, front), pages = buffer_pages(front) }
    drum (front.height) { copy_span(base, frames.last, front, beat, 0, front.width) }
    drum (front.height) { copy_span(base, frames.back, front, beat, 0, front.width) }
    out frames
}

skill present(frames) {
    @base = firmware.guest_base()
    @back = frames.back
    @last = frames.last
    @rows = 0
    @pixels = 0
    drum (back.height) {
        @y = beat
        @start = y * back.stride * PIXEL_BYTES
        @first = -1
        @final = -1
        drum (back.width) {
            @at = start + beat * PIXEL_BYTES
            ((mem.load32(back.memory, at) == mem.load32(last.memory, at)) == no) {
                (first < 0) { first = beat }
                final = beat
            }
        }
        (first > -1) {
            @count = final - first + 1
            copy_span(base, frames.front, back, y, first, count)
            copy_span(base, last, back, y, first, count)
            rows = rows + 1
            pixels = pixels + count
        }
    }
    out "строк {rows}, пикселей {pixels}"
}

skill close_frames(frames) {
    @base = firmware.guest_base()
    uefi.free_pages(base, frames.back.frame, frames.pages)
    out uefi.free_pages(base, frames.last.frame, frames.pages)
}
