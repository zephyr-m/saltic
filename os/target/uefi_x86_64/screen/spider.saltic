-- spider — маскот «паучок-скакун» пиксельной картинкой 40×30 (SPIDER).
-- Буквы в картинке — цвета (b, B, E, w, O, L), точка — прозрачно.
--
-- paint_color(screen, mark) -> цвет по букве
-- draw_at(base, left, top, scale) — паучок без 4 пустых верхних рядов
-- draw(base) — паучок справа вверху на светлой карточке с подписью

use core.str
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.screen.lettering

SCALE = 7
SPIDER = [
    "........................................",
    "........................................",
    "........................................",
    "........................................",
    "...............bbbbbbbbbb...............",
    ".............bbbbbbbbbbbbbb.............",
    "...........bbEbbbbbbbbbbbbEbb...........",
    "..........bbEEEBBBBBBBBBBEEEbb..........",
    ".........bbbBEBBBBBBBBBBBBEBbbb.........",
    ".........EbBBBBBBBBBBBBBBBBBBbE.........",
    "........EEEBBEEEEBBBBBBEEEEBBEEE........",
    "........EEEBEwwEEEBBBBEEEwwEBEEE........",
    "........bEBEEwwEEEEBBEEEEwwEEBEb........",
    ".......bbBBEEEEEEEEBBEEEEEEEEBBbb.......",
    "........bbBEEEEEEEEBBEEEEEEEEBbb........",
    "........bbBBEEEEEEBBBBEEEEEEBBbb........",
    "......LLbbBBBEEEEBBBBBBEEEEBBBbbLL......",
    ".....LLLLbbBBBBBBBBBBBBBBBBBBbbLLLL.....",
    "....LLLLLbbbBBBBBBBBBBBBBBBBbbbLLLLL....",
    "...LLL..LLbbbBBBBBBBBBBBBBBbbbLL..LLL...",
    "..LLLL.LLLLbbbBBBBBBBBBBBBbbbLLLL.LLLL..",
    ".LLL..LLL.LLLbbOOOOBBOOOObbLLL.LLL..LLL.",
    "LLL..LLL.LLLLLLOOOObbOOOOLLLLLL.LLL..LLL",
    "LLL..LLL.LLLLL.OOOO..OOOO.LLLLL.LLL..LLL",
    "LL..LLL.LLL.LL.OOOO..OOOO.LL.LLL.LLL..LL",
    "....LLL.LLLLLL............LLLLLL.LLL....",
    "...LLL.LLL.LL..............LL.LLL.LLL...",
    "...LL..LLL.LL..............LL.LLL..LL...",
    "......LLL.LLL..............LLL.LLL......",
    "......LLL.LL................LL.LLL......"
]

skill paint_color(screen, mark) {
    (mark == "b") { out graphics.color(screen, 120, 86, 60) }
    (mark == "B") { out graphics.color(screen, 70, 48, 36) }
    (mark == "E") { out graphics.color(screen, 15, 15, 18) }
    (mark == "w") { out graphics.color(screen, 255, 255, 255) }
    (mark == "O") { out graphics.color(screen, 245, 158, 11) }
    out graphics.color(screen, 55, 40, 32)
}

skill draw_at(base, left, top, scale) {
    @screen = graphics.open(base)
    drum (group.count(SPIDER) - 4) {
        @row = group.get(SPIDER, beat + 4)
        @y = top + beat * scale
        drum (str.len(row)) {
            @mark = str.get(row, beat)
            ((mark == ".") == no) { graphics.fill(screen, left + beat * scale, y, scale, scale, paint_color(screen, mark)) }
        }
    }
    out none
}

skill draw(base) {
    @screen = graphics.open(base)
    @width = str.len(group.get(SPIDER, 0)) * SCALE
    @left = screen.width - width - 60
    @top = 110
    graphics.fill(screen, left - 20, top - 10, width + 40, group.count(SPIDER) * SCALE + 70, graphics.color(screen, 250, 250, 250))
    drum (group.count(SPIDER)) {
        @row = group.get(SPIDER, beat)
        @y = top + beat * SCALE
        drum (str.len(row)) {
            @mark = str.get(row, beat)
            ((mark == ".") == no) { graphics.fill(screen, left + beat * SCALE, y, SCALE, SCALE, paint_color(screen, mark)) }
        }
    }
    @caption_top = top + group.count(SPIDER) * SCALE + 16
    lettering.paint_text(screen, lettering.FACE_TEXT, left + 8, caption_top, "паучок-скакун Saltic", graphics.color(screen, 24, 24, 27))
    out none
}
