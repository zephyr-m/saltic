-- season — палитры времён года для полянки: трава, кроны, кора, камни, крыши,
-- цветы, небо и что ещё растёт (снеговик зимой, тыквы осенью). Цвета —
-- [красный, зелёный, синий]. Вечер перекрашивает небо и солнце поверх сезона.
--
-- Season { name, grass, crowns, bark, stone, roofs, flowers, blooms, top,
--     low, sun, snow, extra } — сезон; blooms — [меньше, больше] цветов;
--     extra — NOTHING, SNOWMAN или PUMPKINS
-- SEASONS — весна, лето, осень, зима
-- EVENING_TOP / EVENING_LOW / EVENING_SUN — вечернее небо и солнце
-- rgb(color) -> canvas.Rgb из [r, g, b]
-- mix(a, b, percent) -> [r, g, b] — от a к b на percent из 100

use core.group
use os.uiengine.canvas

NOTHING = 0
SNOWMAN = 1
PUMPKINS = 2
EVENING_TOP = [112, 118, 188]
EVENING_LOW = [252, 176, 128]
EVENING_SUN = [255, 168, 104]

Season = Box {
    name = "",
    grass = [96, 160, 84],
    crowns = [],
    bark = [150, 108, 78],
    stone = [176, 164, 184],
    roofs = [],
    flowers = [],
    blooms = [0, 0],
    top = [150, 196, 238],
    low = [252, 232, 214],
    sun = [255, 244, 222],
    snow = no,
    extra = NOTHING
}

SEASONS = [
    Season { name = "весна", grass = [124, 182, 98], crowns = [[246, 186, 206], [250, 228, 234], [156, 208, 120], [236, 158, 190]], bark = [140, 104, 80], stone = [180, 172, 188], roofs = [[214, 108, 82], [118, 150, 204]], flowers = [[250, 250, 250], [250, 212, 90], [240, 140, 182], [172, 150, 242]], blooms = [16, 24], top = [140, 198, 242], low = [250, 238, 224], sun = [255, 246, 226] },
    Season { name = "лето", grass = [96, 160, 84], crowns = [[122, 168, 112], [150, 196, 120], [236, 150, 170], [240, 176, 110]], roofs = [[214, 108, 82], [196, 84, 70], [94, 130, 180]], flowers = [[250, 220, 80], [240, 110, 110], [250, 250, 250]], blooms = [8, 14], sun = [255, 242, 212] },
    Season { name = "осень", grass = [166, 158, 92], crowns = [[234, 128, 56], [220, 86, 60], [238, 186, 72], [182, 152, 70]], bark = [124, 92, 70], roofs = [[150, 84, 66], [104, 112, 120]], top = [160, 188, 216], low = [244, 222, 196], sun = [255, 226, 186], extra = PUMPKINS },
    Season { name = "зима", grass = [234, 240, 250], crowns = [[70, 122, 98], [84, 134, 110], [62, 108, 92]], bark = [112, 86, 70], stone = [150, 150, 172], roofs = [[244, 246, 252]], top = [174, 200, 230], low = [236, 238, 246], sun = [255, 240, 224], snow = yes, extra = SNOWMAN }
]

skill rgb(color) {
    out canvas.Rgb { red = group.get(color, 0), green = group.get(color, 1), blue = group.get(color, 2) }
}

skill mix(a, b, percent) {
    @made = []
    drum (3) {
        @from = group.get(a, beat)
        made = group.add(made, from + (group.get(b, beat) - from) * percent / 100)
    }
    out made
}
