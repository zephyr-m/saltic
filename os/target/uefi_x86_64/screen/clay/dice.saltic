-- dice — кубик процедурной полянки: линейный конгруэнтный генератор
-- (x · 69069 + 1) mod 2³². Произведение меньше 2⁴⁹, до переполнения далеко.
-- Одно зерно — одна и та же полянка.
--
-- Dice { state } — кубик
-- seed(clock) -> зерно из uefi.Clock
-- roll(luck, count) -> 0…count-1
-- between(luck, low, high) -> low…high
-- chance(luck, percent) -> yes с вероятностью percent из 100
-- pick_one(luck, items) -> случайный элемент группы

use core.group

MODULO = 4294967296

Dice = Box {
    state = 1
}

skill seed(clock) {
    out ((clock.month * 31 + clock.day) * 24 + clock.hour) * 3600 + clock.minute * 60 + clock.second
}

skill roll(luck, count) {
    luck.state = (luck.state * 69069 + 1) % MODULO
    (count < 1) { out 0 }
    out luck.state / 65536 % count
}

skill between(luck, low, high) {
    out low + roll(luck, high - low + 1)
}

skill chance(luck, percent) {
    out roll(luck, 100) < percent
}

skill pick_one(luck, items) {
    out group.get(items, roll(luck, group.count(items)))
}
