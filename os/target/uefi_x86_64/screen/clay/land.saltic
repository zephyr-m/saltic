-- land — рельеф полянки: сумма трёх случайных волн (вдоль x, вдоль z и по
-- диагонали) и, если повезёт, чаша пруда. Высота нужна и сетке земли, и
-- запеканию света — лучу, который падает на траву.
--
-- Land { waves, pond } — волна [вид, период, высота, сдвиг]: вид 0 — по x,
--     1 — по z, 2 — по x + z, 3 — по x - z; pond — [x, z, радиус], радиус 0 —
--     пруда нет
-- DEPTH — глубина чаши пруда в центре
-- raise(luck) -> Land
-- height(land, x, z) -> высота земли
-- water(land) -> уровень воды
-- near_pond(land, x, z, gap) -> yes, если до берега меньше gap

use core.group
use os.target.uefi_x86_64.screen.geometry
use os.target.uefi_x86_64.screen.clay.dice
use os.target.uefi_x86_64.screen.clay.forms

DEPTH = 36

Land = Box {
    waves = [],
    pond = [0, 0, 0]
}

skill raise(luck) {
    @land = Land {}
    @waves = []
    drum (3) {
        @kind = beat
        (kind == 2) { kind = dice.between(luck, 2, 3) }
        waves = group.add(waves, [kind, dice.between(luck, 520, 1250), dice.between(luck, 12, 50), dice.roll(luck, 1024) * geometry.TURN / 1024])
    }
    land.waves = waves
    (dice.chance(luck, 55) == yes) { land.pond = [dice.between(luck, -200, 200), dice.between(luck, -200, 200), dice.between(luck, 50, 80)] }
    out land
}

skill along(kind, x, z) {
    (kind == 0) { out x }
    (kind == 1) { out z }
    (kind == 2) { out x + z }
    out x - z
}

skill hills(land, x, z) {
    @sum = 0
    drum (group.count(land.waves)) {
        @wave = group.get(land.waves, beat)
        @angle = forms.wrap(along(group.get(wave, 0), x, z) * geometry.TURN / group.get(wave, 1) + group.get(wave, 3))
        sum = sum + group.get(wave, 2) * geometry.sine(angle) / geometry.ONE
    }
    out sum
}

skill height(land, x, z) {
    @base = hills(land, x, z)
    @radius = group.get(land.pond, 2)
    (radius == 0) { out base }
    @dx = x - group.get(land.pond, 0)
    @dz = z - group.get(land.pond, 1)
    @reach = radius * 3 / 2
    @far = dx * dx + dz * dz
    (far >= reach * reach) { out base }
    out base - DEPTH * (reach * reach - far) / (reach * reach)
}

skill water(land) {
    out hills(land, group.get(land.pond, 0), group.get(land.pond, 1)) - DEPTH / 3
}

skill near_pond(land, x, z, gap) {
    @radius = group.get(land.pond, 2)
    (radius == 0) { out no }
    @dx = x - group.get(land.pond, 0)
    @dz = z - group.get(land.pond, 1)
    @reach = radius * 3 / 2 + gap
    out dx * dx + dz * dz < reach * reach
}
