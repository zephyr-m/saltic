-- forms — заготовки форм для «Пластилина»: эллипсоид (шар, капля, ствол),
-- скруглённый куб и плоская тень-клякса. Все строятся одной сеткой «широта ×
-- долгота» вокруг центра: rings колец по широте, вдвое больше по долготе.
-- Скруглённый куб — та же сфера, притянутая к кубу наполовину.
--
-- ellipsoid(screen, center, radii, tint, rings) -> mesh.Body
-- rounded(screen, center, half, tint, rings) -> mesh.Body — скруглённый куб,
--     half — полуразмеры [x, y, z]
-- blot(screen, center, rx, rz, tint) -> mesh.Body — плоская тень на земле
-- wrap(angle) -> угол в 0…geometry.TURN

use core.num
use core.group
use os.target.uefi_x86_64.screen.geometry
use os.target.uefi_x86_64.screen.clay.mesh

BLOT_SIDES = 14
SQUARE = 55

skill wrap(angle) {
    out num.mod(num.mod(angle, geometry.TURN) + geometry.TURN, geometry.TURN)
}

skill direction(ring, step, rings) {
    @theta = geometry.PI * ring / rings
    @phi = geometry.TURN * step / (2 * rings)
    @across = geometry.sine(theta)
    out [across * geometry.cosine(phi) / geometry.ONE, geometry.cosine(theta), across * geometry.sine(phi) / geometry.ONE]
}

skill magnitude(value) {
    (value < 0) { out 0 - value }
    out value
}

skill squared(d) {
    @x = group.get(d, 0)
    @y = group.get(d, 1)
    @z = group.get(d, 2)
    @most = magnitude(x)
    (magnitude(y) > most) { most = magnitude(y) }
    (magnitude(z) > most) { most = magnitude(z) }
    (most == 0) { out d }
    @blend = []
    drum (3) {
        @v = group.get(d, beat)
        blend = group.add(blend, (v * geometry.ONE / most * SQUARE + v * (100 - SQUARE)) / 100)
    }
    out blend
}

skill shell(screen, center, size, tint, rings, boxy) {
    @body = mesh.Body { center = center }
    @around = 2 * rings
    @points = []
    drum (rings + 1) {
        @ring = beat
        drum (around) {
            @d = direction(ring, beat, rings)
            (boxy == yes) { d = squared(d) }
            points = group.add(points, [group.get(center, 0) + group.get(size, 0) * group.get(d, 0) / geometry.ONE, group.get(center, 1) + group.get(size, 1) * group.get(d, 1) / geometry.ONE, group.get(center, 2) + group.get(size, 2) * group.get(d, 2) / geometry.ONE])
        }
    }
    body.points = points
    drum (rings) {
        @ring = beat
        drum (around) {
            @next = num.mod(beat + 1, around)
            @middle = direction(2 * ring + 1, 2 * beat + 1, 2 * rings)
            (boxy == yes) { middle = squared(middle) }
            @normal = mesh.unit(group.get(middle, 0) * 64 / group.get(size, 0), group.get(middle, 1) * 64 / group.get(size, 1), group.get(middle, 2) * 64 / group.get(size, 2))
            body = mesh.face(screen, body, ring * around + beat, ring * around + next, (ring + 1) * around + next, (ring + 1) * around + beat, normal, tint)
        }
    }
    out body
}

skill ellipsoid(screen, center, radii, tint, rings) {
    out shell(screen, center, radii, tint, rings, no)
}

skill rounded(screen, center, half, tint, rings) {
    out shell(screen, center, half, tint, rings, yes)
}

skill blot(screen, center, rx, rz, tint) {
    @body = mesh.Body { center = center, flat = yes }
    @points = [center]
    drum (BLOT_SIDES) {
        @angle = geometry.TURN * beat / BLOT_SIDES
        points = group.add(points, [group.get(center, 0) + rx * geometry.cosine(angle) / geometry.ONE, group.get(center, 1), group.get(center, 2) + rz * geometry.sine(angle) / geometry.ONE])
    }
    body.points = points
    drum (BLOT_SIDES) {
        @next = num.mod(beat + 1, BLOT_SIDES) + 1
        body = mesh.face(screen, body, 0, beat + 1, next, next, [0, mesh.UNIT, 0], tint)
    }
    out body
}
