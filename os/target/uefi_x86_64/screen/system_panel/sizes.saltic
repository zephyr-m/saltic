-- sizes — подписи размеров, скоростей и долей по-русски. До десяти единиц —
-- с одной цифрой после запятой: «3,4 МБ», дальше целыми: «12 МБ».
--
-- scaled(value, divisor, unit) -> value / divisor в единицах unit
-- kb_text(kb) -> «512 КБ» / «3,4 МБ» / «1,2 ГБ»
-- mb_text(mb) -> «512 МБ» / «7,6 ГБ»
-- speed_text(bytes) -> «512 Б/с» / «12 КБ/с» / «1,5 МБ/с» — bytes за секунду
-- percent(part, whole) -> 0…100; whole = 0 — 0

use core.num

skill scaled(value, divisor, unit) {
    @whole = value / divisor
    (whole > 9) { out "{whole} {unit}" }
    @rest = num.mod(value, divisor) * 10 / divisor
    out "{whole},{rest} {unit}"
}

skill kb_text(kb) {
    (kb < 1024) { out "{kb} КБ" }
    (kb < 1048576) { out scaled(kb, 1024, "МБ") }
    out scaled(kb, 1048576, "ГБ")
}

skill mb_text(mb) {
    (mb < 1024) { out "{mb} МБ" }
    out scaled(mb, 1024, "ГБ")
}

skill speed_text(bytes) {
    (bytes < 1024) { out "{bytes} Б/с" }
    (bytes < 1048576) { out scaled(bytes, 1024, "КБ/с") }
    out scaled(bytes, 1048576, "МБ/с")
}

skill percent(part, whole) {
    (whole < 1) { out 0 }
    out part * 100 / whole
}
