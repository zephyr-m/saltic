-- rtl8111 — драйвер сетевой карты Realtek RTL8111 по MMIO (BAR2), без прерываний.
-- Кольца и буферы — участки арены rtl_* из arena_map: TX — один дескриптор
-- и буфер, RX — 4 дескриптора по 2048 байт. Порядок: open → configure →
-- send/received. Кадр — группа байтов.
--
-- Card { base, mmio, mac, tx_ring, rx_ring, tx_buffer, rx_buffers, sent_bytes,
--     received_bytes } — открытая карта; tx_buffer — адрес, куда можно сложить
--     кадр и позвать send_prepared; *_bytes — счётчики, обнуляет читатель
-- has_bit(value, bit) -> yes/no / with_bit(value, bit) -> число с битом
-- enable(base, config) — включает память и bus master в PCI
-- registers(base, config) -> адрес MMIO; Bar2IsNotMemory
-- read_mac(base, mmio) -> [6 байт]
-- link_text(status) -> "down" или "up, скорость, дуплекс"
-- delay(card, count) — пауза чтением регистра
-- open() -> Card; DeviceNotFound и ошибки registers
-- reset(card); ResetTimeout
-- descriptor(card, slot, flags, length, buffer) — пишет дескриптор по адресу slot
-- rx_flags(index) -> флаги / arm_rx(card, index) — отдаёт буфер карте
-- write_ring(card, register, ring) — адрес кольца в регистр
-- configure(card) — сброс, кольца, размеры, включение приёма и передачи
-- wait_link(card) -> текст линка; NoLink после 60 попыток
-- send(card, bytes) / send_prepared(card, length) -> length; SendTimeout
-- received(card, index) -> yes/no — карта отдала дескриптор RX
-- read_frame(card, index) -> [байты] / release(card, index) — вернуть карте
-- link(card) -> текст / status(card) -> байт PHY
-- Внутри: rx_slot / rx_buffer(card, index) -> адрес дескриптора и буфера RX

use core.num
use core.group
use os.target.uefi_x86_64.platform.firmware

VENDOR_REALTEK = 4332
MODEL_RTL8111 = 33128
PCI_COMMAND = 4
PCI_BAR2 = 24
PCI_BAR2_HIGH = 28
COMMAND_MEMORY = 2
COMMAND_BUS_MASTER = 4

REGISTER_TX_RING = 32
REGISTER_CHIP_COMMAND = 55
REGISTER_TX_POLL = 56
REGISTER_INTERRUPT_MASK = 60
REGISTER_INTERRUPT_STATUS = 62
REGISTER_TX_CONFIG = 64
REGISTER_RX_CONFIG = 68
REGISTER_CONFIG_LOCK = 80
REGISTER_PHY_STATUS = 108
REGISTER_RX_MAX_SIZE = 218
REGISTER_RX_RING = 228
REGISTER_TX_MAX_SIZE = 236

CHIP_RESET = 16
CHIP_RX_TX = 12
CONFIG_UNLOCK = 192
TX_POLL_NORMAL = 64
RX_CONFIG_LOW = 59151
TX_CONFIG_LOW = 1792
TX_CONFIG_HIGH = 768
RX_MAX_SIZE = 1536
TX_MAX_SIZE = 59

PHY_FULL_DUPLEX = 1
PHY_LINK = 2
PHY_10 = 4
PHY_100 = 8
PHY_1000 = 16

DESCRIPTOR_OWN = 32768
DESCRIPTOR_END = 16384
DESCRIPTOR_FIRST_LAST = 12288
DESCRIPTOR_BYTES = 16
RX_COUNT = 4
BUFFER_BYTES = 2048

Card = Box {
    base = 0,
    mmio = 0,
    mac = [],
    tx_ring = 0,
    rx_ring = 0,
    tx_buffer = 0,
    rx_buffers = 0,
    sent_bytes = 0,
    received_bytes = 0
}

skill has_bit(value, bit) {
    out num.mod(value / bit, 2) == 1
}

skill with_bit(value, bit) {
    (has_bit(value, bit) == yes) { out value }
    out value + bit
}

skill enable(base, config) {
    @before = firmware.read16(config, base, PCI_COMMAND)
    @after = with_bit(with_bit(before, COMMAND_MEMORY), COMMAND_BUS_MASTER)
    firmware.write16(config, base, PCI_COMMAND, after)
    out none
}

skill registers(base, config) {
    @low = firmware.read32(config, base, PCI_BAR2)
    (has_bit(num.mod(low, 65536), 1) == yes) { out error.Bar2IsNotMemory }
    @high = firmware.read32(config, base, PCI_BAR2_HIGH)
    out high * firmware.WORD + low - num.mod(low, 16)
}

skill read_mac(base, mmio) {
    @bytes = []
    drum (6) { bytes = group.add(bytes, firmware.read8(mmio, base, beat)) }
    out bytes
}

skill link_text(status) {
    (has_bit(status, PHY_LINK) == no) { out "down" }
    @speed = "?"
    (has_bit(status, PHY_10) == yes) { speed = "10" }
    (has_bit(status, PHY_100) == yes) { speed = "100" }
    (has_bit(status, PHY_1000) == yes) { speed = "1000" }
    @duplex = "half"
    (has_bit(status, PHY_FULL_DUPLEX) == yes) { duplex = "full" }
    out "up, {speed} Mbit/s, {duplex} duplex"
}

skill delay(card, count) {
    drum (count) { firmware.read8(card.mmio, card.base, REGISTER_PHY_STATUS) }
    out none
}

skill open() {
    @base = firmware.guest_base()
    @config = firmware.find_device(base, firmware.ecam(base), VENDOR_REALTEK, MODEL_RTL8111)
    enable(base, config)
    @mmio = registers(base, config)
    out Card {
        base = base,
        mmio = mmio,
        mac = read_mac(base, mmio),
        tx_ring = firmware.region(base, "rtl_tx_ring"),
        rx_ring = firmware.region(base, "rtl_rx_ring"),
        tx_buffer = firmware.region(base, "rtl_tx_buffer"),
        rx_buffers = firmware.region(base, "rtl_rx_buffers")
    }
}

skill reset(card) {
    firmware.write8(card.mmio, card.base, REGISTER_CHIP_COMMAND, CHIP_RESET)
    drum (100000) {
        (has_bit(firmware.read8(card.mmio, card.base, REGISTER_CHIP_COMMAND), CHIP_RESET) == no) { out none }
    }
    out error.ResetTimeout
}

skill descriptor(card, slot, flags, length, buffer) {
    firmware.write16(slot, card.base, 0, length)
    firmware.write16(slot, card.base, 4, 0)
    firmware.write16(slot, card.base, 6, 0)
    firmware.write_phys32(slot, card.base, 8, buffer)
    firmware.write16(slot, card.base, 12, 0)
    firmware.write16(slot, card.base, 14, 0)
    firmware.write16(slot, card.base, 2, flags)
    out none
}

skill rx_slot(card, index) {
    out firmware.add(card.rx_ring, index * DESCRIPTOR_BYTES)
}

skill rx_buffer(card, index) {
    out firmware.add(card.rx_buffers, index * BUFFER_BYTES)
}

skill rx_flags(index) {
    (index == RX_COUNT - 1) { out DESCRIPTOR_OWN + DESCRIPTOR_END }
    out DESCRIPTOR_OWN
}

skill arm_rx(card, index) {
    out descriptor(card, rx_slot(card, index), rx_flags(index), BUFFER_BYTES, rx_buffer(card, index))
}

skill write_ring(card, register, ring) {
    firmware.write_phys32(card.mmio, card.base, register, ring)
    firmware.write16(card.mmio, card.base, register + 4, 0)
    firmware.write16(card.mmio, card.base, register + 6, 0)
    out none
}

skill configure(card) {
    reset(card)
    firmware.write8(card.mmio, card.base, REGISTER_CONFIG_LOCK, CONFIG_UNLOCK)
    firmware.write16(card.mmio, card.base, REGISTER_INTERRUPT_MASK, 0)
    firmware.write16(card.mmio, card.base, REGISTER_INTERRUPT_STATUS, 65535)
    drum (RX_COUNT) { arm_rx(card, beat) }
    write_ring(card, REGISTER_TX_RING, card.tx_ring)
    write_ring(card, REGISTER_RX_RING, card.rx_ring)
    firmware.write16(card.mmio, card.base, REGISTER_RX_MAX_SIZE, RX_MAX_SIZE)
    firmware.write8(card.mmio, card.base, REGISTER_TX_MAX_SIZE, TX_MAX_SIZE)
    firmware.write8(card.mmio, card.base, REGISTER_CHIP_COMMAND, CHIP_RX_TX)
    firmware.write16(card.mmio, card.base, REGISTER_RX_CONFIG, RX_CONFIG_LOW)
    firmware.write16(card.mmio, card.base, REGISTER_RX_CONFIG + 2, 0)
    firmware.write16(card.mmio, card.base, REGISTER_TX_CONFIG, TX_CONFIG_LOW)
    firmware.write16(card.mmio, card.base, REGISTER_TX_CONFIG + 2, TX_CONFIG_HIGH)
    firmware.write8(card.mmio, card.base, REGISTER_CONFIG_LOCK, 0)
    out none
}

skill wait_link(card) {
    drum (60) {
        @status = firmware.read8(card.mmio, card.base, REGISTER_PHY_STATUS)
        (has_bit(status, PHY_LINK) == yes) { out link_text(status) }
        delay(card, 100000)
    }
    out error.NoLink
}

skill send(card, bytes) {
    drum (group.count(bytes)) { firmware.write8(card.tx_buffer, card.base, beat, group.get(bytes, beat)) }
    out send_prepared(card, group.count(bytes))
}

skill send_prepared(card, length) {
    descriptor(card, card.tx_ring, DESCRIPTOR_OWN + DESCRIPTOR_END + DESCRIPTOR_FIRST_LAST, length, card.tx_buffer)
    firmware.write8(card.mmio, card.base, REGISTER_TX_POLL, TX_POLL_NORMAL)
    drum (100000) {
        (firmware.read16(card.tx_ring, card.base, 2) < DESCRIPTOR_OWN) {
            card.sent_bytes = card.sent_bytes + length
            out length
        }
    }
    out error.SendTimeout
}

skill received(card, index) {
    out firmware.read16(rx_slot(card, index), card.base, 2) < DESCRIPTOR_OWN
}

skill read_frame(card, index) {
    @buffer = rx_buffer(card, index)
    @length = num.mod(firmware.read16(rx_slot(card, index), card.base, 0), 16384)
    (length > BUFFER_BYTES) { length = BUFFER_BYTES }
    card.received_bytes = card.received_bytes + length
    @bytes = []
    drum (length) { bytes = group.add(bytes, firmware.read8(buffer, card.base, beat)) }
    out bytes
}

skill release(card, index) {
    out arm_rx(card, index)
}

skill link(card) {
    out link_text(firmware.read8(card.mmio, card.base, REGISTER_PHY_STATUS))
}

skill status(card) {
    out firmware.read8(card.mmio, card.base, REGISTER_PHY_STATUS)
}
