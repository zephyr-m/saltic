-- intel_gpu — встроенная видеокарта Intel HD 620 (Kaby Lake, Gen9.5; 8086:5916),
-- по документации Intel (PRM), i915 в Linux и igt. Два движка: блиттер (BCS)
-- заливает и копирует прямоугольники, движок рендера (RCS) выполняет порции
-- команд 3D (intel_gpu/render). Процессор только кладёт команды в кольцо.
-- Старый режим кольца (без execlists) у этого поколения работает (как
-- i915.enable_execlists=0).
--
-- Адреса видеокарты — свои (GGTT): таблица страниц GTT лежит в окне регистров
-- с 8 МБ, запись — 64 бита: физический адрес страницы | 1. Прошивка
-- разметила первые 64 МБ (там экран, GOP: GGTT 0 = окно BAR2, aperture);
-- выше — мусор. Наши буферы размечаются «один в один»: адрес GGTT = свой
-- физический адрес (map_identity) — одна и та же страница всегда на одном
-- месте, и запомненный видеокартой перевод не устаревает. Кольца и страницы
-- отметок — у верха таблицы (REGION, около 4 ГБ: там нет ОЗУ): блиттер с
-- REGION, рендер с REGION + RENDER_SLOTS.
-- Видеокарта запоминает перевод адресов (TLB): страницы колец поэтому
-- постоянные на всё включение — первая программа выделяет их и кладёт в
-- таблицу конфигурации UEFI (GUID ниже; слово 0 — кольцо блиттера, слово 4 —
-- рендера, слово 8 — MAGIC, иначе слово 4 — мусор), остальные берут те же.
-- Порция блиттера начинается со сброса TLB (MI_FLUSH_DW, MI_INVALIDATE_TLB).
--
-- Gpu { base, mmio, aperture, ring, render, kept, blit_seq, render_seq } —
--     открытая видеокарта; aperture — адрес окна BAR2 (экран GOP в нём); ring
--     / render — физические адреса колец блиттера и рендера; kept — страница
--     таблицы UEFI; *_seq — номер последней отметки (fence) этой копии. Сам
--     счётчик номеров — общий, в kept (BLIT_SEQ_KEPT, RENDER_SEQ_KEPT): копий
--     Gpu у программы несколько (у каждого буфера своя) — номера не повторяются
-- Отметки: «движок дочитал кольцо» ещё не значит «сделал» — команды могут
--     исполняться дальше. Поэтому каждая порция кончается записью номера в
--     память (блиттер — MI_FLUSH_DW, рендер — PIPE_CONTROL после сброса
--     цели), и wait ждёт этот номер (как fence в i915). Слово отметки — на
--     странице за кольцом, по FENCE; номер растёт и между программами.
-- open(base) -> Gpu или none — нет видеокарты Intel / не проснулась
-- map(gpu, slot, place, pages) -> адрес GGTT — свои страницы place на
--     участке данных с номера slot (страницы по 4 КБ)
-- map_identity(gpu, place, pages) -> place — разметить «один в один»
-- screen_at(gpu, frame) -> адрес GGTT точки экрана GOP по её адресу в окне
-- fill(gpu, at, pitch, x, y, width, height, color) — залить прямоугольник
--     поверхности at (шаг строки pitch байт, 32 бита на пиксель)
-- copy(gpu, from, to, pitch, x, y, width, height) — скопировать прямоугольник
--     (те же x, y и шаг строки в обеих поверхностях: задний буфер и экран)
-- submit(gpu, words) — порция команд блиттеру (сброс TLB впереди)
-- submit_render(gpu, words) — порция команд рендеру, в конце — отметка
-- tails(gpu) -> [хвост рендера, хвост копирования] — байт в кольце RING_BYTES
-- frames(gpu) -> счётчик кадров дисплея A (PIPE_FRMCOUNT, 32 бита по кругу)
-- wait_vblank(gpu) -> yes, когда сменился PIPE_FRMCOUNT (vblank; VBLANK_WAITS)
-- reset_render(gpu) -> yes, если сброс прошёл: зависший движок рендера —
--     «готов к сбросу» (RESET_CTL), сброс домена рендера (GDRST), кольцо
--     заново на том же месте (как i915 gen8_reset_engines)
-- wait(gpu) / wait_render(gpu) -> yes, если движок записал последнюю отметку
--     (не дольше WAITS опросов, рендер — RENDER_WAITS: большой кадр
--     треугольников рисуется дольше); drained — дочитал ли кольцо (в HEAD выше
--     HEAD_OFFSET — счётчик оборотов, ниже — смещение)
-- Внутри: wake(…) — пробуждение (forcewake); start_ring / push / drained —
--     общее для обоих колец; ENGINE + TAIL/HEAD/START/CONTROL — регистры
-- SCREEN — адрес GGTT экрана GOP; DATA — первый слот участка данных

use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.uefi

VENDOR_INTEL = 32902
MODEL_HD620 = 22806
GTT = 8388608
BLITTER = 139264
RENDER = 8192
WAKE_BLITTER = 41352
ACK_BLITTER = 1245252
WAKE_RENDER = 41592
ACK_RENDER = 3460
WAKE = 65537
FLUSH_GTT = 1052680
TAIL = 48
HEAD = 52
START = 56
CONTROL = 60
GFX_MODE = 668
NO_EXECLISTS = 2147483648
RING_PAGES = 4
RING_BYTES = 16384
RING_ON = 12289
HEAD_OFFSET = 2097152
REGION = 1046528
RENDER_SLOTS = 8
DATA = 1046784
LOWEST = 16384
SCREEN = 0
PAGE = 4096
WAITS = 200000
RENDER_WAITS = 2000000
COLOR_BLT = 1412431877
COPY_BLT = 1425014792
DEPTH_32 = 50331648
ROP_COPY = 13369344
ROP_FILL = 15728640
FLUSH_TLB = 319045634
USE_GTT = 4
NOOP = 0
FENCE = 64
FLUSH_FENCE = 318783491
RENDER_FENCE = 2046820356
RENDER_FENCE_FLAGS = 17846304
SEQ_LIMIT = 1073741824
RENDER_KEPT = 4
BLIT_SEQ_KEPT = 12
RENDER_SEQ_KEPT = 16
RESET_CONTROL = 208
REQUEST_RESET = 65537
READY_TO_RESET = 2
GDRST = 37916
FRAME_COUNT = 458816
VBLANK_WAITS = 2000000
RESET_RENDER = 2
MAGIC_KEPT = 8
MAGIC = 1196446258
GUID = [83, 65, 76, 84, 73, 67, 45, 71, 80, 85, 0, 0, 0, 0, 0, 1]

Gpu = Box {
    base = 0,
    mmio = 0,
    aperture = 0,
    ring = 0,
    render = 0,
    kept = 0,
    blit_seq = 0,
    render_seq = 0
}

skill wake(mmio, base, register, ack) {
    firmware.write_phys32(mmio, base, register, WAKE)
    drum (1000) {
        (firmware.read32(mmio, base, ack) % 2 == 1) { out yes }
        uefi.poll_key(base, 10)
    }
    out no
}

skill open(base) {
    @config = firmware.find_device(base, firmware.ecam(base), VENDOR_INTEL, MODEL_HD620) rescue |err| { out none }
    @bar = firmware.read32(config, base, 16)
    @mmio = bar - bar % 16
    (wake(mmio, base, WAKE_BLITTER, ACK_BLITTER) == no) { out none }
    (wake(mmio, base, WAKE_RENDER, ACK_RENDER) == no) { out none }
    @window = firmware.read32(config, base, 24)
    @gpu = Gpu { base = base, mmio = mmio, aperture = window - window % 16 }
    @kept = uefi.find_table(base, GUID)
    (kept == 0) {
        kept = uefi.pages_below_4g(base, 1)
        drum (PAGE / 4) { firmware.write_phys32(kept, base, beat * 4, 0) }
        uefi.add_table(base, GUID, kept)
    }
    gpu.ring = firmware.read32(kept, base, 0)
    (gpu.ring == 0) {
        gpu.ring = start_ring(gpu, BLITTER, REGION)
        firmware.write_phys32(kept, base, 0, gpu.ring)
    }
    ((firmware.read32(kept, base, MAGIC_KEPT) == MAGIC) == no) {
        firmware.write_phys32(kept, base, RENDER_KEPT, 0)
        firmware.write_phys32(kept, base, BLIT_SEQ_KEPT, firmware.read32(gpu.ring, base, RING_PAGES * PAGE + FENCE))
        firmware.write_phys32(kept, base, RENDER_SEQ_KEPT, 0)
        firmware.write_phys32(kept, base, MAGIC_KEPT, MAGIC)
    }
    gpu.render = firmware.read32(kept, base, RENDER_KEPT)
    (gpu.render == 0) {
        gpu.render = start_ring(gpu, RENDER, REGION + RENDER_SLOTS)
        firmware.write_phys32(kept, base, RENDER_KEPT, gpu.render)
    }
    gpu.kept = kept
    gpu.blit_seq = firmware.read32(gpu.ring, base, RING_PAGES * PAGE + FENCE)
    gpu.render_seq = firmware.read32(gpu.render, base, RING_PAGES * PAGE + FENCE)
    out gpu
}

skill start_ring(gpu, engine, slot) {
    @base = gpu.base
    @ring = uefi.pages_below_4g(base, RING_PAGES + 1)
    drum ((RING_PAGES + 1) * PAGE / 4) { firmware.write_phys32(ring, base, beat * 4, NOOP) }
    map_slots(gpu, slot, ring, RING_PAGES + 1)
    @mmio = gpu.mmio
    firmware.write_phys32(mmio, base, engine + GFX_MODE, NO_EXECLISTS)
    firmware.write_phys32(mmio, base, engine + CONTROL, 0)
    firmware.write_phys32(mmio, base, engine + HEAD, 0)
    firmware.write_phys32(mmio, base, engine + TAIL, 0)
    firmware.write_phys32(mmio, base, engine + START, slot * PAGE)
    firmware.write_phys32(mmio, base, engine + CONTROL, RING_ON)
    out ring
}

skill map_slots(gpu, slot, place, pages) {
    @gtt = firmware.add(gpu.mmio, GTT)
    drum (pages) { firmware.write64(gtt, gpu.base, (slot + beat) * 8, firmware.number(firmware.add(place, beat * PAGE) + 1)) }
    firmware.write_phys32(gpu.mmio, gpu.base, FLUSH_GTT, 1)
    firmware.read32(gpu.mmio, gpu.base, FLUSH_GTT)
    out slot * PAGE
}

skill map_identity(gpu, place, pages) {
    @slot = place / PAGE
    (slot < LOWEST) { out error.BufferTooLow }
    (slot + pages > REGION) { out error.BufferTooHigh }
    map_slots(gpu, slot, place, pages)
    out place
}

skill screen_at(gpu, frame) {
    out frame - gpu.aperture
}

skill map(gpu, slot, place, pages) {
    out map_slots(gpu, DATA + slot, place, pages)
}

skill drained(gpu, engine) {
    @tail = firmware.read32(gpu.mmio, gpu.base, engine + TAIL)
    drum (WAITS) {
        @head = firmware.read32(gpu.mmio, gpu.base, engine + HEAD) % HEAD_OFFSET
        (head - head % 4 == tail) { out yes }
    }
    out no
}

skill fenced(gpu, ring, seq, limit) {
    drum (limit) {
        (firmware.read32(ring, gpu.base, RING_PAGES * PAGE + FENCE) == seq) { out yes }
    }
    out no
}

skill wait(gpu) {
    out fenced(gpu, gpu.ring, gpu.blit_seq, WAITS)
}

skill wait_render(gpu) {
    out fenced(gpu, gpu.render, gpu.render_seq, RENDER_WAITS)
}

skill push(gpu, engine, ring, words) {
    @all = words
    (group.count(all) % 2 == 1) { all = group.add(all, NOOP) }
    drained(gpu, engine)
    @base = gpu.base
    @tail = firmware.read32(gpu.mmio, base, engine + TAIL)
    (tail + group.count(all) * 4 >= RING_BYTES) {
        drum ((RING_BYTES - tail) / 4) { firmware.write_phys32(ring, base, tail + beat * 4, NOOP) }
        firmware.write_phys32(gpu.mmio, base, engine + TAIL, 0)
        drained(gpu, engine)
        tail = 0
    }
    drum (group.count(all)) { firmware.write_phys32(ring, base, tail + beat * 4, group.get(all, beat)) }
    out firmware.write_phys32(gpu.mmio, base, engine + TAIL, tail + group.count(all) * 4)
}

skill next_seq(gpu, at) {
    @seq = (firmware.read32(gpu.kept, gpu.base, at) + 1) % SEQ_LIMIT
    firmware.write_phys32(gpu.kept, gpu.base, at, seq)
    out seq
}

skill submit(gpu, words) {
    @mark = (REGION + RING_PAGES) * PAGE
    gpu.blit_seq = next_seq(gpu, BLIT_SEQ_KEPT)
    @fence = [FLUSH_FENCE, mark + FENCE + USE_GTT, 0, gpu.blit_seq, 0]
    out push(gpu, BLITTER, gpu.ring, group.concat(group.concat([FLUSH_TLB, mark + USE_GTT, 0, 0], words), fence))
}

skill tails(gpu) {
    out [firmware.read32(gpu.mmio, gpu.base, RENDER + TAIL), firmware.read32(gpu.mmio, gpu.base, BLITTER + TAIL)]
}

skill frames(gpu) {
    out firmware.read32(gpu.mmio, gpu.base, FRAME_COUNT)
}

skill wait_vblank(gpu) {
    @start = firmware.read32(gpu.mmio, gpu.base, FRAME_COUNT)
    drum (VBLANK_WAITS) {
        ((firmware.read32(gpu.mmio, gpu.base, FRAME_COUNT) == start) == no) { out yes }
    }
    out no
}

skill reset_render(gpu) {
    @mmio = gpu.mmio
    @base = gpu.base
    firmware.write_phys32(mmio, base, RENDER + RESET_CONTROL, REQUEST_RESET)
    drum (1000) {
        (firmware.read32(mmio, base, RENDER + RESET_CONTROL) / READY_TO_RESET % 2 == 1) { leave }
        uefi.poll_key(base, 10)
    }
    firmware.write_phys32(mmio, base, GDRST, RESET_RENDER)
    @cleared = no
    drum (1000) {
        (cleared == no) {
            cleared = firmware.read32(mmio, base, GDRST) / RESET_RENDER % 2 == 0
            uefi.poll_key(base, 10)
        }
    }
    (cleared == no) { out no }
    wake(mmio, base, WAKE_RENDER, ACK_RENDER)
    firmware.write_phys32(mmio, base, RENDER + GFX_MODE, NO_EXECLISTS)
    firmware.write_phys32(mmio, base, RENDER + CONTROL, 0)
    firmware.write_phys32(mmio, base, RENDER + HEAD, 0)
    firmware.write_phys32(mmio, base, RENDER + TAIL, 0)
    firmware.write_phys32(mmio, base, RENDER + START, (REGION + RENDER_SLOTS) * PAGE)
    firmware.write_phys32(mmio, base, RENDER + CONTROL, RING_ON)
    out yes
}

skill submit_render(gpu, words) {
    @mark = (REGION + RENDER_SLOTS + RING_PAGES) * PAGE
    gpu.render_seq = next_seq(gpu, RENDER_SEQ_KEPT)
    @fence = [RENDER_FENCE, RENDER_FENCE_FLAGS, mark + FENCE, 0, gpu.render_seq, 0]
    out push(gpu, RENDER, gpu.render, group.concat(words, fence))
}

skill fill(gpu, at, pitch, x, y, width, height, color) {
    out submit(gpu, [COLOR_BLT, DEPTH_32 + ROP_FILL + pitch, y * 65536 + x, (y + height) * 65536 + x + width, at, 0, color])
}

skill copy(gpu, from, to, pitch, x, y, width, height) {
    out submit(gpu, [COPY_BLT, DEPTH_32 + ROP_COPY + pitch, y * 65536 + x, (y + height) * 65536 + x + width, to, 0, y * 65536 + x, pitch, from, 0])
}
