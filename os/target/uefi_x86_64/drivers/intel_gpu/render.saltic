-- intel_gpu/render — 3D-движок Intel Gen9: порция команд «прямоугольник с
-- текстурой» (шаблон generated/rect, собран по igt rendercopy_gen9 и Mesa
-- genxml): конвейер 3D рисует прямоугольник цели, каждую точку красит
-- пиксельный шейдер выборкой из текстуры. Порция лежит в своём буфере
-- (размечен «один в один»), кольцо рендера переходит в неё
-- (MI_BATCH_BUFFER_START) между сбросом кэшей и сбросом цели (PIPE_CONTROL).
--
-- Surface { at, pitch, width, height } — поверхность: адрес GGTT, шаг строки
--     в байтах, размеры в пикселях (32 бита на пиксель, BGRA)
-- Painter { gpu, batch } — видеокарта и буфер порции (BATCH_PAGES страниц)
-- painter(gpu, base) -> Painter — буфер порции; MemoryExhausted
-- draw(painter, target, texture, x, y, width, height) -> yes, если движок
--     дочитал кольцо: прямоугольник цели с x, y, растянутая на него текстура
-- Внутри: put(…) — слово в буфер порции; ONE — 1.0 в битах float

use core.num
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.uefi
use os.target.uefi_x86_64.drivers.intel_gpu
use os.target.uefi_x86_64.drivers.intel_gpu.generated.rect

BATCH_PAGES = 2
ONE = 1065353216
HALF_WORD = 65536
KIND_BATCH = 1
KIND_TARGET = 2
KIND_TEXTURE = 3

Surface = Box {
    at = 0,
    pitch = 0,
    width = 0,
    height = 0
}

Painter = Box {
    gpu = intel_gpu.Gpu {},
    batch = 0
}

skill painter(gpu, base) {
    @batch = uefi.pages_in_window(base, BATCH_PAGES)
    intel_gpu.map_identity(gpu, batch, BATCH_PAGES)
    out Painter { gpu = gpu, batch = batch }
}

skill put(painter, index, value) {
    out firmware.write_phys32(painter.batch, painter.gpu.base, index * 4, value)
}

skill surface(painter, at, area) {
    put(painter, at / 4 + rect.SIZE_WORD, group.get(rect.BATCH, at / 4 + rect.SIZE_WORD) + (area.height - 1) * HALF_WORD + area.width - 1)
    out put(painter, at / 4 + rect.PITCH_WORD, group.get(rect.BATCH, at / 4 + rect.PITCH_WORD) + area.pitch - 1)
}

skill draw(painter, target, texture, x, y, width, height) {
    @words = group.count(rect.BATCH)
    drum (words) { put(painter, beat, group.get(rect.BATCH, beat)) }
    drum (rect.RELOCS) {
        @index = group.get(beat, 0)
        @kind = group.get(beat, 1)
        @add = painter.batch
        (kind == KIND_TARGET) { add = target.at }
        (kind == KIND_TEXTURE) { add = texture.at }
        put(painter, index, group.get(rect.BATCH, index) + add)
    }
    surface(painter, rect.DESTINATION, target)
    surface(painter, rect.SOURCE, texture)
    put(painter, rect.DRAWING_WORD, (target.height - 1) * HALF_WORD + target.width - 1)
    @corners = [(x + width) + (y + height) * HALF_WORD, ONE, ONE, x + (y + height) * HALF_WORD, 0, ONE, x + y * HALF_WORD, 0, 0]
    drum (9) { put(painter, rect.VERTICES / 4 + beat, group.get(corners, beat)) }
    @gpu = painter.gpu
    intel_gpu.submit_render(gpu, group.concat(group.concat(rect.BEFORE, [rect.START, painter.batch, 0]), rect.AFTER))
    out intel_gpu.wait_render(gpu)
}
