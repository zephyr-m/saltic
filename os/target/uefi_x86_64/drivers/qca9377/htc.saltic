-- htc — почта между нами и прошивкой: каналы (endpoints) со службами.
-- Письмо HTC: заголовок 8 байт (канал, флаги, длина, номер), в канале 0 первые
-- 2 байта тела — номер сообщения. Канал WMI: команды — CE3, события — CE2.
-- Письма канала 0 приходят в CE1, в 4 буфера с начала писем (boot.launch).
--
-- connect(chip) -> текст — CONNECT_SERVICE для HTT (данные, без кредитов) и
--     WMI, затем SETUP_COMPLETE_EX — порядок как в ath10k_core_start
-- open_service(chip, service, flags) -> [статус, канал, размер письма]
-- events(chip) -> текст — список событий WMI в 8 буферах CE2
-- event_at(chip, index) -> адрес события; event_bytes(chip, index) -> байт

use core.num
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.drivers.qca9377.card
use os.target.uefi_x86_64.drivers.qca9377.rings
use os.target.uefi_x86_64.drivers.qca9377.boot

SERVICE_WMI = 256
SERVICE_HTT = 768
NO_CREDIT_FLOW = 8
WMI_CREDITS = 2
MSG_CONNECT = 2
MSG_SETUP_COMPLETE_EX = 5

skill control(chip, payload_length) {
    @frame = rings.at(chip, "wifi_frame")
    firmware.write_phys32(frame, chip.base, 0, payload_length * firmware.PAGE)
    firmware.write_phys32(frame, chip.base, 4, 0)
    out rings.send(chip, frame, 8 + payload_length, 0)
}

skill next_letter(chip) {
    @index = chip.receive_at - chip.letters_from
    drum (300) {
        (rings.arrived(chip, chip.receive_at) > 0) {
            (index >= boot.LETTER_SLOTS) { out error.OutOfLetterBuffers }
            chip.receive_at = chip.receive_at + 1
            out boot.letter(chip, index)
        }
        card.stall(chip, 10000)
    }
    out error.NoLetter
}

skill open_service(chip, service, flags) {
    @frame = rings.at(chip, "wifi_frame")
    firmware.write_phys32(frame, chip.base, 8, service * firmware.PAGE + MSG_CONNECT)
    firmware.write_phys32(frame, chip.base, 12, flags)
    control(chip, 8)
    @answer = next_letter(chip)
    @message = firmware.read16(answer, chip.base, 8)
    @status = firmware.read8(answer, chip.base, 12)
    @endpoint = firmware.read8(answer, chip.base, 13)
    @largest = firmware.read16(answer, chip.base, 14)
    card.say(chip, "   answer: message {message} (3 = CONNECT_RESP), status {status} (0 = ok), channel {endpoint}, letters up to {largest} bytes")
    out [status, endpoint, largest]
}

skill connect(chip) {
    chip.receive_at = chip.letters_from + 1
    card.say(chip, "P0. CONNECT_SERVICE: open the HTT data channel (service 0x0300), no credit flow")
    @data = open_service(chip, SERVICE_HTT, NO_CREDIT_FLOW)
    card.say(chip, "P. CONNECT_SERVICE: open a channel for WMI (service 0x0100), give it 2 credits")
    @opened = open_service(chip, SERVICE_WMI, WMI_CREDITS * 256)
    @status = group.get(opened, 0)
    @endpoint = group.get(opened, 1)
    @largest = group.get(opened, 2)
    chip.wmi_endpoint = endpoint
    @data_endpoint = group.get(data, 1)
    card.say(chip, "Q. SETUP_COMPLETE_EX: channels are open, go")
    @frame = rings.at(chip, "wifi_frame")
    firmware.write_phys32(frame, chip.base, 8, MSG_SETUP_COMPLETE_EX)
    firmware.write_phys32(frame, chip.base, 12, 0)
    firmware.write_phys32(frame, chip.base, 16, 0)
    control(chip, 11)
    out "канал HTT: номер {data_endpoint}; канал WMI: статус {status}, номер {endpoint}, письма до {largest} байт"
}

skill event_at(chip, index) {
    out rings.event_buffer(chip, index)
}

skill event_bytes(chip, index) {
    out rings.event_slot(chip, index)
}

skill events(chip) {
    card.say(chip, "R. collecting WMI events from the 8 CE2 buffers for 1 s ...")
    card.stall(chip, 1000000)
    @list = ""
    drum (rings.EVENT_SLOTS) {
        @got = event_bytes(chip, beat)
        (got > 0) {
            @event = event_at(chip, beat)
            @channel = firmware.read8(event, chip.base, 0)
            @id = firmware.hex(firmware.read16(event, chip.base, 8), 4)
            card.say(chip, "   event {beat}: {got} bytes, channel {channel}, WMI id {id}")
            list = "{list}\n  событие {beat}: {got} байт, канал {channel}, WMI id {id}"
        }
    }
    out "события WMI:{list}"
}
