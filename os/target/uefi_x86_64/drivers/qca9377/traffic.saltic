-- traffic — кадры данных через точку доступа: Ethernet ↔ 802.11 (как
-- ath10k_htt_tx_32 в режиме Native Wi-Fi и ath10k_htt_rx_h_undecap_nwifi).
-- Наружу: заголовок 802.11 24 байта (данные, ToDS: точка, мы, получатель),
-- затем LLC/SNAP AA AA 03 00 00 00 и тип Ethernet, затем тело. Письмо HTT
-- TX_FRM: вид Native Wi-Fi, TID 16 (без QoS), адрес — на список кусков
-- (адрес, длина; пустой кусок в конце) в хвосте участка wifi_htt_command.
-- Внутрь: карта кладёт кадр в том же виде (FromDS: нам, точка, отправитель),
-- из него собираем Ethernet: получатель, отправитель, тип из LLC, тело.
--
-- send(chip, network, ethernet) — кадр Ethernet (группа байтов) в эфир
-- receive(chip) -> кадр Ethernet или none — первый готовый кадр данных из
--     приёма HTT; кадры управления по пути отпускаются
-- probe(chip, network) -> текст — DHCPDISCOVER и ответы за WAITS: сколько
--     кадров данных пришло, что предложил сервер

use core.num
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.network.net
use os.target.uefi_x86_64.network.dhcp
use os.target.uefi_x86_64.drivers.qca9377.card
use os.target.uefi_x86_64.drivers.qca9377.rings
use os.target.uefi_x86_64.drivers.qca9377.htt
use os.target.uefi_x86_64.drivers.qca9377.join

DATA_TO_POINT = [8, 1, 0, 0]
SNAP = [170, 170, 3, 0, 0, 0]
NATIVE_WIFI_FLAGS = 33
TID_PLAIN = 16
PIECES = 192
HEADER = 24
BODY = 32
DATA_MASK = 12
DATA = 8
XID = [83, 65, 76, 84]
WAITS = 400
PAUSE = 10000

skill send(chip, network, ethernet) {
    @at = join.bytes(chip, 0, DATA_TO_POINT)
    at = join.bytes(chip, at, network.address)
    at = join.bytes(chip, at, net.slice_bytes(ethernet, 6, 6))
    at = join.bytes(chip, at, net.slice_bytes(ethernet, 0, 6))
    at = join.bytes(chip, at, [0, 0])
    at = join.bytes(chip, at, SNAP)
    at = join.bytes(chip, at, net.slice_bytes(ethernet, 12, group.count(ethernet) - 12))
    @place = join.frame(chip)
    @letter = htt.letter(chip)
    @pieces = firmware.add(letter, PIECES)
    firmware.write_phys32(pieces, chip.base, 0, place)
    firmware.write_phys32(pieces, chip.base, 4, at)
    firmware.write_phys32(pieces, chip.base, 8, 0)
    firmware.write_phys32(pieces, chip.base, 12, 0)
    @fetch = at
    (fetch > join.PREFETCH) { fetch = join.PREFETCH }
    fetch = fetch + num.mod(4 - num.mod(fetch, 4), 4)
    firmware.write_phys32(letter, chip.base, 8, join.TX_FRM + NATIVE_WIFI_FLAGS * 256 + (TID_PLAIN * 64 + join.POSTPONED) * firmware.PAGE)
    firmware.write_phys32(letter, chip.base, 12, at + firmware.PAGE)
    firmware.write_phys32(letter, chip.base, 16, pieces)
    firmware.write_phys32(letter, chip.base, 20, join.NO_PEER)
    drum (fetch / 4) { firmware.write_phys32(letter, chip.base, 24 + beat * 4, firmware.read32(place, chip.base, beat * 4)) }
    out htt.send(chip, 16 + fetch)
}

skill read_bytes(chip, place, first, count) {
    @bytes = []
    drum (count) { bytes = group.add(bytes, firmware.read8(place, chip.base, first + beat)) }
    out bytes
}

skill ethernet(chip, place, length) {
    @bytes = group.concat(read_bytes(chip, place, 4, 6), read_bytes(chip, place, 16, 6))
    bytes = group.concat(bytes, read_bytes(chip, place, HEADER + 6, 2))
    out group.concat(bytes, read_bytes(chip, place, BODY, length - BODY))
}

skill receive(chip) {
    drum (16) {
        @got = htt.next_frame(chip)
        (got == none) { out none }
        @place = group.get(got, 0)
        @length = group.get(got, 1)
        @found = none
        (num.mod(firmware.read8(place, chip.base, 0), 16) == DATA) {
            (length > BODY) { found = ethernet(chip, place, length) }
        }
        htt.recycle(chip)
        ((found == none) == no) { out found }
    }
    out none
}

skill probe(chip, network) {
    card.say("K1. DHCPDISCOVER: broadcast UDP 68 -> 67 through the access point")
    chip.htt_seen = ""
    send(chip, network, dhcp.frame(chip.mac, XID))
    @frames = 0
    @kinds = ""
    drum (WAITS) {
        rings.drain_letters(chip)
        drum (16) {
            @bytes = receive(chip)
            (bytes == none) { leave }
            frames = frames + 1
            @type = firmware.hex(net.word(bytes, 12), 4)
            (frames <= 4) { kinds = "{kinds} {type}" }
            (net.is_udp_to(bytes, dhcp.CLIENT_PORT) == yes) {
                @packet = net.udp(bytes)
                @offer = dhcp.offer(packet.payload)
                ((offer == none) == no) {
                    @address = net.ip_text(offer.address)
                    @server = net.ip_text(offer.server)
                    @seen = chip.htt_seen
                    card.say("   DHCP reply kind {offer.kind}: address {address} from {server}")
                    out "данные: кадров {frames} (типы{kinds}); DHCP вид {offer.kind}: адрес {address} от {server} (письма HTT:{seen})"
                }
            }
        }
        drum (16) {
            (rings.held(chip) == 0) { leave }
            rings.release(chip)
        }
        card.stall(chip, PAUSE)
    }
    @seen = chip.htt_seen
    card.say("   no DHCP reply; data frames {frames}")
    out "данные: кадров {frames} (типы{kinds}), ответа DHCP нет (письма HTT:{seen})"
}
