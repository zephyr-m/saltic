-- rings — копирующие движки (CE): кольца дескрипторов в нашей памяти.
-- Дескриптор — 8 байт: адрес 32, длина 16, флаги 16. Отправка — сдвинуть
-- индекс записи; приём — карта сама вписывает длину в дескриптор. Наши кольца
-- по 16 мест (CE7 — 2). Где что лежит в арене — участки wifi_* в arena_map,
-- at(chip, name) отдаёт место участка.
--
-- descriptor(ring, base, index, buffer, length, flags) — записать дескриптор
-- prepare(chip) — CE0 (отправка), CE1 (приём), CE7 (память карты); -> индекс CE0
-- event_rings(chip) — CE2 (события WMI) с 8 буферами, CE3 (команды WMI) и
--     CE5 (сообщения HTT от карты) с 8 буферами по 512 байт — как rx_post в
--     ath10k: без буферов во входящем кольце прошивка может встать
-- send(chip, buffer, length, flags) -> buffer; CE0, ждёт, пока карта заберёт; SendTimeout
-- command(chip, buffer, length, endpoint) -> buffer; CE3 (команды WMI), ждёт,
--     пока карта заберёт; SendTimeout. Номер канала HTC — в метаданных
--     дескриптора (флаги со 2-го бита, как transfer_id в ath10k): без него
--     прошивка принимает письмо за канал 0 и молча выбрасывает
-- expect(chip, buffer) — подложить буфер в CE1 под ответ
-- arrived(chip, slot) -> байт в слоте CE1, 0 — пока пусто
-- at(chip, name) -> адрес участка арены wifi_* по имени; UnknownRegion
-- event_slot(chip, index) -> байт в слоте CE2, 0 — пока пусто
-- event_buffer(chip, index) -> адрес буфера события index в участке wifi_events

use core.num
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.drivers.qca9377.card

CE0 = 214016
CE1 = 215040
CE2 = 216064
CE3 = 217088
CE5 = 219136
CE7 = 221184
HTT_SLOTS = 8
HTT_BYTES = 512
ENTRIES = 16
META = 4
DIAG_ENTRIES = 2
SEND_LARGEST = 256
DIAG_LARGEST = 2048
EVENT_SLOTS = 8
BUFFER_BYTES = 2048

skill descriptor(ring, base, index, buffer, length, flags) {
    @slot = firmware.add(ring, index * 8)
    firmware.write_phys32(slot, base, 0, buffer)
    firmware.write16(slot, base, 4, length)
    out firmware.write16(slot, base, 6, flags)
}

skill at(chip, name) {
    out firmware.region(chip.base, name)
}

skill ring_out(chip, engine, ring, entries, largest) {
    firmware.write_phys32(chip.bar, chip.base, engine, ring)
    card.put(chip, engine + 4, entries)
    @control = firmware.read32(chip.bar, chip.base, engine + 16)
    firmware.write_phys32(chip.bar, chip.base, engine + 16, card.without_bit(control / firmware.PAGE, 1) * firmware.PAGE + largest)
    card.put(chip, engine + 76, entries)
    out firmware.read16(chip.bar, chip.base, engine + 60)
}

skill ring_in(chip, engine, ring, entries) {
    firmware.write_phys32(chip.bar, chip.base, engine + 8, ring)
    card.put(chip, engine + 12, entries)
    @control = firmware.read32(chip.bar, chip.base, engine + 16)
    firmware.write_phys32(chip.bar, chip.base, engine + 16, card.without_bit(control / firmware.PAGE, 2) * firmware.PAGE + num.mod(control, firmware.PAGE))
    card.put(chip, engine + 80, entries)
    out firmware.read16(chip.bar, chip.base, engine + 64)
}

skill prepare(chip) {
    @sending = ring_out(chip, CE0, at(chip, "wifi_source_ring"), ENTRIES, SEND_LARGEST)
    chip.receive_at = ring_in(chip, CE1, at(chip, "wifi_destination_ring"), ENTRIES)
    ring_out(chip, CE7, at(chip, "wifi_diag_source"), DIAG_ENTRIES, DIAG_LARGEST)
    ring_in(chip, CE7, at(chip, "wifi_diag_destination"), DIAG_ENTRIES)
    chip.send_at = sending
    chip.diag_send = 0
    chip.diag_receive = 0
    out sending
}

skill event_rings(chip) {
    ring_in(chip, CE2, at(chip, "wifi_event_ring"), ENTRIES)
    chip.command_at = ring_out(chip, CE3, at(chip, "wifi_command_ring"), ENTRIES, DIAG_LARGEST)
    drum (EVENT_SLOTS) {
        @buffer = event_buffer(chip, beat)
        firmware.write_phys32(buffer, chip.base, 0, 0)
        descriptor(at(chip, "wifi_event_ring"), chip.base, beat, buffer, 0, 0)
    }
    card.put(chip, CE2 + 64, EVENT_SLOTS)
    ring_in(chip, CE5, at(chip, "wifi_htt_ring"), ENTRIES)
    drum (HTT_SLOTS) { descriptor(at(chip, "wifi_htt_ring"), chip.base, beat, firmware.add(at(chip, "wifi_htt"), beat * HTT_BYTES), 0, 0) }
    out card.put(chip, CE5 + 64, HTT_SLOTS)
}

skill send(chip, buffer, length, flags) {
    descriptor(at(chip, "wifi_source_ring"), chip.base, num.mod(chip.send_at, ENTRIES), buffer, length, flags)
    chip.send_at = chip.send_at + 1
    @target = num.mod(chip.send_at, ENTRIES)
    card.put(chip, CE0 + 60, target)
    drum (20000) {
        (firmware.read16(chip.bar, chip.base, CE0 + 68) == target) { out buffer }
        card.stall(chip, 50)
    }
    out error.SendTimeout
}

skill command(chip, buffer, length, endpoint) {
    descriptor(at(chip, "wifi_command_ring"), chip.base, num.mod(chip.command_at, ENTRIES), buffer, length, endpoint * META)
    chip.command_at = chip.command_at + 1
    @target = num.mod(chip.command_at, ENTRIES)
    card.put(chip, CE3 + 60, target)
    drum (20000) {
        (firmware.read16(chip.bar, chip.base, CE3 + 68) == target) { out buffer }
        card.stall(chip, 50)
    }
    out error.SendTimeout
}

skill expect(chip, buffer) {
    descriptor(at(chip, "wifi_destination_ring"), chip.base, num.mod(chip.receive_at, ENTRIES), buffer, 0, 0)
    chip.receive_at = chip.receive_at + 1
    out card.put(chip, CE1 + 64, num.mod(chip.receive_at, ENTRIES))
}

skill arrived(chip, slot) {
    out firmware.read16(at(chip, "wifi_destination_ring"), chip.base, num.mod(slot, ENTRIES) * 8 + 4)
}

skill event_slot(chip, index) {
    out firmware.read16(at(chip, "wifi_event_ring"), chip.base, index * 8 + 4)
}

skill event_buffer(chip, index) {
    out firmware.add(at(chip, "wifi_events"), index * BUFFER_BYTES)
}
