-- join — подключение к открытой точке доступа, порядок как у mac80211 + ath10k
-- для станции: канал точки (VDEV_START, ждём VDEV_START_RESP), запись о точке
-- в прошивке (PEER_CREATE, прошивка отвечает письмом HTT PEER_MAP), затем
-- кадры 802.11 Authentication (открытая система, шаг 1) и Association Request.
-- Ответы точки приходят в приём HTT, как маяки при поиске.
-- Кадры управления у этой прошивки идут не через WMI (службы MGMT_TX_WMI,
-- бит 76, нет), а письмом HTT TX_FRM (ath10k_htt_tx_32, HTT 3.x): заголовок
-- HTC, тип 1, флаги (вид MGMT, заголовок 802.11 есть), длина, номер, адрес
-- кадра в нашей памяти (участок wifi_tx_frame), нет-пира 0xFFFF и частота 0,
-- следом первые байты кадра (до PREFETCH, кратно 4) — по ним прошивка
-- разбирает кадр.
--
-- tune(chip, network) -> текст — VDEV_START на частоте сети, статус ответа
-- peer(chip, network) -> текст — PEER_CREATE для BSSID, пришёл ли PEER_MAP
-- header(chip, kind, network, sequence) -> 24 — заголовок кадра 802.11 в
--     wifi_tx_frame: тип, адреса (точка, мы, точка), номер
-- send_frame(chip, length) — кадр из wifi_tx_frame письмом TX_FRM
-- answer(chip, kind, network) -> [слово 24, слово 26, слово 28] или none —
--     ответ точки вида kind в приёме HTT (не дольше WAITS); буфер сразу
--     уходит обратно
-- leave_point(chip, network) — Deauthentication (причина 3, «ухожу»): точка
--     забывает нас с прошлого запуска, иначе через раз молчит на ассоциацию
-- authenticate(chip, network) -> текст — Authentication, статус ответа
-- associate(chip, network) -> текст — Association Request (имя, скорости
--     11b/g), до TRIES попыток; номер станции (AID) и возможности точки — в
--     chip.station и chip.point_caps
-- link(chip, network) -> текст — как ath10k_bss_assoc и переход в
--     AUTHORIZED: PEER_ASSOC (11g, скорости 11b/g), VDEV_UP с номером станции,
--     PEER_SET_PARAM authorize — без него прошивка не пропускает данные
-- run(chip, name) -> Network или none — поиск, сеть по имени, всё по
--     порядку; ход — в chip.journal

use core.num
use core.str
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.drivers.qca9377.card
use os.target.uefi_x86_64.drivers.qca9377.rings
use os.target.uefi_x86_64.drivers.qca9377.wmi
use os.target.uefi_x86_64.drivers.qca9377.htt
use os.target.uefi_x86_64.drivers.qca9377.scan

VDEV_START = 20483
TAG_VDEV_START = 88
VDEV_START_RESP = 20481
PEER_CREATE = 24577
TAG_PEER_CREATE = 97
PEER_ASSOC = 24581
TAG_PEER_ASSOC = 101
VDEV_UP = 20485
TAG_VDEV_UP = 92
PEER_SET_PARAM = 24580
TAG_PEER_SET_PARAM = 100
TAG_VHT_RATES = 102
PEER_AUTH = 1
AUTHORIZE = 3
LEGACY_RATES = [130, 132, 139, 150, 12, 18, 24, 36, 48, 72, 96, 108]
TRIES = 3
BEACON_INTERVAL = 100
TX_FRM = 1
MGMT_FLAGS = 97
TID_MGMT = 17
POSTPONED = 2048
NO_PEER = 65535
PREFETCH = 50
AUTH = 176
DEAUTH = 192
LEAVING = 3
ASSOC_REQUEST = 0
ASSOC_RESPONSE = 16
CAPABILITY = [33, 4]
LISTEN = 10
RATES = [1, 8, 130, 132, 139, 150, 12, 18, 24, 36]
EXTENDED_RATES = [50, 4, 48, 72, 96, 108]
WAITS = 300
PAUSE = 10000

skill frame(chip) {
    out rings.at(chip, "wifi_tx_frame")
}

skill bytes(chip, at, values) {
    drum (group.count(values)) { firmware.write8(frame(chip), chip.base, at + beat, group.get(values, beat)) }
    out at + group.count(values)
}

skill tune(chip, network) {
    @freq = scan.mhz(network.channel - 1)
    card.say("J1. VDEV_START: interface 0 on channel {network.channel} ({freq} MHz)")
    @at = wmi.tlv(chip, wmi.BODY, TAG_VDEV_START, 72)
    at = wmi.words(chip, at, [0, 0, BEACON_INTERVAL, 1, 0])
    drum (9) { at = wmi.words(chip, at, [0]) }
    at = wmi.words(chip, at, [0, 0, 0, 0])
    at = wmi.tlv(chip, at, scan.TAG_CHANNEL, 24)
    at = wmi.words(chip, at, [freq, freq, 0, scan.MODE_11G, scan.POWER * 256 + scan.POWER * 65536, scan.POWER * 256])
    at = wmi.tlv(chip, at, scan.TAG_ARRAY_STRUCT, 0)
    wmi.command(chip, VDEV_START, at - wmi.BODY)
    @event = wmi.wait_for(chip, VDEV_START_RESP) rescue |err| {
        @seen = wmi.inbox(chip)
        out "канал {network.channel}: нет VDEV_START_RESP ({seen})"
    }
    @status = firmware.read32(event, chip.base, 28)
    rings.release(chip)
    card.say("   VDEV_START_RESP status {status}")
    out "канал {network.channel}: VDEV_START_RESP статус {status}"
}

skill peer(chip, network) {
    card.say("J2. PEER_CREATE for the access point {network.bssid}")
    chip.htt_seen = ""
    @at = wmi.tlv(chip, wmi.BODY, TAG_PEER_CREATE, 16)
    at = wmi.words(chip, at, group.concat([0], wmi.mac_words(network.address)))
    at = wmi.words(chip, at, [0])
    wmi.command(chip, PEER_CREATE, at - wmi.BODY)
    wmi.barrier(chip)
    rings.drain_letters(chip)
    @mapped = str.contains(chip.htt_seen, " 1:3")
    card.say("   PEER_MAP came: {mapped}")
    out "пир {network.bssid}: PEER_MAP {mapped}"
}

skill header(chip, kind, network, sequence) {
    @at = bytes(chip, 0, [kind, 0, 0, 0])
    at = bytes(chip, at, network.address)
    at = bytes(chip, at, chip.mac)
    at = bytes(chip, at, network.address)
    out bytes(chip, at, [num.mod(sequence * 16, 256), sequence / 16])
}

skill send_frame(chip, length) {
    @letter = htt.letter(chip)
    @place = frame(chip)
    @fetch = length
    (fetch > PREFETCH) { fetch = PREFETCH }
    fetch = fetch + num.mod(4 - num.mod(fetch, 4), 4)
    drum (4) { firmware.write8(place, chip.base, length + beat, 0) }
    firmware.write_phys32(letter, chip.base, 8, TX_FRM + MGMT_FLAGS * 256 + (TID_MGMT * 64 + POSTPONED) * firmware.PAGE)
    firmware.write_phys32(letter, chip.base, 12, length)
    firmware.write_phys32(letter, chip.base, 16, place)
    firmware.write_phys32(letter, chip.base, 20, NO_PEER)
    drum (fetch / 4) { firmware.write_phys32(letter, chip.base, 24 + beat * 4, firmware.read32(place, chip.base, beat * 4)) }
    out htt.send(chip, 16 + fetch)
}

skill from_point(chip, got, kind, network) {
    @place = group.get(got, 0)
    ((firmware.read8(place, chip.base, 0) == kind) == no) { out no }
    drum (6) {
        ((firmware.read8(place, chip.base, 10 + beat) == group.get(network.address, beat)) == no) { out no }
    }
    out yes
}

skill answer(chip, kind, network) {
    drum (WAITS) {
        rings.drain_letters(chip)
        drum (16) {
            @got = htt.next_frame(chip)
            (got == none) { leave }
            @place = group.get(got, 0)
            @words = [firmware.read16(place, chip.base, 24), firmware.read16(place, chip.base, 26), firmware.read16(place, chip.base, 28)]
            @mine = from_point(chip, got, kind, network)
            @first = firmware.hex(firmware.read8(place, chip.base, 0), 2)
            @sender = firmware.read8(place, chip.base, 15)
            (str.bytes(chip.heard) < 120) {
                ((first == "80") == no) { chip.heard = "{chip.heard} {first}/{sender}" }
            }
            htt.recycle(chip)
            (mine == yes) { out words }
        }
        drum (16) {
            (rings.held(chip) == 0) { leave }
            @event = firmware.hex(wmi.event_id(chip, rings.held_buffer(chip)), 4)
            (str.bytes(chip.heard) < 120) { chip.heard = "{chip.heard} w{event}" }
            rings.release(chip)
        }
        card.stall(chip, PAUSE)
    }
    out none
}

skill leave_point(chip, network) {
    card.say("J3a. Deauthentication: forget us from the previous run")
    @at = header(chip, DEAUTH, network, 0)
    at = bytes(chip, at, [LEAVING, 0])
    send_frame(chip, at)
    out card.stall(chip, 200000)
}

skill authenticate(chip, network) {
    card.say("J3. Authentication: open system, step 1, through HTT TX_FRM")
    chip.htt_seen = ""
    @at = header(chip, AUTH, network, 1)
    at = bytes(chip, at, [0, 0, 1, 0, 0, 0])
    send_frame(chip, at)
    @reply = answer(chip, AUTH, network)
    (reply == none) {
        @seen = chip.htt_seen
        card.say("   no Authentication reply (HTT letters:{seen})")
        out "аутентификация: ответа нет (письма HTT:{seen})"
    }
    @sent = chip.htt_seen
    card.say("   HTT letters:{sent}")
    @step = group.get(reply, 1)
    @status = group.get(reply, 2)
    card.say("   Authentication reply: step {step}, status {status}")
    out "аутентификация: шаг {step}, статус {status} (письма HTT:{sent})"
}

skill associate(chip, network) {
    @told = ""
    drum (TRIES) {
        told = ask_association(chip, network, beat + 2)
        (chip.station > 0) { out told }
    }
    out told
}

skill ask_association(chip, network, sequence) {
    card.say("J4. Association Request: SSID «{network.name}», rates 11b/g")
    chip.htt_seen = ""
    @at = header(chip, ASSOC_REQUEST, network, sequence)
    at = bytes(chip, at, group.concat(CAPABILITY, [LISTEN, 0]))
    @size = str.bytes(network.name)
    at = bytes(chip, at, [0, size])
    drum (size) { at = bytes(chip, at, [str.byte(network.name, beat)]) }
    at = bytes(chip, at, RATES)
    at = bytes(chip, at, EXTENDED_RATES)
    send_frame(chip, at)
    chip.heard = ""
    @reply = answer(chip, ASSOC_RESPONSE, network)
    (reply == none) {
        @seen = chip.htt_seen
        @heard = chip.heard
        card.say("   no Association Response (HTT letters:{seen}; heard:{heard})")
        out "ассоциация: ответа нет (письма HTT:{seen}; слышно:{heard})"
    }
    @status = group.get(reply, 1)
    @station = num.mod(group.get(reply, 2), 16384)
    card.say("   Association Response: status {status}, AID {station}")
    (status == 0) {
        chip.station = station
        chip.point_caps = group.get(reply, 0)
    }
    out "ассоциация: статус {status}, номер станции {station}"
}

skill link(chip, network) {
    card.say("J5. PEER_ASSOC: 11g, 12 rates, AID {chip.station}")
    @at = wmi.tlv(chip, wmi.BODY, TAG_PEER_ASSOC, 76)
    at = wmi.words(chip, at, wmi.mac_words(network.address))
    at = wmi.words(chip, at, [0, 1, chip.station, PEER_AUTH, chip.point_caps, 1, 0, 0, 0, 0, 1, 0, scan.MODE_11G, 0, 0])
    at = wmi.words(chip, at, [group.count(LEGACY_RATES), 0])
    at = wmi.tlv(chip, at, scan.TAG_ARRAY_BYTE, group.count(LEGACY_RATES))
    drum (group.count(LEGACY_RATES) / 4) {
        @four = beat * 4
        at = wmi.words(chip, at, [group.get(LEGACY_RATES, four) + group.get(LEGACY_RATES, four + 1) * 256 + group.get(LEGACY_RATES, four + 2) * 65536 + group.get(LEGACY_RATES, four + 3) * 16777216])
    }
    at = wmi.tlv(chip, at, scan.TAG_ARRAY_BYTE, 0)
    at = wmi.tlv(chip, at, TAG_VHT_RATES, 16)
    at = wmi.words(chip, at, [0, 0, 0, 0])
    wmi.command(chip, PEER_ASSOC, at - wmi.BODY)
    card.say("J6. VDEV_UP: interface 0 is associated with {network.bssid}")
    at = wmi.tlv(chip, wmi.BODY, TAG_VDEV_UP, 16)
    at = wmi.words(chip, at, group.concat([0, chip.station], wmi.mac_words(network.address)))
    wmi.command(chip, VDEV_UP, at - wmi.BODY)
    card.say("J7. PEER_SET_PARAM authorize: open network, data may flow")
    at = wmi.tlv(chip, wmi.BODY, TAG_PEER_SET_PARAM, 20)
    at = wmi.words(chip, at, group.concat([0], wmi.mac_words(network.address)))
    at = wmi.words(chip, at, [AUTHORIZE, 1])
    wmi.command(chip, PEER_SET_PARAM, at - wmi.BODY)
    wmi.barrier(chip)
    out "связь: PEER_ASSOC, VDEV_UP, authorize — прошивка приняла (барьер)"
}

skill named(networks, name) {
    drum (group.count(networks)) {
        @found = group.get(networks, beat)
        (found.name == name) { out found }
    }
    out none
}

skill run(chip, name) {
    @tally = scan.search(chip)
    @network = named(tally.networks, name)
    @count = group.count(tally.networks)
    (network == none) {
        chip.journal = "сеть «{name}» не найдена (сетей: {count})"
        out none
    }
    card.say("   found «{name}» on channel {network.channel}, {network.bssid}")
    @tuned = tune(chip, network)
    @peered = peer(chip, network)
    leave_point(chip, network)
    @authenticated = authenticate(chip, network)
    @associated = associate(chip, network)
    chip.journal = "сеть «{name}» · {network.bssid} · канал {network.channel}\n{tuned}\n{peered}\n{authenticated}\n{associated}"
    (chip.station == 0) { out none }
    @linked = link(chip, network)
    chip.journal = "{chip.journal}\n{linked}"
    out network
}
