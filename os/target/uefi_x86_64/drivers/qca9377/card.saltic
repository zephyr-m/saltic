-- card — регистры QCA9377: пробуждение, прерывания, ожидание загрузчика.
-- Всё состояние — в Card: bar — окно регистров, base — guest_base, счётчики
-- колец, memory — свои страницы колец и буферов (rings.MEMORY, rings.at).
-- Адреса — как у QCA6174 в ath10k (hw.c, pci.c).
--
-- Card — состояние карты: окна, счётчики CE0/CE1/CE3/CE7, начало писем,
--     номер канала WMI (из ответа CONNECT_SERVICE), чтение и запись кольца
--     событий CE2, MAC карты (6 байт, из READY)
-- say(chip, text) -> text — печать "wifi: …" на экран; с chip.quiet = yes
--     молчит (агент поднимает Wi-Fi под своим графическим экраном)
-- stall(chip, microseconds) — пауза через Stall прошивки
-- put(chip, offset, value) — 32 бита в регистр, value — обычное число
-- hex32(chip, offset) -> текст регистра, 8 цифр
-- with_bit / without_bit(value, bit) -> число, bit — степень двойки
-- change_low(chip, offset, low) — заменить младшие 16 бит регистра
-- wake(chip) -> опросов; WakeTimeout
-- interrupts_off / interrupts_on(chip) — погасить и очистить / включить INTx
-- wait_loader(chip) -> текст индикатора; TargetNotReady
-- quiet(chip) — прерывания и bus master выключить: карта больше не тронет память

use io
use os.target.uefi_x86_64.platform.firmware

RTC_STATE = 524288
SOC_WAKE = 524292
RTC_ON = 3
INTR_ENABLE = 237576
INTR_CLEAR = 237588
INTR_FIRMWARE = 1024
INTR_CE_ALL = 522240
FW_INDICATOR = 237608
COMMAND_MEMORY = 2
BOOT_SERVICES = 96
BOOT_STALL = 248

Card = Box {
    base = 0,
    config = 0,
    bar = 0,
    memory = 0,
    quiet = no,
    lost = no,
    send_at = 0,
    receive_at = 0,
    letters_from = 0,
    diag_send = 0,
    diag_receive = 0,
    command_at = 0,
    wmi_endpoint = 1,
    event_read = 0,
    event_write = 8,
    letter_read = 0,
    letters_live = no,
    letters_seen = 0,
    htt_at = 0,
    htt_seen = "",
    htt_version = "",
    rx_read = 0,
    rx_fill = 0,
    mac = [],
    station = 0,
    point_caps = 0,
    journal = "",
    point = none,
    heard = "",
    ip = [],
    router = [],
    router_mac = [],
    frames_in = 0,
    frames_damaged = 0,
    arp_answered = 0,
    echoes = 0,
    heard_udp = "",
    services = []
}

skill say(chip, text) {
    (chip.quiet == no) { io.show("wifi: {text}") }
    out text
}

skill stall(chip, microseconds) {
    @services = firmware.pointer(firmware.system_table(), chip.base, BOOT_SERVICES)
    out firmware.call(chip.base, firmware.pointer(services, chip.base, BOOT_STALL), [firmware.number(microseconds)])
}

skill put(chip, offset, value) {
    out firmware.write_phys32(chip.bar, chip.base, offset, firmware.number(value))
}

skill hex32(chip, offset) {
    out firmware.phys_text(firmware.read32(chip.bar, chip.base, offset))
}

skill with_bit(value, bit) {
    out value - value / bit % 2 * bit + bit
}

skill without_bit(value, bit) {
    out value - value / bit % 2 * bit
}

skill change_low(chip, offset, low) {
    @value = firmware.read32(chip.bar, chip.base, offset)
    out firmware.write_phys32(chip.bar, chip.base, offset, value - value % firmware.PAGE + low)
}

skill wake(chip) {
    put(chip, SOC_WAKE, 1)
    @polls = 0
    drum (100000) {
        (firmware.read16(chip.bar, chip.base, RTC_STATE) % 8 == RTC_ON) { out polls }
        polls = polls + 1
    }
    out error.WakeTimeout
}

skill interrupts_off(chip) {
    put(chip, INTR_ENABLE, 0)
    put(chip, INTR_CLEAR, INTR_FIRMWARE + INTR_CE_ALL)
    out firmware.read16(chip.bar, chip.base, INTR_ENABLE)
}

skill interrupts_on(chip) {
    put(chip, INTR_ENABLE, INTR_FIRMWARE + INTR_CE_ALL)
    out firmware.read16(chip.bar, chip.base, INTR_ENABLE)
}

skill wait_loader(chip) {
    @indicator = firmware.read32(chip.bar, chip.base, FW_INDICATOR)
    @waited = 0
    drum (300) {
        (indicator % 4 > 0) {
            @shown = firmware.phys_text(indicator)
            out "{shown} за {waited}0 мс"
        }
        interrupts_on(chip)
        stall(chip, 10000)
        waited = waited + 1
        indicator = firmware.read32(chip.bar, chip.base, FW_INDICATOR)
    }
    out error.TargetNotReady
}

skill quiet(chip) {
    interrupts_off(chip)
    out firmware.write16(chip.config, chip.base, 4, COMMAND_MEMORY)
}
