use core.group
use os.target.uefi_x86_64.firmware

SYSTEM_CON_OUT = 64
SYSTEM_BOOT_SERVICES = 96
SYSTEM_RUNTIME = 88
RUNTIME_GET_TIME = 24
RUNTIME_RESET = 104
RESET_COLD = 0
TIME_BUFFER = 3072
TEXT_QUERY_MODE = 24
TEXT_SET_MODE = 32
TEXT_MODE = 72
BOOT_LOAD_IMAGE = 200
BOOT_START_IMAGE = 208
BOOT_FREE_POOL = 72
EXIT_SIZE_AT = 32
EXIT_DATA_AT = 40
OUTPUT_LIMIT = 1200

Clock = Box {
    year = 0,
    month = 0,
    day = 0,
    hour = 0,
    minute = 0,
    second = 0
}

Launched = Box {
    outcome = firmware.Answer {},
    output = []
}

Console = Box {
    columns = 0,
    rows = 0
}

skill con_out(base) {
    out firmware.pointer(firmware.system_table(), base, SYSTEM_CON_OUT)
}

skill boot_services(base) {
    out firmware.pointer(firmware.system_table(), base, SYSTEM_BOOT_SERVICES)
}

skill query_mode(base, output, mode) {
    @columns_at = firmware.scratch(base, 0)
    @rows_at = firmware.scratch(base, 8)
    @queried = firmware.call(base, firmware.pointer(output, base, TEXT_QUERY_MODE), [output, firmware.number(mode), columns_at, rows_at])
    (queried.failed == yes) { out Console {} }
    out Console { columns = firmware.read16(columns_at, base, 0), rows = firmware.read16(rows_at, base, 0) }
}

skill wide_console(base) {
    @output = con_out(base)
    @modes = firmware.read16(firmware.pointer(output, base, TEXT_MODE), base, 0)
    @best = 0
    @area = 0
    drum (modes) {
        @size = query_mode(base, output, beat)
        (size.columns * size.rows > area) {
            area = size.columns * size.rows
            best = beat
        }
    }
    firmware.call(base, firmware.pointer(output, base, TEXT_SET_MODE), [output, firmware.number(best)])
    out query_mode(base, output, best)
}

skill start_image(base, image, size) {
    @services = boot_services(base)
    @handle_at = firmware.scratch(base, 16)
    @loaded = firmware.call(base, firmware.pointer(services, base, BOOT_LOAD_IMAGE), [firmware.number(0), firmware.image_handle(), firmware.number(0), image, firmware.number(size), handle_at])
    (loaded.failed == yes) { out Launched { outcome = loaded } }
    @child = firmware.pointer(handle_at, base, 0)
    @size_at = firmware.scratch(base, EXIT_SIZE_AT)
    @data_at = firmware.scratch(base, EXIT_DATA_AT)
    firmware.write64(size_at, base, 0, firmware.Phys {})
    firmware.write64(data_at, base, 0, firmware.Phys {})
    @outcome = firmware.call(base, firmware.pointer(services, base, BOOT_START_IMAGE), [child, size_at, data_at])
    out Launched { outcome = outcome, output = exit_output(base, services, size_at, data_at) }
}

skill exit_output(base, services, size_at, data_at) {
    @size = firmware.read16(size_at, base, 0)
    (firmware.read16(size_at, base, 2) > 0) { size = OUTPUT_LIMIT }
    (size == 0) { out [] }
    @data = firmware.pointer(data_at, base, 0)
    @first = 0
    drum (size / 2) {
        (firmware.read16(data, base, beat * 2) == 0) {
            first = beat * 2 + 2
            leave
        }
    }
    @count = size - first
    (count > OUTPUT_LIMIT) { count = OUTPUT_LIMIT }
    @bytes = []
    drum (count) { bytes = group.add(bytes, firmware.read8(data, base, first + beat)) }
    firmware.call(base, firmware.pointer(services, base, BOOT_FREE_POOL), [data])
    out bytes
}

skill now(base) {
    @runtime = firmware.pointer(firmware.system_table(), base, SYSTEM_RUNTIME)
    @at = firmware.scratch(base, TIME_BUFFER)
    @asked = firmware.call(base, firmware.pointer(runtime, base, RUNTIME_GET_TIME), [at, firmware.number(0)])
    (asked.failed == yes) { out Clock {} }
    out Clock {
        year = firmware.read16(at, base, 0),
        month = firmware.read8(at, base, 2),
        day = firmware.read8(at, base, 3),
        hour = firmware.read8(at, base, 4),
        minute = firmware.read8(at, base, 5),
        second = firmware.read8(at, base, 6)
    }
}

skill restart(base) {
    @runtime = firmware.pointer(firmware.system_table(), base, SYSTEM_RUNTIME)
    out firmware.call(base, firmware.pointer(runtime, base, RUNTIME_RESET), [firmware.number(RESET_COLD), firmware.number(0), firmware.number(0), firmware.number(0)])
}
