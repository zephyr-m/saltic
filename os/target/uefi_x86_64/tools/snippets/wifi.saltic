-- Wi-Fi на Acer: поднять QCA9377, залить прошивку, открыть WMI, показать паспорт.
-- Запуск (посылку собирает tools/wifi_pack.py):
--   python3 tools/wifi_pack.py /tmp/wifi-pack.bin
--   SNIPPET_DATA=/tmp/wifi-pack.bin python3 tools/snippet.py -f tools/snippets/wifi.saltic

use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.drivers.qca9377

skill steps(chip) {
    @started = qca9377.start(chip)
    @loaded = qca9377.load(chip, DATA_HI * firmware.PAGE + DATA_LO)
    @talked = qca9377.talk(chip)
    @ready = qca9377.ready(chip)
    @networks = qca9377.look(chip)
    out "{started}\n{loaded}\n{talked}\n{ready}\n{networks}"
}

skill snippet() {
    @chip = qca9377.open()
    @told = steps(chip) rescue |err| { "ошибка: {err}" }
    qca9377.quiet(chip)
    out told
}
