use core.mem
use core.num
use os.target.uefi_x86_64.firmware
use os.target.uefi_x86_64.graphics
use os.target.uefi_x86_64.button

BIG = 1920
SMALL = 1366
SPOTS = 3

skill channel(value, shift) {
    out num.mod(value / shift, 256)
}

skill shrink(screen, buffer, left, top) {
    @width = buffer.width * SMALL / BIG
    @height = buffer.height * SMALL / BIG
    drum (height) {
        @row = beat
        @at = ((top + row) * screen.stride + left) * graphics.PIXEL_BYTES
        drum (width) {
            @column = beat
            @red = 0
            @green = 0
            @blue = 0
            drum (SPOTS) {
                @sy = ((row * SPOTS + beat) * 2 + 1) * BIG / (SMALL * SPOTS * 2)
                drum (SPOTS) {
                    @sx = ((column * SPOTS + beat) * 2 + 1) * BIG / (SMALL * SPOTS * 2)
                    @value = mem.load32(buffer.memory, (sy * buffer.stride + sx) * graphics.PIXEL_BYTES)
                    red = red + channel(value, 65536)
                    green = green + channel(value, 256)
                    blue = blue + channel(value, 1)
                }
            }
            @count = SPOTS * SPOTS
            mem.store32(screen.memory, at + column * graphics.PIXEL_BYTES, graphics.color(screen, red / count, green / count, blue / count))
        }
    }
    out none
}

skill snippet() {
    @base = firmware.guest_base()
    @screen = graphics.open(base)
    button.variants_card(screen, 40, 470, "Родной масштаб")
    @place = firmware.add(firmware.arena(base), 65536)
    @buffer = graphics.Screen { width = 680, height = 124, stride = 680, format = screen.format, frame = place, memory = firmware.guest(place, base) }
    graphics.fill(buffer, 0, 0, buffer.width, buffer.height, button.paint(screen, button.paper()))
    button.variants_card(buffer, 0, 0, "Full HD, уменьшено")
    shrink(screen, buffer, 740, 470)
    out "слева — родной масштаб, справа — нарисовано для Full HD и уменьшено в 1366/1920"
}
