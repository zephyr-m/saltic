-- build — UEFI-образ для флешки: программа (по умолчанию programs/hello.saltic)
-- собирается родным компилятором с полки (bootstrap.names.build) в <папка>/image/EFI/BOOT/BOOTX64.EFI. Папка —
-- SALTIC_UEFI_DIR (.cache/build/uefi_x86_64), цель — SALTIC_TARGET
-- (x86_64-uefi), куча — 64 МиБ. Содержимое image — на FAT32-флешку. Вместо
-- build.sh (в .archive/); зовёт tests/run.saltic (случай uefi).
--
-- program(source) — source: исходник программы или "" (hello)
-- Внутри: setting(name, fallback)

use io
use core.str
use core.process
use bootstrap.names

SOURCE = "os/target/uefi_x86_64/programs/hello.saltic"
WORK = ".cache/build/uefi_x86_64"
HEAP = "67108864"

skill setting(name, fallback) {
    drum (process.environment()) {
        (str.starts_with(beat, "{name}=") == yes) {
            @value = str.slice(beat, str.bytes(name) + 1, str.bytes(beat))
            (str.bytes(value) > 0) { out value }
        }
    }
    out fallback
}

program(source) {
    @chosen = source
    (str.bytes(chosen) == 0) { chosen = SOURCE }
    @work = setting("SALTIC_UEFI_DIR", WORK)
    @target = setting("SALTIC_TARGET", "x86_64-uefi")
    @image = "{work}/image"
    process.run(["mkdir", "-p", "{image}/EFI/BOOT"], "", [])
    io.show("uefi: собираю {chosen}")
    names.build(chosen, "{image}/EFI/BOOT/BOOTX64.EFI", HEAP, target)
    io.show("uefi: образ флешки — {image} (скопируй его содержимое на FAT32-флешку)")
    out none
}
