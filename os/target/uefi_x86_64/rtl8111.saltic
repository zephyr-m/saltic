use io
use core.num
use core.str
use core.group
use os.target.uefi_x86_64.firmware

VENDOR_REALTEK = 4332
MODEL_RTL8111 = 33128
PCI_COMMAND = 4
PCI_BAR2 = 24
PCI_BAR2_HIGH = 28
COMMAND_MEMORY = 2
COMMAND_BUS_MASTER = 4

REGISTER_TX_RING = 32
REGISTER_CHIP_COMMAND = 55
REGISTER_TX_POLL = 56
REGISTER_INTERRUPT_MASK = 60
REGISTER_INTERRUPT_STATUS = 62
REGISTER_TX_CONFIG = 64
REGISTER_RX_CONFIG = 68
REGISTER_CONFIG_LOCK = 80
REGISTER_PHY_STATUS = 108
REGISTER_RX_MAX_SIZE = 218
REGISTER_RX_RING = 228
REGISTER_TX_MAX_SIZE = 236

CHIP_RESET = 16
CHIP_RX_TX = 12
CONFIG_UNLOCK = 192
TX_POLL_NORMAL = 64
RX_CONFIG_LOW = 59151
TX_CONFIG_LOW = 1792
TX_CONFIG_HIGH = 768
RX_MAX_SIZE = 1536
TX_MAX_SIZE = 59

PHY_FULL_DUPLEX = 1
PHY_LINK = 2
PHY_10 = 4
PHY_100 = 8
PHY_1000 = 16

DESCRIPTOR_OWN = 32768
DESCRIPTOR_END = 16384
DESCRIPTOR_FIRST_LAST = 12288
DESCRIPTOR_BYTES = 16
RX_COUNT = 4
BUFFER_BYTES = 2048
TX_RING = 0
RX_RING = 256
TX_BUFFER = 4096
RX_BUFFERS = 8192

PORT = 5555
FRAME_MINIMUM = 60
TYPE_IPV4 = 2048
PROTOCOL_UDP = 17
LISTEN_ROUNDS = 200000000
BROADCAST_MAC = [255, 255, 255, 255, 255, 255]
BROADCAST_IP = [65535, 65535]
OWN_IP = [2560, 2]
ASCII = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[?]^_`abcdefghijklmnopqrstuvwxyz?|?~"

Card = Box {
    base = firmware.Phys {},
    mmio = firmware.Phys {},
    arena = firmware.Phys {},
    mac = []
}

skill has_bit(value, bit) {
    out num.mod(value / bit, 2) == 1
}

skill with_bit(value, bit) {
    (has_bit(value, bit) == yes) { out value }
    out value + bit
}

skill enable(base, config) {
    @before = firmware.read16(config, base, PCI_COMMAND)
    @after = with_bit(with_bit(before, COMMAND_MEMORY), COMMAND_BUS_MASTER)
    firmware.write16(config, base, PCI_COMMAND, after)
    out none
}

skill registers(base, config) {
    @low = firmware.read32(config, base, PCI_BAR2)
    (has_bit(low.lo, 1) == yes) { out error.Bar2IsNotMemory }
    @high = firmware.read32(config, base, PCI_BAR2_HIGH)
    (high.hi > 0) { out error.RegistersAbove4G }
    (high.lo > 0) { out error.RegistersAbove4G }
    out firmware.Phys { hi = low.hi, lo = low.lo - num.mod(low.lo, 16) }
}

skill read_mac(base, mmio) {
    @bytes = []
    drum (6) { bytes = group.add(bytes, firmware.read8(mmio, base, beat)) }
    out bytes
}

skill mac_text(bytes) {
    @text = firmware.hex(group.get(bytes, 0), 2)
    drum (5) {
        @part = firmware.hex(group.get(bytes, beat + 1), 2)
        text = "{text}:{part}"
    }
    out text
}

skill link_text(status) {
    (has_bit(status, PHY_LINK) == no) { out "down" }
    @speed = "?"
    (has_bit(status, PHY_10) == yes) { speed = "10" }
    (has_bit(status, PHY_100) == yes) { speed = "100" }
    (has_bit(status, PHY_1000) == yes) { speed = "1000" }
    @duplex = "half"
    (has_bit(status, PHY_FULL_DUPLEX) == yes) { duplex = "full" }
    out "up, {speed} Mbit/s, {duplex} duplex"
}

skill delay(card, count) {
    drum (count) { firmware.read8(card.mmio, card.base, REGISTER_PHY_STATUS) }
    out none
}

skill open() {
    @base = firmware.guest_base()
    @config = firmware.find_device(base, firmware.ecam(base), VENDOR_REALTEK, MODEL_RTL8111)
    enable(base, config)
    @mmio = registers(base, config)
    out Card { base = base, mmio = mmio, arena = firmware.arena(base), mac = read_mac(base, mmio) }
}

skill reset(card) {
    firmware.write8(card.mmio, card.base, REGISTER_CHIP_COMMAND, CHIP_RESET)
    drum (100000) {
        (has_bit(firmware.read8(card.mmio, card.base, REGISTER_CHIP_COMMAND), CHIP_RESET) == no) { out none }
    }
    out error.ResetTimeout
}

skill descriptor(card, offset, flags, length, buffer) {
    firmware.write16(card.arena, card.base, offset, length)
    firmware.write16(card.arena, card.base, offset + 4, 0)
    firmware.write16(card.arena, card.base, offset + 6, 0)
    firmware.write_phys32(card.arena, card.base, offset + 8, firmware.add(card.arena, buffer))
    firmware.write16(card.arena, card.base, offset + 12, 0)
    firmware.write16(card.arena, card.base, offset + 14, 0)
    firmware.write16(card.arena, card.base, offset + 2, flags)
    out none
}

skill rx_flags(index) {
    (index == RX_COUNT - 1) { out DESCRIPTOR_OWN + DESCRIPTOR_END }
    out DESCRIPTOR_OWN
}

skill arm_rx(card, index) {
    out descriptor(card, RX_RING + index * DESCRIPTOR_BYTES, rx_flags(index), BUFFER_BYTES, RX_BUFFERS + index * BUFFER_BYTES)
}

skill write_ring(card, register, offset) {
    firmware.write_phys32(card.mmio, card.base, register, firmware.add(card.arena, offset))
    firmware.write16(card.mmio, card.base, register + 4, 0)
    firmware.write16(card.mmio, card.base, register + 6, 0)
    out none
}

skill configure(card) {
    reset(card)
    firmware.write8(card.mmio, card.base, REGISTER_CONFIG_LOCK, CONFIG_UNLOCK)
    firmware.write16(card.mmio, card.base, REGISTER_INTERRUPT_MASK, 0)
    firmware.write16(card.mmio, card.base, REGISTER_INTERRUPT_STATUS, 65535)
    drum (RX_COUNT) { arm_rx(card, beat) }
    write_ring(card, REGISTER_TX_RING, TX_RING)
    write_ring(card, REGISTER_RX_RING, RX_RING)
    firmware.write16(card.mmio, card.base, REGISTER_RX_MAX_SIZE, RX_MAX_SIZE)
    firmware.write8(card.mmio, card.base, REGISTER_TX_MAX_SIZE, TX_MAX_SIZE)
    firmware.write8(card.mmio, card.base, REGISTER_CHIP_COMMAND, CHIP_RX_TX)
    firmware.write16(card.mmio, card.base, REGISTER_RX_CONFIG, RX_CONFIG_LOW)
    firmware.write16(card.mmio, card.base, REGISTER_RX_CONFIG + 2, 0)
    firmware.write16(card.mmio, card.base, REGISTER_TX_CONFIG, TX_CONFIG_LOW)
    firmware.write16(card.mmio, card.base, REGISTER_TX_CONFIG + 2, TX_CONFIG_HIGH)
    firmware.write8(card.mmio, card.base, REGISTER_CONFIG_LOCK, 0)
    out none
}

skill wait_link(card) {
    drum (60) {
        @status = firmware.read8(card.mmio, card.base, REGISTER_PHY_STATUS)
        (has_bit(status, PHY_LINK) == yes) { out link_text(status) }
        delay(card, 100000)
    }
    out error.NoLink
}

skill add16(bytes, value) {
    out group.add(group.add(bytes, value / 256), num.mod(value, 256))
}

skill checksum(words) {
    @total = 0
    drum (words) { total = total + beat }
    drum (4) { total = num.mod(total, 65536) + total / 65536 }
    out 65535 - total
}

skill frame(card, to_mac, to_ip, to_port, text) {
    @udp_length = 8 + str.len(text)
    @ip = [17664, 20 + udp_length, 1, 0, 16401, 0, group.get(OWN_IP, 0), group.get(OWN_IP, 1), group.get(to_ip, 0), group.get(to_ip, 1)]
    @bytes = to_mac
    drum (card.mac) { bytes = group.add(bytes, beat) }
    bytes = add16(bytes, TYPE_IPV4)
    drum (10) {
        @word = group.get(ip, beat)
        (beat == 5) { word = checksum(ip) }
        bytes = add16(bytes, word)
    }
    bytes = add16(add16(add16(add16(bytes, PORT), to_port), udp_length), 0)
    drum (str.len(text)) { bytes = group.add(bytes, str.byte(text, beat)) }
    (group.count(bytes) < FRAME_MINIMUM) {
        drum (FRAME_MINIMUM - group.count(bytes)) { bytes = group.add(bytes, 0) }
    }
    out bytes
}

skill send(card, bytes) {
    drum (group.count(bytes)) { firmware.write8(card.arena, card.base, TX_BUFFER + beat, group.get(bytes, beat)) }
    descriptor(card, TX_RING, DESCRIPTOR_OWN + DESCRIPTOR_END + DESCRIPTOR_FIRST_LAST, group.count(bytes), TX_BUFFER)
    firmware.write8(card.mmio, card.base, REGISTER_TX_POLL, TX_POLL_NORMAL)
    drum (100000) {
        (firmware.read16(card.arena, card.base, TX_RING + 2) < DESCRIPTOR_OWN) { out group.count(bytes) }
    }
    out error.SendTimeout
}

skill rx_byte(card, buffer, offset) {
    out firmware.read8(card.arena, card.base, buffer + offset)
}

skill rx_word(card, buffer, offset) {
    out rx_byte(card, buffer, offset) * 256 + rx_byte(card, buffer, offset + 1)
}

skill printable(code) {
    (code < 32) { out "." }
    (code > 126) { out "." }
    out str.get(ASCII, code - 32)
}

skill ip_text(card, buffer, offset) {
    @first = rx_byte(card, buffer, offset)
    @text = "{first}"
    drum (3) {
        @part = rx_byte(card, buffer, offset + beat + 1)
        text = "{text}.{part}"
    }
    out text
}

skill answer(card, buffer, length) {
    @from_mac = []
    drum (6) { from_mac = group.add(from_mac, rx_byte(card, buffer, 6 + beat)) }
    @from_ip = [rx_word(card, buffer, 26), rx_word(card, buffer, 28)]
    @from_port = rx_word(card, buffer, 34)
    @size = rx_word(card, buffer, 38) - 8
    (size > length - 42) { size = length - 42 }
    @command = ""
    drum (size) { command = str.add(command, printable(rx_byte(card, buffer, 42 + beat))) }
    @who = ip_text(card, buffer, 26)
    io.show("    command from {who}:{from_port}: {command}")
    @sent = send(card, frame(card, from_mac, from_ip, from_port, "echo: {command}"))
    io.show("    replied with {sent} bytes")
    out none
}

skill handle_rx(card, index) {
    @buffer = RX_BUFFERS + index * BUFFER_BYTES
    @length = num.mod(firmware.read16(card.arena, card.base, RX_RING + index * DESCRIPTOR_BYTES), 16384)
    @from = []
    drum (6) { from = group.add(from, rx_byte(card, buffer, 6 + beat)) }
    @type = rx_word(card, buffer, 12)
    @sender = mac_text(from)
    @kind = firmware.hex(type, 4)
    io.show("rx: {length} bytes from {sender}, type {kind}")
    (type == TYPE_IPV4) {
        (rx_byte(card, buffer, 23) == PROTOCOL_UDP) {
            (rx_word(card, buffer, 36) == PORT) { answer(card, buffer, length) }
        }
    }
    out none
}

skill poll_rx(card) {
    @seen = 0
    drum (RX_COUNT) {
        (firmware.read16(card.arena, card.base, RX_RING + beat * DESCRIPTOR_BYTES + 2) < DESCRIPTOR_OWN) {
            handle_rx(card, beat)
            arm_rx(card, beat)
            seen = seen + 1
        }
    }
    out seen
}

skill run() {
    @card = open()
    @mac = mac_text(card.mac)
    @arena = firmware.phys_text(card.arena)
    io.show("[1] card {mac}, DMA arena at {arena}")
    configure(card)
    io.show("[2] card reset and configured, rings armed")
    io.show("[3] waiting for link...")
    @link = wait_link(card)
    io.show("[4] link {link}")
    @sent = send(card, frame(card, BROADCAST_MAC, BROADCAST_IP, PORT, "hello from Saltic, listening on 10.0.0.2:5555"))
    io.show("[5] announced myself ({sent} bytes), listening for UDP on port 5555")
    drum (LISTEN_ROUNDS) { poll_rx(card) }
    out none
}

program() {
    io.show("Saltic RTL8111 driver, step 3: receive frames, answer UDP commands")
    @done = run() rescue |err| {
        io.show("FAILED: ", err)
        none
    }
    io.show("")
    io.show("This program never exits. Turn the laptop off when done.")
    drum (200000000) {
        @key = io.key()
    }
}
