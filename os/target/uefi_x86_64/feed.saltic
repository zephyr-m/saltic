use core.str
use core.group
use os.target.uefi_x86_64.firmware
use os.target.uefi_x86_64.uefi
use os.target.uefi_x86_64.graphics
use os.target.uefi_x86_64.lettering
use os.target.uefi_x86_64.clock
use os.target.uefi_x86_64.spider

MARGIN = 40
BAR_SPACE = 64
TOP = 96
LINE_GAP = 4
LOG_LIMIT = 150
REPLY_INDENT = 24
REPLY_LINES = 24
BOOT_COPY_MEM = 352

skill paper(screen) {
    out graphics.color(screen, 250, 250, 250)
}

skill ink(screen) {
    out graphics.color(screen, 24, 24, 27)
}

skill code_ink(screen) {
    out graphics.color(screen, 37, 99, 235)
}

skill faint(screen) {
    out graphics.color(screen, 113, 113, 122)
}

skill scroll(agent, screen, amount) {
    @base = agent.card.base
    @services = uefi.boot_services(base)
    @limit = screen.height - BAR_SPACE - 32
    @row_bytes = screen.stride * graphics.PIXEL_BYTES
    @upper = firmware.add(screen.frame, (TOP - 8) * row_bytes)
    @lower = firmware.add(screen.frame, (TOP - 8 + amount) * row_bytes)
    @length = (limit - TOP + 8 - amount) * row_bytes
    firmware.call(base, firmware.pointer(services, base, BOOT_COPY_MEM), [upper, lower, firmware.number(length)])
    graphics.fill(screen, 0, limit - amount, screen.width, amount, paper(screen))
    spider.draw(base)
    agent.cursor = agent.cursor - amount
    out none
}

skill next_row(agent, screen, face) {
    @limit = screen.height - BAR_SPACE - 32
    (agent.cursor + face.height > limit) { scroll(agent, screen, agent.cursor + face.height - limit) }
    @y = agent.cursor
    agent.cursor = agent.cursor + face.height + LINE_GAP
    out y
}

skill text_bytes(text, limit) {
    @bytes = []
    @count = str.len(text)
    (count > limit) { count = limit }
    drum (count) { bytes = group.add(bytes, str.byte(text, beat)) }
    out bytes
}

skill show_command(agent, who, payload) {
    (agent.console == yes) { out none }
    (agent.lent == yes) { out none }
    @screen = graphics.open(agent.card.base)
    @face = lettering.FACE_SMALL
    @moment_text = clock.clock_text(clock.local_time(uefi.now(agent.card.base)))
    @bytes = text_bytes("{moment_text}  {who}  ", LOG_LIMIT)
    @shown = group.count(payload)
    (shown > LOG_LIMIT) { shown = LOG_LIMIT }
    bytes = group.concat(bytes, group.slice(payload, 0, shown))
    lettering.paint_bytes(screen, face, MARGIN, next_row(agent, screen, face), bytes, faint(screen))
    out none
}

skill split_lines(bytes) {
    @lines = []
    @line = []
    drum (bytes) {
        (beat == 10) {
            lines = group.add(lines, line)
            line = []
        }
        ((beat == 10) == no) { line = group.add(line, beat) }
    }
    out group.add(lines, line)
}

skill show_reply(agent, bytes) {
    out show_lines(agent, bytes, REPLY_INDENT, no)
}

skill show_code(agent, bytes) {
    out show_lines(agent, bytes, REPLY_INDENT * 2, yes)
}

skill show_lines(agent, bytes, indent, is_code) {
    (agent.console == yes) { out none }
    (agent.lent == yes) { out none }
    @screen = graphics.open(agent.card.base)
    @color = ink(screen)
    (is_code == yes) { color = code_ink(screen) }
    @face = lettering.FACE_SMALL
    @lines = split_lines(bytes)
    @shown = group.count(lines)
    (shown > REPLY_LINES) { shown = REPLY_LINES }
    drum (shown) {
        @row = next_row(agent, screen, face)
        @line = group.get(lines, beat)
        @width = group.count(line)
        (width > LOG_LIMIT) { width = LOG_LIMIT }
        lettering.paint_bytes(screen, face, MARGIN + indent, row, group.slice(line, 0, width), color)
    }
    @hidden = group.count(lines) - shown
    (hidden > 0) {
        @row = next_row(agent, screen, face)
        lettering.paint_text(screen, face, MARGIN + indent, row, "... и ещё {hidden} строк", faint(screen))
    }
    out none
}
