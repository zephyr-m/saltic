-- shot — снимок экрана по сети (tools/shot.py): экран уменьшается вдвое,
-- пиксели RGB кладутся в участок арены "shot" (arena_map): 1555200 байт —
-- ровно половинный кадр 1920 × 1080 (1366 × 768 — 786816). Экран больше —
-- ShotTooBig, снимок не делается и чужую память не трогает.
--
-- capture(card) -> байтов в снимке; ShotTooBig
-- caption(card, bytes) -> заголовок ответа
-- send_chunk(card, bytes, packet, index) — отправить кусок снимка по кабелю
-- chunk_frame(mac, ip, base, total, packet, index) -> кадр Ethernet куска
--     группой байтов — для Wi-Fi (своего буфера отправки у неё нет)

use core.mem
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.arena_map
use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.drivers.rtl8111
use os.target.uefi_x86_64.network.net

SHOT_CHUNK = 1024
SHOT_HEADER = 46
MY_IP = [10, 0, 0, 2]
PORT = 5555

skill shot_bytes(screen) {
    out (screen.width / 2) * (screen.height / 2) * 3
}

skill capture(card) {
    @base = card.base
    @screen = graphics.open_whole(base)
    @room = arena_map.region("shot")
    (shot_bytes(screen) > room.bytes) { out error.ShotTooBig }
    @width = screen.width / 2
    @height = screen.height / 2
    @place = firmware.guest(firmware.region(base, "shot"), base)
    @at = 0
    @red = 2
    @blue = 0
    (screen.format == graphics.FORMAT_RGB) {
        red = 0
        blue = 2
    }
    drum (height) {
        @line = beat * 2 * screen.stride * graphics.PIXEL_BYTES
        drum (width) {
            @pixel = line + beat * 2 * graphics.PIXEL_BYTES
            mem.store8(place, at, mem.load8(screen.memory, pixel + red))
            mem.store8(place, at + 1, mem.load8(screen.memory, pixel + 1))
            mem.store8(place, at + 2, mem.load8(screen.memory, pixel + blue))
            at = at + 3
        }
    }
    out shot_bytes(screen)
}

skill caption(card, total) {
    @screen = graphics.open_whole(card.base)
    @width = screen.width / 2
    @height = screen.height / 2
    @chunks = (total + SHOT_CHUNK - 1) / SHOT_CHUNK
    out "снимок {width} {height} {total} {chunks}"
}

skill chunk_frame(mac, ip, base, total, packet, index) {
    @first = index * SHOT_CHUNK
    @size = total - first
    (size > SHOT_CHUNK) { size = SHOT_CHUNK }
    (size < 1) { out none }
    @bytes = net.udp_header(mac, ip, packet.from_mac, packet.from_ip, PORT, packet.from_port, size + 4)
    bytes = net.add16(net.add16(bytes, index / 65536), index % 65536)
    @place = firmware.guest(firmware.region(base, "shot"), base)
    drum (size) { bytes = group.add(bytes, mem.load8(place, first + beat)) }
    out net.pad(bytes)
}

skill send_chunk(card, total, packet, index) {
    @first = index * SHOT_CHUNK
    @size = total - first
    (size > SHOT_CHUNK) { size = SHOT_CHUNK }
    (size < 1) { out none }
    @header = net.udp_header(card.mac, MY_IP, packet.from_mac, packet.from_ip, PORT, packet.from_port, size + 4)
    header = net.add16(net.add16(header, index / 65536), index % 65536)
    @frame = firmware.guest(card.tx_buffer, card.base)
    @place = firmware.guest(firmware.region(card.base, "shot"), card.base)
    drum (SHOT_HEADER) { mem.store8(frame, beat, group.get(header, beat)) }
    drum (size) { mem.store8(frame, SHOT_HEADER + beat, mem.load8(place, first + beat)) }
    @length = SHOT_HEADER + size
    (length < net.FRAME_MINIMUM) {
        drum (net.FRAME_MINIMUM - length) { mem.store8(frame, length + beat, 0) }
        length = net.FRAME_MINIMUM
    }
    rtl8111.send_prepared(card, length)
    out none
}
