-- data — data ответа mRPC полями, а не текстом: член объекта JSON — пара
-- [имя, байты значения]; строки — UTF-8 как есть (mrpc.quoted_text).
--
-- text(name, value) / number(name, value) / answer(name, yes/no) /
--     object(name, members) -> член
-- encode(members) -> байты объекта {"имя":значение,…}
-- reply(call, members, ms) -> байты ответа ok с data = encode(members)

use core.group
use os.target.uefi_x86_64.platform.utf8
use os.target.uefi_x86_64.network.mrpc

skill text(name, value) {
    out [name, mrpc.quoted_text(value)]
}

skill number(name, value) {
    out [name, utf8.encode("{value}")]
}

skill answer(name, value) {
    (value == yes) { out [name, utf8.encode("true")] }
    out [name, utf8.encode("false")]
}

skill object(name, members) {
    out [name, encode(members)]
}

skill encode(members) {
    @bytes = [123]
    drum (group.count(members)) {
        @member = group.get(members, beat)
        (beat > 0) { bytes = group.add(bytes, 44) }
        bytes = group.concat(group.add(group.concat(bytes, mrpc.quoted_text(group.get(member, 0))), 58), group.get(member, 1))
    }
    out group.add(bytes, 125)
}

skill reply(call, members, ms) {
    @start = group.concat(mrpc.head(call, yes, ms), utf8.encode(",\"data\":"))
    out group.add(group.concat(start, encode(members)), 125)
}
