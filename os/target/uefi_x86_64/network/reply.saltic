-- reply — выход из UEFI-программы с текстом для родителя (agent).
-- Текст кладётся в пул прошивки: 2 нулевых байта, затем байты text; родитель
-- читает его через uefi.start_image → Launched.output.
--
-- finish(text) — выход со статусом DONE (0)
-- home(text) — выход со статусом HOME (2): «вернуться в меню»
-- exit_with(text, status) -> Answer; MemoryExhausted, если пул не выделен

use core.str
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.uefi

BOOT_ALLOCATE_POOL = 64
BOOT_EXIT = 216
LOADER_DATA = 2
SCRATCH_POOL = 0
DONE = 0
HOME = 2

skill finish(text) {
    out exit_with(text, DONE)
}

skill home(text) {
    out exit_with(text, HOME)
}

skill exit_with(text, status) {
    @base = firmware.guest_base()
    @services = uefi.boot_services(base)
    @size = str.bytes(text) + 2
    @pool_at = firmware.scratch(base, SCRATCH_POOL)
    @got = firmware.call(base, firmware.pointer(services, base, BOOT_ALLOCATE_POOL), [firmware.number(LOADER_DATA), firmware.number(size), pool_at])
    (got.failed == yes) { out error.MemoryExhausted }
    @data = firmware.pointer(pool_at, base, 0)
    firmware.write16(data, base, 0, 0)
    drum (str.bytes(text)) { firmware.write8(data, base, 2 + beat, str.byte(text, beat)) }
    out firmware.call(base, firmware.pointer(services, base, BOOT_EXIT), [firmware.image_handle(), firmware.number(status), firmware.number(size), data])
}
