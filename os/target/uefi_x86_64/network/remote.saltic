-- remote — сеть для программ, пока агент ждёт их возвращения: программа раз
-- в кадр зовёт serve. Общий протокол, который remote ведёт сам за любую
-- программу (порт 5555, команды текстом):
--   quit  — выйти на главный экран агента (reply.home), из любой программы
--   state — ответить текстом, который программа сообщила о себе через tell
--   shot  — снимок экрана (tools/shot.py)
--   key <клавиша или текст> — нажатие в очередь keys, программа читает его
--         через uefi.poll_key как настоящее
-- state и quit понимает и mRPC (пакет-объект JSON, network.mrpc); прочие
-- cmd — unknown_cmd со списком.
-- Остальные пакеты UDP на 5555 отдаются программе — у неё свои команды.
-- Вход — кабель (rtl8111) и Wi-Fi, поднятый агентом (qca9377.handoff): ответ
-- уходит тем входом, откуда пришёл последний пакет (via); счётчики колец
-- Wi-Fi — обратно на страницу передачи каждый круг serve.
-- Каждый запрос и каждый ответ (и программы тоже) пишется в netlog — панель
-- слева; куски снимка shot-part не пишутся. Раз в PANEL_EVERY вызовов serve —
-- system_panel.tick (панель справа) со счётчиком кадров программы: один
-- вызов serve — один кадр, панель рисует их график.
--
-- Remote — карта, Wi-Fi (или none), via, состояние программы текстом, байты
--     последнего снимка, meter — счётчик кадров для системной панели
-- open_remote() -> Remote; нет ни кабеля, ни Wi-Fi от агента — NoLink
-- my_ip(remote) / our_mac(remote) / transmit(remote, frame) — по входу via
-- serve(remote) -> группа пакетов Udp для программы
-- tell(remote, text) — сообщить своё состояние (отвечает на state)
-- own(remote, place, pages) — страницы прошивки, которые вернуть при quit
-- reply_text(remote, packet, text) — ответить отправителю
-- send_to(remote, packet, port, text_bytes) — ответить на другой порт
-- answer(remote, bytes) -> пакет или none — разбор одного кадра (для serve)
-- answer_mrpc(remote, packet) — ответ mRPC: state, quit, key, help, иначе unknown_cmd
-- key_reply(text) -> текст — нажатия в очередь keys

use core.num
use core.str
use core.group
use os.target.uefi_x86_64.drivers.rtl8111
use os.target.uefi_x86_64.drivers.qca9377.handoff
use os.target.uefi_x86_64.drivers.qca9377.traffic
use os.target.uefi_x86_64.network.net
use os.target.uefi_x86_64.network.shot
use os.target.uefi_x86_64.platform.parse
use os.target.uefi_x86_64.network.reply
use os.target.uefi_x86_64.network.netlog
use os.target.uefi_x86_64.screen.system_panel
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.uefi
use os.target.uefi_x86_64.network.mrpc
use os.target.uefi_x86_64.platform.utf8
use os.target.uefi_x86_64.platform.keys

MY_IP = [10, 0, 0, 2]
PORT = 5555
PART = "shot-part "

PANEL_EVERY = 8
WIFI_FRAMES = 4
REPLY_LIMIT = 1400
QUIET_STATE = "программа не рассказала о себе (нет remote.tell)"
COMMANDS = [
    mrpc.Command { name = "state", kind = "query", about = "что программа сообщила о себе" },
    mrpc.Command { name = "quit", kind = "exec", about = "выйти на главный экран агента" },
    mrpc.Command { name = "key", kind = "exec", params = ["key"], about = "нажать клавишу или набрать текст" }
]

Remote = Box {
    card = rtl8111.Card {},
    shot_bytes = 0,
    state = "",
    owned = [],
    rounds = 0,
    meter = system_panel.Meter {},
    wifi = none,
    cabled = no,
    via = "cable"
}

skill open_remote() {
    @card = rtl8111.open()
    rtl8111.configure(card)
    rtl8111.wait_link(card) rescue |err| { none }
    @cabled = rtl8111.has_bit(rtl8111.status(card), rtl8111.PHY_LINK)
    @remote = Remote { card = card, cabled = cabled }
    @wifi = handoff.adopt(card.base) rescue |err| { none }
    remote.wifi = wifi
    (cabled == no) {
        (wifi == none) { out error.NoLink }
        remote.via = "wifi"
    }
    out remote
}

skill my_ip(remote) {
    (remote.via == "wifi") { out remote.wifi.ip }
    out MY_IP
}

skill our_mac(remote) {
    (remote.via == "wifi") { out remote.wifi.mac }
    out remote.card.mac
}

skill transmit(remote, frame) {
    (remote.via == "wifi") {
        traffic.send(remote.wifi, remote.wifi.point, frame)
        out group.count(frame)
    }
    out rtl8111.send(remote.card, frame)
}

skill reply_text(remote, packet, text) {
    netlog.say_text(remote.card.base, text)
    out transmit(remote, net.udp_frame(our_mac(remote), my_ip(remote), packet.from_mac, packet.from_ip, PORT, packet.from_port, text))
}

skill answer(remote, bytes) {
    (remote.via == "wifi") { traffic.answer_arp(remote.wifi, remote.wifi.point, bytes) }
    (net.is_arp_request_for(bytes, MY_IP) == yes) {
        (remote.via == "cable") { rtl8111.send(remote.card, net.arp_reply(remote.card.mac, MY_IP, bytes)) }
        out none
    }
    (net.is_udp_to(bytes, PORT) == no) { out none }
    @packet = net.udp(bytes)
    (str.starts_with(packet.text, PART) == yes) {
        (remote.via == "wifi") {
            @piece = shot.chunk_frame(remote.wifi.mac, remote.wifi.ip, remote.card.base, remote.shot_bytes, packet, parse.parse_size(str.slice(packet.text, str.bytes(PART), str.bytes(packet.text))))
            ((piece == none) == no) { transmit(remote, piece) }
            out none
        }
        shot.send_chunk(remote.card, remote.shot_bytes, packet, parse.parse_size(str.slice(packet.text, str.bytes(PART), str.bytes(packet.text))))
        out none
    }
    netlog.ask(remote.card.base, packet.payload)
    (mrpc.is_request(packet.payload) == yes) {
        answer_mrpc(remote, packet)
        out none
    }
    (packet.text == "shot") {
        @taken = shot.capture(remote.card) rescue |err| {
            reply_text(remote, packet, "снимок не сделан: {err} (участок shot — половина экрана до 1920 × 1080)")
            out none
        }
        remote.shot_bytes = taken
        reply_text(remote, packet, shot.caption(remote.card, remote.shot_bytes))
        out none
    }
    (str.starts_with(packet.text, "key ") == yes) {
        reply_text(remote, packet, key_reply(str.slice(packet.text, 4, str.bytes(packet.text))))
        out none
    }
    (packet.text == "state") {
        @told = remote.state
        (str.bytes(told) == 0) { told = QUIET_STATE }
        reply_text(remote, packet, told)
        out none
    }
    (packet.text == "quit") {
        reply_text(remote, packet, "выхожу на главный экран")
        drum (remote.owned) { uefi.free_pages(firmware.guest_base(), group.get(beat, 0), group.get(beat, 1)) }
        reply.home("вышла по команде quit")
        out none
    }
    out packet
}

skill key_reply(text) {
    @count = keys.push(firmware.guest_base(), text) rescue |err| { out "клавиша не принята: {err}" }
    out "принято нажатий: {count}"
}

skill answer_mrpc(remote, packet) {
    @call = mrpc.decode(packet.text)
    (call.ok == no) { out send_to(remote, packet, packet.from_port, mrpc.failure(call, "invalid_param", call.message, "", 0)) }
    (call.cmd == "state") {
        @told = remote.state
        (str.bytes(told) == 0) { told = QUIET_STATE }
        out send_to(remote, packet, packet.from_port, mrpc.success(call, utf8.encode(told), 0, REPLY_LIMIT))
    }
    (call.cmd == "quit") {
        send_to(remote, packet, packet.from_port, mrpc.success(call, utf8.encode("выхожу на главный экран"), 0, REPLY_LIMIT))
        drum (remote.owned) { uefi.free_pages(firmware.guest_base(), group.get(beat, 0), group.get(beat, 1)) }
        reply.home("вышла по команде quit")
        out none
    }
    (call.cmd == "key") {
        @asked = mrpc.line(call, mrpc.find(COMMANDS, "key"))
        (asked.ok == no) { out send_to(remote, packet, packet.from_port, mrpc.failure(call, "missing_param", "нужен параметр key", "key", 0)) }
        out send_to(remote, packet, packet.from_port, mrpc.success(call, utf8.encode(key_reply(str.slice(asked.text, 4, str.bytes(asked.text)))), 0, REPLY_LIMIT))
    }
    (call.cmd == "help") { out send_to(remote, packet, packet.from_port, mrpc.help(call, COMMANDS, 0, REPLY_LIMIT)) }
    out send_to(remote, packet, packet.from_port, mrpc.unknown(call, COMMANDS, 0))
}

skill serve(remote) {
    remote.rounds = remote.rounds + 1
    @meter = remote.meter
    meter.rounds = remote.rounds
    (num.mod(remote.rounds, PANEL_EVERY) == 0) { system_panel.tick(remote.card.base, remote.card, meter) rescue |err| { none } }
    @packets = []
    drum (rtl8111.RX_COUNT) {
        (rtl8111.received(remote.card, beat) == yes) {
            @bytes = rtl8111.read_frame(remote.card, beat)
            rtl8111.release(remote.card, beat)
            remote.via = "cable"
            @packet = answer(remote, bytes)
            ((packet == none) == no) { packets = group.add(packets, packet) }
        }
    }
    (remote.wifi == none) { out packets }
    drum (WIFI_FRAMES) {
        @bytes = traffic.poll(remote.wifi)
        (bytes == none) { leave }
        remote.via = "wifi"
        @packet = answer(remote, bytes)
        ((packet == none) == no) { packets = group.add(packets, packet) }
    }
    handoff.write_counters(remote.wifi)
    out packets
}

skill send_to(remote, packet, port, text_bytes) {
    netlog.say(remote.card.base, text_bytes)
    out transmit(remote, net.udp_frame_bytes(our_mac(remote), my_ip(remote), packet.from_mac, packet.from_ip, PORT, port, text_bytes))
}

skill tell(remote, text) {
    remote.state = text
    out none
}

skill own(remote, place, pages) {
    remote.owned = group.add(remote.owned, [place, pages])
    out none
}
