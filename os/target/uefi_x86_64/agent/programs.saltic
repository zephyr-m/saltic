-- programs — полка программ агента на диске: папка \SALTIC\BIN, файлы ИМЯ.EFI;
-- рядом — данные агента в своих папках (\SALTIC\FIRMWARE: прошивка Wi-Fi).
-- Имя приводится к верхнему регистру; размеры — числа до 2^32 через hi/lo.
--
-- shelf_path() -> "SALTIC\BIN" / file_name(name) -> "ИМЯ.EFI"
-- forget(base, folder, entry) — удаляет файл entry из папки, если есть
-- keep(base, image, size, name) -> записано байт; WriteFailed
-- keep_file(base, image, size, folder, file) -> так же в \SALTIC\folder\file
-- load_file(base, path, place, limit) -> прочитано байт; path от \SALTIC
-- shelf_names(base) -> [имена без .EFI]; без диска — []
-- load(base, name, place, limit) -> прочитано байт в place; ReadFailed

use core.str
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.storage.files

HOME = "SALTIC"
SHELF = "BIN"
TAIL = ".EFI"
FILE_DELETE = 24
MODE_READ_WRITE = 3

skill shelf_path() {
    out str.concat(str.concat(HOME, "\\"), SHELF)
}

skill file_name(name) {
    out str.concat(str.upper(name), TAIL)
}

skill forget(base, shelf, entry) {
    @child_at = firmware.scratch(base, files.SCRATCH_POINTER)
    @opened = firmware.call(base, firmware.pointer(shelf, base, files.FILE_OPEN), [shelf, child_at, files.wide_name(base, entry), firmware.number(MODE_READ_WRITE), firmware.number(0)])
    (opened.failed == yes) { out none }
    @file = firmware.pointer(child_at, base, 0)
    out firmware.call(base, firmware.pointer(file, base, FILE_DELETE), [file])
}

skill keep(base, image, size, name) {
    out keep_file(base, image, size, SHELF, file_name(name))
}

skill keep_file(base, image, size, folder, name) {
    @root = files.saltic_root(base)
    @home = files.create(base, root, HOME, files.DIRECTORY)
    @shelf = files.create(base, home, folder, files.DIRECTORY)
    forget(base, shelf, name)
    @file = files.create(base, shelf, name, 0)
    @size_at = firmware.scratch(base, files.SCRATCH_SIZE)
    firmware.write64(size_at, base, 0, firmware.number(size))
    @written = firmware.call(base, firmware.pointer(file, base, files.FILE_WRITE), [file, size_at, image])
    (written.failed == yes) { out error.WriteFailed }
    @count = firmware.read16(size_at, base, 0) + firmware.read16(size_at, base, 2) * 65536
    firmware.call(base, firmware.pointer(file, base, files.FILE_FLUSH), [file])
    files.close_file(base, file)
    files.close_file(base, shelf)
    files.close_file(base, home)
    files.close_file(base, root)
    out count
}

skill shelf_names(base) {
    @root = files.saltic_root(base) rescue |err| { out [] }
    @found = files.folder_names(base, root, shelf_path())
    files.close_file(base, root)
    @names = []
    drum (found) {
        (str.ends_with(beat, TAIL) == yes) { names = group.add(names, str.slice(beat, 0, str.bytes(beat) - str.bytes(TAIL))) }
    }
    out names
}

skill load(base, name, place, limit) {
    out load_file(base, str.concat(str.concat(SHELF, "\\"), file_name(name)), place, limit)
}

skill load_file(base, path, place, limit) {
    @root = files.saltic_root(base)
    @file = files.open_child(base, root, str.concat(str.concat(HOME, "\\"), path))
    @size_at = firmware.scratch(base, files.SCRATCH_SIZE)
    firmware.write64(size_at, base, 0, firmware.number(limit))
    @read = firmware.call(base, firmware.pointer(file, base, files.FILE_READ), [file, size_at, place])
    files.close_file(base, file)
    files.close_file(base, root)
    (read.failed == yes) { out error.ReadFailed }
    out firmware.read16(size_at, base, 0) + firmware.read16(size_at, base, 2) * 65536
}
