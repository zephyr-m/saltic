use core.group
use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.agent.feed
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.icons

CARD = 36
GAP = 10
PADDING = 14

skill shelf_top(screen) {
    out screen.height - feed.BAR_SPACE - 28 - feed.SHELF_SPACE
}

skill card_width(name) {
    out fonts.measure(name, fonts.MEDIUM) + 2 * PADDING + icons.SIZE + 8
}

skill draw_shelf(base, names, chosen) {
    @screen = graphics.open(base)
    @top = shelf_top(screen)
    graphics.fill(screen, 0, top, screen.width, feed.SHELF_SPACE, canvas.paint(screen, canvas.PAPER))
    @small = fonts.SMALL
    fonts.draw_text(screen, feed.MARGIN, top + 6, "Программы на диске: ← → выбрать, Enter — открыть, keep <имя> — сохранить принятую", canvas.ZINC_500, small)
    @row = top + 30
    (group.count(names) == 0) {
        fonts.draw_text(screen, feed.MARGIN, row + 8, "пока пусто: залей программу (upload.py) и скажи keep <имя>", canvas.ZINC_500, fonts.REGULAR)
        out none
    }
    @x = feed.MARGIN
    @face = fonts.MEDIUM
    drum (group.count(names)) {
        @name = group.get(names, beat)
        @wide = card_width(name)
        @style = canvas.variant_look("outline")
        (beat == chosen) { style = canvas.variant_look("default") }
        shapes.framed_box(screen, x, row, wide, CARD, 8, style, canvas.PAPER)
        icons.draw_icon(screen, x + PADDING, row + (CARD - icons.SIZE) / 2, "file", style.ink)
        fonts.draw_text(screen, x + PADDING + icons.SIZE + 8, row + (CARD - face.line) / 2, name, style.ink, face)
        x = x + wide + GAP
    }
    out none
}
