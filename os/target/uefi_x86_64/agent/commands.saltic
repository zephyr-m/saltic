-- commands — реестр команд агента: имя, вид mRPC (query / exec / raw),
-- обязательные и необязательные параметры по порядку, описание. Из него
-- строятся и текстовый help, и mRPC help / describe (network.mrpc).
-- Параметры встают в текст команды через пробел в том же порядке.
--
-- REGISTRY — группа mrpc.Command
-- help_text() -> "команды: имя <парам> — описание | …"

use core.str
use core.group
use os.target.uefi_x86_64.network.mrpc

REGISTRY = [
    mrpc.Command { name = "help", kind = "raw", about = "эта справка" },
    mrpc.Command { name = "info", kind = "query", about = "о себе" },
    mrpc.Command { name = "pci", kind = "query", about = "устройства" },
    mrpc.Command { name = "mem", kind = "query", params = ["address"], options = ["bytes"], about = "память: адрес hex, байт до 64" },
    mrpc.Command { name = "echo", kind = "raw", params = ["text"], about = "вернуть текст" },
    mrpc.Command { name = "upload", kind = "exec", params = ["bytes"], about = "принять программу, байты — на порт 5556" },
    mrpc.Command { name = "check", kind = "query", about = "что принято" },
    mrpc.Command { name = "run", kind = "exec", about = "запустить принятое" },
    mrpc.Command { name = "screen", kind = "exec", about = "проверочная картинка" },
    mrpc.Command { name = "print", kind = "exec", params = ["text"], about = "напечатать своим шрифтом" },
    mrpc.Command { name = "clear", kind = "exec", about = "очистить экран (после run экран у программы, лента молчит до clear)" },
    mrpc.Command { name = "volumes", kind = "query", about = "файловые системы и их папки EFI (только чтение)" },
    mrpc.Command { name = "prepare-disk", kind = "exec", options = ["confirm"], about = "какой диск будет стёрт; с confirm = ERASE-ACER-DISK — стереть и разметить" },
    mrpc.Command { name = "install", kind = "exec", about = "записать принятую программу на диск" },
    mrpc.Command { name = "usb", kind = "query", about = "устройства USB" },
    mrpc.Command { name = "protocols", kind = "query", options = ["disk"], about = "протоколы блочного диска, номер hex" },
    mrpc.Command { name = "camera", kind = "query", about = "что умеет камера" },
    mrpc.Command { name = "code", kind = "exec", params = ["text"], about = "показать кусок кода" },
    mrpc.Command { name = "keep", kind = "exec", params = ["name"], about = "сохранить принятую программу на диск, она появится в панели (Enter — открыть)" },
    mrpc.Command { name = "open", kind = "exec", params = ["name"], about = "открыть программу из панели (ответ сразу, программа — следом)" },
    mrpc.Command { name = "state", kind = "query", about = "где я и что вокруг текстом; в программе: state, quit (выйти), shot" },
    mrpc.Command { name = "key", kind = "exec", params = ["key"], about = "нажать клавишу: esc, enter, tab, left, right, up, down, home, end, backspace, space или набрать текст; в программе с сетью — ей" },
    mrpc.Command { name = "time", kind = "query", about = "дата и время" },
    mrpc.Command { name = "reboot", kind = "exec", about = "перезагрузить ноутбук" },
    mrpc.Command { name = "shot", kind = "raw", about = "снимок экрана (забирает tools/shot.py); только по кабелю" },
    mrpc.Command { name = "wifi", kind = "exec", options = ["network"], about = "поднять Wi-Fi: прошивка с диска, открытая сеть (без имени — точка телефона), адрес по DHCP" },
    mrpc.Command { name = "wifi-keep", kind = "exec", about = "сохранить принятую посылку прошивки Wi-Fi (tools/wifi_pack.py) на диск" }
]

skill help_text() {
    @parts = []
    drum (group.count(REGISTRY)) {
        @command = group.get(REGISTRY, beat)
        @words = command.name
        drum (group.count(command.params)) {
            @param = group.get(command.params, beat)
            words = "{words} <{param}>"
        }
        drum (group.count(command.options)) {
            @option = group.get(command.options, beat)
            words = "{words} [{option}]"
        }
        @about = command.about
        parts = group.add(parts, "{words} — {about}")
    }
    @joined = str.join(parts, " | ")
    out "команды: {joined}"
}
