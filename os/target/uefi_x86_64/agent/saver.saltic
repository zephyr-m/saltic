-- saver — хранитель экрана агента: в середине экрана облетает полянка
-- «Пластилина» (screen/clay/stage), боковые панели остаются. Включает агент
-- после простоя (agent.saltic, SAVER_AFTER), снимает — любая команда или
-- клавиша. Кадр рисуется в цикле агента, сеть между кадрами живёт. Раз в
-- RENEW секунд полянка новая (пока лепится — пара секунд — сеть ждёт).
-- Прежний хранитель (градиент с паучком) — .archive/os/agent/saver-gradient.saltic.
--
-- Dream { set, angle, lift, made } — площадка, камера, секунда суток
--     последней полянки
-- start(base) -> Dream — буферы и сцена (страницы); MemoryExhausted
-- frame(dream, base) — один кадр, камера сдвигается на SPEED; пора — новая
--     полянка
-- stop(base, dream) — отдать буферы

use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.screen.clay.forms
use os.target.uefi_x86_64.screen.clay.stage

SPEED = 300
LIFT = 380
RENEW = 60
DAY = 86400

Dream = Box {
    set = stage.Stage {},
    angle = 0,
    lift = LIFT,
    made = 0
}

skill start(base) {
    @set = stage.open_stage(base, graphics.open(base))
    out Dream { set = set, made = stage.moment(base) }
}

skill frame(dream, base) {
    ((stage.moment(base) - dream.made + DAY) % DAY >= RENEW) {
        stage.remake(dream.set, base)
        dream.made = stage.moment(base)
    }
    stage.render(dream.set, dream.angle, dream.lift, base)
    dream.angle = forms.wrap(dream.angle + SPEED)
    out none
}

skill stop(base, dream) {
    out stage.close_stage(base, dream.set)
}
