use core.str
use os.target.uefi_x86_64.firmware
use os.target.uefi_x86_64.uefi

BOOT_ALLOCATE_POOL = 64
BOOT_EXIT = 216
LOADER_DATA = 2
SCRATCH_POOL = 0

skill finish(text) {
    @base = firmware.guest_base()
    @services = uefi.boot_services(base)
    @size = str.len(text) + 2
    @pool_at = firmware.scratch(base, SCRATCH_POOL)
    @got = firmware.call(base, firmware.pointer(services, base, BOOT_ALLOCATE_POOL), [firmware.number(LOADER_DATA), firmware.number(size), pool_at])
    (got.failed == yes) { out error.MemoryExhausted }
    @data = firmware.pointer(pool_at, base, 0)
    firmware.write16(data, base, 0, 0)
    drum (str.len(text)) { firmware.write8(data, base, 2 + beat, str.byte(text, beat)) }
    out firmware.call(base, firmware.pointer(services, base, BOOT_EXIT), [firmware.image_handle(), firmware.number(0), firmware.number(size), data])
}
