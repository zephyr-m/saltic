use io
use core.num
use core.str
use core.group
use os.target.uefi_x86_64.firmware
use os.target.uefi_x86_64.pci
use os.target.uefi_x86_64.rtl8111
use os.target.uefi_x86_64.net
use os.target.uefi_x86_64.uefi
use os.target.uefi_x86_64.graphics
use os.target.uefi_x86_64.lettering
use os.target.uefi_x86_64.files
use os.target.uefi_x86_64.disk

PORT = 5555
DATA_PORT = 5556
UPLOAD_OFFSET = 65536
UPLOAD_LIMIT = 1966080
REPORT_EVERY = 65536
MY_IP = [10, 0, 0, 2]
MEMORY_DEFAULT = 16
MEMORY_LIMIT = 64
LISTEN_ROUNDS = 200000000
HELP = "команды: help — эта справка | info — о себе | pci — устройства | mem <адрес hex> [байт, до 64] — память | echo <текст> | upload <байт> — принять программу | check — что принято | run — запустить принятое | screen — проверочная картинка | print <текст> — напечатать своим шрифтом | clear — очистить экран | volumes — файловые системы и их папки EFI (только чтение) | prepare-disk — какой диск будет стёрт; prepare-disk ERASE-ACER-DISK — стереть и разметить | install — записать принятую программу на диск | time — дата и время"

Agent = Box {
    card = rtl8111.Card {},
    frames = 0,
    commands = 0,
    arp = 0,
    expected = 0,
    received = 0,
    total = 0,
    columns = 0,
    rows = 0,
    line = 0,
    cursor = 0,
    console = yes,
    shown_second = -1,
    rounds = 0
}

MARGIN = 40
LINE_GAP = 4
LOG_LIMIT = 150
ZONE_HOURS = 5
MONTH_DAYS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
CLOCK_EVERY = 20000
CLOCK_WIDTH = 160
ERASE_WORD = "ERASE-ACER-DISK"
TOP = 96

skill log(agent, message) {
    (agent.console == yes) { io.show(message) }
    out none
}

skill parse_hex(text) {
    (str.len(text) == 0) { out error.BadAddress }
    (str.len(text) > 8) { out error.BadAddress }
    @hi = 0
    @lo = 0
    drum (str.len(text)) {
        @digit = num.hex_value(str.get(text, beat))
        (digit < 0) { out error.BadAddress }
        hi = hi * 16 + lo / 4096
        lo = num.mod(lo, 4096) * 16 + digit
    }
    out firmware.Phys { hi = hi, lo = lo }
}

skill parse_count(text) {
    @value = 0
    drum (str.len(text)) {
        @ch = str.get(text, beat)
        (str.is_digit(ch) == no) { out MEMORY_DEFAULT }
        value = value * 10 + num.digit(ch)
    }
    (value < 1) { out MEMORY_DEFAULT }
    (value > MEMORY_LIMIT) { out MEMORY_LIMIT }
    out value
}

skill parse_size(text) {
    @value = 0
    drum (str.len(text)) {
        @ch = str.get(text, beat)
        (str.is_digit(ch) == no) { out 0 }
        value = value * 10 + num.digit(ch)
    }
    out value
}

skill begin_upload(agent, words) {
    (group.count(words) < 2) { out "как: upload <байт>" }
    @size = parse_size(group.get(words, 1))
    (size < 1) { out "плохой размер" }
    (size > UPLOAD_LIMIT) { out "слишком много: предел {UPLOAD_LIMIT} байт" }
    agent.expected = size
    agent.received = 0
    agent.total = 0
    log(agent, "upload: waiting for {size} bytes on port 5556")
    out "жду {size} байт на порту 5556"
}

skill upload_state(agent) {
    @received = agent.received
    @expected = agent.expected
    @total = agent.total
    out "принято {received} из {expected} байт, сумма {total}"
}

skill launch(agent) {
    (agent.expected == 0) { out "ничего не принято" }
    ((agent.received == agent.expected) == no) { out str.add("приём не закончен: ", upload_state(agent)) }
    @size = agent.expected
    log(agent, "run: starting uploaded image, {size} bytes")
    @outcome = uefi.start_image(agent.card.base, firmware.add(agent.card.arena, UPLOAD_OFFSET), size)
    @code = outcome.value.lo
    @status = "{code}"
    (outcome.failed == yes) { status = "ошибка прошивки {code}" }
    log(agent, "run: image returned")
    rtl8111.configure(agent.card)
    rtl8111.wait_link(agent.card)
    log(agent, "run: card configured again, listening")
    out "программа закончила работу, статус {status}"
}

skill memory_dump(agent, words) {
    (group.count(words) < 2) { out "как: mem <адрес hex> [байт]" }
    @at = parse_hex(group.get(words, 1)) rescue |err| { out "плохой адрес: {err}" }
    @count = MEMORY_DEFAULT
    (group.count(words) > 2) { count = parse_count(group.get(words, 2)) }
    @dump = []
    @row = ""
    drum (count) {
        (num.mod(beat, 16) == 0) {
            (beat > 0) { dump = group.add(dump, row) }
            @where = firmware.phys_text(firmware.add(at, beat))
            row = "{where}:"
        }
        @value = firmware.hex(firmware.read8(at, agent.card.base, beat), 2)
        row = "{row} {value}"
    }
    dump = group.add(dump, row)
    out str.join(dump, "\n")
}

skill link_russian(status) {
    (rtl8111.has_bit(status, rtl8111.PHY_LINK) == no) { out "нет" }
    @speed = "?"
    (rtl8111.has_bit(status, rtl8111.PHY_10) == yes) { speed = "10" }
    (rtl8111.has_bit(status, rtl8111.PHY_100) == yes) { speed = "100" }
    (rtl8111.has_bit(status, rtl8111.PHY_1000) == yes) { speed = "1000" }
    @duplex = "полудуплекс"
    (rtl8111.has_bit(status, rtl8111.PHY_FULL_DUPLEX) == yes) { duplex = "полный дуплекс" }
    out "есть, {speed} Мбит/с, {duplex}"
}

skill information(agent) {
    @mac = net.mac_text(agent.card.mac)
    @ip = net.ip_text(MY_IP)
    @arena = firmware.phys_text(agent.card.arena)
    @link = link_russian(rtl8111.status(agent.card))
    @frames = agent.frames
    @commands = agent.commands
    @arp = agent.arp
    @columns = agent.columns
    @rows = agent.rows
    out "агент Saltic на Acer Aspire E5-575G\nmac {mac}, ip {ip}, udp-порт 5555\nлинк {link}\nарена DMA {arena}\nкадров {frames}, команд {commands}, ответов ARP {arp}\nэкран {columns} × {rows} символов"
}

skill draw_test(agent) {
    @screen = graphics.open(agent.card.base)
    @gray = graphics.color(screen, 161, 161, 170)
    @left = (screen.width - 400) / 2
    @top = (screen.height - 260) / 2
    graphics.fill(screen, left - 4, top - 4, 408, 208, graphics.color(screen, 250, 250, 250))
    graphics.fill(screen, left, top, 400, 200, gray)
    graphics.fill(screen, left, top + 220, 120, 40, graphics.color(screen, 239, 68, 68))
    graphics.fill(screen, left + 140, top + 220, 120, 40, graphics.color(screen, 34, 197, 94))
    graphics.fill(screen, left + 280, top + 220, 120, 40, graphics.color(screen, 59, 130, 246))
    @width = screen.width
    @height = screen.height
    @stride = screen.stride
    @format = graphics.format_name(screen)
    @frame = firmware.phys_text(screen.frame)
    out "графика: {width} × {height}, формат {format}, строка {stride} пикселей, кадр по адресу {frame}\nнарисовал серый прямоугольник 400 × 200 и красный, зелёный, синий квадраты"
}

skill paper(screen) {
    out graphics.color(screen, 250, 250, 250)
}

skill ink(screen) {
    out graphics.color(screen, 24, 24, 27)
}

skill clear_screen(agent) {
    @screen = graphics.open(agent.card.base)
    graphics.fill(screen, 0, 0, screen.width, screen.height, paper(screen))
    lettering.paint_text(screen, lettering.FACE_TITLE, MARGIN, 32, "Saltic - агент на Acer", ink(screen))
    graphics.fill(screen, MARGIN, 76, screen.width - MARGIN * 2, 1, graphics.color(screen, 228, 228, 231))
    agent.line = 0
    agent.cursor = TOP
    agent.console = no
    out "экран очищен"
}

skill faint(screen) {
    out graphics.color(screen, 113, 113, 122)
}

skill next_row(agent, screen, face) {
    (agent.cursor + face.height > screen.height - 16) {
        graphics.fill(screen, 0, TOP - 8, screen.width, screen.height - TOP + 8, paper(screen))
        agent.cursor = TOP
    }
    @y = agent.cursor
    agent.cursor = agent.cursor + face.height + LINE_GAP
    out y
}

skill print_line(agent, line_bytes) {
    @screen = graphics.open(agent.card.base)
    @face = lettering.FACE_TEXT
    lettering.paint_bytes(screen, face, MARGIN, next_row(agent, screen, face), line_bytes, ink(screen))
    agent.line = agent.line + 1
    out "напечатал строку {agent.line}"
}

skill journal(agent, who, payload) {
    (agent.console == yes) { out none }
    @screen = graphics.open(agent.card.base)
    @face = lettering.FACE_SMALL
    @clock = clock_text(local_time(uefi.now(agent.card.base)))
    @prefix = "{clock}  {who}  "
    @bytes = []
    drum (str.len(prefix)) { bytes = group.add(bytes, str.byte(prefix, beat)) }
    @shown = group.count(payload)
    (shown > LOG_LIMIT) { shown = LOG_LIMIT }
    bytes = group.concat(bytes, group.slice(payload, 0, shown))
    lettering.paint_bytes(screen, face, MARGIN, next_row(agent, screen, face), bytes, faint(screen))
    out none
}

skill prepare_disk(agent, words) {
    @base = agent.card.base
    @target = disk.find_target(base, files.handles_with(base, files.BY_PROTOCOL, files.BLOCK_IO_GUID), files.BLOCK_IO_GUID)
    @size = target.megabytes
    (group.count(words) < 2) { out "будет стёрт целый несъёмный диск, около {size} МБ. Чтобы стереть и разметить: prepare-disk {ERASE_WORD}" }
    ((group.get(words, 1) == ERASE_WORD) == no) { out "кодовое слово не то, ничего не записано" }
    log(agent, "disk: erasing {size} MB disk, writing GPT")
    disk.write_table(base, target)
    log(agent, "disk: writing FAT32")
    disk.write_fat(base, target)
    disk.reconnect(base, target)
    out str.add("диск размечен: GPT, раздел EFI 512 МБ, FAT32 'SALTIC'\n", files.report(base))
}

skill install_image(agent) {
    (agent.expected == 0) { out "сначала upload программы" }
    ((agent.received == agent.expected) == no) { out str.add("приём не закончен: ", upload_state(agent)) }
    @written = files.install(agent.card.base, firmware.add(agent.card.arena, UPLOAD_OFFSET), agent.expected)
    out "записал \\EFI\\BOOT\\BOOTX64.EFI на том SALTIC: {written} байт"
}

skill two(value) {
    (value < 10) { out "0{value}" }
    out "{value}"
}

skill local_time(moment) {
    moment.hour = moment.hour + ZONE_HOURS
    (moment.hour > 23) {
        moment.hour = moment.hour - 24
        moment.day = moment.day + 1
        @days = group.get(MONTH_DAYS, moment.month - 1)
        (moment.month == 2) {
            (num.mod(moment.year, 4) == 0) { days = 29 }
        }
        (moment.day > days) {
            moment.day = 1
            moment.month = moment.month + 1
            (moment.month > 12) {
                moment.month = 1
                moment.year = moment.year + 1
            }
        }
    }
    out moment
}

skill clock_text(moment) {
    @hours = two(moment.hour)
    @minutes = two(moment.minute)
    @seconds = two(moment.second)
    out "{hours}:{minutes}:{seconds}"
}

skill date_text(moment) {
    @day = two(moment.day)
    @month = two(moment.month)
    @year = moment.year
    out "{day}.{month}.{year}"
}

skill draw_clock(agent) {
    @moment = local_time(uefi.now(agent.card.base))
    (moment.second == agent.shown_second) { out agent }
    agent.shown_second = moment.second
    @screen = graphics.open(agent.card.base)
    @left = screen.width - MARGIN - CLOCK_WIDTH
    graphics.fill(screen, left, 32, CLOCK_WIDTH, 32, paper(screen))
    lettering.paint_text(screen, lettering.FACE_TITLE, left + 16, 32, clock_text(moment), ink(screen))
    out agent
}

skill time_reply(agent) {
    @moment = local_time(uefi.now(agent.card.base))
    @clock = clock_text(moment)
    @date = date_text(moment)
    out "{date} {clock} (UTC+5, по часам ноутбука)"
}

skill device_list(agent) {
    @base = agent.card.base
    out str.join(pci.device_lines(base, firmware.ecam(base)), "\n")
}

skill execute(agent, text, payload) {
    @words = str.split(text, " ")
    @name = group.get(words, 0)
    (name == "help") { out HELP }
    (name == "info") { out information(agent) }
    (name == "pci") { out device_list(agent) }
    (name == "mem") { out memory_dump(agent, words) }
    (name == "echo") { out str.slice(text, 4, str.len(text)) }
    (name == "upload") { out begin_upload(agent, words) }
    (name == "check") { out upload_state(agent) }
    (name == "run") { out launch(agent) }
    (name == "screen") { out draw_test(agent) }
    (name == "clear") { out clear_screen(agent) }
    (name == "volumes") { out files.report(agent.card.base) }
    (name == "time") { out time_reply(agent) }
    (name == "prepare-disk") { out prepare_disk(agent, words) }
    (name == "install") { out install_image(agent) }
    (name == "print") { out print_line(agent, group.slice(payload, 6, group.count(payload))) }
    out "не знаю команду '{name}'. {HELP}"
}

skill answer(agent, bytes) {
    @packet = net.udp(bytes)
    @who = net.ip_text(packet.from_ip)
    @command = packet.text
    log(agent, "command from {who}: {command}")
    journal(agent, who, packet.payload)
    @reply = execute(agent, command, packet.payload) rescue |err| { "ошибка: {err}" }
    @frame = net.udp_frame(agent.card.mac, MY_IP, packet.from_mac, packet.from_ip, PORT, packet.from_port, reply)
    @sent = rtl8111.send(agent.card, frame)
    log(agent, "  replied {sent} bytes")
    agent.commands = agent.commands + 1
    out agent
}

skill store_chunk(agent, bytes) {
    @offset = net.word(bytes, 42) * 65536 + net.word(bytes, 44)
    @size = net.word(bytes, 38) - 12
    (size > group.count(bytes) - 46) { size = group.count(bytes) - 46 }
    (agent.expected > 0) {
        (offset == agent.received) {
            (offset + size > agent.expected) { size = agent.expected - offset }
            drum (size) {
                @value = group.get(bytes, 46 + beat)
                firmware.write8(agent.card.arena, agent.card.base, UPLOAD_OFFSET + offset + beat, value)
                agent.total = num.mod(agent.total + value, 65536)
            }
            agent.received = offset + size
            (num.mod(agent.received, REPORT_EVERY) < size) {
                @received = agent.received
                @expected = agent.expected
                log(agent, "upload: {received} of {expected} bytes")
            }
        }
    }
    @reply = "ok {agent.received}"
    @to_mac = net.slice_bytes(bytes, 6, 6)
    @to_ip = net.slice_bytes(bytes, 26, 4)
    rtl8111.send(agent.card, net.udp_frame(agent.card.mac, MY_IP, to_mac, to_ip, DATA_PORT, net.word(bytes, 34), reply))
    out agent
}

skill handle(agent, bytes) {
    agent.frames = agent.frames + 1
    (net.is_arp_request_for(bytes, MY_IP) == yes) {
        rtl8111.send(agent.card, net.arp_reply(agent.card.mac, MY_IP, bytes))
        agent.arp = agent.arp + 1
        @asker = net.ip_text(net.slice_bytes(bytes, 28, 4))
        log(agent, "arp: told {asker} that 10.0.0.2 is us")
        out agent
    }
    (net.is_udp_to(bytes, PORT) == yes) { out answer(agent, bytes) }
    (net.is_udp_to(bytes, DATA_PORT) == yes) { out store_chunk(agent, bytes) }
    out agent
}

skill serve(agent) {
    drum (LISTEN_ROUNDS) {
        drum (rtl8111.RX_COUNT) {
            (rtl8111.received(agent.card, beat) == yes) {
                @bytes = rtl8111.read_frame(agent.card, beat)
                rtl8111.release(agent.card, beat)
                agent = handle(agent, bytes)
            }
        }
        agent.rounds = agent.rounds + 1
        (agent.rounds == CLOCK_EVERY) {
            agent.rounds = 0
            (agent.console == no) { agent = draw_clock(agent) }
        }
    }
    out agent
}

skill run() {
    @screen = uefi.wide_console(firmware.guest_base())
    @columns = screen.columns
    @rows = screen.rows
    io.show("Saltic agent: screen {columns} x {rows} characters")
    @card = rtl8111.open()
    @mac = net.mac_text(card.mac)
    io.show("[1] card {mac}")
    rtl8111.configure(card)
    io.show("[2] card configured, waiting for link...")
    @link = rtl8111.wait_link(card)
    io.show("[3] link {link}")
    @hello = net.udp_frame(card.mac, MY_IP, net.BROADCAST_MAC, [255, 255, 255, 255], PORT, PORT, "агент Saltic слушает 10.0.0.2:5555, скажи help")
    rtl8111.send(card, hello)
    io.show("[4] listening on 10.0.0.2:5555 (arp + udp commands)")
    io.show("")
    @agent = Agent { card = card, columns = columns, rows = rows }
    clear_screen(agent)
    serve(agent)
    out none
}

program() {
    io.show("Saltic agent: commands over the network")
    @done = run() rescue |err| {
        io.show("FAILED: ", err)
        none
    }
    io.show("")
    io.show("This program never exits. Turn the laptop off when done.")
    drum (200000000) {
        @key = io.key()
    }
}
