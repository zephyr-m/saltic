use io
use core.num
use core.str
use core.group
use core.mem
use os.target.uefi_x86_64.firmware
use os.target.uefi_x86_64.pci
use os.target.uefi_x86_64.rtl8111
use os.target.uefi_x86_64.net
use os.target.uefi_x86_64.uefi
use os.target.uefi_x86_64.graphics
use os.target.uefi_x86_64.lettering
use os.target.uefi_x86_64.files
use os.target.uefi_x86_64.disk
use os.target.uefi_x86_64.clock
use os.target.uefi_x86_64.parse
use os.target.uefi_x86_64.spider
use os.target.uefi_x86_64.usb
use os.target.uefi_x86_64.feed
use os.target.uefi_x86_64.camera
use os.target.uefi_x86_64.shot
use os.target.uefi_x86_64.reply
use os.target.uefi_x86_64.programs
use os.target.uefi_x86_64.shelf

VERSION = 8
KEY_EVERY = 256
ENTER = 13
SCAN_RIGHT = 3
SCAN_LEFT = 4
REPLY_LIMIT = 1400
PORT = 5555
DATA_PORT = 5556
UPLOAD_OFFSET = 65536
UPLOAD_LIMIT = 33554432
ARENA_LIMIT = 1966080
UPLOAD_PAGES = 8192
REPORT_EVERY = 32768
BAR_HEIGHT = 16
MY_IP = [10, 0, 0, 2]
LISTEN_ROUNDS = 200000000
HELP = "команды: help — эта справка | info — о себе | pci — устройства | mem <адрес hex> [байт, до 64] — память | echo <текст> | upload <байт> — принять программу | check — что принято | run — запустить принятое | screen — проверочная картинка | print <текст> — напечатать своим шрифтом | clear — очистить экран (после run экран у программы, лента молчит до clear) | volumes — файловые системы и их папки EFI (только чтение) | prepare-disk — какой диск будет стёрт; prepare-disk ERASE-ACER-DISK — стереть и разметить | install — записать принятую программу на диск | usb — устройства USB | camera — что умеет камера | code <текст> — показать кусок кода | keep <имя> — сохранить принятую программу на диск, она появится в панели (Enter — открыть) | time — дата и время | reboot — перезагрузить ноутбук | shot — снимок экрана (забирает tools/shot.py)"

Agent = Box {
    card = rtl8111.Card {},
    frames = 0,
    commands = 0,
    arp = 0,
    expected = 0,
    received = 0,
    total = 0,
    columns = 0,
    rows = 0,
    line = 0,
    cursor = 0,
    console = yes,
    shown_second = -1,
    rounds = 0,
    failures = 0,
    last_error = "нет",
    shot_bytes = 0,
    restart = no,
    output = [],
    lent = no,
    bay = firmware.Phys {},
    names = [],
    chosen = 0,
    limit = ARENA_LIMIT
}

COUNTDOWN = 5
SECOND_WAIT = 50000000
SHOT_PREFIX = "shot-part "
CLOCK_EVERY = 20000
ERASE_WORD = "ERASE-ACER-DISK"

skill log(agent, message) {
    (agent.console == yes) { io.show(message) }
    out none
}

skill begin_upload(agent, words) {
    (group.count(words) < 2) { out "как: upload <байт>" }
    @size = parse.parse_size(group.get(words, 1))
    (size < 1) { out "плохой размер" }
    (size > agent.limit) {
        @limit = agent.limit
        out "слишком много: предел {limit} байт"
    }
    agent.expected = size
    agent.received = 0
    agent.total = 0
    log(agent, "upload: waiting for {size} bytes on port 5556")
    out "жду {size} байт на порту 5556"
}

skill upload_state(agent) {
    @received = agent.received
    @expected = agent.expected
    @total = agent.total
    out "принято {received} из {expected} байт, сумма {total}"
}

skill launch(agent) {
    (agent.expected == 0) { out "ничего не принято" }
    ((agent.received == agent.expected) == no) { out str.add("приём не закончен: ", upload_state(agent)) }
    @size = agent.expected
    log(agent, "run: starting uploaded image, {size} bytes")
    @launched = uefi.start_image(agent.card.base, agent.bay, size)
    agent.output = launched.output
    agent.lent = yes
    @outcome = launched.outcome
    @code = outcome.value.lo
    @status = "{code}"
    (outcome.failed == yes) { status = "ошибка прошивки {code}" }
    log(agent, "run: image returned")
    rtl8111.configure(agent.card)
    rtl8111.wait_link(agent.card)
    log(agent, "run: card configured again, listening")
    (outcome.failed == no) {
        (code == reply.HOME) { clear_screen(agent) }
    }
    out "программа закончила работу, статус {status}"
}

skill memory_dump(agent, words) {
    (group.count(words) < 2) { out "как: mem <адрес hex> [байт]" }
    @at = parse.parse_hex(group.get(words, 1)) rescue |err| { out "плохой адрес: {err}" }
    @count = parse.MEMORY_DEFAULT
    (group.count(words) > 2) { count = parse.parse_count(group.get(words, 2)) }
    @dump = []
    @row = ""
    drum (count) {
        (num.mod(beat, 16) == 0) {
            (beat > 0) { dump = group.add(dump, row) }
            @where = firmware.phys_text(firmware.add(at, beat))
            row = "{where}:"
        }
        @value = firmware.hex(firmware.read8(at, agent.card.base, beat), 2)
        row = "{row} {value}"
    }
    dump = group.add(dump, row)
    out str.join(dump, "\n")
}

skill link_russian(status) {
    (rtl8111.has_bit(status, rtl8111.PHY_LINK) == no) { out "нет" }
    @speed = "?"
    (rtl8111.has_bit(status, rtl8111.PHY_10) == yes) { speed = "10" }
    (rtl8111.has_bit(status, rtl8111.PHY_100) == yes) { speed = "100" }
    (rtl8111.has_bit(status, rtl8111.PHY_1000) == yes) { speed = "1000" }
    @duplex = "полудуплекс"
    (rtl8111.has_bit(status, rtl8111.PHY_FULL_DUPLEX) == yes) { duplex = "полный дуплекс" }
    out "есть, {speed} Мбит/с, {duplex}"
}

skill information(agent) {
    @mac = net.mac_text(agent.card.mac)
    @ip = net.ip_text(MY_IP)
    @arena = firmware.phys_text(agent.card.arena)
    @bay = firmware.phys_text(agent.bay)
    @limit = agent.limit
    @link = link_russian(rtl8111.status(agent.card))
    @frames = agent.frames
    @commands = agent.commands
    @arp = agent.arp
    @failures = agent.failures
    @last_error = agent.last_error
    @columns = agent.columns
    @rows = agent.rows
    out "агент Saltic {VERSION} на Acer Aspire E5-575G\nmac {mac}, ip {ip}, udp-порт 5555\nлинк {link}\nарена DMA {arena}, приём программ {bay}, предел {limit} байт\nкадров {frames}, команд {commands}, ответов ARP {arp}\nэкран {columns} × {rows} символов\nсбоев в цикле {failures}, последний: {last_error}"
}

skill draw_test(agent) {
    @screen = graphics.open(agent.card.base)
    @gray = graphics.color(screen, 161, 161, 170)
    @left = (screen.width - 400) / 2
    @top = (screen.height - 260) / 2
    graphics.fill(screen, left - 4, top - 4, 408, 208, graphics.color(screen, 250, 250, 250))
    graphics.fill(screen, left, top, 400, 200, gray)
    graphics.fill(screen, left, top + 220, 120, 40, graphics.color(screen, 239, 68, 68))
    graphics.fill(screen, left + 140, top + 220, 120, 40, graphics.color(screen, 34, 197, 94))
    graphics.fill(screen, left + 280, top + 220, 120, 40, graphics.color(screen, 59, 130, 246))
    @width = screen.width
    @height = screen.height
    @stride = screen.stride
    @format = graphics.format_name(screen)
    @frame = firmware.phys_text(screen.frame)
    out "графика: {width} × {height}, формат {format}, строка {stride} пикселей, кадр по адресу {frame}\nнарисовал серый прямоугольник 400 × 200 и красный, зелёный, синий квадраты"
}

skill clear_screen(agent) {
    @screen = graphics.open(agent.card.base)
    graphics.fill(screen, 0, 0, screen.width, screen.height, feed.paper(screen))
    lettering.paint_text(screen, lettering.FACE_TITLE, feed.MARGIN, 32, "Saltic — агент {VERSION} на Acer", feed.ink(screen))
    graphics.fill(screen, feed.MARGIN, 76, screen.width - feed.MARGIN * 2, 1, graphics.color(screen, 228, 228, 231))
    agent.line = 0
    agent.cursor = feed.TOP
    agent.console = no
    agent.lent = no
    spider.draw(agent.card.base)
    refresh_shelf(agent)
    out "экран очищен"
}

skill refresh_shelf(agent) {
    agent.names = programs.shelf_names(agent.card.base) rescue |err| { [] }
    (agent.chosen > group.count(agent.names) - 1) { agent.chosen = 0 }
    out shelf.draw_shelf(agent.card.base, agent.names, agent.chosen)
}

skill keep_program(agent, words) {
    (group.count(words) < 2) { out "как: keep <имя>" }
    (agent.expected == 0) { out "ничего не принято" }
    @name = group.get(words, 1)
    @written = programs.keep(agent.card.base, agent.bay, agent.expected, name)
    (agent.lent == no) { refresh_shelf(agent) }
    out "сохранил {name}: {written} байт в \\SALTIC\\BIN"
}

skill open_program(agent) {
    (group.count(agent.names) == 0) { out none }
    @name = group.get(agent.names, agent.chosen)
    @size = programs.load(agent.card.base, name, agent.bay, agent.limit)
    agent.expected = size
    agent.received = size
    feed.show_command(agent, "клавиатура", feed.text_bytes("открываю {name}", 64))
    @result = launch(agent)
    out feed.show_reply(agent, feed.text_bytes(result, 200))
}

skill press(agent, key) {
    (key.ready == no) { out none }
    (agent.lent == yes) { out clear_screen(agent) }
    @count = group.count(agent.names)
    (count == 0) { out none }
    (key.scan == SCAN_RIGHT) { agent.chosen = num.mod(agent.chosen + 1, count) }
    (key.scan == SCAN_LEFT) { agent.chosen = num.mod(agent.chosen + count - 1, count) }
    (key.char == ENTER) { out open_program(agent) rescue |err| { feed.show_reply(agent, feed.text_bytes("не открылась: {err}", 200)) } }
    out shelf.draw_shelf(agent.card.base, agent.names, agent.chosen)
}

skill print_line(agent, line_bytes) {
    @screen = graphics.open(agent.card.base)
    @face = lettering.FACE_TEXT
    lettering.paint_bytes(screen, face, feed.MARGIN, feed.next_row(agent, screen, face), line_bytes, feed.ink(screen))
    agent.line = agent.line + 1
    out "напечатал строку {agent.line}"
}

skill prepare_disk(agent, words) {
    @base = agent.card.base
    @target = disk.find_target(base, files.handles_with(base, files.BY_PROTOCOL, files.BLOCK_IO_GUID), files.BLOCK_IO_GUID)
    @size = target.megabytes
    (group.count(words) < 2) { out "будет стёрт целый несъёмный диск, около {size} МБ. Чтобы стереть и разметить: prepare-disk {ERASE_WORD}" }
    ((group.get(words, 1) == ERASE_WORD) == no) { out "кодовое слово не то, ничего не записано" }
    log(agent, "disk: erasing {size} MB disk, writing GPT")
    disk.write_table(base, target)
    log(agent, "disk: writing FAT32")
    disk.write_fat(base, target)
    disk.reconnect(base, target)
    out str.add("диск размечен: GPT, раздел EFI 512 МБ, FAT32 'SALTIC'\n", files.report(base))
}

skill install_image(agent) {
    (agent.expected == 0) { out "сначала upload программы" }
    ((agent.received == agent.expected) == no) { out str.add("приём не закончен: ", upload_state(agent)) }
    @written = files.install(agent.card.base, agent.bay, agent.expected)
    out "записал \\EFI\\BOOT\\BOOTX64.EFI на том SALTIC: {written} байт"
}

skill time_reply(agent) {
    @moment = clock.local_time(uefi.now(agent.card.base))
    @moment_text = clock.clock_text(moment)
    @date = clock.date_text(moment)
    out "{date} {moment_text} (UTC+5, по часам ноутбука)"
}

skill show_code(agent, payload) {
    @lines = feed.split_lines(group.slice(payload, 5, group.count(payload)))
    @count = group.count(lines)
    feed.show_code(agent, group.slice(payload, 5, group.count(payload)))
    out "показал кусок: {count} строк"
}

skill device_list(agent) {
    @base = agent.card.base
    out str.join(pci.device_lines(base, firmware.ecam(base)), "\n")
}

skill execute(agent, text, payload) {
    @words = str.split(text, " ")
    @name = group.get(words, 0)
    (name == "help") { out HELP }
    (name == "info") { out information(agent) }
    (name == "pci") { out device_list(agent) }
    (name == "mem") { out memory_dump(agent, words) }
    (name == "echo") { out str.slice(text, 4, str.len(text)) }
    (name == "upload") { out begin_upload(agent, words) }
    (name == "check") { out upload_state(agent) }
    (name == "run") { out launch(agent) }
    (name == "screen") { out draw_test(agent) }
    (name == "clear") { out clear_screen(agent) }
    (name == "volumes") { out files.report(agent.card.base) }
    (name == "usb") { out usb.report(agent.card.base) }
    (name == "code") { out show_code(agent, payload) }
    (name == "keep") { out keep_program(agent, words) }
    (name == "camera") { out camera.report(agent.card.base) }
    (name == "protocols") { out usb.protocols(agent.card.base, words) }
    (name == "time") { out time_reply(agent) }
    (name == "reboot") { out restart_later(agent) }
    (name == "shot") {
        agent.shot_bytes = shot.capture(agent.card)
        out shot.caption(agent.card, agent.shot_bytes)
    }
    (name == "prepare-disk") { out prepare_disk(agent, words) }
    (name == "install") { out install_image(agent) }
    (name == "print") { out print_line(agent, group.slice(payload, 6, group.count(payload))) }
    out "не знаю команду '{name}'. {HELP}"
}

skill wait_second(base) {
    @first = uefi.now(base)
    drum (SECOND_WAIT) {
        @moment = uefi.now(base)
        ((moment.second == first.second) == no) { out none }
    }
    out none
}

skill countdown(agent, seconds) {
    @base = agent.card.base
    drum (seconds) {
        @left = seconds - beat
        feed.banner(base, "перезагрузка через {left}...")
        wait_second(base)
    }
    feed.banner(base, "перезагружаюсь")
    out none
}

skill restart_later(agent) {
    agent.restart = yes
    out "перезагружаюсь через {COUNTDOWN} секунд"
}

skill answer(agent, bytes) {
    @packet = net.udp(bytes)
    (str.starts_with(packet.text, SHOT_PREFIX) == yes) {
        shot.send_chunk(agent.card, agent.shot_bytes, packet, parse.parse_size(str.slice(packet.text, str.len(SHOT_PREFIX), str.len(packet.text))))
        out agent
    }
    @who = net.ip_text(packet.from_ip)
    @command = packet.text
    log(agent, "command from {who}: {command}")
    feed.show_command(agent, who, packet.payload)
    @said = execute(agent, command, packet.payload) rescue |err| { "ошибка: {err}" }
    @reply_bytes = feed.text_bytes(said, REPLY_LIMIT)
    (group.count(agent.output) > 0) { reply_bytes = group.concat(group.add(reply_bytes, 10), agent.output) }
    agent.output = []
    (group.count(reply_bytes) > REPLY_LIMIT) { reply_bytes = group.slice(reply_bytes, 0, REPLY_LIMIT) }
    feed.show_reply(agent, reply_bytes)
    @frame = net.udp_frame_bytes(agent.card.mac, MY_IP, packet.from_mac, packet.from_ip, PORT, packet.from_port, reply_bytes)
    @sent = rtl8111.send(agent.card, frame)
    log(agent, "  replied {sent} bytes")
    agent.commands = agent.commands + 1
    (agent.restart == yes) {
        countdown(agent, COUNTDOWN)
        uefi.restart(agent.card.base)
    }
    out agent
}

skill draw_progress(agent) {
    (agent.console == yes) { out none }
    (agent.lent == yes) { out none }
    @screen = graphics.open(agent.card.base)
    @width = screen.width - feed.MARGIN * 2
    @top = screen.height - feed.BAR_SPACE
    graphics.fill(screen, 0, top - 24, screen.width, feed.BAR_SPACE + 24, feed.paper(screen))
    @done = agent.received / 1024
    @total = agent.expected / 1024
    @percent = done * 100 / total
    @label = "приём программы: {done} КБ из {total} КБ - {percent} %"
    (agent.received == agent.expected) { label = "программа принята целиком: {total} КБ" }
    lettering.paint_text(screen, lettering.FACE_SMALL, feed.MARGIN, top - 20, label, feed.faint(screen))
    graphics.fill(screen, feed.MARGIN, top, width, BAR_HEIGHT, graphics.color(screen, 228, 228, 231))
    graphics.fill(screen, feed.MARGIN, top, width * percent / 100, BAR_HEIGHT, graphics.color(screen, 24, 24, 27))
    out none
}

skill store_chunk(agent, bytes) {
    @offset = net.word(bytes, 42) * 65536 + net.word(bytes, 44)
    @size = net.word(bytes, 38) - 12
    (size > group.count(bytes) - 46) { size = group.count(bytes) - 46 }
    (agent.expected > 0) {
        (offset == agent.received) {
            (offset + size > agent.expected) { size = agent.expected - offset }
            drum (size) {
                @value = group.get(bytes, 46 + beat)
                firmware.write8(agent.bay, agent.card.base, offset + beat, value)
                agent.total = num.mod(agent.total + value, 65536)
            }
            agent.received = offset + size
            (num.mod(agent.received, REPORT_EVERY) < size) {
                @received = agent.received
                @expected = agent.expected
                log(agent, "upload: {received} of {expected} bytes")
                draw_progress(agent)
            }
            (agent.received == agent.expected) { draw_progress(agent) }
        }
    }
    @said = "ok {agent.received}"
    @to_mac = net.slice_bytes(bytes, 6, 6)
    @to_ip = net.slice_bytes(bytes, 26, 4)
    rtl8111.send(agent.card, net.udp_frame(agent.card.mac, MY_IP, to_mac, to_ip, DATA_PORT, net.word(bytes, 34), said))
    out agent
}

skill handle(agent, bytes) {
    agent.frames = agent.frames + 1
    (net.is_arp_request_for(bytes, MY_IP) == yes) {
        rtl8111.send(agent.card, net.arp_reply(agent.card.mac, MY_IP, bytes))
        agent.arp = agent.arp + 1
        @asker = net.ip_text(net.slice_bytes(bytes, 28, 4))
        log(agent, "arp: told {asker} that 10.0.0.2 is us")
        out agent
    }
    (net.is_udp_to(bytes, PORT) == yes) { out answer(agent, bytes) }
    (net.is_udp_to(bytes, DATA_PORT) == yes) { out store_chunk(agent, bytes) }
    out agent
}

skill tick(agent) {
    drum (rtl8111.RX_COUNT) {
        (rtl8111.received(agent.card, beat) == yes) {
            @bytes = rtl8111.read_frame(agent.card, beat)
            rtl8111.release(agent.card, beat)
            handle(agent, bytes)
        }
    }
    agent.rounds = agent.rounds + 1
    (num.mod(agent.rounds, KEY_EVERY) == 0) { press(agent, uefi.poll_key(agent.card.base, 0)) }
    (agent.rounds == CLOCK_EVERY) {
        agent.rounds = 0
        (agent.console == no) {
            (agent.lent == no) { feed.draw_clock(agent) }
        }
    }
    out none
}

skill last_cry(card, message) {
    feed.banner(card.base, message)
    rtl8111.send(card, net.udp_frame(card.mac, MY_IP, net.BROADCAST_MAC, [255, 255, 255, 255], PORT, PORT, message))
    out none
}

skill survive(agent) {
    tick(agent) rescue |err| {
        agent.failures = agent.failures + 1
        agent.last_error = "{err}"
        feed.banner(agent.card.base, "сбой в цикле: {err} (агент продолжает работу)")
        none
    }
    out none
}

skill serve(agent) {
    drum (LISTEN_ROUNDS) {
        drum (LISTEN_ROUNDS) { survive(agent) }
    }
    out agent
}

skill run() {
    @screen = uefi.wide_console(firmware.guest_base())
    @columns = screen.columns
    @rows = screen.rows
    io.show("Saltic agent: screen {columns} x {rows} characters")
    @card = rtl8111.open()
    @mac = net.mac_text(card.mac)
    io.show("[1] card {mac}")
    rtl8111.configure(card)
    io.show("[2] card configured, waiting for link...")
    @link = rtl8111.wait_link(card)
    io.show("[3] link {link}")
    @hello = net.udp_frame(card.mac, MY_IP, net.BROADCAST_MAC, [255, 255, 255, 255], PORT, PORT, "агент Saltic {VERSION} слушает 10.0.0.2:5555, скажи help")
    rtl8111.send(card, hello)
    io.show("[4] listening on 10.0.0.2:5555 (arp + udp commands)")
    io.show("")
    @bay = firmware.add(card.arena, UPLOAD_OFFSET)
    @limit = ARENA_LIMIT
    @pages = uefi.pages_below_4g(card.base, UPLOAD_PAGES) rescue |err| { bay }
    ((firmware.phys_text(pages) == firmware.phys_text(bay)) == no) {
        bay = pages
        limit = UPLOAD_LIMIT
    }
    @where = firmware.phys_text(bay)
    io.show("[5] upload bay {where}, limit {limit} bytes")
    @agent = Agent { card = card, columns = columns, rows = rows, bay = bay, limit = limit }
    clear_screen(agent)
    serve(agent) rescue |err| {
        last_cry(card, "агент остановился: {err}")
        out err
    }
    last_cry(card, "агент остановился: главный цикл закончился")
    out none
}

program() {
    io.show("Saltic agent: commands over the network")
    @done = run() rescue |err| {
        io.show("FAILED: ", err)
        feed.banner(firmware.guest_base(), "агент не запустился: {err}") rescue |again| { none }
        none
    }
    io.show("")
    io.show("This program never exits. Turn the laptop off when done.")
    drum (200000000) {
        @key = io.key()
    }
}
