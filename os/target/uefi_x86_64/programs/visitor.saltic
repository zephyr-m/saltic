use io

program() {
    io.show("")
    io.show("  *** Hello! I am a Saltic program that came over the network. ***")
    io.show("  *** The agent loaded me from its memory and started me.      ***")
    io.show("")
    @x = 0
    drum (30000000) { x = beat }
    io.show("  visitor: done, returning to the agent")
    out none
}
