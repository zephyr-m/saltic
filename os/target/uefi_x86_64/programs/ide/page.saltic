-- page — страница Saltic IDE из четырёх атомов (jtml/atom), светлая тема: шапка,
-- полоса значков, проводник, вкладки и редактор с подсветкой (ide/syntax),
-- миникарта, структура, проблемы и изменения, терминал, строка состояния.
-- Логики нет — только вид; редактор показывает ide/code.
--
-- tree() -> atom.Node корня
-- Внутри: say(text, tone) — текст; boxed(flow, size, padding, gap, border,
--     tone, grow, kids) — box; title, activity, explorer, editor, minimap,
--     outline, terminal, status — куски страницы

use core.str
use core.group
use os.ui.jtml.atom
use os.target.uefi_x86_64.programs.ide.code
use os.target.uefi_x86_64.programs.ide.syntax

SHOWN = 31
CURRENT = 28
EXPLORER = [[0, "v saltic", ""], [1, "> .archive", "quiet"], [1, "> bootstrap", ""], [1, "> docs", ""], [1, "v os", ""], [2, "> apps", ""], [2, "> drivers", ""], [2, "v target", ""], [3, "> qemu_virt", ""], [3, "v uefi_x86_64", ""], [4, "> agent", ""], [4, "> drivers", ""], [4, "> network", ""], [4, "> platform", ""], [4, "v programs", ""], [5, "> clay", ""], [5, "> exchange", ""], [5, "> ide", "up"], [5, "> nodus", ""], [5, "clay.saltic", ""], [5, "exchange.saltic", "select"], [5, "ide.saltic", "up"], [5, "nodus.saltic", ""], [4, "> screen", ""], [4, "agent.saltic", ""], [2, "v ui", ""], [3, "> jtml", ""], [3, "jtml.saltic", ""], [1, "> soul", ""], [1, "> tests", ""], [1, "> workbench", ""]]
TABS = ["exchange.saltic", "page.saltic", "atoms.saltic", "jtml.saltic", "atom.saltic"]
SKILLS = [["B", "Desk"], ["s", "moment"], ["s", "type"], ["s", "steer"], ["s", "show"], ["s", "group_id"], ["s", "program"], ["C", "PAUSE"], ["C", "SCAN_RIGHT"], ["C", "SCAN_LEFT"], ["C", "TAB"], ["C", "FIELD_LIMIT"]]
CHANGES = [["M", "exchange.saltic", "accent"], ["A", "exchange/page.saltic", "up"], ["A", "screen/atoms.saltic", "up"], ["M", "os/ui/jtml.saltic", "accent"], ["A", "os/ui/jtml/atom.saltic", "up"], ["D", "uiengine/jtml/reader.saltic", "down"]]
TERMINAL = [["$ ", "up", "bootstrap/saltic os/target/uefi_x86_64/programs/exchange.saltic exchange.efi 67108864 x86_64-uefi"], ["", "quiet", "toolchain: пишу родной x86-64 .cache/build/lens/exchange.efi"], ["$ ", "up", "lens check os/target/uefi_x86_64/programs/exchange.saltic"], ["", "up", "ok"], ["$ ", "up", "acer upload exchange.efi --run"], ["", "quiet", "передано 2 103 296 байт за 2.1 с, повторов 0 · сумма 11387 совпала"]]

skill say(text, tone) {
    @node = atom.text(text)
    node.tone = tone
    out node
}

skill boxed(flow, size, padding, gap, border, tone, grow, kids) {
    @node = atom.frame(flow, group.get(size, 0), group.get(size, 1), grow, padding, gap, border, kids)
    node.tone = tone
    out node
}

skill spacer() {
    out atom.space(1)
}

skill title() {
    @dots = boxed(atom.Flow.ROW, [0, 0], 0, 6, 0, "", 0, [boxed(atom.Flow.ROW, [10, 10], 0, 0, 5, "down", 0, []), boxed(atom.Flow.ROW, [10, 10], 0, 0, 5, "accent", 0, []), boxed(atom.Flow.ROW, [10, 10], 0, 0, 5, "up", 0, [])])
    out boxed(atom.Flow.ROW, [0, 28], 6, 16, 0, "panel", 0, [dots, say("Saltic IDE — saltic / os / target / uefi_x86_64 / programs / exchange.saltic", "quiet"), spacer(), say("ветка master", "info"), say("не запушено 7", "accent")])
}

skill icon(letter, active) {
    (active == yes) { out boxed(atom.Flow.ROW, [30, 30], 7, 0, 2, "accent", 0, [say(letter, "ground")]) }
    out boxed(atom.Flow.ROW, [30, 30], 7, 0, 1, "", 0, [say(letter, "quiet")])
}

skill activity() {
    out boxed(atom.Flow.COLUMN, [44, 0], 7, 10, 0, "panel", 0, [icon("Ф", yes), icon("П", no), icon("G", no), icon("З", no), icon("Р", no), spacer(), icon("Н", no)])
}

skill indent(depth) {
    @text = ""
    drum (depth) { text = str.concat(text, "  ") }
    out text
}

skill explorer() {
    @rows = [say("ПРОВОДНИК", "quiet")]
    drum (EXPLORER) {
        @depth = group.get(beat, 0)
        @label = group.get(beat, 1)
        @tone = group.get(beat, 2)
        @shown = say(str.concat(indent(depth), label), tone)
        (tone == "select") {
            shown = say(str.concat(indent(depth), label), "info")
            rows = group.add(rows, boxed(atom.Flow.ROW, [0, 0], 0, 0, 0, "select", 0, [shown]))
        }
        ((tone == "select") == no) { rows = group.add(rows, shown) }
    }
    out boxed(atom.Flow.COLUMN, [236, 0], 8, 1, 0, "panel", 0, rows)
}

skill tab(name, active) {
    (active == yes) { out boxed(atom.Flow.ROW, [0, 30], 8, 8, 0, "ground", 0, [say(name, ""), say("x", "quiet")]) }
    out boxed(atom.Flow.ROW, [0, 30], 8, 8, 0, "panel", 0, [say(name, "quiet")])
}

skill editor() {
    @tabs = []
    drum (TABS) {
        tabs = group.add(tabs, tab(beat, group.count(tabs) == 0))
        tabs = group.add(tabs, boxed(atom.Flow.ROW, [1, 30], 0, 0, 0, "line", 0, []))
    }
    tabs = group.add(tabs, boxed(atom.Flow.ROW, [0, 30], 0, 0, 0, "panel", 1, []))
    @numbers = []
    @lines = []
    drum (SHOWN) {
        @number = code.FIRST + beat
        @tone = "quiet"
        (beat == CURRENT - 1) { tone = "" }
        @shown = atom.label("{number}", atom.Align.END)
        shown.tone = tone
        numbers = group.add(numbers, shown)
        @tokens = syntax.line(group.get(code.CODE, beat))
        (group.count(tokens) == 0) { tokens = [say(" ", "")] }
        @row = boxed(atom.Flow.ROW, [0, 0], 0, 0, 0, "", 0, tokens)
        (beat == CURRENT - 1) { row = boxed(atom.Flow.ROW, [0, 0], 0, 0, 0, "select", 0, tokens) }
        lines = group.add(lines, row)
    }
    @gutter = boxed(atom.Flow.COLUMN, [44, 0], 0, 0, 0, "", 0, numbers)
    @text = boxed(atom.Flow.COLUMN, [0, 0], 0, 0, 0, "", 1, lines)
    @crumbs = boxed(atom.Flow.ROW, [0, 22], 4, 6, 0, "", 0, [say("saltic", "quiet"), say(">", "quiet"), say("os", "quiet"), say(">", "quiet"), say("target", "quiet"), say(">", "quiet"), say("uefi_x86_64", "quiet"), say(">", "quiet"), say("programs", "quiet"), say(">", "quiet"), say("exchange.saltic", ""), say(">", "quiet"), say("Desk", "name")])
    out boxed(atom.Flow.COLUMN, [0, 0], 0, 0, 0, "ground", 1, [boxed(atom.Flow.ROW, [0, 30], 0, 0, 0, "panel", 0, tabs), crumbs, boxed(atom.Flow.ROW, [0, 0], 0, 12, 0, "", 1, [gutter, text])])
}

skill minimap() {
    @bars = []
    drum (120) {
        @line = group.get(code.CODE, beat % group.count(code.CODE))
        @length = str.bytes(line) * 2 / 3
        (length > 52) { length = 52 }
        @tone = "quiet"
        (str.contains(line, "--") == yes) { tone = "comment" }
        (str.contains(line, "skill") == yes) { tone = "keyword" }
        (str.contains(line, "\"") == yes) { tone = "string" }
        @bar = boxed(atom.Flow.ROW, [length, 3], 0, 0, 0, tone, 0, [])
        (length == 0) { bar = boxed(atom.Flow.ROW, [1, 3], 0, 0, 0, "", 0, []) }
        bars = group.add(bars, boxed(atom.Flow.ROW, [0, 3], 0, 0, 0, "", 0, [bar, spacer()]))
    }
    out boxed(atom.Flow.COLUMN, [64, 0], 6, 1, 0, "ground", 0, bars)
}

skill badge(letter, tone) {
    out boxed(atom.Flow.ROW, [18, 18], 4, 0, 1, tone, 0, [say(letter, tone)])
}

skill outline() {
    @rows = [say("СТРУКТУРА", "quiet")]
    drum (SKILLS) {
        @letter = group.get(beat, 0)
        @tone = "keyword"
        (letter == "B") { tone = "name" }
        (letter == "C") { tone = "number" }
        rows = group.add(rows, boxed(atom.Flow.ROW, [0, 0], 0, 8, 0, "", 0, [badge(letter, tone), say(group.get(beat, 1), "")]))
    }
    rows = group.add(rows, boxed(atom.Flow.ROW, [0, 1], 0, 0, 0, "line", 0, []))
    rows = group.add(rows, boxed(atom.Flow.ROW, [0, 0], 0, 8, 0, "", 0, [say("ПРОБЛЕМЫ", "quiet"), badge("2", "accent")]))
    rows = group.add(rows, boxed(atom.Flow.ROW, [0, 0], 0, 8, 0, "", 0, [badge("!", "accent"), say("64:5 строка в долгом Box", "")]))
    rows = group.add(rows, boxed(atom.Flow.ROW, [0, 0], 0, 8, 0, "", 0, [badge("!", "accent"), say("91:12 шаг ползунка", "")]))
    rows = group.add(rows, boxed(atom.Flow.ROW, [0, 1], 0, 0, 0, "line", 0, []))
    rows = group.add(rows, say("ИЗМЕНЕНИЯ", "quiet"))
    drum (CHANGES) {
        @tone = group.get(beat, 2)
        rows = group.add(rows, boxed(atom.Flow.ROW, [0, 0], 0, 8, 0, "", 0, [say(group.get(beat, 0), tone), say(group.get(beat, 1), "")]))
    }
    out boxed(atom.Flow.COLUMN, [236, 0], 8, 5, 0, "panel", 0, rows)
}

skill terminal() {
    @tabs = boxed(atom.Flow.ROW, [0, 0], 0, 20, 0, "", 0, [boxed(atom.Flow.COLUMN, [0, 0], 0, 2, 0, "", 0, [say("ТЕРМИНАЛ", ""), boxed(atom.Flow.ROW, [0, 2], 0, 0, 0, "accent", 0, [])]), say("ВЫВОД", "quiet"), say("ПРОБЛЕМЫ 2", "quiet"), say("LENS", "quiet"), spacer(), say("bash", "quiet"), say("+", "quiet")])
    @rows = [tabs]
    drum (TERMINAL) {
        @prompt = group.get(beat, 0)
        @tone = group.get(beat, 1)
        @text = group.get(beat, 2)
        (str.bytes(prompt) > 0) { rows = group.add(rows, boxed(atom.Flow.ROW, [0, 0], 0, 0, 0, "", 0, [say(prompt, tone), say(text, "")])) }
        (str.bytes(prompt) == 0) { rows = group.add(rows, say(text, tone)) }
    }
    out boxed(atom.Flow.COLUMN, [0, 156], 8, 3, 0, "ground", 0, rows)
}

skill status() {
    out boxed(atom.Flow.ROW, [0, 24], 4, 20, 0, "accent", 0, [say("master", "ground"), say("lens ok", "ground"), say("предупреждений 2", "ground"), spacer(), say("строка 58, столбец 12", "ground"), say("пробелы: 4", "ground"), say("UTF-8", "ground"), say("Saltic 231:66:218", "ground"), say("x86_64-uefi", "ground"), say("Acer 10.0.0.2", "ground")])
}

skill tree() {
    @line = boxed(atom.Flow.ROW, [1, 0], 0, 0, 0, "line", 0, [])
    @body = boxed(atom.Flow.ROW, [0, 0], 0, 0, 0, "", 1, [activity(), explorer(), line, editor(), minimap(), line, outline()])
    @rule = boxed(atom.Flow.ROW, [0, 1], 0, 0, 0, "line", 0, [])
    out boxed(atom.Flow.COLUMN, [0, 0], 0, 0, 0, "ground", 0, [title(), body, rule, terminal(), status()])
}
