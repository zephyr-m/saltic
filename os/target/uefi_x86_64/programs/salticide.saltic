-- salticide — SalticIDE с сайта (docs/site/public/IDE.html) на весь экран Acer:
-- светлая тема 1 автора, страница из четырёх атомов JTML
-- (programs/salticide/page), нарисованная screen/atoms с палитрой
-- palette_site. Логики нет — только вид. Esc — выход; по сети — state, quit,
-- key, shot.
--
-- program() — нарисовать один раз и ждать Esc

use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.uefi
use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.screen.atoms
use os.target.uefi_x86_64.network.reply
use os.target.uefi_x86_64.network.remote
use os.target.uefi_x86_64.programs.salticide.page
use os.ui.jtml

PAUSE = 10000
SCAN_ESCAPE = 23

skill show(base, whole, back) {
    @runtime = jtml.mount(back, atoms.measured(page.tree(), no))
    atoms.draw(back, runtime, atoms.palette_site(whole))
    out graphics.push(base, whole, back)
}

program() {
    @base = firmware.guest_base()
    uefi.forget_keys(base)
    @whole = graphics.open_whole(base)
    @back = graphics.buffer_like(base, whole)
    @link = remote.open_remote() rescue |err| { none }
    (link) |link| {
        remote.own(link, back.frame, graphics.buffer_pages(whole))
        remote.hide_panels(link)
        remote.tell(link, "salticide: SalticIDE с сайта, тема 1")
    }
    show(base, whole, back)
    always {
        (link) |link| {
            drum (remote.serve(link)) { }
        }
        @key = uefi.poll_key(base, PAUSE)
        (key.ready == yes) {
            (key.scan == SCAN_ESCAPE) {
                uefi.free_pages(base, back.frame, graphics.buffer_pages(whole))
                reply.home("salticide: вышла")
                out none
            }
        }
    }
    out none
}
