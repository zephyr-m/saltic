-- page — экран пульта текстом JTML на жителях UIEngine
-- (registry/libraries/uiengine/library): console-deck — шапка strip (название,
-- четыре вида chip, часы), слева console-panel «Сеть» — строки журнала агента
-- (netlog.entries, новые снизу, перенос journal.wrap по ширине моноширинного
-- шрифта), справа console-panel «Система» — Wi-Fi и кабель (link-row), память,
-- диск и куча (gauge), приём и итоги, графики кадров и приёма (graph из bar).
-- Центр пуст (решение автора 16.11.2026: карта мира — потом). Виды — как в
-- docs/site/private/CONSOLE-LOOK.html: Броня, Читать (Броня крупнее), Мягкая,
-- Тихо (Мягкая, где ничего не движется само: часы без секунд).
--
-- Look { name, armor, radius, line, label, small, still } — вид пульта
-- LOOKS — четыре вида по порядку кнопок
-- deck(look, chosen, clock, lines, told) -> текст JTML экрана; lines —
--     netlog.entries, told — system_panel.Facts или none (сети нет)
-- Внутри: text_of(bytes) -> строка; log_panel / system_panel_jtml — панели;
--     gauge_of, graph_of — один прибор; share(part, whole) -> ширина заливки

use core.str
use core.group
use core.bytes
use registry.libraries.uiengine.jtml.calls
use os.target.uefi_x86_64.network.netlog.journal
use os.target.uefi_x86_64.screen.system_panel
use os.target.uefi_x86_64.screen.system_panel.sizes
use os.target.uefi_x86_64.drivers.qca9377.handoff

SIDE = 300
INNER = 270
BARS = 40
BAR_WIDE = 5
GRAPH_HIGH = 52
LOG_HIGH = 640

Look = Box {
    name = "",
    armor = no,
    radius = 14,
    line = 12,
    label = 14,
    small = 12,
    still = no
}

LOOKS = [
    Look { name = "Броня", armor = yes, radius = 0, line = 12, label = 13, small = 11 },
    Look { name = "Читать", armor = yes, radius = 0, line = 15, label = 16, small = 14 },
    Look { name = "Мягкая" },
    Look { name = "Тихо", still = yes }
]

skill text_of(list) {
    @buffer = bytes.new(group.count(list))
    drum (group.count(list)) { bytes.set(buffer, beat, group.get(list, beat)) }
    out str.from_bytes(buffer)
}

skill share(part, whole) {
    (whole < 1) { out 0 }
    out INNER * sizes.percent(part, whole) / 100
}

skill line_tone(kind) {
    (kind == journal.ASK) { out "info" }
    (kind == journal.NOTE) { out "mustard" }
    out "ink"
}

skill log_panel(look, lines) {
    @letters = INNER * 10 / (look.line * 6)
    @room = LOG_HIGH / (look.line + 9)
    @rows = []
    drum (lines) {
        @tone = line_tone(group.get(beat, 0))
        @pieces = journal.wrap(group.get(beat, 1), letters)
        @count = group.count(pieces)
        (group.count(rows) + count > room) { leave }
        drum (count) {
            @piece = group.get(pieces, count - 1 - beat)
            rows = group.add(rows, calls.call("console-line", [["text", calls.quoted(text_of(piece))], ["tone", calls.quoted(tone)], ["size", "{look.line}"]]))
        }
    }
    @shown = []
    drum (group.count(rows)) { shown = group.add(shown, group.get(rows, group.count(rows) - 1 - beat)) }
    (group.count(shown) == 0) { shown = [calls.call("console-line", [["text", calls.quoted("журнал пуст")], ["tone", calls.quoted("quiet")], ["size", "{look.line}"]])] }
    @body = calls.call("stack", [["gap", "3"], ["justify", calls.quoted("end")], ["grow", "1"], ["children", calls.listed(shown)]])
    out calls.call("console-panel", [["title", calls.quoted("Сеть")], ["note", calls.quoted("10.0.0.2:5555")], ["width", "{SIDE}"], ["radius", "{look.radius}"], ["children", calls.listed([body])]])
}

skill gauge_of(look, label, used_kb, total_kb) {
    (total_kb < 1) { out calls.call("gauge", [["label", calls.quoted(label)], ["fill", "0"], ["tone", calls.quoted("accent")], ["text", calls.quoted("нет сведений")], ["size", "{look.label}"], ["small", "{look.small}"]]) }
    @used = sizes.kb_text(used_kb)
    @total = sizes.kb_text(total_kb)
    @part = sizes.percent(used_kb, total_kb)
    @tone = "accent"
    (part > 85) { tone = "down" }
    @fill = share(used_kb, total_kb)
    out calls.call("gauge", [["label", calls.quoted(label)], ["fill", "{fill}"], ["tone", calls.quoted(tone)], ["text", calls.quoted("занято {used} из {total}, {part} %")], ["size", "{look.label}"], ["small", "{look.small}"]])
}

skill graph_of(look, title, values, floor, note, tone) {
    @most = floor
    drum (values) {
        (beat > most) { most = beat }
    }
    @bars = []
    drum (BARS - group.count(values)) { bars = group.add(bars, calls.call("bar", [["width", "{BAR_WIDE}"], ["height", "1"], ["tone", calls.quoted("well")], ["radius", "0"]])) }
    drum (values) {
        @tall = beat * GRAPH_HIGH / most
        (tall < 1) { tall = 1 }
        bars = group.add(bars, calls.call("bar", [["width", "{BAR_WIDE}"], ["height", "{tall}"], ["tone", calls.quoted(tone)], ["radius", "1"]]))
    }
    @scale = "{most}"
    (floor > 100) { scale = sizes.speed_text(most) }
    out calls.call("graph", [["title", calls.quoted(title)], ["bars", calls.listed(bars)], ["note", calls.quoted("{note}, шкала до {scale}")], ["size", "{look.label}"], ["small", "{look.small}"]])
}

skill system_panel_jtml(look, told) {
    (told == none) { out calls.call("console-panel", [["title", calls.quoted("Система")], ["note", calls.quoted("Acer")], ["width", "{SIDE}"], ["radius", "{look.radius}"], ["children", calls.listed([calls.call("label", [["text", calls.quoted("сети нет: ни кабеля, ни Wi-Fi от агента")]])])]]) }
    @wifi_tone = "quiet"
    (told.wifi_step == handoff.CONNECTED) { wifi_tone = "accent" }
    @wifi_text = told.wifi_text
    (str.bytes(wifi_text) == 0) { wifi_text = "выключен" }
    @cable_tone = "quiet"
    (told.linked == yes) { cable_tone = "accent" }
    @last = 0
    (group.count(told.rates) > 0) { last = group.get(told.rates, group.count(told.rates) - 1) }
    @parts = [calls.call("link-row", [["icon", calls.quoted("wifi")], ["tone", calls.quoted(wifi_tone)], ["title", calls.quoted("Wi-Fi")], ["text", calls.quoted(wifi_text)], ["size", "{look.label}"], ["small", "{look.small}"]])]
    parts = group.add(parts, gauge_of(look, "память", told.memory_used * 1024, told.memory_total * 1024))
    parts = group.add(parts, gauge_of(look, "диск Saltic", told.disk_used * 1024, told.disk_total * 1024))
    parts = group.add(parts, gauge_of(look, "куча программы · побеги {told.escapes}", told.heap_used, told.heap_total))
    parts = group.add(parts, calls.call("link-row", [["icon", calls.quoted("ethernet-port")], ["tone", calls.quoted(cable_tone)], ["title", calls.quoted("кабель")], ["text", calls.quoted(told.cable)], ["size", "{look.label}"], ["small", "{look.small}"]]))
    parts = group.add(parts, calls.call("console-line", [["text", calls.quoted("приём {told.incoming} · отправка {told.outgoing}")], ["tone", calls.quoted("quiet")], ["size", "{look.small}"]]))
    parts = group.add(parts, calls.call("console-line", [["text", calls.quoted("всего: принято {told.received}, отправлено {told.sent}")], ["tone", calls.quoted("quiet")], ["size", "{look.small}"]]))
    parts = group.add(parts, graph_of(look, "кадры: {last} в секунду", told.rates, system_panel.FLOOR_RATE, "за {BARS} с", "accent"))
    parts = group.add(parts, graph_of(look, "приём", told.heard, system_panel.FLOOR_BYTES, "за {BARS} с", "up"))
    out calls.call("console-panel", [["title", calls.quoted("Система")], ["note", calls.quoted("Acer · живое")], ["width", "{SIDE}"], ["radius", "{look.radius}"], ["children", calls.listed(parts)]])
}

skill top(look, chosen, clock) {
    @buttons = []
    drum (group.count(LOOKS)) {
        @one = group.get(LOOKS, beat)
        @fill = "panel"
        @tone = "quiet"
        (beat == chosen) {
            fill = "accent"
            tone = "ground"
            (look.armor == no) { fill = "mustard" }
        }
        @number = beat + 1
        buttons = group.add(buttons, calls.call("chip", [["text", calls.quoted("{number} {one.name}")], ["fill", calls.quoted(fill)], ["tone", calls.quoted(tone)]]))
    }
    @title = calls.call("figure", [["text", calls.quoted("Пульт · Saltic")], ["size", "20"], ["tone", calls.quoted("ink")]])
    @looks = calls.call("strip", [["gap", "6"], ["children", calls.listed(buttons)]])
    @time = calls.call("strip", [["gap", "8"], ["children", calls.listed([calls.call("dot", [["tone", calls.quoted("up")]]), calls.call("number", [["text", calls.quoted(clock)], ["tone", calls.quoted("ink")]])])]])
    out calls.call("strip", [["gap", "16"], ["justify", calls.quoted("between")], ["children", calls.listed([title, looks, time])]])
}

skill deck(look, chosen, clock, lines, told) {
    @middle = calls.call("gap", [["grow", "1"]])
    out calls.call("console-deck", [["top", top(look, chosen, clock)], ["left", log_panel(look, lines)], ["middle", middle], ["right", system_panel_jtml(look, told)]])
}
