-- graph — граф Nodus: узлы и связи. Узел — карточка на холсте: заголовок,
-- входы слева, выходы справа, значение внизу; связь — от выхода одного узла
-- ко входу другого. Координаты — точки холста (холст двигается целиком).
-- Пока только вид: значения в примере нарисованы, не посчитаны.
--
-- Node { title, x, y, width, inputs, outputs, value, kind, called } — узел;
--     kind: PLAIN, CURVE (внутри кривая, как у графика), IN и OUT (вход и
--     выход программы: имя — подпись его единственного выхода / входа), CALL
--     (вставленная программа, called — её файл)
-- result, history — посчитанное (nodus/run): текст и точки графика; на диск
--     не пишутся
-- memory — что хранит «регистр» между тактами; picture — точки «экрана»
--     (ряды из 0 и 1); inside — [свой граф] вставленной программы (своя
--     копия: её регистры помнят своё); все три — только в памяти
-- curvy(node) -> yes, если внутри рисуется кривая (вид CURVE или «график»)
-- screen(node) -> yes, если это «экран» (внутри — точки)
-- RING — «кольцо»: круг-область под карточками (x, y — угол квадрата, width —
--     диаметр), подпись — заголовок; портов нет, ничего не считает
-- KINDS — названия видов по номеру: обычный, кривая, вход, выход, программа,
--     кольцо
-- kind_of(text) -> номер вида по названию; NoSuchKind
-- face(nodes_graph) -> [[входы], [выходы]] — подписи узлов IN и OUT по порядку
-- whole(text) -> целое со знаком; NotNumber
-- Link { from, exit, to, entry } — связь: номер узла и номер его выхода →
--     номер узла и номер его входа
-- Graph { nodes, links } — граф
-- HEADER / ROW / FOOTER — высота заголовка, ряда портов, строки значения
-- rows(node) -> рядов портов; height(node) -> высота карточки
-- port_y(node, index) -> высота кружка порта номер index от верха карточки
-- example() -> Graph из рисунка: время → синус → график, 3 и 4 → сложить → показать

use core.str
use core.group

PLAIN = 0
CURVE = 1
IN = 2
OUT = 3
CALL = 4
RING = 5
KINDS = ["обычный", "кривая", "вход", "выход", "программа", "кольцо"]
HEADER = 28
ROW = 22
FOOTER = 30
CURVE_HEIGHT = 60
SCREEN_HEIGHT = 100

Node = Box {
    title = "",
    x = 0,
    y = 0,
    width = 150,
    inputs = [],
    outputs = [],
    value = "",
    kind = PLAIN,
    called = "",
    result = "",
    history = [],
    memory = [],
    picture = [],
    inside = []
}

Link = Box {
    from = 0,
    exit = 0,
    to = 0,
    entry = 0
}

Graph = Box {
    nodes = [],
    links = []
}

skill whole(text) {
    @sign = 1
    @first = 0
    (str.starts_with(text, "-") == yes) {
        sign = -1
        first = 1
    }
    (str.bytes(text) <= first) { out error.NotNumber }
    @made = 0
    drum (str.bytes(text) - first) {
        @letter = str.get(text, first + beat)
        (str.is_digit(letter) == no) { out error.NotNumber }
        made = made * 10 + str.byte(letter, 0) - 48
    }
    out sign * made
}

skill kind_of(text) {
    drum (group.count(KINDS)) {
        (group.get(KINDS, beat) == text) { out beat }
    }
    out error.NoSuchKind
}

skill face(nodes_graph) {
    @inputs = []
    @outputs = []
    drum (nodes_graph.nodes) {
        @node = beat
        (node.kind == IN) {
            (group.count(node.outputs) > 0) { inputs = group.add(inputs, group.get(node.outputs, 0)) }
        }
        (node.kind == OUT) {
            (group.count(node.inputs) > 0) { outputs = group.add(outputs, group.get(node.inputs, 0)) }
        }
    }
    out [inputs, outputs]
}

skill rows(node) {
    @count = group.count(node.inputs)
    (group.count(node.outputs) > count) { count = group.count(node.outputs) }
    out count
}

skill curvy(node) {
    (node.kind == CURVE) { out yes }
    out node.title == "график"
}

skill screen(node) {
    out node.title == "экран"
}

skill height(node) {
    @body = FOOTER
    (curvy(node) == yes) { body = CURVE_HEIGHT }
    (screen(node) == yes) { body = SCREEN_HEIGHT }
    out HEADER + rows(node) * ROW + body + 6
}

skill port_y(node, index) {
    out HEADER + 4 + index * ROW + ROW / 2
}

skill example() {
    @nodes = [
        Node { title = "время", x = 40, y = 40, outputs = ["выход"], value = "12.4 с" },
        Node { title = "синус", x = 270, y = 70, inputs = ["угол"], outputs = ["выход"], value = "= 0.81" },
        Node { title = "график", x = 520, y = 60, width = 200, inputs = ["значение"], kind = CURVE },
        Node { title = "число", x = 40, y = 230, outputs = ["выход"], value = "3" },
        Node { title = "число", x = 40, y = 340, outputs = ["выход"], value = "4" },
        Node { title = "сложить", x = 270, y = 270, inputs = ["а", "б"], outputs = ["выход"], value = "= 7" },
        Node { title = "показать", x = 520, y = 280, width = 200, inputs = ["значение"], value = "7" }
    ]
    @links = [
        Link { from = 0, exit = 0, to = 1, entry = 0 },
        Link { from = 1, exit = 0, to = 2, entry = 0 },
        Link { from = 3, exit = 0, to = 5, entry = 0 },
        Link { from = 4, exit = 0, to = 5, entry = 1 },
        Link { from = 5, exit = 0, to = 6, entry = 0 }
    ]
    out Graph { nodes = nodes, links = links }
}
