-- spider — программа: рисует паучка (screen.spider.draw) и сразу возвращается.
-- Маленькая проба для upload … --run рядом с агентом.
--
-- program() — вход

use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.screen.spider

program() {
    out spider.draw(firmware.guest_base())
}
