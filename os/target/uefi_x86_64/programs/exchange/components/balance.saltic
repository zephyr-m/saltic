-- balance — блок биржи «баланс»: монеты на счёте и сумма в ордерах. Box Balance
-- показывает себя жителем balance.
--
-- Balance { usdt, btc, eth, held } — суммы текстом; jtml() -> текст JTML

use tarantul.uiengine.jtml.calls

Balance = Box {
    usdt = "24 300.00",
    btc = "0.4120",
    eth = "3.200",
    held = "1 200.00 USDT"

    skill jtml() {
        out calls.call("balance", [["usdt", calls.quoted(usdt)], ["btc", calls.quoted(btc)], ["eth", calls.quoted(eth)], ["held", calls.quoted(held)]])
    }
}
