-- market — ненастоящий рынок биржи, общий для всех её блоков: цена ходит
-- случайными шагами от такта, свечи и объём — шум трёх масштабов (крупная
-- волна, средняя, дрожь); деньги и монеты — текстом.
--
-- Market { price, tick } — рынок: цена в центах и такт; step() — такт: цена
--     шагает на шум
-- START — цена открытия в центах
-- level(t) -> 0…1000 — уровень свечи
-- noise(seed) -> 0…999; within(value, least, most) -> value в пределах
-- money(cents) -> «67 412.50»; coins(milli) -> «0.150»; two(value) -> «07»
-- direction(sign) -> "up" / "down"; change_sign(value) -> 1 / -1
-- Внутри: smooth(t, period) — гладкий шум; thousands — разряды через пробел

START = 6741250

Market = Box {
    price = START,
    tick = 0

    skill step() {
        tick = tick + 1
        price = price + noise(tick + 7) - 500
        out none
    }
}

skill within(value, least, most) {
    (value < least) { out least }
    (value > most) { out most }
    out value
}

skill noise(seed) {
    @value = ((seed + 1000000) * 1103515245 + 12345) % 2147483648 / 65536 % 1000
    (value < 0) { out -value }
    out value
}

skill smooth(t, period) {
    @from = noise(t / period * 7919)
    @to = noise((t / period + 1) * 7919)
    out from + (to - from) * (t % period) / period
}

skill level(t) {
    out (smooth(t, 16) * 6 + smooth(t, 4) * 3 + noise(t) * 1) / 10
}

skill two(value) {
    (value < 10) { out "0{value}" }
    out "{value}"
}

skill thousands(value) {
    (value < 1000) { out "{value}" }
    @high = thousands(value / 1000)
    @low = value % 1000
    @pad = "{low}"
    (low < 100) { pad = "0{pad}" }
    (low < 10) { pad = "0{pad}" }
    out "{high} {pad}"
}

skill money(cents) {
    @whole = thousands(cents / 100)
    @part = two(cents % 100)
    out "{whole}.{part}"
}

skill coins(milli) {
    @whole = milli / 1000
    @part = milli % 1000
    @pad = "{part}"
    (part < 100) { pad = "0{pad}" }
    (part < 10) { pad = "0{pad}" }
    out "{whole}.{pad}"
}

skill change_sign(value) {
    (value < 0) { out -1 }
    out 1
}

skill direction(sign) {
    (sign < 0) { out "down" }
    out "up"
}
