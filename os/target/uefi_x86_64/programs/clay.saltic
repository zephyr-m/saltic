-- clay — программа «Пластилин»: игрушечная полянка из скруглённых тел —
-- холмы, пруд, деревья, камни, домики, цветы, снеговик или тыквы по
-- времени года; каждый запуск полянка новая, мягкий пластилиновый свет и
-- тени-кляксы (screen/clay/{mesh,forms,scene}).
-- Камера облетает полянку, кадр рисует screen/clay/stage. Стрелки ← → —
-- облёт и его скорость, ↑ ↓ — выше и ниже, пробел — пауза, R — новая
-- полянка (сама — каждые RENEW секунд), V — vsync вкл/выкл
-- (60 кадров без разрывов или сколько выжмет видеокарта), Esc — назад; по
-- сети — quit, state, key, shot. Только x86_64-uefi.
--
-- Orbit { angle, speed, lift, paused, quit, frames, counted, rate, vsync,
--     remake, made, last, measured, slow, longest } — slow — кадров дольше
--     SLOW обновлений экрана, longest — самый долгий — время — в кадрах экрана (stage.ticks,
--     HZ в секунду): камера сдвигается на столько, сколько кадров экрана
--     прошло, поэтому пропущенный кадр не даёт рывка; часы прошивки в кадре
--     не спрашиваются
-- steer(orbit, key) / count_rate(orbit, base) / tick(set, orbit, base, link)
-- broken(set, orbit, base, link, problem) — ошибка кадра на экран и в state
-- program() — вход

use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.uefi
use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.network.reply
use os.target.uefi_x86_64.network.remote
use os.target.uefi_x86_64.screen.clay.forms
use os.target.uefi_x86_64.screen.clay.stage
use os.target.uefi_x86_64.screen.clay.season
use os.uiengine.canvas
use os.uiengine.fonts

LIFT = 380
LIFT_STEP = 40
SPEED = 600
SPEED_STEP = 300
PAUSE = 1000
SCAN_UP = 1
SCAN_DOWN = 2
SCAN_RIGHT = 3
SCAN_LEFT = 4
SCAN_ESCAPE = 23
SPACE = 32
LETTER_V = 118
LETTER_V_UPPER = 86
LETTER_R = 114
LETTER_R_UPPER = 82
RENEW = 60
HZ = 60
WRAP = 4294967296
MOST_STEP = 4
SLOW = 3

Orbit = Box {
    angle = 0,
    speed = SPEED,
    lift = LIFT,
    paused = no,
    quit = no,
    frames = 0,
    counted = 0,
    rate = 0,
    vsync = yes,
    remake = no,
    made = 0,
    last = -1,
    measured = 0,
    slow = 0,
    longest = 0
}

skill steer(orbit, key) {
    (key.scan == SCAN_ESCAPE) { orbit.quit = yes }
    (key.scan == SCAN_LEFT) { orbit.speed = orbit.speed - SPEED_STEP }
    (key.scan == SCAN_RIGHT) { orbit.speed = orbit.speed + SPEED_STEP }
    (key.scan == SCAN_UP) { orbit.lift = orbit.lift + LIFT_STEP }
    (key.scan == SCAN_DOWN) { orbit.lift = orbit.lift - LIFT_STEP }
    (orbit.lift < 160) { orbit.lift = 160 }
    (orbit.lift > 1400) { orbit.lift = 1400 }
    (key.char == SPACE) { orbit.paused = orbit.paused == no }
    (key.char == LETTER_V) { orbit.vsync = orbit.vsync == no }
    (key.char == LETTER_V_UPPER) { orbit.vsync = orbit.vsync == no }
    (key.char == LETTER_R) { orbit.remake = yes }
    (key.char == LETTER_R_UPPER) { orbit.remake = yes }
    out none
}

skill clock(set, base) {
    @now = stage.ticks(set)
    (now >= 0) { out now }
    out stage.moment(base) * HZ
}

skill since(now, then) {
    out (now - then + WRAP) % WRAP
}

skill count_rate(orbit, now) {
    orbit.frames = orbit.frames + 1
    orbit.counted = orbit.counted + 1
    @spent = since(now, orbit.measured)
    (spent >= HZ) {
        orbit.rate = orbit.counted * HZ / spent
        orbit.counted = 0
        orbit.measured = now
    }
    out none
}

skill step(set, orbit) {
    @now = stage.ticks(set)
    (now < 0) { out 2 }
    @passed = 2
    (orbit.last >= 0) { passed = since(now, orbit.last) }
    orbit.last = now
    (passed >= SLOW) { orbit.slow = orbit.slow + 1 }
    (passed > orbit.longest) { orbit.longest = passed }
    (passed > MOST_STEP) { out MOST_STEP }
    out passed
}

skill tick(set, orbit, base, link) {
    remote.serve(link)
    steer(orbit, uefi.poll_key(base, PAUSE))
    (since(clock(set, base), orbit.made) >= RENEW * HZ) { orbit.remake = yes }
    (orbit.remake == yes) {
        orbit.remake = no
        stage.remake(set, base)
        orbit.made = clock(set, base)
        orbit.last = -1
    }
    @passed = step(set, orbit)
    (orbit.paused == no) { orbit.angle = forms.wrap(orbit.angle + orbit.speed * passed / 2) }
    @back = set.back
    back.vsync = orbit.vsync
    stage.render(set, orbit.angle, orbit.lift, base)
    count_rate(orbit, clock(set, base))
    @rate = orbit.rate
    @frames = orbit.frames
    @faces = set.faces
    @sync = "vsync"
    (orbit.vsync == no) { sync = "без vsync" }
    @chosen = group.get(season.SEASONS, set.season)
    @season_name = chosen.name
    @seed = set.seed
    @baked = set.baked
    @drawer = "процессор"
    (group.count(set.painter) > 0) {
        @painter = group.get(set.painter, 0)
        @missed = painter.missed
        @dropped = painter.dropped
        @vertices = painter.count
        (painter.broken == no) { drawer = "видеокарта" }
        drawer = "{drawer} (сбоев {missed}, вершин {vertices}, не влезло {dropped})"
    }
    @slow = orbit.slow
    @w_sky = set.worst_sky
    @w_collect = set.worst_collect
    @w_gpu = set.worst_gpu
    @w_screen = set.worst_screen
    @stall_count = set.stalls
    @long = set.stall_long
    @render_tail = set.stall_render
    @blit_tail = set.stall_blit
    @stalls = " {stall_count}, последний [{long}: {render_tail}/{blit_tail}]"
    @longest = orbit.longest
    out remote.tell(link, "пластилин: долгих кадров {slow}, самый долгий {longest}/60 с, небо {w_sky}, сбор {w_collect}, видеокарта {w_gpu}, экран {w_screen}; затыки{stalls}; {season_name}, зерно {seed}, кадров {frames}, в секунду {rate}, граней {faces}, слеплено за {baked} с, рисует {drawer}, {sync}")
}

skill broken(set, orbit, base, link, problem) {
    @front = set.front
    graphics.fill(front, 0, 0, front.width, 40, graphics.color(front, 20, 22, 28))
    fonts.draw_text(front, 16, 12, "Пластилин упал: {problem} · Esc — выход", canvas.Rgb { red = 250, green = 204, blue = 21 }, fonts.SMALL)
    remote.tell(link, "пластилин упал: {problem}")
    always {
        remote.serve(link)
        @key = uefi.poll_key(base, PAUSE)
        (key.scan == SCAN_ESCAPE) {
            orbit.quit = yes
            out none
        }
    }
    out none
}

program() {
    @base = firmware.guest_base()
    @front = graphics.open(base)
    uefi.forget_keys(base)
    @link = remote.open_remote()
    fonts.draw_text(front, 16, 12, "Пластилин: леплю полянку…", canvas.ZINC_900, fonts.REGULAR)
    @set = stage.open_stage(base, front)
    @sky = set.sky
    @back = set.back
    @pages = stage.pages(set)
    remote.own(link, sky.frame, pages)
    remote.own(link, back.frame, pages)
    @orbit = Orbit { made = clock(set, base), measured = clock(set, base) }
    always {
        tick(set, orbit, base, link) rescue |problem| { broken(set, orbit, base, link, problem) }
        (orbit.quit == yes) {
            stage.close_stage(base, set)
            @frames = orbit.frames
            reply.home("пластилин: кадров {frames}")
            out none
        }
    }
    out none
}
