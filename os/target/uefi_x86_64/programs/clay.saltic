-- clay — программа «Пластилин»: игрушечная полянка из скруглённых тел —
-- холмы, деревья-леденцы, камни-капли, домик, паучок из шариков, мягкий
-- пластилиновый свет и тени-кляксы (screen/clay/{mesh,forms,scene}).
-- Камера облетает полянку, кадр рисует screen/clay/stage. Стрелки ← → —
-- облёт и его скорость, ↑ ↓ — выше и ниже, пробел — пауза, V — vsync вкл/выкл
-- (60 кадров без разрывов или сколько выжмет видеокарта), Esc — назад; по
-- сети — quit, state, key, shot. Только x86_64-uefi.
--
-- Orbit { angle, speed, lift, paused, quit, frames, second, counted, rate, vsync }
-- steer(orbit, key) / count_rate(orbit, base) / tick(set, orbit, base, link)
-- broken(set, orbit, base, link, problem) — ошибка кадра на экран и в state
-- program() — вход

use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.uefi
use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.network.reply
use os.target.uefi_x86_64.network.remote
use os.target.uefi_x86_64.screen.clay.forms
use os.target.uefi_x86_64.screen.clay.stage
use os.uiengine.canvas
use os.uiengine.fonts

LIFT = 560
LIFT_STEP = 40
SPEED = 600
SPEED_STEP = 300
PAUSE = 1000
SCAN_UP = 1
SCAN_DOWN = 2
SCAN_RIGHT = 3
SCAN_LEFT = 4
SCAN_ESCAPE = 23
SPACE = 32
LETTER_V = 118
LETTER_V_UPPER = 86

Orbit = Box {
    angle = 0,
    speed = SPEED,
    lift = LIFT,
    paused = no,
    quit = no,
    frames = 0,
    second = -1,
    counted = 0,
    rate = 0,
    vsync = yes
}

skill steer(orbit, key) {
    (key.scan == SCAN_ESCAPE) { orbit.quit = yes }
    (key.scan == SCAN_LEFT) { orbit.speed = orbit.speed - SPEED_STEP }
    (key.scan == SCAN_RIGHT) { orbit.speed = orbit.speed + SPEED_STEP }
    (key.scan == SCAN_UP) { orbit.lift = orbit.lift + LIFT_STEP }
    (key.scan == SCAN_DOWN) { orbit.lift = orbit.lift - LIFT_STEP }
    (orbit.lift < 160) { orbit.lift = 160 }
    (orbit.lift > 1400) { orbit.lift = 1400 }
    (key.char == SPACE) { orbit.paused = orbit.paused == no }
    (key.char == LETTER_V) { orbit.vsync = orbit.vsync == no }
    (key.char == LETTER_V_UPPER) { orbit.vsync = orbit.vsync == no }
    out none
}

skill count_rate(orbit, base) {
    orbit.frames = orbit.frames + 1
    orbit.counted = orbit.counted + 1
    @moment = uefi.now(base)
    ((moment.second == orbit.second) == no) {
        orbit.rate = orbit.counted
        orbit.counted = 0
        orbit.second = moment.second
    }
    out none
}

skill tick(set, orbit, base, link) {
    remote.serve(link)
    steer(orbit, uefi.poll_key(base, PAUSE))
    (orbit.paused == no) { orbit.angle = forms.wrap(orbit.angle + orbit.speed) }
    @back = set.back
    back.vsync = orbit.vsync
    stage.render(set, orbit.angle, orbit.lift, base)
    count_rate(orbit, base)
    @rate = orbit.rate
    @frames = orbit.frames
    @faces = set.faces
    @sync = "vsync"
    (orbit.vsync == no) { sync = "без vsync" }
    out remote.tell(link, "пластилин: кадров {frames}, в секунду {rate}, граней {faces}, {sync}")
}

skill broken(set, orbit, base, link, problem) {
    @front = set.front
    graphics.fill(front, 0, 0, front.width, 40, graphics.color(front, 20, 22, 28))
    fonts.draw_text(front, 16, 12, "Пластилин упал: {problem} · Esc — выход", canvas.Rgb { red = 250, green = 204, blue = 21 }, fonts.SMALL)
    remote.tell(link, "пластилин упал: {problem}")
    always {
        remote.serve(link)
        @key = uefi.poll_key(base, PAUSE)
        (key.scan == SCAN_ESCAPE) {
            orbit.quit = yes
            out none
        }
    }
    out none
}

program() {
    @base = firmware.guest_base()
    @front = graphics.open(base)
    uefi.forget_keys(base)
    @link = remote.open_remote()
    fonts.draw_text(front, 16, 12, "Пластилин: леплю полянку…", canvas.ZINC_900, fonts.REGULAR)
    @set = stage.open_stage(base, front)
    @sky = set.sky
    @back = set.back
    @pages = stage.pages(set)
    remote.own(link, sky.frame, pages)
    remote.own(link, back.frame, pages)
    @orbit = Orbit {}
    always {
        tick(set, orbit, base, link) rescue |problem| { broken(set, orbit, base, link, problem) }
        (orbit.quit == yes) {
            stage.close_stage(base, set)
            @frames = orbit.frames
            reply.home("пластилин: кадров {frames}")
            out none
        }
    }
    out none
}
