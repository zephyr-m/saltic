-- scene — сцена «Пластилина»: холмистая полянка сеткой CELLS × CELLS, на ней
-- деревья-леденцы, камни-капли, домик из скруглённых кубов и паучок из
-- шариков; под каждым предметом — тень-клякса. Высота земли — сумма двух
-- волн, предметы ставятся на неё.
--
-- Scene { ground, blots, bodies } — земля, тени, предметы
-- height(x, z) -> высота земли
-- build(screen) -> Scene
-- quads(scene) -> сколько граней в сцене

use core.group
use os.uiengine.canvas
use os.target.uefi_x86_64.programs.web.geometry
use os.target.uefi_x86_64.programs.clay.mesh
use os.target.uefi_x86_64.programs.clay.forms

CELLS = 18
CELL = 70
TREES = [[-380, -240, 0], [-220, 260, 1], [300, -320, 2], [420, 180, 0], [-470, 120, 3], [120, 380, 1], [-80, -430, 3], [500, -60, 2]]
ROCKS = [[-260, -60, 34], [240, -160, 26], [60, -260, 22], [-360, 330, 30], [380, 380, 24]]
CROWNS = [[122, 168, 112], [150, 196, 120], [236, 150, 170], [240, 176, 110]]
BARK = canvas.Rgb { red = 150, green = 108, blue = 78 }
STONE = canvas.Rgb { red = 176, green = 164, blue = 184 }
WALL = canvas.Rgb { red = 244, green = 228, blue = 196 }
ROOF = canvas.Rgb { red = 214, green = 108, blue = 82 }
SPIDER = canvas.Rgb { red = 124, green = 88, blue = 64 }
EYE = canvas.Rgb { red = 250, green = 250, blue = 250 }
SHADOW = canvas.Rgb { red = 82, green = 128, blue = 76 }
LEGS = [[1, 1], [1, 3], [1, -1], [1, -3], [-1, 1], [-1, 3], [-1, -1], [-1, -3]]

Scene = Box {
    ground = mesh.Body {},
    blots = [],
    bodies = []
}

skill wave(value, period, amount) {
    out amount * geometry.sine(forms.wrap(value * geometry.TURN / period)) / geometry.ONE
}

skill height(x, z) {
    out wave(x, 900, 46) + wave(z, 1100, 38) + wave(x + z, 600, 14)
}

skill rgb(color) {
    out canvas.Rgb { red = group.get(color, 0), green = group.get(color, 1), blue = group.get(color, 2) }
}

skill grass(value) {
    @lift = value + 90
    out canvas.Rgb { red = 96 + lift / 3, green = 150 + lift / 4, blue = 84 + lift / 6 }
}

skill field(screen) {
    @half = CELLS * CELL / 2
    @body = mesh.Body { center = [0, 0, 0] }
    @points = []
    drum (CELLS + 1) {
        @z = beat * CELL - half
        drum (CELLS + 1) {
            @x = beat * CELL - half
            points = group.add(points, [x, height(x, z), z])
        }
    }
    body.points = points
    @side = CELLS + 1
    drum (CELLS) {
        @row = beat
        drum (CELLS) {
            @x = beat * CELL - half + CELL / 2
            @z = row * CELL - half + CELL / 2
            @normal = mesh.unit(height(x - CELL / 2, z) - height(x + CELL / 2, z), CELL, height(x, z - CELL / 2) - height(x, z + CELL / 2))
            @a = row * side + beat
            body = mesh.face(screen, body, a, a + 1, a + side + 1, a + side, normal, grass(height(x, z)))
        }
    }
    out body
}

skill on_ground(x, z, lift) {
    out [x, height(x, z) + lift, z]
}

skill blot_at(screen, x, z, size) {
    out forms.blot(screen, on_ground(x, z, 3), size, size * 3 / 4, SHADOW)
}

skill tree(screen, place) {
    @x = group.get(place, 0)
    @z = group.get(place, 1)
    @crown = rgb(group.get(CROWNS, group.get(place, 2)))
    @size = 40 + group.get(place, 2) * 5
    out [forms.ellipsoid(screen, on_ground(x, z, 40), [9, 42, 9], BARK, 4), forms.ellipsoid(screen, on_ground(x, z, 82 + size / 2), [size, size + 6, size], crown, 7)]
}

skill house(screen) {
    @x = 40
    @z = 60
    out [forms.rounded(screen, on_ground(x, z, 50), [72, 56, 60], WALL, 6), forms.rounded(screen, on_ground(x, z, 120), [86, 22, 72], ROOF, 6), forms.rounded(screen, on_ground(x + 40, z - 20, 150), [12, 24, 12], ROOF, 3)]
}

skill spider(screen) {
    @x = -150
    @z = 120
    @parts = [forms.ellipsoid(screen, on_ground(x, z, 34), [30, 24, 34], SPIDER, 6), forms.ellipsoid(screen, on_ground(x, z + 34, 30), [18, 16, 16], SPIDER, 5)]
    parts = group.add(parts, forms.ellipsoid(screen, on_ground(x - 8, z + 48, 36), [5, 6, 4], EYE, 3))
    parts = group.add(parts, forms.ellipsoid(screen, on_ground(x + 8, z + 48, 36), [5, 6, 4], EYE, 3))
    drum (group.count(LEGS)) {
        @leg = group.get(LEGS, beat)
        @side = group.get(leg, 0)
        @along = group.get(leg, 1)
        parts = group.add(parts, forms.ellipsoid(screen, on_ground(x + side * 38, z + along * 8, 40), [8, 7, 8], SPIDER, 3))
        parts = group.add(parts, forms.ellipsoid(screen, on_ground(x + side * 60, z + along * 12, 16), [6, 16, 6], SPIDER, 3))
    }
    out parts
}

skill build(screen) {
    @scene = Scene { ground = field(screen) }
    @bodies = []
    @blots = []
    drum (group.count(TREES)) {
        @place = group.get(TREES, beat)
        bodies = group.concat(bodies, tree(screen, place))
        blots = group.add(blots, blot_at(screen, group.get(place, 0), group.get(place, 1), 44 + group.get(place, 2) * 4))
    }
    drum (group.count(ROCKS)) {
        @rock = group.get(ROCKS, beat)
        @size = group.get(rock, 2)
        bodies = group.add(bodies, forms.ellipsoid(screen, on_ground(group.get(rock, 0), group.get(rock, 1), size / 2), [size + 8, size * 2 / 3, size], STONE, 5))
        blots = group.add(blots, blot_at(screen, group.get(rock, 0), group.get(rock, 1), size + 14))
    }
    bodies = group.concat(bodies, house(screen))
    blots = group.add(blots, blot_at(screen, 40, 60, 104))
    bodies = group.concat(bodies, spider(screen))
    blots = group.add(blots, blot_at(screen, -150, 130, 70))
    scene.bodies = bodies
    scene.blots = blots
    out scene
}

skill quads(scene) {
    @count = group.count(scene.ground.quads)
    drum (group.count(scene.bodies)) {
        @body = group.get(scene.bodies, beat)
        count = count + group.count(body.quads)
    }
    out count
}
