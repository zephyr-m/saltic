-- pci — программа: печатает окно ECAM и все устройства PCI в консоль UEFI.
-- Никогда не выходит — ноутбук выключать руками.
--
-- run() — разведка и печать; ошибка — в program
-- program() — вход

use io
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.pci

skill run() {
    @base = firmware.guest_base()
    @space = firmware.ecam(base)
    @start = firmware.phys_text(space.start)
    io.show("ECAM at {start}, buses ", space.first, "..", space.last)
    io.show("")
    @found = pci.device_lines(base, space)
    drum (found) { io.show("  ", beat) }
    io.show("")
    io.show("devices found: ", group.count(found))
    out none
}

program() {
    io.show("Saltic PCI scan")
    @done = run() rescue |err| {
        io.show("FAILED: ", err)
        none
    }
    io.show("")
    io.show("This program never exits. Turn the laptop off when done.")
    drum (200000000) {
        @key = io.key()
    }
}
