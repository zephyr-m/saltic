-- head — шапка экрана гильдии алхимии языка: «← Назад», герб с щитом, имя
-- раздела и подраздела, золотая плашка с монетами; вид — жители back-link и
-- guild-head.
--
-- Head { title, note, coins } — раздел, подраздел, монеты; jtml() -> текст JTML

use tarantul.uiengine.jtml.calls

Head = Box {
    title = "Гильдия",
    note = "Локации",
    coins = 3122

    skill jtml() {
        @back = calls.call("back-link", [["text", calls.quoted("Назад")]])
        @guild = calls.call("guild-head", [["title", calls.quoted(title)], ["note", calls.quoted(note)], ["amount", calls.quoted("{coins}")]])
        out "\{\"box\": \{\"gap\": 14, \"children\": [{back}, {guild}]\}\}"
    }
}
