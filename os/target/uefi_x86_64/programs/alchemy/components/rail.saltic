-- rail — боковая рейка разделов гильдии: восемь значков, выбранный — латунный;
-- вид — жители rail-button, rail-button-active и section-rail.
--
-- Rail { active } — выбранный раздел; jtml() -> текст JTML

use core.group
use tarantul.uiengine.jtml.calls

SECTIONS = ["Заказы", "Квесты", "Магазин", "Локации", "Свитки", "Лицензии", "Статистика", "Правила"]
ICONS = ["clipboard-list", "sparkles", "store", "map", "scroll-text", "award", "chart-column", "scale"]

Rail = Box {
    active = "Локации"

    skill jtml() {
        @buttons = []
        drum (group.count(SECTIONS)) {
            @kind = "rail-button"
            (group.get(SECTIONS, beat) == active) { kind = "rail-button-active" }
            buttons = group.add(buttons, calls.call(kind, [["icon", calls.quoted(group.get(ICONS, beat))]]))
        }
        out calls.call("section-rail", [["buttons", calls.listed(buttons)]])
    }
}
