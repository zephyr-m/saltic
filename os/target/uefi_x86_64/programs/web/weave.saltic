-- weave — чертёж паутины и пути паука по ней. Паутина как у кругопряда:
-- радиусы из центра, рама по их концам, причальные нити к краям экрана,
-- спираль снаружи внутрь с провисанием между радиусами.
-- Узлы для охоты: точки спирали 0…count-1 (точка s лежит на радиусе
-- s mod spokes) и центр с номером count; нити между узлами — спираль
-- (s, s+1), радиус (s, s+spokes) и центр с последним витком.
--
-- Web { hub_x, hub_y, spokes, width, height, angles, ends, points, seed } —
--     чертёж; ends — [x, y, длина] концов радиусов, points — [x, y] спирали
-- random(web, limit) -> число 0…limit-1 (свой генератор, как у jumper)
-- design(width, height, seed) -> Web: радиусы, концы, точки спирали
-- point(web, node) -> [x, y]; центр — node = count(points)
-- plan(web, step) -> группа geometry.Piece: весь путь паука от центра до центра
-- spiral_piece(web, s, ink, step) -> куски дуги от точки s к s+1
-- nearest(web, x, y) -> номер точки спирали ближе всех к (x, y)
-- route(web, from, to) -> группа узлов кратчайшего пути по нитям (поиск в ширину)
-- walk(web, nodes, step) -> куски пути паука по узлам без новой нити

use core.num
use core.group
use core.bytes
use os.target.uefi_x86_64.programs.web.geometry

SPOKES = 14
TURNS = 9
OUTER = 92
INNER = 14
SAG = 12
JITTER = 30
MOORINGS = [0, 4, 7, 11]
MARGIN = 6
UNSEEN = 255
FRAME = 1
SPOKE = 2
SPIRAL = 3

Web = Box {
    hub_x = 0,
    hub_y = 0,
    spokes = SPOKES,
    width = 0,
    height = 0,
    angles = [],
    ends = [],
    points = [],
    seed = 1
}

skill random(web, limit) {
    web.seed = num.mod(web.seed * 75 + 74, 65537)
    out num.mod(web.seed, limit)
}

skill design(width, height, seed) {
    @web = Web { hub_x = width / 2, hub_y = height / 2, width = width, height = height, seed = seed }
    @reach = height / 2 - 30
    (width / 2 - 30 < reach) { reach = width / 2 - 30 }
    @angles = []
    @ends = []
    @slice = geometry.TURN / SPOKES
    drum (SPOKES) {
        @angle = slice * beat + slice * (random(web, 2 * JITTER + 1) - JITTER) / 100
        (angle < 0) { angle = angle + geometry.TURN }
        @length = reach * (82 + random(web, 19)) / 100
        angles = group.add(angles, angle)
        ends = group.add(ends, [web.hub_x + length * geometry.cosine(angle) / geometry.ONE, web.hub_y + length * geometry.sine(angle) / geometry.ONE, length])
    }
    web.angles = angles
    web.ends = ends
    @count = SPOKES * TURNS
    @points = []
    drum (count) {
        @spoke = num.mod(beat, SPOKES)
        @end = group.get(ends, spoke)
        @angle = group.get(angles, spoke)
        @distance = group.get(end, 2) * (OUTER * count - (OUTER - INNER) * beat) / (100 * count)
        points = group.add(points, [web.hub_x + distance * geometry.cosine(angle) / geometry.ONE, web.hub_y + distance * geometry.sine(angle) / geometry.ONE])
    }
    web.points = points
    out web
}

skill point(web, node) {
    (node == group.count(web.points)) { out [web.hub_x, web.hub_y] }
    out group.get(web.points, node)
}

skill edge_of(web, angle) {
    @dx = geometry.cosine(angle)
    @dy = geometry.sine(angle)
    @reach = web.width + web.height
    (dx > 0) { reach = (web.width - MARGIN - web.hub_x) * geometry.ONE / dx }
    (dx < 0) { reach = (MARGIN - web.hub_x) * geometry.ONE / dx }
    @down = reach
    (dy > 0) { down = (web.height - MARGIN - web.hub_y) * geometry.ONE / dy }
    (dy < 0) { down = (MARGIN - web.hub_y) * geometry.ONE / dy }
    (down < reach) { reach = down }
    out [web.hub_x + reach * dx / geometry.ONE, web.hub_y + reach * dy / geometry.ONE]
}

skill spiral_piece(web, s, ink, step) {
    @from = group.get(web.points, s)
    @to = group.get(web.points, s + 1)
    @pull = geometry.sag(group.get(from, 0), group.get(from, 1), group.get(to, 0), group.get(to, 1), web.hub_x, web.hub_y, SAG)
    out geometry.curve([], from, to, pull, ink, step)
}

skill plan(web, step) {
    @hx = web.hub_x
    @hy = web.hub_y
    @pieces = []
    drum (SPOKES) {
        @end = group.get(web.ends, beat)
        pieces = geometry.line(pieces, hx, hy, group.get(end, 0), group.get(end, 1), SPOKE, step)
        pieces = geometry.line(pieces, group.get(end, 0), group.get(end, 1), hx, hy, 0, step)
    }
    @first = group.get(web.ends, 0)
    pieces = geometry.line(pieces, hx, hy, group.get(first, 0), group.get(first, 1), 0, step)
    drum (SPOKES) {
        @from = group.get(web.ends, beat)
        @to = group.get(web.ends, num.mod(beat + 1, SPOKES))
        pieces = geometry.line(pieces, group.get(from, 0), group.get(from, 1), group.get(to, 0), group.get(to, 1), FRAME, step)
        (group.contains(MOORINGS, beat) == yes) {
            @edge = edge_of(web, group.get(web.angles, beat))
            pieces = geometry.line(pieces, group.get(from, 0), group.get(from, 1), group.get(edge, 0), group.get(edge, 1), FRAME, step)
            pieces = geometry.line(pieces, group.get(edge, 0), group.get(edge, 1), group.get(from, 0), group.get(from, 1), 0, step)
        }
    }
    @start = group.get(web.points, 0)
    pieces = geometry.line(pieces, group.get(first, 0), group.get(first, 1), group.get(start, 0), group.get(start, 1), 0, step)
    drum (group.count(web.points) - 1) { pieces = group.concat(pieces, spiral_piece(web, beat, SPIRAL, step)) }
    @last = group.get(web.points, group.count(web.points) - 1)
    out geometry.line(pieces, group.get(last, 0), group.get(last, 1), hx, hy, 0, step)
}

skill nearest(web, x, y) {
    @best = 0
    @best_distance = -1
    drum (group.count(web.points)) {
        @p = group.get(web.points, beat)
        @dx = group.get(p, 0) - x
        @dy = group.get(p, 1) - y
        @distance = dx * dx + dy * dy
        (best_distance < 0) { best_distance = distance }
        (distance < best_distance) {
            best = beat
            best_distance = distance
        }
    }
    out best
}

skill neighbors(web, node) {
    @count = group.count(web.points)
    (node == count) {
        @inner = []
        drum (SPOKES) { inner = group.add(inner, count - SPOKES + beat) }
        out inner
    }
    @found = []
    (node > 0) { found = group.add(found, node - 1) }
    (node < count - 1) { found = group.add(found, node + 1) }
    (node >= SPOKES) { found = group.add(found, node - SPOKES) }
    (node + SPOKES < count) { found = group.add(found, node + SPOKES) }
    (node >= count - SPOKES) { found = group.add(found, count) }
    out found
}

skill route(web, from, to) {
    @count = group.count(web.points) + 1
    @parent = bytes.new(count)
    drum (count) { bytes.set(parent, beat, UNSEEN) }
    bytes.set(parent, from, from)
    @queue = [from]
    @head = 0
    drum (count) {
        (head >= group.count(queue)) { leave }
        @node = group.get(queue, head)
        head = head + 1
        (node == to) { leave }
        @next = neighbors(web, node)
        drum (group.count(next)) {
            @other = group.get(next, beat)
            (bytes.get(parent, other) == UNSEEN) {
                bytes.set(parent, other, node)
                queue = group.add(queue, other)
            }
        }
    }
    @path = [to]
    @at = to
    drum (count) {
        (at == from) { leave }
        at = bytes.get(parent, at)
        path = group.add(path, at)
    }
    @forward = []
    drum (group.count(path)) { forward = group.add(forward, group.get(path, group.count(path) - 1 - beat)) }
    out forward
}

skill walk(web, nodes, step) {
    @pieces = []
    drum (group.count(nodes) - 1) {
        @from = point(web, group.get(nodes, beat))
        @to = point(web, group.get(nodes, beat + 1))
        pieces = geometry.line(pieces, group.get(from, 0), group.get(from, 1), group.get(to, 0), group.get(to, 1), 0, step)
    }
    out pieces
}
