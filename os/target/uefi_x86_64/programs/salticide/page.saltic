-- page — SalticIDE с сайта (docs/site/IDE.html) из четырёх атомов, светлая
-- тема 1: шапка окна, слева проект, навыки и типы, посередине вкладки и
-- редактор workbench/actor.saltic с подсветкой по смыслу (salticide/syntax),
-- справа сборка и журнал со временем, внизу полоса режимов и состояние.
-- Логики нет — только вид.
--
-- tree() -> atom.Node корня
-- Внутри: say, boxed, rule, coin, file_row, side, tabs, editor, right, modes

use core.str
use core.group
use os.ui.jtml.atom
use os.target.uefi_x86_64.programs.salticide.code
use os.target.uefi_x86_64.programs.salticide.syntax

SHOWN = 35
LINE = 18
LIGHT = 24
MODES = ["код", "поток", "база", "проверки", "железо", "время", "git", "ветки"]
LOG = [["17:42:01", "toolchain: читаю workbench/actor.saltic", ""], ["17:42:01", "toolchain: проверяю", ""], ["17:42:01", "toolchain: собираю", ""], ["17:42:02", "toolchain: пишу родной x86-64 .cache/build/actor", ""], ["17:42:02", "собрано за 0.4 с — цель x86_64", "up"], ["17:42:05", "запускаю .cache/build/actor", ""], ["17:42:05", "NotEnoughEnergy: нужно 40", "down"], ["17:42:05", "pip: осталось 18", ""], ["17:42:05", "pip устал", ""], ["17:42:05", "код выхода 0 — 12 мс", "up"]]

skill say(text, tone) {
    @node = atom.text(text)
    node.tone = tone
    out node
}

skill boxed(flow, size, padding, gap, border, tone, grow, kids) {
    @node = atom.frame(flow, group.get(size, 0), group.get(size, 1), grow, padding, gap, border, kids)
    node.tone = tone
    out node
}

skill rule(across) {
    (across == yes) { out boxed(atom.Flow.ROW, [0, 1], 0, 0, 0, "line", 0, []) }
    out boxed(atom.Flow.ROW, [1, 0], 0, 0, 0, "line", 0, [])
}

skill coin() {
    out boxed(atom.Flow.ROW, [20, 18], 2, 0, 0, "ink", 0, [say("<", "down"), say(">", "accent")])
}

skill title() {
    @dots = boxed(atom.Flow.ROW, [0, 0], 0, 6, 0, "", 0, [boxed(atom.Flow.ROW, [11, 11], 0, 0, 6, "accent", 0, []), boxed(atom.Flow.ROW, [11, 11], 0, 0, 6, "line", 0, []), boxed(atom.Flow.ROW, [11, 11], 0, 0, 6, "line", 0, [])])
    @mode = boxed(atom.Flow.ROW, [0, 24], 4, 0, 1, "", 0, [say("тема", "quiet")])
    @full = boxed(atom.Flow.ROW, [0, 24], 4, 0, 1, "", 0, [say("весь экран", "quiet")])
    out boxed(atom.Flow.ROW, [0, 38], 8, 12, 0, "panel", 0, [dots, coin(), say(code.PATH, "quiet"), atom.space(1), mode, full])
}

skill heading(text) {
    out boxed(atom.Flow.ROW, [0, 0], 6, 0, 0, "", 0, [say(text, "quiet")])
}

skill file_row(name, current) {
    (current == yes) { out boxed(atom.Flow.ROW, [0, 24], 0, 8, 0, "raise", 0, [boxed(atom.Flow.ROW, [3, 24], 0, 0, 0, "accent", 0, []), boxed(atom.Flow.ROW, [12, 0], 0, 0, 0, "", 0, []), coin(), say(name, "")]) }
    out boxed(atom.Flow.ROW, [0, 24], 0, 8, 0, "", 0, [boxed(atom.Flow.ROW, [15, 0], 0, 0, 0, "", 0, []), coin(), say(name, "")])
}

skill symbol(name, tone, at) {
    out boxed(atom.Flow.ROW, [0, 22], 0, 8, 0, "", 0, [boxed(atom.Flow.ROW, [8, 0], 0, 0, 0, "", 0, []), say(name, tone), atom.space(1), say(at, "gutter"), boxed(atom.Flow.ROW, [6, 0], 0, 0, 0, "", 0, [])])
}

skill side(info) {
    @rows = [heading("ПРОЕКТ"), say("  v soul/seed", "quiet"), file_row("time.saltic", no), say("  v workbench", "quiet"), file_row("actor.saltic", yes), file_row("stamp.saltic", no), heading("НАВЫКИ")]
    drum (info.scopes) {
        @line = beat.line
        rows = group.add(rows, symbol(beat.name, "up", ":{line}"))
    }
    rows = group.add(rows, heading("ТИПЫ"))
    rows = group.add(rows, symbol("State", "name", "enum"))
    rows = group.add(rows, symbol("Actor", "name", "Box"))
    out boxed(atom.Flow.COLUMN, [220, 0], 8, 2, 0, "panel", 0, rows)
}

skill tab(name, active) {
    (active == yes) { out boxed(atom.Flow.COLUMN, [0, 36], 0, 0, 0, "ground", 0, [boxed(atom.Flow.ROW, [0, 2], 0, 0, 0, "accent", 0, []), boxed(atom.Flow.ROW, [0, 34], 8, 8, 0, "", 0, [coin(), say(name, "")])]) }
    out boxed(atom.Flow.ROW, [0, 36], 8, 8, 0, "", 0, [coin(), say(name, "quiet")])
}

skill editor(info) {
    @tabs = boxed(atom.Flow.ROW, [0, 36], 0, 0, 0, "panel", 0, [tab("actor.saltic", yes), rule(no), tab("stamp.saltic", no), rule(no), atom.space(1)])
    @lines = []
    drum (SHOWN) {
        @number = beat + 1
        @label = atom.label("{number}", atom.Align.END)
        label.tone = "gutter"
        @gutter = boxed(atom.Flow.COLUMN, [36, 0], 0, 0, 0, "", 0, [label])
        @tokens = syntax.line(group.get(code.ACTOR, beat), number, info)
        (group.count(tokens) == 0) { tokens = [say(" ", "")] }
        @tone = ""
        (number == LIGHT) { tone = "select" }
        lines = group.add(lines, boxed(atom.Flow.ROW, [0, LINE], 0, 0, 0, tone, 0, [gutter, boxed(atom.Flow.ROW, [18, 0], 0, 0, 0, "", 0, []), boxed(atom.Flow.ROW, [0, 0], 0, 0, 0, "", 1, tokens)]))
    }
    @text = boxed(atom.Flow.COLUMN, [0, 0], 10, 0, 0, "", 1, lines)
    out boxed(atom.Flow.COLUMN, [0, 0], 0, 0, 0, "ground", 1, [tabs, rule(yes), text])
}

skill pill(text, go) {
    (go == yes) { out boxed(atom.Flow.ROW, [0, 30], 7, 0, 2, "up", 0, [say(text, "ground")]) }
    out boxed(atom.Flow.ROW, [0, 30], 7, 0, 1, "", 0, [say(text, "")])
}

skill right(info) {
    @bar = boxed(atom.Flow.ROW, [0, 0], 12, 8, 0, "", 0, [pill("собрать", yes), pill("запустить", no), pill("x86_64  v", no)])
    @count = group.count(code.ACTOR)
    @skills = group.count(info.scopes)
    @summary = boxed(atom.Flow.ROW, [0, 0], 12, 0, 0, "", 0, [say("{count} строк — {skills} навыков — ошибок в подписях: 1", "quiet")])
    @rows = []
    drum (LOG) {
        @at = group.get(beat, 0)
        rows = group.add(rows, boxed(atom.Flow.ROW, [0, 0], 0, 8, 0, "", 0, [say("[{at}]", "gutter"), say(group.get(beat, 1), group.get(beat, 2))]))
    }
    @card = boxed(atom.Flow.COLUMN, [0, 0], 12, 6, 1, "", 0, [boxed(atom.Flow.ROW, [0, 0], 0, 0, 0, "", 0, [say("spend", "up"), say("(actor, cost)", "")]), say("Тратит силы актёра; не хватает — ошибка.", "quiet"), say("ошибки: NotEnoughEnergy", "down"), say("строка 18", "quiet")])
    @log = boxed(atom.Flow.COLUMN, [0, 0], 16, 6, 0, "ground", 1, group.concat(rows, [atom.space(1), say("КАРТОЧКА НАВЫКА", "quiet"), card]))
    out boxed(atom.Flow.COLUMN, [475, 0], 0, 0, 0, "panel", 0, [bar, summary, rule(yes), log])
}

skill modes() {
    @buttons = []
    drum (MODES) {
        @name = beat
        (group.count(buttons) == 0) { buttons = group.add(buttons, boxed(atom.Flow.ROW, [0, 30], 7, 7, 0, "ground", 0, [boxed(atom.Flow.ROW, [8, 8], 0, 0, 4, "accent", 0, []), say(name, "")])) }
        (group.count(buttons) > 0) {
            ((name == "код") == no) { buttons = group.add(buttons, boxed(atom.Flow.ROW, [0, 30], 7, 7, 0, "", 0, [boxed(atom.Flow.ROW, [8, 8], 0, 0, 1, "quiet", 0, []), say(name, "quiet")])) }
        }
    }
    @segment = boxed(atom.Flow.ROW, [0, 36], 3, 2, 0, "raise", 0, buttons)
    out boxed(atom.Flow.ROW, [0, 44], 4, 14, 0, "panel", 0, [segment, atom.space(1), say("main +12", "quiet"), say("x86_64", "quiet"), say("24:5", "quiet"), say("ошибок 1", "down"), boxed(atom.Flow.ROW, [4, 0], 0, 0, 0, "", 0, [])])
}

skill tree() {
    @info = syntax.scan(code.ACTOR)
    @body = boxed(atom.Flow.ROW, [0, 0], 0, 0, 0, "", 1, [side(info), rule(no), editor(info), rule(no), right(info)])
    out boxed(atom.Flow.COLUMN, [0, 0], 0, 0, 0, "ground", 0, [title(), rule(yes), body, rule(yes), modes()])
}
