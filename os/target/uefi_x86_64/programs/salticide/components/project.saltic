-- project — левая панель SalticIDE: файлы проекта, навыки открытого файла (из
-- подсветки, со строкой определения) и его типы; вид — житель project-panel,
-- строки — folder-row, file-row, file-row-current, symbol-row. Файлы — строки
-- rows, их даёт хозяин окна (Linux — с диска, os/target/linux/salticide/disk);
-- нет строк — образец с сайта. id строки — FOLDER или FILE и путь: по нему
-- щелчок раскрывает папку или открывает файл.
--
-- Row { kind, name, path, depth, open } — строка дерева: kind — FOLDER или
--     FILE, depth — вложенность, open — папка раскрыта
-- Project { info, rows, current } — разбор открытого файла, строки дерева,
--     путь открытого файла; jtml() -> текст JTML
-- Внутри: file(name, chosen) — строка образца; row(item) — строка дерева

use core.group
use registry.libraries.uiengine.jtml.calls
use os.target.uefi_x86_64.programs.salticide.syntax

INDENT = 12
FOLDER = "dir:"
FILE = "file:"

Row = Box {
    kind = "file:",
    name = "",
    path = "",
    depth = 0,
    open = no
}

Project = Box {
    info = syntax.Info {},
    rows = [],
    current = ""

    skill file(name, chosen) {
        @kind = "file-row"
        (chosen == yes) { kind = "file-row-current" }
        out calls.call(kind, [["id", calls.quoted("")], ["name", calls.quoted(name)], ["indent", "{INDENT}"]])
    }

    skill row(item) {
        @indent = item.depth * INDENT
        (item.kind == FOLDER) {
            @icon = "chevron-right"
            (item.open == yes) { icon = "chevron-down" }
            out calls.call("folder-row", [["id", calls.quoted("{FOLDER}{item.path}")], ["name", calls.quoted(item.name)], ["indent", "{indent}"], ["icon", calls.quoted(icon)]])
        }
        @kind = "file-row"
        (item.path == current) { kind = "file-row-current" }
        out calls.call(kind, [["id", calls.quoted("{FILE}{item.path}")], ["name", calls.quoted(item.name)], ["indent", "{indent}"]])
    }

    skill jtml() {
        @files = [calls.call("folder-row", [["id", calls.quoted("")], ["name", calls.quoted("soul/seed")], ["indent", "0"], ["icon", calls.quoted("chevron-down")]]), file("time.saltic", no), calls.call("folder-row", [["id", calls.quoted("")], ["name", calls.quoted("workbench")], ["indent", "0"], ["icon", calls.quoted("chevron-down")]]), file("actor.saltic", yes), file("stamp.saltic", no)]
        (group.count(rows) > 0) {
            files = []
            drum (rows) { files = group.add(files, row(beat)) }
        }
        @skills = []
        drum (info.scopes) {
            @at = beat.line
            skills = group.add(skills, calls.call("symbol-row", [["name", calls.quoted(beat.name)], ["tone", calls.quoted("up")], ["at", calls.quoted(":{at}")]]))
        }
        @types = [calls.call("symbol-row", [["name", calls.quoted("State")], ["tone", calls.quoted("name")], ["at", calls.quoted("enum")]]), calls.call("symbol-row", [["name", calls.quoted("Actor")], ["tone", calls.quoted("name")], ["at", calls.quoted("Box")]])]
        out calls.call("project-panel", [["files", calls.listed(files)], ["skills", calls.listed(skills)], ["types", calls.listed(types)]])
    }
}
