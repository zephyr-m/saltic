-- view — доска задач текстом JTML для UIEngine: шапка и три колонки-карточки
-- ширины lg, в каждой — карточки задач с номером. Выбранная задача — тёмный
-- номер, «в руке» — красный. Кавычки и обратные слэши в тексте задач
-- заменяются, чтобы не ломать JTML.
--
-- board_jtml(desk, note) -> текст JTML; note — строка состояния справа сверху

use core.str
use core.group
use os.target.uefi_x86_64.programs.tasks.board

QUOTE = 34
BACKSLASH = 92

skill safe(words) {
    @clean = ""
    drum (str.len(words)) {
        @code = str.byte(words, beat)
        pick {
            (code == QUOTE) { clean = str.concat(clean, "'") }
            (code == BACKSLASH) { clean = str.concat(clean, "/") }
            { clean = str.concat(clean, str.get(words, beat)) }
        }
    }
    out clean
}

skill task_card(desk, number) {
    @look = "secondary"
    (number == desk.selected) {
        look = "default"
        (desk.holding == yes) { look = "destructive" }
    }
    @name = safe(group.get(desk.names, number - 1))
    out "\{\"card\": \{\"children\": [\{\"row\": \{\"children\": [\{\"badge\": \{\"variant\": \"{look}\", \"text\": \"{number}\"\}\}, \{\"text\": \{\"text\": \"{name}\"\}\}]\}\}]\}\}"
}

skill column_card(desk, column) {
    @title = group.get(board.COLUMN_NAMES, column)
    @numbers = board.tasks_in(desk, column)
    @total = group.count(numbers)
    @cards = ""
    drum (numbers) {
        @card = task_card(desk, beat)
        pick {
            (str.len(cards) == 0) { cards = card }
            { cards = "{cards}, {card}" }
        }
    }
    @head = "\{\"row\": \{\"children\": [\{\"title\": \{\"text\": \"{title}\"\}\}, \{\"spacer\": \{\}\}, \{\"badge\": \{\"variant\": \"outline\", \"text\": \"{total}\"\}\}]\}\}"
    (total > 0) { head = "{head}, {cards}" }
    out "\{\"card\": \{\"width\": \"lg\", \"children\": [{head}]\}\}"
}

skill board_jtml(desk, note) {
    @first = column_card(desk, 0)
    @second = column_card(desk, 1)
    @third = column_card(desk, 2)
    @shown = safe(note)
    @top = "\{\"row\": \{\"children\": [\{\"heading\": \{\"text\": \"Задачи Saltic\"\}\}, \{\"badge\": \{\"variant\": \"secondary\", \"text\": \"{shown}\"\}\}, \{\"spacer\": \{\}\}, \{\"muted\": \{\"text\": \"стрелки — выбор · Enter — взять и положить · Esc — выход\"\}\}]\}\}"
    out "\{\"column\": \{\"gap\": \"md\", \"children\": [{top}, \{\"row\": \{\"gap\": \"md\", \"children\": [{first}, {second}, {third}]\}\}]\}\}"
}
