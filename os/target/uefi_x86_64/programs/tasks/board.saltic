-- board — модель доски задач: три колонки, задачи с номерами, выбор и «в руке».
-- Номер задачи — её место в списке, с 1; колонки 0 «Надо», 1 «Делаю», 2 «Готово».
-- Доска меняется на месте (Box), навыки отдают текст ответа или yes/no.
-- У задачи свой список пунктов (туду): пункт — [сделано yes/no, текст,
-- время последнего изменения], номер пункта — с 1; свой журнал событий —
-- [время, что случилось]; и лента сообщений — [время, автор, текст]: вопросы и
-- ответы людей и агентов прямо в задаче. Время — текст «ДД.ММ.ГГГГ ЧЧ:ММ» от вызывающего
-- (модель часов не знает), "" — неизвестно (задачи и пункты до журнала).
-- opened — открытая задача (0 — видна доска), cursor — место выбранного пункта
-- в ней (с 0).
--
-- Board — names, columns, items, events, messages, selected (номер выбранной),
--     holding, opened, cursor
-- starting_board() -> Board — наши настоящие задачи
-- column_word(word) -> 0..2, -1 — не колонка; понимает цифры, рус. и англ.
-- put_task(desk, column, name) -> номер
-- shift_task(desk, number, column) -> yes/no
-- tasks_in(desk, column) -> группа номеров
-- choose(desk, scan) -> yes, если что-то поменялось; стрелки (пустые колонки
--     перепрыгивает), держа задачу — перенос
-- grab(desk) — Enter: взять или положить выбранную
-- board_text(desk) -> текст для ответа по сети (с пунктами задач)
-- add_item(desk, number, text, stamp) -> номер пункта; NoSuchTask
-- tick_item(desk, number, item, stamp) -> сделано ли теперь; NoSuchTask, NoSuchItem
-- items_of / events_of(desk, number) -> пункты / события; done_count(items)
-- note_event(desk, number, stamp, text) — событие в журнал задачи; NoSuchTask
-- messages_of(desk, number) -> сообщения; post(desk, number, stamp, author,
--     text) -> номер сообщения; NoSuchTask
-- open_task(desk) — открыть выбранную; walk_items(desk, scan) -> yes, если сдвинулся

use core.str
use core.group

COLUMN_NAMES = ["Надо", "Делаю", "Готово"]
SCAN_UP = 1
SCAN_DOWN = 2
SCAN_RIGHT = 3
SCAN_LEFT = 4
STARTING = [
    [0, "Агент 11: глухота RTL8111"],
    [0, "Wi-Fi: WMI_INIT и MAC-адрес"],
    [0, "Wi-Fi: поиск сетей"],
    [0, "Баг имён модулей и локальных"],
    [0, "Битовые операции у чисел"],
    [0, "64-битные и дробные числа"],
    [0, "Шапки во всех файлах"],
    [1, "Доска задач на Acer"],
    [2, "Комментарии -- в шапке"],
    [2, "Wi-Fi: прошивка и паспорт"],
    [2, "Раскладка uefi_x86_64"],
    [2, "Агент 10: жизнь без кабеля"]
]

Board = Box {
    names = [],
    columns = [],
    items = [],
    events = [],
    messages = [],
    selected = 1,
    holding = no,
    opened = 0,
    cursor = 0
}

skill starting_board() {
    @desk = Board {}
    drum (STARTING) { put_task(desk, group.get(beat, 0), group.get(beat, 1)) }
    out desk
}

skill column_word(word) {
    @low = str.lower(word)
    (low == "0") { out 0 }
    (low == "1") { out 1 }
    (low == "2") { out 2 }
    (low == "надо") { out 0 }
    (low == "делаю") { out 1 }
    (low == "готово") { out 2 }
    (low == "todo") { out 0 }
    (low == "doing") { out 1 }
    (low == "done") { out 2 }
    out -1
}

skill put_task(desk, column, name) {
    desk.names = group.add(desk.names, name)
    desk.columns = group.add(desk.columns, column)
    desk.items = group.add(desk.items, [])
    desk.events = group.add(desk.events, [])
    desk.messages = group.add(desk.messages, [])
    out group.count(desk.names)
}

skill messages_of(desk, number) {
    (number < 1) { out error.NoSuchTask }
    (number > group.count(desk.messages)) { out error.NoSuchTask }
    out group.get(desk.messages, number - 1)
}

skill post(desk, number, stamp, author, text) {
    @list = group.add(messages_of(desk, number), [stamp, author, text])
    desk.messages = group.replaced(desk.messages, number - 1, list)
    out group.count(list)
}

skill events_of(desk, number) {
    (number < 1) { out error.NoSuchTask }
    (number > group.count(desk.events)) { out error.NoSuchTask }
    out group.get(desk.events, number - 1)
}

skill note_event(desk, number, stamp, text) {
    @list = group.add(events_of(desk, number), [stamp, text])
    desk.events = group.replaced(desk.events, number - 1, list)
    out none
}

skill items_of(desk, number) {
    (number < 1) { out error.NoSuchTask }
    (number > group.count(desk.items)) { out error.NoSuchTask }
    out group.get(desk.items, number - 1)
}

skill add_item(desk, number, text, stamp) {
    @list = group.add(items_of(desk, number), [no, text, stamp])
    desk.items = group.replaced(desk.items, number - 1, list)
    out group.count(list)
}

skill tick_item(desk, number, item, stamp) {
    @list = items_of(desk, number)
    (item < 1) { out error.NoSuchItem }
    (item > group.count(list)) { out error.NoSuchItem }
    @old = group.get(list, item - 1)
    @done = group.get(old, 0) == no
    desk.items = group.replaced(desk.items, number - 1, group.replaced(list, item - 1, [done, group.get(old, 1), stamp]))
    out done
}

skill done_count(list) {
    @count = 0
    drum (list) { (group.get(beat, 0) == yes) { count = count + 1 } }
    out count
}

skill open_task(desk) {
    (desk.selected < 1) { out none }
    desk.opened = desk.selected
    desk.cursor = 0
    out none
}

skill walk_items(desk, scan) {
    @count = group.count(items_of(desk, desk.opened))
    (scan == SCAN_UP) {
        (desk.cursor > 0) { desk.cursor = desk.cursor - 1 }
        out yes
    }
    (scan == SCAN_DOWN) {
        (desk.cursor < count - 1) { desk.cursor = desk.cursor + 1 }
        out yes
    }
    out no
}

skill shift_task(desk, number, column) {
    (number < 1) { out no }
    (number > group.count(desk.columns)) { out no }
    (column < 0) { out no }
    (column > 2) { out no }
    @changed = []
    drum (group.count(desk.columns)) {
        pick {
            (beat + 1 == number) { changed = group.add(changed, column) }
            { changed = group.add(changed, group.get(desk.columns, beat)) }
        }
    }
    desk.columns = changed
    out yes
}

skill tasks_in(desk, column) {
    @found = []
    drum (group.count(desk.columns)) {
        (group.get(desk.columns, beat) == column) { found = group.add(found, beat + 1) }
    }
    out found
}

skill place_of(found, number) {
    drum (group.count(found)) {
        (group.get(found, beat) == number) { out beat }
    }
    out -1
}

skill choose(desk, scan) {
    (group.count(desk.names) == 0) { out no }
    @column = group.get(desk.columns, desk.selected - 1)
    @here = tasks_in(desk, column)
    @place = place_of(here, desk.selected)
    (scan == SCAN_UP) {
        (place > 0) { desk.selected = group.get(here, place - 1) }
        out yes
    }
    (scan == SCAN_DOWN) {
        (place < group.count(here) - 1) { desk.selected = group.get(here, place + 1) }
        out yes
    }
    @aim = column
    (scan == SCAN_RIGHT) { aim = column + 1 }
    (scan == SCAN_LEFT) { aim = column - 1 }
    (aim == column) { out no }
    (aim < 0) { out no }
    (aim > 2) { out no }
    (desk.holding == yes) { out shift_task(desk, desk.selected, aim) }
    @there = tasks_in(desk, aim)
    (group.count(there) == 0) {
        aim = aim + (aim - column)
        (aim < 0) { out no }
        (aim > 2) { out no }
        there = tasks_in(desk, aim)
        (group.count(there) == 0) { out no }
    }
    @row = place
    (row > group.count(there) - 1) { row = group.count(there) - 1 }
    desk.selected = group.get(there, row)
    out yes
}

skill grab(desk) {
    desk.holding = desk.holding == no
    out yes
}

skill board_text(desk) {
    @told = ""
    drum (3) {
        @column = beat
        @title = group.get(COLUMN_NAMES, column)
        told = "{told}{title}:\n"
        drum (tasks_in(desk, column)) {
            @number = beat
            @name = group.get(desk.names, number - 1)
            told = "{told}  {number}. {name}\n"
            @list = group.get(desk.items, number - 1)
            drum (group.count(list)) {
                @item = group.get(list, beat)
                @mark = " "
                (group.get(item, 0) == yes) { mark = "x" }
                @place = beat + 1
                @text = group.get(item, 1)
                @when = group.get(item, 2)
                told = "{told}      [{mark}] {place}. {text} · {when}\n"
            }
            drum (group.get(desk.events, number - 1)) {
                @when = group.get(beat, 0)
                @what = group.get(beat, 1)
                told = "{told}      @ {when} {what}\n"
            }
            drum (group.get(desk.messages, number - 1)) {
                @when = group.get(beat, 0)
                @who = group.get(beat, 1)
                @said = group.get(beat, 2)
                told = "{told}      > {when} {who}: {said}\n"
            }
        }
    }
    out told
}
