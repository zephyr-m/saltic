use core.str
use core.num
use core.mem
use core.group
use os.target.uefi_x86_64.graphics
use os.target.uefi_x86_64.lettering
use os.target.uefi_x86_64.tint
use os.target.uefi_x86_64.sans

QUESTION = 31
EXTRA = [8212, 8211, 171, 187, 215, 8230, 176, 8470]
EXTRA_FIRST = 161
LEVELS = 15

skill sans_index(code) {
    (code > 31) {
        (code < 127) { out code - 32 }
    }
    (code > 1039) {
        (code < 1104) { out 95 + code - 1040 }
    }
    (code == 1025) { out 159 }
    (code == 1105) { out 160 }
    drum (group.count(EXTRA)) {
        (group.get(EXTRA, beat) == code) { out EXTRA_FIRST + beat }
    }
    out QUESTION
}

skill text_bytes(text) {
    @bytes = []
    drum (str.len(text)) { bytes = group.add(bytes, str.byte(text, beat)) }
    out bytes
}

skill measure(text) {
    @bytes = text_bytes(text)
    @pen = 0
    @index = 0
    drum (group.count(bytes)) {
        (index < group.count(bytes)) {
            @point = lettering.decode(bytes, index)
            pen = pen + group.get(sans.ADVANCE, sans_index(point.value))
            index = index + point.width
        }
    }
    out pen / 16
}

skill draw_glyph(screen, x, y, glyph, ink) {
    @width = group.get(sans.WIDTH, glyph)
    @pixels = group.get(sans.PIXELS, glyph)
    @solid = tint.paint(screen, ink)
    drum (group.get(sans.HEIGHT, glyph)) {
        @row = beat
        @line = ((y + row) * screen.stride + x) * graphics.PIXEL_BYTES
        drum (width) {
            @level = num.hex_value(str.get(pixels, row * width + beat))
            @at = line + beat * graphics.PIXEL_BYTES
            (level == LEVELS) { mem.store32(screen.memory, at, solid) }
            (level > 0) {
                (level < LEVELS) {
                    @under = tint.unpack(screen, mem.load32(screen.memory, at))
                    mem.store32(screen.memory, at, tint.paint(screen, tint.mix(under, ink, level, LEVELS)))
                }
            }
        }
    }
    out none
}

skill draw_text(screen, x, y, text, ink) {
    @bytes = text_bytes(text)
    @pen = x * 16
    @index = 0
    drum (group.count(bytes)) {
        (index < group.count(bytes)) {
            @point = lettering.decode(bytes, index)
            @glyph = sans_index(point.value)
            draw_glyph(screen, (pen + 8) / 16 + group.get(sans.LEFT, glyph), y + sans.ASCENT + group.get(sans.TOP, glyph), glyph, ink)
            pen = pen + group.get(sans.ADVANCE, glyph)
            index = index + point.width
        }
    }
    out pen / 16
}
