-- parse — разбор чисел из текста команд UEFI-программ.
--
-- parse_hex(text) -> адрес из 1–15 шестнадцатеричных цифр; BadAddress
-- parse_count(text) -> число 1…64; не число или 0 — 16 (MEMORY_DEFAULT)
-- parse_size(text) -> десятичное число; не число — 0

use core.str
use core.num
use os.target.uefi_x86_64.platform.firmware

MEMORY_DEFAULT = 16
MEMORY_LIMIT = 64

skill parse_hex(text) {
    (str.bytes(text) == 0) { out error.BadAddress }
    (str.bytes(text) > 15) { out error.BadAddress }
    @value = 0
    drum (str.bytes(text)) {
        @digit = num.hex_value(str.get(text, beat))
        (digit < 0) { out error.BadAddress }
        value = value * 16 + digit
    }
    out value
}

skill parse_count(text) {
    @value = 0
    drum (str.bytes(text)) {
        @ch = str.get(text, beat)
        (str.is_digit(ch) == no) { out MEMORY_DEFAULT }
        value = value * 10 + num.digit_value(ch)
    }
    (value < 1) { out MEMORY_DEFAULT }
    (value > MEMORY_LIMIT) { out MEMORY_LIMIT }
    out value
}

skill parse_size(text) {
    @value = 0
    drum (str.bytes(text)) {
        @ch = str.get(text, beat)
        (str.is_digit(ch) == no) { out 0 }
        value = value * 10 + num.digit_value(ch)
    }
    out value
}
