-- uefi — службы прошивки UEFI поверх firmware: консоль, клавиши, время,
-- страницы памяти, запуск образов, перезагрузка. Только x86_64-uefi.
-- base = firmware.guest_base(); адреса — числа; при неудаче вызова
-- навыки отдают пустой Box (Clock {}, Key {}, Console {}), не ошибку.
--
-- Clock { year, month, day, hour, minute, second } — время прошивки (UTC)
-- Launched { outcome = Answer, output = [байты] } — итог запуска образа
-- Key { scan, char, ready } — клавиша; ready = no значит «не было»
-- Console { columns, rows } — размер текстового режима
-- con_out(base) / boot_services(base) -> адреса таблиц прошивки
-- query_mode(base, output, mode) -> Console
-- wide_console(base) -> Console — выбирает самый большой текстовый режим
-- start_image(base, image, size) -> Launched; текст выхода ребёнка — в output
-- exit_output(base, services, size_at, data_at) -> [байты] после первого нуля
-- now(base) -> Clock
-- restart(base) — холодная перезагрузка
-- pages_below_4g(base, pages) -> адрес; MemoryExhausted
-- pages_at_address(base, place, pages) -> yes/no
-- pages_in_window(base, pages) -> адрес в окне выше base; MemoryExhausted
-- free_pages(base, place, pages) -> Answer
-- forget_keys(base) — сброс буфера клавиш
-- poll_key(base, pause) -> Key; pause — микросекунды ожидания после промаха;
--     сначала нажатие из очереди keys (прислано по сети), потом клавиатура
-- wait_key(base) -> Key — ждёт нажатия (с пределом опросов)

use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.keys

SYSTEM_CON_IN = 48
SYSTEM_CON_OUT = 64
INPUT_RESET = 0
INPUT_READ = 8
BOOT_STALL = 248
KEY_AT = 56
POLL_MICROSECONDS = 10000
POLLS = 200000000
SYSTEM_BOOT_SERVICES = 96
SYSTEM_RUNTIME = 88
RUNTIME_GET_TIME = 24
RUNTIME_RESET = 104
RESET_COLD = 0
TIME_BUFFER = 3072
TEXT_QUERY_MODE = 24
TEXT_SET_MODE = 32
TEXT_MODE = 72
BOOT_LOAD_IMAGE = 200
BOOT_START_IMAGE = 208
BOOT_FREE_POOL = 72
BOOT_ALLOCATE_PAGES = 40
BOOT_FREE_PAGES = 48
ALLOCATE_BELOW = 1
ALLOCATE_ADDRESS = 2
WINDOW_STEP = 256
TOP_HALF = 65535
LOADER_DATA = 2
PAGE_AT = 48
EXIT_SIZE_AT = 32
EXIT_DATA_AT = 40
OUTPUT_LIMIT = 1200

Clock = Box {
    year = 0,
    month = 0,
    day = 0,
    hour = 0,
    minute = 0,
    second = 0
}

Launched = Box {
    outcome = firmware.Answer {},
    output = []
}

Key = Box {
    scan = 0,
    char = 0,
    ready = no
}

Console = Box {
    columns = 0,
    rows = 0
}

skill con_out(base) {
    out firmware.pointer(firmware.system_table(), base, SYSTEM_CON_OUT)
}

skill boot_services(base) {
    out firmware.pointer(firmware.system_table(), base, SYSTEM_BOOT_SERVICES)
}

skill query_mode(base, output, mode) {
    @columns_at = firmware.scratch(base, 0)
    @rows_at = firmware.scratch(base, 8)
    @queried = firmware.call(base, firmware.pointer(output, base, TEXT_QUERY_MODE), [output, firmware.number(mode), columns_at, rows_at])
    (queried.failed == yes) { out Console {} }
    out Console { columns = firmware.read16(columns_at, base, 0), rows = firmware.read16(rows_at, base, 0) }
}

skill wide_console(base) {
    @output = con_out(base)
    @modes = firmware.read16(firmware.pointer(output, base, TEXT_MODE), base, 0)
    @best = 0
    @area = 0
    drum (modes) {
        @size = query_mode(base, output, beat)
        (size.columns * size.rows > area) {
            area = size.columns * size.rows
            best = beat
        }
    }
    firmware.call(base, firmware.pointer(output, base, TEXT_SET_MODE), [output, firmware.number(best)])
    out query_mode(base, output, best)
}

skill start_image(base, image, size) {
    @services = boot_services(base)
    @handle_at = firmware.scratch(base, 16)
    @loaded = firmware.call(base, firmware.pointer(services, base, BOOT_LOAD_IMAGE), [firmware.number(0), firmware.image_handle(), firmware.number(0), image, firmware.number(size), handle_at])
    (loaded.failed == yes) { out Launched { outcome = loaded } }
    @child = firmware.pointer(handle_at, base, 0)
    @size_at = firmware.scratch(base, EXIT_SIZE_AT)
    @data_at = firmware.scratch(base, EXIT_DATA_AT)
    firmware.write64(size_at, base, 0, 0)
    firmware.write64(data_at, base, 0, 0)
    @outcome = firmware.call(base, firmware.pointer(services, base, BOOT_START_IMAGE), [child, size_at, data_at])
    out Launched { outcome = outcome, output = exit_output(base, services, size_at, data_at) }
}

skill exit_output(base, services, size_at, data_at) {
    @size = firmware.read16(size_at, base, 0)
    (firmware.read16(size_at, base, 2) > 0) { size = OUTPUT_LIMIT }
    (size == 0) { out [] }
    @data = firmware.pointer(data_at, base, 0)
    @first = 0
    drum (size / 2) {
        (firmware.read16(data, base, beat * 2) == 0) {
            first = beat * 2 + 2
            leave
        }
    }
    @count = size - first
    (count > OUTPUT_LIMIT) { count = OUTPUT_LIMIT }
    @bytes = []
    drum (count) { bytes = group.add(bytes, firmware.read8(data, base, first + beat)) }
    firmware.call(base, firmware.pointer(services, base, BOOT_FREE_POOL), [data])
    out bytes
}

skill now(base) {
    @runtime = firmware.pointer(firmware.system_table(), base, SYSTEM_RUNTIME)
    @at = firmware.scratch(base, TIME_BUFFER)
    @asked = firmware.call(base, firmware.pointer(runtime, base, RUNTIME_GET_TIME), [at, firmware.number(0)])
    (asked.failed == yes) { out Clock {} }
    out Clock {
        year = firmware.read16(at, base, 0),
        month = firmware.read8(at, base, 2),
        day = firmware.read8(at, base, 3),
        hour = firmware.read8(at, base, 4),
        minute = firmware.read8(at, base, 5),
        second = firmware.read8(at, base, 6)
    }
}

skill restart(base) {
    @runtime = firmware.pointer(firmware.system_table(), base, SYSTEM_RUNTIME)
    out firmware.call(base, firmware.pointer(runtime, base, RUNTIME_RESET), [firmware.number(RESET_COLD), firmware.number(0), firmware.number(0), firmware.number(0)])
}

skill pages_below_4g(base, pages) {
    @services = boot_services(base)
    @at = firmware.scratch(base, PAGE_AT)
    firmware.write64(at, base, 0, 4294967295)
    @got = firmware.call(base, firmware.pointer(services, base, BOOT_ALLOCATE_PAGES), [firmware.number(ALLOCATE_BELOW), firmware.number(LOADER_DATA), firmware.number(pages), at])
    (got.failed == yes) { out error.MemoryExhausted }
    @pages_at = firmware.pointer(at, base, 0)
    firmware.guest(pages_at, base) rescue |err| {
        firmware.call(base, firmware.pointer(services, base, BOOT_FREE_PAGES), [pages_at, firmware.number(pages)])
        out err
    }
    out pages_at
}

skill free_pages(base, place, pages) {
    out firmware.call(base, firmware.pointer(boot_services(base), base, BOOT_FREE_PAGES), [place, firmware.number(pages)])
}

skill pages_at_address(base, place, pages) {
    @at = firmware.scratch(base, PAGE_AT)
    firmware.write64(at, base, 0, place)
    @got = firmware.call(base, firmware.pointer(boot_services(base), base, BOOT_ALLOCATE_PAGES), [firmware.number(ALLOCATE_ADDRESS), firmware.number(LOADER_DATA), firmware.number(pages), at])
    out got.failed == no
}

skill pages_in_window(base, pages) {
    @anywhere = pages_below_4g(base, pages) rescue |err| { 0 }
    (anywhere > 0) { out anywhere }
    @span = (pages * 4096 + 65535) / 65536
    @high = (base / firmware.PAGE / WINDOW_STEP + 1) * WINDOW_STEP
    drum ((TOP_HALF - high) / WINDOW_STEP) {
        (high + span > TOP_HALF) { out error.MemoryExhausted }
        @place = high * firmware.PAGE
        (pages_at_address(base, place, pages) == yes) { out place }
        high = high + WINDOW_STEP
    }
    out error.MemoryExhausted
}

skill forget_keys(base) {
    @input = firmware.pointer(firmware.system_table(), base, SYSTEM_CON_IN)
    out firmware.call(base, firmware.pointer(input, base, INPUT_RESET), [input, firmware.number(0)])
}

skill poll_key(base, pause) {
    @sent = keys.pop(base)
    ((sent == none) == no) { out Key { scan = group.get(sent, 0), char = group.get(sent, 1), ready = yes } }
    @input = firmware.pointer(firmware.system_table(), base, SYSTEM_CON_IN)
    @at = firmware.scratch(base, KEY_AT)
    @got = firmware.call(base, firmware.pointer(input, base, INPUT_READ), [input, at])
    (got.failed == no) { out Key { scan = firmware.read16(at, base, 0), char = firmware.read16(at, base, 2), ready = yes } }
    (pause > 0) { firmware.call(base, firmware.pointer(boot_services(base), base, BOOT_STALL), [firmware.number(pause)]) }
    out Key {}
}

skill wait_key(base) {
    drum (POLLS) {
        @key = poll_key(base, POLL_MICROSECONDS)
        (key.ready == yes) { out key }
    }
    out Key {}
}
