-- pci — перечисление устройств PCI через окно ECAM (firmware.ecam) в текст.
--
-- class_name(code) -> имя класса по коду (старшие 16 бит класса) или ""
-- function_line(base, config, bus, device, function) -> строка
--     "bus:dev.fn  vendor:model  class code  имя"
-- device_lines(base, space) -> [строки] по всем шинам space; у устройства
--     без многофункционального бита смотрит только функцию 0

use io
use core.group
use os.target.uefi_x86_64.platform.firmware

skill class_name(code) {
    (code == 512) { out "Ethernet" }
    (code == 640) { out "Network (Wi-Fi?)" }
    (code == 768) { out "VGA" }
    (code == 770) { out "3D controller" }
    (code == 1027) { out "Audio" }
    (code == 1536) { out "Host bridge" }
    (code == 1537) { out "ISA bridge" }
    (code == 1540) { out "PCI bridge" }
    (code == 262) { out "SATA" }
    (code == 264) { out "NVMe" }
    (code == 3075) { out "USB" }
    (code == 3077) { out "SMBus" }
    (code == 1920) { out "Communication" }
    (code == 4480) { out "Signal processing" }
    (code == 2176) { out "System peripheral" }
    out ""
}

skill function_line(base, config, bus, device, function) {
    @b = firmware.hex(bus, 2)
    @d = firmware.hex(device, 2)
    @v = firmware.hex(firmware.read16(config, base, 0), 4)
    @m = firmware.hex(firmware.read16(config, base, 2), 4)
    @class = firmware.read16(config, base, 10)
    @c = firmware.hex(class, 4)
    @name = class_name(class)
    out "{b}:{d}.{function}  {v}:{m}  class {c}  {name}"
}

skill device_lines(base, space) {
    @found = []
    drum (space.last - space.first + 1) {
        @bus = space.first + beat
        drum (32) {
            @device = beat
            drum (8) {
                @function = beat
                @config = firmware.function_config(space, bus, device, function)
                @vendor = firmware.read16(config, base, 0)
                (vendor == firmware.NO_DEVICE) {
                    (function == 0) { leave }
                }
                ((vendor == firmware.NO_DEVICE) == no) {
                    found = group.add(found, function_line(base, config, bus, device, function))
                    (function == 0) {
                        (firmware.read8(config, base, 14) < 128) { leave }
                    }
                }
            }
        }
    }
    out found
}
