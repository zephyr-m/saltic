-- firmware — физическая память и вызовы прошивки для UEFI-программ:
-- сниппеты, драйверы, графика. Только x86_64-uefi.
-- Физический адрес — обычное число (61 бит, с 06.11.2026; было Phys { hi, lo }
-- по 16 бит и только ниже 4 ГБ). Программа живёт в окне: base =
-- guest_base() — начало её памяти, берётся один раз; mem.* получает смещение
-- от base парой [hi, lo] (guest).
--
-- guest_base() -> base
-- number(value) -> адрес (то же число; осталось от Phys)
-- add(p, offset) / sum(a, b) / align(p, boundary) -> адрес
-- hex(value, digits) / phys_text(p) -> текст
-- guest(p, base) -> [hi, lo] для core.mem; ниже base — BelowGuestBase
-- read8 / read16 / read32(p, base, offset) -> число
-- pointer(p, base, offset) -> адрес, 64 бита
-- write8 / write16 / write_phys32(p, base, offset, value)
-- write64(p, base, offset, value) — 64 бита
-- write_wide(p, base, offset, low, high) — 64 бита из двух 32-битных половин
-- system_table() / image_handle() -> адрес
-- find_rsdp(base) -> адрес; NoAcpi20
-- find_mcfg(base, rsdp) -> адрес; NoMcfg
-- ecam(base) -> Ecam { start, first, last } — окно PCI
-- function_config(space, bus, device, function) -> адрес конфига PCI
-- find_device(base, space, vendor, model) -> адрес конфига; DeviceNotFound
-- call(base, function, [адрес…]) -> Answer { value, failed }; до 10 аргументов
-- call_wide(base, function, arguments, highs) — то же, highs — добавки к старшим
--     32 битам (2^63 и выше в 61-битное число не влезают)
-- scratch(base, offset) -> адрес памяти для ответов прошивки (участок "scratch")
-- arena(base) -> адрес служебной арены, выровнен на 256
-- region(base, name) -> адрес участка арены по реестру arena_map; UnknownRegion
--
-- Пример — uefi.now. Грабли: буферы для железа выравнивать через align;
-- чтение MMIO по неизвестному адресу может повесить машину. Место в арене
-- берётся только через region — смещения вне arena_map запрещены.

use core.cpu
use core.mem
use core.num
use core.str
use core.group
use os.target.uefi_x86_64.platform.arena_map

PAGE = 65536
WORD = 4294967296
ACPI20_GUID_LOW = 59505
ACPI20_GUID_HIGH = 34920
ACPI20_GUID_DATA2 = 58609
SIGNATURE_MC = 17229
SIGNATURE_FG = 18246
NO_DEVICE = 65535
CALL_RESULT = 96
CALL_ARGUMENTS = 10

Answer = Box {
    value = 0,
    failed = no
}

Ecam = Box {
    start = 0,
    first = 0,
    last = 0
}

skill hex(value, digits) {
    @text = ""
    @rest = value
    drum (digits) {
        text = str.concat(num.hex_digit(num.mod(rest, 16)), text)
        rest = rest / 16
    }
    out text
}

skill phys_text(p) {
    (p < WORD) { out hex(p, 8) }
    out hex(p, 12)
}

skill add(p, offset) {
    out p + offset
}

skill pieces(first) {
    out ((cpu.firmware(first + 3) * PAGE + cpu.firmware(first + 2)) * PAGE + cpu.firmware(first + 1)) * PAGE + cpu.firmware(first)
}

skill guest_base() {
    out pieces(0)
}

skill guest(p, base) {
    @offset = p - base
    (offset < 0) { out error.BelowGuestBase }
    out [offset / PAGE, num.mod(offset, PAGE)]
}

skill read8(p, base, offset) {
    out mem.load8(guest(add(p, offset), base), 0)
}

skill read16(p, base, offset) {
    out mem.load16(guest(add(p, offset), base), 0)
}

skill read32(p, base, offset) {
    out read16(p, base, offset + 2) * PAGE + read16(p, base, offset)
}

skill write16(p, base, offset, value) {
    out mem.store16(guest(add(p, offset), base), 0, value)
}

skill write8(p, base, offset, value) {
    out mem.store8(guest(add(p, offset), base), 0, value)
}

skill write_phys32(p, base, offset, value) {
    out mem.store_address32(guest(add(p, offset), base), 0, [value / PAGE, num.mod(value, PAGE)])
}

skill sum(a, b) {
    out a + b
}

skill align(p, boundary) {
    @rest = num.mod(p, boundary)
    (rest == 0) { out p }
    out p + boundary - rest
}

skill arena(base) {
    out align(base + mem.arena(1) * PAGE + mem.arena(0), 256)
}

skill pointer(p, base, offset) {
    out read32(p, base, offset + 4) * WORD + read32(p, base, offset)
}

skill system_table() {
    out pieces(4)
}

skill find_rsdp(base) {
    @table = system_table()
    @count = read16(table, base, 104)
    @entries = pointer(table, base, 112)
    drum (count) {
        @entry = add(entries, beat * 24)
        (read16(entry, base, 0) == ACPI20_GUID_LOW) {
            (read16(entry, base, 2) == ACPI20_GUID_HIGH) {
                (read16(entry, base, 4) == ACPI20_GUID_DATA2) { out pointer(entry, base, 16) }
            }
        }
    }
    out error.NoAcpi20
}

skill find_mcfg(base, rsdp) {
    @xsdt = pointer(rsdp, base, 24)
    @length = read16(xsdt, base, 4) + read16(xsdt, base, 6) * PAGE
    drum ((length - 36) / 8) {
        @table = pointer(xsdt, base, 36 + beat * 8)
        (read16(table, base, 0) == SIGNATURE_MC) {
            (read16(table, base, 2) == SIGNATURE_FG) { out table }
        }
    }
    out error.NoMcfg
}

skill ecam(base) {
    @mcfg = find_mcfg(base, find_rsdp(base))
    out Ecam { start = pointer(mcfg, base, 44), first = read8(mcfg, base, 54), last = read8(mcfg, base, 55) }
}

skill function_config(space, bus, device, function) {
    out add(space.start, bus * 1048576 + device * 32768 + function * 4096)
}

skill find_device(base, space, vendor, model) {
    drum (space.last - space.first + 1) {
        @bus = space.first + beat
        drum (32) {
            @device = beat
            drum (8) {
                @config = function_config(space, bus, device, beat)
                @found = read16(config, base, 0)
                (found == NO_DEVICE) {
                    (beat == 0) { leave }
                }
                (found == vendor) {
                    (read16(config, base, 2) == model) { out config }
                }
            }
        }
    }
    out error.DeviceNotFound
}

skill image_handle() {
    out pieces(8)
}

skill number(value) {
    out value
}

skill write64(p, base, offset, value) {
    out write_wide(p, base, offset, num.mod(value, WORD), value / WORD)
}

skill write_wide(p, base, offset, low, high) {
    write_phys32(p, base, offset, low)
    out write_phys32(p, base, offset + 4, high)
}

skill region(base, name) {
    @found = arena_map.region(name)
    out add(arena(base), found.at)
}

skill scratch(base, offset) {
    out add(region(base, "scratch"), offset)
}

skill call(base, function, arguments) {
    out call_wide(base, function, arguments, [])
}

skill call_wide(base, function, arguments, highs) {
    @block = region(base, "calls")
    write64(block, base, 0, function)
    write64(block, base, 8, number(group.count(arguments)))
    drum (CALL_ARGUMENTS) {
        @value = 0
        @high = 0
        (beat < group.count(arguments)) { value = group.get(arguments, beat) }
        (beat < group.count(highs)) { high = group.get(highs, beat) }
        write_wide(block, base, 16 + beat * 8, num.mod(value, WORD), value / WORD + high)
    }
    @at = guest(block, base)
    cpu.call(group.get(at, 0), group.get(at, 1))
    out Answer { value = read32(block, base, CALL_RESULT), failed = read16(block, base, CALL_RESULT + 6) > 32767 }
}
