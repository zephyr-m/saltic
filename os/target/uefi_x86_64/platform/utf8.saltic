-- utf8 — байт в текст: в Saltic нет символа по коду байта, но строка — это
-- байты UTF-8, и str.get отдаёт один байт строкой. Нужный байт берётся из
-- литерала, где он уже есть: ASCII — из таблицы печатных, кириллица (D0, D1,
-- 80–BF) — из алфавита. Склеенные подряд байты дают обычный русский текст.
--
-- byte_text(code) -> строка из одного байта; неизвестный байт — "?"
-- decode(bytes, first, count) -> текст из группы байтов
-- encode(text) -> группа байтов строки

use core.str
use core.group

ASCII = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|\}~"
CYRILLIC = "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдежзийклмнопрстуфхцчшщъыьэюяЁё№«»—–…"
NEWLINE = "\n"

skill byte_text(code) {
    (code == 10) { out NEWLINE }
    (code > 31) {
        (code < 127) { out str.get(ASCII, code - 32) }
    }
    drum (str.bytes(CYRILLIC)) {
        (str.byte(CYRILLIC, beat) == code) { out str.get(CYRILLIC, beat) }
    }
    out "?"
}

skill decode(bytes, first, count) {
    @found = ""
    drum (count) { found = str.concat(found, byte_text(group.get(bytes, first + beat))) }
    out found
}

skill encode(words) {
    @found = []
    drum (str.bytes(words)) { found = group.add(found, str.byte(words, beat)) }
    out found
}
