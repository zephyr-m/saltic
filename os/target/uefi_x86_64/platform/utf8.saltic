-- utf8 — байты и текст: строка — это байты UTF-8, str.from_byte даёт один
-- байт строкой. Склеенные подряд байты дают обычный русский текст.
--
-- byte_text(code) -> строка из одного байта 0…255
-- decode(bytes, first, count) -> текст из группы байтов
-- encode(text) -> группа байтов строки

use core.str
use core.group

skill byte_text(code) {
    out str.from_byte(code)
}

skill decode(bytes, first, count) {
    @found = ""
    drum (count) { found = str.concat(found, byte_text(group.get(bytes, first + beat))) }
    out found
}

skill encode(words) {
    @found = []
    drum (str.bytes(words)) { found = group.add(found, str.byte(words, beat)) }
    out found
}
