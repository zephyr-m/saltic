use seed
use os.drivers.graphics
use os.drivers.font
use os.drivers.keyboard
use os.drivers.text_field
use os.drivers.uart
use os.console

program() {
    @screen = graphics.graphics_open() rescue |err| {
        uart.uart_line("ошибка буфера кадра")
        out err
    }

    graphics.graphics_fill(screen, graphics.Ink.BACKGROUND)
    graphics.graphics_rect(screen, 128, 96, 1024, 528, graphics.Ink.FOREGROUND)
    graphics.graphics_rect(screen, 160, 128, 960, 464, graphics.Ink.BACKGROUND)
    graphics.graphics_rect(screen, 224, 176, 832, 368, graphics.Ink.FOREGROUND)
    graphics.graphics_rect(screen, 256, 208, 768, 304, graphics.Ink.BACKGROUND)
    font.graphics_text(screen, 622, 302, "SALTIC", 1, graphics.Ink.FOREGROUND)
    font.graphics_text(screen, 592, 322, "BARE METAL RV32I", 1, graphics.Ink.FOREGROUND)

    @keyboard_device = keyboard.keyboard_open()
    (keyboard_device.ready == no) {
        uart.uart_line(seed.str.add("ошибка клавиатуры, этап ", seed.num.text(keyboard_device.status)))
        out error.KeyboardUnavailable
    }
    @field = text_field.text_field_new(340, 360, 600)
    text_field.text_field_draw(screen, field)
    @terminal = console.console_open()

    uart.uart_line("клавиатура Saltic готова")
    drum (268435455) {
        drum (268435455) {
            terminal = console.console_poll(terminal) rescue |err| {
                seed.io.show("ошибка консоли: ", err)
                out err
            }
            @event = keyboard.keyboard_poll(keyboard_device) rescue |err| {
                seed.io.show("ошибка клавиатуры: ", err)
                out keyboard.KeyEvent {}
            }
            (event.ready == yes) {
                (event.value > 0) {
                    field = text_field.text_field_key(field, event.code, keyboard_device.shift)
                    text_field.text_field_draw(screen, field)
                }
            }
        }
    }

    out none
}
