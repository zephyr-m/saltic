use seed
use os.apps.launcher
use os.drivers.framebuffer
use os.drivers.graphics
use os.drivers.keyboard
use os.drivers.pointer
use os.drivers.sound
use os.drivers.timer
use os.drivers.uart

program() {
    @screen = graphics.graphics_open() rescue |err| {
        uart.uart_line("ошибка буфера кадра")
        out err
    }

    @keyboard_device = keyboard.keyboard_open()
    (keyboard_device.ready == no) {
        uart.uart_line(seed.str.add("ошибка клавиатуры, этап ", seed.num.text(keyboard_device.status)))
        out error.KeyboardUnavailable
    }
    @pointer_device = pointer.pointer_open(framebuffer.FRAMEBUFFER_WIDTH, framebuffer.FRAMEBUFFER_HEIGHT)
    (pointer_device.ready == no) {
        uart.uart_line(seed.str.add("ошибка мыши, этап ", seed.num.text(pointer_device.status)))
        out error.PointerUnavailable
    }

    @sound_device = sound.sound_open()
    (sound_device.ready == yes) {
        uart.uart_line("звук Saltic готов")
    }
    (sound_device.ready == no) {
        uart.uart_line(seed.str.add("звук недоступен, этап ", seed.num.text(sound_device.status)))
    }
    @shell = launcher.new(screen, sound_device)
    launcher.draw(screen, shell)
    pointer_device = pointer.pointer_cursor_show(screen, pointer_device)

    uart.uart_line("лаунчер Saltic готов")
    drum (268435455) {
        drum (268435455) {
            sound.sound_update(shell.sound_device)
            @event = keyboard.keyboard_poll(keyboard_device) rescue |err| {
                seed.io.show("ошибка клавиатуры: ", err)
                out keyboard.KeyEvent {}
            }
            (event.ready == yes) {
                (event.type == keyboard.VIRTIO_EVENT_KEY) {
                    pointer_device = pointer.pointer_cursor_hide(screen, pointer_device)
                    shell = launcher.key(screen, shell, event.code, keyboard_device.shift, event.value)
                    pointer_device = pointer.pointer_cursor_show(screen, pointer_device)
                }
            }

            @pointer_event = pointer.pointer_poll(pointer_device)
            (pointer_event.ready == yes) {
                @pointer_changed = pointer_event.moved
                (pointer_event.pressed == yes) { pointer_changed = yes }
                (pointer_event.released == yes) { pointer_changed = yes }
                (pointer_changed == yes) {
                    pointer_device = pointer.pointer_cursor_hide(screen, pointer_device)
                    (pointer_event.pressed == yes) {
                        shell = launcher.click(screen, shell, pointer_event.x, pointer_event.y)
                    }
                    (pointer_event.released == yes) {
                        shell = launcher.release(screen, shell, pointer_event.x, pointer_event.y)
                    }
                    pointer_device = pointer.pointer_cursor_show(screen, pointer_device)
                }
            }

            @now = timer.timer_now()
            (launcher.tick_due(shell, now) == yes) {
                pointer_device = pointer.pointer_cursor_hide(screen, pointer_device)
                shell = launcher.tick(screen, shell, now)
                pointer_device = pointer.pointer_cursor_show(screen, pointer_device)
            }
            sound.sound_update(shell.sound_device)
        }
    }

    out none
}
