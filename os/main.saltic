use seed
use os.drivers.framebuffer
use os.drivers.graphics
use os.drivers.keyboard
use os.drivers.pointer
use os.drivers.uart
use os.console
use os.ui.jtml

program() {
    @screen = graphics.graphics_open() rescue |err| {
        uart.uart_line("ошибка буфера кадра")
        out err
    }

    @header = jtml.frame(jtml.Flow.ROW, 0, 56, 0, 12, 16, 2, [
        jtml.text_scaled("SALTIC", 2),
        jtml.space(1),
        jtml.text("CELL 01  ALIVE")
    ])
    @navigation = jtml.frame(jtml.Flow.COLUMN, 224, 0, 0, 16, 20, 2, [
        jtml.text_scaled("WORKSPACE", 2),
        jtml.text("> CELLS"),
        jtml.text("  MEMORY"),
        jtml.text("  EVENTS"),
        jtml.space(1),
        jtml.text("RV32I")
    ])
    @workspace = jtml.frame(jtml.Flow.COLUMN, 0, 0, 1, 24, 16, 2, [
        jtml.text_scaled("CELL WORKSPACE", 2),
        jtml.space(1),
        jtml.label("CELL 01 IS ALIVE", 2, jtml.Align.CENTER),
        jtml.label("WAITING FOR A RULE", 1, jtml.Align.CENTER),
        jtml.space(1)
    ])
    @body = jtml.frame(jtml.Flow.ROW, 0, 0, 1, 0, 16, 0, [
        navigation,
        workspace
    ])
    @command = jtml.frame(jtml.Flow.ROW, 0, 87, 0, 8, 12, 2, [
        jtml.text_scaled(">", 2),
        jtml.field_grow("command", ""),
        jtml.text("PULSE 000001")
    ])
    @view = jtml.frame(jtml.Flow.COLUMN, 0, 0, 0, 32, 16, 0, [
        header,
        body,
        command
    ])
    @ui = jtml.mount(screen, view)
    jtml.draw(screen, ui)

    @keyboard_device = keyboard.keyboard_open()
    (keyboard_device.ready == no) {
        uart.uart_line(seed.str.add("ошибка клавиатуры, этап ", seed.num.text(keyboard_device.status)))
        out error.KeyboardUnavailable
    }
    @pointer_device = pointer.pointer_open(framebuffer.FRAMEBUFFER_WIDTH, framebuffer.FRAMEBUFFER_HEIGHT)
    (pointer_device.ready == no) {
        uart.uart_line(seed.str.add("ошибка мыши, этап ", seed.num.text(pointer_device.status)))
        out error.PointerUnavailable
    }
    pointer_device = pointer.pointer_cursor_show(screen, pointer_device)
    @terminal = console.console_open()

    uart.uart_line("клавиатура и мышь Saltic готовы")
    drum (268435455) {
        drum (268435455) {
            terminal = console.console_poll(terminal) rescue |err| {
                seed.io.show("ошибка консоли: ", err)
                out err
            }
            @event = keyboard.keyboard_poll(keyboard_device) rescue |err| {
                seed.io.show("ошибка клавиатуры: ", err)
                out keyboard.KeyEvent {}
            }
            (event.ready == yes) {
                (event.type == keyboard.VIRTIO_EVENT_KEY) {
                    (event.value > 0) {
                        pointer_device = pointer.pointer_cursor_hide(screen, pointer_device)
                        ui = jtml.key(ui, event.code, keyboard_device.shift)
                        jtml.draw_focused(screen, ui)
                        pointer_device = pointer.pointer_cursor_show(screen, pointer_device)
                    }
                }
            }
            @pointer_event = pointer.pointer_poll(pointer_device)
            (pointer_event.ready == yes) {
                @pointer_changed = pointer_event.moved
                (pointer_event.pressed == yes) { pointer_changed = yes }
                (pointer_event.released == yes) { pointer_changed = yes }
                (pointer_changed == yes) {
                    pointer_device = pointer.pointer_cursor_hide(screen, pointer_device)
                    (pointer_event.pressed == yes) {
                        ui = jtml.focus_at(ui, pointer_event.x, pointer_event.y)
                    }
                    pointer_device = pointer.pointer_cursor_show(screen, pointer_device)
                }
            }
        }
    }

    out none
}
