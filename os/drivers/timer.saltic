use seed

MTIME_ADDRESS = [512, 0]
MTIME_LOW_OFFSET = 49144
TIMER_WRAP_LAST = 268435455

skill timer_now() {
    @raw = seed.mem.load32(MTIME_ADDRESS, MTIME_LOW_OFFSET)
    (raw < 0) { out raw + TIMER_WRAP_LAST + 1 }
    out raw
}

skill timer_elapsed(before, now) {
    (now < before) { out TIMER_WRAP_LAST - before + now + 1 }
    out now - before
}
