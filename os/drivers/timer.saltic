-- timer — счётчик времени qemu-virt: младшее слово CLINT mtime (0x200BFF8).
-- Берутся младшие биты в пределах обычного числа (time.COUNTER_LAST).
--
-- timer_now() -> число тиков; разница — через time.elapsed

use core.mem
use core.time
use core.num
use core.u32
use core.usize
use core.bits32
use core.group
use core.address

MTIME_ADDRESS = [512, 0]
MTIME_LOW_OFFSET = 49144

skill timer_now() {
    @raw = bits32.from(mem.load32(timer_place(MTIME_ADDRESS), usize.from(MTIME_LOW_OFFSET)))
    out num.from(bits32.and(raw, bits32.from(time.COUNTER_LAST)))
}

skill timer_place(pair) {
    out address.from(u32.from(group.get(pair, 0)) * u32.from(65536) + u32.from(group.get(pair, 1)))
}

