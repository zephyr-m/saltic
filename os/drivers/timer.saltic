-- timer — счётчик времени qemu-virt: младшее слово CLINT mtime (0x200BFF8).
-- Отрицательное чтение разворачивается в положительное через time.COUNTER_LAST.
--
-- timer_now() -> число тиков; разница — через time.elapsed

use core.mem
use core.time

MTIME_ADDRESS = [512, 0]
MTIME_LOW_OFFSET = 49144

skill timer_now() {
    @raw = mem.load32(MTIME_ADDRESS, MTIME_LOW_OFFSET)
    (raw < 0) { out raw + time.COUNTER_LAST + 1 }
    out raw
}
