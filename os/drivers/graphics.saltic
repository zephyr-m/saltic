-- graphics — двухцветная растровая графика поверх framebuffer: кремовый фон
-- и какао-передний план (Ink). Координаты в пикселях, выход за экран — тихо.
--
-- Ink — BACKGROUND / FOREGROUND
-- Screen { memory, width, height }
-- graphics_open() -> Screen; ошибки framebuffer_open
-- graphics_color(ink) -> число цвета
-- graphics_pixel(screen, x, y, ink) — точка
-- graphics_toggle_pixel(screen, x, y) — инверсия точки (курсор мыши)
-- graphics_fill(screen, ink) — весь экран
-- graphics_rect(screen, x, y, width, height, ink) — закрашенный прямоугольник
-- graphics_frame(screen, x, y, width, height, thickness, ink) — рамка
-- graphics_line(screen, x0, y0, x1, y1, ink) — отрезок (Брезенхем)
-- graphics_triangle(screen, x0, y0, x1, y1, x2, y2, ink) — закрашенный
-- graphics_abs(value) -> модуль числа

use core.mem
use os.drivers.framebuffer

Ink = enum {
    BACKGROUND,
    FOREGROUND,
}

GRAPHICS_CREAM = 16446696
GRAPHICS_CACAO = 3418660

Screen = Box {
    memory = [],
    width = 0,
    height = 0
}

skill graphics_open() {
    @memory = framebuffer.framebuffer_open()
    out Screen {
        memory = memory,
        width = framebuffer.FRAMEBUFFER_WIDTH,
        height = framebuffer.FRAMEBUFFER_HEIGHT
    }
}

skill graphics_color(ink) {
    (ink == Ink.FOREGROUND) {
        out GRAPHICS_CACAO
    }
    out GRAPHICS_CREAM
}

skill graphics_pixel(screen, x, y, ink) {
    @inside = yes
    (x < 0) { inside = no }
    (y < 0) { inside = no }
    ((x < screen.width) == no) { inside = no }
    ((y < screen.height) == no) { inside = no }

    (inside == yes) {
        framebuffer.framebuffer_store(screen.memory, x, y, graphics_color(ink))
    }
    out none
}

skill graphics_toggle_pixel(screen, x, y) {
    @inside = yes
    (x < 0) { inside = no }
    (y < 0) { inside = no }
    ((x < screen.width) == no) { inside = no }
    ((y < screen.height) == no) { inside = no }

    (inside == yes) {
        @color = framebuffer.framebuffer_load(screen.memory, x, y)
        @next = GRAPHICS_CACAO
        (color == GRAPHICS_CACAO) { next = GRAPHICS_CREAM }
        framebuffer.framebuffer_store(screen.memory, x, y, next)
    }
    out none
}

skill graphics_fill(screen, ink) {
    @color = graphics_color(ink)
    @count = screen.width * screen.height
    drum (count) {
        mem.store32(screen.memory, beat * 4, color)
    }
    out none
}

skill graphics_rect(screen, x, y, width, height, ink) {
    drum (height) {
        @row = beat
        drum (width) { graphics_pixel(screen, x + beat, y + row, ink) }
    }
    out none
}

skill graphics_frame(screen, x, y, width, height, thickness, ink) {
    graphics_rect(screen, x, y, width, thickness, ink)
    graphics_rect(screen, x, y + height - thickness, width, thickness, ink)
    @middle_height = height - thickness * 2
    (middle_height > 0) {
        graphics_rect(screen, x, y + thickness, thickness, middle_height, ink)
        graphics_rect(screen, x + width - thickness, y + thickness, thickness, middle_height, ink)
    }
    out none
}

skill graphics_abs(value) {
    (value < 0) { out 0 - value }
    out value
}

skill graphics_line(screen, x0, y0, x1, y1, ink) {
    @dx = graphics_abs(x1 - x0)
    @step_x = 1
    (x0 > x1) { step_x = -1 }
    @dy = 0 - graphics_abs(y1 - y0)
    @step_y = 1
    (y0 > y1) { step_y = -1 }
    @error = dx + dy
    @active = yes
    @limit = dx + graphics_abs(dy) + 2
    drum (limit) {
        (active == yes) {
            graphics_pixel(screen, x0, y0, ink)
            @done = x0 == x1
            (done == yes) { done = y0 == y1 }
            (done == yes) { active = no }
            (done == no) {
                @twice = error * 2
                (twice > dy - 1) {
                    error = error + dy
                    x0 = x0 + step_x
                }
                (twice < dx + 1) {
                    error = error + dx
                    y0 = y0 + step_y
                }
            }
        }
    }
    out none
}

skill graphics_triangle(screen, x0, y0, x1, y1, x2, y2, ink) {
    (y0 > y1) {
        @swap_x = x0
        @swap_y = y0
        x0 = x1
        y0 = y1
        x1 = swap_x
        y1 = swap_y
    }
    (y1 > y2) {
        @swap_x = x1
        @swap_y = y1
        x1 = x2
        y1 = y2
        x2 = swap_x
        y2 = swap_y
    }
    (y0 > y1) {
        @swap_x = x0
        @swap_y = y0
        x0 = x1
        y0 = y1
        x1 = swap_x
        y1 = swap_y
    }

    @height = y2 - y0 + 1
    (height < 1) {
        graphics_line(screen, x0, y0, x2, y2, ink)
        out none
    }

    drum (height) {
        @y = y0 + beat
        @long_x = x0
        (y2 > y0) { long_x = x0 + (x2 - x0) * (y - y0) / (y2 - y0) }

        @short_x = x1
        (y < y1) {
            short_x = x0
            (y1 > y0) { short_x = x0 + (x1 - x0) * (y - y0) / (y1 - y0) }
        }
        ((y < y1) == no) {
            (y2 > y1) { short_x = x1 + (x2 - x1) * (y - y1) / (y2 - y1) }
        }

        @left = long_x
        @right = short_x
        (left > right) {
            @swap = left
            left = right
            right = swap
        }
        graphics_rect(screen, left, y, right - left + 1, 1, ink)
    }
    out none
}
