use seed
use os.drivers.graphics
use os.drivers.font
use os.drivers.keymap_us

TEXT_FIELD_LINES = 1
TEXT_FIELD_LINE_STEP = font.BODY_HEIGHT
TEXT_FIELD_PADDING = 12
TEXT_FIELD_CHARACTER_WIDTH = font.BODY_WIDTH
TEXT_FIELD_HEIGHT = TEXT_FIELD_LINES * TEXT_FIELD_LINE_STEP + TEXT_FIELD_PADDING * 2 + 3

TextField = Box {
    x = 0
    y = 0
    width = 0
    text = ""
    cursor_line = 0
    cursor_col = 0
}

skill text_field_new(x, y, width) {
    out TextField {
        x = x
        y = y
        width = width
    }
}

skill text_field_capacity(field) {
    out (field.width - TEXT_FIELD_PADDING * 2) / TEXT_FIELD_CHARACTER_WIDTH
}

skill text_field_cursor_line(text) {
    @byte_count = seed.str.len(text)
    @line = 0
    @index = 0
    @step = 0
    drum (byte_count) {
        (index < byte_count) {
            @codepoint = font.font_decode(text, index)
            (codepoint.value == 10) { line = line + 1 }
            step = codepoint.width
            index = index + step
        }
    }
    out line
}

skill text_field_cursor_col(text) {
    @byte_count = seed.str.len(text)
    @col = 0
    @index = 0
    @step = 0
    drum (byte_count) {
        (index < byte_count) {
            @codepoint = font.font_decode(text, index)
            @is_newline = codepoint.value == 10
            (is_newline) { col = 0 }
            (is_newline == no) { col = col + 1 }
            step = codepoint.width
            index = index + step
        }
    }
    out col
}

skill text_field_sync(field) {
    out TextField {
        x = field.x
        y = field.y
        width = field.width
        text = field.text
        cursor_line = text_field_cursor_line(field.text)
        cursor_col = text_field_cursor_col(field.text)
    }
}

skill text_field_draw(screen, field) {
    graphics.graphics_rect(screen, field.x, field.y, field.width, TEXT_FIELD_HEIGHT, graphics.Ink.BACKGROUND)
    graphics.graphics_frame(screen, field.x, field.y, field.width, TEXT_FIELD_HEIGHT, 2, graphics.Ink.FOREGROUND)
    font.graphics_body_text(screen, field.x + TEXT_FIELD_PADDING, field.y + TEXT_FIELD_PADDING, field.text, graphics.Ink.FOREGROUND)

    @cursor_x = field.x + TEXT_FIELD_PADDING + field.cursor_col * TEXT_FIELD_CHARACTER_WIDTH
    @cursor_y = field.y + TEXT_FIELD_PADDING + field.cursor_line * TEXT_FIELD_LINE_STEP
    graphics.graphics_rect(screen, cursor_x, cursor_y, 2, font.BODY_HEIGHT, graphics.Ink.FOREGROUND)
    out none
}

skill text_field_key(field, code, shift) {
    (code == keymap_us.KEY_BACKSPACE) {
        @length = seed.str.len(field.text)
        (length > 0) {
            @remove = 1
            @last = seed.str.byte(field.text, length - 1)
            @continuation = yes
            (last < 128) { continuation = no }
            (last > 191) { continuation = no }
            (continuation == yes) { remove = 2 }
            out text_field_sync(TextField {
                x = field.x
                y = field.y
                width = field.width
                text = seed.str.slice(field.text, 0, length - remove)
            })
        }
        out field
    }

    (code == keymap_us.KEY_ENTER) {
        out text_field_sync(TextField {
            x = field.x
            y = field.y
            width = field.width
            text = seed.str.add(field.text, "\n")
        })
    }

    @character = keymap_us.keymap_us(code, shift)
    (seed.str.len(character) > 0) {
        @col = text_field_cursor_col(field.text)
        (col < text_field_capacity(field)) {
            out text_field_sync(TextField {
                x = field.x
                y = field.y
                width = field.width
                text = seed.str.add(field.text, character)
            })
        }
    }
    out field
}
