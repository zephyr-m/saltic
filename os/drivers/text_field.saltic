use seed
use os.drivers.graphics
use os.drivers.font
use os.drivers.keymap_us

TEXT_FIELD_HEIGHT = 31
TEXT_FIELD_PADDING = 8
TEXT_FIELD_CHARACTER_WIDTH = 6

TextField = Box {
    x = 0
    y = 0
    width = 0
    text = ""
}

skill text_field_new(x, y, width) {
    out TextField {
        x = x
        y = y
        width = width
    }
}

skill text_field_capacity(field) {
    out (field.width - TEXT_FIELD_PADDING * 2) / TEXT_FIELD_CHARACTER_WIDTH
}

skill text_field_draw(screen, field) {
    graphics.graphics_rect(screen, field.x, field.y, field.width, TEXT_FIELD_HEIGHT, graphics.Ink.FOREGROUND)
    graphics.graphics_rect(screen, field.x + 2, field.y + 2, field.width - 4, TEXT_FIELD_HEIGHT - 4, graphics.Ink.BACKGROUND)
    font.graphics_text(screen, field.x + TEXT_FIELD_PADDING, field.y + 12, field.text, 1, graphics.Ink.FOREGROUND)

    @cursor_x = field.x + TEXT_FIELD_PADDING + seed.str.len(field.text) * TEXT_FIELD_CHARACTER_WIDTH
    graphics.graphics_rect(screen, cursor_x, field.y + 10, 1, 11, graphics.Ink.FOREGROUND)
    out none
}

skill text_field_key(field, code, shift) {
    (code == keymap_us.KEY_BACKSPACE) {
        @length = seed.str.len(field.text)
        (length > 0) { field.text = seed.str.slice(field.text, 0, length - 1) }
        out field
    }

    (code == keymap_us.KEY_ENTER) { out field }

    @character = keymap_us.keymap_us(code, shift)
    (seed.str.len(character) > 0) {
        (seed.str.len(field.text) < text_field_capacity(field)) {
            field.text = seed.str.add(field.text, character)
        }
    }
    out field
}
