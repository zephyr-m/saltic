-- uart — вывод и ввод по UART 16550 в qemu-virt ([4096, 0] = 0x10000000).
-- Запись ждёт готовности передатчика; чтение не блокирует.
--
-- uart_poll() -> принятый байт или -1, если ничего нет
-- uart_put(device, byte) — один байт
-- uart_write(text) — текст без перевода строки
-- uart_line(text) — текст и перевод строки
-- uart_place(pair) -> address пары [hi, lo]

use core.str
use core.mem
use core.num
use core.u8
use core.u32
use core.usize
use core.group
use core.address

UART_ADDRESS = [4096, 0]
UART_DATA = 0
UART_STATUS = 5
UART_READY = 32
UART_RECEIVE_READY = 97

skill uart_place(pair) {
    out address.from(u32.from(group.get(pair, 0)) * u32.from(65536) + u32.from(group.get(pair, 1)))
}

skill uart_poll() {
    @status = num.from(mem.load8(uart_place(UART_ADDRESS), usize.from(UART_STATUS)))
    (status == UART_RECEIVE_READY) { out num.from(mem.load8(uart_place(UART_ADDRESS), usize.from(UART_DATA))) }
    out -1
}

skill uart_put(device, byte) {
    @status = num.from(mem.load8(uart_place(device), usize.from(UART_STATUS)))
    (status < UART_READY) {
        uart_put(device, byte)
        out none
    }

    mem.store8(uart_place(device), usize.from(UART_DATA), u8.from(byte))
    out none
}

skill uart_write(text) {
    @device = UART_ADDRESS
    @count = str.bytes(text)
    drum (count) {
        uart_put(device, str.byte(text, beat))
    }
    out none
}

skill uart_line(text) {
    uart_write(text)
    uart_put(UART_ADDRESS, 10)
    out none
}
