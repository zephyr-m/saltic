use seed

UART_ADDRESS = [4096, 0]
UART_DATA = 0
UART_STATUS = 5
UART_READY = 32
UART_RECEIVE_READY = 97

skill uart_poll() {
    @status = seed.mem.load8(UART_ADDRESS, UART_STATUS)
    (status == UART_RECEIVE_READY) { out seed.mem.load8(UART_ADDRESS, UART_DATA) }
    out 0 - 1
}

skill uart_put(device, byte) {
    @status = seed.mem.load8(device, UART_STATUS)
    (status < UART_READY) {
        uart_put(device, byte)
        out none
    }

    seed.mem.store8(device, UART_DATA, byte)
    out none
}

skill uart_write(text) {
    @device = UART_ADDRESS
    @count = seed.str.len(text)
    @index = 0
    drum (count) {
        uart_put(device, seed.str.byte(text, index))
        index = index + 1
    }
    out none
}

skill uart_line(text) {
    uart_write(text)
    uart_put(UART_ADDRESS, 10)
    out none
}
