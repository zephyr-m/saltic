use seed
use os.drivers.graphics
use os.fonts.spleen

BODY_WIDTH = 8
BODY_HEIGHT = 16
DIVISORS_16 = [32768, 16384, 8192, 4096, 2048, 1024, 512, 256, 128, 64, 32, 16, 8, 4, 2, 1]

Style = enum {
    BODY,
    H1,
    H2,
    H3,
    H4,
    H5,
    H6,
}

Face = Box {
    glyphs = []
    width = BODY_WIDTH
    height = BODY_HEIGHT
}

Markdown = Box {
    style = Style.BODY
    offset = 0
}

Codepoint = Box {
    value = 32
    width = 1
}

FACE_BODY = Face { glyphs = spleen.GLYPHS_8X16 width = 8 height = 16 }
FACE_H1 = Face { glyphs = spleen.GLYPHS_32X64 width = 32 height = 64 }
FACE_H2 = Face { glyphs = spleen.GLYPHS_16X32 width = 16 height = 32 }
FACE_H3 = Face { glyphs = spleen.GLYPHS_12X24 width = 12 height = 24 }
FACE_H4 = Face { glyphs = spleen.GLYPHS_8X16 width = 8 height = 16 }
FACE_H5 = Face { glyphs = spleen.GLYPHS_6X12 width = 6 height = 12 }
FACE_H6 = Face { glyphs = spleen.GLYPHS_5X8 width = 5 height = 8 }

skill font_markdown(text) {
    (seed.str.starts_with(text, "###### ") == yes) { out Markdown { style = Style.H6 offset = 7 } }
    (seed.str.starts_with(text, "##### ") == yes) { out Markdown { style = Style.H5 offset = 6 } }
    (seed.str.starts_with(text, "#### ") == yes) { out Markdown { style = Style.H4 offset = 5 } }
    (seed.str.starts_with(text, "### ") == yes) { out Markdown { style = Style.H3 offset = 4 } }
    (seed.str.starts_with(text, "## ") == yes) { out Markdown { style = Style.H2 offset = 3 } }
    (seed.str.starts_with(text, "# ") == yes) { out Markdown { style = Style.H1 offset = 2 } }
    out Markdown {}
}

skill font_face(style) {
    (style == Style.H1) { out FACE_H1 }
    (style == Style.H2) { out FACE_H2 }
    (style == Style.H3) { out FACE_H3 }
    (style == Style.H4) { out FACE_H4 }
    (style == Style.H5) { out FACE_H5 }
    (style == Style.H6) { out FACE_H6 }
    out FACE_BODY
}

skill font_decode(text, index) {
    @first = seed.str.byte(text, index)
    @length = seed.str.len(text)
    @two_bytes = yes
    (first < 194) { two_bytes = no }
    (first > 223) { two_bytes = no }
    ((index + 1 < length) == no) { two_bytes = no }

    (two_bytes == yes) {
        @second = seed.str.byte(text, index + 1)
        @continuation = yes
        (second < 128) { continuation = no }
        (second > 191) { continuation = no }
        (continuation == yes) {
            out Codepoint {
                value = (first - 192) * 64 + second - 128
                width = 2
            }
        }
    }
    out Codepoint { value = first }
}

skill font_glyph_index(code) {
    @ascii = yes
    (code < 32) { ascii = no }
    (code > 126) { ascii = no }
    (ascii == yes) { out code - 32 }
    (code == 1025) { out 95 }

    @cyrillic = yes
    (code < 1040) { cyrillic = no }
    (code > 1103) { cyrillic = no }
    (cyrillic == yes) { out 96 + code - 1040 }
    (code == 1105) { out 160 }
    out 31
}

skill font_draw_glyph(screen, face, x, y, code, ink) {
    @glyph = seed.group.at(face.glyphs, font_glyph_index(code))
    @row = 0
    drum (face.height) {
        @left = seed.group.at(glyph, row)
        @right = left
        @mask_width = face.width
        (face.width == 32) {
            left = seed.group.at(glyph, row * 2)
            right = seed.group.at(glyph, row * 2 + 1)
            mask_width = 16
        }

        @column = 0
        drum (face.width) {
            @local = column
            @mask = left
            (column > 15) {
                local = column - 16
                mask = right
            }
            @divisor = seed.group.at(DIVISORS_16, 16 - mask_width + local)
            @quotient = mask / divisor
            @bit = quotient - quotient / 2 * 2
            (bit == 1) { graphics.graphics_pixel(screen, x + column, y + row, ink) }
            column = column + 1
        }
        row = row + 1
    }
    out none
}

skill font_text_length_from(text, offset) {
    @byte_count = seed.str.len(text)
    @index = offset
    @result = 0
    @step = 0
    drum (byte_count) {
        (index < byte_count) {
            @codepoint = font_decode(text, index)
            result = result + 1
            step = codepoint.width
            index = index + step
        }
    }
    out result
}

skill font_text_length(text) {
    @markdown = font_markdown(text)
    out font_text_length_from(text, markdown.offset)
}

skill font_text_width(text) {
    @markdown = font_markdown(text)
    @face = font_face(markdown.style)
    out font_text_length_from(text, markdown.offset) * face.width
}

skill font_text_height(text) {
    @markdown = font_markdown(text)
    @face = font_face(markdown.style)
    out face.height
}

skill font_draw_text(screen, x, y, text, offset, face, ink) {
    @origin = x
    @cursor_x = x
    @cursor_y = y
    @index = offset
    @byte_count = seed.str.len(text)
    @step = 0

    drum (byte_count) {
        (index < byte_count) {
            @codepoint = font_decode(text, index)
            (codepoint.value == 10) {
                cursor_x = origin
                cursor_y = cursor_y + face.height
            }
            ((codepoint.value == 10) == no) {
                font_draw_glyph(screen, face, cursor_x, cursor_y, codepoint.value, ink)
                cursor_x = cursor_x + face.width
            }
            step = codepoint.width
            index = index + step
        }
    }
    out none
}

skill graphics_body_text(screen, x, y, text, ink) {
    out font_draw_text(screen, x, y, text, 0, FACE_BODY, ink)
}

skill graphics_text(screen, x, y, text, ink) {
    @markdown = font_markdown(text)
    @face = font_face(markdown.style)
    out font_draw_text(screen, x, y, text, markdown.offset, face, ink)
}
