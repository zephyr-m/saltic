use seed
use os.drivers.fw_cfg

FRAMEBUFFER_ADDRESS = [33280, 0]
FRAMEBUFFER_WIDTH = 1280
FRAMEBUFFER_HEIGHT = 720
FRAMEBUFFER_STRIDE = 5120

skill framebuffer_open() {
    out fw_cfg.fw_cfg_configure_ramfb(FRAMEBUFFER_ADDRESS)
}

skill framebuffer_store(framebuffer, x, y, color) {
    @offset = y * FRAMEBUFFER_STRIDE + x * 4
    seed.mem.store32(framebuffer, offset, color)
    out none
}
