-- framebuffer — буфер кадра ramfb в qemu-virt: 1920×1080, 4 байта на пиксель,
-- память по адресу [34048, 0] (0x85000000). Цвет — число 0xRRGGBB.
--
-- framebuffer_open() -> адрес буфера; RamfbNotFound, RamfbDmaFailed (fw_cfg)
-- framebuffer_store(framebuffer, x, y, color) — пиксель в память
-- framebuffer_load(framebuffer, x, y) -> цвет пикселя
-- framebuffer_place(pair) -> address пары [hi, lo] (буфер хранится парой: на rv32i
--     address в поле Box не влезает в обычное число)

use core.mem
use core.num
use core.u32
use core.usize
use core.group
use core.address
use os.drivers.fw_cfg

FRAMEBUFFER_ADDRESS = [34048, 0]
FRAMEBUFFER_WIDTH = 1920
FRAMEBUFFER_HEIGHT = 1080
FRAMEBUFFER_STRIDE = 7680

skill framebuffer_place(pair) {
    out address.from(u32.from(group.get(pair, 0)) * u32.from(65536) + u32.from(group.get(pair, 1)))
}

skill framebuffer_open() {
    out fw_cfg.fw_cfg_configure_ramfb(FRAMEBUFFER_ADDRESS)
}

skill framebuffer_store(framebuffer, x, y, color) {
    @offset = y * FRAMEBUFFER_STRIDE + x * 4
    mem.store32(framebuffer_place(framebuffer), usize.from(offset), u32.from(color))
    out none
}

skill framebuffer_load(framebuffer, x, y) {
    @offset = y * FRAMEBUFFER_STRIDE + x * 4
    out num.from(mem.load32(framebuffer_place(framebuffer), usize.from(offset)))
}
