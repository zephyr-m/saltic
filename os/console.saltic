use seed
use os.drivers.uart

MAX_COMMAND_LENGTH = 128

Console = Box {
    text = ""
}

skill console_character(byte) {
    (byte > 96) {
        (byte < 123) { out seed.str.at("abcdefghijklmnopqrstuvwxyz", byte - 97) }
    }
    (byte > 47) {
        (byte < 58) { out seed.str.at("0123456789", byte - 48) }
    }
    (byte == 32) { out " " }
    (byte == 45) { out "-" }
    (byte == 95) { out "_" }
    out ""
}

skill console_execute(console) {
    @command = console.text
    console.text = ""

    (seed.str.len(command) == 0) { out console }
    (command == "ping") {
        uart.uart_line("pong")
        out console
    }
    (command == "status") {
        uart.uart_line("Saltic готов")
        out console
    }
    (command == "help") {
        uart.uart_line("команды: ping status help")
        out console
    }

    uart.uart_line(seed.str.add("неизвестная команда: ", command))
    out console
}

skill console_open() {
    uart.uart_line("консоль Saltic готова")
    out Console {}
}

skill console_poll(console) {
    @byte = uart.uart_poll()
    out console
    (byte < 0) { out console }
    (byte == 10) { out console_execute(console) }
    (byte == 13) { out console_execute(console) }
    (byte == 8) {
        @length = seed.str.len(console.text)
        (length > 0) { console.text = seed.str.slice(console.text, 0, length - 1) }
        out console
    }
    (byte == 127) {
        @length = seed.str.len(console.text)
        (length > 0) { console.text = seed.str.slice(console.text, 0, length - 1) }
        out console
    }

    @character = console_character(byte)
    (seed.str.len(character) > 0) {
        (seed.str.len(console.text) < MAX_COMMAND_LENGTH) {
            console.text = seed.str.add(console.text, character)
        }
    }
    out console
}
