-- build — переводит значки Lucide (lucide-react, dist/esm/icons/*.js, лицензия
-- ISC — os/icons/lucide/LICENSE.txt) в свой файл os/icons/lucide/icons.txt:
-- значок — строка «имя|черта;черта;…», черта — «o:» (открытая) или «c:»
-- (замкнутая) и точки «x,y x,y …» в 1/SCALE клетки 24×24 Lucide. Все кривые
-- (дуги, кубические и квадратичные) уже разложены на отрезки: рантайму значков
-- тригонометрия не нужна, он только обводит ломаные (os/icons). Печатает шаги.
--
-- program(source) — source: папка dist/esm/icons пакета lucide-react
-- Внутри: Pen { strokes, points, x, y, start_x, start_y, last_x, last_y, closed }
--     — перо разбора пути; tokens(text) — команды и числа пути; number(text) ->
--     дробное; attr(chunk, name) -> текст атрибута; element(pen, tag, chunk) —
--     круг, эллипс, прямоугольник, линия, ломаная, многоугольник, путь; path(pen,
--     d); arc(pen, rx, ry, градусы, large, sweep, x2, y2) / cubic / quad —
--     кривые отрезками (дуга — по SVG F.6.5: центр, углы через core.fraction);
--     circle_points; points_of; rect_path — прямоугольник путём; take — числа

use io
use io.file
use core.str
use core.num
use core.group
use core.fraction

OUTPUT = "os/icons/lucide/icons.txt"
SCALE = 16
TAIL = ".js"
CURVE_STEPS = 8
ARC_STEP = 0.3926990816987241
ROUND_STEPS = 24
TAGS = ["path", "circle", "ellipse", "line", "polyline", "polygon", "rect"]

Pen = Box {
    strokes = [],
    points = [],
    x = 0.0,
    y = 0.0,
    start_x = 0.0,
    start_y = 0.0,
    last_x = 0.0,
    last_y = 0.0,
    closed = no

    skill push(px, py) {
        points = group.add(points, [num.round_school(px * 16.0), num.round_school(py * 16.0)])
        x = px
        y = py
        out none
    }

    skill point(px, py) {
        (group.count(points) == 0) { push(x, y) }
        out push(px, py)
    }

    skill finish() {
        (group.count(points) > 1) {
            @kind = "o"
            (closed == yes) { kind = "c" }
            @parts = []
            drum (points) {
                @px = group.get(beat, 0)
                @py = group.get(beat, 1)
                parts = group.add(parts, "{px},{py}")
            }
            @joined = str.join(parts, " ")
            strokes = group.add(strokes, "{kind}:{joined}")
        }
        points = []
        closed = no
        out none
    }

    skill move(px, py) {
        finish()
        start_x = px
        start_y = py
        push(px, py)
        last_x = px
        last_y = py
        out none
    }
}

skill digit(ch) {
    out str.is_digit(ch)
}

skill tokens(text) {
    @found = []
    @current = ""
    @dotted = no
    drum (str.bytes(text)) {
        @ch = str.slice(text, beat, beat + 1)
        @placed = no
        (digit(ch) == yes) {
            current = str.concat(current, ch)
            placed = yes
        }
        (ch == ".") {
            (dotted == yes) {
                found = group.add(found, current)
                current = ""
            }
            current = str.concat(current, ".")
            dotted = yes
            placed = yes
        }
        (ch == "-") {
            (str.bytes(current) > 0) { found = group.add(found, current) }
            current = "-"
            dotted = no
            placed = yes
        }
        (placed == no) {
            (str.bytes(current) > 0) { found = group.add(found, current) }
            current = ""
            dotted = no
            @letter = yes
            (ch == " ") { letter = no }
            (ch == ",") { letter = no }
            (ch == "\n") { letter = no }
            (letter == yes) { found = group.add(found, ch) }
        }
    }
    (str.bytes(current) > 0) { found = group.add(found, current) }
    out found
}

skill number(text) {
    @negative = str.starts_with(text, "-")
    @body = text
    (negative == yes) { body = str.slice(text, 1, str.bytes(text)) }
    @whole = 0
    @part = 0
    @scale = 1
    @after = no
    drum (str.bytes(body)) {
        @ch = str.slice(body, beat, beat + 1)
        (ch == ".") { after = yes }
        (digit(ch) == yes) {
            @figure = str.byte(body, beat) - 48
            (after == no) { whole = whole * 10 + figure }
            (after == yes) {
                part = part * 10 + figure
                scale = scale * 10
            }
        }
    }
    @made = fraction.from(whole) + fraction.from(part) / fraction.from(scale)
    (negative == yes) { out 0.0 - made }
    out made
}

skill attr(chunk, name) {
    @key = " {name}: \""
    @at = -1
    drum (str.bytes(chunk)) {
        (at < 0) { (str.starts_at(chunk, key, beat) == yes) { at = beat + str.bytes(key) } }
    }
    (at < 0) { out "" }
    @end = at
    drum (str.bytes(chunk) - at) {
        (end == at + beat) { ((str.slice(chunk, end, end + 1) == "\"") == no) { end = end + 1 } }
    }
    out str.slice(chunk, at, end)
}

skill value(chunk, name) {
    @text = attr(chunk, name)
    (str.bytes(text) == 0) { out 0.0 }
    out number(text)
}

skill cubic(pen, x1, y1, x2, y2, x3, y3) {
    @x0 = pen.x
    @y0 = pen.y
    drum (CURVE_STEPS) {
        @t = fraction.from(beat + 1) / fraction.from(CURVE_STEPS)
        @u = 1.0 - t
        @px = u * u * u * x0 + 3.0 * u * u * t * x1 + 3.0 * u * t * t * x2 + t * t * t * x3
        @py = u * u * u * y0 + 3.0 * u * u * t * y1 + 3.0 * u * t * t * y2 + t * t * t * y3
        pen.point(px, py)
    }
    out none
}

skill quad(pen, x1, y1, x2, y2) {
    @x0 = pen.x
    @y0 = pen.y
    drum (CURVE_STEPS) {
        @t = fraction.from(beat + 1) / fraction.from(CURVE_STEPS)
        @u = 1.0 - t
        pen.point(u * u * x0 + 2.0 * u * t * x1 + t * t * x2, u * u * y0 + 2.0 * u * t * y1 + t * t * y2)
    }
    out none
}

skill arc(pen, radius_x, radius_y, degrees, large, sweep, x2, y2) {
    @rx = radius_x
    @ry = radius_y
    @phi = degrees * fraction.PI / 180.0
    @x1 = pen.x
    @y1 = pen.y
    (rx < 0.0) { rx = 0.0 - rx }
    (ry < 0.0) { ry = 0.0 - ry }
    @flat = (rx > 0.0) == no
    ((ry > 0.0) == no) { flat = yes }
    (flat == yes) { out pen.point(x2, y2) }
    @c = fraction.cos(phi)
    @s = fraction.sin(phi)
    @dx = (x1 - x2) / 2.0
    @dy = (y1 - y2) / 2.0
    @xp = c * dx + s * dy
    @yp = c * dy - s * dx
    @lambda = xp * xp / (rx * rx) + yp * yp / (ry * ry)
    (lambda > 1.0) {
        @grow = fraction.sqrt(lambda)
        rx = rx * grow
        ry = ry * grow
    }
    @top = rx * rx * ry * ry - rx * rx * yp * yp - ry * ry * xp * xp
    (top < 0.0) { top = 0.0 }
    @bottom = rx * rx * yp * yp + ry * ry * xp * xp
    @coef = 0.0
    (bottom > 0.0) { coef = fraction.sqrt(top / bottom) }
    (large == sweep) { coef = 0.0 - coef }
    @cxp = coef * rx * yp / ry
    @cyp = 0.0 - coef * ry * xp / rx
    @cx = c * cxp - s * cyp + (x1 + x2) / 2.0
    @cy = s * cxp + c * cyp + (y1 + y2) / 2.0
    @start = fraction.atan2((yp - cyp) / ry, (xp - cxp) / rx)
    @finish = fraction.atan2((0.0 - yp - cyp) / ry, (0.0 - xp - cxp) / rx)
    @delta = finish - start
    (sweep == no) { (delta > 0.0) { delta = delta - fraction.TURN } }
    (sweep == yes) { (delta < 0.0) { delta = delta + fraction.TURN } }
    @size = delta
    (size < 0.0) { size = 0.0 - size }
    @steps = num.ceil(size / ARC_STEP)
    (steps < 2) { steps = 2 }
    drum (steps) {
        @angle = start + delta * fraction.from(beat + 1) / fraction.from(steps)
        @ex = rx * fraction.cos(angle)
        @ey = ry * fraction.sin(angle)
        pen.point(c * ex - s * ey + cx, s * ex + c * ey + cy)
    }
    out none
}

skill take(list, from, count) {
    @made = []
    drum (count) { made = group.add(made, number(group.get(list, from + beat))) }
    out made
}

skill path(pen, d) {
    pen.x = 0.0
    pen.y = 0.0
    @list = tokens(d)
    @index = 0
    @command = "M"
    drum (group.count(list)) {
        (index < group.count(list)) {
            @head = group.get(list, index)
            @letter = str.is_digit(str.slice(head, 0, 1)) == no
            (head == "-") { letter = no }
            (str.starts_with(head, "-") == yes) { letter = no }
            (str.starts_with(head, ".") == yes) { letter = no }
            (letter == yes) {
                command = head
                index = index + 1
            }
            @lower = str.lower(command)
            @relative = (command == lower)
            @bx = 0.0
            @by = 0.0
            (relative == yes) {
                bx = pen.x
                by = pen.y
            }
            (lower == "z") {
                pen.closed = yes
                pen.point(pen.start_x, pen.start_y)
                pen.finish()
                pen.x = pen.start_x
                pen.y = pen.start_y
                command = "M"
            }
            (lower == "m") {
                @v = take(list, index, 2)
                pen.move(bx + group.get(v, 0), by + group.get(v, 1))
                index = index + 2
                command = "L"
                (relative == yes) { command = "l" }
            }
            (lower == "l") {
                @v = take(list, index, 2)
                pen.point(bx + group.get(v, 0), by + group.get(v, 1))
                pen.last_x = pen.x
                pen.last_y = pen.y
                index = index + 2
            }
            (lower == "h") {
                @v = take(list, index, 1)
                pen.point(bx + group.get(v, 0), pen.y)
                pen.last_x = pen.x
                pen.last_y = pen.y
                index = index + 1
            }
            (lower == "v") {
                @v = take(list, index, 1)
                pen.point(pen.x, by + group.get(v, 0))
                pen.last_x = pen.x
                pen.last_y = pen.y
                index = index + 1
            }
            (lower == "c") {
                @v = take(list, index, 6)
                pen.last_x = bx + group.get(v, 2)
                pen.last_y = by + group.get(v, 3)
                cubic(pen, bx + group.get(v, 0), by + group.get(v, 1), pen.last_x, pen.last_y, bx + group.get(v, 4), by + group.get(v, 5))
                index = index + 6
            }
            (lower == "s") {
                @v = take(list, index, 4)
                @rx = 2.0 * pen.x - pen.last_x
                @ry = 2.0 * pen.y - pen.last_y
                pen.last_x = bx + group.get(v, 0)
                pen.last_y = by + group.get(v, 1)
                cubic(pen, rx, ry, pen.last_x, pen.last_y, bx + group.get(v, 2), by + group.get(v, 3))
                index = index + 4
            }
            (lower == "q") {
                @v = take(list, index, 4)
                pen.last_x = bx + group.get(v, 0)
                pen.last_y = by + group.get(v, 1)
                quad(pen, pen.last_x, pen.last_y, bx + group.get(v, 2), by + group.get(v, 3))
                index = index + 4
            }
            (lower == "t") {
                @v = take(list, index, 2)
                pen.last_x = 2.0 * pen.x - pen.last_x
                pen.last_y = 2.0 * pen.y - pen.last_y
                quad(pen, pen.last_x, pen.last_y, bx + group.get(v, 0), by + group.get(v, 1))
                index = index + 2
            }
            (lower == "a") {
                @v = take(list, index, 7)
                @large = group.get(v, 3) > 0.5
                @sweep = group.get(v, 4) > 0.5
                arc(pen, 0.0 + group.get(v, 0), 0.0 + group.get(v, 1), 0.0 + group.get(v, 2), large, sweep, bx + group.get(v, 5), by + group.get(v, 6))
                pen.last_x = pen.x
                pen.last_y = pen.y
                index = index + 7
            }
        }
    }
    out pen.finish()
}

skill circle_points(pen, cx, cy, rx, ry) {
    pen.move(cx + rx, cy)
    drum (ROUND_STEPS) {
        @angle = fraction.TURN * fraction.from(beat + 1) / fraction.from(ROUND_STEPS)
        pen.point(cx + rx * fraction.cos(angle), cy + ry * fraction.sin(angle))
    }
    pen.closed = yes
    out pen.finish()
}

skill points_of(pen, text, closed) {
    @list = tokens(text)
    @count = group.count(list) / 2
    drum (count) {
        @px = number(group.get(list, beat * 2))
        @py = number(group.get(list, beat * 2 + 1))
        (beat == 0) { pen.move(px, py) }
        (beat > 0) { pen.point(px, py) }
    }
    pen.closed = closed
    out pen.finish()
}

skill element(pen, tag, chunk) {
    (tag == "path") { out path(pen, attr(chunk, "d")) }
    (tag == "circle") { out circle_points(pen, value(chunk, "cx"), value(chunk, "cy"), value(chunk, "r"), value(chunk, "r")) }
    (tag == "ellipse") { out circle_points(pen, value(chunk, "cx"), value(chunk, "cy"), value(chunk, "rx"), value(chunk, "ry")) }
    (tag == "line") {
        pen.move(value(chunk, "x1"), value(chunk, "y1"))
        pen.point(value(chunk, "x2"), value(chunk, "y2"))
        out pen.finish()
    }
    (tag == "polyline") { out points_of(pen, attr(chunk, "points"), no) }
    (tag == "polygon") { out points_of(pen, attr(chunk, "points"), yes) }
    (tag == "rect") {
        @x = value(chunk, "x")
        @y = value(chunk, "y")
        @w = value(chunk, "width")
        @h = value(chunk, "height")
        @r = value(chunk, "rx")
        out path(pen, rect_path(x, y, w, h, r))
    }
    out none
}

skill rect_path(x, y, w, h, r) {
    @right = x + w
    @low = y + h
    @inner_right = right - r
    @inner_low = low - r
    @left_in = x + r
    @top_in = y + r
    ((r > 0.0) == no) { out "M{x} {y}H{right}V{low}H{x}Z" }
    out "M{left_in} {y}H{inner_right}A{r} {r} 0 0 1 {right} {top_in}V{inner_low}A{r} {r} 0 0 1 {inner_right} {low}H{left_in}A{r} {r} 0 0 1 {x} {inner_low}V{top_in}A{r} {r} 0 0 1 {left_in} {y}Z"
}

skill icon(text) {
    @pen = Pen {}
    drum (str.bytes(text)) {
        @at = beat
        drum (TAGS) {
            @tag = beat
            (str.starts_at(text, "\"{tag}\",", at) == yes) {
                @open = at
                drum (str.bytes(text) - at) {
                    (open == at + beat) { ((str.slice(text, open, open + 1) == "\{") == no) { open = open + 1 } }
                }
                @close = open
                drum (str.bytes(text) - open) {
                    (close == open + beat) { ((str.slice(text, close, close + 1) == "\}") == no) { close = close + 1 } }
                }
                element(pen, tag, str.slice(text, open, close + 1))
            }
        }
    }
    out str.join(pen.strokes, ";")
}

program(source) {
    io.show("lucide: читаю {source}")
    @files = file.list(source)
    @lines = []
    @done = 0
    @total = group.count(files)
    drum (files) {
        @name = beat
        (str.ends_with(name, TAIL) == yes) {
            @short = str.slice(name, 0, str.bytes(name) - str.bytes(TAIL))
            @strokes = icon(file.read("{source}/{name}"))
            (str.bytes(strokes) > 0) { lines = group.add(lines, "{short}|{strokes}") }
            done = done + 1
            (done % 200 == 0) { io.show("lucide: {done} из ~{total}") }
        }
    }
    file.write(OUTPUT, str.concat(str.join(lines, "\n"), "\n"))
    @count = group.count(lines)
    io.show("записано {OUTPUT}: значков {count}")
    out none
}
