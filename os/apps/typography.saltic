use seed
use os.ui.jtml

skill language(title, upper, lower, sentence) {
    out jtml.frame(jtml.Flow.COLUMN, 0, 0, 1, 20, 18, 1, [
        jtml.text(seed.str.add("### ", title)),
        jtml.text(upper),
        jtml.text(lower),
        jtml.text("0123456789  ! ? . , : ; + - * / ="),
        jtml.text(sentence),
        jtml.space(1),
        jtml.text("##### SMALL / МЕЛКИЙ"),
        jtml.text("###### CAPTION / ПОДПИСЬ")
    ])
}

skill reference_line(text) {
    out jtml.text(seed.str.add("## ", text))
}

skill spleen_reference() {
    out jtml.frame(jtml.Flow.COLUMN, 0, 0, 1, 20, 0, 0, [
        reference_line("/*"),
        reference_line(" * Spleen 1.0.0"),
        reference_line(" * Copyright (c) 2018, Frederic Cambus"),
        reference_line(" * https://www.cambus.net/"),
        reference_line(" *"),
        reference_line(" * Created:      2018-08-08"),
        reference_line(" * Last Updated: 2018-09-18"),
        reference_line(" *"),
        reference_line(" * Spleen is released under the BSD 2-Clause license."),
        reference_line(" * See LICENSE file for details."),
        reference_line(" */"),
        jtml.space(32),
        reference_line("#include <stdio.h>"),
        jtml.space(32),
        reference_line("int main() {"),
        reference_line("    char *hello = \"Hello Spleen!\";"),
        reference_line("    char ducks[] = \" >o_/ >o_/ \";"),
        jtml.space(32),
        reference_line("    printf(\"%s%s\\n\", hello, ducks);"),
        jtml.space(32),
        reference_line("    return 0;"),
        reference_line("}")
    ])
}

skill view() {
    @levels = jtml.frame(jtml.Flow.COLUMN, 0, 300, 0, 20, 16, 1, [
        jtml.text("# H1 / ЗАГОЛОВОК 1"),
        jtml.text("## H2 / ЗАГОЛОВОК 2"),
        jtml.text("### H3 / ЗАГОЛОВОК 3"),
        jtml.text("#### H4 / ЗАГОЛОВОК 4"),
        jtml.text("##### H5 / ЗАГОЛОВОК 5"),
        jtml.text("###### H6 / ЗАГОЛОВОК 6")
    ])
    @languages = jtml.frame(jtml.Flow.ROW, 0, 0, 1, 0, 24, 0, [
        language(
            "ENGLISH",
            "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
            "abcdefghijklmnopqrstuvwxyz",
            "Saltic speaks clearly on bare metal."
        ),
        language(
            "РУССКИЙ",
            "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ",
            "абвгдеёжзийклмнопрстуфхцчшщъыьэюя",
            "Салтик говорит ясно прямо на железе."
        )
    ])
    @catalog = jtml.frame(jtml.Flow.COLUMN, 0, 0, 0, 0, 64, 0, [
        levels,
        languages
    ])
    out jtml.frame(jtml.Flow.ROW, 0, 0, 0, 28, 64, 0, [
        catalog,
        spleen_reference()
    ])
}
