-- typography — экран-образец шрифта Spleen: уровни заголовков, латиница и
-- кириллица, цифры и знаки, справа — листинг на C как в README Spleen.
-- Дерево строится через os.ui.jtml, рисует launcher.
--
-- view() -> дерево jtml всего экрана
-- language(title, upper, lower, sentence) -> колонка образцов одного языка
-- spleen_reference() -> колонка листинга; reference_line(text) -> строка "## "

use core.str
use os.ui.jtml
use os.ui.jtml.atom

skill language(title, upper, lower, sentence) {
    out atom.frame(atom.Flow.COLUMN, 0, 0, 1, 20, 18, 1, [
        atom.text("### {title}"),
        atom.text(upper),
        atom.text(lower),
        atom.text("0123456789  ! ? . , : ; + - * / ="),
        atom.text(sentence),
        atom.space(1),
        atom.text("##### SMALL / МЕЛКИЙ"),
        atom.text("###### CAPTION / ПОДПИСЬ")
    ])
}

skill reference_line(text) {
    out atom.text("## {text}")
}

skill spleen_reference() {
    out atom.frame(atom.Flow.COLUMN, 0, 0, 1, 20, 0, 0, [
        reference_line("/*"),
        reference_line(" * Spleen 1.0.0"),
        reference_line(" * Copyright (c) 2018, Frederic Cambus"),
        reference_line(" * https://www.cambus.net/"),
        reference_line(" *"),
        reference_line(" * Created:      2018-08-08"),
        reference_line(" * Last Updated: 2018-09-18"),
        reference_line(" *"),
        reference_line(" * Spleen is released under the BSD 2-Clause license."),
        reference_line(" * See LICENSE file for details."),
        reference_line(" */"),
        atom.space(32),
        reference_line("#include <stdio.h>"),
        atom.space(32),
        reference_line("int main() \{"),
        reference_line("    char *hello = \"Hello Spleen!\";"),
        reference_line("    char ducks[] = \" >o_/ >o_/ \";"),
        atom.space(32),
        reference_line("    printf(\"%s%s\\n\", hello, ducks);"),
        atom.space(32),
        reference_line("    return 0;"),
        reference_line("\}")
    ])
}

skill view() {
    @levels = atom.frame(atom.Flow.COLUMN, 0, 300, 0, 20, 16, 1, [
        atom.text("# H1 / ЗАГОЛОВОК 1"),
        atom.text("## H2 / ЗАГОЛОВОК 2"),
        atom.text("### H3 / ЗАГОЛОВОК 3"),
        atom.text("#### H4 / ЗАГОЛОВОК 4"),
        atom.text("##### H5 / ЗАГОЛОВОК 5"),
        atom.text("###### H6 / ЗАГОЛОВОК 6")
    ])
    @languages = atom.frame(atom.Flow.ROW, 0, 0, 1, 0, 24, 0, [
        language(
            "ENGLISH",
            "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
            "abcdefghijklmnopqrstuvwxyz",
            "Saltic speaks clearly on bare metal."
        ),
        language(
            "РУССКИЙ",
            "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ",
            "абвгдеёжзийклмнопрстуфхцчшщъыьэюя",
            "Салтик говорит ясно прямо на железе."
        )
    ])
    @catalog = atom.frame(atom.Flow.COLUMN, 0, 0, 0, 0, 64, 0, [
        levels,
        languages
    ])
    out atom.frame(atom.Flow.ROW, 0, 0, 0, 28, 64, 0, [
        catalog,
        spleen_reference()
    ])
}
