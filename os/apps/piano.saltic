use seed
use os.drivers.font
use os.drivers.graphics
use os.drivers.sound

PIANO_X = 180
PIANO_Y = 320
WHITE_WIDTH = 120
WHITE_HEIGHT = 520
BLACK_WIDTH = 80
BLACK_HEIGHT = 310

Note = Box {
    name = "A"
    shortcut = "1"
    code = 2
    half_frames = 109
    black = no
    slot = 0
}

Model = Box {
    active = 0
    pressed = no
    last = ""
}

Hit = Box {
    found = no
    index = 0
}

skill note(name, shortcut, code, half_frames, black, slot) {
    out Note {
        name = name
        shortcut = shortcut
        code = code
        half_frames = half_frames
        black = black
        slot = slot
    }
}

NOTES = [
    note("A3",  "1", 2,  109, no,  0),
    note("A#3", "2", 3,  103, yes, 1),
    note("B3",  "3", 4,  97,  no,  1),
    note("C4",  "4", 5,  92,  no,  2),
    note("C#4", "5", 6,  87,  yes, 3),
    note("D4",  "6", 7,  82,  no,  3),
    note("D#4", "7", 8,  77,  yes, 4),
    note("E4",  "8", 9,  73,  no,  4),
    note("F4",  "9", 10, 69,  no,  5),
    note("F#4", "0", 11, 65,  yes, 6),
    note("G4",  "-", 12, 61,  no,  6),
    note("G#4", "=", 13, 58,  yes, 7),
    note("A4",  "Q", 16, 55,  no,  7),
    note("A#4", "W", 17, 52,  yes, 8),
    note("B4",  "E", 18, 49,  no,  8),
    note("C5",  "R", 19, 46,  no,  9),
    note("C#5", "T", 20, 43,  yes, 10),
    note("D5",  "Y", 21, 41,  no,  10),
    note("D#5", "U", 22, 39,  yes, 11),
    note("E5",  "I", 23, 36,  no,  11),
    note("F5",  "O", 24, 34,  no,  12),
]

skill new() {
    out Model {}
}

skill inside(x, y, left, top, width, height) {
    (x < left) { out no }
    (y < top) { out no }
    ((x < left + width) == no) { out no }
    ((y < top + height) == no) { out no }
    out yes
}

skill note_left(note) {
    (note.black == yes) {
        out PIANO_X + note.slot * WHITE_WIDTH - BLACK_WIDTH / 2
    }
    out PIANO_X + note.slot * WHITE_WIDTH
}

skill draw_white(screen, note) {
    @left = note_left(note)
    graphics.graphics_rect(screen, left, PIANO_Y, WHITE_WIDTH, WHITE_HEIGHT, graphics.Ink.BACKGROUND)
    graphics.graphics_frame(screen, left, PIANO_Y, WHITE_WIDTH, WHITE_HEIGHT, 2, graphics.Ink.FOREGROUND)
    font.graphics_body_text(screen, left + 48, PIANO_Y + 446, note.name, graphics.Ink.FOREGROUND)
    font.graphics_body_text(screen, left + 56, PIANO_Y + 474, note.shortcut, graphics.Ink.FOREGROUND)
    out none
}

skill draw_black(screen, note) {
    @left = note_left(note)
    graphics.graphics_rect(screen, left, PIANO_Y, BLACK_WIDTH, BLACK_HEIGHT, graphics.Ink.FOREGROUND)
    font.graphics_body_text(screen, left + 24, PIANO_Y + 238, note.name, graphics.Ink.BACKGROUND)
    font.graphics_body_text(screen, left + 36, PIANO_Y + 266, note.shortcut, graphics.Ink.BACKGROUND)
    out none
}

skill draw_keys(screen) {
    @index = 0
    drum (seed.group.count(NOTES)) {
        @note = seed.group.item(NOTES, index)
        (note.black == no) { draw_white(screen, note) }
        index = index + 1
    }
    index = 0
    drum (seed.group.count(NOTES)) {
        @note = seed.group.item(NOTES, index)
        (note.black == yes) { draw_black(screen, note) }
        index = index + 1
    }
    out none
}

skill draw_indicator(screen, note, pressed) {
    @left = note_left(note)
    (note.black == no) {
        @ink = graphics.Ink.BACKGROUND
        (pressed == yes) { ink = graphics.Ink.FOREGROUND }
        graphics.graphics_rect(screen, left + 8, PIANO_Y + WHITE_HEIGHT - 16, WHITE_WIDTH - 16, 8, ink)
    }
    (note.black == yes) {
        @ink = graphics.Ink.FOREGROUND
        (pressed == yes) { ink = graphics.Ink.BACKGROUND }
        graphics.graphics_rect(screen, left + 10, PIANO_Y + BLACK_HEIGHT - 16, BLACK_WIDTH - 20, 8, ink)
    }
    out none
}

skill draw_status(screen, text) {
    graphics.graphics_rect(screen, 1210, 200, 520, 32, graphics.Ink.BACKGROUND)
    font.graphics_body_text(screen, 1210, 208, text, graphics.Ink.FOREGROUND)
    out none
}

skill draw(screen, model) {
    graphics.graphics_fill(screen, graphics.Ink.BACKGROUND)
    font.graphics_text(screen, PIANO_X, 140, "## SALTIC PIANO", graphics.Ink.FOREGROUND)
    font.graphics_body_text(screen, PIANO_X, 214, "21 KEYS / A3 TO F5", graphics.Ink.FOREGROUND)
    font.graphics_body_text(screen, PIANO_X, 246, "MOUSE OR 1...= AND Q...O", graphics.Ink.FOREGROUND)
    draw_keys(screen)
    (seed.str.len(model.last) > 0) {
        draw_status(screen, seed.str.add("LAST NOTE  ", model.last))
    }
    font.graphics_body_text(screen, PIANO_X, 900, "BARE-METAL PCM / 48 KHZ / S16 STEREO", graphics.Ink.FOREGROUND)
    out none
}

skill hit(screen_x, screen_y) {
    @index = 0
    drum (seed.group.count(NOTES)) {
        @note = seed.group.item(NOTES, index)
        (note.black == yes) {
            @left = note_left(note)
            (inside(screen_x, screen_y, left, PIANO_Y, BLACK_WIDTH, BLACK_HEIGHT) == yes) {
                out Hit { found = yes index = index }
            }
        }
        index = index + 1
    }
    index = 0
    drum (seed.group.count(NOTES)) {
        @note = seed.group.item(NOTES, index)
        (note.black == no) {
            @left = note_left(note)
            (inside(screen_x, screen_y, left, PIANO_Y, WHITE_WIDTH, WHITE_HEIGHT) == yes) {
                out Hit { found = yes index = index }
            }
        }
        index = index + 1
    }
    out Hit {}
}

skill press(screen, model, audio, index) {
    @note = seed.group.item(NOTES, index)
    draw_indicator(screen, note, yes)
    draw_status(screen, seed.str.add("PLAYING    ", note.name))
    @played = sound.sound_note_on(audio, index, note.half_frames)
    model.last = note.name
    (played == no) { draw_status(screen, "AUDIO OFFLINE") }
    out model
}

skill release_note(screen, model, audio, index) {
    @note = seed.group.item(NOTES, index)
    sound.sound_note_off(audio, index)
    draw_indicator(screen, note, no)
    draw_status(screen, seed.str.add("LAST NOTE  ", note.name))
    model.last = note.name
    out model
}

skill click(screen, model, audio, x, y) {
    @target = hit(x, y)
    (target.found == yes) {
        model.active = target.index
        model.pressed = yes
        out press(screen, model, audio, target.index)
    }
    out model
}

skill release_click(screen, model, audio) {
    (model.pressed == yes) {
        model = release_note(screen, model, audio, model.active)
        model.pressed = no
    }
    out model
}

skill key_down(screen, model, audio, code) {
    @index = 0
    drum (seed.group.count(NOTES)) {
        @note = seed.group.item(NOTES, index)
        (note.code == code) { out press(screen, model, audio, index) }
        index = index + 1
    }
    out model
}

skill key_up(screen, model, audio, code) {
    @index = 0
    drum (seed.group.count(NOTES)) {
        @note = seed.group.item(NOTES, index)
        (note.code == code) { out release_note(screen, model, audio, index) }
        index = index + 1
    }
    out model
}
