-- wayland — змейка os.apps.snake на композиторе хоста.
-- Сокет без блокировки, клавиатура wl_keyboard, шаг по core.time.
-- Слово 8 байт: на rv32 send/place/sleep не работают.
--
-- program() — поле 32×20. Клавиатура: стрелки и WASD. Кнопки на экране те же.
-- x закрывает, NEW или Enter после смерти.

use core.str
use core.bytes
use core.group
use core.process
use core.socket
use core.time
use io
use os.apps.snake
use os.apps.snake.board
use os.apps.wayland.wire

DISPLAY = 1
REGISTRY = 2
CALLBACK = 3
COMPOSITOR = 4
SHM = 5
SHELL = 6
POOL = 7
BUFFER = 8
SURFACE = 9
XDG_SURFACE = 10
TOPLEVEL = 11
SEAT = 12
POINTER = 13
KEYBOARD = 14
DECOR_MANAGER = 15
DECOR = 16

WIDTH = 496
HEIGHT = 440
STRIDE = 1984
PIXELS = 872960
LEFT_BUTTON = 272
NO_DATA = 0 - 11
STREAM_NONBLOCK = 2049

Session = Box {
    way_fd = 0,
    way_memfd = 0,
    way_compositor_name = 0,
    way_compositor_version = 0,
    way_shm_name = 0,
    way_shm_version = 0,
    way_shell_name = 0,
    way_shell_version = 0,
    way_seat_name = 0,
    way_seat_version = 0,
    way_decor_name = 0,
    way_pointer_x = 0,
    way_pointer_y = 0,
    way_key = 0,
    way_keyed = no,
    way_hold = 0,
    way_last = 0,
    way_model = snake.Model {},
    way_synced = no,
    way_configured = no,
    way_shown = no,
    way_closed = no,
    way_failed = no,
    way_serial = 0,
    way_ping = 0,
    way_pinged = no
}

skill cap(version, limit) {
    (version > limit) { out limit }
    (version < 1) { out 1 }
    out version
}

skill value_of(name) {
    @rows = process.environment()
    @found = ""
    drum (group.count(rows)) {
        @row = group.get(rows, beat)
        @cut = 0
        drum (str.bytes(row)) {
            (str.byte(row, beat) == 61) { cut = beat }
        }
        (cut > 0) {
            @key = str.slice(row, 0, cut)
            (key == name) { found = str.slice(row, cut + 1, str.bytes(row)) }
        }
    }
    out found
}

skill socket_path() {
    @dir = value_of("XDG_RUNTIME_DIR")
    @name = value_of("WAYLAND_DISPLAY")
    (str.bytes(name) == 0) { out "" }
    (str.byte(name, 0) == 47) { out name }
    out "{dir}/{name}"
}

skill unix_address(path) {
    @buffer = bytes.new(str.bytes(path) + 3)
    bytes.set(buffer, 0, 1)
    drum (str.bytes(path)) {
        bytes.set(buffer, beat + 2, str.byte(path, beat))
    }
    out buffer
}

skill remember(session, packet, at) {
    @name = wire.get32(packet, at + 8)
    @len = wire.get32(packet, at + 12)
    @text = at + 16
    @version = wire.get32(packet, text + (len + 3) / 4 * 4)
    (wire.text_is(packet, text, "wl_compositor") == yes) {
        session.way_compositor_name = name
        session.way_compositor_version = version
    }
    (wire.text_is(packet, text, "wl_shm") == yes) {
        session.way_shm_name = name
        session.way_shm_version = version
    }
    (wire.text_is(packet, text, "xdg_wm_base") == yes) {
        session.way_shell_name = name
        session.way_shell_version = version
    }
    (wire.text_is(packet, text, "wl_seat") == yes) {
        session.way_seat_name = name
        session.way_seat_version = version
    }
    (wire.text_is(packet, text, "zxdg_decoration_manager_v1") == yes) {
        session.way_decor_name = name
    }
    out none
}

skill reply_ping(session) {
    (session.way_pinged == no) { out none }
    @pong = wire.request(SHELL, 3, 12)
    wire.put32(pong, 8, session.way_ping)
    socket.write(session.way_fd, pong, 12)
    session.way_pinged = no
    out none
}

skill take(session, packet, count) {
    @at = 0
    always {
        (at + 8 > count) { leave }
        @size = wire.get16(packet, at + 6)
        (size < 8) {
            session.way_failed = yes
            leave
        }
        (at + size > count) { leave }
        @object = wire.get32(packet, at)
        @opcode = wire.get16(packet, at + 4)
        (object == DISPLAY) {
            (opcode == 0) { session.way_failed = yes }
        }
        (object == REGISTRY) {
            (opcode == 0) { remember(session, packet, at) }
        }
        (object == CALLBACK) {
            (opcode == 0) { session.way_synced = yes }
        }
        (object == SHELL) {
            (opcode == 0) {
                session.way_ping = wire.get32(packet, at + 8)
                session.way_pinged = yes
            }
        }
        (object == XDG_SURFACE) {
            (opcode == 0) {
                session.way_serial = wire.get32(packet, at + 8)
                session.way_configured = yes
            }
        }
        (object == TOPLEVEL) {
            (opcode == 1) { session.way_closed = yes }
        }
        (object == POINTER) {
            (opcode == 0) {
                (size >= 24) {
                    session.way_pointer_x = wire.get32(packet, at + 16) / 256
                    session.way_pointer_y = wire.get32(packet, at + 20) / 256
                }
            }
            (opcode == 2) {
                (size >= 20) {
                    session.way_pointer_x = wire.get32(packet, at + 12) / 256
                    session.way_pointer_y = wire.get32(packet, at + 16) / 256
                }
            }
            (opcode == 3) {
                (size >= 24) {
                    @button = wire.get32(packet, at + 16)
                    @state = wire.get32(packet, at + 20)
                    (button == LEFT_BUTTON) {
                        (state == 1) {
                            @hit = board.press(session.way_pointer_x, session.way_pointer_y, WIDTH)
                            (hit == 0 - 1) { session.way_closed = yes }
                            (hit > 0) {
                                session.way_key = hit
                                session.way_keyed = yes
                            }
                        }
                    }
                }
            }
        }
        (object == KEYBOARD) {
            (opcode == 3) {
                (size >= 24) {
                    @scan = wire.get32(packet, at + 16)
                    @down = wire.get32(packet, at + 20)
                    (down == 1) {
                        session.way_key = scan
                        session.way_keyed = yes
                    }
                }
            }
        }
        at = at + size
    }
    reply_ping(session)
    out at
}

skill pump(session, packet, hold, joined) {
    @got = socket.read(session.way_fd, packet)
    (got == NO_DATA) { out 0 }
    (got <= 0) { session.way_failed = yes }
    (got > 0) {
        @total = wire.join(hold, session.way_hold, packet, got, joined)
        @used = take(session, joined, total)
        session.way_hold = wire.keep(joined, used, total, hold)
    }
    out got
}

skill send_buffer(fd, buffer) {
    out socket.write(fd, buffer, bytes.count(buffer))
}

skill bind(fd, name, interface, version, id) {
    @len = str.bytes(interface) + 1
    @size = 24 + (len + 3) / 4 * 4
    @buffer = wire.request(REGISTRY, 0, size)
    wire.put32(buffer, 8, name)
    @at = wire.put_text(buffer, 12, interface)
    wire.put32(buffer, at, version)
    wire.put32(buffer, at + 4, id)
    out send_buffer(fd, buffer)
}

skill titled(fd, opcode, text) {
    @len = str.bytes(text) + 1
    @size = 12 + (len + 3) / 4 * 4
    @buffer = wire.request(TOPLEVEL, opcode, size)
    wire.put_text(buffer, 8, text)
    out send_buffer(fd, buffer)
}

skill frame(session, pixels) {
    socket.place(session.way_memfd, pixels, 0)
    @attach = wire.request(SURFACE, 1, 20)
    wire.put32(attach, 8, BUFFER)
    send_buffer(session.way_fd, attach)
    @damage = wire.request(SURFACE, 2, 24)
    wire.put32(damage, 16, WIDTH)
    wire.put32(damage, 20, HEIGHT)
    send_buffer(session.way_fd, damage)
    @commit = wire.request(SURFACE, 6, 8)
    send_buffer(session.way_fd, commit)
    out none
}

skill present(session, pixels) {
    @ack = wire.request(XDG_SURFACE, 4, 12)
    wire.put32(ack, 8, session.way_serial)
    send_buffer(session.way_fd, ack)
    out frame(session, pixels)
}

skill open_window(session) {
    @fd = session.way_fd
    @compositor = bind(fd, session.way_compositor_name, "wl_compositor", cap(session.way_compositor_version, 4), COMPOSITOR)
    (compositor < 0) { out no }
    @shm = bind(fd, session.way_shm_name, "wl_shm", cap(session.way_shm_version, 1), SHM)
    (shm < 0) { out no }
    @shell = bind(fd, session.way_shell_name, "xdg_wm_base", cap(session.way_shell_version, 1), SHELL)
    (shell < 0) { out no }
    @memfd = socket.memory("saltic")
    (memfd < 0) { out no }
    session.way_memfd = memfd
    @sized = socket.resize(memfd, PIXELS)
    (sized < 0) { out no }
    @pool = wire.request(SHM, 0, 16)
    wire.put32(pool, 8, POOL)
    wire.put32(pool, 12, PIXELS)
    @sent = socket.send(fd, pool, 16, memfd)
    (sent < 0) { out no }
    @made = wire.request(POOL, 0, 32)
    wire.put32(made, 8, BUFFER)
    wire.put32(made, 16, WIDTH)
    wire.put32(made, 20, HEIGHT)
    wire.put32(made, 24, STRIDE)
    wire.put32(made, 28, 1)
    send_buffer(fd, made)
    @surface = wire.request(COMPOSITOR, 0, 12)
    wire.put32(surface, 8, SURFACE)
    send_buffer(fd, surface)
    @xdg = wire.request(SHELL, 2, 16)
    wire.put32(xdg, 8, XDG_SURFACE)
    wire.put32(xdg, 12, SURFACE)
    send_buffer(fd, xdg)
    @top = wire.request(XDG_SURFACE, 1, 12)
    wire.put32(top, 8, TOPLEVEL)
    send_buffer(fd, top)
    titled(fd, 2, "Snake")
    titled(fd, 3, "saltic")
    (session.way_seat_name > 0) {
        bind(fd, session.way_seat_name, "wl_seat", 1, SEAT)
        @pointer = wire.request(SEAT, 0, 12)
        wire.put32(pointer, 8, POINTER)
        send_buffer(fd, pointer)
        @keys = wire.request(SEAT, 1, 12)
        wire.put32(keys, 8, KEYBOARD)
        send_buffer(fd, keys)
    }
    (session.way_decor_name > 0) {
        bind(fd, session.way_decor_name, "zxdg_decoration_manager_v1", 1, DECOR_MANAGER)
        @decor = wire.request(DECOR_MANAGER, 1, 16)
        wire.put32(decor, 8, DECOR)
        wire.put32(decor, 12, TOPLEVEL)
        send_buffer(fd, decor)
        @mode = wire.request(DECOR, 1, 12)
        wire.put32(mode, 8, 2)
        send_buffer(fd, mode)
    }
    @commit = wire.request(SURFACE, 6, 8)
    send_buffer(fd, commit)
    out yes
}

program() {
    @path = socket_path()
    (str.bytes(path) == 0) {
        io.show("нет WAYLAND_DISPLAY")
        out error.Wayland
    }
    @fd = socket.open(1, STREAM_NONBLOCK, 0)
    (fd < 0) {
        io.show("сокет не открылся")
        out error.Wayland
    }
    @address = unix_address(path)
    @connected = socket.connect(fd, address)
    (connected < 0) {
        io.show("нет соединения с {path}")
        out error.Wayland
    }
    io.show(path)
    @session = Session { way_fd = fd }
    @registry = wire.request(DISPLAY, 1, 12)
    wire.put32(registry, 8, REGISTRY)
    send_buffer(fd, registry)
    @sync = wire.request(DISPLAY, 0, 12)
    wire.put32(sync, 8, CALLBACK)
    send_buffer(fd, sync)
    @packet = bytes.new(8192)
    @hold = bytes.new(4096)
    @joined = bytes.new(12288)
    always {
        (session.way_synced == yes) { leave }
        (session.way_failed == yes) { leave }
        pump(session, packet, hold, joined)
    }
    (session.way_failed == yes) {
        io.show("реестр оборвался")
        out error.Wayland
    }
    (session.way_compositor_name == 0) {
        io.show("нет wl_compositor")
        out error.Wayland
    }
    (session.way_shm_name == 0) {
        io.show("нет wl_shm")
        out error.Wayland
    }
    (session.way_shell_name == 0) {
        io.show("нет xdg_wm_base")
        out error.Wayland
    }
    @opened = open_window(session)
    (opened == no) {
        io.show("окно не собралось")
        out error.Wayland
    }
    @pixels = bytes.new(PIXELS)
    session.way_model = snake.new()
    session.way_last = time.now()
    board.paint(pixels, WIDTH, HEIGHT, session.way_model)
    always {
        (session.way_closed == yes) { leave }
        (session.way_failed == yes) { leave }
        pump(session, packet, hold, joined)
        (session.way_closed == yes) { leave }
        (session.way_configured == yes) {
            (session.way_shown == no) {
                present(session, pixels)
                session.way_shown = yes
                io.show("змейка на экране")
            }
        }
        (session.way_shown == yes) {
            (board.advance(session, pixels, WIDTH, time.now()) == yes) {
                frame(session, pixels)
            }
        }
        socket.sleep(20)
    }
    io.show("окно закрыто")
    out none
}
