-- board — змейка os.apps.snake в буфере Wayland.
-- Клетка 14 пикселей, поле 32×20. Шапка с «x» закрывает окно.
-- advance двигает модель и дорисовывает только изменившиеся клетки.

use core.str
use core.group
use core.num
use os.apps.snake
use os.apps.wayland.ink

CELL = 14
ORIGIN_X = 24
ORIGIN_Y = 56
CREAM = 16446696
CACAO = 3418660
STEP_MS = 180
ENTER = 28

skill cell(buffer, width, spot, color) {
    @x = ORIGIN_X + spot.x * CELL
    @y = ORIGIN_Y + spot.y * CELL
    ink.rect(buffer, width, x + 2, y + 2, CELL - 4, CELL - 4, color)
    out none
}

skill food(buffer, width, spot) {
    @x = ORIGIN_X + spot.x * CELL
    @y = ORIGIN_Y + spot.y * CELL
    ink.rect(buffer, width, x + 4, y + 4, CELL - 8, CELL - 8, CACAO)
    out none
}

skill score(buffer, width, model) {
    ink.rect(buffer, width, 120, 12, 240, 24, CACAO)
    ink.body(buffer, width, 120, 16, num.text(model.score), CREAM)
    (model.alive == no) { ink.body(buffer, width, 200, 16, "DEAD", CREAM) }
    out none
}

skill paint(buffer, width, height, model) {
    ink.rect(buffer, width, 0, 0, width, height, CREAM)
    ink.rect(buffer, width, 0, 0, width, 48, CACAO)
    ink.rect(buffer, width, width - 48, 0, 48, 48, CACAO)
    ink.body(buffer, width, 16, 16, "SNAKE", CREAM)
    ink.body(buffer, width, width - 28, 16, "x", CREAM)
    drum (group.count(model.body)) {
        cell(buffer, width, group.get(model.body, beat), CACAO)
    }
    food(buffer, width, model.food)
    score(buffer, width, model)
    ink.rect(buffer, width, 216, 348, 64, 40, CACAO)
    ink.rect(buffer, width, 140, 396, 64, 40, CACAO)
    ink.rect(buffer, width, 216, 396, 64, 40, CACAO)
    ink.rect(buffer, width, 292, 396, 64, 40, CACAO)
    ink.rect(buffer, width, 380, 396, 96, 40, CACAO)
    ink.body(buffer, width, 236, 360, "W", CREAM)
    ink.body(buffer, width, 160, 408, "A", CREAM)
    ink.body(buffer, width, 236, 408, "S", CREAM)
    ink.body(buffer, width, 312, 408, "D", CREAM)
    ink.body(buffer, width, 396, 408, "NEW", CREAM)
    out none
}

skill move(buffer, width, tick) {
    (tick.moved == yes) {
        (tick.grew == no) { cell(buffer, width, tick.tail, CREAM) }
        cell(buffer, width, group.get(tick.model.body, 0), CACAO)
    }
    (tick.grew == yes) { food(buffer, width, tick.model.food) }
    out score(buffer, width, tick.model)
}

skill button(x, y, left, top) {
    (x < left) { out no }
    (y < top) { out no }
    (x >= left + 64) { out no }
    (y >= top + 40) { out no }
    out yes
}

skill press(x, y, width) {
    (x >= width - 48) {
        (y < 48) { out -1 }
    }
    (button(x, y, 216, 348) == yes) { out 103 }
    (button(x, y, 140, 396) == yes) { out 105 }
    (button(x, y, 216, 396) == yes) { out 108 }
    (button(x, y, 292, 396) == yes) { out 106 }
    (button(x, y, 380, 396) == yes) { out 28 }
    out 0
}

skill playing(code) {
    (code == 17) { out yes }
    (code == 30) { out yes }
    (code == 31) { out yes }
    (code == 32) { out yes }
    (code == 28) { out yes }
    (code == 103) { out yes }
    (code == 105) { out yes }
    (code == 106) { out yes }
    (code == 108) { out yes }
    out no
}

skill advance(session, buffer, width, now) {
    (session.way_keyed == yes) {
        session.way_keyed = no
        @code = session.way_key
        (playing(code) == no) {
            (code >= 8) { code = code - 8 }
        }
        (code == ENTER) {
            (session.way_model.alive == no) {
                session.way_model = snake.new()
                paint(buffer, width, 440, session.way_model)
                out yes
            }
        }
        session.way_model = snake.turn(session.way_model, code)
    }
    (now < session.way_last) { session.way_last = now }
    (now - session.way_last < STEP_MS) { out no }
    (session.way_model.alive == no) { out no }
    @tick = snake.step(session.way_model)
    session.way_model = tick.model
    session.way_last = now
    move(buffer, width, tick)
    out yes
}

program() {
    out none
}
