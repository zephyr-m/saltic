-- desk — окно счёта: шапка с закрытием, число, две кнопки.

use core.str
use core.num
use os.apps.wayland.ink

BAR = 48
BUTTON_W = 112
BUTTON_H = 56

PAPER = 16052714
INK = 1843236
NIGHT = 2106410
LIGHT = 16052714
CLOSE = 11550768
KEY = 15262938

skill paint(buffer, width, height, count) {
    ink.rect(buffer, width, 0, 0, width, height, PAPER)
    ink.rect(buffer, width, 0, 0, width, BAR, NIGHT)
    ink.rect(buffer, width, width - BAR, 0, BAR, BAR, CLOSE)
    ink.body(buffer, width, 16, 16, "Saltic", LIGHT)
    ink.body(buffer, width, width - 28, 16, "x", LIGHT)
    @label = num.text(count)
    @label_x = (width - str.bytes(label) * 16) / 2
    ink.large(buffer, width, label_x, 112, label, INK)
    ink.body(buffer, width, (width - 32) / 2, 156, "счёт", INK)
    @minus_x = 40
    @plus_x = width - 40 - BUTTON_W
    @button_y = height - 28 - BUTTON_H
    ink.rect(buffer, width, minus_x, button_y, BUTTON_W, BUTTON_H, KEY)
    ink.rect(buffer, width, plus_x, button_y, BUTTON_W, BUTTON_H, KEY)
    ink.large(buffer, width, minus_x + 48, button_y + 12, "-", INK)
    ink.large(buffer, width, plus_x + 48, button_y + 12, "+", INK)
    out none
}

skill press(x, y, width, height) {
    (ink.inside(x, y, width - BAR, 0, BAR, BAR) == yes) { out 1 }
    @button_y = height - 28 - BUTTON_H
    (ink.inside(x, y, 40, button_y, BUTTON_W, BUTTON_H) == yes) { out 2 }
    @plus_x = width - 40 - BUTTON_W
    (ink.inside(x, y, plus_x, button_y, BUTTON_W, BUTTON_H) == yes) { out 3 }
    out 0
}

program() {
    out none
}
