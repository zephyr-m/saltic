-- wire — байты протокола Wayland: целые, строки, сравнение имени.

use core.str
use core.bytes

skill put16(buffer, at, value) {
    bytes.set(buffer, at, value % 256)
    bytes.set(buffer, at + 1, value / 256)
    out none
}

skill put32(buffer, at, value) {
    put16(buffer, at, value % 65536)
    put16(buffer, at + 2, value / 65536)
    out none
}

skill get16(buffer, at) {
    out bytes.get(buffer, at) + bytes.get(buffer, at + 1) * 256
}

skill get32(buffer, at) {
    out get16(buffer, at) + get16(buffer, at + 2) * 65536
}

skill put_text(buffer, at, text) {
    @len = str.bytes(text) + 1
    put32(buffer, at, len)
    drum (str.bytes(text)) {
        bytes.set(buffer, at + 4 + beat, str.byte(text, beat))
    }
    out at + 4 + (len + 3) / 4 * 4
}

skill text_is(buffer, at, text) {
    @differs = no
    drum (str.bytes(text)) {
        ((bytes.get(buffer, at + beat) == str.byte(text, beat)) == no) { differs = yes }
    }
    (differs == yes) { out no }
    out yes
}

skill header(buffer, object, opcode, size) {
    put32(buffer, 0, object)
    put16(buffer, 4, opcode)
    put16(buffer, 6, size)
    out none
}

skill request(object, opcode, size) {
    @buffer = bytes.new(size)
    header(buffer, object, opcode, size)
    out buffer
}

skill keep(source, used, total, hold) {
    @left = total - used
    (left < 1) { out 0 }
    drum (left) {
        bytes.set(hold, beat, bytes.get(source, used + beat))
    }
    out left
}

skill join(hold, hold_count, packet, got, joined) {
    drum (hold_count) {
        bytes.set(joined, beat, bytes.get(hold, beat))
    }
    drum (got) {
        bytes.set(joined, hold_count + beat, bytes.get(packet, beat))
    }
    out hold_count + got
}

program() {
    out none
}
