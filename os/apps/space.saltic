use seed
use os.drivers.font
use os.drivers.graphics

TICK_TICKS = 400000
ANGLE_STEPS = 64
TRIG_SCALE = 1024
FOCAL_LENGTH = 760
CUBE_DEPTH = 720
TRIANGLE_DEPTH = 660
CUBE_CENTER_X = 1260
CUBE_CENTER_Y = 560
TRIANGLE_CENTER_X = 500
TRIANGLE_CENTER_Y = 560

SINE = [
    0, 100, 200, 297, 392, 483, 569, 650,
    724, 792, 851, 903, 946, 980, 1004, 1019,
    1024, 1019, 1004, 980, 946, 903, 851, 792,
    724, 650, 569, 483, 392, 297, 200, 100,
    0, 0 - 100, 0 - 200, 0 - 297, 0 - 392, 0 - 483, 0 - 569, 0 - 650,
    0 - 724, 0 - 792, 0 - 851, 0 - 903, 0 - 946, 0 - 980, 0 - 1004, 0 - 1019,
    0 - 1024, 0 - 1019, 0 - 1004, 0 - 980, 0 - 946, 0 - 903, 0 - 851, 0 - 792,
    0 - 724, 0 - 650, 0 - 569, 0 - 483, 0 - 392, 0 - 297, 0 - 200, 0 - 100,
]

Point = Box {
    x = 0
    y = 0
    z = 0
}

Model = Box {
    angle = 0
    cube = []
    triangle = []
}

skill points(count) {
    @result = []
    @index = 0
    drum (count) {
        result = seed.group.add(result, Point {})
        index = index + 1
    }
    out result
}

skill new() {
    out Model {
        cube = points(8)
        triangle = points(3)
    }
}

skill wrap(value, limit) {
    out value - value / limit * limit
}

skill sine(angle) {
    out seed.group.item(SINE, wrap(angle, ANGLE_STEPS))
}

skill project(points, index, x, y, z, angle_y, angle_x, depth_offset) {
    @sin_y = sine(angle_y)
    @cos_y = sine(angle_y + 16)
    @sin_x = sine(angle_x)
    @cos_x = sine(angle_x + 16)

    @turned_x = (x * cos_y + z * sin_y) / TRIG_SCALE
    @turned_z = (z * cos_y - x * sin_y) / TRIG_SCALE
    @turned_y = (y * cos_x - turned_z * sin_x) / TRIG_SCALE
    @depth = (y * sin_x + turned_z * cos_x) / TRIG_SCALE + depth_offset
    (depth < 1) { depth = 1 }

    @point = seed.group.item(points, index)
    point.x = turned_x * FOCAL_LENGTH / depth
    point.y = 0 - turned_y * FOCAL_LENGTH / depth
    point.z = depth
    out none
}

skill center(points, count, center_x, center_y) {
    @index = 0
    drum (count) {
        @point = seed.group.item(points, index)
        point.x = point.x + center_x
        point.y = point.y + center_y
        index = index + 1
    }
    out none
}

skill place_cube(model) {
    @angle_x = wrap(model.angle / 2 + 6, ANGLE_STEPS)
    @angle_y = model.angle
    @size = 160
    project(model.cube, 0, 0 - size, 0 - size, 0 - size, angle_y, angle_x, CUBE_DEPTH)
    project(model.cube, 1, size,     0 - size, 0 - size, angle_y, angle_x, CUBE_DEPTH)
    project(model.cube, 2, size,     size,     0 - size, angle_y, angle_x, CUBE_DEPTH)
    project(model.cube, 3, 0 - size, size,     0 - size, angle_y, angle_x, CUBE_DEPTH)
    project(model.cube, 4, 0 - size, 0 - size, size,     angle_y, angle_x, CUBE_DEPTH)
    project(model.cube, 5, size,     0 - size, size,     angle_y, angle_x, CUBE_DEPTH)
    project(model.cube, 6, size,     size,     size,     angle_y, angle_x, CUBE_DEPTH)
    project(model.cube, 7, 0 - size, size,     size,     angle_y, angle_x, CUBE_DEPTH)
    center(model.cube, 8, CUBE_CENTER_X, CUBE_CENTER_Y)
    out none
}

skill place_triangle(model) {
    @angle_y = wrap(ANGLE_STEPS - model.angle, ANGLE_STEPS)
    @angle_x = 4
    @size = 200
    project(model.triangle, 0, 0 - size, 0 - 130, 0, angle_y, angle_x, TRIANGLE_DEPTH)
    project(model.triangle, 1, size,     0 - 130, 0, angle_y, angle_x, TRIANGLE_DEPTH)
    project(model.triangle, 2, 0,        size,    0, angle_y, angle_x, TRIANGLE_DEPTH)
    center(model.triangle, 3, TRIANGLE_CENTER_X, TRIANGLE_CENTER_Y)
    out none
}

skill place(model) {
    place_cube(model)
    place_triangle(model)
    out none
}

skill edge(screen, points, from, to, ink) {
    @left = seed.group.item(points, from)
    @right = seed.group.item(points, to)
    graphics.graphics_line(screen, left.x, left.y, right.x, right.y, ink)
    graphics.graphics_line(screen, left.x + 1, left.y, right.x + 1, right.y, ink)
    graphics.graphics_line(screen, left.x, left.y + 1, right.x, right.y + 1, ink)
    out none
}

skill draw_cube(screen, model, ink) {
    edge(screen, model.cube, 0, 1, ink)
    edge(screen, model.cube, 1, 2, ink)
    edge(screen, model.cube, 2, 3, ink)
    edge(screen, model.cube, 3, 0, ink)
    edge(screen, model.cube, 4, 5, ink)
    edge(screen, model.cube, 5, 6, ink)
    edge(screen, model.cube, 6, 7, ink)
    edge(screen, model.cube, 7, 4, ink)
    edge(screen, model.cube, 0, 4, ink)
    edge(screen, model.cube, 1, 5, ink)
    edge(screen, model.cube, 2, 6, ink)
    edge(screen, model.cube, 3, 7, ink)
    out none
}

skill draw_triangle(screen, model, ink) {
    @a = seed.group.item(model.triangle, 0)
    @b = seed.group.item(model.triangle, 1)
    @c = seed.group.item(model.triangle, 2)
    graphics.graphics_triangle(screen, a.x, a.y, b.x, b.y, c.x, c.y, ink)
    out none
}

skill draw_shapes(screen, model, ink) {
    draw_triangle(screen, model, ink)
    draw_cube(screen, model, ink)
    out none
}

skill draw(screen, model) {
    graphics.graphics_fill(screen, graphics.Ink.BACKGROUND)
    font.graphics_text(screen, 180, 140, "## SALTIC SPACE", graphics.Ink.FOREGROUND)
    font.graphics_body_text(screen, 180, 214, "TRIANGLE", graphics.Ink.FOREGROUND)
    font.graphics_body_text(screen, 1120, 214, "CUBE", graphics.Ink.FOREGROUND)
    font.graphics_body_text(screen, 180, 940, "INTEGER PERSPECTIVE / TWO FORMS / DIRECT SPACE", graphics.Ink.FOREGROUND)
    place(model)
    draw_shapes(screen, model, graphics.Ink.FOREGROUND)
    out none
}

skill tick(screen, model) {
    draw_shapes(screen, model, graphics.Ink.BACKGROUND)
    model.angle = wrap(model.angle + 1, ANGLE_STEPS)
    place(model)
    draw_shapes(screen, model, graphics.Ink.FOREGROUND)
    out model
}
