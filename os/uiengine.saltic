use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.screen.graphics
use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.jtml
use os.uiengine.layout
use os.uiengine.components.desktop
use os.uiengine.components.desktop.pointer
use os.uiengine.components.desktop.tile

PAGE = 24
DIM = 55

skill show(source) {
    @screen = graphics.open(firmware.guest_base())
    @root = jtml.read_tree(source)
    (jtml.tag_of(root) == "desktop") { out layout.draw_node(screen, root, 0, 0, screen.width, canvas.CREAM) }
    graphics.fill(screen, 0, 0, screen.width, screen.height, canvas.paint(screen, canvas.PAPER))
    layout.draw_node(screen, root, PAGE, PAGE, screen.width - 2 * PAGE, canvas.PAPER)
    @layer = jtml.prop(jtml.props_of(root), "overlay")
    (jtml.tag_of(layer) == "") { out none }
    out draw_layer(screen, layer)
}

skill draw_layer(screen, layer) {
    @tag = jtml.tag_of(layer)
    @props = jtml.props_of(layer)
    @size = layout.measure_node(layer)
    (tag == "toast") {
        @wide = canvas.width_of(jtml.prop_words(props, "width", "md"))
        out layout.draw_node(screen, layer, screen.width - wide - PAGE, screen.height - size.height - PAGE, wide, canvas.PAPER)
    }
    shapes.dim(screen, DIM)
    @under = canvas.mix(canvas.PAPER, canvas.BLACK, 100 - DIM, 100)
    (tag == "drawer") { out layout.draw_node(screen, layer, PAGE, screen.height - size.height, screen.width - 2 * PAGE, under) }
    (tag == "sheet") {
        @wide = canvas.width_of(jtml.prop_words(props, "width", "md"))
        out layout.draw_node(screen, layer, screen.width - wide, 0, wide, under)
    }
    @wide = canvas.width_of(jtml.prop_words(props, "width", "lg"))
    out layout.draw_node(screen, layer, (screen.width - wide) / 2, (screen.height - size.height) / 2, wide, under)
}

Cursor = Box {
    arrow = pointer.Cursor {},
    hover = -1,
    kept = firmware.Phys {}
}

skill desktop_apps(source) {
    out desktop.apps_of(jtml.props_of(jtml.read_tree(source)), "apps")
}

skill app_name(source, index) {
    (index < 0) { out "" }
    @app = group.get(desktop_apps(source), index)
    out app.name
}

skill point(source, cursor, x, y) {
    @screen = graphics.open(firmware.guest_base())
    pointer.hide(screen, cursor.arrow)
    @apps = desktop_apps(source)
    @under = pointer.app_at(group.count(apps), x, y)
    ((under == cursor.hover) == no) {
        (cursor.hover > -1) { pointer.ring_off(screen, cursor.hover, cursor.kept) }
        (under > -1) { cursor.kept = pointer.ring_on(screen, under, group.get(apps, under)) }
        cursor.hover = under
    }
    pointer.show_at(screen, cursor.arrow, x, y)
    out under
}

skill retitle(source, cursor, window) {
    @screen = graphics.open(firmware.guest_base())
    pointer.hide(screen, cursor.arrow)
    @props = jtml.props_of(jtml.read_tree(source))
    @shown = desktop.repaint_bar(screen, jtml.with_words(props, "window", window))
    out pointer.show_at(screen, cursor.arrow, cursor.arrow.x, cursor.arrow.y)
}

skill new_voice() {
    out desktop.new_voice()
}

skill voice_frame(cursor, voice) {
    @screen = graphics.open(firmware.guest_base())
    pointer.hide(screen, cursor.arrow)
    desktop.voice_frame(screen, voice)
    out pointer.show_at(screen, cursor.arrow, cursor.arrow.x, cursor.arrow.y)
}

skill voice_click(cursor, voice, x, y) {
    @screen = graphics.open(firmware.guest_base())
    (desktop.voice_hit(screen, x, y) == no) { out no }
    pointer.hide(screen, cursor.arrow)
    desktop.toggle_voice(screen, voice)
    pointer.show_at(screen, cursor.arrow, cursor.arrow.x, cursor.arrow.y)
    out yes
}

skill voice_off(voice) {
    out desktop.hide_voice(graphics.open(firmware.guest_base()), voice)
}
