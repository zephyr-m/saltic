use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml

ROW = 36
CELL_PADDING = 12

skill replace_at(items, index, value) {
    out group.concat(group.add(group.slice(items, 0, index), value), group.slice(items, index + 1, group.count(items)))
}

skill cell_words(cell) {
    out cell.words
}

skill column_widths(props) {
    @head = jtml.prop(props, "columns")
    @widths = []
    drum (head.items) { widths = group.add(widths, fonts.measure(beat.words, fonts.MEDIUM) + 2 * CELL_PADDING) }
    @body = jtml.prop(props, "rows")
    drum (body.items) {
        @cells = beat.items
        drum (group.count(cells)) {
            @wide = fonts.measure(cell_words(group.get(cells, beat)), fonts.REGULAR) + 2 * CELL_PADDING
            (wide > group.get(widths, beat)) { widths = replace_at(widths, beat, wide) }
        }
    }
    out widths
}

skill table_width(props) {
    @total = 0
    drum (column_widths(props)) { total = total + beat }
    out total
}

skill table_height(props) {
    @body = jtml.prop(props, "rows")
    out ROW * (group.count(body.items) + 1)
}

skill draw_cells(screen, x, y, cells, widths, face, ink) {
    @pen = x
    drum (group.count(cells)) {
        fonts.draw_text(screen, pen + CELL_PADDING, y + (ROW - face.line) / 2, cell_words(group.get(cells, beat)), ink, face)
        pen = pen + group.get(widths, beat)
    }
    out none
}

skill draw_table(screen, x, y, width, props, under) {
    @widths = column_widths(props)
    @head = jtml.prop(props, "columns")
    draw_cells(screen, x, y, head.items, widths, fonts.MEDIUM, canvas.ZINC_500)
    shapes.hairline(screen, x, y + ROW - 1, width, canvas.ZINC_200)
    @body = jtml.prop(props, "rows")
    @top = y + ROW
    drum (body.items) {
        draw_cells(screen, x, top, beat.items, widths, fonts.REGULAR, canvas.ZINC_900)
        top = top + ROW
        shapes.hairline(screen, x, top - 1, width, canvas.ZINC_200)
    }
    out top - y
}
