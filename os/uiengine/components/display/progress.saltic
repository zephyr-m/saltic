-- progress — полоса прогресса: value в процентах, ширина от родителя.
--
-- draw_progress(screen, x, y, width, props, under) -> HEIGHT (8)

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.jtml

HEIGHT = 8
WIDTH = 240

skill draw_progress(screen, x, y, width, props, under) {
    @radius = HEIGHT / 2
    shapes.rounded(screen, x, y, width, HEIGHT, radius, canvas.ZINC_100, under)
    @done = width * jtml.prop_amount(props, "value", 0) / 100
    (done < HEIGHT) { out HEIGHT }
    shapes.rounded(screen, x, y, done, HEIGHT, radius, canvas.ZINC_900, canvas.ZINC_100)
    out HEIGHT
}
