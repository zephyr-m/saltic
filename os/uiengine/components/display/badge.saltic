-- badge — метка-пилюля: text, variant (canvas.variant_look), шрифт SMALL.
--
-- badge_width(props) -> ширина
-- draw_badge(screen, x, y, props, under) -> HEIGHT (20)

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml

HEIGHT = 20
PADDING = 8

skill badge_width(props) {
    out fonts.measure(jtml.prop_words(props, "text", ""), fonts.SMALL) + 2 * PADDING
}

skill draw_badge(screen, x, y, props, under) {
    @style = canvas.variant_look(jtml.prop_words(props, "variant", "default"))
    shapes.framed_box(screen, x, y, badge_width(props), HEIGHT, HEIGHT / 2, style, under)
    @face = fonts.SMALL
    fonts.draw_text(screen, x + PADDING, y + (HEIGHT - face.line) / 2, jtml.prop_words(props, "text", ""), style.ink, face)
    out HEIGHT
}
