-- status — empty (icon, title, text — пустое состояние по центру) и spinner (иконка loader).
--
-- empty_size(props) -> canvas.Size
-- draw_empty(screen, x, y, width, props, under) -> высота
-- draw_spinner(screen, x, y, props) -> размер иконки

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

MEDIA = 40
GAP = 12

skill empty_size(props) {
    @title = fonts.MEDIUM
    @body = fonts.REGULAR
    @wide = fonts.measure(jtml.prop_words(props, "title", ""), title)
    @text_wide = fonts.measure(jtml.prop_words(props, "text", ""), body)
    (text_wide > wide) { wide = text_wide }
    out canvas.Size { width = wide, height = MEDIA + GAP + title.line + 4 + body.line }
}

skill draw_empty(screen, x, y, width, props, under) {
    @size = empty_size(props)
    @middle = x + width / 2
    shapes.rounded(screen, middle - MEDIA / 2, y, MEDIA, MEDIA, 8, canvas.ZINC_100, under)
    icons.draw_icon(screen, middle - icons.SIZE / 2, y + (MEDIA - icons.SIZE) / 2, jtml.prop_words(props, "icon", "search"), canvas.ZINC_900)
    @title = fonts.MEDIUM
    @body = fonts.REGULAR
    @heading = jtml.prop_words(props, "title", "")
    @top = y + MEDIA + GAP
    fonts.draw_text(screen, middle - fonts.measure(heading, title) / 2, top, heading, canvas.ZINC_900, title)
    @hint = jtml.prop_words(props, "text", "")
    fonts.draw_text(screen, middle - fonts.measure(hint, body) / 2, top + title.line + 4, hint, canvas.ZINC_500, body)
    out size.height
}

skill draw_spinner(screen, x, y, props) {
    out icons.draw_icon(screen, x, y, "loader", canvas.ZINC_500)
}
