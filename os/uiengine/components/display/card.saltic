use os.uiengine.canvas
use os.uiengine.shapes

RADIUS = 10
PADDING = 16
GAP = 12

skill is_frame(tag) {
    (tag == "card") { out yes }
    (tag == "popover") { out yes }
    (tag == "dialog") { out yes }
    (tag == "sheet") { out yes }
    (tag == "drawer") { out yes }
    out tag == "toast"
}

skill frame_radius(tag) {
    (tag == "popover") { out 8 }
    (tag == "toast") { out 8 }
    (tag == "dialog") { out 12 }
    (tag == "drawer") { out 12 }
    (tag == "sheet") { out 1 }
    out RADIUS
}

skill frame_blur(tag) {
    (tag == "popover") { out 6 }
    (tag == "toast") { out 8 }
    (tag == "dialog") { out 12 }
    (tag == "drawer") { out 12 }
    (tag == "sheet") { out 10 }
    (tag == "drawer") { out 10 }
    out 2
}

skill frame_padding(tag) {
    (tag == "popover") { out 12 }
    (tag == "dialog") { out 24 }
    (tag == "sheet") { out 24 }
    (tag == "drawer") { out 32 }
    out PADDING
}

skill draw_frame(screen, tag, x, y, width, height, under) {
    @radius = frame_radius(tag)
    shapes.shadow(screen, x, y, width, height, radius, under, frame_blur(tag))
    shapes.framed_box(screen, x, y, width, height, radius, canvas.Look { fill = canvas.WHITE, edge = canvas.ZINC_200, framed = yes }, under)
    out canvas.WHITE
}
