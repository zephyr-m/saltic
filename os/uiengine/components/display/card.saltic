-- card — рамки card, popover, dialog, sheet, drawer, window, toast: тень, скругление, отступы.
-- draw_frame отдаёт цвет внутри рамки (WHITE), которым дети считают сглаживание.
--
-- is_frame(tag) -> yes для рамок
-- frame_radius / frame_blur / frame_padding(tag) -> пиксели по тегу
-- draw_frame(screen, tag, x, y, width, height, under) -> canvas.WHITE; у drawer — ручка сверху
-- frame_header(tag) -> TITLE_BAR для window, иначе 0
-- draw_title(screen, x, y, width, title) -> TITLE_BAR — заголовок окна с кнопками

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.icons

RADIUS = 10
PADDING = 16
GAP = 12
TITLE_BAR = 36

skill is_frame(tag) {
    (tag == "card") { out yes }
    (tag == "popover") { out yes }
    (tag == "dialog") { out yes }
    (tag == "sheet") { out yes }
    (tag == "drawer") { out yes }
    (tag == "window") { out yes }
    out tag == "toast"
}

skill frame_radius(tag) {
    (tag == "popover") { out 8 }
    (tag == "toast") { out 8 }
    (tag == "dialog") { out 12 }
    (tag == "drawer") { out 12 }
    (tag == "sheet") { out 1 }
    out RADIUS
}

skill frame_blur(tag) {
    (tag == "popover") { out 6 }
    (tag == "toast") { out 8 }
    (tag == "dialog") { out 12 }
    (tag == "drawer") { out 12 }
    (tag == "sheet") { out 10 }
    (tag == "drawer") { out 10 }
    (tag == "window") { out 8 }
    out 2
}

skill frame_padding(tag) {
    (tag == "popover") { out 12 }
    (tag == "dialog") { out 24 }
    (tag == "sheet") { out 24 }
    (tag == "drawer") { out 32 }
    out PADDING
}

skill draw_frame(screen, tag, x, y, width, height, under) {
    @radius = frame_radius(tag)
    shapes.shadow(screen, x, y, width, height, radius, under, frame_blur(tag))
    shapes.framed_box(screen, x, y, width, height, radius, canvas.Look { fill = canvas.WHITE, edge = canvas.ZINC_200, framed = yes }, under)
    (tag == "drawer") { shapes.rounded(screen, x + (width - 100) / 2, y + 12, 100, 6, 3, canvas.ZINC_100, canvas.WHITE) }
    out canvas.WHITE
}

skill frame_header(tag) {
    (tag == "window") { out TITLE_BAR }
    out 0
}

skill draw_title(screen, x, y, width, title) {
    shapes.hairline(screen, x + 1, y + TITLE_BAR - 1, width - 2, canvas.ZINC_200)
    @face = fonts.MEDIUM
    fonts.draw_text(screen, x + (width - fonts.measure(title, face)) / 2, y + (TITLE_BAR - face.line) / 2, title, canvas.ZINC_900, face)
    icons.draw_icon(screen, x + width - 12 - icons.SIZE, y + (TITLE_BAR - icons.SIZE) / 2, "x", canvas.ZINC_500)
    icons.draw_icon(screen, x + width - 20 - 2 * icons.SIZE, y + (TITLE_BAR - icons.SIZE) / 2, "minus", canvas.ZINC_500)
    shapes.rounded(screen, x + 12, y + (TITLE_BAR - 12) / 2, 12, 12, 6, canvas.ZINC_200, canvas.WHITE)
    out TITLE_BAR
}
