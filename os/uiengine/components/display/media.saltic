use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

SIZE = 32

skill draw_avatar(screen, x, y, props, under) {
    @size = avatar_size(props)
    shapes.rounded(screen, x, y, size, size, size / 2, canvas.ZINC_100, under)
    @face = fonts.MEDIUM
    @letters = jtml.prop_words(props, "text", "")
    fonts.draw_text(screen, x + (size - fonts.measure(letters, face)) / 2, y + (size - face.line) / 2, letters, canvas.ZINC_900, face)
    out size
}

skill avatar_size(props) {
    @token = jtml.prop_words(props, "size", "md")
    (token == "sm") { out 24 }
    (token == "lg") { out 40 }
    out SIZE
}

skill skeleton_height(props) {
    @shape = jtml.prop_words(props, "shape", "line")
    (shape == "circle") { out 40 }
    (shape == "block") { out canvas.height_of(jtml.prop_words(props, "height", "sm")) }
    out 16
}

skill skeleton_width(props) {
    (jtml.prop_words(props, "shape", "line") == "circle") { out 40 }
    out canvas.width_of(jtml.prop_words(props, "width", "xs"))
}

skill draw_skeleton(screen, x, y, width, props, under) {
    @height = skeleton_height(props)
    @radius = 6
    (jtml.prop_words(props, "shape", "") == "circle") {
        radius = height / 2
        width = height
    }
    shapes.rounded(screen, x, y, width, height, radius, canvas.ZINC_100, under)
    out height
}

skill aspect_height(props) {
    @ratio = jtml.prop_words(props, "ratio", "video")
    @percent = 56
    (ratio == "square") { percent = 100 }
    (ratio == "wide") { percent = 42 }
    (ratio == "portrait") { percent = 133 }
    out canvas.width_of(jtml.prop_words(props, "width", "md")) * percent / 100
}

skill draw_aspect(screen, x, y, props, under) {
    @width = canvas.width_of(jtml.prop_words(props, "width", "md"))
    @height = aspect_height(props)
    shapes.rounded(screen, x, y, width, height, 8, canvas.ZINC_100, under)
    icons.draw_icon(screen, x + (width - icons.SIZE) / 2, y + (height - icons.SIZE) / 2, "image", canvas.ZINC_500)
    out height
}
