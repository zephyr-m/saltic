-- typography — текстовые теги: heading, title, text, muted, small, kbd.
-- Начертание и цвет по тегу: heading — HEADING, title — SEMIBOLD, muted и small — серые; kbd — пилюля.
--
-- is_typography(tag) -> yes для своих тегов
-- face_for(tag) -> fonts.Face / ink_for(tag) -> canvas.Rgb
-- typography_size(tag, props) -> canvas.Size
-- draw_typography(screen, tag, props, x, y) -> высота строки

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml

skill is_typography(tag) {
    (tag == "heading") { out yes }
    (tag == "title") { out yes }
    (tag == "text") { out yes }
    (tag == "muted") { out yes }
    (tag == "kbd") { out yes }
    out tag == "small"
}

skill face_for(tag) {
    (tag == "heading") { out fonts.HEADING }
    (tag == "title") { out fonts.SEMIBOLD }
    (tag == "small") { out fonts.SMALL }
    out fonts.REGULAR
}

skill ink_for(tag) {
    (tag == "muted") { out canvas.ZINC_500 }
    (tag == "small") { out canvas.ZINC_500 }
    out canvas.ZINC_900
}

skill typography_size(tag, props) {
    @face = face_for(tag)
    (tag == "kbd") {
        @small = fonts.SMALL
        out canvas.Size { width = fonts.measure(jtml.prop_words(props, "text", ""), small) + 12, height = 20 }
    }
    out canvas.Size { width = fonts.measure(jtml.prop_words(props, "text", ""), face), height = face.line }
}

skill draw_typography(screen, tag, props, x, y) {
    @face = face_for(tag)
    (tag == "kbd") {
        @small = fonts.SMALL
        @label = jtml.prop_words(props, "text", "")
        shapes.rounded(screen, x, y, fonts.measure(label, small) + 12, 20, 4, canvas.ZINC_100, canvas.WHITE)
        fonts.draw_text(screen, x + 6, y + (20 - small.line) / 2, label, canvas.ZINC_500, small)
        out 20
    }
    fonts.draw_text(screen, x, y, jtml.prop_words(props, "text", ""), ink_for(tag), face)
    out face.line
}
