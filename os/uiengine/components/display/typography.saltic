use os.uiengine.canvas
use os.uiengine.fonts
use os.uiengine.jtml

skill is_typography(tag) {
    (tag == "heading") { out yes }
    (tag == "title") { out yes }
    (tag == "text") { out yes }
    (tag == "muted") { out yes }
    out tag == "small"
}

skill face_for(tag) {
    (tag == "heading") { out fonts.HEADING }
    (tag == "title") { out fonts.SEMIBOLD }
    (tag == "small") { out fonts.SMALL }
    out fonts.REGULAR
}

skill ink_for(tag) {
    (tag == "muted") { out canvas.ZINC_500 }
    (tag == "small") { out canvas.ZINC_500 }
    out canvas.ZINC_900
}

skill typography_size(tag, props) {
    @face = face_for(tag)
    out canvas.Size { width = fonts.measure(jtml.prop_words(props, "text", ""), face), height = face.line }
}

skill draw_typography(screen, tag, props, x, y) {
    @face = face_for(tag)
    fonts.draw_text(screen, x, y, jtml.prop_words(props, "text", ""), ink_for(tag), face)
    out face.line
}
