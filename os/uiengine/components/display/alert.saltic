-- alert — уведомление в рамке: icon (по умолчанию info), title, text; variant destructive — красным.
--
-- alert_height(props) -> высота (заголовок + строка текста)
-- draw_alert(screen, x, y, width, props, under) -> высота

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

PADDING = 12
RADIUS = 8
ICON_GAP = 10

skill alert_height(props) {
    @title = fonts.MEDIUM
    @body = fonts.REGULAR
    out 2 * PADDING + title.line + body.line
}

skill draw_alert(screen, x, y, width, props, under) {
    @tone = canvas.ZINC_900
    @muted = canvas.ZINC_500
    (jtml.prop_words(props, "variant", "default") == "destructive") {
        tone = canvas.RED_500
        muted = canvas.RED_500
    }
    @height = alert_height(props)
    shapes.framed_box(screen, x, y, width, height, RADIUS, canvas.variant_look("outline"), under)
    icons.draw_icon(screen, x + PADDING, y + PADDING + 2, jtml.prop_words(props, "icon", "info"), tone)
    @left = x + PADDING + icons.SIZE + ICON_GAP
    @title = fonts.MEDIUM
    fonts.draw_text(screen, left, y + PADDING, jtml.prop_words(props, "title", ""), tone, title)
    fonts.draw_text(screen, left, y + PADDING + title.line, jtml.prop_words(props, "text", ""), muted, fonts.REGULAR)
    out height
}
