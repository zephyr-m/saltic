use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml

HEIGHT = 36
INSET = 4
PADDING = 12
RADIUS = 8

skill labels_of(props) {
    @found = jtml.prop(props, "items")
    @labels = []
    drum (found.items) { labels = group.add(labels, beat.words) }
    out labels
}

skill tabs_width(props) {
    @width = 2 * INSET
    drum (labels_of(props)) { width = width + fonts.measure(beat, fonts.MEDIUM) + 2 * PADDING }
    out width
}

skill draw_tabs(screen, x, y, props, under) {
    shapes.rounded(screen, x, y, tabs_width(props), HEIGHT, RADIUS, canvas.ZINC_100, under)
    @chosen = jtml.prop_amount(props, "value", 0)
    @face = fonts.MEDIUM
    @pen = x + INSET
    @labels = labels_of(props)
    drum (group.count(labels)) {
        @label = group.get(labels, beat)
        @wide = fonts.measure(label, face) + 2 * PADDING
        @ink = canvas.ZINC_500
        (beat == chosen) {
            shapes.shadow(screen, pen, y + INSET, wide, HEIGHT - 2 * INSET, RADIUS - 2, canvas.ZINC_100, 2)
            shapes.rounded(screen, pen, y + INSET, wide, HEIGHT - 2 * INSET, RADIUS - 2, canvas.WHITE, canvas.ZINC_100)
            ink = canvas.ZINC_900
        }
        fonts.draw_text(screen, pen + PADDING, y + (HEIGHT - face.line) / 2, label, ink, face)
        pen = pen + wide
    }
    out HEIGHT
}
