-- menus — navigation-menu: полоса пунктов items (text, open); у открытого — панель links (title, text) в две колонки.
--
-- open_links(props) -> ссылки открытого пункта или []
-- nav_width(props) -> PANEL (440) / nav_height(props) -> высота с панелью
-- draw_nav(screen, x, y, props, under) -> высота

use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

BAR = 36
PANEL = 440
LINK = 60
PADDING = 12

skill open_links(props) {
    @found = jtml.prop(props, "items")
    drum (found.items) {
        (jtml.prop_truth(beat, "open") == yes) {
            @links = jtml.prop(beat, "links")
            out links.items
        }
    }
    out []
}

skill nav_height(props) {
    @links = open_links(props)
    (group.count(links) == 0) { out BAR }
    out BAR + 6 + (group.count(links) + 1) / 2 * LINK + 2 * PADDING
}

skill nav_width(props) {
    out PANEL
}

skill draw_nav(screen, x, y, props, under) {
    @found = jtml.prop(props, "items")
    @medium = fonts.MEDIUM
    @pen = x
    @panel_x = x
    drum (found.items) {
        @label = jtml.prop_words(beat, "text", "")
        @wide = fonts.measure(label, medium) + 24 + icons.SMALL + 4
        (jtml.prop_truth(beat, "open") == yes) {
            shapes.rounded(screen, pen, y, wide, BAR, 6, canvas.ZINC_100, under)
            panel_x = pen
        }
        fonts.draw_text(screen, pen + 12, y + (BAR - medium.line) / 2, label, canvas.ZINC_900, medium)
        icons.draw_small_icon(screen, pen + wide - 12 - icons.SMALL, y + (BAR - icons.SMALL) / 2, "chevron-down", canvas.ZINC_900)
        pen = pen + wide + 4
    }
    @links = open_links(props)
    (group.count(links) == 0) { out BAR }
    @top = y + BAR + 6
    @height = nav_height(props) - BAR - 6
    shapes.shadow(screen, panel_x, top, PANEL, height, 8, under, 6)
    shapes.framed_box(screen, panel_x, top, PANEL, height, 8, canvas.variant_look("outline"), under)
    @column = (PANEL - 2 * PADDING) / 2
    @small = fonts.REGULAR
    drum (group.count(links)) {
        @link = group.get(links, beat)
        @lx = panel_x + PADDING + (beat - beat / 2 * 2) * column
        @ly = top + PADDING + beat / 2 * LINK
        (beat == 0) { shapes.rounded(screen, lx, ly, column - 4, LINK - 4, 6, canvas.ZINC_100, canvas.WHITE) }
        fonts.draw_text(screen, lx + 10, ly + 8, jtml.prop_words(link, "title", ""), canvas.ZINC_900, medium)
        fonts.draw_text(screen, lx + 10, ly + 8 + medium.line, jtml.prop_words(link, "text", ""), canvas.ZINC_500, small)
    }
    out nav_height(props)
}
