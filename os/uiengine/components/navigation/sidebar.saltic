use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

WIDTH = 240
HEIGHT = 560
PADDING = 12
ITEM = 32
LABEL = 28

skill draw_entry(screen, x, y, width, entry) {
    @face = fonts.REGULAR
    (jtml.prop_truth(entry, "active") == yes) {
        shapes.rounded(screen, x, y, width, ITEM, 6, canvas.ZINC_100, canvas.PAPER)
        face = fonts.MEDIUM
    }
    icons.draw_icon(screen, x + 8, y + (ITEM - icons.SIZE) / 2, jtml.prop_words(entry, "icon", "dot"), canvas.ZINC_900)
    fonts.draw_text(screen, x + 32, y + (ITEM - face.line) / 2, jtml.prop_words(entry, "text", ""), canvas.ZINC_900, face)
    out ITEM
}

skill draw_sidebar(screen, x, y, props, under) {
    @width = canvas.width_of(jtml.prop_words(props, "width", "sm"))
    @height = canvas.height_of(jtml.prop_words(props, "height", "xl"))
    shapes.framed_box(screen, x, y, width, height, 10, canvas.Look { fill = canvas.PAPER, edge = canvas.ZINC_200, framed = yes }, under)
    shapes.rounded(screen, x + PADDING, y + PADDING, 32, 32, 8, canvas.ZINC_900, canvas.PAPER)
    icons.draw_icon(screen, x + PADDING + 8, y + PADDING + 8, jtml.prop_words(props, "icon", "home"), canvas.PAPER)
    @semibold = fonts.SEMIBOLD
    @small = fonts.SMALL
    fonts.draw_text(screen, x + PADDING + 42, y + PADDING, jtml.prop_words(props, "title", ""), canvas.ZINC_900, semibold)
    fonts.draw_text(screen, x + PADDING + 42, y + PADDING + semibold.line, jtml.prop_words(props, "subtitle", ""), canvas.ZINC_500, small)
    @top = y + PADDING + 48
    @found = jtml.prop(props, "groups")
    drum (found.items) {
        fonts.draw_text(screen, x + PADDING + 8, top + (LABEL - small.line) / 2, jtml.prop_words(beat, "title", ""), canvas.ZINC_500, small)
        top = top + LABEL
        @entries = jtml.prop(beat, "items")
        drum (entries.items) { top = top + draw_entry(screen, x + PADDING, top, width - 2 * PADDING, beat) }
        top = top + 8
    }
    @foot = y + height - PADDING - 36
    shapes.hairline(screen, x + 1, foot - PADDING, width - 2, canvas.ZINC_200)
    shapes.rounded(screen, x + PADDING, foot + 2, 32, 32, 16, canvas.ZINC_200, canvas.PAPER)
    @medium = fonts.MEDIUM
    @initials = jtml.prop_words(props, "initials", "")
    fonts.draw_text(screen, x + PADDING + (32 - fonts.measure(initials, medium)) / 2, foot + 2 + (32 - medium.line) / 2, initials, canvas.ZINC_900, medium)
    fonts.draw_text(screen, x + PADDING + 42, foot, jtml.prop_words(props, "user", ""), canvas.ZINC_900, medium)
    fonts.draw_text(screen, x + PADDING + 42, foot + medium.line, jtml.prop_words(props, "email", ""), canvas.ZINC_500, small)
    icons.draw_icon(screen, x + width - PADDING - icons.SIZE, foot + 10, "chevrons", canvas.ZINC_500)
    out height
}
