use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

HEIGHT = 60
MEDIA = 36
PADDING = 12

skill draw_item(screen, x, y, width, props, under) {
    @inner = under
    (jtml.prop_words(props, "variant", "") == "outline") {
        shapes.framed_box(screen, x, y, width, HEIGHT, 8, canvas.Look { fill = under, edge = canvas.ZINC_200, framed = yes }, under)
    }
    @pen = x + PADDING
    @symbol = jtml.prop_words(props, "icon", "")
    ((symbol == "") == no) {
        shapes.rounded(screen, pen, y + (HEIGHT - MEDIA) / 2, MEDIA, MEDIA, 8, canvas.ZINC_100, inner)
        icons.draw_icon(screen, pen + (MEDIA - icons.SIZE) / 2, y + (HEIGHT - icons.SIZE) / 2, symbol, canvas.ZINC_900)
        pen = pen + MEDIA + PADDING
    }
    @title = fonts.MEDIUM
    @body = fonts.REGULAR
    @top = y + (HEIGHT - title.line - body.line) / 2
    fonts.draw_text(screen, pen, top, jtml.prop_words(props, "title", ""), canvas.ZINC_900, title)
    fonts.draw_text(screen, pen, top + title.line, jtml.prop_words(props, "text", ""), canvas.ZINC_500, body)
    @action = jtml.prop_words(props, "action", "")
    (action == "") { out HEIGHT }
    @medium = fonts.MEDIUM
    @wide = fonts.measure(action, medium) + 24
    @left = x + width - PADDING - wide
    shapes.framed_box(screen, left, y + (HEIGHT - 28) / 2, wide, 28, 6, canvas.variant_look("outline"), inner)
    fonts.draw_text(screen, left + 12, y + (HEIGHT - medium.line) / 2, action, canvas.ZINC_900, medium)
    out HEIGHT
}
