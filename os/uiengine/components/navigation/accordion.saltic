-- accordion — accordion (items с title и text, value — раскрытый номер) и collapsible (title, text, open).
--
-- accordion_height(props) -> высота / draw_accordion(screen, x, y, width, props, under) -> высота
-- collapsible_height(props) -> высота / draw_collapsible(screen, x, y, width, props, under) -> высота

use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

ROW = 44
GAP = 12

skill accordion_height(props) {
    @found = jtml.prop(props, "items")
    @open = jtml.prop_amount(props, "value", -1)
    @height = ROW * group.count(found.items)
    @face = fonts.REGULAR
    (open > -1) { height = height + face.line + GAP }
    out height
}

skill draw_accordion(screen, x, y, width, props, under) {
    @found = jtml.prop(props, "items")
    @open = jtml.prop_amount(props, "value", -1)
    @title = fonts.MEDIUM
    @body = fonts.REGULAR
    @top = y
    drum (group.count(found.items)) {
        @item = group.get(found.items, beat)
        fonts.draw_text(screen, x, top + (ROW - title.line) / 2, jtml.prop_words(item, "title", ""), canvas.ZINC_900, title)
        @symbol = "chevron-down"
        (beat == open) { symbol = "chevron-up" }
        icons.draw_icon(screen, x + width - icons.SIZE, top + (ROW - icons.SIZE) / 2, symbol, canvas.ZINC_500)
        top = top + ROW
        (beat == open) {
            fonts.draw_text(screen, x, top - GAP / 2, jtml.prop_words(item, "text", ""), canvas.ZINC_500, body)
            top = top + body.line + GAP
        }
        shapes.hairline(screen, x, top - 1, width, canvas.ZINC_200)
    }
    out top - y
}

skill collapsible_height(props) {
    @title = fonts.MEDIUM
    @body = fonts.REGULAR
    (jtml.prop_truth(props, "open") == no) { out 32 }
    out 32 + 8 + body.line + 20
}

skill draw_collapsible(screen, x, y, width, props, under) {
    @title = fonts.MEDIUM
    fonts.draw_text(screen, x, y + (32 - title.line) / 2, jtml.prop_words(props, "title", ""), canvas.ZINC_900, title)
    shapes.framed_box(screen, x + width - 32, y, 32, 32, 6, canvas.Look { fill = under, edge = canvas.ZINC_200, framed = yes }, under)
    icons.draw_icon(screen, x + width - 24, y + 8, "chevrons", canvas.ZINC_900)
    (jtml.prop_truth(props, "open") == no) { out 32 }
    @body = fonts.REGULAR
    shapes.framed_box(screen, x, y + 40, width, body.line + 20, 6, canvas.variant_look("outline"), under)
    fonts.draw_text(screen, x + 12, y + 50, jtml.prop_words(props, "text", ""), canvas.ZINC_900, body)
    out collapsible_height(props)
}
