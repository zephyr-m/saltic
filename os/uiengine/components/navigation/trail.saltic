-- trail — breadcrumb (items — тексты через chevron-right) и pagination (value — текущая из трёх, «Назад»/«Далее»).
--
-- crumbs_width(props) -> ширина / draw_crumbs(screen, x, y, props) -> высота строки
-- pages_width(props) -> ширина / draw_pages(screen, x, y, props, under) -> PAGE (32)
-- edge_width(label) -> ширина / draw_edge(screen, x, y, label, symbol, before) -> x после кнопки края

use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons
use os.uiengine.components.navigation.tabs

CRUMB_GAP = 6
PAGE = 32
RADIUS = 6
PAGE_GAP = 4
SHOWN = 3

skill crumbs_width(props) {
    @width = 0
    drum (tabs.labels_of(props)) { width = width + fonts.measure(beat, fonts.REGULAR) + 2 * CRUMB_GAP + icons.SMALL }
    out width - 2 * CRUMB_GAP - icons.SMALL
}

skill draw_crumbs(screen, x, y, props) {
    @labels = tabs.labels_of(props)
    @face = fonts.REGULAR
    @pen = x
    drum (group.count(labels)) {
        @last = beat == group.count(labels) - 1
        @ink = canvas.ZINC_500
        (last == yes) { ink = canvas.ZINC_900 }
        pen = fonts.draw_text(screen, pen, y, group.get(labels, beat), ink, face)
        (last == no) {
            icons.draw_small_icon(screen, pen + CRUMB_GAP, y + (face.line - icons.SMALL) / 2, "chevron-right", canvas.ZINC_500)
            pen = pen + 2 * CRUMB_GAP + icons.SMALL
        }
    }
    out face.line
}

skill edge_width(label) {
    out fonts.measure(label, fonts.MEDIUM) + icons.SIZE + 4 + 2 * 10
}

skill pages_width(props) {
    out edge_width("Назад") + edge_width("Далее") + (SHOWN + 1) * (PAGE + PAGE_GAP) + PAGE_GAP
}

skill draw_edge(screen, x, y, label, symbol, before) {
    @face = fonts.MEDIUM
    @top = y + (PAGE - face.line) / 2
    @icon_top = y + (PAGE - icons.SIZE) / 2
    (before == yes) {
        icons.draw_icon(screen, x + 10, icon_top, symbol, canvas.ZINC_900)
        fonts.draw_text(screen, x + 10 + icons.SIZE + 4, top, label, canvas.ZINC_900, face)
        out x + edge_width(label) + PAGE_GAP
    }
    @after = fonts.draw_text(screen, x + 10, top, label, canvas.ZINC_900, face)
    icons.draw_icon(screen, after + 4, icon_top, symbol, canvas.ZINC_900)
    out x + edge_width(label) + PAGE_GAP
}

skill draw_pages(screen, x, y, props, under) {
    @current = jtml.prop_amount(props, "value", 1)
    @face = fonts.MEDIUM
    @pen = draw_edge(screen, x, y, "Назад", "chevron-left", yes)
    drum (SHOWN) {
        @number = beat + 1
        (number == current) { shapes.framed_box(screen, pen, y, PAGE, PAGE, RADIUS, canvas.variant_look("outline"), under) }
        @digits = "{number}"
        fonts.draw_text(screen, pen + (PAGE - fonts.measure(digits, face)) / 2, y + (PAGE - face.line) / 2, digits, canvas.ZINC_900, face)
        pen = pen + PAGE + PAGE_GAP
    }
    icons.draw_icon(screen, pen + (PAGE - icons.SIZE) / 2, y + (PAGE - icons.SIZE) / 2, "more", canvas.ZINC_900)
    pen = pen + PAGE + PAGE_GAP
    draw_edge(screen, pen, y, "Далее", "chevron-right", no)
    out PAGE
}
