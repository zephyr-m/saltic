-- tree — дерево файлов: children с text, open, active; у папок (есть children) стрелка и иконка folder.
--
-- rows_of(items) -> число видимых строк / tree_height(props) -> высота
-- draw_branch(screen, x, y, width, items, depth) -> высота ветки
-- draw_tree(screen, x, y, width, props) -> высота

use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

ROW = 28
INDENT = 16

skill rows_of(items) {
    @count = 0
    drum (items) {
        count = count + 1
        (jtml.prop_truth(beat, "open") == yes) { count = count + rows_of(jtml.prop_children(beat)) }
    }
    out count
}

skill tree_height(props) {
    out rows_of(jtml.prop_children(props)) * ROW
}

skill draw_branch(screen, x, y, width, items, depth) {
    @top = y
    @face = fonts.REGULAR
    drum (items) {
        @left = x + depth * INDENT
        @folder = group.count(jtml.prop_children(beat)) > 0
        (jtml.prop_truth(beat, "active") == yes) { shapes.rounded(screen, x, top, width, ROW, 6, canvas.ZINC_100, canvas.WHITE) }
        @symbol = "file"
        (folder == yes) {
            @arrow = "chevron-right"
            (jtml.prop_truth(beat, "open") == yes) { arrow = "chevron-down" }
            icons.draw_small_icon(screen, left + 2, top + (ROW - icons.SMALL) / 2, arrow, canvas.ZINC_500)
            symbol = "folder"
        }
        icons.draw_icon(screen, left + 18, top + (ROW - icons.SIZE) / 2, symbol, canvas.ZINC_500)
        fonts.draw_text(screen, left + 40, top + (ROW - face.line) / 2, jtml.prop_words(beat, "text", ""), canvas.ZINC_900, face)
        top = top + ROW
        (jtml.prop_truth(beat, "open") == yes) { top = top + draw_branch(screen, x, top, width, jtml.prop_children(beat), depth + 1) }
    }
    out top - y
}

skill draw_tree(screen, x, y, width, props) {
    draw_branch(screen, x, y, width, jtml.prop_children(props), 0)
    out tree_height(props)
}
