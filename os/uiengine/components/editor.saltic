use os.uiengine.canvas
use os.uiengine.jtml
use os.uiengine.components.editor.code
use os.uiengine.components.editor.tree

skill editor_own(tag) {
    (tag == "tree") { out yes }
    out tag == "code"
}

skill editor_size(tag, props) {
    (tag == "tree") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "xs")), height = tree.tree_height(props) } }
    out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "xl")), height = code.code_height(props) }
}

skill editor_draw(screen, tag, props, x, y, width, under) {
    (tag == "tree") { out tree.draw_tree(screen, x, y, width, props) }
    out code.draw_code(screen, x, y, width, props, under)
}
