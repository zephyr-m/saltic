use os.uiengine.canvas
use os.uiengine.jtml
use os.uiengine.components.editor.code

skill editor_own(tag) {
    out tag == "code"
}

skill editor_size(tag, props) {
    out canvas.Size { width = jtml.prop_amount(props, "width", 520), height = code.code_height(props) }
}

skill editor_draw(screen, tag, props, x, y, width, under) {
    out code.draw_code(screen, x, y, width, props, under)
}
