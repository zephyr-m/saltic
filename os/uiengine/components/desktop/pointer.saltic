-- pointer — стрелка курсора и кольцо-подсветка плитки под ней.
-- Курсор хранит строки экрана под собой (shapes.keep_rows); сетка плиток та же, что в tile.draw_apps (36, 60, шаг 104×112).
--
-- Cursor { x, y, kept, shown }
-- hide(screen, cursor) / show_at(screen, cursor, x, y) — убрать и нарисовать стрелку
-- app_left / app_top(index) -> координаты плитки
-- app_at(count, x, y) -> номер плитки под точкой или -1
-- ring_on(screen, index, app) -> Phys сохранённого места; рисует кольцо SAGE
-- ring_off(screen, index, kept) — вернуть экран под кольцом

use core.str
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.screen.graphics
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.components.desktop.tile

ARROW = [
    "K..........",
    "KK.........",
    "KWK........",
    "KWWK.......",
    "KWWWK......",
    "KWWWWK.....",
    "KWWWWWK....",
    "KWWWWWWK...",
    "KWWWWWWWK..",
    "KWWWWWWWWK.",
    "KWWWWWKKKKK",
    "KWWKWWK....",
    "KWK.KWWK...",
    "KK..KWWK...",
    "K....KWWK..",
    ".....KWWK..",
    "......KK..."
]
WIDE = 11
TALL = 17
RING = 6

Cursor = Box {
    x = 0,
    y = 0,
    kept = firmware.Phys {},
    shown = no
}

skill hide(screen, cursor) {
    (cursor.shown == no) { out none }
    shapes.put_back_rows(screen, cursor.kept, cursor.x, cursor.y, WIDE, TALL)
    cursor.shown = no
    out none
}

skill show_at(screen, cursor, x, y) {
    hide(screen, cursor)
    cursor.x = x
    cursor.y = y
    cursor.kept = shapes.keep_rows(screen, x, y, WIDE, TALL)
    cursor.shown = yes
    @black = canvas.paint(screen, canvas.INK)
    @white = canvas.paint(screen, canvas.WHITE)
    drum (TALL) {
        @row = group.get(ARROW, beat)
        @top = y + beat
        drum (WIDE) {
            @mark = str.get(row, beat)
            (mark == "K") { graphics.fill(screen, x + beat, top, 1, 1, black) }
            (mark == "W") { graphics.fill(screen, x + beat, top, 1, 1, white) }
        }
    }
    out none
}

skill app_left(index) {
    out 36 + index / 6 * 104
}

skill app_top(index) {
    out 60 + (index - index / 6 * 6) * 112
}

skill app_at(count, x, y) {
    drum (count) {
        @left = app_left(beat) - 16
        @top = app_top(beat) - 6
        (x > left - 1) {
            (x < left + tile.TILE + 32) {
                (y > top - 1) {
                    (y < top + tile.TILE + 40) { out beat }
                }
            }
        }
    }
    out -1
}

skill ring_on(screen, index, app) {
    @x = app_left(index) - RING
    @y = app_top(index) - RING
    @size = tile.TILE + 2 * RING
    @kept = shapes.keep_rows(screen, x, y, size, size)
    shapes.framed_box(screen, x, y, size, size, 22, canvas.Look { fill = canvas.SAGE, edge = canvas.SAGE, framed = yes }, canvas.CREAM)
    tile.draw_tile(screen, app_left(index), app_top(index), tile.TILE, app.tint, app.icon)
    out kept
}

skill ring_off(screen, index, kept) {
    @x = app_left(index) - RING
    @y = app_top(index) - RING
    @size = tile.TILE + 2 * RING
    out shapes.put_back_rows(screen, kept, x, y, size, size)
}
