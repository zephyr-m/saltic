-- glass — стеклянное окно CareOS с заголовком и подпись капли в стеклянной пилюле.
--
-- draw_window(screen, x, y, width, height, title) -> canvas.CREAM — фон внутри
-- draw_voice(screen, label, middle, y) -> x после текста

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.icons

TITLE = 40
RADIUS = 18
PADDING = 18

skill draw_window(screen, x, y, width, height, title) {
    shapes.soft_shadow(screen, x, y + 4, width, height, RADIUS, 14)
    shapes.glass(screen, x, y, width, height, RADIUS, canvas.CREAM, 80)
    shapes.hairline(screen, x + RADIUS, y, width - 2 * RADIUS, canvas.WHITE)
    shapes.hairline(screen, x + 1, y + TITLE, width - 2, canvas.STONE)
    icons.draw_icon(screen, x + 14, y + (TITLE - icons.SIZE) / 2, "info", canvas.SAGE)
    @face = fonts.SEMIBOLD
    fonts.draw_text(screen, x + 38, y + (TITLE - face.line) / 2, title, canvas.INK, face)
    @button = 22
    shapes.rounded(screen, x + width - 14 - button, y + (TITLE - button) / 2, button, button, button / 2, canvas.SAND, canvas.CREAM)
    icons.draw_small_icon(screen, x + width - 14 - button + 5, y + (TITLE - icons.SMALL) / 2, "x", canvas.BARK)
    shapes.rounded(screen, x + width - 20 - 2 * button, y + (TITLE - button) / 2, button, button, button / 2, canvas.SAND, canvas.CREAM)
    icons.draw_small_icon(screen, x + width - 20 - 2 * button + 5, y + (TITLE - icons.SMALL) / 2, "minus", canvas.BARK)
    out canvas.CREAM
}

skill draw_voice(screen, label, middle, y) {
    @face = fonts.MONO
    @wide = fonts.measure(label, face) + 16
    shapes.glass(screen, middle - wide / 2, y, wide, face.line + 4, (face.line + 4) / 2, canvas.WHITE, 78)
    out fonts.draw_text(screen, middle - wide / 2 + 8, y + 2, label, canvas.INK, face)
}
