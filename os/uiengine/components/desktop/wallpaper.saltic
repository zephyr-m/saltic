use core.mem
use core.group
use os.target.uefi_x86_64.graphics
use os.uiengine.canvas

ANCHORS = [[0, 0, 178, 200, 166], [1366, 0, 124, 174, 212], [260, 768, 192, 207, 176], [880, 768, 234, 196, 162], [1150, 330, 112, 170, 214], [560, 260, 205, 214, 190]]
SOFTNESS = 1500

skill paint_row(screen, row) {
    out paint_span(screen, row, 0, screen.width)
}

skill paint_span(screen, row, left, width) {
    @start = row * screen.stride * graphics.PIXEL_BYTES
    drum (width) {
        @x = left + beat
        @total = 0
        @red = 0
        @green = 0
        @blue = 0
        drum (ANCHORS) {
            @dx = (x - group.get(beat, 0)) / 4
            @dy = (row - group.get(beat, 1)) / 4
            @weight = 100000000 / (dx * dx + dy * dy + SOFTNESS)
            total = total + weight / 64
            red = red + group.get(beat, 2) * (weight / 64)
            green = green + group.get(beat, 3) * (weight / 64)
            blue = blue + group.get(beat, 4) * (weight / 64)
        }
        mem.store32(screen.memory, start + x * graphics.PIXEL_BYTES, graphics.color(screen, red / total, green / total, blue / total))
    }
    out none
}

skill paint_wallpaper(screen) {
    drum (screen.height) { paint_row(screen, beat) }
    out none
}
