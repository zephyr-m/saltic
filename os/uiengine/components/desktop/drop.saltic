-- drop — «капля» голоса: четыре цветных метабола в стекле, дышат и отзываются на уровень звука.
-- Рисует квадрат DROP_SIDE (256) от drop.x/y; рабочие таблицы — в памяти прошивки
-- (пул DROP_WORK_BYTES, раскладка DROP_AT_*); фон под каплей сохраняется и возвращается.
-- Дроби — в 1/1024, углы — в DROP_TURN; синус и профили — таблицами. mode 0 — покой,
-- 2 — демо-уровень (нет микрофона). Только x86_64-uefi.
--
-- DropBlob { x, y, r, hue, target, timer, red, green, blue, cx, cy, cr, near, reach }
-- Drop { blobs, moment, mode, level, seed, x, y, shown, kept, pool, work, left, top, right, bottom }
-- new_drop() -> Drop / toggle_drop(drop) — переключить mode
-- drop_step(drop) — шаг времени: уровень и движение капель
-- draw_drop(screen, drop, x, y) — в первый раз готовит таблицы и фон, потом перерисовывает; MemoryExhausted
-- hide_drop(screen, drop) — вернуть фон и освободить память
-- Таблицы (синус, профили, обратные длины) — ребёнок drop/tables.
-- Внутри: drop_sine / drop_cosine / drop_phase, drop_tint, drop_move_blob, drop_prepare,
--     drop_field_row, drop_shell_row, drop_pixel, drop_paint*, drop_pool / drop_free и прочие drop_*.

use core.mem
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.platform.uefi
use os.uiengine.shapes
use os.uiengine.components.desktop.drop.tables
use core.num
use core.usize
use core.address
use core.u8
use core.u16
use core.u32

DROP_HUES = [195, 215, 205]
DROP_CALM = [801, 1602, 70, 100, 50, 55, 29372, 133509]
DROP_QUIET = [801, 1602, 75, 100, 50, 50, 34713, 160211]
DROP_MIDDLE = [961, 1923, 70, 150, 45, 60, 37383, 133509]
DROP_LOUD = [2670, 5340, 70, 100, 60, 70, 16021, 66754]
DROP_LAMP_SPEC = [120, -100, 300]
DROP_LAMP_CAUSTIC = [460, 760, 180]
DROP_TURN = 16777216
DROP_QUARTER = 4194304
DROP_RADIAN = 2670177
DROP_DEGREE = 46603
DROP_BREATH = 763
DROP_SIDE = 256
DROP_PAD = 32
DROP_CELLS = 128
DROP_ORIGIN = 256
DROP_GLASS = 128
DROP_NEAR = 288
DROP_REACH = 272
DROP_SQUARES = 8192
DROP_PAIRS = 801
DROP_PAIR_ZERO = 400
DROP_AT_SQUARE = 0
DROP_AT_SPEC = 16384
DROP_AT_CAUSTIC = 22528
DROP_AT_GOO_PAIR = 28672
DROP_AT_HALO_PAIR = 32768
DROP_AT_FIELD = 36864
DROP_AT_GLOW_RED = 69632
DROP_AT_GLOW_GREEN = 135168
DROP_AT_GLOW_BLUE = 200704
DROP_AT_GLOW = 266240
DROP_AT_GLEAM = 299008
DROP_AT_SPARK = 331776
DROP_AT_DARK = 364544
DROP_AT_BACK = 397312
DROP_AT_BUMP = 593920
DROP_AT_SHADE = 596992
DROP_AT_RING = 600064
DROP_WORK_BYTES = 606208

DropBlob = Box {
    x = 0,
    y = 0,
    r = 3200,
    hue = 0,
    target = 0,
    timer = 0,
    red = 0,
    green = 0,
    blue = 0,
    cx = 0,
    cy = 0,
    cr = 0,
    near = 0,
    reach = 0
}

Drop = Box {
    blobs = [],
    moment = 0,
    mode = 0,
    level = 0,
    seed = 1,
    x = 0,
    y = 0,
    shown = no,
    kept = 0,
    pool = 0,
    work = 0,
    left = 0,
    top = 0,
    right = 128,
    bottom = 128
}

skill new_drop() {
    out Drop { blobs = [DropBlob {}, DropBlob {}, DropBlob {}, DropBlob {}] }
}

skill toggle_drop(drop) {
    (drop.mode == 0) {
        drop.mode = 2
        out none
    }
    drop.mode = 0
    drop.level = 0
    out none
}

skill drop_random(drop) {
    drop.seed = (drop.seed * 75 + 74) % 65537
    out drop.seed
}

skill drop_sine(phase) {
    @angle = phase % DROP_TURN
    (angle < 0) { angle = angle + DROP_TURN }
    @whole = angle / DROP_DEGREE
    @fraction = angle - whole * DROP_DEGREE
    @from_value = group.get(tables.DROP_SINES, whole % 360)
    @to_value = group.get(tables.DROP_SINES, (whole + 1) % 360)
    out from_value + (to_value - from_value) * fraction / DROP_DEGREE
}

skill drop_cosine(phase) {
    out drop_sine(phase + DROP_QUARTER)
}

skill drop_phase(moment, k) {
    @high = moment / 4096
    @low = moment - high * 4096
    out (high * k % 4096 * 4096 + low * k) % DROP_TURN
}

skill drop_demo_level(moment) {
    @slow = drop_sine(drop_phase(moment, 2967))
    @fast = drop_sine(drop_phase(moment, 11609))
    @pulse = drop_sine(drop_phase(moment, 668))
    @level = slow * fast / 1024 * 35 / 100
    (pulse > 614) { level = level + 256 }
    (level < 0) { level = 0 }
    out level
}

skill drop_tint(blob) {
    @hue = blob.hue / 1024 % 360
    @sector = hue / 60
    @fraction = (blob.hue - sector * 61440) * 1024 / 61440
    @rising = 153 * fraction / 1024
    @falling = 153 - rising
    blob.red = 77
    blob.green = 77
    blob.blue = 77
    pick {
        (sector == 0) {
            blob.red = 230
            blob.green = 77 + rising
        }
        (sector == 1) {
            blob.red = 77 + falling
            blob.green = 230
        }
        (sector == 2) {
            blob.green = 230
            blob.blue = 77 + rising
        }
        (sector == 3) {
            blob.green = 77 + falling
            blob.blue = 230
        }
        (sector == 4) {
            blob.red = 77 + rising
            blob.blue = 230
        }
        {
            blob.red = 230
            blob.blue = 77 + falling
        }
    }
    out none
}

skill drop_move_blob(drop, index, leader) {
    @blob = group.get(drop.blobs, index)
    @noise = drop_random(drop) - 32768
    @angle = index * DROP_QUARTER + noise * group.get(leader, 3) / 100 * 2037 / 1000
    @reactivity = group.get(leader, 4)
    @swell = 1920 + drop_sine(drop_phase(drop.moment, group.get(leader, 0)) + index * DROP_RADIAN) * 1280 / 1024
    @breath = drop_sine(drop_phase(drop.moment, DROP_BREATH)) * 640 / 1024
    @shove = drop.level * reactivity / 8
    @wave = drop_sine(drop_phase(drop.moment, group.get(leader, 6)) + drop.level * 26076 - index * group.get(leader, 7))
    @ripple = wave * drop.level / 1024 * reactivity * group.get(leader, 5) / 800
    @distance = swell + breath + shove + ripple
    @tx = 19200 + drop_cosine(angle) * distance / 1024
    @ty = 19200 + drop_sine(angle) * distance / 1024
    @inertia = group.get(leader, 2)
    blob.x = (blob.x * inertia + tx * (100 - inertia)) / 100
    blob.y = (blob.y * inertia + ty * (100 - inertia)) / 100
    @wobble = drop_sine(drop_phase(drop.moment, group.get(leader, 1)) + index * DROP_RADIAN)
    blob.r = 3200 + wobble * 640 / 1024 + drop.level * reactivity * 96 / 1024
    (blob.timer < 1) {
        blob.target = group.get(DROP_HUES, drop_random(drop) % 3) * 1024
        blob.timer = 61 + drop_random(drop) % 120
    }
    (blob.hue == 0) { blob.hue = blob.target }
    blob.hue = blob.hue + (blob.target - blob.hue) * 15 / 1000
    blob.timer = blob.timer - 1
    out drop_tint(blob)
}

skill drop_step(drop) {
    drop.moment = (drop.moment + 16) % DROP_TURN
    (drop.mode == 0) { drop.level = 0 }
    (drop.mode == 2) { drop.level = drop_demo_level(drop.moment) }
    @leader = DROP_CALM
    (drop.mode > 0) {
        leader = DROP_QUIET
        (drop.level > 204) { leader = DROP_MIDDLE }
        (drop.level > 512) { leader = DROP_LOUD }
    }
    drum (4) { drop_move_blob(drop, beat, leader) }
    out none
}

skill drop_root(amount) {
    (amount < 2) { out amount }
    @guess = amount
    @next = (guess + 1) / 2
    drum (40) {
        (next >= guess) { out guess }
        guess = next
        next = (amount / guess + guess) / 2
    }
    out guess
}

skill drop_lamp(work, where, lamp, vx, vy) {
    @dx = group.get(lamp, 0) - vx
    @dy = group.get(lamp, 1) - vy
    @dz = group.get(lamp, 2)
    @length = drop_root(dx * dx + dy * dy + dz * dz)
    @hx = dx * 1024 / length
    @hy = dy * 1024 / length
    @hz = dz * 1024 / length + 1024
    @size = drop_root(hx * hx + hy * hy + hz * hz)
    mem.store16(work, usize.from(where), u16.from(hx * 1024 / size + 1024))
    mem.store16(work, usize.from(where + 2), u16.from(hy * 1024 / size + 1024))
    mem.store16(work, usize.from(where + 4), u16.from(hz * 1024 / size + 1024))
    out none
}

skill drop_prepare(work) {
    @radius = 0
    drum (DROP_SQUARES) {
        @square = beat
        drum (16) {
            ((2 * radius + 1) * (2 * radius + 1) <= 256 * square) { radius = radius + 1 }
        }
        mem.store16(work, usize.from(DROP_AT_SQUARE + square * 2), u16.from(radius))
    }
    drum (1024) {
        @spot = beat
        @vx = ((spot % 32) * 8 + 4 - DROP_PAD) * 25 / 8
        @vy = (spot / 32 * 8 + 4 - DROP_PAD) * 25 / 8
        drop_lamp(work, DROP_AT_SPEC + spot * 6, DROP_LAMP_SPEC, vx, vy)
        drop_lamp(work, DROP_AT_CAUSTIC + spot * 6, DROP_LAMP_CAUSTIC, vx, vy)
    }
    drum (1025) {
        mem.store16(work, usize.from(DROP_AT_BUMP + beat * 2), u16.from(drop_table(tables.DROP_BUMP, beat)))
        mem.store16(work, usize.from(DROP_AT_SHADE + beat * 2), u16.from(drop_table(tables.DROP_SHADE, beat) * 225 / 1024))
        mem.store16(work, usize.from(DROP_AT_RING + beat * 2), u16.from((1024 - drop_table(tables.DROP_CORE, beat)) * 881 / 1024))
    }
    drum (DROP_PAIRS) {
        @gap = beat - DROP_PAIR_ZERO
        @shell = drop_phi(gap - DROP_GLASS, 5, 4)
        mem.store32(work, usize.from(DROP_AT_GOO_PAIR + beat * 4), u32.from(drop_phi(gap, 5, 4) * 2048 + shell))
        mem.store32(work, usize.from(DROP_AT_HALO_PAIR + beat * 4), u32.from(drop_phi(gap, 5, 7) * 2048 + shell))
    }
    out none
}

skill drop_background(work, source, swap) {
    drum (DROP_SIDE * DROP_SIDE) {
        @pixel = num.from(mem.load32(source, usize.from(beat * 4)))
        @high = pixel / 65536 % 256
        @middle = pixel / 256 % 256
        @low = pixel % 256
        @red = high
        @blue = low
        (swap == yes) {
            red = low
            blue = high
        }
        mem.store8(work, usize.from(DROP_AT_BACK + beat), u8.from(red))
        mem.store8(work, usize.from(DROP_AT_BACK + 65536 + beat), u8.from(middle))
        mem.store8(work, usize.from(DROP_AT_BACK + 131072 + beat), u8.from(blue))
    }
    out none
}

skill drop_phi(gap, mul, div) {
    @away = gap
    (away < 0) { away = -away }
    @index = away * mul / div
    (index > 256) {
        (gap > 0) { out 0 }
        out 1024
    }
    (gap > 0) { out group.get(tables.DROP_PHI, index) }
    out 1024 - group.get(tables.DROP_PHI, index)
}

skill drop_table(table, amount) {
    @index = amount / 8
    (index > 127) { out group.get(table, 128) }
    @low = group.get(table, index)
    out low + (group.get(table, index + 1) - low) * (amount - index * 8) / 8
}

skill drop_field_row(drop, work, ly, left, right) {
    @py = ly * 16 + 8
    @first = ly * DROP_CELLS
    drum (right - left) {
        @lx = left + beat
        @px = lx * 16 + 8
        @halo = 0
        @halo_red = 0
        @halo_green = 0
        @halo_blue = 0
        @shell = 0
        drum (drop.blobs) {
            @dx = px - beat.cx
            @dy = py - beat.cy
            @square = dx * dx + dy * dy
            (square <= beat.reach * beat.reach) {
                @gap = num.from(mem.load16(work, usize.from(DROP_AT_SQUARE + square / 64 * 2))) - beat.cr
                (gap < -DROP_PAIR_ZERO) { gap = -DROP_PAIR_ZERO }
                (gap > DROP_PAIR_ZERO) { gap = DROP_PAIR_ZERO }
                @pair = num.from(mem.load32(work, usize.from(DROP_AT_HALO_PAIR + (gap + DROP_PAIR_ZERO) * 4)))
                @far = pair / 2048
                shell = shell + pair - far * 2048
                (far > 0) {
                    halo = halo + far
                    halo_red = halo_red + far * beat.red
                    halo_green = halo_green + far * beat.green
                    halo_blue = halo_blue + far * beat.blue
                }
            }
        }
        (shell > 1024) { shell = 1024 }
        @here = first + lx
        mem.store16(work, usize.from(DROP_AT_FIELD + here * 2), u16.from(shell))
        @glow = 0
        @red = 0
        @green = 0
        @blue = 0
        (halo > 0) {
            glow = halo
            (glow > 1024) { glow = 1024 }
            glow = glow * 461 / 1024
            red = halo_red / halo * glow
            green = halo_green / halo * glow
            blue = halo_blue / halo * glow
        }
        mem.store32(work, usize.from(DROP_AT_GLOW_RED + here * 4), u32.from(red))
        mem.store32(work, usize.from(DROP_AT_GLOW_GREEN + here * 4), u32.from(green))
        mem.store32(work, usize.from(DROP_AT_GLOW_BLUE + here * 4), u32.from(blue))
        mem.store16(work, usize.from(DROP_AT_GLOW + here * 2), u16.from(glow))
    }
    out none
}

skill drop_shine(work, where, lamp, nx, ny) {
    @hx = num.from(mem.load16(work, usize.from(where + lamp * 6))) - 1024
    @hy = num.from(mem.load16(work, usize.from(where + lamp * 6 + 2))) - 1024
    @hz = num.from(mem.load16(work, usize.from(where + lamp * 6 + 4))) - 1024
    @tilt = (nx * nx + ny * ny) / 16384
    (tilt > 64) { tilt = 64 }
    @facing = (nx * hx + ny * hy + 1024 * hz) / 1024 * group.get(tables.DROP_INVN, tilt) / 1024
    (facing < 0) { facing = 0 }
    (facing > 1024) { facing = 1024 }
    out facing
}

skill drop_power22(v) {
    @p2 = v * v / 1024
    @p4 = p2 * p2 / 1024
    @p8 = p4 * p4 / 1024
    @p16 = p8 * p8 / 1024
    out p16 * p4 / 1024 * p2 / 1024
}

skill drop_power9(v) {
    @p2 = v * v / 1024
    @p4 = p2 * p2 / 1024
    @p8 = p4 * p4 / 1024
    out p8 * v / 1024
}

skill drop_shell_row(drop, work, ly, left, right) {
    @first = ly * DROP_CELLS
    drum (right - left) {
        @lx = left + beat
        @here = first + lx
        @amount = num.from(mem.load16(work, usize.from(DROP_AT_FIELD + here * 2)))
        @above = num.from(mem.load16(work, usize.from(DROP_AT_FIELD + (here - 2 * DROP_CELLS) * 2)))
        mem.store16(work, usize.from(DROP_AT_DARK + here * 2), u16.from(num.from(mem.load16(work, usize.from(DROP_AT_SHADE + above * 2)))))
        @gleam = 0
        @sparkle = 0
        (amount > 160) {
            @bump_left = num.from(mem.load16(work, usize.from(DROP_AT_BUMP + num.from(mem.load16(work, usize.from(DROP_AT_FIELD + (here - 1) * 2))) * 2)))
            @bump_right = num.from(mem.load16(work, usize.from(DROP_AT_BUMP + num.from(mem.load16(work, usize.from(DROP_AT_FIELD + (here + 1) * 2))) * 2)))
            @bump_up = num.from(mem.load16(work, usize.from(DROP_AT_BUMP + num.from(mem.load16(work, usize.from(DROP_AT_FIELD + (here - DROP_CELLS) * 2))) * 2)))
            @bump_down = num.from(mem.load16(work, usize.from(DROP_AT_BUMP + num.from(mem.load16(work, usize.from(DROP_AT_FIELD + (here + DROP_CELLS) * 2))) * 2)))
            @gx = bump_left - bump_right
            @gy = bump_up - bump_down
            @lamp = ly / 4 * 32 + lx / 4
            gleam = drop_power22(drop_shine(work, DROP_AT_SPEC, lamp, gx * 72 / 100, gy * 72 / 100)) * 1126 / 1024
            (gleam > 1024) { gleam = 1024 }
            sparkle = drop_power9(drop_shine(work, DROP_AT_CAUSTIC, lamp, gx * 96 / 100, gy * 96 / 100)) * 922 / 1024 * 922 / 1024
        }
        mem.store16(work, usize.from(DROP_AT_GLEAM + here * 2), u16.from(gleam))
        mem.store16(work, usize.from(DROP_AT_SPARK + here * 2), u16.from(sparkle))
    }
    out none
}

skill drop_pixel(drop, work, px, py, swap) {
    @sx = px * 8 + 4
    @sy = py * 8 + 4
    @goo = 0
    @goo_red = 0
    @goo_green = 0
    @goo_blue = 0
    @shell = 0
    drum (drop.blobs) {
        @dx = sx - beat.cx
        @dy = sy - beat.cy
        @square = dx * dx + dy * dy
        (square <= beat.near * beat.near) {
            @gap = num.from(mem.load16(work, usize.from(DROP_AT_SQUARE + square / 64 * 2))) - beat.cr
            (gap < -DROP_PAIR_ZERO) { gap = -DROP_PAIR_ZERO }
            @pair = num.from(mem.load32(work, usize.from(DROP_AT_GOO_PAIR + (gap + DROP_PAIR_ZERO) * 4)))
            @near = pair / 2048
            shell = shell + pair - near * 2048
            (near > 0) {
                goo = goo + near
                goo_red = goo_red + near * beat.red
                goo_green = goo_green + near * beat.green
                goo_blue = goo_blue + near * beat.blue
            }
        }
    }
    @red = 0
    @green = 0
    @blue = 0
    @alpha = 0
    (goo > 0) {
        @cover = goo
        (cover > 1024) { cover = 1024 }
        alpha = cover * 24 - 7168
        (alpha > 1024) { alpha = 1024 }
        (alpha < 0) { alpha = 0 }
        (alpha > 0) {
            red = goo_red / goo * alpha
            green = goo_green / goo * alpha
            blue = goo_blue / goo * alpha
        }
    }
    @back = py * DROP_SIDE + px
    @under_red = num.from(mem.load8(work, usize.from(DROP_AT_BACK + back)))
    @under_green = num.from(mem.load8(work, usize.from(DROP_AT_BACK + 65536 + back)))
    @under_blue = num.from(mem.load8(work, usize.from(DROP_AT_BACK + 131072 + back)))
    (alpha < 1024) {
        @lx = px / 2
        @ly = py / 2
        @ox = lx - 1
        (px % 2 == 1) { ox = lx + 1 }
        @oy = ly - 1
        (py % 2 == 1) { oy = ly + 1 }
        @i00 = ly * DROP_CELLS + lx
        @i10 = ly * DROP_CELLS + ox
        @i01 = oy * DROP_CELLS + lx
        @i11 = oy * DROP_CELLS + ox
        @glow = (9 * num.from(mem.load16(work, usize.from(DROP_AT_GLOW + i00 * 2))) + 3 * num.from(mem.load16(work, usize.from(DROP_AT_GLOW + i10 * 2))) + 3 * num.from(mem.load16(work, usize.from(DROP_AT_GLOW + i01 * 2))) + num.from(mem.load16(work, usize.from(DROP_AT_GLOW + i11 * 2)))) / 16
        (glow > 0) {
            @rest = 1024 - alpha
            @spread = num.from(mem.load16(work, usize.from(DROP_AT_GLOW + i00 * 2)))
            (spread > 0) {
                @effective = glow * rest / 1024
                red = red + num.from(mem.load32(work, usize.from(DROP_AT_GLOW_RED + i00 * 4))) / spread * effective
                green = green + num.from(mem.load32(work, usize.from(DROP_AT_GLOW_GREEN + i00 * 4))) / spread * effective
                blue = blue + num.from(mem.load32(work, usize.from(DROP_AT_GLOW_BLUE + i00 * 4))) / spread * effective
                alpha = alpha + effective
            }
        }
        (shell > 1024) { shell = 1024 }
        @shape = shell * 24 - 7168
        (shape > 1024) { shape = 1024 }
        (shape > 0) {
            @gleam = (9 * num.from(mem.load16(work, usize.from(DROP_AT_GLEAM + i00 * 2))) + 3 * num.from(mem.load16(work, usize.from(DROP_AT_GLEAM + i10 * 2))) + 3 * num.from(mem.load16(work, usize.from(DROP_AT_GLEAM + i01 * 2))) + num.from(mem.load16(work, usize.from(DROP_AT_GLEAM + i11 * 2)))) / 16 * shape / 1024 * (1024 - alpha) / 1024
            red = red + 255 * gleam
            green = green + 255 * gleam
            blue = blue + 255 * gleam
            alpha = alpha + gleam
            @ring = shape * num.from(mem.load16(work, usize.from(DROP_AT_RING + shell * 2))) / 1024 * (1024 - alpha) / 1024
            red = red + 191 * ring
            green = green + 230 * ring
            blue = blue + 255 * ring
            alpha = alpha + ring
            @sparkle = (9 * num.from(mem.load16(work, usize.from(DROP_AT_SPARK + i00 * 2))) + 3 * num.from(mem.load16(work, usize.from(DROP_AT_SPARK + i10 * 2))) + 3 * num.from(mem.load16(work, usize.from(DROP_AT_SPARK + i01 * 2))) + num.from(mem.load16(work, usize.from(DROP_AT_SPARK + i11 * 2)))) / 16 * shape / 1024 * (1024 - alpha) / 1024
            red = red + 214 * sparkle
            green = green + 239 * sparkle
            blue = blue + 255 * sparkle
            alpha = alpha + sparkle
            @body = shape * 176 / 1024 * (1024 - alpha) / 1024
            red = red + 255 * body
            green = green + 255 * body
            blue = blue + 255 * body
            alpha = alpha + body
        }
        @dark = num.from(mem.load16(work, usize.from(DROP_AT_DARK + i00 * 2))) * (1024 - alpha) / 1024
        red = red + 51 * dark
        green = green + 77 * dark
        blue = blue + 89 * dark
        alpha = alpha + dark
    }
    (alpha > 0) {
        under_red = (under_red * (1024 - alpha) + red) / 1024
        under_green = (under_green * (1024 - alpha) + green) / 1024
        under_blue = (under_blue * (1024 - alpha) + blue) / 1024
        (under_red > 255) { under_red = 255 }
        (under_green > 255) { under_green = 255 }
        (under_blue > 255) { under_blue = 255 }
    }
    (swap == yes) { out under_blue * 65536 + under_green * 256 + under_red }
    out under_red * 65536 + under_green * 256 + under_blue
}

skill drop_paint_row(screen, drop, py, left, right) {
    @swap = screen.format == graphics.FORMAT_RGB
    @from_byte = ((drop.y + py) * screen.stride + drop.x + left) * graphics.PIXEL_BYTES
    drum (right - left) { mem.store32(address.from(screen.memory), usize.from(from_byte + beat * graphics.PIXEL_BYTES), u32.from(drop_pixel(drop, address.from(drop.work), left + beat, py, swap))) }
    out none
}

skill drop_clear_row(screen, drop, py, left, right) {
    @swap = screen.format == graphics.FORMAT_RGB
    @from_byte = ((drop.y + py) * screen.stride + drop.x + left) * graphics.PIXEL_BYTES
    @back = py * DROP_SIDE + left
    drum (right - left) {
        @red = num.from(mem.load8(address.from(drop.work), usize.from(DROP_AT_BACK + back + beat)))
        @green = num.from(mem.load8(address.from(drop.work), usize.from(DROP_AT_BACK + 65536 + back + beat)))
        @blue = num.from(mem.load8(address.from(drop.work), usize.from(DROP_AT_BACK + 131072 + back + beat)))
        @pixel = red * 65536 + green * 256 + blue
        (swap == yes) { pixel = blue * 65536 + green * 256 + red }
        mem.store32(address.from(screen.memory), usize.from(from_byte + beat * graphics.PIXEL_BYTES), u32.from(pixel))
    }
    out none
}

skill drop_paint_band(screen, drop, py, paint_left, paint_right, left, right) {
    (paint_left < left) { drop_clear_row(screen, drop, py, paint_left, left) }
    drop_paint_row(screen, drop, py, drop_higher(paint_left, left), drop_lower(paint_right, right))
    (paint_right > right) { drop_clear_row(screen, drop, py, right, paint_right) }
    out none
}

skill drop_lower(a, b) {
    (a < b) { out a }
    out b
}

skill drop_higher(a, b) {
    (a > b) { out a }
    out b
}

skill drop_paint(screen, drop) {
    @left = DROP_CELLS
    @top = DROP_CELLS
    @right = 0
    @bottom = 0
    drum (drop.blobs) {
        beat.cx = beat.x / 25 + DROP_ORIGIN
        beat.cy = beat.y / 25 + DROP_ORIGIN
        beat.cr = beat.r / 25
        beat.near = beat.cr + DROP_NEAR
        beat.reach = beat.cr + DROP_REACH
        left = drop_lower(left, (beat.cx - beat.reach) / 16)
        top = drop_lower(top, (beat.cy - beat.reach) / 16)
        right = drop_higher(right, (beat.cx + beat.reach) / 16 + 1)
        bottom = drop_higher(bottom, (beat.cy + beat.reach) / 16 + 1)
    }
    left = drop_higher(left, 0)
    top = drop_higher(top, 0)
    right = drop_lower(right, DROP_CELLS)
    bottom = drop_lower(bottom, DROP_CELLS)
    @union_left = drop_lower(left, drop.left)
    @union_top = drop_lower(top, drop.top)
    @union_right = drop_higher(right, drop.right)
    @union_bottom = drop_higher(bottom, drop.bottom)
    drop.left = left
    drop.top = top
    drop.right = right
    drop.bottom = bottom
    @wide_left = drop_higher(union_left - 2, 0)
    @wide_right = drop_lower(union_right + 2, DROP_CELLS)
    @wide_top = drop_higher(union_top - 2, 0)
    @wide_bottom = drop_lower(union_bottom + 2, DROP_CELLS)
    drum (wide_bottom - wide_top) { drop_field_row(drop, address.from(drop.work), wide_top + beat, wide_left, wide_right) }
    @shell_left = drop_higher(union_left, 2)
    @shell_right = drop_lower(union_right, DROP_CELLS - 2)
    @shell_top = drop_higher(union_top, 2)
    @shell_bottom = drop_lower(union_bottom, DROP_CELLS - 2)
    drum (shell_bottom - shell_top) { drop_shell_row(drop, address.from(drop.work), shell_top + beat, shell_left, shell_right) }
    @paint_left = drop_higher(union_left * 2, 2)
    @paint_right = drop_lower(union_right * 2, DROP_SIDE - 2)
    @paint_top = drop_higher(union_top * 2, 2)
    @paint_bottom = drop_lower(union_bottom * 2, DROP_SIDE - 2)
    @fresh_left = drop_higher(left * 2, paint_left)
    @fresh_right = drop_lower(right * 2, paint_right)
    @fresh_top = drop_higher(top * 2, paint_top)
    @fresh_bottom = drop_lower(bottom * 2, paint_bottom)
    drum (paint_bottom - paint_top) {
        @py = paint_top + beat
        pick {
            (py < fresh_top) { drop_clear_row(screen, drop, py, paint_left, paint_right) }
            (py >= fresh_bottom) { drop_clear_row(screen, drop, py, paint_left, paint_right) }
            { drop_paint_band(screen, drop, py, paint_left, paint_right, fresh_left, fresh_right) }
        }
    }
    out none
}

skill drop_pool(size_bytes) {
    @base = firmware.guest_base()
    @services = uefi.boot_services(base)
    @where = firmware.scratch(base, shapes.POOL_AT)
    @got = firmware.call(base, firmware.pointer(services, base, shapes.BOOT_ALLOCATE_POOL), [firmware.number(shapes.LOADER_DATA), firmware.number(size_bytes), where])
    (got.failed == yes) { out error.MemoryExhausted }
    out firmware.pointer(where, base, 0)
}

skill drop_free(pool) {
    @base = firmware.guest_base()
    @services = uefi.boot_services(base)
    out firmware.call(base, firmware.pointer(services, base, shapes.BOOT_FREE_POOL), [pool])
}

skill draw_drop(screen, drop, x, y) {
    (drop.shown == no) {
        @base = firmware.guest_base()
        drop.kept = shapes.keep_rows(screen, x, y, DROP_SIDE, DROP_SIDE)
        drop.pool = drop_pool(DROP_WORK_BYTES)
        drop.work = firmware.guest(drop.pool, base)
        drop_prepare(address.from(drop.work))
        drop_background(address.from(drop.work), firmware.guest(drop.kept, base), screen.format == graphics.FORMAT_RGB)
        drop.x = x
        drop.y = y
        drop.left = 0
        drop.top = 0
        drop.right = DROP_CELLS
        drop.bottom = DROP_CELLS
        drop.shown = yes
    }
    out drop_paint(screen, drop)
}

skill hide_drop(screen, drop) {
    (drop.shown == no) { out none }
    shapes.put_back_rows(screen, drop.kept, drop.x, drop.y, DROP_SIDE, DROP_SIDE)
    drop_free(drop.pool)
    drop.shown = no
    out none
}
