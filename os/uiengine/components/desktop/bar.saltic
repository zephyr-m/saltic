-- bar — верхняя панель стола: лист и title, «· window», справа clock, battery, «сеть», колокольчик с alerts.
--
-- draw_bar(screen, props) -> HEIGHT (36)
-- str_join_dot(window) -> "· window" или ""

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.icons
use os.uiengine.jtml

HEIGHT = 36

skill draw_bar(screen, props) {
    shapes.glass(screen, 0, 0, screen.width, HEIGHT, 1, canvas.WHITE, 72)
    shapes.hairline(screen, 0, HEIGHT - 1, screen.width, canvas.STONE)
    @mono = fonts.MONO
    @top = (HEIGHT - mono.line) / 2
    icons.draw_icon(screen, 24, (HEIGHT - icons.SIZE) / 2, "leaf", canvas.SAGE)
    @pen = fonts.draw_text(screen, 52, top - 1, jtml.prop_words(props, "title", "CareOS"), canvas.INK, fonts.SEMIBOLD)
    fonts.draw_text(screen, pen + 16, top, str_join_dot(jtml.prop_words(props, "window", "")), canvas.BARK, mono)
    @clock = jtml.prop_words(props, "clock", "")
    @right = screen.width - 20 - fonts.measure(clock, mono)
    fonts.draw_text(screen, right, top, clock, canvas.INK, mono)
    @battery = jtml.prop_words(props, "battery", "")
    right = right - 16 - fonts.measure(battery, mono)
    fonts.draw_text(screen, right, top, battery, canvas.INK, mono)
    @net = "сеть"
    right = right - 16 - fonts.measure(net, mono)
    fonts.draw_text(screen, right, top, net, canvas.INK, mono)
    shapes.rounded(screen, right - 12, HEIGHT / 2 - 3, 6, 6, 3, canvas.GROWTH, canvas.WHITE)
    @bell = right - 44
    icons.draw_icon(screen, bell, (HEIGHT - icons.SIZE) / 2, "bell", canvas.SAGE)
    @alerts = jtml.prop_amount(props, "alerts", 0)
    (alerts > 0) {
        shapes.rounded(screen, bell + 10, 6, 14, 14, 7, canvas.ROSE, canvas.WHITE)
        @small = fonts.SMALL
        @digits = "{alerts}"
        fonts.draw_text(screen, bell + 17 - fonts.measure(digits, small) / 2, 6 + (14 - small.line) / 2, digits, canvas.WHITE, small)
    }
    out HEIGHT
}

skill str_join_dot(window) {
    (window == "") { out "" }
    out "· {window}"
}
