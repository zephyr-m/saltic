-- tile — плитки программ и док: градиентный квадрат с иконкой и подпись в стекле.
-- Плитки в колонках по 6, шаг 104×112 от (left, top); док — по центру внизу.
--
-- App { name, icon, tint, open }
-- draw_tile(screen, x, y, size, tint, symbol) -> size
-- draw_label(screen, middle, y, label) -> x после текста
-- draw_apps(screen, apps, left, top) — сетка плиток с подписями
-- dock_width(count) -> ширина / draw_dock(screen, items) — док; open — точка под плиткой

use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.icons

App = Box {
    name = "",
    icon = "",
    tint = "",
    open = no
}

TILE = 64
DOCK_TILE = 48
RADIUS = 18

skill draw_tile(screen, x, y, size, tint, symbol) {
    @pair = canvas.organic_tint(tint)
    shapes.soft_shadow(screen, x, y + 2, size, size, RADIUS, 4)
    shapes.gradient_box(screen, x, y, size, RADIUS * size / TILE, group.get(pair, 0), group.get(pair, 1))
    pick {
        (size > 40) { icons.draw_large_icon(screen, x + (size - icons.LARGE) / 2, y + (size - icons.LARGE) / 2, symbol, canvas.INK) }
        { icons.draw_icon(screen, x + (size - icons.SIZE) / 2, y + (size - icons.SIZE) / 2, symbol, canvas.INK) }
    }
    out size
}

skill draw_label(screen, middle, y, label) {
    @face = fonts.MONO
    @wide = fonts.measure(label, face) + 16
    shapes.glass(screen, middle - wide / 2, y, wide, face.line + 4, (face.line + 4) / 2, canvas.WHITE, 78)
    out fonts.draw_text(screen, middle - wide / 2 + 8, y + 2, label, canvas.INK, face)
}

skill draw_apps(screen, apps, left, top) {
    drum (group.count(apps)) {
        @app = group.get(apps, beat)
        @column = beat / 6
        @row = beat - column * 6
        @x = left + column * 104
        @y = top + row * 112
        draw_tile(screen, x, y, TILE, app.tint, app.icon)
        draw_label(screen, x + TILE / 2, y + TILE + 8, app.name)
    }
    out none
}

skill dock_width(count) {
    out count * (DOCK_TILE + 10) + 14
}

skill draw_dock(screen, items) {
    @count = group.count(items)
    @width = dock_width(count)
    @x = (screen.width - width) / 2
    @y = screen.height - DOCK_TILE - 30
    shapes.soft_shadow(screen, x, y, width, DOCK_TILE + 20, 24, 8)
    shapes.glass(screen, x, y, width, DOCK_TILE + 20, 24, canvas.WHITE, 62)
    drum (count) {
        @item = group.get(items, beat)
        @tile_x = x + 12 + beat * (DOCK_TILE + 10)
        draw_tile(screen, tile_x, y + 8, DOCK_TILE, item.tint, item.icon)
        (item.open == yes) { shapes.rounded(screen, tile_x + DOCK_TILE / 2 - 2, y + DOCK_TILE + 12, 4, 4, 2, canvas.INK, canvas.WHITE) }
    }
    out none
}
