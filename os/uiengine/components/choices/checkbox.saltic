use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

BOX = 16
RADIUS = 4
LABEL_GAP = 8

skill choice_width(props) {
    @label = jtml.prop_words(props, "text", "")
    (label == "") { out BOX }
    out BOX + LABEL_GAP + fonts.measure(label, fonts.REGULAR)
}

skill draw_label(screen, x, y, props) {
    @label = jtml.prop_words(props, "text", "")
    (label == "") { out none }
    @face = fonts.REGULAR
    out fonts.draw_text(screen, x + BOX + LABEL_GAP, y + (BOX - face.line) / 2, label, canvas.ZINC_900, face)
}

skill draw_checkbox(screen, x, y, props, under) {
    pick {
        (jtml.prop_truth(props, "on") == yes) {
            shapes.rounded(screen, x, y, BOX, BOX, RADIUS, canvas.ZINC_900, under)
            icons.draw_small_icon(screen, x + (BOX - icons.SMALL) / 2, y + (BOX - icons.SMALL) / 2, "check", canvas.PAPER)
        }
        { shapes.framed_box(screen, x, y, BOX, BOX, RADIUS, canvas.Look { fill = canvas.WHITE, edge = canvas.ZINC_900, framed = yes }, under) }
    }
    draw_label(screen, x, y, props)
    out BOX
}

skill draw_radio(screen, x, y, props, under) {
    @ring = canvas.Look { fill = canvas.WHITE, edge = canvas.ZINC_900, framed = yes }
    shapes.framed_box(screen, x, y, BOX, BOX, BOX / 2, ring, under)
    (jtml.prop_truth(props, "on") == yes) { shapes.rounded(screen, x + 4, y + 4, BOX - 8, BOX - 8, (BOX - 8) / 2, canvas.ZINC_900, canvas.WHITE) }
    draw_label(screen, x, y, props)
    out BOX
}
