-- slider — ползунок: value в процентах (по умолчанию 50), ширина от родителя.
--
-- draw_slider(screen, x, y, width, props, under) -> THUMB (16)

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.jtml

TRACK = 6
THUMB = 16
WIDTH = 240

skill draw_slider(screen, x, y, width, props, under) {
    @top = y + (THUMB - TRACK) / 2
    shapes.rounded(screen, x, top, width, TRACK, TRACK / 2, canvas.ZINC_100, under)
    @reach = (width - THUMB) * jtml.prop_amount(props, "value", 50) / 100
    (reach > TRACK) { shapes.rounded(screen, x, top, reach + THUMB / 2, TRACK, TRACK / 2, canvas.ZINC_900, canvas.ZINC_100) }
    shapes.shadow(screen, x + reach, y, THUMB, THUMB, THUMB / 2, under, 2)
    shapes.framed_box(screen, x + reach, y, THUMB, THUMB, THUMB / 2, canvas.Look { fill = canvas.WHITE, edge = canvas.ZINC_900, framed = yes }, under)
    out THUMB
}
