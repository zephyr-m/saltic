-- switch — тумблер: on, text — подпись справа.
--
-- switch_width(props) -> ширина с подписью
-- draw_switch(screen, x, y, props, under) -> HEIGHT (20)

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml

WIDTH = 36
HEIGHT = 20
THUMB = 16
LABEL_GAP = 8

skill switch_width(props) {
    @label = jtml.prop_words(props, "text", "")
    (label == "") { out WIDTH }
    out WIDTH + LABEL_GAP + fonts.measure(label, fonts.REGULAR)
}

skill draw_switch(screen, x, y, props, under) {
    @track = canvas.ZINC_200
    @thumb_left = x + 2
    (jtml.prop_truth(props, "on") == yes) {
        track = canvas.ZINC_900
        thumb_left = x + WIDTH - THUMB - 2
    }
    shapes.rounded(screen, x, y, WIDTH, HEIGHT, HEIGHT / 2, track, under)
    shapes.rounded(screen, thumb_left, y + 2, THUMB, THUMB, THUMB / 2, canvas.WHITE, track)
    @label = jtml.prop_words(props, "text", "")
    (label == "") { out HEIGHT }
    @face = fonts.REGULAR
    fonts.draw_text(screen, x + WIDTH + LABEL_GAP, y + (HEIGHT - face.line) / 2, label, canvas.ZINC_900, face)
    out HEIGHT
}
