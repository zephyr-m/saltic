use os.uiengine.canvas
use os.uiengine.components.buttons.button
use os.uiengine.components.buttons.toggle

skill buttons_own(tag) {
    (tag == "button") { out yes }
    (tag == "toggle") { out yes }
    out tag == "toggle-group"
}

skill buttons_size(tag, props) {
    (tag == "button") { out canvas.Size { width = button.button_width(props), height = button.HEIGHT } }
    (tag == "toggle") { out canvas.Size { width = toggle.toggle_width(props), height = toggle.HEIGHT } }
    out canvas.Size { width = toggle.group_width(props), height = toggle.HEIGHT + 2 }
}

skill buttons_draw(screen, tag, props, x, y, under) {
    (tag == "button") { out button.draw_button(screen, x, y, props, under) }
    (tag == "toggle") { out toggle.draw_toggle(screen, x, y, props, under) }
    out toggle.draw_group(screen, x, y, props, under)
}
