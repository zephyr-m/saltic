-- choices — группа выбора: checkbox, radio, switch, slider.
-- slider тянется на ширину родителя.
--
-- choices_own(tag) / choices_stretch(tag) -> yes/no
-- choices_size(tag, props) -> canvas.Size
-- choices_draw(screen, tag, props, x, y, width, under) -> высота
--
-- Дети: checkbox (и radio), switch, slider.

use os.uiengine.canvas
use os.uiengine.jtml
use os.uiengine.components.choices.checkbox
use os.uiengine.components.choices.switch
use os.uiengine.components.choices.slider

skill choices_own(tag) {
    (tag == "checkbox") { out yes }
    (tag == "radio") { out yes }
    (tag == "switch") { out yes }
    out tag == "slider"
}

skill choices_stretch(tag) {
    out tag == "slider"
}

skill choices_size(tag, props) {
    (tag == "switch") { out canvas.Size { width = switch.switch_width(props), height = switch.HEIGHT } }
    (tag == "slider") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "sm")), height = slider.THUMB } }
    out canvas.Size { width = checkbox.choice_width(props), height = checkbox.BOX }
}

skill choices_draw(screen, tag, props, x, y, width, under) {
    (tag == "checkbox") { out checkbox.draw_checkbox(screen, x, y, props, under) }
    (tag == "radio") { out checkbox.draw_radio(screen, x, y, props, under) }
    (tag == "switch") { out switch.draw_switch(screen, x, y, props, under) }
    out slider.draw_slider(screen, x, y, width, props, under)
}
