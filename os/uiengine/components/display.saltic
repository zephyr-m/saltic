use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.jtml
use os.uiengine.icons
use os.uiengine.components.display.badge
use os.uiengine.components.display.progress
use os.uiengine.components.display.typography
use os.uiengine.components.display.card
use os.uiengine.components.display.alert
use os.uiengine.components.display.avatar
use os.uiengine.components.display.table

CARD_PADDING = card.PADDING
CARD_GAP = card.GAP

skill display_own(tag) {
    (tag == "badge") { out yes }
    (tag == "separator") { out yes }
    (tag == "progress") { out yes }
    (tag == "icon") { out yes }
    (tag == "alert") { out yes }
    (tag == "avatar") { out yes }
    (tag == "skeleton") { out yes }
    (tag == "table") { out yes }
    out typography.is_typography(tag)
}

skill display_stretch(tag) {
    (tag == "separator") { out yes }
    (tag == "alert") { out yes }
    (tag == "table") { out yes }
    out tag == "progress"
}

skill display_size(tag, props) {
    (tag == "badge") { out canvas.Size { width = badge.badge_width(props), height = badge.HEIGHT } }
    (tag == "separator") { out canvas.Size { height = 1 } }
    (tag == "icon") { out canvas.Size { width = icons.SIZE, height = icons.SIZE } }
    (tag == "progress") { out canvas.Size { width = jtml.prop_amount(props, "width", progress.WIDTH), height = progress.HEIGHT } }
    (tag == "alert") { out canvas.Size { width = jtml.prop_amount(props, "width", 320), height = alert.alert_height(props) } }
    (tag == "avatar") { out canvas.Size { width = jtml.prop_amount(props, "size", avatar.SIZE), height = jtml.prop_amount(props, "size", avatar.SIZE) } }
    (tag == "skeleton") { out canvas.Size { width = jtml.prop_amount(props, "width", 120), height = jtml.prop_amount(props, "height", 16) } }
    (tag == "table") { out canvas.Size { width = table.table_width(props), height = table.table_height(props) } }
    out typography.typography_size(tag, props)
}

skill display_draw(screen, tag, props, x, y, width, under) {
    (tag == "badge") { out badge.draw_badge(screen, x, y, props, under) }
    (tag == "separator") {
        shapes.hairline(screen, x, y, width, canvas.ZINC_200)
        out 1
    }
    (tag == "progress") { out progress.draw_progress(screen, x, y, width, props, under) }
    (tag == "icon") {
        @ink = canvas.ZINC_900
        (jtml.prop_words(props, "tone", "") == "muted") { ink = canvas.ZINC_500 }
        out icons.draw_icon(screen, x, y, jtml.prop_words(props, "name", ""), ink)
    }
    (tag == "alert") { out alert.draw_alert(screen, x, y, width, props, under) }
    (tag == "avatar") { out avatar.draw_avatar(screen, x, y, props, under) }
    (tag == "skeleton") { out avatar.draw_skeleton(screen, x, y, width, props, under) }
    (tag == "table") { out table.draw_table(screen, x, y, width, props, under) }
    out typography.draw_typography(screen, tag, props, x, y)
}

skill is_frame(tag) {
    out card.is_frame(tag)
}

skill frame_padding(tag) {
    out card.frame_padding(tag)
}

skill draw_frame(screen, tag, x, y, width, height, under) {
    out card.draw_frame(screen, tag, x, y, width, height, under)
}
