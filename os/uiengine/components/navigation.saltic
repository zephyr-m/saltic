use os.uiengine.canvas
use os.uiengine.jtml
use os.uiengine.fonts
use os.uiengine.components.navigation.tabs
use os.uiengine.components.navigation.trail
use os.uiengine.components.navigation.accordion
use os.uiengine.components.navigation.item
use os.uiengine.components.navigation.sidebar
use os.uiengine.components.navigation.menus
use os.uiengine.components.navigation.tree

skill navigation_own(tag) {
    (tag == "tabs") { out yes }
    (tag == "breadcrumb") { out yes }
    (tag == "pagination") { out yes }
    (tag == "collapsible") { out yes }
    (tag == "item") { out yes }
    (tag == "sidebar") { out yes }
    (tag == "navigation-menu") { out yes }
    (tag == "tree") { out yes }
    out tag == "accordion"
}

skill navigation_stretch(tag) {
    (tag == "collapsible") { out yes }
    (tag == "item") { out yes }
    out tag == "accordion"
}

skill navigation_size(tag, props) {
    (tag == "tabs") { out canvas.Size { width = tabs.tabs_width(props), height = tabs.HEIGHT } }
    (tag == "breadcrumb") {
        @face = fonts.REGULAR
        out canvas.Size { width = trail.crumbs_width(props), height = face.line }
    }
    (tag == "pagination") { out canvas.Size { width = trail.pages_width(props), height = trail.PAGE } }
    (tag == "collapsible") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "md")), height = accordion.collapsible_height(props) } }
    (tag == "item") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "md")), height = item.HEIGHT } }
    (tag == "sidebar") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "sm")), height = canvas.height_of(jtml.prop_words(props, "height", "xl")) } }
    (tag == "navigation-menu") { out canvas.Size { width = menus.nav_width(props), height = menus.nav_height(props) } }
    (tag == "tree") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "xs")), height = tree.tree_height(props) } }
    out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "md")), height = accordion.accordion_height(props) }
}

skill navigation_draw(screen, tag, props, x, y, width, under) {
    (tag == "tabs") { out tabs.draw_tabs(screen, x, y, props, under) }
    (tag == "breadcrumb") { out trail.draw_crumbs(screen, x, y, props) }
    (tag == "pagination") { out trail.draw_pages(screen, x, y, props, under) }
    (tag == "collapsible") { out accordion.draw_collapsible(screen, x, y, width, props, under) }
    (tag == "item") { out item.draw_item(screen, x, y, width, props, under) }
    (tag == "sidebar") { out sidebar.draw_sidebar(screen, x, y, props, under) }
    (tag == "navigation-menu") { out menus.draw_nav(screen, x, y, props, under) }
    (tag == "tree") { out tree.draw_tree(screen, x, y, width, props) }
    out accordion.draw_accordion(screen, x, y, width, props, under)
}
