use os.uiengine.canvas
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.components.fields.input
use os.uiengine.components.fields.textarea
use os.uiengine.components.fields.select
use os.uiengine.components.fields.otp
use os.uiengine.components.fields.combobox

skill fields_own(tag) {
    (tag == "input") { out yes }
    (tag == "textarea") { out yes }
    (tag == "select") { out yes }
    (tag == "input-otp") { out yes }
    (tag == "combobox") { out yes }
    out tag == "label"
}

skill fields_stretch(tag) {
    (tag == "input") { out yes }
    (tag == "textarea") { out yes }
    out tag == "select"
}

skill fields_size(tag, props) {
    (tag == "input") { out canvas.Size { width = jtml.prop_amount(props, "width", input.WIDTH), height = input.HEIGHT } }
    (tag == "textarea") { out canvas.Size { width = jtml.prop_amount(props, "width", input.WIDTH), height = textarea.textarea_height(props) } }
    (tag == "select") { out canvas.Size { width = jtml.prop_amount(props, "width", select.WIDTH), height = select.HEIGHT } }
    (tag == "input-otp") { out canvas.Size { width = otp.code_width(props), height = otp.CELL } }
    (tag == "combobox") { out canvas.Size { width = jtml.prop_amount(props, "width", combobox.WIDTH), height = combobox.combobox_height(props) } }
    @face = fonts.MEDIUM
    out canvas.Size { width = fonts.measure(jtml.prop_words(props, "text", ""), face), height = face.line }
}

skill fields_draw(screen, tag, props, x, y, width, under) {
    (tag == "input") { out input.draw_input(screen, x, y, width, props, under) }
    (tag == "textarea") { out textarea.draw_textarea(screen, x, y, width, props, under) }
    (tag == "select") { out select.draw_select(screen, x, y, width, props, under) }
    (tag == "input-otp") { out otp.draw_code(screen, x, y, props, under) }
    (tag == "combobox") { out combobox.draw_combobox(screen, x, y, props, under) }
    @face = fonts.MEDIUM
    fonts.draw_text(screen, x, y, jtml.prop_words(props, "text", ""), canvas.ZINC_900, face)
    out face.line
}
