-- tooltip — подсказка: тёмная пилюля с text шрифтом SMALL.
--
-- tooltip_width(props) -> ширина
-- draw_tooltip(screen, x, y, props, under) -> HEIGHT (26)

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml

HEIGHT = 26
PADDING = 10
RADIUS = 6

skill tooltip_width(props) {
    out fonts.measure(jtml.prop_words(props, "text", ""), fonts.SMALL) + 2 * PADDING
}

skill draw_tooltip(screen, x, y, props, under) {
    shapes.rounded(screen, x, y, tooltip_width(props), HEIGHT, RADIUS, canvas.ZINC_900, under)
    @face = fonts.SMALL
    fonts.draw_text(screen, x + PADDING, y + (HEIGHT - face.line) / 2, jtml.prop_words(props, "text", ""), canvas.PAPER, face)
    out HEIGHT
}
