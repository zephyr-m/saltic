-- menu — выпадающее меню и menubar. Пункт: text, icon, shortcut, label (заголовок), separator; value — подсвеченный номер.
--
-- item_height(item) / items_height(items) / menu_height(props) -> пиксели
-- draw_item(screen, x, y, width, item, lit) -> высота пункта
-- draw_items(screen, x, y, width, items, lit) -> высота всех (берёт и command)
-- draw_menu(screen, x, y, width, props, under) -> высота
-- bar_width(props) -> ширина / draw_bar(screen, x, y, props, under) -> BAR (36)

use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

ITEM = 32
INSET = 4
PADDING = 8
RADIUS = 8
WIDTH = 220
BAR = 36

skill item_height(item) {
    (jtml.prop_truth(item, "separator") == yes) { out 9 }
    out ITEM
}

skill items_height(items) {
    @height = 0
    drum (items) { height = height + item_height(beat) }
    out height
}

skill menu_height(props) {
    @found = jtml.prop(props, "items")
    out items_height(found.items) + 2 * INSET
}

skill draw_item(screen, x, y, width, item, lit) {
    (jtml.prop_truth(item, "separator") == yes) {
        shapes.hairline(screen, x - INSET, y + 4, width + 2 * INSET, canvas.ZINC_200)
        out 9
    }
    (lit == yes) { shapes.rounded(screen, x, y, width, ITEM, 4, canvas.ZINC_100, canvas.WHITE) }
    @face = fonts.REGULAR
    @ink = canvas.ZINC_900
    (jtml.prop_truth(item, "label") == yes) {
        face = fonts.MEDIUM
        ink = canvas.ZINC_500
    }
    @pen = x + PADDING
    @symbol = jtml.prop_words(item, "icon", "")
    ((symbol == "") == no) {
        icons.draw_icon(screen, pen, y + (ITEM - icons.SIZE) / 2, symbol, canvas.ZINC_500)
        pen = pen + icons.SIZE + PADDING
    }
    fonts.draw_text(screen, pen, y + (ITEM - face.line) / 2, jtml.prop_words(item, "text", ""), ink, face)
    @keys = jtml.prop_words(item, "shortcut", "")
    @small = fonts.SMALL
    ((keys == "") == no) { fonts.draw_text(screen, x + width - PADDING - fonts.measure(keys, small), y + (ITEM - small.line) / 2, keys, canvas.ZINC_500, small) }
    out ITEM
}

skill draw_items(screen, x, y, width, items, lit) {
    @top = y
    drum (group.count(items)) { top = top + draw_item(screen, x, top, width, group.get(items, beat), beat == lit) }
    out top - y
}

skill draw_menu(screen, x, y, width, props, under) {
    @found = jtml.prop(props, "items")
    @height = menu_height(props)
    shapes.shadow(screen, x, y, width, height, RADIUS, under, 6)
    shapes.framed_box(screen, x, y, width, height, RADIUS, canvas.variant_look("outline"), under)
    draw_items(screen, x + INSET, y + INSET, width - 2 * INSET, found.items, jtml.prop_amount(props, "value", -1))
    out height
}

skill bar_width(props) {
    @found = jtml.prop(props, "items")
    @width = 2 * INSET
    drum (found.items) { width = width + fonts.measure(beat.words, fonts.MEDIUM) + 2 * 12 }
    out width
}

skill draw_bar(screen, x, y, props, under) {
    shapes.framed_box(screen, x, y, bar_width(props), BAR, RADIUS, canvas.variant_look("outline"), under)
    @found = jtml.prop(props, "items")
    @lit = jtml.prop_amount(props, "value", -1)
    @face = fonts.MEDIUM
    @pen = x + INSET
    drum (group.count(found.items)) {
        @label = group.get(found.items, beat)
        @wide = fonts.measure(label.words, face) + 2 * 12
        (beat == lit) { shapes.rounded(screen, pen, y + INSET, wide, BAR - 2 * INSET, 4, canvas.ZINC_100, canvas.WHITE) }
        fonts.draw_text(screen, pen + 12, y + (BAR - face.line) / 2, label.words, canvas.ZINC_900, face)
        pen = pen + wide
    }
    out BAR
}
