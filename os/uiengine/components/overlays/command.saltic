use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons
use os.uiengine.components.overlays.menu

SEARCH = 44
HEADING = 28
RADIUS = 8
INSET = 4

skill command_height(props) {
    @found = jtml.prop(props, "groups")
    @height = SEARCH + 2 * INSET
    drum (found.items) {
        @entries = jtml.prop(beat, "items")
        height = height + HEADING + menu.items_height(entries.items)
    }
    out height
}

skill draw_command(screen, x, y, width, props, under) {
    @height = command_height(props)
    shapes.shadow(screen, x, y, width, height, RADIUS, under, 6)
    shapes.framed_box(screen, x, y, width, height, RADIUS, canvas.variant_look("outline"), under)
    icons.draw_icon(screen, x + 12, y + (SEARCH - icons.SIZE) / 2, "search", canvas.ZINC_500)
    @face = fonts.REGULAR
    fonts.draw_text(screen, x + 12 + icons.SIZE + 8, y + (SEARCH - face.line) / 2, jtml.prop_words(props, "placeholder", ""), canvas.ZINC_500, face)
    shapes.hairline(screen, x + 1, y + SEARCH, width - 2, canvas.ZINC_200)
    @found = jtml.prop(props, "groups")
    @lit = jtml.prop_amount(props, "value", -1)
    @small = fonts.SMALL
    @top = y + SEARCH + INSET
    @seen = 0
    drum (found.items) {
        fonts.draw_text(screen, x + INSET + 8, top + (HEADING - small.line) / 2, jtml.prop_words(beat, "title", ""), canvas.ZINC_500, small)
        top = top + HEADING
        @entries = jtml.prop(beat, "items")
        top = top + menu.draw_items(screen, x + INSET, top, width - 2 * INSET, entries.items, lit - seen)
        seen = seen + group.count(entries.items)
    }
    out height
}
