use os.uiengine.canvas
use os.uiengine.jtml
use os.uiengine.components.data.calendar
use os.uiengine.components.data.chart
use os.uiengine.components.data.grid
use os.uiengine.components.data.carousel

skill data_own(tag) {
    (tag == "calendar") { out yes }
    (tag == "date-picker") { out yes }
    (tag == "chart") { out yes }
    (tag == "data-table") { out yes }
    out tag == "carousel"
}

skill data_stretch(tag) {
    out tag == "data-table"
}

skill data_size(tag, props) {
    (tag == "calendar") { out canvas.Size { width = calendar.WIDTH, height = calendar.HEIGHT } }
    (tag == "date-picker") { out canvas.Size { width = calendar.WIDTH, height = calendar.picker_height(props) } }
    (tag == "chart") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "md")), height = canvas.height_of(jtml.prop_words(props, "height", "md")) } }
    (tag == "data-table") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "xl")), height = grid.grid_height(props) } }
    out canvas.Size { width = carousel.carousel_width(props), height = carousel.SLIDE + 18 }
}

skill data_draw(screen, tag, props, x, y, width, under) {
    (tag == "calendar") { out calendar.draw_calendar(screen, x, y, props, under) }
    (tag == "date-picker") { out calendar.draw_picker(screen, x, y, props, under) }
    (tag == "chart") { out chart.draw_chart(screen, x, y, props, under) }
    (tag == "data-table") { out grid.draw_grid(screen, x, y, width, props, under) }
    out carousel.draw_carousel(screen, x, y, props, under)
}
