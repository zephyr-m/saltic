use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

HEIGHT = 28
PADDING = 10
RADIUS = 6

skill item_width(label) {
    out fonts.measure(label, fonts.MEDIUM) + 2 * PADDING
}

skill draw_item(screen, x, y, label, pressed, under) {
    @fill = under
    (pressed == yes) { fill = canvas.ZINC_100 }
    shapes.rounded(screen, x, y, item_width(label), HEIGHT, RADIUS, fill, under)
    @face = fonts.MEDIUM
    fonts.draw_text(screen, x + PADDING, y + (HEIGHT - face.line) / 2, label, canvas.ZINC_900, face)
    out item_width(label)
}

skill toggle_width(props) {
    out item_width(jtml.prop_words(props, "text", ""))
}

skill draw_toggle(screen, x, y, props, under) {
    draw_item(screen, x, y, jtml.prop_words(props, "text", ""), jtml.prop_truth(props, "on"), under)
    out HEIGHT
}

skill group_items(props) {
    @found = jtml.prop(props, "items")
    @labels = []
    drum (found.items) { labels = group.add(labels, beat.words) }
    out labels
}

skill group_width(props) {
    @width = 2
    drum (group_items(props)) { width = width + item_width(beat) }
    out width
}

skill draw_group(screen, x, y, props, under) {
    @chosen = jtml.prop_amount(props, "value", 0)
    @style = canvas.variant_look("outline")
    shapes.framed_box(screen, x, y, group_width(props), HEIGHT + 2, RADIUS, style, under)
    @pen = x + 1
    @labels = group_items(props)
    drum (group.count(labels)) {
        pen = pen + draw_item(screen, pen, y + 1, group.get(labels, beat), beat == chosen, canvas.WHITE)
    }
    out HEIGHT + 2
}
