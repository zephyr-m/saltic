-- button — кнопка: text, icon, variant (canvas.variant_look), disabled.
-- Высота 28; без текста — квадрат под иконку; ghost берёт фон родителя.
--
-- button_width(props) -> ширина
-- draw_button(screen, x, y, props, under) -> HEIGHT

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

HEIGHT = 28
RADIUS = 6
PADDING = 12
ICON_GAP = 6

skill button_width(props) {
    @label = jtml.prop_words(props, "text", "")
    @symbol = jtml.prop_words(props, "icon", "")
    (label == "") {
        ((symbol == "") == no) { out HEIGHT }
    }
    @width = fonts.measure(label, fonts.MEDIUM) + 2 * PADDING
    (symbol == "") { out width }
    out width + icons.SIZE + ICON_GAP
}

skill draw_button(screen, x, y, props, under) {
    @style = canvas.variant_look(jtml.prop_words(props, "variant", "default"))
    (jtml.prop_words(props, "variant", "default") == "ghost") { style = canvas.Look { fill = under, ink = style.ink } }
    (jtml.prop_truth(props, "disabled") == yes) { style = canvas.faded(style, under) }
    shapes.framed_box(screen, x, y, button_width(props), HEIGHT, RADIUS, style, under)
    @face = fonts.MEDIUM
    @label = jtml.prop_words(props, "text", "")
    @symbol = jtml.prop_words(props, "icon", "")
    @pen = x + PADDING
    ((symbol == "") == no) {
        (label == "") { pen = x + (HEIGHT - icons.SIZE) / 2 }
        icons.draw_icon(screen, pen, y + (HEIGHT - icons.SIZE) / 2, symbol, style.ink)
        pen = pen + icons.SIZE + ICON_GAP
    }
    fonts.draw_text(screen, pen, y + (HEIGHT - face.line) / 2, label, style.ink, face)
    out HEIGHT
}
