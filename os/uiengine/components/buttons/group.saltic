use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

HEIGHT = 28
PADDING = 12
RADIUS = 6

skill segment_width(item) {
    @label = jtml.prop_words(item, "text", "")
    (label == "") { out HEIGHT }
    @wide = fonts.measure(label, fonts.MEDIUM) + 2 * PADDING
    (jtml.prop_words(item, "icon", "") == "") { out wide }
    out wide + icons.SIZE + 6
}

skill bunch_width(props) {
    @found = jtml.prop(props, "items")
    @width = 0
    drum (found.items) { width = width + segment_width(beat) }
    out width
}

skill draw_bunch(screen, x, y, props, under) {
    @found = jtml.prop(props, "items")
    shapes.framed_box(screen, x, y, bunch_width(props), HEIGHT, RADIUS, canvas.variant_look("outline"), under)
    @face = fonts.MEDIUM
    @pen = x
    drum (group.count(found.items)) {
        @item = group.get(found.items, beat)
        (beat > 0) { graphics_divider(screen, pen, y) }
        @inner = pen + PADDING
        @label = jtml.prop_words(item, "text", "")
        @symbol = jtml.prop_words(item, "icon", "")
        ((symbol == "") == no) {
            (label == "") { inner = pen + (HEIGHT - icons.SIZE) / 2 }
            icons.draw_icon(screen, inner, y + (HEIGHT - icons.SIZE) / 2, symbol, canvas.ZINC_900)
            inner = inner + icons.SIZE + 6
        }
        fonts.draw_text(screen, inner, y + (HEIGHT - face.line) / 2, label, canvas.ZINC_900, face)
        pen = pen + segment_width(item)
    }
    out HEIGHT
}

skill graphics_divider(screen, x, y) {
    drum (HEIGHT) { shapes.hairline(screen, x, y + beat, 1, canvas.ZINC_200) }
    out none
}
