use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

HEIGHT = 32
WIDTH = 220
ITEM = 32
SEARCH = 36

skill combobox_height(props) {
    (jtml.prop_truth(props, "open") == no) { out HEIGHT }
    @found = jtml.prop(props, "items")
    out HEIGHT + 4 + SEARCH + group.count(found.items) * ITEM + 8
}

skill draw_combobox(screen, x, y, props, under) {
    @width = jtml.prop_amount(props, "width", WIDTH)
    shapes.framed_box(screen, x, y, width, HEIGHT, 6, canvas.variant_look("outline"), under)
    @face = fonts.REGULAR
    @value = jtml.prop_words(props, "value", "")
    @ink = canvas.ZINC_900
    @shown = value
    (value == "") {
        shown = jtml.prop_words(props, "placeholder", "Выберите…")
        ink = canvas.ZINC_500
    }
    fonts.draw_text(screen, x + 10, y + (HEIGHT - face.line) / 2, shown, ink, face)
    icons.draw_icon(screen, x + width - 10 - icons.SIZE, y + 8, "chevrons", canvas.ZINC_500)
    (jtml.prop_truth(props, "open") == no) { out HEIGHT }
    @top = y + HEIGHT + 4
    @found = jtml.prop(props, "items")
    @height = SEARCH + group.count(found.items) * ITEM + 8
    shapes.shadow(screen, x, top, width, height, 8, under, 6)
    shapes.framed_box(screen, x, top, width, height, 8, canvas.variant_look("outline"), under)
    icons.draw_icon(screen, x + 10, top + (SEARCH - icons.SIZE) / 2, "search", canvas.ZINC_500)
    fonts.draw_text(screen, x + 34, top + (SEARCH - face.line) / 2, jtml.prop_words(props, "search", "Поиск…"), canvas.ZINC_500, face)
    shapes.hairline(screen, x + 1, top + SEARCH, width - 2, canvas.ZINC_200)
    @row = top + SEARCH + 4
    drum (found.items) {
        (beat.words == value) {
            shapes.rounded(screen, x + 4, row, width - 8, ITEM, 4, canvas.ZINC_100, canvas.WHITE)
            icons.draw_icon(screen, x + width - 12 - icons.SIZE, row + 8, "check", canvas.ZINC_900)
        }
        fonts.draw_text(screen, x + 12, row + (ITEM - face.line) / 2, beat.words, canvas.ZINC_900, face)
        row = row + ITEM
    }
    out combobox_height(props)
}
