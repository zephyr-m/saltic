-- otp — input-otp: ячейки кода, length (по умолчанию 6), value — введённые цифры.
-- Ячейка после последней цифры обведена тёмной рамкой.
--
-- code_width(props) -> ширина всех ячеек
-- draw_code(screen, x, y, props, under) -> CELL (36)

use core.str
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml

CELL = 36
GAP = 6
RADIUS = 6
LENGTH = 6

skill code_width(props) {
    @length = jtml.prop_amount(props, "length", LENGTH)
    out length * CELL + (length - 1) * GAP
}

skill draw_code(screen, x, y, props, under) {
    @value = jtml.prop_words(props, "value", "")
    @face = fonts.MEDIUM
    drum (jtml.prop_amount(props, "length", LENGTH)) {
        @left = x + beat * (CELL + GAP)
        @style = canvas.variant_look("outline")
        (beat == str.bytes(value)) { style = canvas.Look { fill = canvas.WHITE, edge = canvas.ZINC_900, framed = yes } }
        shapes.framed_box(screen, left, y, CELL, CELL, RADIUS, style, under)
        (beat < str.bytes(value)) {
            @digit = str.slice(value, beat, beat + 1)
            fonts.draw_text(screen, left + (CELL - fonts.measure(digit, face)) / 2, y + (CELL - face.line) / 2, digit, canvas.ZINC_900, face)
        }
    }
    out CELL
}
