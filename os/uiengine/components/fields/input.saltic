use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

HEIGHT = 32
PADDING = 10
WIDTH = 240
RADIUS = 6

skill draw_input(screen, x, y, width, props, under) {
    @style = canvas.variant_look("outline")
    shapes.framed_box(screen, x, y, width, HEIGHT, RADIUS, style, under)
    @face = fonts.REGULAR
    @top = y + (HEIGHT - face.line) / 2
    @pen = x + PADDING
    @symbol = jtml.prop_words(props, "icon", "")
    ((symbol == "") == no) {
        icons.draw_icon(screen, pen, y + (HEIGHT - icons.SIZE) / 2, symbol, canvas.ZINC_500)
        pen = pen + icons.SIZE + 8
    }
    @value = jtml.prop_words(props, "value", "")
    pick {
        (value == "") { fonts.draw_text(screen, pen, top, jtml.prop_words(props, "placeholder", ""), canvas.ZINC_500, face) }
        { fonts.draw_text(screen, pen, top, value, canvas.ZINC_900, face) }
    }
    @action = jtml.prop_words(props, "action", "")
    (action == "") { out HEIGHT }
    @medium = fonts.MEDIUM
    @wide = fonts.measure(action, medium) + 16
    @left = x + width - 4 - wide
    shapes.rounded(screen, left, y + 4, wide, HEIGHT - 8, 4, canvas.ZINC_100, canvas.WHITE)
    fonts.draw_text(screen, left + 8, y + (HEIGHT - medium.line) / 2, action, canvas.ZINC_900, medium)
    out HEIGHT
}
