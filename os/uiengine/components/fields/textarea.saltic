-- textarea — многострочное поле: value (строки через \n), placeholder, rows (по умолчанию 3).
-- Показывает не больше rows строк.
--
-- textarea_height(props) -> высота по rows
-- draw_textarea(screen, x, y, width, props, under) -> высота

use core.str
use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml

PADDING = 10
RADIUS = 6
ROWS = 3

skill textarea_height(props) {
    @face = fonts.REGULAR
    out jtml.prop_amount(props, "rows", ROWS) * face.line + 2 * PADDING
}

skill draw_textarea(screen, x, y, width, props, under) {
    @height = textarea_height(props)
    shapes.framed_box(screen, x, y, width, height, RADIUS, canvas.variant_look("outline"), under)
    @face = fonts.REGULAR
    @value = jtml.prop_words(props, "value", "")
    @ink = canvas.ZINC_900
    (value == "") {
        value = jtml.prop_words(props, "placeholder", "")
        ink = canvas.ZINC_500
    }
    @lines = str.split(value, "\n")
    @shown = group.count(lines)
    (shown > jtml.prop_amount(props, "rows", ROWS)) { shown = jtml.prop_amount(props, "rows", ROWS) }
    drum (shown) { fonts.draw_text(screen, x + PADDING, y + PADDING + beat * face.line, group.get(lines, beat), ink, face) }
    out height
}
