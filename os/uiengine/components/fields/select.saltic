-- select — выпадающий список в закрытом виде: value или placeholder и chevron-down.
--
-- draw_select(screen, x, y, width, props, under) -> HEIGHT (32)

use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

HEIGHT = 32
PADDING = 10
WIDTH = 200
RADIUS = 6

skill draw_select(screen, x, y, width, props, under) {
    shapes.framed_box(screen, x, y, width, HEIGHT, RADIUS, canvas.variant_look("outline"), under)
    @face = fonts.REGULAR
    @value = jtml.prop_words(props, "value", "")
    @ink = canvas.ZINC_900
    (value == "") {
        value = jtml.prop_words(props, "placeholder", "")
        ink = canvas.ZINC_500
    }
    fonts.draw_text(screen, x + PADDING, y + (HEIGHT - face.line) / 2, value, ink, face)
    icons.draw_icon(screen, x + width - PADDING - icons.SIZE, y + (HEIGHT - icons.SIZE) / 2, "chevron-down", canvas.ZINC_500)
    out HEIGHT
}
