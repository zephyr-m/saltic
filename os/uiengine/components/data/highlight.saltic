-- highlight — подсветка строки кода Saltic: ключевые слова, строки, числа, имя после skill, Типы с большой буквы.
-- Цвета — свои Rgb (KEYWORD, STRING, NUMBER, NAME, TYPE); знаки — ZINC_500.
--
-- is_word_start / is_word_part(ch) -> yes/no
-- string_end(line, at) / run_end(line, at, words) -> позиция конца лексемы
-- word_color(word, previous) -> canvas.Rgb
-- draw_line(screen, x, y, line) — нарисовать строку шрифтом MONO

use core.str
use core.group
use os.uiengine.canvas
use os.uiengine.fonts

KEYWORDS = ["skill", "program", "use", "Box", "out", "enum", "drum", "rescue", "yes", "no", "none", "leave", "pick", "native", "always", "beat"]
KEYWORD = canvas.Rgb { red = 207, green = 34, blue = 46 }
STRING = canvas.Rgb { red = 10, green = 48, blue = 105 }
NUMBER = canvas.Rgb { red = 5, green = 80, blue = 174 }
NAME = canvas.Rgb { red = 130, green = 80, blue = 223 }
TYPE = canvas.Rgb { red = 149, green = 56, blue = 0 }
QUOTE = "\""
SLASH = "\\"

skill is_word_start(ch) {
    (ch == "_") { out yes }
    @code = str.byte(ch, 0)
    (code > 64) {
        (code < 91) { out yes }
    }
    (code > 96) {
        (code < 123) { out yes }
    }
    out no
}

skill is_word_part(ch) {
    (str.is_digit(ch) == yes) { out yes }
    out is_word_start(ch)
}

skill string_end(line, at) {
    @index = at + 1
    drum (str.bytes(line) - at) {
        (index >= str.bytes(line)) { out str.bytes(line) }
        @ch = str.get(line, index)
        (ch == QUOTE) { out index + 1 }
        (ch == SLASH) { index = index + 1 }
        index = index + 1
    }
    out str.bytes(line)
}

skill run_end(line, at, words) {
    @index = at + 1
    drum (str.bytes(line) - at) {
        (index >= str.bytes(line)) { out str.bytes(line) }
        @ch = str.get(line, index)
        (words == yes) {
            (is_word_part(ch) == no) { out index }
        }
        (words == no) {
            (str.is_digit(ch) == no) { out index }
        }
        index = index + 1
    }
    out str.bytes(line)
}

skill word_color(word, previous) {
    (group.contains(KEYWORDS, word) == yes) { out KEYWORD }
    (previous == "skill") { out NAME }
    @code = str.byte(word, 0)
    (code > 64) {
        (code < 91) { out TYPE }
    }
    out canvas.ZINC_900
}

skill draw_line(screen, x, y, line) {
    @face = fonts.MONO
    @pen = x
    @index = 0
    @previous = ""
    drum (str.bytes(line)) {
        (index < str.bytes(line)) {
            @ch = str.get(line, index)
            @end = index + 1
            @color = canvas.ZINC_900
            @spoken = no
            pick {
                (ch == QUOTE) {
                    end = string_end(line, index)
                    color = STRING
                }
                (str.is_digit(ch) == yes) {
                    end = run_end(line, index, no)
                    color = NUMBER
                }
                (is_word_start(ch) == yes) {
                    end = run_end(line, index, yes)
                    spoken = yes
                }
                { color = canvas.ZINC_500 }
            }
            @token = str.slice(line, index, end)
            (spoken == yes) {
                color = word_color(token, previous)
                previous = token
            }
            (ch == " ") { color = canvas.ZINC_900 }
            pen = fonts.draw_text(screen, pen, y, token, color, face)
            index = end
        }
    }
    out none
}
