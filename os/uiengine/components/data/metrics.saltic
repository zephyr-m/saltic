use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.components.data.chart

SPARK_HEIGHT = 40
STAT_HEIGHT = 120

skill draw_spark(screen, x, y, width, height, values, under) {
    @count = group.count(values)
    (count < 2) { out height }
    @top = chart.peak(values)
    @low = top
    drum (values) {
        (beat < low) { low = beat }
    }
    @span = top - low
    (span < 1) { span = 1 }
    @previous_x = x
    @previous_y = y + height - 2 - (group.get(values, 0) - low) * (height - 4) / span
    drum (count - 1) {
        @next_x = x + (beat + 1) * (width - 1) / (count - 1)
        @next_y = y + height - 2 - (group.get(values, beat + 1) - low) * (height - 4) / span
        shapes.stroke(screen, previous_x, previous_y, next_x, next_y, 2, chart.TEAL, under)
        previous_x = next_x
        previous_y = next_y
    }
    out height
}

skill draw_sparkline(screen, x, y, width, props, under) {
    out draw_spark(screen, x, y, width, SPARK_HEIGHT, chart.amounts(props, "values"), under)
}

skill draw_stat(screen, x, y, width, props, under) {
    @small = fonts.REGULAR
    @big = fonts.HEADING
    fonts.draw_text(screen, x, y, jtml.prop_words(props, "label", ""), canvas.ZINC_500, small)
    @value_y = y + small.line + 4
    @after = fonts.draw_text(screen, x, value_y, jtml.prop_words(props, "value", ""), canvas.ZINC_900, big)
    @delta = jtml.prop_words(props, "delta", "")
    ((delta == "") == no) { fonts.draw_text(screen, after + 8, value_y + big.line - small.line, delta, canvas.ZINC_500, small) }
    draw_spark(screen, x, value_y + big.line + 8, width, STAT_HEIGHT - small.line - big.line - 20, chart.amounts(props, "values"), under)
    out STAT_HEIGHT
}
