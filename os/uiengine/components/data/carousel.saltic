-- carousel — карусель: items — тексты слайдов, value — текущий; стрелки по бокам, точки снизу.
--
-- carousel_width(props) -> ширина со стрелками
-- draw_carousel(screen, x, y, props, under) -> SLIDE + 18

use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

SLIDE = 220
ARROW = 32
GAP = 12

skill carousel_width(props) {
    out SLIDE + 2 * (ARROW + GAP)
}

skill draw_carousel(screen, x, y, props, under) {
    @found = jtml.prop(props, "items")
    @current = jtml.prop_amount(props, "value", 0)
    @slide_x = x + ARROW + GAP
    shapes.shadow(screen, slide_x, y, SLIDE, SLIDE, 12, under, 2)
    shapes.framed_box(screen, slide_x, y, SLIDE, SLIDE, 12, canvas.variant_look("outline"), under)
    @face = fonts.HEADING
    @label = group.get(found.items, current)
    fonts.draw_text(screen, slide_x + (SLIDE - fonts.measure(label.words, face)) / 2, y + (SLIDE - face.line) / 2, label.words, canvas.ZINC_900, face)
    @middle = y + (SLIDE - ARROW) / 2
    shapes.framed_box(screen, x, middle, ARROW, ARROW, ARROW / 2, canvas.variant_look("outline"), under)
    icons.draw_icon(screen, x + 8, middle + 8, "chevron-left", canvas.ZINC_900)
    @right = slide_x + SLIDE + GAP
    shapes.framed_box(screen, right, middle, ARROW, ARROW, ARROW / 2, canvas.variant_look("outline"), under)
    icons.draw_icon(screen, right + 8, middle + 8, "chevron-right", canvas.ZINC_900)
    @count = group.count(found.items)
    @dots_x = slide_x + (SLIDE - count * 12) / 2
    drum (count) {
        @color = canvas.ZINC_200
        (beat == current) { color = canvas.ZINC_900 }
        shapes.rounded(screen, dots_x + beat * 12 + 2, y + SLIDE + 10, 8, 8, 4, color, under)
    }
    out SLIDE + 18
}
