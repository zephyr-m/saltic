-- grid — data-table: панель фильтра и «Колонки», таблица с флажками по columns и rows,
-- selected — номера строк, sort — номер колонки; внизу «Выбрано N из M» и кнопки.
--
-- Pen { face, ink, under } — как рисовать строку
-- grid_height(props) -> высота
-- is_selected(props, index) -> yes/no
-- draw_box(screen, x, y, on, under) — флажок
-- draw_line(screen, x, y, width, cells, pen, on) -> ширина колонки
-- draw_grid(screen, x, y, width, props, under) -> высота

use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

ROW = 40
TOOLBAR = 32
GAP = 12
CHECK = 40
BOX = 16

Pen = Box {
    face = fonts.REGULAR,
    ink = canvas.ZINC_900,
    under = canvas.WHITE
}

skill grid_height(props) {
    @body = jtml.prop(props, "rows")
    out TOOLBAR + GAP + ROW * (group.count(body.items) + 1) + GAP + 32
}

skill is_selected(props, index) {
    @found = jtml.prop(props, "selected")
    drum (found.items) {
        (beat.amount == index) { out yes }
    }
    out no
}

skill draw_box(screen, x, y, on, under) {
    pick {
        (on == yes) {
            shapes.rounded(screen, x, y, BOX, BOX, 4, canvas.ZINC_900, under)
            icons.draw_small_icon(screen, x + 2, y + 2, "check", canvas.PAPER)
        }
        { shapes.framed_box(screen, x, y, BOX, BOX, 4, canvas.Look { fill = under, edge = canvas.ZINC_900, framed = yes }, under) }
    }
    out none
}

skill draw_line(screen, x, y, width, cells, pen, on) {
    @face = pen.face
    draw_box(screen, x + (CHECK - BOX) / 2, y + (ROW - BOX) / 2, on, pen.under)
    @column = (width - CHECK) / group.count(cells)
    drum (group.count(cells)) {
        @cell = group.get(cells, beat)
        fonts.draw_text(screen, x + CHECK + beat * column + 8, y + (ROW - face.line) / 2, cell.words, pen.ink, face)
    }
    out column
}

skill draw_grid(screen, x, y, width, props, under) {
    shapes.framed_box(screen, x, y, 240, TOOLBAR, 6, canvas.variant_look("outline"), under)
    @face = fonts.REGULAR
    @medium = fonts.MEDIUM
    fonts.draw_text(screen, x + 10, y + (TOOLBAR - face.line) / 2, jtml.prop_words(props, "placeholder", "Фильтр…"), canvas.ZINC_500, face)
    @columns_label = "Колонки"
    @wide = fonts.measure(columns_label, medium) + 24 + icons.SIZE + 6
    shapes.framed_box(screen, x + width - wide, y, wide, TOOLBAR, 6, canvas.variant_look("outline"), under)
    fonts.draw_text(screen, x + width - wide + 12, y + (TOOLBAR - medium.line) / 2, columns_label, canvas.ZINC_900, medium)
    icons.draw_icon(screen, x + width - 12 - icons.SIZE, y + (TOOLBAR - icons.SIZE) / 2, "chevron-down", canvas.ZINC_900)
    @body = jtml.prop(props, "rows")
    @top = y + TOOLBAR + GAP
    @table_height = ROW * (group.count(body.items) + 1)
    shapes.framed_box(screen, x, top, width, table_height, 8, canvas.variant_look("outline"), under)
    @head = jtml.prop(props, "columns")
    @column = draw_line(screen, x, top, width, head.items, Pen { face = medium, ink = canvas.ZINC_500 }, no)
    @sorted = jtml.prop_amount(props, "sort", -1)
    (sorted > -1) {
        @name = group.get(head.items, sorted)
        icons.draw_small_icon(screen, x + CHECK + sorted * column + 8 + fonts.measure(name.words, medium) + 6, top + (ROW - icons.SMALL) / 2, "chevrons", canvas.ZINC_500)
    }
    @chosen = 0
    drum (group.count(body.items)) {
        @line_top = top + ROW * (beat + 1)
        shapes.hairline(screen, x + 1, line_top, width - 2, canvas.ZINC_200)
        @on = is_selected(props, beat)
        @row_under = canvas.WHITE
        (on == yes) {
            row_under = canvas.ZINC_100
            chosen = chosen + 1
            shapes.rounded(screen, x + 1, line_top + 1, width - 2, ROW - 2, 1, row_under, canvas.WHITE)
        }
        @cells = group.get(body.items, beat)
        draw_line(screen, x, line_top, width, cells.items, Pen { face = face, under = row_under }, on)
    }
    @total = group.count(body.items)
    @bottom = top + table_height + GAP
    fonts.draw_text(screen, x, bottom + (32 - face.line) / 2, "Выбрано {chosen} из {total}", canvas.ZINC_500, face)
    @next_label = "Далее"
    @back_label = "Назад"
    @next_wide = fonts.measure(next_label, medium) + 24
    @back_wide = fonts.measure(back_label, medium) + 24
    shapes.framed_box(screen, x + width - next_wide, bottom, next_wide, 32, 6, canvas.variant_look("outline"), under)
    fonts.draw_text(screen, x + width - next_wide + 12, bottom + (32 - medium.line) / 2, next_label, canvas.ZINC_900, medium)
    @back_x = x + width - next_wide - 8 - back_wide
    shapes.framed_box(screen, back_x, bottom, back_wide, 32, 6, canvas.faded(canvas.variant_look("outline"), under), under)
    fonts.draw_text(screen, back_x + 12, bottom + (32 - medium.line) / 2, back_label, canvas.ZINC_500, medium)
    out grid_height(props)
}
