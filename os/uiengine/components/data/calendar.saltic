-- calendar — месяц: year, month, value (выбранный день), from/to (отрезок), today; date-picker — поле с open.
-- Неделя с понедельника; названия месяцев и дней — по-русски.
--
-- weekday(year, month, day) -> 0 (Пн) … 6 (Вс) / month_length(year, month) -> дней
-- draw_day(screen, x, y, day, props) / draw_month(screen, x, y, props) — ячейки и шапка месяца
-- draw_calendar(screen, x, y, props, under) -> HEIGHT (300)
-- picker_height(props) -> высота / draw_picker(screen, x, y, props, under) -> высота

use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons

CELL = 32
PADDING = 12
HEAD = 32
WEEK = 24
WIDTH = 248
HEIGHT = 300
SHIFTS = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
LENGTHS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
MONTHS = ["Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"]
DAYS = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]

skill weekday(year, month, day) {
    @y = year
    (month < 3) { y = y - 1 }
    @sunday_first = (y + y / 4 - y / 100 + y / 400 + group.get(SHIFTS, month - 1) + day) % 7
    out (sunday_first + 6) % 7
}

skill month_length(year, month) {
    (month == 2) {
        (year % 400 == 0) { out 29 }
        (year % 100 == 0) { out 28 }
        (year % 4 == 0) { out 29 }
    }
    out group.get(LENGTHS, month - 1)
}

skill draw_day(screen, x, y, day, props) {
    @value = jtml.prop_amount(props, "value", 0)
    @from = jtml.prop_amount(props, "from", 0)
    @to = jtml.prop_amount(props, "to", 0)
    @ink = canvas.ZINC_900
    @inside = no
    (day > from) {
        (day < to) { inside = yes }
    }
    (inside == yes) { shapes.rounded(screen, x, y, CELL, CELL, 6, canvas.ZINC_100, canvas.WHITE) }
    @chosen = day == value
    (day == from) { chosen = yes }
    (day == to) { chosen = yes }
    (chosen == yes) {
        shapes.rounded(screen, x, y, CELL, CELL, 6, canvas.ZINC_900, canvas.WHITE)
        ink = canvas.PAPER
    }
    (jtml.prop_amount(props, "today", 0) == day) {
        (chosen == no) { shapes.rounded(screen, x, y, CELL, CELL, 6, canvas.ZINC_100, canvas.WHITE) }
    }
    @face = fonts.REGULAR
    @digits = "{day}"
    fonts.draw_text(screen, x + (CELL - fonts.measure(digits, face)) / 2, y + (CELL - face.line) / 2, digits, ink, face)
    out none
}

skill draw_month(screen, x, y, props) {
    @year = jtml.prop_amount(props, "year", 2026)
    @month = jtml.prop_amount(props, "month", 1)
    @medium = fonts.MEDIUM
    @title = group.get(MONTHS, month - 1)
    @caption = "{title} {year}"
    fonts.draw_text(screen, x + (7 * CELL - fonts.measure(caption, medium)) / 2, y + (HEAD - medium.line) / 2, caption, canvas.ZINC_900, medium)
    shapes.framed_box(screen, x, y + 2, 28, 28, 6, canvas.variant_look("outline"), canvas.WHITE)
    icons.draw_icon(screen, x + 6, y + 8, "chevron-left", canvas.ZINC_900)
    shapes.framed_box(screen, x + 7 * CELL - 28, y + 2, 28, 28, 6, canvas.variant_look("outline"), canvas.WHITE)
    icons.draw_icon(screen, x + 7 * CELL - 22, y + 8, "chevron-right", canvas.ZINC_900)
    @small = fonts.SMALL
    drum (7) {
        @name = group.get(DAYS, beat)
        fonts.draw_text(screen, x + beat * CELL + (CELL - fonts.measure(name, small)) / 2, y + HEAD + 8, name, canvas.ZINC_500, small)
    }
    @first = weekday(year, month, 1)
    @top = y + HEAD + WEEK + 8
    drum (month_length(year, month)) {
        @slot = first + beat
        draw_day(screen, x + slot % 7 * CELL, top + slot / 7 * CELL, beat + 1, props)
    }
    out none
}

skill draw_calendar(screen, x, y, props, under) {
    shapes.framed_box(screen, x, y, WIDTH, HEIGHT, 8, canvas.variant_look("outline"), under)
    draw_month(screen, x + PADDING, y + PADDING, props)
    out HEIGHT
}

skill picker_height(props) {
    (jtml.prop_truth(props, "open") == no) { out 32 }
    out 40 + HEIGHT
}

skill draw_picker(screen, x, y, props, under) {
    shapes.framed_box(screen, x, y, 240, 32, 6, canvas.variant_look("outline"), under)
    icons.draw_icon(screen, x + 10, y + 8, "calendar", canvas.ZINC_500)
    @face = fonts.REGULAR
    @value = jtml.prop_words(props, "text", "")
    @ink = canvas.ZINC_900
    (value == "") {
        value = jtml.prop_words(props, "placeholder", "Выберите дату")
        ink = canvas.ZINC_500
    }
    fonts.draw_text(screen, x + 34, y + (32 - face.line) / 2, value, ink, face)
    (jtml.prop_truth(props, "open") == no) { out 32 }
    shapes.shadow(screen, x, y + 40, WIDTH, HEIGHT, 8, under, 6)
    draw_calendar(screen, x, y + 40, props, under)
    out 40 + HEIGHT
}
