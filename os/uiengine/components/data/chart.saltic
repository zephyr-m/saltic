-- chart — график: kind bar / line / area, values — числа, labels — подписи; сетка из LINES линий.
-- Размер по токенам width и height; масштаб по максимуму values. ORANGE — столбцы, TEAL — линии.
--
-- amounts(props, name) -> группа чисел из свойства (берёт и metrics)
-- peak(values) -> максимум, не меньше 1
-- draw_chart(screen, x, y, props, under) -> высота
-- fill_area(screen, x, y, slot, plot, values, top, under) — заливка под линией

use core.group
use os.target.uefi_x86_64.screen.graphics
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml

WIDTH = 360
HEIGHT = 200
LINES = 4
ORANGE = canvas.Rgb { red = 231, green = 110, blue = 80 }
TEAL = canvas.Rgb { red = 42, green = 157, blue = 144 }

skill amounts(props, name) {
    @found = jtml.prop(props, name)
    @values = []
    drum (found.items) { values = group.add(values, beat.amount) }
    out values
}

skill peak(values) {
    @top = 1
    drum (values) {
        (beat > top) { top = beat }
    }
    out top
}

skill draw_chart(screen, x, y, props, under) {
    @width = canvas.width_of(jtml.prop_words(props, "width", "md"))
    @height = canvas.height_of(jtml.prop_words(props, "height", "md"))
    @small = fonts.SMALL
    @plot = height - small.line - 8
    drum (LINES + 1) { shapes.hairline(screen, x, y + beat * plot / LINES, width, canvas.ZINC_200) }
    @values = amounts(props, "values")
    @count = group.count(values)
    @slot = width / count
    @top = peak(values)
    @kind = jtml.prop_words(props, "kind", "bar")
    @labels = jtml.prop(props, "labels")
    drum (count) {
        @label = group.get(labels.items, beat)
        fonts.draw_text(screen, x + beat * slot + (slot - fonts.measure(label.words, small)) / 2, y + plot + 8, label.words, canvas.ZINC_500, small)
    }
    (kind == "bar") {
        drum (count) {
            @tall = group.get(values, beat) * plot / top
            shapes.rounded(screen, x + beat * slot + slot / 5, y + plot - tall, slot * 3 / 5, tall, 4, ORANGE, under)
        }
        out height
    }
    @previous_x = x + slot / 2
    @previous_y = y + plot - group.get(values, 0) * plot / top
    (kind == "area") { fill_area(screen, x, y, slot, plot, values, top, under) }
    drum (count - 1) {
        @next_x = x + (beat + 1) * slot + slot / 2
        @next_y = y + plot - group.get(values, beat + 1) * plot / top
        shapes.stroke(screen, previous_x, previous_y, next_x, next_y, 2, TEAL, under)
        previous_x = next_x
        previous_y = next_y
    }
    out height
}

skill fill_area(screen, x, y, slot, plot, values, top, under) {
    @shade = canvas.paint(screen, canvas.mix(under, TEAL, 3, 10))
    drum (group.count(values) - 1) {
        @from_x = x + beat * slot + slot / 2
        @from_y = y + plot - group.get(values, beat) * plot / top
        @to_y = y + plot - group.get(values, beat + 1) * plot / top
        drum (slot) {
            @column_top = from_y + (to_y - from_y) * beat / slot
            (y + plot > column_top) { graphics.fill(screen, from_x + beat, column_top, 1, y + plot - column_top, shade) }
        }
    }
    out none
}
