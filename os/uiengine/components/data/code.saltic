use core.str
use core.group
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.fonts
use os.uiengine.jtml
use os.uiengine.icons
use os.uiengine.components.data.highlight

PADDING = 12
HEADER = 36
RADIUS = 8
GUTTER = 3

skill code_lines(props) {
    @text = jtml.prop_words(props, "text", "")
    @lines = []
    @from = 0
    drum (str.len(text)) {
        (str.get(text, beat) == "\n") {
            lines = group.add(lines, str.slice(text, from, beat))
            from = beat + 1
        }
    }
    out group.add(lines, str.slice(text, from, str.len(text)))
}

skill code_height(props) {
    @face = fonts.MONO
    @height = group.count(code_lines(props)) * face.line + 2 * PADDING
    (jtml.prop_words(props, "title", "") == "") { out height }
    out height + HEADER
}

skill draw_code(screen, x, y, width, props, under) {
    @height = code_height(props)
    shapes.framed_box(screen, x, y, width, height, RADIUS, canvas.Look { fill = canvas.PAPER, edge = canvas.ZINC_200, framed = yes }, under)
    @top = y + PADDING
    @title = jtml.prop_words(props, "title", "")
    ((title == "") == no) {
        @medium = fonts.MEDIUM
        icons.draw_icon(screen, x + PADDING, y + (HEADER - icons.SIZE) / 2, "target", canvas.ZINC_500)
        fonts.draw_text(screen, x + PADDING + icons.SIZE + 8, y + (HEADER - medium.line) / 2, title, canvas.ZINC_900, medium)
        shapes.hairline(screen, x + 1, y + HEADER, width - 2, canvas.ZINC_200)
        top = y + HEADER + PADDING
    }
    @face = fonts.MONO
    @digit = fonts.measure("0", face)
    @gutter = x + PADDING + GUTTER * digit
    @first = jtml.prop_amount(props, "start", 1)
    @lit = jtml.prop_amount(props, "highlight", 0)
    @lines = code_lines(props)
    drum (group.count(lines)) {
        @number = first + beat
        @row = top + beat * face.line
        (number == lit) { shapes.rounded(screen, x + 1, row, width - 2, face.line, 1, canvas.ZINC_100, canvas.PAPER) }
        @label = "{number}"
        fonts.draw_text(screen, gutter - fonts.measure(label, face), row, label, canvas.ZINC_500, face)
        highlight.draw_line(screen, gutter + 2 * digit, row, group.get(lines, beat))
    }
    out height
}
