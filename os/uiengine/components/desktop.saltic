use core.group
use os.uiengine.canvas
use os.uiengine.jtml
use os.uiengine.components.desktop.wallpaper
use os.uiengine.components.desktop.tile
use os.uiengine.components.desktop.bar
use os.uiengine.components.desktop.glass
use os.uiengine.components.desktop.pointer
use os.uiengine.components.desktop.drop

VOICE_RIGHT = 24
VOICE_BOTTOM = 64
VOICE_REACH = 80
VOICE_GAP = 4
LISTEN = "нажми, чтобы слушать"
DEMO = "демо · нет микрофона"

skill apps_of(props, name) {
    @found = jtml.prop(props, name)
    @apps = []
    drum (found.items) { apps = group.add(apps, tile.App { name = jtml.prop_words(beat, "name", ""), icon = jtml.prop_words(beat, "icon", "dot"), tint = jtml.prop_words(beat, "tint", "sage"), open = jtml.prop_truth(beat, "open") }) }
    out apps
}

skill paint_desktop(screen, props) {
    wallpaper.paint_wallpaper(screen)
    bar.draw_bar(screen, props)
    tile.draw_apps(screen, apps_of(props, "apps"), 36, 60)
    tile.draw_dock(screen, apps_of(props, "dock"))
    @voice = jtml.prop_words(props, "voice", "")
    ((voice == "") == no) { glass.draw_voice(screen, voice, voice_left(screen) + drop.DROP_SIDE / 2, voice_label_top(screen)) }
    out none
}

skill desktop_frame(tag) {
    out tag == "glass"
}

skill glass_header() {
    out glass.TITLE
}

skill glass_padding() {
    out glass.PADDING
}

skill draw_glass(screen, x, y, width, height, title) {
    out glass.draw_window(screen, x, y, width, height, title)
}

skill repaint_bar(screen, props) {
    drum (bar.HEIGHT) { wallpaper.paint_row(screen, beat) }
    out bar.draw_bar(screen, props)
}

skill voice_left(screen) {
    out screen.width - drop.DROP_SIDE - VOICE_RIGHT
}

skill voice_top(screen) {
    out screen.height - drop.DROP_SIDE - VOICE_BOTTOM
}

skill voice_label_top(screen) {
    out voice_top(screen) + drop.DROP_SIDE + VOICE_GAP
}

skill new_voice() {
    out drop.new_drop()
}

skill voice_frame(screen, voice) {
    drop.drop_step(voice)
    out drop.draw_drop(screen, voice, voice_left(screen), voice_top(screen))
}

skill voice_hit(screen, x, y) {
    @dx = x - voice_left(screen) - drop.DROP_SIDE / 2
    @dy = y - voice_top(screen) - drop.DROP_SIDE / 2
    out dx * dx + dy * dy < VOICE_REACH * VOICE_REACH
}

skill toggle_voice(screen, voice) {
    drop.toggle_drop(voice)
    @label = LISTEN
    (voice.mode > 0) { label = DEMO }
    @middle = voice_left(screen) + drop.DROP_SIDE / 2
    @wide = 220
    @top = voice_label_top(screen)
    drum (24) { wallpaper.paint_span(screen, top + beat, middle - wide / 2, wide) }
    out glass.draw_voice(screen, label, middle, top)
}

skill hide_voice(screen, voice) {
    out drop.hide_drop(screen, voice)
}
