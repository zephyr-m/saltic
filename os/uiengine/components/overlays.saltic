-- overlays — группа всплывающих: tooltip, menu (dropdown и context), menubar, command.
--
-- overlays_own(tag) -> yes/no
-- overlays_size(tag, props) -> canvas.Size
-- overlays_draw(screen, tag, props, x, y, width, under) -> высота
--
-- Дети: tooltip, menu (и menubar), command.

use os.uiengine.canvas
use os.uiengine.jtml
use os.uiengine.components.overlays.tooltip
use os.uiengine.components.overlays.menu
use os.uiengine.components.overlays.command

skill overlays_own(tag) {
    (tag == "tooltip") { out yes }
    (tag == "menu") { out yes }
    (tag == "menubar") { out yes }
    out tag == "command"
}

skill overlays_size(tag, props) {
    (tag == "tooltip") { out canvas.Size { width = tooltip.tooltip_width(props), height = tooltip.HEIGHT } }
    (tag == "menu") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "sm")), height = menu.menu_height(props) } }
    (tag == "menubar") { out canvas.Size { width = menu.bar_width(props), height = menu.BAR } }
    out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "md")), height = command.command_height(props) }
}

skill overlays_draw(screen, tag, props, x, y, width, under) {
    (tag == "tooltip") { out tooltip.draw_tooltip(screen, x, y, props, under) }
    (tag == "menu") { out menu.draw_menu(screen, x, y, width, props, under) }
    (tag == "menubar") { out menu.draw_bar(screen, x, y, props, under) }
    out command.draw_command(screen, x, y, width, props, under)
}
