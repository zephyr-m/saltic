-- fonts — набор текста полутонами начертаниями Noto Sans из fonts/generated.
-- Face — таблицы начертания: advance в 1/16 пикселя, pixels — строки hex-уровней 0…f.
-- Текст — UTF-8: латиница, кириллица и EXTRA (тире, кавычки, стрелки…), прочее — «?».
-- Начертания: REGULAR, MEDIUM, SEMIBOLD (14 px), SMALL (12), HEADING (18), MONO (13).
--
-- Face { ascent, line, advance, left, top, width, height, pixels }
-- glyph_of(code) -> номер глифа по коду символа
-- bytes_of(words) -> группа байтов строки
-- measure(words, face) / measure_bytes(bytes, face) -> ширина в пикселях
-- draw_text(screen, x, y, words, ink, face) / draw_bytes(screen, x, y, bytes, ink, face) -> x после текста
-- draw_glyph(screen, x, y, glyph, ink, face) — один глиф
-- draw_square(screen, x, y, pixels, size, ink) — квадрат уровней (иконки)
-- draw_levels(screen, x, y, pixels, width, height, ink) — прямоугольник уровней, смешивает с фоном

use core.str
use core.num
use core.mem
use core.group
use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.screen.lettering
use os.uiengine.canvas
use os.uiengine.fonts.generated.regular14
use os.uiengine.fonts.generated.medium14
use os.uiengine.fonts.generated.semibold14
use os.uiengine.fonts.generated.regular12
use os.uiengine.fonts.generated.semibold18
use os.uiengine.fonts.generated.mono13
use core.usize
use core.address
use core.u32

QUESTION = 31
EXTRA = [8212, 8211, 171, 187, 215, 8230, 176, 8470, 8592, 8593, 8594, 8595, 8596, 183]
EXTRA_FIRST = 161
LEVELS = 15

Face = Box {
    ascent = 0,
    line = 0,
    advance = [],
    left = [],
    top = [],
    width = [],
    height = [],
    pixels = []
}

REGULAR = Face { ascent = regular14.ASCENT, line = regular14.LINE, advance = regular14.ADVANCE, left = regular14.LEFT, top = regular14.TOP, width = regular14.WIDTH, height = regular14.HEIGHT, pixels = regular14.PIXELS }
MEDIUM = Face { ascent = medium14.ASCENT, line = medium14.LINE, advance = medium14.ADVANCE, left = medium14.LEFT, top = medium14.TOP, width = medium14.WIDTH, height = medium14.HEIGHT, pixels = medium14.PIXELS }
SEMIBOLD = Face { ascent = semibold14.ASCENT, line = semibold14.LINE, advance = semibold14.ADVANCE, left = semibold14.LEFT, top = semibold14.TOP, width = semibold14.WIDTH, height = semibold14.HEIGHT, pixels = semibold14.PIXELS }
SMALL = Face { ascent = regular12.ASCENT, line = regular12.LINE, advance = regular12.ADVANCE, left = regular12.LEFT, top = regular12.TOP, width = regular12.WIDTH, height = regular12.HEIGHT, pixels = regular12.PIXELS }
MONO = Face { ascent = mono13.ASCENT, line = mono13.LINE, advance = mono13.ADVANCE, left = mono13.LEFT, top = mono13.TOP, width = mono13.WIDTH, height = mono13.HEIGHT, pixels = mono13.PIXELS }
HEADING = Face { ascent = semibold18.ASCENT, line = semibold18.LINE, advance = semibold18.ADVANCE, left = semibold18.LEFT, top = semibold18.TOP, width = semibold18.WIDTH, height = semibold18.HEIGHT, pixels = semibold18.PIXELS }

skill glyph_of(code) {
    (code > 31) {
        (code < 127) { out code - 32 }
    }
    (code > 1039) {
        (code < 1104) { out 95 + code - 1040 }
    }
    (code == 1025) { out 159 }
    (code == 1105) { out 160 }
    drum (group.count(EXTRA)) {
        (group.get(EXTRA, beat) == code) { out EXTRA_FIRST + beat }
    }
    out QUESTION
}

skill bytes_of(words) {
    @bytes = []
    drum (str.bytes(words)) { bytes = group.add(bytes, str.byte(words, beat)) }
    out bytes
}

skill measure(words, face) {
    out measure_bytes(bytes_of(words), face)
}

skill measure_bytes(bytes, face) {
    @pen = 0
    @index = 0
    drum (group.count(bytes)) {
        (index < group.count(bytes)) {
            @point = lettering.decode(bytes, index)
            pen = pen + group.get(face.advance, glyph_of(point.value))
            index = index + point.width
        }
    }
    out pen / 16
}

skill draw_glyph(screen, x, y, glyph, ink, face) {
    out draw_levels(screen, x, y, group.get(face.pixels, glyph), group.get(face.width, glyph), group.get(face.height, glyph), ink)
}

skill draw_square(screen, x, y, pixels, size, ink) {
    out draw_levels(screen, x, y, pixels, size, size, ink)
}

skill draw_levels(screen, x, y, pixels, width, height, ink) {
    @solid = canvas.paint(screen, ink)
    drum (height) {
        @row = beat
        @start = ((y + row) * screen.stride + x) * graphics.PIXEL_BYTES
        drum (width) {
            @level = num.hex_value(str.get(pixels, row * width + beat))
            @at = start + beat * graphics.PIXEL_BYTES
            (level == LEVELS) { mem.store32(address.from(screen.memory), usize.from(at), u32.from(solid)) }
            (level > 0) {
                (level < LEVELS) {
                    @under = canvas.unpack(screen, num.from(mem.load32(address.from(screen.memory), usize.from(at))))
                    mem.store32(address.from(screen.memory), usize.from(at), u32.from(canvas.paint(screen, canvas.mix(under, ink, level, LEVELS))))
                }
            }
        }
    }
    out none
}

skill draw_text(screen, x, y, words, ink, face) {
    out draw_bytes(screen, x, y, bytes_of(words), ink, face)
}

skill draw_bytes(screen, x, y, bytes, ink, face) {
    @pen = x * 16
    @index = 0
    drum (group.count(bytes)) {
        (index < group.count(bytes)) {
            @point = lettering.decode(bytes, index)
            @glyph = glyph_of(point.value)
            draw_glyph(screen, (pen + 8) / 16 + group.get(face.left, glyph), y + face.ascent + group.get(face.top, glyph), glyph, ink, face)
            pen = pen + group.get(face.advance, glyph)
            index = index + point.width
        }
    }
    out pen / 16
}
