use core.str
use core.num
use core.group
use os.target.uefi_x86_64.firmware
use os.target.uefi_x86_64.pci

SAMPLES = 8
TURNS = 10000000
HPET_LOW = 20552
HPET_HIGH = 21573
TABS = "[\"Кнопки\", \"Поля\", \"Выбор\", \"Показ\", \"Навигация\", \"Данные\", \"Меню\", \"Диалог\", \"Шторка\", \"Ящик\", \"Код\", \"Редактор\", \"Железо\", \"Пульт\"]"

skill find_hpet(base) {
    @xsdt = firmware.pointer(firmware.find_rsdp(base), base, 24)
    drum ((firmware.read16(xsdt, base, 4) - 36) / 8) {
        @table = firmware.pointer(xsdt, base, 36 + beat * 8)
        (firmware.read16(table, base, 0) == HPET_LOW) {
            (firmware.read16(table, base, 2) == HPET_HIGH) { out table }
        }
    }
    out error.NoHpet
}

skill one_sample(hpet, base, kilohertz) {
    @before = firmware.read32(hpet, base, 240)
    @x = 0
    drum (TURNS) { x = beat }
    @after = firmware.read32(hpet, base, 240)
    @ticks = (after.hi - before.hi) * 65536 + after.lo - before.lo
    @micro = ticks * 10 / (kilohertz / 100)
    (micro < 1) { out 0 }
    out TURNS / micro
}

skill speeds(base) {
    @hpet = firmware.read32(find_hpet(base), base, 44)
    @period = firmware.read32(hpet, base, 4)
    @kilohertz = 100000000 / ((period.hi * 65536 + period.lo) / 10000)
    @found = []
    drum (SAMPLES) { found = group.add(found, one_sample(hpet, base, kilohertz)) }
    out found
}

skill quoted(words) {
    out str.add(str.add("\"", words), "\"")
}

skill numbers(values) {
    @parts = []
    drum (values) { parts = group.add(parts, "{beat}") }
    out str.add(str.add("[", str.join(parts, ", ")), "]")
}

skill device_row(line) {
    @cells = str.split(line, "  ")
    @parts = []
    drum (cells) { parts = group.add(parts, quoted(beat)) }
    drum (4 - group.count(cells)) { parts = group.add(parts, quoted("")) }
    out str.add(str.add("[", str.join(parts, ", ")), "]")
}

skill count_class(lines, word) {
    @count = 0
    drum (lines) {
        (str.contains(beat, word) == yes) { count = count + 1 }
    }
    out count
}

skill stat(label, value, delta, values) {
    out stat_sized(label, value, delta, values, "sm")
}

skill stat_sized(label, value, delta, values, width) {
    out "\{\"card\": \{\"children\": [\{\"stat\": \{\"width\": \"{width}\", \"label\": {label}, \"value\": {value}, \"delta\": {delta}, \"values\": {values}\}\}]\}\}"
}

skill page(position) {
    @base = firmware.guest_base()
    @lines = pci.device_lines(base, firmware.ecam(base))
    @measured = speeds(base)
    @last = group.get(measured, SAMPLES - 1)
    @total = group.count(lines)
    @bridges = count_class(lines, "bridge")
    @usb = count_class(lines, "USB")
    @rows = []
    drum (lines) { rows = group.add(rows, device_row(beat)) }
    @table_rows = str.join(rows, ", ")
    @speed = stat(quoted("Скорость цикла, млн оборотов/с"), quoted("{last}"), quoted("8 замеров по HPET"), numbers(measured))
    @devices = stat(quoted("Устройств PCI"), quoted("{total}"), quoted("мостов {bridges}, USB {usb}"), "[]")
    @position_text = "{position}"
    @head = "\{\"row\": \{\"children\": [\{\"heading\": \{\"text\": \"Saltic UIEngine\"\}\}, \{\"badge\": \{\"variant\": \"secondary\", \"text\": \"{position_text} / 14\"\}\}, \{\"muted\": \{\"text\": \"живые данные Acer, собраны программой при запуске\"\}\}]\}\}"
    @tabs = "\{\"tabs\": \{\"value\": 12, \"items\": {TABS}\}\}"
    @table = "\{\"card\": \{\"children\": [\{\"title\": \{\"text\": \"Устройства PCI\"\}\}, \{\"scroll\": \{\"height\": \"lg\", \"children\": [\{\"table\": \{\"columns\": [\"Адрес\", \"ID\", \"Класс\", \"Название\"], \"rows\": [{table_rows}]\}\}]\}\}]\}\}"
    out "\{\"column\": \{\"gap\": \"md\", \"children\": [{head}, {tabs}, \{\"row\": \{\"gap\": \"lg\", \"children\": [{speed}, {devices}]\}\}, {table}]\}\}"
}

skill uptime_minutes(base) {
    @hpet = firmware.read32(find_hpet(base), base, 44)
    @low = firmware.read32(hpet, base, 240)
    @high = firmware.read32(hpet, base, 244)
    @seconds = (high.hi * 65536 + high.lo) * 178 + low.hi / 366
    out seconds / 60
}

skill feed_item(icon, title, text) {
    out "\{\"item\": \{\"icon\": {icon}, \"title\": {title}, \"text\": {text}\}\}"
}

skill dashboard(position) {
    @base = firmware.guest_base()
    @lines = pci.device_lines(base, firmware.ecam(base))
    @measured = speeds(base)
    @last = group.get(measured, SAMPLES - 1)
    @total = group.count(lines)
    @usb = count_class(lines, "USB")
    @minutes = uptime_minutes(base)
    @rows = []
    drum (lines) { rows = group.add(rows, device_row(beat)) }
    @table_rows = str.join(rows, ", ")
    @speed = stat_sized(quoted("Процессор, млн/с"), quoted("{last}"), quoted("i5-7200U"), numbers(measured), "xs")
    @devices = stat_sized(quoted("Устройства PCI"), quoted("{total}"), quoted("USB {usb}"), "[3, 5, 8, 12, 15, 17, 19]", "xs")
    @memory = stat_sized(quoted("Память, МБ"), quoted("8192"), quoted("2 × 4 ГБ DDR4"), "[2, 4, 4, 6, 7, 7, 8]", "xs")
    @alive = stat_sized(quoted("Работает, минут"), quoted("{minutes}"), quoted("по счётчику HPET"), "[1, 2, 3, 4, 5, 6, 7]", "xs")
    @position_text = "{position}"
    @sidebar = "\{\"sidebar\": \{\"title\": \"Saltic\", \"subtitle\": \"пульт\", \"icon\": \"home\", \"height\": \"2xl\", \"user\": \"Зефир\", \"email\": \"zephyr@saltic.dev\", \"initials\": \"З\", \"groups\": [\{\"title\": \"Система\", \"items\": [\{\"icon\": \"home\", \"text\": \"Пульт\", \"active\": true\}, \{\"icon\": \"target\", \"text\": \"Железо\"\}, \{\"icon\": \"bell\", \"text\": \"События\"\}, \{\"icon\": \"mail\", \"text\": \"Сеть\"\}]\}, \{\"title\": \"Разработка\", \"items\": [\{\"icon\": \"file\", \"text\": \"Редактор\"\}, \{\"icon\": \"folder\", \"text\": \"Проекты\"\}, \{\"icon\": \"calendar\", \"text\": \"Сборки\"\}]\}]\}\}"
    @top = "\{\"row\": \{\"children\": [\{\"breadcrumb\": \{\"items\": [\"Saltic\", \"Пульт\"]\}\}, \{\"badge\": \{\"variant\": \"secondary\", \"text\": \"{position_text} / 14\"\}\}, \{\"spacer\": \{\}\}, \{\"input\": \{\"icon\": \"search\", \"placeholder\": \"Поиск…\", \"width\": \"sm\"\}\}, \{\"kbd\": \{\"text\": \"Ctrl\"\}\}, \{\"kbd\": \{\"text\": \"K\"\}\}, \{\"button\": \{\"variant\": \"ghost\", \"icon\": \"bell\"\}\}, \{\"avatar\": \{\"text\": \"З\"\}\}]\}\}"
    @stats = "\{\"row\": \{\"gap\": \"md\", \"children\": [{speed}, {devices}, {memory}, {alive}]\}\}"
    @bars = "\{\"card\": \{\"children\": [\{\"title\": \{\"text\": \"Сборки за неделю\"\}\}, \{\"chart\": \{\"kind\": \"bar\", \"width\": \"md\", \"height\": \"sm\", \"values\": [12, 19, 8, 24, 16, 30, 22], \"labels\": [\"Пн\", \"Вт\", \"Ср\", \"Чт\", \"Пт\", \"Сб\", \"Вс\"]\}\}]\}\}"
    @area = "\{\"card\": \{\"children\": [\{\"title\": \{\"text\": \"Время самосборки, с\"\}\}, \{\"chart\": \{\"kind\": \"area\", \"width\": \"md\", \"height\": \"sm\", \"values\": [41, 33, 30, 22, 14, 9, 7], \"labels\": [\"61:12\", \"70:19\", \"77:27\", \"80:27\", \"85:27\", \"90:27\", \"93:27\"]\}\}]\}\}"
    @first_event = feed_item(quoted("check"), quoted("Самосборка сошлась"), quoted("fixed point, 0 упавших"))
    @second_event = feed_item(quoted("arrow-right"), quoted("Агент 6 на диске"), quoted("приём программ 32 МБ"))
    @third_event = feed_item(quoted("bell"), quoted("Камера найдена"), quoted("0408:a030, поток изохронный"))
    @events = "\{\"card\": \{\"gap\": \"xs\", \"children\": [\{\"title\": \{\"text\": \"События\"\}\}, {first_event}, {second_event}, {third_event}]\}\}"
    @middle = "\{\"row\": \{\"gap\": \"md\", \"children\": [{bars}, {area}, {events}]\}\}"
    @table = "\{\"card\": \{\"children\": [\{\"title\": \{\"text\": \"Устройства PCI\"\}\}, \{\"scroll\": \{\"height\": \"md\", \"children\": [\{\"table\": \{\"columns\": [\"Адрес\", \"ID\", \"Класс\", \"Название\"], \"rows\": [{table_rows}]\}\}]\}\}]\}\}"
    @snippet = "\{\"code\": \{\"title\": \"pulse.saltic\", \"width\": \"md\", \"highlight\": 3, \"text\": \"skill pulse(base) \{\\n    @speed = speeds(base)\\n    out group.get(speed, 7)\\n\}\\n\\nprogram() \{\\n    out uiengine.show(dashboard(14))\\n\}\"\}\}"
    @bottom = "\{\"row\": \{\"gap\": \"md\", \"children\": [{table}, {snippet}]\}\}"
    @main = "\{\"column\": \{\"gap\": \"md\", \"children\": [{top}, {stats}, {middle}, {bottom}]\}\}"
    out "\{\"row\": \{\"gap\": \"lg\", \"children\": [{sidebar}, {main}]\}\}"
}
