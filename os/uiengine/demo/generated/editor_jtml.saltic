JTML = "\{\n \"column\": \{\n  \"gap\": \"md\",\n  \"children\": [\n   \{\n    \"row\": \{\n     \"children\": [\n      \{\n       \"heading\": \{\n        \"text\": \"Saltic UIEngine\"\n       \}\n      \},\n      \{\n       \"badge\": \{\n        \"variant\": \"secondary\",\n        \"text\": \"12 / 14\"\n       \}\n      \},\n      \{\n       \"spacer\": \{\}\n      \},\n      \{\n       \"muted\": \{\n        \"text\": \"← → листать, 1–0 страница, Esc — выход\"\n       \}\n      \}\n     ]\n    \}\n   \},\n   \{\n    \"tabs\": \{\n     \"items\": [\n      \"Кнопки\",\n      \"Поля\",\n      \"Выбор\",\n      \"Показ\",\n      \"Навигация\",\n      \"Данные\",\n      \"Меню\",\n      \"Диалог\",\n      \"Шторка\",\n      \"Ящик\",\n      \"Код\",\n      \"Редактор\",\n      \"Железо\",\n      \"Пульт\"\n     ],\n     \"value\": 11\n    \}\n   \},\n   \{\n    \"window\": \{\n     \"title\": \"saltic-os — agent.saltic\",\n     \"padding\": \"md\",\n     \"children\": [\n      \{\n       \"row\": \{\n        \"gap\": \"md\",\n        \"children\": [\n         \{\n          \"tree\": \{\n           \"width\": \"sm\",\n           \"children\": [\n            \{\n             \"text\": \"os\",\n             \"open\": true,\n             \"children\": [\n              \{\n               \"text\": \"target\",\n               \"open\": true,\n               \"children\": [\n                \{\n                 \"text\": \"uefi_x86_64\",\n                 \"open\": true,\n                 \"children\": [\n                  \{\n                   \"text\": \"agent.saltic\",\n                   \"active\": true\n                  \},\n                  \{\n                   \"text\": \"feed.saltic\"\n                  \},\n                  \{\n                   \"text\": \"net.saltic\"\n                  \},\n                  \{\n                   \"text\": \"rtl8111.saltic\"\n                  \}\n                 ]\n                \}\n               ]\n              \},\n              \{\n               \"text\": \"uiengine\",\n               \"children\": [\n                \{\n                 \"text\": \"x\"\n                \}\n               ]\n              \},\n              \{\n               \"text\": \"uiengine.saltic\"\n              \}\n             ]\n            \},\n            \{\n             \"text\": \"soul\",\n             \"children\": [\n              \{\n               \"text\": \"x\"\n              \}\n             ]\n            \},\n            \{\n             \"text\": \"README.md\"\n            \}\n           ]\n          \}\n         \},\n         \{\n          \"code\": \{\n           \"title\": \"agent.saltic\",\n           \"width\": \"xl\",\n           \"start\": 96,\n           \"highlight\": 103,\n           \"text\": \"skill launch(agent) \{\\n    (agent.expected == 0) \{ out \\\"ничего не принято\\\" \}\\n    ((agent.received == agent.expected) == no) \{ out str.add(\\\"приём не закончен: \\\", upload_state(agent)) \}\\n    @size = agent.expected\\n    log(agent, \\\"run: starting uploaded image, \{size\} bytes\\\")\\n    @launched = uefi.start_image(agent.card.base, agent.bay, size)\\n    agent.output = launched.output\\n    agent.lent = yes\\n    @outcome = launched.outcome\\n    @code = outcome.value.lo\\n    @status = \\\"\{code\}\\\"\\n    (outcome.failed == yes) \{ status = \\\"ошибка прошивки \{code\}\\\" \}\\n    log(agent, \\\"run: image returned\\\")\\n    rtl8111.configure(agent.card)\\n    rtl8111.wait_link(agent.card)\\n    log(agent, \\\"run: card configured again, listening\\\")\\n    out \\\"программа закончила работу, статус \{status\}\\\"\\n\}\\n\"\n          \}\n         \}\n        ]\n       \}\n      \}\n     ]\n    \}\n   \}\n  ]\n \}\n\}\n"
