JTML = "\{\"column\": \{\"gap\": 16, \"overlay\": \{\"dialog\": \{\"width\": 420, \"children\": [\n    \{\"heading\": \{\"text\": \"Удалить проект?\"\}\},\n    \{\"muted\": \{\"text\": \"Действие нельзя отменить. Проект saltic-os исчезнет.\"\}\},\n    \{\"row\": \{\"children\": [\n      \{\"spacer\": \{\}\},\n      \{\"button\": \{\"variant\": \"outline\", \"text\": \"Отмена\"\}\},\n      \{\"button\": \{\"variant\": \"destructive\", \"text\": \"Удалить\"\}\}\n    ]\}\}\n  ]\}\}, \"children\": [\n  \{\"row\": \{\"children\": [\n    \{\"heading\": \{\"text\": \"Saltic\"\}\},\n    \{\"menubar\": \{\"items\": [\"Файл\", \"Правка\", \"Вид\", \"Справка\"], \"value\": 1\}\},\n    \{\"spacer\": \{\}\},\n    \{\"tooltip\": \{\"text\": \"Поиск по проекту\"\}\},\n    \{\"button\": \{\"variant\": \"ghost\", \"icon\": \"search\"\}\}\n  ]\}\},\n  \{\"separator\": \{\}\},\n  \{\"row\": \{\"gap\": 16, \"children\": [\n    \{\"menu\": \{\"value\": 1, \"items\": [\n      \{\"label\": true, \"text\": \"Мой аккаунт\"\},\n      \{\"separator\": true\},\n      \{\"icon\": \"user\", \"text\": \"Профиль\", \"shortcut\": \"Shift+P\"\},\n      \{\"icon\": \"mail\", \"text\": \"Почта\", \"shortcut\": \"Ctrl+M\"\},\n      \{\"icon\": \"bell\", \"text\": \"Уведомления\"\},\n      \{\"separator\": true\},\n      \{\"icon\": \"x\", \"text\": \"Выйти\"\}\n    ]\}\},\n    \{\"command\": \{\"placeholder\": \"Введите команду…\", \"value\": 0, \"groups\": [\n      \{\"title\": \"Предложения\", \"items\": [\n        \{\"icon\": \"calendar\", \"text\": \"Календарь\"\},\n        \{\"icon\": \"search\", \"text\": \"Поиск файлов\", \"shortcut\": \"Ctrl+K\"\}\n      ]\},\n      \{\"title\": \"Настройки\", \"items\": [\n        \{\"icon\": \"user\", \"text\": \"Профиль\"\},\n        \{\"icon\": \"home\", \"text\": \"Главная\"\}\n      ]\}\n    ]\}\},\n    \{\"popover\": \{\"width\": 260, \"children\": [\n      \{\"title\": \{\"text\": \"Размеры\"\}\},\n      \{\"muted\": \{\"text\": \"Ширина и высота окна.\