JTML = "\{\n \"column\": \{\n  \"gap\": 14,\n  \"children\": [\n   \{\n    \"row\": \{\n     \"children\": [\n      \{\n       \"heading\": \{\n        \"text\": \"Saltic UIEngine\"\n       \}\n      \},\n      \{\n       \"badge\": \{\n        \"variant\": \"secondary\",\n        \"text\": \"11 / 11\"\n       \}\n      \},\n      \{\n       \"spacer\": \{\}\n      \},\n      \{\n       \"muted\": \{\n        \"text\": \"← → листать, 1–0 страница, Esc — выход\"\n       \}\n      \}\n     ]\n    \}\n   \},\n   \{\n    \"tabs\": \{\n     \"items\": [\n      \"Кнопки\",\n      \"Поля\",\n      \"Выбор\",\n      \"Показ\",\n      \"Навигация\",\n      \"Данные\",\n      \"Меню\",\n      \"Диалог\",\n      \"Шторка\",\n      \"Ящик\",\n      \"Код\"\n     ],\n     \"value\": 10\n    \}\n   \},\n   \{\n    \"row\": \{\n     \"gap\": 16,\n     \"children\": [\n      \{\n       \"code\": \{\n        \"title\": \"hello.saltic\",\n        \"width\": 560,\n        \"highlight\": 9,\n        \"text\": \"use os.uiengine\\n\\nGreeter = Box \{\\n    name = \\\"мир\\\",\\n    times = 3\\n\}\\n\\nskill greet(who) \{\\n    drum (who.times) \{\\n        io.show(\\\"Привет, \{who.name\}! #\{beat\}\\\")\\n    \}\\n    out none\\n\}\\n\\nprogram() \{\\n    @greeter = Greeter \{ name = \\\"Acer\\\" \}\\n    greet(greeter) rescue |err| \{ out err \}\\n    out uiengine.show(app_jtml.JTML)\\n\}\"\n       \}\n      \},\n      \{\n       \"code\": \{\n        \"title\": \"demo.saltic\",\n        \"width\": 620,\n        \"text\": \"DIGIT_ONE = 49\\nDIGIT_NINE = 57\\nSTOP = -1\\nTURNS = 100000\\n\\nskill next_page(index, key) \{\\n    @count = group.count(PAGES)\\n    (key.scan == SCAN_ESCAPE) \{ out STOP \}\\n    (key.scan == SCAN_RIGHT) \{ out (index + 1) - (index + 1) / count * count \}\\n    (key.scan == SCAN_DOWN) \{ out (index + 1) - (index + 1) / count * count \}\\n    (key.char == TAB) \{ out (index + 1) - (index + 1) / count * count \}\\n    (key.scan == SCAN_LEFT) \{ out (index + count - 1) - (index + count - 1) / count * count \}\\n    (key.scan == SCAN_UP) \{ out (index + count - 1) - (index + count - 1) / count * count \}\\n    (key.char == DIGIT_ZERO) \{ out count - 1 \}\\n    (key.char > DIGIT_ONE - 1) \{\\n        (key.char < DIGIT_NINE + 1) \{ out key.char - DIGIT_ONE \}\\n    \}\\n    out index\\n\}\\n\\nskill turn(index) \{\\n    uiengine.show(group.get(PAGES, index))\\n    out next_page(index, uefi.wait_key(firmware.guest_base()))\\n\}\\n\\nprogram() \{\\n    uefi.forget_keys(firmware.guest_base())\\n    @index = 0\\n    drum (TURNS) \{\"\n       \}\n      \}\n     ]\n    \}\n   \}\n  ]\n \}\n\}\n"
