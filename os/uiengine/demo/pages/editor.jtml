          "code": {
           "title": "agent.saltic",
           "width": "xl",
           "start": 96,
           "highlight": 103,
           "text": "skill launch(agent) {\n    (agent.expected == 0) { out \"ничего не принято\" }\n    ((agent.received == agent.expected) == no) { out str.add(\"приём не закончен: \", upload_state(agent)) }\n    @size = agent.expected\n    log(agent, \"run: starting uploaded image, {size} bytes\")\n    @launched = uefi.start_image(agent.card.base, agent.bay, size)\n    agent.output = launched.output\n    agent.lent = yes\n    @outcome = launched.outcome\n    @code = outcome.value.lo\n    @status = \"{code}\"\n    (outcome.failed == yes) { status = \"ошибка прошивки {code}\" }\n    log(agent, \"run: image returned\")\n    rtl8111.configure(agent.card)\n    rtl8111.wait_link(agent.card)\n    log(agent, \"run: card configured again, listening\")\n    out \"программа закончила работу, статус {status}\"\n}\n"
          }
         }
        ]
       }
      }
     ]
    }
   }
