     "children": [
      {
       "code": {
        "title": "hello.saltic",
        "width": "xl",
        "highlight": 9,
        "text": "use os.uiengine\n\nGreeter = Box {\n    name = \"мир\",\n    times = 3\n}\n\nskill greet(who) {\n    drum (who.times) {\n        io.show(\"Привет, {who.name}! #{beat}\")\n    }\n    out none\n}\n\nprogram() {\n    @greeter = Greeter { name = \"Acer\" }\n    greet(greeter) rescue |err| { out err }\n    out uiengine.show(app_jtml.JTML)\n}"
       }
      },
      {
       "code": {
        "title": "demo.saltic",
        "width": "xl",
        "text": "DIGIT_ONE = 49\nDIGIT_NINE = 57\nSTOP = -1\nTURNS = 100000\n\nskill next_page(index, key) {\n    @count = group.count(PAGES)\n    (key.scan == SCAN_ESCAPE) { out STOP }\n    (key.scan == SCAN_RIGHT) { out (index + 1) - (index + 1) / count * count }\n    (key.scan == SCAN_DOWN) { out (index + 1) - (index + 1) / count * count }\n    (key.char == TAB) { out (index + 1) - (index + 1) / count * count }\n    (key.scan == SCAN_LEFT) { out (index + count - 1) - (index + count - 1) / count * count }\n    (key.scan == SCAN_UP) { out (index + count - 1) - (index + count - 1) / count * count }\n    (key.char == DIGIT_ZERO) { out count - 1 }\n    (key.char > DIGIT_ONE - 1) {\n        (key.char < DIGIT_NINE + 1) { out key.char - DIGIT_ONE }\n    }\n    out index\n}\n\nskill turn(index) {\n    uiengine.show(group.get(PAGES, index))\n    out next_page(index, uefi.wait_key(firmware.guest_base()))\n}\n\nprogram() {\n    uefi.forget_keys(firmware.guest_base())\n    @index = 0\n    drum (TURNS) {"
       }
      }
     ]
    }
   }
  ]
 }
