-- layout — раскладка блоков JTML: column, row, field, scroll, resizable, desktop и рамки.
-- Размер считает measure_node до рисования; draw_node отдаёт высоту занятого места.
-- Отступы — токены canvas (gap, padding); spacer в row тянется на свободное место.
-- Листовые теги уходят в components; scroll держит строки под обрезкой через shapes.keep_rows.
--
-- is_block(tag) -> yes для блоков и рамок
-- measure_node(node) -> canvas.Size
-- fills(node) -> yes, если узел тянется на всю ширину
-- draw_node(screen, node, x, y, width, under) -> высота
-- draw_row(screen, props, x, y, width, gap, under) -> высота самого высокого ребёнка
-- draw_scroll(screen, node, x, y, width, under) / draw_panes(screen, node, x, y, under) -> высота; sizes — доли "1/3"
-- draw_desktop(screen, node) -> высота экрана; окна-дети каскадом
-- spacing(tag, props) -> Size { width = padding, height = gap } / space_or(props, name, fallback)
-- field_extra(props) / field_label / field_notes — подпись, подсказка и ошибка поля
-- scroll_content(props, width) -> высота содержимого scroll
-- fraction_top / fraction_bottom(words) -> числитель / знаменатель доли

use core.str
use core.num
use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.screen.graphics
use os.uiengine.canvas
use os.uiengine.shapes
use os.uiengine.jtml
use os.uiengine.components
use os.uiengine.fonts

GAP = 12
FIELD_GAP = 6
PANE_PADDING = 12

skill is_block(tag) {
    (components.is_frame(tag) == yes) { out yes }
    (tag == "field") { out yes }
    (tag == "scroll") { out yes }
    (tag == "resizable") { out yes }
    (tag == "desktop") { out yes }
    (tag == "column") { out yes }
    out tag == "row"
}

skill spacing(tag, props) {
    (components.is_frame(tag) == yes) { out canvas.Size { width = space_or(props, "padding", components.frame_padding(tag)), height = space_or(props, "gap", components.CARD_GAP) } }
    (tag == "field") { out canvas.Size { height = FIELD_GAP } }
    out canvas.Size { width = space_or(props, "padding", 0), height = space_or(props, "gap", GAP) }
}

skill space_or(props, name, fallback) {
    @token = jtml.prop_words(props, name, "")
    (token == "") { out fallback }
    out canvas.space_of(token)
}

skill field_extra(props) {
    @label = fonts.MEDIUM
    @hint = fonts.SMALL
    @extra = 0
    ((jtml.prop_words(props, "label", "") == "") == no) { extra = extra + label.line + FIELD_GAP }
    ((jtml.prop_words(props, "hint", "") == "") == no) { extra = extra + hint.line + FIELD_GAP }
    ((jtml.prop_words(props, "error", "") == "") == no) { extra = extra + hint.line + FIELD_GAP }
    out extra
}

skill measure_node(node) {
    @tag = jtml.tag_of(node)
    @props = jtml.props_of(node)
    (tag == "spacer") { out canvas.Size {} }
    (is_block(tag) == no) { out components.component_size(tag, props) }
    (tag == "resizable") { out canvas.Size { width = canvas.width_of(jtml.prop_words(props, "width", "xl")), height = canvas.height_of(jtml.prop_words(props, "height", "md")) } }
    @kids = jtml.prop_children(props)
    @space = spacing(tag, props)
    @across = 0
    @along = 0
    drum (kids) {
        @size = measure_node(beat)
        pick {
            (tag == "row") {
                across = across + size.width
                (size.height > along) { along = size.height }
            }
            {
                along = along + size.height
                (size.width > across) { across = size.width }
            }
        }
    }
    @gaps = (group.count(kids) - 1) * space.height
    (gaps < 0) { gaps = 0 }
    (tag == "row") { across = across + gaps }
    ((tag == "row") == no) { along = along + gaps }
    (tag == "field") { along = along + field_extra(props) }
    (tag == "scroll") { out canvas.Size { width = across + 2 * PANE_PADDING, height = canvas.height_of(jtml.prop_words(props, "height", "md")) } }
    @outer = across + 2 * space.width
    @least = jtml.prop_words(props, "width", "")
    ((least == "") == no) {
        (canvas.width_of(least) > outer) { outer = canvas.width_of(least) }
    }
    out canvas.Size { width = outer, height = along + 2 * space.width + components.frame_header(tag) }
}

skill fills(node) {
    @tag = jtml.tag_of(node)
    (is_block(tag) == yes) { out yes }
    out components.component_stretch(tag)
}

skill draw_node(screen, node, x, y, width, under) {
    @tag = jtml.tag_of(node)
    @props = jtml.props_of(node)
    (tag == "spacer") { out 0 }
    (is_block(tag) == no) { out components.draw_component(screen, tag, props, x, y, width, under) }
    (tag == "scroll") { out draw_scroll(screen, node, x, y, width, under) }
    (tag == "desktop") { out draw_desktop(screen, node) }
    (tag == "resizable") { out draw_panes(screen, node, x, y, under) }
    @size = measure_node(node)
    @space = spacing(tag, props)
    @inner = under
    @header = 0
    (components.is_frame(tag) == yes) {
        inner = components.draw_frame(screen, tag, x, y, width, size.height, under, jtml.prop_words(props, "title", ""))
        header = components.frame_header(tag)
        (tag == "window") { components.draw_title(screen, x, y, width, jtml.prop_words(props, "title", "")) }
    }
    @pad = space.width
    (tag == "row") { out draw_row(screen, props, x + pad, y + pad, width - 2 * pad, space.height, inner) + 2 * pad }
    @cursor = y + pad + header
    (tag == "field") { cursor = field_label(screen, props, x, cursor) }
    drum (jtml.prop_children(props)) {
        @child_width = width - 2 * pad
        (fills(beat) == no) {
            @child = measure_node(beat)
            child_width = child.width
        }
        cursor = cursor + draw_node(screen, beat, x + pad, cursor, child_width, inner) + space.height
    }
    (tag == "field") { field_notes(screen, props, x, cursor) }
    out size.height
}

skill field_label(screen, props, x, y) {
    @label = jtml.prop_words(props, "label", "")
    (label == "") { out y }
    @face = fonts.MEDIUM
    fonts.draw_text(screen, x, y, label, canvas.ZINC_900, face)
    out y + face.line + FIELD_GAP
}

skill field_notes(screen, props, x, y) {
    @face = fonts.SMALL
    @hint = jtml.prop_words(props, "hint", "")
    @top = y
    ((hint == "") == no) {
        fonts.draw_text(screen, x, top, hint, canvas.ZINC_500, face)
        top = top + face.line + FIELD_GAP
    }
    @error = jtml.prop_words(props, "error", "")
    ((error == "") == no) { fonts.draw_text(screen, x, top, error, canvas.RED_500, face) }
    out none
}

skill draw_row(screen, props, x, y, width, gap, under) {
    @kids = jtml.prop_children(props)
    @used = (group.count(kids) - 1) * gap
    @springs = 0
    @tallest = 0
    drum (kids) {
        @size = measure_node(beat)
        used = used + size.width
        (jtml.tag_of(beat) == "spacer") { springs = springs + 1 }
        (size.height > tallest) { tallest = size.height }
    }
    @extra = 0
    (springs > 0) { extra = (width - used) / springs }
    @pen = x
    drum (kids) {
        @size = measure_node(beat)
        @child_width = size.width
        (jtml.tag_of(beat) == "spacer") { child_width = extra }
        @shift = (tallest - size.height) / 2
        (is_block(jtml.tag_of(beat)) == yes) { shift = 0 }
        draw_node(screen, beat, pen, y + shift, child_width, under)
        pen = pen + child_width + gap
    }
    out tallest
}

skill scroll_content(props, width) {
    @content = PANE_PADDING
    drum (jtml.prop_children(props)) {
        @size = measure_node(beat)
        content = content + size.height + GAP
    }
    out content
}

skill draw_scroll(screen, node, x, y, width, under) {
    @props = jtml.props_of(node)
    @height = canvas.height_of(jtml.prop_words(props, "height", "md"))
    shapes.framed_box(screen, x, y, width, height, 8, canvas.variant_look("outline"), under)
    @content = scroll_content(props, width)
    @overflow = content - height
    (overflow > screen.height - y - height) { overflow = screen.height - y - height }
    @kept = 0
    (overflow > 0) { kept = shapes.keep_rows(screen, x, y + height, width, overflow) }
    @cursor = y + PANE_PADDING
    drum (jtml.prop_children(props)) { cursor = cursor + draw_node(screen, beat, x + PANE_PADDING, cursor, width - 3 * PANE_PADDING, canvas.WHITE) + GAP }
    (overflow > 0) {
        shapes.put_back_rows(screen, kept, x, y + height, width, overflow)
        shapes.hairline(screen, x + 8, y + height - 1, width - 16, canvas.ZINC_200)
        graphics.fill(screen, x + 1, y + height - 2, width - 2, 1, canvas.paint(screen, canvas.WHITE))
        @thumb = height * height / content
        shapes.rounded(screen, x + width - 8, y + 4, 4, thumb - 8, 2, canvas.ZINC_200, canvas.WHITE)
    }
    out height
}

skill draw_panes(screen, node, x, y, under) {
    @props = jtml.props_of(node)
    @width = canvas.width_of(jtml.prop_words(props, "width", "xl"))
    @height = canvas.height_of(jtml.prop_words(props, "height", "md"))
    shapes.framed_box(screen, x, y, width, height, 8, canvas.variant_look("outline"), under)
    @sizes = jtml.prop(props, "sizes")
    @kids = jtml.prop_children(props)
    @pen = x
    drum (group.count(kids)) {
        @share = width / group.count(kids)
        (beat < group.count(sizes.items)) {
            @part = group.get(sizes.items, beat)
            share = width * fraction_top(part.words) / fraction_bottom(part.words)
        }
        draw_node(screen, group.get(kids, beat), pen + PANE_PADDING, y + PANE_PADDING, share - 2 * PANE_PADDING, canvas.WHITE)
        pen = pen + share
        (beat < group.count(kids) - 1) {
            graphics.fill(screen, pen, y + 1, 1, height - 2, canvas.paint(screen, canvas.ZINC_200))
            shapes.framed_box(screen, pen - 5, y + height / 2 - 10, 11, 20, 3, canvas.Look { fill = canvas.ZINC_100, edge = canvas.ZINC_200, framed = yes }, canvas.WHITE)
        }
    }
    out height
}

skill fraction_top(words) {
    out num.digit_value(str.get(words, 0))
}

skill fraction_bottom(words) {
    (str.bytes(words) < 3) { out 1 }
    out num.digit_value(str.get(words, 2))
}

skill draw_desktop(screen, node) {
    @props = jtml.props_of(node)
    components.paint_desktop(screen, props)
    @kids = jtml.prop_children(props)
    drum (group.count(kids)) {
        @child = group.get(kids, beat)
        @width = canvas.width_of(jtml.prop_words(jtml.props_of(child), "width", "md"))
        draw_node(screen, child, 380 + beat * 48, 80 + beat * 48, width, canvas.CREAM)
    }
    out screen.height
}
