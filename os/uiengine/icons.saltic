-- icons — иконки UIEngine в духе lucide из icons/generated (set16, set12, set28).
-- Имя иконки — из set16.NAMES; неизвестное имя ничего не рисует, но размер отдаёт.
--
-- icon_index(name) -> номер в NAMES или -1
-- draw_icon(screen, x, y, name, ink) -> SIZE (16)
-- draw_small_icon(screen, x, y, name, ink) -> SMALL (12)
-- draw_large_icon(screen, x, y, name, ink) -> LARGE (28)

use core.group
use os.uiengine.fonts
use os.uiengine.icons.generated.set16
use os.uiengine.icons.generated.set12
use os.uiengine.icons.generated.set28

SIZE = set16.SIZE
SMALL = set12.SIZE
LARGE = set28.SIZE

skill icon_index(name) {
    drum (group.count(set16.NAMES)) {
        (group.get(set16.NAMES, beat) == name) { out beat }
    }
    out -1
}

skill draw_icon(screen, x, y, name, ink) {
    @index = icon_index(name)
    (index < 0) { out SIZE }
    fonts.draw_square(screen, x, y, group.get(set16.PIXELS, index), SIZE, ink)
    out SIZE
}

skill draw_small_icon(screen, x, y, name, ink) {
    @index = icon_index(name)
    (index < 0) { out SMALL }
    fonts.draw_square(screen, x, y, group.get(set12.PIXELS, index), SMALL, ink)
    out SMALL
}

skill draw_large_icon(screen, x, y, name, ink) {
    @index = icon_index(name)
    (index < 0) { out LARGE }
    fonts.draw_square(screen, x, y, group.get(set28.PIXELS, index), LARGE, ink)
    out LARGE
}
