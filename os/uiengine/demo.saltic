-- demo — галерея UIEngine: 12 страниц из demo/generated и две живые из monitor; листание клавиатурой.
-- Программа для x86_64-uefi (куча 128 МБ), запуск через агента; по выходу — доклад reply.home.
-- Клавиши: ← → ↑ ↓ Tab — соседняя страница, 1–0 — номер, Esc — выход.
--
-- Turn { index, scan, char } — итог одного показа
-- next_page(index, key, count) -> номер следующей страницы или STOP
-- turn(frames, index, pages) -> Turn — показать страницу и ждать клавишу
-- drain_keys(base) -> сколько старых нажатий выброшено
-- program() — точка входа

use core.group
use os.target.uefi_x86_64.platform.firmware
use os.target.uefi_x86_64.platform.uefi
use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.network.reply
use os.uiengine
use os.uiengine.demo.generated.buttons_jtml
use os.uiengine.demo.generated.fields_jtml
use os.uiengine.demo.generated.choices_jtml
use os.uiengine.demo.generated.display_jtml
use os.uiengine.demo.generated.navigation_jtml
use os.uiengine.demo.generated.data_jtml
use os.uiengine.demo.generated.menus_jtml
use os.uiengine.demo.generated.dialog_jtml
use os.uiengine.demo.generated.sheet_jtml
use os.uiengine.demo.generated.drawer_jtml
use os.uiengine.demo.generated.code_jtml
use os.uiengine.demo.generated.editor_jtml
use os.uiengine.demo.monitor

PAGES = [buttons_jtml.JTML, fields_jtml.JTML, choices_jtml.JTML, display_jtml.JTML, navigation_jtml.JTML, data_jtml.JTML, menus_jtml.JTML, dialog_jtml.JTML, sheet_jtml.JTML, drawer_jtml.JTML, code_jtml.JTML, editor_jtml.JTML]
SCAN_UP = 1
SCAN_DOWN = 2
SCAN_RIGHT = 3
SCAN_LEFT = 4
SCAN_ESCAPE = 23
TAB = 9
DIGIT_ZERO = 48
DIGIT_ONE = 49
DIGIT_NINE = 57
STOP = -1
TURNS = 100000
DRAIN = 64

skill next_page(index, key, count) {
    (key.scan == SCAN_ESCAPE) { out STOP }
    (key.scan == SCAN_RIGHT) { out (index + 1) - (index + 1) / count * count }
    (key.scan == SCAN_DOWN) { out (index + 1) - (index + 1) / count * count }
    (key.char == TAB) { out (index + 1) - (index + 1) / count * count }
    (key.scan == SCAN_LEFT) { out (index + count - 1) - (index + count - 1) / count * count }
    (key.scan == SCAN_UP) { out (index + count - 1) - (index + count - 1) / count * count }
    (key.char == DIGIT_ZERO) { out 9 }
    (key.char > DIGIT_ONE - 1) {
        (key.char < DIGIT_NINE + 1) { out key.char - DIGIT_ONE }
    }
    out index
}

Turn = Box {
    index = 0,
    scan = 0,
    char = 0
}

skill turn(frames, index, pages) {
    uiengine.show_on(frames.back, group.get(pages, index))
    graphics.present(frames)
    @key = uefi.wait_key(firmware.guest_base())
    out Turn { index = next_page(index, key, group.count(pages)), scan = key.scan, char = key.char }
}

skill drain_keys(base) {
    @dropped = 0
    drum (DRAIN) {
        @key = uefi.poll_key(base, 0)
        (key.ready == no) { out dropped }
        dropped = dropped + 1
    }
    out dropped
}

program() {
    @base = firmware.guest_base()
    uefi.forget_keys(base)
    @dropped = drain_keys(base)
    @pages = group.add(group.add(PAGES, monitor.page(group.count(PAGES) + 1)), monitor.dashboard(group.count(PAGES) + 2))
    @frames = graphics.open_frames(base)
    @index = 0
    @turns = 0
    drum (TURNS) {
        @step = turn(frames, index, pages)
        turns = turns + 1
        (step.index == STOP) {
            @scan = step.scan
            graphics.close_frames(frames)
            reply.home("галерея: выход по клавише (скан-код {scan}), страниц показано {turns}, старых нажатий выброшено {dropped}")
            out none
        }
        index = step.index
    }
    out none
}
