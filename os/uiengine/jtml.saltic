-- jtml — узлы страницы JTML: тег, свойства, дети.
-- Узел — объект с одним ключом-тегом: {"button": {…}}; свойства — reader.Value вида OBJECT,
-- дети — свойство "children". Разбор текста — в jtml/reader.
--
-- read_tree(source) -> корневой Value; BadJtml
-- tag_of(node) -> тег или "" (не объект) / props_of(node) -> свойства
-- prop(props, name) -> Value (пустой, если нет)
-- prop_words / prop_amount(props, name, fallback) -> текст / число или fallback
-- prop_truth(props, name) -> yes/no / prop_children(props) -> группа узлов
-- with_words(props, name, words) -> копия свойств с заменённым текстовым полем

use core.group
use os.uiengine.jtml.reader

skill read_tree(source) {
    out reader.read_jtml(source)
}

skill tag_of(node) {
    ((node.kind == reader.Kind.OBJECT) == no) { out "" }
    out group.get(node.keys, 0)
}

skill props_of(node) {
    out group.get(node.items, 0)
}

skill prop(props, name) {
    drum (group.count(props.keys)) {
        (group.get(props.keys, beat) == name) { out group.get(props.items, beat) }
    }
    out reader.Value {}
}

skill prop_words(props, name, fallback) {
    @found = prop(props, name)
    (found.kind == reader.Kind.WORDS) { out found.words }
    out fallback
}

skill prop_amount(props, name, fallback) {
    @found = prop(props, name)
    (found.kind == reader.Kind.AMOUNT) { out found.amount }
    out fallback
}

skill prop_truth(props, name) {
    @found = prop(props, name)
    out found.truth
}

skill prop_children(props) {
    @found = prop(props, "children")
    out found.items
}

skill with_words(props, name, words) {
    @keys = [name]
    @items = [reader.Value { kind = reader.Kind.WORDS, words = words }]
    drum (group.count(props.keys)) {
        ((group.get(props.keys, beat) == name) == no) {
            keys = group.add(keys, group.get(props.keys, beat))
            items = group.add(items, group.get(props.items, beat))
        }
    }
    out reader.Value { kind = reader.Kind.OBJECT, keys = keys, items = items }
}
