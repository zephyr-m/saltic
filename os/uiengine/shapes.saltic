use core.num
use core.mem
use os.target.uefi_x86_64.graphics
use os.uiengine.canvas

SAMPLES = 4
FULL = 16
SHADOW_STEP = 8

skill coverage(column, row, radius) {
    @limit = 64 * radius * radius
    @inside = 0
    drum (SAMPLES) {
        @dx = 8 * column + 2 * beat + 1 - 8 * radius
        drum (SAMPLES) {
            @dy = 8 * row + 2 * beat + 1 - 8 * radius
            (dx * dx + dy * dy < limit + 1) { inside = inside + 1 }
        }
    }
    out inside
}

skill rounded(screen, x, y, width, height, radius, color, under) {
    @solid = canvas.paint(screen, color)
    drum (height) {
        @row = beat
        @from_edge = row
        (row > height - radius - 1) { from_edge = height - 1 - row }
        pick {
            (from_edge < radius) {
                drum (radius) {
                    @shade = canvas.paint(screen, canvas.mix(under, color, coverage(beat, from_edge, radius), FULL))
                    graphics.fill(screen, x + beat, y + row, 1, 1, shade)
                    graphics.fill(screen, x + width - 1 - beat, y + row, 1, 1, shade)
                }
                graphics.fill(screen, x + radius, y + row, width - 2 * radius, 1, solid)
            }
            { graphics.fill(screen, x, y + row, width, 1, solid) }
        }
    }
    out none
}

skill framed_box(screen, x, y, width, height, radius, style, under) {
    (style.framed == no) { out rounded(screen, x, y, width, height, radius, style.fill, under) }
    rounded(screen, x, y, width, height, radius, style.edge, under)
    out rounded(screen, x + 1, y + 1, width - 2, height - 2, radius - 1, style.fill, style.edge)
}

skill hairline(screen, x, y, width, color) {
    out graphics.fill(screen, x, y, width, 1, canvas.paint(screen, color))
}

skill shadow(screen, x, y, width, height, radius, under, blur) {
    @drop = blur / 3 + 1
    drum (blur) {
        @spread = blur - beat
        @strength = (beat + 1) * SHADOW_STEP
        rounded(screen, x - spread, y - spread + drop, width + 2 * spread, height + 2 * spread, radius + spread, canvas.mix(under, canvas.BLACK, strength, 1000), under)
    }
    out none
}

skill dim_row(screen, row, keep) {
    @start = row * screen.stride * graphics.PIXEL_BYTES
    drum (screen.width) {
        @at = start + beat * graphics.PIXEL_BYTES
        @value = mem.load32(screen.memory, at)
        @high = num.mod(value / 65536, 256) * keep / 100
        @middle = num.mod(value / 256, 256) * keep / 100
        @low = num.mod(value, 256) * keep / 100
        mem.store32(screen.memory, at, high * 65536 + middle * 256 + low)
    }
    out none
}

skill dim(screen, keep) {
    drum (screen.height) { dim_row(screen, beat, keep) }
    out none
}

skill stroke_cover(px, py, ax, ay, bx, by, half) {
    @dx = bx - ax
    @dy = by - ay
    @length = dx * dx + dy * dy
    @inside = 0
    drum (SAMPLES) {
        @sx = px * 4 + beat
        drum (SAMPLES) {
            @sy = py * 4 + beat
            @along = (sx - ax) * dx + (sy - ay) * dy
            @t = 0
            (length > 4096) { t = along / (length / 64) }
            (length > 0) {
                (length < 4097) { t = along * 64 / length }
            }
            (t < 0) { t = 0 }
            (t > 64) { t = 64 }
            @ex = sx - ax - dx * t / 64
            @ey = sy - ay - dy * t / 64
            (ex * ex + ey * ey < half * half + 1) { inside = inside + 1 }
        }
    }
    out inside
}

skill stroke(screen, x0, y0, x1, y1, width, color, under) {
    @half = width * 2
    @left = x0
    (x1 < left) { left = x1 }
    @top = y0
    (y1 < top) { top = y1 }
    @wide = x0 + x1 - 2 * left + width + 2
    @tall = y0 + y1 - 2 * top + width + 2
    @from_x = left - width / 2 - 1
    @from_y = top - width / 2 - 1
    drum (tall) {
        @py = from_y + beat
        drum (wide) {
            @px = from_x + beat
            @cover = stroke_cover(px, py, x0 * 4 + 2, y0 * 4 + 2, x1 * 4 + 2, y1 * 4 + 2, half)
            (cover > 0) {
                @at = (py * screen.stride + px) * graphics.PIXEL_BYTES
                @below = canvas.unpack(screen, mem.load32(screen.memory, at))
                mem.store32(screen.memory, at, canvas.paint(screen, canvas.mix(below, color, cover, FULL)))
            }
        }
    }
    out none
}
