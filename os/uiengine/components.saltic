-- components — диспетчер компонентов UIEngine: по тегу JTML находит группу-владельца.
-- Группа отвечает на <группа>_own(tag), _size, _draw, _stretch; рамки (card, dialog, window…)
-- рисует display/card, glass — desktop. CARD_GAP — зазор внутри рамок.
--
-- component_size(tag, props) -> canvas.Size; неизвестный тег — пустой размер
-- component_stretch(tag) -> yes, если компонент тянется на ширину родителя
-- draw_component(screen, tag, props, x, y, width, under) -> высота; неизвестный тег — 0
-- is_frame(tag) / frame_padding(tag) / frame_header(tag) — рамки и их отступы
-- draw_frame(screen, tag, x, y, width, height, under, title) -> цвет фона внутри рамки
-- paint_desktop(screen, props) — обои, панель, плитки рабочего стола
-- draw_title(screen, x, y, width, title) -> высота заголовка окна
--
-- Дети: buttons, fields, choices, display, navigation, overlays, data, desktop.

use os.uiengine.canvas
use os.uiengine.components.buttons
use os.uiengine.components.fields
use os.uiengine.components.choices
use os.uiengine.components.display
use os.uiengine.components.navigation
use os.uiengine.components.overlays
use os.uiengine.components.data
use os.uiengine.components.desktop

CARD_GAP = display.CARD_GAP

skill component_size(tag, props) {
    (buttons.buttons_own(tag) == yes) { out buttons.buttons_size(tag, props) }
    (fields.fields_own(tag) == yes) { out fields.fields_size(tag, props) }
    (choices.choices_own(tag) == yes) { out choices.choices_size(tag, props) }
    (display.display_own(tag) == yes) { out display.display_size(tag, props) }
    (navigation.navigation_own(tag) == yes) { out navigation.navigation_size(tag, props) }
    (overlays.overlays_own(tag) == yes) { out overlays.overlays_size(tag, props) }
    (data.data_own(tag) == yes) { out data.data_size(tag, props) }
    out canvas.Size {}
}

skill component_stretch(tag) {
    (fields.fields_stretch(tag) == yes) { out yes }
    (choices.choices_stretch(tag) == yes) { out yes }
    (navigation.navigation_stretch(tag) == yes) { out yes }
    (data.data_stretch(tag) == yes) { out yes }
    out display.display_stretch(tag)
}

skill draw_component(screen, tag, props, x, y, width, under) {
    (buttons.buttons_own(tag) == yes) { out buttons.buttons_draw(screen, tag, props, x, y, under) }
    (fields.fields_own(tag) == yes) { out fields.fields_draw(screen, tag, props, x, y, width, under) }
    (choices.choices_own(tag) == yes) { out choices.choices_draw(screen, tag, props, x, y, width, under) }
    (display.display_own(tag) == yes) { out display.display_draw(screen, tag, props, x, y, width, under) }
    (navigation.navigation_own(tag) == yes) { out navigation.navigation_draw(screen, tag, props, x, y, width, under) }
    (overlays.overlays_own(tag) == yes) { out overlays.overlays_draw(screen, tag, props, x, y, width, under) }
    (data.data_own(tag) == yes) { out data.data_draw(screen, tag, props, x, y, width, under) }
    out 0
}

skill is_frame(tag) {
    (desktop.desktop_frame(tag) == yes) { out yes }
    out display.is_frame(tag)
}

skill frame_padding(tag) {
    (desktop.desktop_frame(tag) == yes) { out desktop.glass_padding() }
    out display.frame_padding(tag)
}

skill draw_frame(screen, tag, x, y, width, height, under, title) {
    (desktop.desktop_frame(tag) == yes) { out desktop.draw_glass(screen, x, y, width, height, title) }
    out display.draw_frame(screen, tag, x, y, width, height, under)
}

skill frame_header(tag) {
    (desktop.desktop_frame(tag) == yes) { out desktop.glass_header() }
    out display.frame_header(tag)
}

skill paint_desktop(screen, props) {
    out desktop.paint_desktop(screen, props)
}

skill draw_title(screen, x, y, width, title) {
    out display.draw_title(screen, x, y, width, title)
}
