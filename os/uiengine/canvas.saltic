-- canvas — цвета и токены дизайн-системы UIEngine: палитра zinc и органическая палитра CareOS.
-- Цвет — Rgb по 0…255, на экран переводит paint(). Токены отступов, ширин и высот —
-- имена (none, xs…2xl); числа в пикселях живут только здесь.
--
-- Rgb { red, green, blue } / Size { width, height } / Look { fill, ink, edge, framed }
-- mix(under, over, cover, full) -> Rgb — смесь, cover из full долей over
-- paint(screen, color) -> число пикселя экрана / unpack(screen, value) -> Rgb
-- variant_look(variant) -> Look: default, secondary, outline, destructive, ghost
-- faded(style, under) -> Look вполсилы (disabled)
-- space_of / width_of / height_of(token) -> пиксели; неизвестный токен — середина шкалы
-- scale_of(names, values, token) -> значение по имени из пары групп
-- organic_tint(name) -> [светлый, тёмный] для плиток: sky, peach, leaf, иначе sage
-- Константы: ZINC_900…ZINC_100, WHITE, PAPER, RED_500, BLACK; CREAM, INK, SAGE, SAND, STONE… для стола.

use core.num
use core.group
use os.target.uefi_x86_64.screen.graphics

FULL = 16
HALF = 8

Rgb = Box {
    red = 0,
    green = 0,
    blue = 0
}

Size = Box {
    width = 0,
    height = 0
}

Look = Box {
    fill = Rgb {},
    ink = Rgb {},
    edge = Rgb {},
    framed = no
}

ZINC_900 = Rgb { red = 24, green = 24, blue = 27 }
ZINC_500 = Rgb { red = 113, green = 113, blue = 122 }
ZINC_200 = Rgb { red = 228, green = 228, blue = 231 }
ZINC_100 = Rgb { red = 244, green = 244, blue = 245 }
WHITE = Rgb { red = 255, green = 255, blue = 255 }
PAPER = Rgb { red = 250, green = 250, blue = 250 }
RED_500 = Rgb { red = 239, green = 68, blue = 68 }
BLACK = Rgb {}

skill mix(under, over, cover, full) {
    @rest = full - cover
    out Rgb {
        red = (under.red * rest + over.red * cover) / full,
        green = (under.green * rest + over.green * cover) / full,
        blue = (under.blue * rest + over.blue * cover) / full
    }
}

skill paint(screen, color) {
    out graphics.color(screen, color.red, color.green, color.blue)
}

skill unpack(screen, value) {
    @high = num.mod(value / 65536, 256)
    @middle = num.mod(value / 256, 256)
    @low = num.mod(value, 256)
    (screen.format == graphics.FORMAT_RGB) { out Rgb { red = low, green = middle, blue = high } }
    out Rgb { red = high, green = middle, blue = low }
}

skill variant_look(variant) {
    (variant == "secondary") { out Look { fill = ZINC_100, ink = ZINC_900 } }
    (variant == "outline") { out Look { fill = WHITE, ink = ZINC_900, edge = ZINC_200, framed = yes } }
    (variant == "destructive") { out Look { fill = RED_500, ink = WHITE } }
    (variant == "ghost") { out Look { fill = WHITE, ink = ZINC_900 } }
    out Look { fill = ZINC_900, ink = PAPER }
}

skill faded(style, under) {
    out Look { fill = mix(under, style.fill, HALF, FULL), ink = mix(under, style.ink, HALF, FULL), edge = mix(under, style.edge, HALF, FULL), framed = style.framed }
}

SPACE_NAMES = ["none", "xs", "sm", "md", "lg", "xl", "2xl"]
SPACE_VALUES = [0, 4, 8, 12, 16, 24, 32]
WIDTH_NAMES = ["xs", "sm", "md", "lg", "xl", "2xl"]
WIDTH_VALUES = [160, 240, 320, 420, 560, 720]
HEIGHT_VALUES = [40, 120, 200, 280, 560, 720]

skill scale_of(names, values, token) {
    drum (group.count(names)) {
        (group.get(names, beat) == token) { out group.get(values, beat) }
    }
    out group.get(values, group.count(values) / 2)
}

skill space_of(token) {
    out scale_of(SPACE_NAMES, SPACE_VALUES, token)
}

skill width_of(token) {
    out scale_of(WIDTH_NAMES, WIDTH_VALUES, token)
}

skill height_of(token) {
    out scale_of(WIDTH_NAMES, HEIGHT_VALUES, token)
}

CREAM = Rgb { red = 250, green = 248, blue = 243 }
INK = Rgb { red = 58, green = 58, blue = 54 }
SAGE = Rgb { red = 122, green = 155, blue = 118 }
SAGE_LIGHT = Rgb { red = 157, green = 179, blue = 154 }
LEAF = Rgb { red = 196, green = 214, blue = 164 }
SAND = Rgb { red = 244, green = 234, blue = 213 }
BARK = Rgb { red = 139, green = 115, blue = 85 }
SKY = Rgb { red = 107, green = 163, blue = 196 }
SKY_LIGHT = Rgb { red = 126, green = 180, blue = 212 }
PEACH = Rgb { red = 232, green = 168, blue = 124 }
PEACH_LIGHT = Rgb { red = 240, green = 192, blue = 159 }
ROSE = Rgb { red = 229, green = 115, blue = 115 }
GROWTH = Rgb { red = 76, green = 175, blue = 80 }
STONE = Rgb { red = 184, green = 180, blue = 169 }

skill organic_tint(name) {
    (name == "sky") { out [SKY_LIGHT, SKY] }
    (name == "peach") { out [PEACH_LIGHT, PEACH] }
    (name == "leaf") { out [LEAF, SAGE_LIGHT] }
    out [SAGE_LIGHT, SAGE]
}
