use core.num
use os.target.uefi_x86_64.graphics

FULL = 16
HALF = 8

Rgb = Box {
    red = 0,
    green = 0,
    blue = 0
}

Size = Box {
    width = 0,
    height = 0
}

Look = Box {
    fill = Rgb {},
    ink = Rgb {},
    edge = Rgb {},
    framed = no
}

ZINC_900 = Rgb { red = 24, green = 24, blue = 27 }
ZINC_500 = Rgb { red = 113, green = 113, blue = 122 }
ZINC_200 = Rgb { red = 228, green = 228, blue = 231 }
ZINC_100 = Rgb { red = 244, green = 244, blue = 245 }
WHITE = Rgb { red = 255, green = 255, blue = 255 }
PAPER = Rgb { red = 250, green = 250, blue = 250 }
RED_500 = Rgb { red = 239, green = 68, blue = 68 }
BLACK = Rgb {}

skill mix(under, over, cover, full) {
    @rest = full - cover
    out Rgb {
        red = (under.red * rest + over.red * cover) / full,
        green = (under.green * rest + over.green * cover) / full,
        blue = (under.blue * rest + over.blue * cover) / full
    }
}

skill paint(screen, color) {
    out graphics.color(screen, color.red, color.green, color.blue)
}

skill unpack(screen, value) {
    @high = num.mod(value / 65536, 256)
    @middle = num.mod(value / 256, 256)
    @low = num.mod(value, 256)
    (screen.format == graphics.FORMAT_RGB) { out Rgb { red = low, green = middle, blue = high } }
    out Rgb { red = high, green = middle, blue = low }
}

skill variant_look(variant) {
    (variant == "secondary") { out Look { fill = ZINC_100, ink = ZINC_900 } }
    (variant == "outline") { out Look { fill = WHITE, ink = ZINC_900, edge = ZINC_200, framed = yes } }
    (variant == "destructive") { out Look { fill = RED_500, ink = WHITE } }
    (variant == "ghost") { out Look { fill = WHITE, ink = ZINC_900 } }
    out Look { fill = ZINC_900, ink = PAPER }
}

skill faded(style, under) {
    out Look { fill = mix(under, style.fill, HALF, FULL), ink = mix(under, style.ink, HALF, FULL), edge = mix(under, style.edge, HALF, FULL), framed = style.framed }
}
