{
  "id": "saltic-playground",
  "state": {
    "source": "use seed\n\nprogram() {\n    seed.io.show(\"Привет из Saltic\")\n    out none\n}",
    "output": "Нажми «Запустить».",
    "loading": false
  },
  "markup": [
    {"main": {"children": [
      {"header": {"children": [
        {"h1": {"children": [
          {"span": {"text": "Saltic"}},
          {"span": {"text": " Playground"}}
        ]}},
        {"div": {"class": "hint", "text": "JTML frontend · Saltic backend · Ctrl + Enter"}}
      ]}},
      {"section": {"class": "workspace", "children": [
        {"article": {"class": "pane", "children": [
          {"div": {"class": "toolbar", "children": [
            {"strong": {"text": "Исходник"}},
            {"select": {
              "id": "example",
              "bind": "source",
              "options": [
                {
                  "label": "Приветствие",
                  "value": "use seed\n\nprogram() {\n    seed.io.show(\"Привет из Saltic\")\n    out none\n}"
                },
                {
                  "label": "Box",
                  "value": "use seed\n\nPerson = Box {\n    name = \"unknown\"\n    age = 0\n}\n\nprogram() {\n    @person = Person { name = \"Zephyr\" age = 10 }\n    seed.io.show(person.name, \": \", person.age)\n    out none\n}"
                },
                {
                  "label": "Группа",
                  "value": "use seed\n\nprogram() {\n    @items = [\"cell\", \"event\", \"out\"]\n    @index = 0\n    drum (seed.group.count(items)) {\n        seed.io.show(index, \": \", seed.group.at(items, index))\n        index = index + 1\n    }\n    out none\n}"
                }
              ]
            }},
            {"button": {
              "id": "run",
              "class": "run",
              "text": "Запустить",
              "disabled": "$loading",
              "onClick": {
                "set": {"loading": true, "output": ""},
                "fetch": {
                  "url": "/api/run",
                  "method": "POST",
                  "body": {"source": "$source"},
                  "path": "output",
                  "into": "output"
                }
              }
            }}
          ]}},
          {"textarea": {"class": "source", "bind": "source", "rows": 24}}
        ]}},
        {"article": {"class": "pane", "children": [
          {"div": {"class": "toolbar", "children": [
            {"strong": {"text": "Вывод"}},
            {"div": {"class": "status running", "visible": "$loading", "children": [
              {"i": {"class": "spinner"}},
              {"span": {"text": "компилирую и запускаю…"}}
            ]}},
            {"div": {"class": "status ok", "visible": "!$loading", "text": "готов"}},
            {"button": {"text": "Очистить", "onClick": {"set": {"output": ""}}}}
          ]}},
          {"div": {"class": "output", "bind": "output"}}
        ]}}
      ]}}
    ]}}
  ]
}
