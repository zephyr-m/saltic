use core

skill include(symbol, options) {
    (symbol.present == no) { out no }
    (symbol.kind == "runtime") { out options.show_runtime }
    (symbol.kind == "saltic") {
        (core.str.len(options.prefix) == 0) { out yes }
        out core.str.starts_with(symbol.name, options.prefix)
    }
    out no
}

skill display_name(symbol) {
    @prefix = "saltic_"
    (core.str.starts_with(symbol.name, prefix) == yes) {
        out core.str.slice(symbol.name, core.str.len(prefix), core.str.len(symbol.name))
    }
    out symbol.name
}
