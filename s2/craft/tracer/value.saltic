use core
use s2.vm.state

skill raw_text(word) {
    out core.str.add("0x", state.word_hex(word))
}

skill pointer(word) {
    @address = state.word_copy(word)
    address.b0 = address.b0 - state.mod(address.b0, 8)
    out state.word_address(address)
}

skill hex_byte(value) {
    @text = core.str.at(state.HEX, value / 16)
    out core.str.add(text, core.str.at(state.HEX, state.mod(value, 16)))
}

skill string_byte(value) {
    (value == 9) { out "\\t" }
    (value == 10) { out "\\n" }
    (value == 13) { out "\\r" }
    (value == 34) { out "\\\"" }
    (value == 92) { out "\\\\" }
    (value > 31) {
        (value < 127) { out core.str.at(state.PRINTABLE, value - 32) }
    }
    out core.str.add("\\x", hex_byte(value))
}

skill string_value(machine, word) {
    @address = pointer(word)
    (address < 0) { out core.str.add(raw_text(word), " (некорректная строка)") }
    (address > machine.memory.size - 4) { out core.str.add(raw_text(word), " (строка вне памяти)") }
    @length = state.word_address(state.memory_load_word(machine.memory, address))
    (length < 0) { out core.str.add(raw_text(word), " (некорректная длина строки)") }
    (address > machine.memory.size - length - 4) { out core.str.add(raw_text(word), " (строка вне памяти)") }

    @text = "\""
    @limit = length
    (limit > 80) { limit = 80 }
    @index = 0
    drum (limit) {
        text = core.str.add(text, string_byte(state.memory_raw_load8(machine.memory, address + 4 + index)))
        index = index + 1
    }
    (length > limit) { text = core.str.add(text, "…") }
    text = core.str.add(text, "\"")
    out core.str.add(raw_text(word), core.str.add(" (", core.str.add(text, ")")))
}

skill tagged_id(word) {
    out state.word_address(word) / 8
}

skill render(machine, word) {
    @tag = state.mod(word.b0, 8)
    @raw = raw_text(word)
    (tag == 0) {
        @number = state.word_signed_number(word) / 8
        out core.str.add(raw, core.str.add(" (число ", core.str.add(core.num.text(number), ")")))
    }
    (tag == 1) {
        (state.word_equal(word, state.word_number(9)) == yes) { out core.str.add(raw, " (да)") }
        (state.word_equal(word, state.word_number(1)) == yes) { out core.str.add(raw, " (нет)") }
        out core.str.add(raw, " (ответ)")
    }
    (tag == 2) { out core.str.add(raw, " (пусто)") }
    (tag == 3) { out string_value(machine, word) }
    (tag == 4) { out core.str.add(raw, " (группа)") }
    (tag == 5) { out core.str.add(raw, " (объект)") }
    (tag == 6) { out core.str.add(raw, core.str.add(" (перечисление #", core.str.add(core.num.text(tagged_id(word)), ")"))) }
    out core.str.add(raw, core.str.add(" (ошибка #", core.str.add(core.num.text(tagged_id(word)), ")")))
}

skill registers(machine) {
    @values = []
    @index = 0
    drum (4) {
        values = core.group.add(values, render(machine, state.register(machine, index + 10)))
        index = index + 1
    }
    out values
}
