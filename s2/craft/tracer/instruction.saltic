use s2.vm.state
use s2.vm.cpu

skill is_call(instruction) {
    (instruction.rd == 1) {
        (instruction.opcode == 111) { out yes }
        (instruction.opcode == 103) { out yes }
    }
    out no
}

skill is_return(instruction) {
    (instruction.opcode == 103) {
        (instruction.rd == 0) {
            (instruction.rs1 == 1) {
                (cpu.immediate_i(instruction) == 0) { out yes }
            }
        }
    }
    out no
}

skill call_target(machine, instruction) {
    (instruction.opcode == 111) { out machine.pc + cpu.immediate_j(instruction) }
    (instruction.opcode == 103) {
        @target = state.word_add(state.register(machine, instruction.rs1), state.word_number(cpu.immediate_i(instruction)))
        target.b0 = target.b0 - state.mod(target.b0, 2)
        out state.word_address(target)
    }
    out 0 - 1
}
