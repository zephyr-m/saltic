use core
use s2.craft.tracer.model

skill indent(depth) {
    @text = ""
    @index = 0
    drum (depth) {
        text = core.str.add(text, "  ")
        index = index + 1
    }
    out text
}

skill values_text(values) {
    @text = ""
    @index = 0
    @count = core.group.count(values)
    drum (count) {
        (index > 0) { text = core.str.add(text, " ") }
        text = core.str.add(text, core.str.add("a", core.num.text(index)))
        text = core.str.add(text, "=")
        text = core.str.add(text, core.group.at(values, index))
        index = index + 1
    }
    out text
}

skill event(item) {
    @space = indent(item.depth)
    (item.kind == model.EventKind.CALL) {
        core.io.show(space, item.sequence, " → ", item.name, " pc=0x", item.pc)
        (core.group.count(item.values) > 0) {
            core.io.show(space, "    ", values_text(item.values))
        }
        out none
    }
    core.io.show(space, item.sequence, " ← ", item.name, " = ", item.result, " pc=0x", item.pc)
    out none
}

skill start(path, symbol_count, options) {
    core.io.show("трассировка: ", path)
    core.io.show("символов: ", symbol_count, ", лимит событий: ", options.event_limit, ", лимит инструкций: ", options.step_limit)
    out none
}

skill finish(result) {
    core.io.show("событий: ", result.events, ", инструкций: ", result.steps)
    (result.completed == yes) {
        core.io.show("программа завершилась с кодом ", result.exit_code)
    }
    (core.str.len(result.diagnostic) > 0) {
        core.io.show("остановка: ", result.diagnostic)
    }
    out none
}
