use core
use s2.compiler.state
use s2.compiler.codegen
use s2.compiler.runtime

skill compiler_compile(ast) {
    @compiler = state.CompilerState { ast = ast }
    compiler = state.compiler_collect_top_level(compiler)
    compiler = state.compiler_header(compiler)
    compiler = state.compiler_start(compiler)
    compiler = codegen.compiler_compile_functions(compiler)
    compiler = state.compiler_emit(compiler, runtime.compiler_runtime_assembly())
    compiler = state.compiler_finish_data(compiler)
    out state.compiler_render_lines(compiler.lines)
}

program() {
    core.io.show("библиотека компилятора")
    out none
}
