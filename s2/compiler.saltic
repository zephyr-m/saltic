use core
use s2.compiler.state
use s2.compiler.codegen
use s2.compiler.runtime

skill compile(ast) {
    @compiler = state.State { ast = ast }
    compiler = state.collect_top_level(compiler)
    compiler = state.header(compiler)
    compiler = state.start(compiler)
    compiler = codegen.compile_functions(compiler)
    compiler = state.emit(compiler, runtime.assembly())
    compiler = state.finish_data(compiler)
    out state.render_lines(compiler.lines)
}

program() {
    core.io.show("библиотека компилятора")
    out none
}
