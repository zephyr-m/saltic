use core
use s2.parser.lexer

Cursor = Box {
    tokens = none
    index = 0

    skill at(offset) {
        out lexer.token_buffer_at(tokens, index + offset)
    }

    skill peek() {
        @token = at(0)
        out token
    }

    skill is(kind) {
        @token = peek()
        out token.kind == kind
    }

    skill is_at(offset, kind) {
        @token = at(offset)
        out token.kind == kind
    }

    skill next() {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = index + 1
        out cursor
    }

    skill move(count) {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = index + count
        out cursor
    }
}

Parser = Box {
    tokens = none
    path = ""
    locations = no

    skill at(index) {
        out lexer.token_buffer_at(tokens, index)
    }

    skill is(index, kind) {
        @token = at(index)
        out token.kind == kind
    }

    skill skip_lines(index) {
        @next = index
        @count = lexer.token_buffer_count(tokens)
        drum (count) {
            (next == count) { out next }
            (is(next, lexer.TokenKind.NEWLINE) == no) { out next }
            next = next + 1
        }
        out next
    }

    skill fail(index, message) {
        @token = at(index)
        @tail = core.str.add(message, ", получен ")
        tail = core.str.add(tail, token.kind)
        out Read {
            node = make_node("", [])
            next = index
            diagnostics = group1(diagnostic(path, token.line, token.col, tail))
        }
    }

    skill expect(index, kind, message) {
        @token = at(index)
        (is(index, kind) == yes) { out ok("token", group1(token.value), index + 1) }
        out fail(index, message)
    }

    skill field_item(start, item_message) {
        (is(start, lexer.TokenKind.IDENT) == no) { out fail(start, item_message) }
        @name_token = at(start)
        @eq = expect(start + 1, lexer.TokenKind.ASSIGN, "ожидался = после имени поля")
        (has_diagnostics(eq.diagnostics) == yes) { out eq }
        @value = expression(eq.next)
        (has_diagnostics(value.diagnostics) == yes) { out value }
        out ok("field", group3("field", name_token.value, value.node.datum), value.next)
    }

    skill sequence_item(start, item_kind, item_message) {
        (item_kind == "name") {
            (is(start, lexer.TokenKind.IDENT) == no) { out fail(start, item_message) }
            @token = at(start)
            out ok("name", token.value, start + 1)
        }
        (item_kind == "expression") {
            @value = expression(start)
            (has_diagnostics(value.diagnostics) == yes) { out value }
            out ok("expression", value.node.datum, value.next)
        }
        (item_kind == "field") { out field_item(start, item_message) }
        (item_kind == "member") {
            (is(start, lexer.TokenKind.SKILL) == yes) {
                @member_skill = subject_skill(start)
                (has_diagnostics(member_skill.diagnostics) == yes) { out member_skill }
                out ok("member", member_skill.node.datum, member_skill.next)
            }
            out field_item(start, item_message)
        }
        (item_kind == "statement") {
            @value = statement(start)
            (has_diagnostics(value.diagnostics) == yes) { out value }
            out ok("statement", value.node.datum, value.next)
        }
        out fail(start, item_message)
    }

    skill sequence(start, end_kind, item_kind, item_message, eof_message, require_separator, allow_comma) {
        @items = []
        @next = skip_lines(start)
        @done = no
        @diagnostics = []
        @count = lexer.token_buffer_count(tokens)
        drum (count) {
            (done == no) {
                (is(next, end_kind) == yes) {
                    next = next + 1
                    done = yes
                }
                (done == no) {
                    (is(next, lexer.TokenKind.EOF) == yes) {
                        @failure = fail(next, eof_message)
                        diagnostics = failure.diagnostics
                        done = yes
                    }
                }
                (done == no) {
                    @item = sequence_item(next, item_kind, item_message)
                    (has_diagnostics(item.diagnostics) == yes) { diagnostics = item.diagnostics done = yes }
                    (done == no) {
                        items = core.group.add(items, item.node.datum)
                        next = item.next
                        @separated = no
                        (allow_comma == yes) {
                            (is(next, lexer.TokenKind.COMMA) == yes) {
                                next = next + 1
                                separated = yes
                            }
                        }
                        @before_lines = next
                        next = skip_lines(next)
                        (next > before_lines) { separated = yes }
                        (is(next, end_kind) == no) {
                            (require_separator == yes) {
                                (separated == no) {
                                    @separator_failure = fail(next, "ожидался разделитель")
                                    diagnostics = separator_failure.diagnostics
                                    done = yes
                                }
                            }
                        }
                    }
                }
            }
            (done == yes) { out Read { node = make_node("sequence", items) next = next diagnostics = diagnostics } }
        }
        out Read { node = make_node("sequence", items) next = next diagnostics = diagnostics }
    }

    skill names(start, end_kind, item_message) {
        @items = sequence(start, end_kind, "name", item_message, item_message, yes, yes)
        out Read { node = make_node("names", items.node.datum) next = items.next diagnostics = items.diagnostics }
    }

    skill params(start) {
        @parsed_names = names(start, lexer.TokenKind.RPAREN, "ожидалось имя параметра")
        out Read { node = make_node("params", parsed_names.node.datum) next = parsed_names.next diagnostics = parsed_names.diagnostics }
    }

    skill module(start) {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = start
        @token = cursor.peek()
        cursor = cursor.next()
        @module = path_at(cursor.index, no)
        (has_diagnostics(module.diagnostics) == yes) { out module }
        @parts = module.node.datum
        @datum = group1("use")
        datum = append_tail(datum, parts, 1)
        out ok("use", loc(datum, token, locations), module.next)
    }

    skill constant(start) {
        @token = at(start)
        @value = expression(start + 2)
        (has_diagnostics(value.diagnostics) == yes) { out value }
        out ok("const", loc(group3("const", token.value, value.node.datum), token, locations), value.next)
    }

    skill entry(start) {
        @token = at(start)
        @open = expect(start + 1, lexer.TokenKind.LPAREN, "ожидалась ( после program")
        (has_diagnostics(open.diagnostics) == yes) { out open }
        @params = params(open.next)
        (has_diagnostics(params.diagnostics) == yes) { out params }
        @body = block(params.next)
        (has_diagnostics(body.diagnostics) == yes) { out body }
        out ok("entry", loc(group3("entry", params.node.datum, body.node.datum), token, locations), body.next)
    }

    skill named_skill(start) {
        @token = at(start)
        (is(start + 1, lexer.TokenKind.IDENT) == no) { out fail(start + 1, "ожидалось имя skill") }
        @name_token = at(start + 1)
        @name = name_token.value
        @open = expect(start + 2, lexer.TokenKind.LPAREN, "ожидалась (")
        (has_diagnostics(open.diagnostics) == yes) { out open }
        @params = params(open.next)
        (has_diagnostics(params.diagnostics) == yes) { out params }
        @body = block(params.next)
        (has_diagnostics(body.diagnostics) == yes) { out body }
        out ok("skill", loc(group4("skill", name, params.node.datum, body.node.datum), token, locations), body.next)
    }

    skill subject_skill(start) {
        @token = at(start)
        (is(start + 1, lexer.TokenKind.IDENT) == no) { out fail(start + 1, "ожидалось имя skill") }
        @name_token = at(start + 1)
        @open = expect(start + 2, lexer.TokenKind.LPAREN, "ожидалась (")
        (has_diagnostics(open.diagnostics) == yes) { out open }
        @params = params(open.next)
        (has_diagnostics(params.diagnostics) == yes) { out params }
        @body = block(params.next)
        (has_diagnostics(body.diagnostics) == yes) { out body }
        out ok("subject-skill", loc(group4("subject-skill", name_token.value, params.node.datum, body.node.datum), token, locations), body.next)
    }

    skill box_members(start) {
        @open = expect(start, lexer.TokenKind.LBRACE, "ожидалась {")
        (has_diagnostics(open.diagnostics) == yes) { out open }
        @members = sequence(open.next, lexer.TokenKind.RBRACE, "member", "ожидалось поле или skill", "ожидалась }", no, yes)
        out Read { node = make_node("box-members", members.node.datum) next = members.next diagnostics = members.diagnostics }
    }

    skill enumeration(start) {
        @token = at(start)
        @open = expect(start + 3, lexer.TokenKind.LBRACE, "ожидалась {")
        (has_diagnostics(open.diagnostics) == yes) { out open }
        @datum = group2("enum", token.value)
        @variants = names(open.next, lexer.TokenKind.RBRACE, "ожидался вариант enum")
        (has_diagnostics(variants.diagnostics) == yes) { out variants }
        datum = append_tail(datum, variants.node.datum, 0)
        out ok("enum", loc(datum, token, locations), variants.next)
    }

    skill box(start) {
        @token = at(start)
        @members = box_members(start + 3)
        (has_diagnostics(members.diagnostics) == yes) { out members }
        @datum = group2("box", token.value)
        datum = append_tail(datum, members.node.datum, 0)
        out ok("box", loc(datum, token, locations), members.next)
    }

    skill top(start) {
        @token = at(start)
        (token.kind == lexer.TokenKind.USE) { out module(start) }
        (token.kind == lexer.TokenKind.PROGRAM) { out entry(start) }
        (token.kind == lexer.TokenKind.SKILL) { out named_skill(start) }
        (token.kind == lexer.TokenKind.IDENT) {
            (is(start + 1, lexer.TokenKind.ASSIGN) == yes) {
                (is(start + 2, lexer.TokenKind.BOX) == yes) { out box(start) }
                (is(start + 2, lexer.TokenKind.ENUM) == yes) { out enumeration(start) }
                out constant(start)
            }
        }
        out fail(start, "ожидалось объявление верхнего уровня")
    }

    skill parse_tokens() {
        @ast = group1("program")
        @next = skip_lines(0)
        @diagnostics = []
        @done = no
        @count = lexer.token_buffer_count(tokens)
        drum (count) {
            (done == no) {
                (is(next, lexer.TokenKind.EOF) == yes) { done = yes }
                (done == no) {
                    @item = top(next)
                    (has_diagnostics(item.diagnostics) == yes) { diagnostics = item.diagnostics done = yes }
                    (done == no) { ast = core.group.add(ast, item.node.datum) next = skip_lines(item.next) }
                }
            }
            (done == yes) { out Parse { ast = ast tokens = tokens diagnostics = diagnostics } }
        }
        out Parse { ast = ast tokens = tokens diagnostics = diagnostics }
    }

    skill path_at(start, with_locations) {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = start
        (cursor.is(lexer.TokenKind.IDENT) == no) { out fail(cursor.index, "ожидался идентификатор") }
        @token = cursor.peek()
        @parts = group2("path", token.value)
        cursor = cursor.next()
        @count = lexer.token_buffer_count(tokens)
        @active = yes
        drum (count) {
            (active == yes) {
                (cursor.index + 1 < count) {
                    (cursor.is(lexer.TokenKind.DOT) == yes) {
                        @has_part = cursor.is_at(1, lexer.TokenKind.IDENT)
                        (has_part == yes) {
                            @part_token = cursor.at(1)
                            parts = core.group.add(parts, part_token.value)
                            cursor = cursor.move(2)
                        }
                        (has_part == no) { active = no }
                    }
                    (cursor.is(lexer.TokenKind.DOT) == no) { active = no }
                }
                (cursor.index + 1 == count) { active = no }
            }
            (active == no) { out ok("path", loc(parts, token, with_locations), cursor.index) }
        }
        out ok("path", loc(parts, token, with_locations), cursor.index)
    }

    skill expressions(start, end_kind) {
        @items = sequence(start, end_kind, "expression", "ожидалось выражение", "ожидался закрывающий токен", no, yes)
        out Read { node = make_node("expressions", items.node.datum) next = items.next diagnostics = items.diagnostics }
    }

    skill primary(start) {
        @token = at(start)
        (token.kind == lexer.TokenKind.NUMBER) {
            (number_is_wide(token.value) == yes) { out ok("wide-number", loc(group2("wide-number", token.value), token, locations), start + 1) }
            out ok("number", loc(group2("number", number_value(token.value)), token, locations), start + 1)
        }
        (token.kind == lexer.TokenKind.STRING) { out ok("string", loc(group2("string", token.value), token, locations), start + 1) }
        (token.kind == lexer.TokenKind.YES) { out ok("answer", loc(group2("answer", "yes"), token, locations), start + 1) }
        (token.kind == lexer.TokenKind.NO) { out ok("answer", loc(group2("answer", "no"), token, locations), start + 1) }
        (token.kind == lexer.TokenKind.NONE) { out ok("none", loc(group1("none"), token, locations), start + 1) }
        (token.kind == lexer.TokenKind.DOT) {
            (is(start + 1, lexer.TokenKind.IDENT) == no) { out fail(start + 1, "ожидалось значение enum") }
            @name_token = at(start + 1)
            out ok("enum-value", loc(group2("enum-value", name_token.value), token, locations), start + 2)
        }
        (token.kind == lexer.TokenKind.LBRACKET) { out group(start) }
        (token.kind == lexer.TokenKind.IDENT) { out path_at(start, locations) }
        (token.kind == lexer.TokenKind.LPAREN) {
            @inside = expression(start + 1)
            (has_diagnostics(inside.diagnostics) == yes) { out inside }
            @close = expect(inside.next, lexer.TokenKind.RPAREN, "ожидалась )")
            (has_diagnostics(close.diagnostics) == yes) { out close }
            out Read { node = inside.node next = close.next diagnostics = [] }
        }
        out fail(start, "ожидалось выражение")
    }

    skill args(start) {
        @expressions = expressions(start + 1, lexer.TokenKind.RPAREN)
        out Read { node = make_node("args", expressions.node.datum) next = expressions.next diagnostics = expressions.diagnostics }
    }

    skill fields(start) {
        @open = expect(start, lexer.TokenKind.LBRACE, "ожидалась {")
        (has_diagnostics(open.diagnostics) == yes) { out open }
        @fields = sequence(open.next, lexer.TokenKind.RBRACE, "field", "ожидалось имя поля", "ожидалась }", no, yes)
        out Read { node = make_node("fields", fields.node.datum) next = fields.next diagnostics = fields.diagnostics }
    }

    skill postfix(start) {
        @base = primary(start)
        (has_diagnostics(base.diagnostics) == yes) { out base }
        @node = base.node
        @next = base.next
        @active = yes
        @diagnostics = []
        @count = lexer.token_buffer_count(tokens)
        drum (count) {
            (active == yes) {
                (is(next, lexer.TokenKind.LPAREN) == yes) {
                    @call_token = at(next)
                    @args = args(next)
                    (has_diagnostics(args.diagnostics) == yes) { diagnostics = args.diagnostics active = no }
                    (has_diagnostics(args.diagnostics) == no) {
                        @call = group2("call", node.datum)
                        call = append_tail(call, args.node.datum, 0)
                        node = make_node("call", loc(call, call_token, locations))
                        next = args.next
                    }
                }
                (is(next, lexer.TokenKind.LPAREN) == no) {
                    @box_candidate = no
                    (node.tag == "path") {
                        @plain_path = node.datum
                        (locations == yes) { plain_path = core.group.item(node.datum, 3) }
                        (is(next, lexer.TokenKind.LBRACE) == yes) { box_candidate = yes }
                    }
                    (box_candidate == yes) {
                        @box_token = at(next)
                        @fields = fields(next)
                        (has_diagnostics(fields.diagnostics) == yes) { diagnostics = fields.diagnostics active = no }
                        (has_diagnostics(fields.diagnostics) == no) {
                            @plain_name = node.datum
                            (locations == yes) { plain_name = core.group.item(node.datum, 3) }
                            @box_name = core.group.item(plain_name, 1)
                            @name_index = 2
                            @name_count = core.group.count(plain_name)
                            drum (name_count) {
                                (name_index < name_count) { box_name = core.str.add(box_name, core.str.add(".", core.group.item(plain_name, name_index))) name_index = name_index + 1 }
                            }
                            @box = group2("box-new", box_name)
                            box = append_tail(box, fields.node.datum, 0)
                            node = make_node("box-new", loc(box, box_token, locations))
                            next = fields.next
                        }
                    }
                    (box_candidate == no) { active = no }
                }
            }
            (active == no) { out Read { node = node next = next diagnostics = diagnostics } }
        }
        out Read { node = node next = next diagnostics = diagnostics }
    }

    skill precedence(kind) {
        (kind == lexer.TokenKind.EQ) { out 1 }
        (kind == lexer.TokenKind.GT) { out 1 }
        (kind == lexer.TokenKind.LT) { out 1 }
        (kind == lexer.TokenKind.PLUS) { out 2 }
        (kind == lexer.TokenKind.MINUS) { out 2 }
        (kind == lexer.TokenKind.STAR) { out 3 }
        (kind == lexer.TokenKind.SLASH) { out 3 }
        out 0
    }

    skill binary(start, minimum) {
        @first = postfix(start)
        (has_diagnostics(first.diagnostics) == yes) { out first }
        @left = first.node
        @next = first.next
        @active = yes
        @diagnostics = []
        @count = lexer.token_buffer_count(tokens)
        drum (count) {
            (active == yes) {
                @operator = at(next)
                @level = precedence(operator.kind)
                (level < minimum) { active = no }
                (level == 0) { active = no }
                (active == yes) {
                    @right = binary(next + 1, level + 1)
                    (has_diagnostics(right.diagnostics) == yes) { diagnostics = right.diagnostics active = no }
                    (has_diagnostics(right.diagnostics) == no) {
                        left = make_node("binary", loc(group4("binary", operator.value, left.datum, right.node.datum), operator, locations))
                        next = right.next
                    }
                }
            }
            (active == no) { out Read { node = left next = next diagnostics = diagnostics } }
        }
        out Read { node = left next = next diagnostics = diagnostics }
    }

    skill expression(start) {
        @value = binary(start, 0)
        (has_diagnostics(value.diagnostics) == yes) { out value }
        (is(value.next, lexer.TokenKind.RESCUE) == yes) {
            @rescue_token = at(value.next)
            @pipe = expect(value.next + 1, lexer.TokenKind.PIPE, "ожидался |")
            (has_diagnostics(pipe.diagnostics) == yes) { out pipe }
            (is(pipe.next, lexer.TokenKind.IDENT) == no) { out fail(pipe.next, "ожидалось имя ошибки rescue") }
            @error_token = at(pipe.next)
            @error_name = error_token.value
            @pipe2 = expect(pipe.next + 1, lexer.TokenKind.PIPE, "ожидался |")
            (has_diagnostics(pipe2.diagnostics) == yes) { out pipe2 }
            @body = block(pipe2.next)
            (has_diagnostics(body.diagnostics) == yes) { out body }
            out ok("rescue", loc(group4("rescue", value.node.datum, error_name, body.node.datum), rescue_token, locations), body.next)
        }
        out value
    }

    skill group(start) {
        @token = at(start)
        @expressions = expressions(start + 1, lexer.TokenKind.RBRACKET)
        (has_diagnostics(expressions.diagnostics) == yes) { out expressions }
        @items = group1("group")
        items = append_tail(items, expressions.node.datum, 0)
        out ok("group", loc(items, token, locations), expressions.next)
    }

    skill block(start) {
        @token = at(start)
        @open = expect(start, lexer.TokenKind.LBRACE, "ожидалась {")
        (has_diagnostics(open.diagnostics) == yes) { out open }
        @statements = sequence(open.next, lexer.TokenKind.RBRACE, "statement", "ожидалась инструкция", "ожидалась }", no, no)
        @items = group1("block")
        items = append_tail(items, statements.node.datum, 0)
        out Read { node = make_node("block", loc(items, token, locations)) next = statements.next diagnostics = statements.diagnostics }
    }

    skill variable(start) {
        @token = at(start)
        (is(start + 1, lexer.TokenKind.IDENT) == no) { out fail(start + 1, "ожидалось имя переменной") }
        @name_token = at(start + 1)
        @name = name_token.value
        @eq = expect(start + 2, lexer.TokenKind.ASSIGN, "ожидался = после имени переменной")
        (has_diagnostics(eq.diagnostics) == yes) { out eq }
        @value = expression(eq.next)
        (has_diagnostics(value.diagnostics) == yes) { out value }
        out ok("var", loc(group3("var", name, value.node.datum), token, locations), value.next)
    }

    skill assign(start) {
        @token = at(start)
        @value = expression(start + 2)
        (has_diagnostics(value.diagnostics) == yes) { out value }
        out ok("assign", loc(group3("assign", token.value, value.node.datum), token, locations), value.next)
    }

    skill field_assign(start) {
        @token = at(start)
        @target = path_at(start, locations)
        (has_diagnostics(target.diagnostics) == yes) { out target }
        @eq = expect(target.next, lexer.TokenKind.ASSIGN, "ожидался =")
        (has_diagnostics(eq.diagnostics) == yes) { out eq }
        @value = expression(eq.next)
        (has_diagnostics(value.diagnostics) == yes) { out value }
        out ok("field-assign", loc(group3("field-assign", target.node.datum, value.node.datum), token, locations), value.next)
    }

    skill out_statement(start) {
        @token = at(start)
        @value = expression(start + 1)
        (has_diagnostics(value.diagnostics) == yes) { out value }
        out ok("out", loc(group2("out", value.node.datum), token, locations), value.next)
    }

    skill drum_statement(start) {
        @token = at(start)
        @open = expect(start + 1, lexer.TokenKind.LPAREN, "ожидалась ( после drum")
        (has_diagnostics(open.diagnostics) == yes) { out open }
        @count = expression(open.next)
        (has_diagnostics(count.diagnostics) == yes) { out count }
        @close = expect(count.next, lexer.TokenKind.RPAREN, "ожидалась )")
        (has_diagnostics(close.diagnostics) == yes) { out close }
        @body = block(close.next)
        (has_diagnostics(body.diagnostics) == yes) { out body }
        out ok("drum", loc(group3("drum", count.node.datum, body.node.datum), token, locations), body.next)
    }

    skill paren_statement(start) {
        @token = at(start)
        @value = expression(start + 1)
        (has_diagnostics(value.diagnostics) == yes) { out value }
        @close = expect(value.next, lexer.TokenKind.RPAREN, "ожидалась )")
        (has_diagnostics(close.diagnostics) == yes) { out close }
        @open = expect(close.next, lexer.TokenKind.LBRACE, "ожидалась {")
        (has_diagnostics(open.diagnostics) == yes) { out open }
        @next = skip_lines(open.next)
        (is(next, lexer.TokenKind.DOT) == yes) {
            @cases = group2("switch", value.node.datum)
            @done = no
            @diagnostics = []
            @count = lexer.token_buffer_count(tokens)
            drum (count) {
                (done == no) {
                    (is(next, lexer.TokenKind.RBRACE) == yes) { next = next + 1 done = yes }
                    (done == no) {
                        @case_token = at(next)
                        @dot = expect(next, lexer.TokenKind.DOT, "ожидалась .")
                        (has_diagnostics(dot.diagnostics) == yes) { diagnostics = dot.diagnostics done = yes }
                        (done == no) {
                            (is(dot.next, lexer.TokenKind.IDENT) == no) { @failure = fail(dot.next, "ожидалась метка ветки выбора") diagnostics = failure.diagnostics done = yes }
                        }
                        (done == no) {
                            @tag_token = at(dot.next)
                            @tag = tag_token.value
                            @arrow = expect(dot.next + 1, lexer.TokenKind.ARROW, "ожидался =>")
                            (has_diagnostics(arrow.diagnostics) == yes) { diagnostics = arrow.diagnostics done = yes }
                            (done == no) {
                                @body = expression(arrow.next)
                                (has_diagnostics(body.diagnostics) == yes) { diagnostics = body.diagnostics done = yes }
                                (done == no) {
                                    cases = core.group.add(cases, loc(group3("case", tag, body.node.datum), case_token, locations))
                                    next = body.next
                                    (is(next, lexer.TokenKind.COMMA) == yes) { next = next + 1 }
                                    next = skip_lines(next)
                                }
                            }
                        }
                    }
                }
                (done == yes) { out Read { node = make_node("switch", loc(cases, token, locations)) next = next diagnostics = diagnostics } }
            }
            out Read { node = make_node("switch", loc(cases, token, locations)) next = next diagnostics = diagnostics }
        }
        @statements = sequence(next, lexer.TokenKind.RBRACE, "statement", "ожидалась инструкция", "ожидалась }", no, no)
        @items = group1("block")
        items = append_tail(items, statements.node.datum, 0)
        @located_body = loc(items, token, locations)
        out Read { node = make_node("if", loc(group3("if", value.node.datum, located_body), token, locations)) next = statements.next diagnostics = statements.diagnostics }
    }

    skill statement(start) {
        @token = at(start)
        (token.kind == lexer.TokenKind.AT) { out variable(start) }
        (token.kind == lexer.TokenKind.OUT) { out out_statement(start) }
        (token.kind == lexer.TokenKind.DRUM) { out drum_statement(start) }
        (token.kind == lexer.TokenKind.LPAREN) { out paren_statement(start) }
        (token.kind == lexer.TokenKind.IDENT) {
            (is(start + 1, lexer.TokenKind.ASSIGN) == yes) { out assign(start) }
            @target = path_at(start, no)
            (is(target.next, lexer.TokenKind.ASSIGN) == yes) { out field_assign(start) }
        }
        @expression = expression(start)
        (has_diagnostics(expression.diagnostics) == yes) { out expression }
        out ok("expr", group2("expr", expression.node.datum), expression.next)
    }

}

Node = Box {
    datum = []
    tag = ""
}

Read = Box {
    node = Node {}
    next = 0
    diagnostics = []
}

Parse = Box {
    ast = []
    tokens = none
    diagnostics = []
}

skill group1(a) {
    out core.group.add([], a)
}

skill group2(a, b) {
    out core.group.add(group1(a), b)
}

skill group3(a, b, c) {
    out core.group.add(group2(a, b), c)
}

skill group4(a, b, c, d) {
    out core.group.add(group3(a, b, c), d)
}

skill diagnostic(path, line, col, message) {
    @where = core.str.add(path, ":")
    where = core.str.add(where, core.num.text(line))
    where = core.str.add(where, ":")
    where = core.str.add(where, core.num.text(col))
    where = core.str.add(where, ": ")
    out core.str.add(where, message)
}

skill has_diagnostics(diagnostics) {
    out core.group.count(diagnostics) > 0
}

skill is_digit(ch) {
    out core.str.contains("0123456789", ch)
}

skill digit_value(ch) {
    (ch == "0") { out 0 }
    (ch == "1") { out 1 }
    (ch == "2") { out 2 }
    (ch == "3") { out 3 }
    (ch == "4") { out 4 }
    (ch == "5") { out 5 }
    (ch == "6") { out 6 }
    (ch == "7") { out 7 }
    (ch == "8") { out 8 }
    out 9
}

skill number_value(text) {
    @whole = 0
    @fraction = 0
    @scale = 1
    @after_dot = no
    @index = 0
    @length = core.str.len(text)
    drum (length) {
        (index < length) {
            @ch = core.str.at(text, index)
            (ch == ".") { after_dot = yes }
            (is_digit(ch) == yes) {
                (after_dot == no) { whole = whole * 10 + digit_value(ch) }
                (after_dot == yes) { fraction = fraction * 10 + digit_value(ch) scale = scale * 10 }
            }
            index = index + 1
        }
    }
    out whole + fraction / scale
}

skill number_is_wide(text) {
    (core.str.contains(text, ".") == yes) { out no }
    @length = core.str.len(text)
    (length > 9) { out yes }
    (length < 9) { out no }
    @limit = "268435455"
    @index = 0
    drum (9) {
        @actual = digit_value(core.str.at(text, index))
        @maximum = digit_value(core.str.at(limit, index))
        (actual > maximum) { out yes }
        (actual < maximum) { out no }
        index = index + 1
    }
    out no
}

skill lex(source, path) {
    out lexer.lex(source, path)
}

skill loc(datum, token, locations) {
    (locations == yes) { out group4("loc", token.line, token.col, datum) }
    out datum
}

skill make_node(tag, datum) {
    out Node { datum = datum tag = tag }
}

skill ok(tag, datum, next) {
    out Read { node = make_node(tag, datum) next = next diagnostics = [] }
}

skill append_tail(head, tail, start) {
    @result = head
    @cursor = start
    @count = core.group.count(tail)
    drum (count) {
        (cursor < count) { result = core.group.add(result, core.group.item(tail, cursor)) cursor = cursor + 1 }
    }
    out result
}

skill parse_tokens_mode(tokens, path, locations) {
    @parser = Parser()
    parser.tokens = tokens
    parser.path = path
    parser.locations = locations
    out parser.parse_tokens()
}

skill parse_tokens(tokens, path) {
    out parse_tokens_mode(tokens, path, no)
}

skill parse_tokens_loc(tokens, path) {
    out parse_tokens_mode(tokens, path, yes)
}

skill parse_string(source, path) {
    @scan = lex(source, path)
    (has_diagnostics(scan.diagnostics) == yes) { out Parse { ast = [] tokens = scan.tokens diagnostics = scan.diagnostics } }
    out parse_tokens(scan.tokens, path)
}

skill parse_string_loc(source, path) {
    @scan = lex(source, path)
    (has_diagnostics(scan.diagnostics) == yes) { out Parse { ast = [] tokens = scan.tokens diagnostics = scan.diagnostics } }
    out parse_tokens_loc(scan.tokens, path)
}

skill ast_datum(source, path) {
    @parsed = parse_string(source, path)
    out parsed.ast
}

skill ast_datum_loc(source, path) {
    @parsed = parse_string_loc(source, path)
    out parsed.ast
}
