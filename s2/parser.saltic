use core
use s2.parser.syntax
use s2.parser.loader

skill parser_lex(source, path) {
    out syntax.parser_lex(source, path)
}

skill parser_parse_tokens_mode(tokens, path, locations) {
    out syntax.parser_parse_tokens_mode(tokens, path, locations)
}

skill parser_parse_tokens(tokens, path) {
    out syntax.parser_parse_tokens(tokens, path)
}

skill parser_parse_tokens_loc(tokens, path) {
    out syntax.parser_parse_tokens_loc(tokens, path)
}

skill parser_parse_string(source, path) {
    out syntax.parser_parse_string(source, path)
}

skill parser_parse_string_loc(source, path) {
    out syntax.parser_parse_string_loc(source, path)
}

skill parser_ast_datum(source, path) {
    out syntax.parser_ast_datum(source, path)
}

skill parser_ast_datum_loc(source, path) {
    out syntax.parser_ast_datum_loc(source, path)
}

skill parser_load_file(path, root) {
    out loader.parser_load_file(path, root)
}

skill parser_load_file_loc(path, root) {
    out loader.parser_load_file_loc(path, root)
}

skill parser_load_modules(path, root) {
    out loader.parser_load_modules(path, root)
}

program(path) {
    @parsed = parser_load_file(path, ".")
    @diagnostic_count = core.group.count(parsed.diagnostics)

    core.io.show("ast items: ", core.group.count(parsed.ast))
    core.io.show("diagnostics: ", diagnostic_count)

    (diagnostic_count > 0) {
        out error.ParseFailed
    }

    out none
}
