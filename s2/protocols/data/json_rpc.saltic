use core
use s2.protocols.data.json
use s2.protocols.data.json.text
use s2.protocols.data.json.value

MessageKind = enum {
    INVALID,
    REQUEST,
    NOTIFICATION,
    SUCCESS,
    FAILURE,
}

PARSE_ERROR = "-32700"
INVALID_REQUEST = "-32600"
METHOD_NOT_FOUND = "-32601"
INVALID_PARAMS = "-32602"
INTERNAL_ERROR = "-32603"

Message = Box {
    kind = MessageKind.INVALID
    method = json.Text {}
    params = json.Value {}
    has_params = no
    id = json.Value {}
    has_id = no
    result = json.Value {}
    error_code = INVALID_REQUEST
    error_message = json.Text {}
    error_data = json.Value {}
    has_error_data = no
    diagnostic = ""
}

Packet = Box {
    ok = no
    batch = no
    messages = []
    diagnostic = ""
}

skill rpc_text(source) {
    @read = text.read(source)
    out read.text
}

skill invalid(code, message, diagnostic) {
    out Message {
        kind = MessageKind.INVALID
        id = value.null_value()
        has_id = yes
        error_code = code
        error_message = rpc_text(message)
        diagnostic = diagnostic
    }
}

skill parse_error(diagnostic) {
    out invalid(PARSE_ERROR, "Ошибка разбора", diagnostic)
}

skill invalid_request(diagnostic) {
    out invalid(INVALID_REQUEST, "Некорректный запрос", diagnostic)
}

skill request(method, id) {
    out Message {
        kind = MessageKind.REQUEST
        method = rpc_text(method)
        id = id
        has_id = yes
    }
}

skill request_with_params(method, params, id) {
    out Message {
        kind = MessageKind.REQUEST
        method = rpc_text(method)
        params = params
        has_params = yes
        id = id
        has_id = yes
    }
}

skill notification(method) {
    out Message {
        kind = MessageKind.NOTIFICATION
        method = rpc_text(method)
    }
}

skill notification_with_params(method, params) {
    out Message {
        kind = MessageKind.NOTIFICATION
        method = rpc_text(method)
        params = params
        has_params = yes
    }
}

skill success(id, result) {
    out Message {
        kind = MessageKind.SUCCESS
        id = id
        has_id = yes
        result = result
    }
}

skill failure_text(id, code, message) {
    out Message {
        kind = MessageKind.FAILURE
        id = id
        has_id = yes
        error_code = code
        error_message = rpc_text(message)
    }
}

skill failure(id, code, message) {
    out failure_text(id, core.num.text(code), message)
}

skill failure_with_data(id, code, message, data) {
    out Message {
        kind = MessageKind.FAILURE
        id = id
        has_id = yes
        error_code = core.num.text(code)
        error_message = rpc_text(message)
        error_data = data
        has_error_data = yes
    }
}

skill method_is(message, method) {
    (message.kind == MessageKind.REQUEST) { out text.equal_string(message.method, method) }
    (message.kind == MessageKind.NOTIFICATION) { out text.equal_string(message.method, method) }
    out no
}
