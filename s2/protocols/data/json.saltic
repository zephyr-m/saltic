use core

JsonKind = enum {
    NULL,
    ANSWER,
    NUMBER,
    STRING,
    ARRAY,
    OBJECT,
}

HEX = "0123456789abcdef"
ASCII = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

Text = Box {
    units = []
}

Value = Box {
    kind = JsonKind.NULL
    answer = no
    number = ""
    string = Text {}
    items = []
    members = []
}

Member = Box {
    name = Text {}
    value = Value {}
}

Parse = Box {
    ok = no
    value = Value {}
    index = 0
    message = ""
}

TextRead = Box {
    ok = no
    text = Text {}
    index = 0
    message = ""
}

CodepointRead = Box {
    ok = no
    value = 0
    index = 0
    message = ""
}

Lookup = Box {
    found = no
    value = Value {}
}
