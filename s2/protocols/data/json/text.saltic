use core
use s2.protocols.data.json

skill add(subject, unit) {
    out json.Text { units = core.group.add(subject.units, unit) }
}

skill count(subject) {
    out core.group.count(subject.units)
}

skill at(subject, index) {
    out core.group.item(subject.units, index)
}

skill continuation(byte) {
    (byte > 127) {
        (byte < 192) { out yes }
    }
    out no
}

skill codepoint_failure(index, message) {
    out json.CodepointRead { index = index message = message }
}

skill read_utf8(source, index) {
    @length = core.str.len(source)
    (index > length - 1) { out codepoint_failure(index, "неожиданный конец текста UTF-8") }

    @first = core.str.byte(source, index)
    (first < 128) { out json.CodepointRead { ok = yes value = first index = index + 1 } }

    (first > 193) {
        (first < 224) {
            (index + 1 > length - 1) { out codepoint_failure(index, "неполная двухбайтовая последовательность UTF-8") }
            @second = core.str.byte(source, index + 1)
            (continuation(second) == no) { out codepoint_failure(index, "некорректный байт продолжения UTF-8") }
            @value = (first - 192) * 64 + second - 128
            out json.CodepointRead { ok = yes value = value index = index + 2 }
        }
    }

    (first > 223) {
        (first < 240) {
            (index + 2 > length - 1) { out codepoint_failure(index, "неполная трёхбайтовая последовательность UTF-8") }
            @second = core.str.byte(source, index + 1)
            @third = core.str.byte(source, index + 2)
            (continuation(second) == no) { out codepoint_failure(index, "некорректный байт продолжения UTF-8") }
            (continuation(third) == no) { out codepoint_failure(index, "некорректный байт продолжения UTF-8") }
            @value = (first - 224) * 4096 + (second - 128) * 64 + third - 128
            (value < 2048) { out codepoint_failure(index, "избыточно длинная последовательность UTF-8") }
            (value > 55295) {
                (value < 57344) { out codepoint_failure(index, "последовательность UTF-8 кодирует суррогат") }
            }
            out json.CodepointRead { ok = yes value = value index = index + 3 }
        }
    }

    (first > 239) {
        (first < 245) {
            (index + 3 > length - 1) { out codepoint_failure(index, "неполная четырёхбайтовая последовательность UTF-8") }
            @second = core.str.byte(source, index + 1)
            @third = core.str.byte(source, index + 2)
            @fourth = core.str.byte(source, index + 3)
            (continuation(second) == no) { out codepoint_failure(index, "некорректный байт продолжения UTF-8") }
            (continuation(third) == no) { out codepoint_failure(index, "некорректный байт продолжения UTF-8") }
            (continuation(fourth) == no) { out codepoint_failure(index, "некорректный байт продолжения UTF-8") }
            @value = (first - 240) * 262144 + (second - 128) * 4096 + (third - 128) * 64 + fourth - 128
            (value < 65536) { out codepoint_failure(index, "избыточно длинная последовательность UTF-8") }
            (value > 1114111) { out codepoint_failure(index, "кодовая точка UTF-8 находится вне диапазона") }
            out json.CodepointRead { ok = yes value = value index = index + 4 }
        }
    }

    out codepoint_failure(index, "некорректный начальный байт UTF-8")
}

skill read_failure(index, message) {
    out json.TextRead { index = index message = message }
}

skill read(source) {
    @subject = json.Text {}
    @index = 0
    @length = core.str.len(source)
    @active = yes
    drum (length + 1) {
        (active == yes) {
            (index < length) {
                @unit = read_utf8(source, index)
                (unit.ok == no) { out read_failure(unit.index, unit.message) }
                subject = add(subject, unit.value)
                index = unit.index
            }
            (index == length) { active = no }
        }
    }
    out json.TextRead { ok = yes text = subject index = index }
}

skill equal(left, right) {
    @size = count(left)
    (size == count(right)) {
        @same = yes
        @index = 0
        drum (size) {
            (index < size) {
                @unit_equal = at(left, index) == at(right, index)
                (unit_equal == yes) { index = index + 1 }
                (unit_equal == no) { same = no index = size }
            }
        }
        out same
    }
    out no
}

skill equal_string(left, right) {
    @read = read(right)
    (read.ok == no) { out no }
    out equal(left, read.text)
}
