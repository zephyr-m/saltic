use core
use s2.protocols.data.json
use s2.protocols.data.json.text

skill null_value() {
    out json.Value {}
}

skill answer_value(answer) {
    out json.Value { kind = json.JsonKind.ANSWER answer = answer }
}

skill number_value(number) {
    out json.Value { kind = json.JsonKind.NUMBER number = number }
}

skill number(number) {
    out number_value(core.num.text(number))
}

skill string_text(subject) {
    out json.Value { kind = json.JsonKind.STRING string = subject }
}

skill string(source) {
    @read = text.read(source)
    out string_text(read.text)
}

skill array(items) {
    out json.Value { kind = json.JsonKind.ARRAY items = items }
}

skill field_text(name, item) {
    out json.Member { name = name value = item }
}

skill field(name, item) {
    @read = text.read(name)
    out field_text(read.text, item)
}

skill object(members) {
    out json.Value { kind = json.JsonKind.OBJECT members = members }
}

skill is_kind(item, kind) {
    out item.kind == kind
}

skill string_equal(item, source) {
    (item.kind == json.JsonKind.STRING) { out text.equal_string(item.string, source) }
    out no
}

skill get_text(item, name) {
    (item.kind == json.JsonKind.OBJECT) {
        @index = 0
        @count = core.group.count(item.members)
        drum (count) {
            (index < count) {
                @member = core.group.item(item.members, index)
                (text.equal(member.name, name) == yes) { out json.Lookup { found = yes value = member.value } }
                index = index + 1
            }
        }
    }
    out json.Lookup {}
}

skill get(item, name) {
    @read = text.read(name)
    (read.ok == no) { out json.Lookup {} }
    out get_text(item, read.text)
}

skill has(item, name) {
    @lookup = get(item, name)
    out lookup.found
}
