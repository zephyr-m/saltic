use core
use s2.vm.state
use s2.vm.loader
use s2.vm.cpu

skill vm_run(image, options) {
    @machine = state.vm_new_machine(options)
    loader.vm_load(machine, image, options.load_address)
    (core.str.len(machine.trap) == 0) { loader.vm_prepare_stack(machine, options) }
    @index = 0
    drum (options.step_limit) {
        (machine.halted == no) { cpu.vm_step(machine) }
        index = index + 1
    }
    (machine.halted == no) {
        @detail = core.str.add(core.num.text(options.step_limit), " instructions")
        state.vm_trap(machine, "step limit reached", detail)
    }
    out cpu.vm_result(machine)
}
