use core
use s2.vm.state
use s2.vm.loader
use s2.vm.cpu

skill run(image, options) {
    @machine = state.new_machine(options)
    loader.load(machine, image, options.load_address)
    (core.str.len(machine.trap) == 0) { loader.prepare_stack(machine, options) }
    @index = 0
    drum (options.step_limit) {
        (machine.halted == no) { cpu.step(machine) }
        index = index + 1
    }
    (machine.halted == no) {
        @detail = core.str.add(core.num.text(options.step_limit), " инструкций")
        state.trap(machine, "исчерпан лимит инструкций", detail)
    }
    out cpu.result(machine)
}
