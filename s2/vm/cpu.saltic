use core
use s2.vm.state
use s2.vm.syscalls

skill vm_decode(word) {
    @opcode = state.vm_mod(word.b0, 128)
    @rd = word.b0 / 128 + state.vm_mod(word.b1, 16) * 2
    @funct3 = state.vm_mod(word.b1 / 16, 8)
    @rs1 = word.b1 / 128 + state.vm_mod(word.b2, 16) * 2
    @rs2 = word.b2 / 16 + state.vm_mod(word.b3, 2) * 16
    @funct7 = word.b3 / 2
    out state.VmInstruction { word = word opcode = opcode rd = rd funct3 = funct3 rs1 = rs1 rs2 = rs2 funct7 = funct7 }
}

skill vm_immediate_i(instruction) {
    @value = instruction.word.b2 / 16 + instruction.word.b3 * 16
    (value > 2047) { value = value - 4096 }
    out value
}

skill vm_immediate_s(instruction) {
    @low = instruction.rd
    @value = low + instruction.funct7 * 32
    (value > 2047) { value = value - 4096 }
    out value
}

skill vm_immediate_b(instruction) {
    @bit12 = instruction.word.b3 / 128
    @bit11 = instruction.word.b0 / 128
    @bits10_5 = state.vm_mod(instruction.word.b3 / 2, 64)
    @bits4_1 = state.vm_mod(instruction.word.b1, 16)
    @value = bit12 * 4096 + bit11 * 2048 + bits10_5 * 32 + bits4_1 * 2
    (value > 4095) { value = value - 8192 }
    out value
}

skill vm_immediate_j(instruction) {
    @bit20 = instruction.word.b3 / 128
    @bit11 = state.vm_mod(instruction.word.b2 / 16, 2)
    @bits19_12 = instruction.word.b1 / 16 + state.vm_mod(instruction.word.b2, 16) * 16
    @bits10_1 = instruction.word.b2 / 32 + state.vm_mod(instruction.word.b3, 128) * 8
    @value = bit20 * 1048576 + bits19_12 * 4096 + bit11 * 2048 + bits10_1 * 2
    (value > 1048575) { value = value - 2097152 }
    out value
}

skill vm_immediate_u(instruction) {
    out state.vm_word_bytes(0, instruction.word.b1 / 16 * 16, instruction.word.b2, instruction.word.b3)
}

skill vm_boolean_word(value) {
    (value == yes) { out state.vm_word_number(1) }
    out state.vm_word_zero()
}

skill vm_illegal(machine, instruction) {
    state.vm_trap(machine, "illegal instruction", core.str.add("0x", state.vm_word_hex(instruction.word)))
    out none
}

skill vm_effective_address(machine, register_index, immediate) {
    out state.vm_word_add(state.vm_register(machine, register_index), state.vm_word_number(immediate))
}

skill vm_execute_lui(machine, instruction, control) {
    state.vm_set_register(machine, instruction.rd, vm_immediate_u(instruction))
    control.handled = yes
    out none
}

skill vm_execute_auipc(machine, instruction, control) {
    @value = state.vm_word_add(state.vm_word_number(machine.pc), vm_immediate_u(instruction))
    state.vm_set_register(machine, instruction.rd, value)
    control.handled = yes
    out none
}

skill vm_execute_jal(machine, instruction, control) {
    state.vm_set_register(machine, instruction.rd, state.vm_word_number(machine.pc + 4))
    control.next_pc = machine.pc + vm_immediate_j(instruction)
    control.handled = yes
    out none
}

skill vm_execute_jalr(machine, instruction, control) {
    (instruction.funct3 > 0) { vm_illegal(machine, instruction) control.handled = yes out none }
    @target = vm_effective_address(machine, instruction.rs1, vm_immediate_i(instruction))
    target.b0 = target.b0 - state.vm_mod(target.b0, 2)
    state.vm_set_register(machine, instruction.rd, state.vm_word_number(machine.pc + 4))
    control.next_pc = state.vm_word_address(target)
    control.handled = yes
    out none
}

skill vm_execute_branch(machine, instruction, control) {
    @left = state.vm_register(machine, instruction.rs1)
    @right = state.vm_register(machine, instruction.rs2)
    @take = no
    @valid = yes
    (instruction.funct3 == 0) { take = state.vm_word_equal(left, right) }
    (instruction.funct3 == 1) {
        (state.vm_word_equal(left, right) == no) { take = yes }
    }
    (instruction.funct3 == 4) { take = state.vm_word_signed_less(left, right) }
    (instruction.funct3 == 5) {
        (state.vm_word_signed_less(left, right) == no) { take = yes }
    }
    (instruction.funct3 == 6) { take = state.vm_word_unsigned_less(left, right) }
    (instruction.funct3 == 7) {
        (state.vm_word_unsigned_less(left, right) == no) { take = yes }
    }
    (instruction.funct3 == 2) { valid = no }
    (instruction.funct3 == 3) { valid = no }
    (valid == no) { vm_illegal(machine, instruction) }
    (valid == yes) {
        (take == yes) { control.next_pc = machine.pc + vm_immediate_b(instruction) }
    }
    control.handled = yes
    out none
}

skill vm_execute_load(machine, instruction, control) {
    @size = 0
    @signed = yes
    (instruction.funct3 == 0) { size = 1 }
    (instruction.funct3 == 1) { size = 2 }
    (instruction.funct3 == 2) { size = 4 }
    (instruction.funct3 == 4) { size = 1 signed = no }
    (instruction.funct3 == 5) { size = 2 signed = no }
    (size == 0) { vm_illegal(machine, instruction) control.handled = yes out none }
    @target = vm_effective_address(machine, instruction.rs1, vm_immediate_i(instruction))
    @address = state.vm_word_address(target)
    (state.vm_memory_check(machine, address, size, size, "load") == yes) {
        @value = state.vm_word_zero()
        value.b0 = state.vm_memory_raw_load8(machine.memory, address)
        (size > 1) { value.b1 = state.vm_memory_raw_load8(machine.memory, address + 1) }
        (size > 2) {
            value.b2 = state.vm_memory_raw_load8(machine.memory, address + 2)
            value.b3 = state.vm_memory_raw_load8(machine.memory, address + 3)
        }
        (signed == yes) {
            (size == 1) {
                (value.b0 > 127) { value.b1 = 255 value.b2 = 255 value.b3 = 255 }
            }
            (size == 2) {
                (value.b1 > 127) { value.b2 = 255 value.b3 = 255 }
            }
        }
        state.vm_set_register(machine, instruction.rd, value)
    }
    control.handled = yes
    out none
}

skill vm_execute_store(machine, instruction, control) {
    @size = 0
    (instruction.funct3 == 0) { size = 1 }
    (instruction.funct3 == 1) { size = 2 }
    (instruction.funct3 == 2) { size = 4 }
    (size == 0) { vm_illegal(machine, instruction) control.handled = yes out none }
    @target = vm_effective_address(machine, instruction.rs1, vm_immediate_s(instruction))
    @address = state.vm_word_address(target)
    (state.vm_memory_check(machine, address, size, size, "store") == yes) {
        state.vm_memory_store_word(machine.memory, address, state.vm_register(machine, instruction.rs2), size)
    }
    control.handled = yes
    out none
}

skill vm_execute_immediate(machine, instruction, control) {
    @left = state.vm_register(machine, instruction.rs1)
    @immediate = state.vm_word_number(vm_immediate_i(instruction))
    @value = state.vm_word_zero()
    @valid = yes
    (instruction.funct3 == 0) { value = state.vm_word_add(left, immediate) }
    (instruction.funct3 == 2) { value = vm_boolean_word(state.vm_word_signed_less(left, immediate)) }
    (instruction.funct3 == 3) { value = vm_boolean_word(state.vm_word_unsigned_less(left, immediate)) }
    (instruction.funct3 == 4) { value = state.vm_word_xor(left, immediate) }
    (instruction.funct3 == 6) { value = state.vm_word_or(left, immediate) }
    (instruction.funct3 == 7) { value = state.vm_word_and(left, immediate) }
    (instruction.funct3 == 1) {
        (instruction.funct7 == 0) { value = state.vm_word_shift_left(left, instruction.rs2) }
        (instruction.funct7 > 0) { valid = no }
    }
    (instruction.funct3 == 5) {
        (instruction.funct7 == 0) { value = state.vm_word_shift_right(left, instruction.rs2) }
        (instruction.funct7 == 32) { value = state.vm_word_shift_right_arithmetic(left, instruction.rs2) }
        (instruction.funct7 > 0) {
            (instruction.funct7 < 32) { valid = no }
            (instruction.funct7 > 32) { valid = no }
        }
    }
    (instruction.funct3 > 7) { valid = no }
    (valid == no) { vm_illegal(machine, instruction) }
    (valid == yes) { state.vm_set_register(machine, instruction.rd, value) }
    control.handled = yes
    out none
}

skill vm_execute_register(machine, instruction, control) {
    @left = state.vm_register(machine, instruction.rs1)
    @right = state.vm_register(machine, instruction.rs2)
    @value = state.vm_word_zero()
    @valid = yes
    (instruction.funct3 == 0) {
        (instruction.funct7 == 0) { value = state.vm_word_add(left, right) }
        (instruction.funct7 == 32) { value = state.vm_word_sub(left, right) }
        (instruction.funct7 > 0) {
            (instruction.funct7 < 32) { valid = no }
            (instruction.funct7 > 32) { valid = no }
        }
    }
    (instruction.funct3 == 1) {
        (instruction.funct7 == 0) { value = state.vm_word_shift_left(left, state.vm_mod(right.b0, 32)) }
        (instruction.funct7 > 0) { valid = no }
    }
    (instruction.funct3 == 2) {
        (instruction.funct7 == 0) { value = vm_boolean_word(state.vm_word_signed_less(left, right)) }
        (instruction.funct7 > 0) { valid = no }
    }
    (instruction.funct3 == 3) {
        (instruction.funct7 == 0) { value = vm_boolean_word(state.vm_word_unsigned_less(left, right)) }
        (instruction.funct7 > 0) { valid = no }
    }
    (instruction.funct3 == 4) {
        (instruction.funct7 == 0) { value = state.vm_word_xor(left, right) }
        (instruction.funct7 > 0) { valid = no }
    }
    (instruction.funct3 == 5) {
        (instruction.funct7 == 0) { value = state.vm_word_shift_right(left, state.vm_mod(right.b0, 32)) }
        (instruction.funct7 == 32) { value = state.vm_word_shift_right_arithmetic(left, state.vm_mod(right.b0, 32)) }
        (instruction.funct7 > 0) {
            (instruction.funct7 < 32) { valid = no }
            (instruction.funct7 > 32) { valid = no }
        }
    }
    (instruction.funct3 == 6) {
        (instruction.funct7 == 0) { value = state.vm_word_or(left, right) }
        (instruction.funct7 > 0) { valid = no }
    }
    (instruction.funct3 == 7) {
        (instruction.funct7 == 0) { value = state.vm_word_and(left, right) }
        (instruction.funct7 > 0) { valid = no }
    }
    (valid == no) { vm_illegal(machine, instruction) }
    (valid == yes) { state.vm_set_register(machine, instruction.rd, value) }
    control.handled = yes
    out none
}

skill vm_execute_fence(machine, instruction, control) {
    (instruction.funct3 > 0) { vm_illegal(machine, instruction) }
    control.handled = yes
    out none
}

skill vm_execute_environment(machine, instruction, control) {
    @ecall = state.vm_word_bytes(115, 0, 0, 0)
    @ebreak = state.vm_word_bytes(115, 0, 16, 0)
    (state.vm_word_equal(instruction.word, ecall) == yes) { syscalls.vm_ecall(machine) control.handled = yes out none }
    (state.vm_word_equal(instruction.word, ebreak) == yes) {
        machine.halted = yes
        machine.halt_reason = "break"
        control.handled = yes
        out none
    }
    vm_illegal(machine, instruction)
    control.handled = yes
    out none
}

skill vm_execute(machine, instruction) {
    @control = state.VmControl { next_pc = machine.pc + 4 }
    (instruction.opcode == 55) { vm_execute_lui(machine, instruction, control) }
    (instruction.opcode == 23) { vm_execute_auipc(machine, instruction, control) }
    (instruction.opcode == 111) { vm_execute_jal(machine, instruction, control) }
    (instruction.opcode == 103) { vm_execute_jalr(machine, instruction, control) }
    (instruction.opcode == 99) { vm_execute_branch(machine, instruction, control) }
    (instruction.opcode == 3) { vm_execute_load(machine, instruction, control) }
    (instruction.opcode == 35) { vm_execute_store(machine, instruction, control) }
    (instruction.opcode == 19) { vm_execute_immediate(machine, instruction, control) }
    (instruction.opcode == 51) { vm_execute_register(machine, instruction, control) }
    (instruction.opcode == 15) { vm_execute_fence(machine, instruction, control) }
    (instruction.opcode == 115) { vm_execute_environment(machine, instruction, control) }
    (control.handled == no) { vm_illegal(machine, instruction) }
    out control
}

skill vm_step(machine) {
    (machine.halted == yes) { out none }
    (state.vm_mod(machine.pc, 4) > 0) {
        state.vm_trap(machine, "instruction address misaligned", "")
        out none
    }
    (state.vm_memory_check(machine, machine.pc, 4, 4, "instruction") == no) { out none }
    @instruction = vm_decode(state.vm_memory_load_word(machine.memory, machine.pc))
    @control = vm_execute(machine, instruction)
    (core.str.len(machine.trap) == 0) {
        machine.pc = control.next_pc
        machine.steps = machine.steps + 1
    }
    out none
}

skill vm_result(machine) {
    @registers = []
    @index = 0
    drum (32) {
        registers = core.group.add(registers, state.vm_word_hex(state.vm_register(machine, index)))
        index = index + 1
    }
    @reason = machine.halt_reason
    (core.str.len(machine.trap) > 0) { reason = "trap" }
    out state.VmResult {
        exit_code = machine.exit_code
        reason = reason
        pc = state.vm_number_hex(machine.pc)
        steps = machine.steps
        registers = registers
        stdout = machine.stdout
        stderr = machine.stderr
        files = machine.files
        trap = machine.trap
    }
}
