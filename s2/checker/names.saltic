use core

Name = Box {
    name = ""
    kind = ""
    type = "unknown"
    node = []
}

Scope = Box {
    names = []
    subject = ""
    module = ""
}

skill plain(node) {
    @plain = node
    (core.group.count(plain) == 3) {
        (core.group.item(plain, 0) == "module") { plain = core.group.item(plain, 2) }
    }
    (core.group.count(plain) == 4) {
        (core.group.item(plain, 0) == "loc") { out core.group.item(plain, 3) }
    }
    out plain
}

skill module(node) {
    (core.group.count(node) == 3) {
        (core.group.item(node, 0) == "module") { out core.group.item(node, 1) }
    }
    out ""
}

skill tag(node) {
    @plain = plain(node)
    out core.group.item(plain, 0)
}

skill part(node, index) {
    @plain = plain(node)
    out core.group.item(plain, index)
}

skill find(names, name) {
    @result = Name {}
    @found = no
    @index = 0
    @count = core.group.count(names)
    drum (count) {
        (found == no) {
            @item = core.group.item(names, index)
            (item.name == name) { result = item found = yes }
        }
        index = index + 1
    }
    out result
}

skill has(names, name) {
    @found = find(names, name)
    out core.str.len(found.name) > 0
}

skill put(names, name, kind, type) {
    out core.group.add(names, Name { name = name kind = kind type = type })
}

skill put_node(names, name, kind, type, node) {
    out core.group.add(names, Name { name = name kind = kind type = type node = node })
}

skill update(names, name, type) {
    @result = []
    @index = 0
    @count = core.group.count(names)
    drum (count) {
        @item = core.group.item(names, index)
        @next_type = item.type
        (item.name == name) { next_type = type }
        result = put_node(result, item.name, item.kind, next_type, item.node)
        index = index + 1
    }
    out result
}

skill path_text(path) {
    @plain = plain(path)
    @text = core.group.item(plain, 1)
    @index = 2
    @count = core.group.count(plain)
    drum (count) {
        (index < count) { text = core.str.add(text, core.str.add(".", core.group.item(plain, index))) }
        index = index + 1
    }
    out text
}

skill qualified(module, name) {
    (core.str.len(module) == 0) { out name }
    out core.str.add(module, core.str.add(".", name))
}

skill alias_key(module, alias) {
    out core.str.add(module, core.str.add("|", alias))
}

skill name_head(name) {
    @index = 0
    @count = core.str.len(name)
    drum (count) {
        (index < count) {
            (core.str.at(name, index) == ".") { out core.str.slice(name, 0, index) }
            index = index + 1
        }
    }
    out name
}

skill name_tail(name) {
    @index = 0
    @count = core.str.len(name)
    drum (count) {
        (index < count) {
            (core.str.at(name, index) == ".") { out core.str.slice(name, index, count) }
            index = index + 1
        }
    }
    out ""
}

skill name_module(name) {
    @last = 0
    @index = 0
    @count = core.str.len(name)
    drum (count) {
        (index < count) {
            (core.str.at(name, index) == ".") { last = index }
            index = index + 1
        }
    }
    (last == 0) { out "" }
    out core.str.slice(name, 0, last)
}

skill resolve_name(name, module, globals) {
    (has(globals, name) == yes) { out name }
    @local = qualified(module, name)
    (has(globals, local) == yes) { out local }
    @head = name_head(name)
    @import = find(globals, alias_key(module, head))
    (import.kind == "import") {
        @candidate = core.str.add(import.type, name_tail(name))
        (has(globals, candidate) == yes) { out candidate }
    }
    out ""
}

skill resolve_path(node, scope, globals) {
    @plain = plain(node)
    @count = core.group.count(plain)
    @head = core.group.item(plain, 1)
    (count == 2) {
        (has(scope.names, head) == yes) { out "" }
    }
    @direct = path_text(plain)
    (has(globals, direct) == yes) { out direct }
    (count == 2) {
        @local = qualified(scope.module, head)
        (has(globals, local) == yes) { out local }
    }
    @import = find(globals, alias_key(scope.module, head))
    (import.kind == "import") {
        @candidate = import.type
        @index = 2
        drum (count) {
            (index < count) { candidate = core.str.add(candidate, core.str.add(".", core.group.item(plain, index))) index = index + 1 }
        }
        (has(globals, candidate) == yes) { out candidate }
    }
    out ""
}

skill path_prefix(node) {
    @plain = plain(node)
    @count = core.group.count(plain)
    @text = core.group.item(plain, 1)
    @index = 2
    drum (count - 1) {
        (index < count - 1) { text = core.str.add(text, core.str.add(".", core.group.item(plain, index))) index = index + 1 }
    }
    out text
}
