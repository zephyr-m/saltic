use core
use s2.checker.names
use s2.checker.types

CheckDiagnostic = Box {
    code = "checker_error"
    message = ""
    line = 0
    col = 0
}

CheckResult = Box {
    diagnostics = []
    globals = []
}

skill checker_location(node) {
    @plain = node
    (core.group.count(plain) == 3) {
        (core.group.item(plain, 0) == "module") { plain = core.group.item(plain, 2) }
    }
    (core.group.count(plain) == 4) {
        (core.group.item(plain, 0) == "loc") { out [core.group.item(plain, 1), core.group.item(plain, 2)] }
    }
    out [0, 0]
}

skill checker_diagnostic(node, code, message) {
    @place = checker_location(node)
    out CheckDiagnostic {
        code = code
        message = message
        line = core.group.item(place, 0)
        col = core.group.item(place, 1)
    }
}

skill checker_add(diagnostics, diagnostic) {
    out core.group.add(diagnostics, diagnostic)
}

skill checker_collect(ast) {
    @result = CheckResult {}
    @program_seen = no
    @index = 1
    @count = core.group.count(ast)
    drum (count) {
        (index < count) {
            @item = core.group.item(ast, index)
            @tag = names.checker_tag(item)
            @module = names.checker_module(item)
            @name = ""
            @kind = ""
            (tag == "use") {
                (names.checker_part(item, 1) == "core") {
                    (names.checker_has(result.globals, "__core__") == no) { result.globals = names.checker_put(result.globals, "__core__", "import", "module-path") }
                }
                @target = names.checker_path_text(item)
                @plain_use = names.checker_plain(item)
                @alias = core.group.item(plain_use, core.group.count(plain_use) - 1)
                @alias_key = names.checker_alias_key(module, alias)
                @old_alias = names.checker_find(result.globals, alias_key)
                (core.str.len(old_alias.name) > 0) {
                    ((old_alias.type == target) == no) { result.diagnostics = checker_add(result.diagnostics, CheckDiagnostic { code = "duplicate_definition" message = core.str.add("duplicate module alias '", core.str.add(alias, "'")) }) }
                }
                (core.str.len(old_alias.name) == 0) { result.globals = names.checker_put(result.globals, alias_key, "import", target) }
            }
            (tag == "entry") {
                (program_seen == yes) { result.diagnostics = checker_add(result.diagnostics, CheckDiagnostic { code = "duplicate_definition" message = "duplicate program entry" }) }
                program_seen = yes
            }
            (tag == "const") { name = names.checker_qualified(module, names.checker_part(item, 1)) kind = "const" }
            (tag == "enum") { name = names.checker_qualified(module, names.checker_part(item, 1)) kind = "enum" }
            (tag == "box") { name = names.checker_qualified(module, names.checker_part(item, 1)) kind = "box" }
            (tag == "skill") { name = names.checker_qualified(module, names.checker_part(item, 1)) kind = "skill" }
            (core.str.len(name) > 0) {
                (names.checker_has(result.globals, name) == yes) {
                    result.diagnostics = checker_add(result.diagnostics, CheckDiagnostic { code = "duplicate_definition" message = core.str.add("duplicate top-level name '", core.str.add(name, "'")) })
                }
                @type = "unknown"
                (kind == "const") { type = types.checker_type_in_module(names.checker_part(item, 2), module, result.globals) }
                (kind == "enum") { type = "enum-type" }
                (kind == "box") { type = "box-type" }
                (kind == "skill") { type = "function" }
                (names.checker_has(result.globals, name) == no) { result.globals = names.checker_put_node(result.globals, name, kind, type, item) }
            }
            index = index + 1
        }
    }
    out result
}

skill checker_box_has_skill(globals, box_name, skill_name) {
    @box = names.checker_find(globals, box_name)
    @found = no
    @index = 2
    @count = core.group.count(names.checker_plain(box.node))
    drum (count) {
        (index < count) {
            @member = names.checker_part(box.node, index)
            (names.checker_tag(member) == "subject-skill") {
                (names.checker_part(member, 1) == skill_name) { found = yes }
            }
            index = index + 1
        }
    }
    out found
}

skill checker_enum_has(globals, enum_name, variant) {
    @model = names.checker_find(globals, enum_name)
    @found = no
    @index = 2
    @count = core.group.count(names.checker_plain(model.node))
    drum (count) {
        (index < count) {
            (names.checker_part(model.node, index) == variant) { found = yes }
            index = index + 1
        }
    }
    out found
}

skill checker_path(node, scope, globals, diagnostics) {
    @parts = names.checker_plain(node)
    @name = core.group.item(parts, 1)
    @count = core.group.count(parts)
    @resolved = names.checker_resolve_path(node, scope, globals)
    (core.str.len(resolved) > 0) { out diagnostics }
    (count == 2) {
        @known = names.checker_has(scope.names, name)
        (known == no) { known = names.checker_has(globals, name) }
        (name == "error") { known = yes }
        (known == no) { out checker_add(diagnostics, checker_diagnostic(node, "unknown_name", core.str.add("unknown name '", core.str.add(name, "'")))) }
        out diagnostics
    }
    (name == "host") { out diagnostics }
    (name == "world") { out diagnostics }
    (name == "visual") { out diagnostics }
    (name == "ui") { out diagnostics }
    (name == "error") { out diagnostics }
    (name == "core") {
        (names.checker_has(globals, "__core__") == no) { out checker_add(diagnostics, checker_diagnostic(node, "core_not_imported", "module 'core' is not imported; add 'use core'")) }
        out diagnostics
    }
    @global = names.checker_find(globals, name)
    (global.kind == "enum") {
        (count == 3) {
            @variant = core.group.item(parts, 2)
            (checker_enum_has(globals, name, variant) == no) { out checker_add(diagnostics, checker_diagnostic(node, "checker_error", core.str.add("enum '", core.str.add(name, core.str.add("' has no variant '", core.str.add(variant, "'")))))) }
            out diagnostics
        }
    }
    @base = names.checker_find(scope.names, name)
    (core.str.len(base.name) == 0) { base = global }
    (core.str.len(base.name) == 0) { out diagnostics }
    @type = base.type
    @index = 2
    drum (count) {
        (index < count) {
            @field_name = core.group.item(parts, index)
            (type == "unknown") { index = count }
            (index < count) {
                @was_box = core.str.starts_with(type, "box:")
                (was_box == yes) {
                    @box_name = types.checker_tail(type, 4)
                    @field = types.checker_box_field(globals, box_name, field_name)
                    (core.str.len(field.name) == 0) {
                        @message = core.str.add("Box '", box_name)
                        message = core.str.add(message, "' has no field '")
                        message = core.str.add(message, field_name)
                        message = core.str.add(message, "'")
                        diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", message))
                        index = count
                    }
                    (core.str.len(field.name) > 0) { type = field.type }
                }
                (was_box == no) {
                    @message = core.str.add("cannot access field '", field_name)
                    message = core.str.add(message, "' on ")
                    message = core.str.add(message, types.checker_type_text(type))
                    diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", message))
                    index = count
                }
            }
            index = index + 1
        }
    }
    out diagnostics
}

skill checker_expression(node, scope, globals, diagnostics) {
    @plain = names.checker_plain(node)
    @tag = core.group.item(plain, 0)
    (tag == "path") { out checker_path(node, scope, globals, diagnostics) }
    (tag == "binary") {
        @left_node = core.group.item(plain, 2)
        @right_node = core.group.item(plain, 3)
        diagnostics = checker_expression(left_node, scope, globals, diagnostics)
        diagnostics = checker_expression(right_node, scope, globals, diagnostics)
        @operator = core.group.item(plain, 1)
        @numeric = no
        (operator == "+") { numeric = yes }
        (operator == "-") { numeric = yes }
        (operator == "*") { numeric = yes }
        (operator == "/") { numeric = yes }
        (operator == ">") { numeric = yes }
        (operator == "<") { numeric = yes }
        (numeric == yes) {
            @left_type = types.checker_value_type(left_node, scope, globals)
            @right_type = types.checker_value_type(right_node, scope, globals)
            @known_types = yes
            (left_type == "unknown") { known_types = no }
            (right_type == "unknown") { known_types = no }
            (known_types == yes) {
                @both_numbers = no
                (left_type == "number") {
                    (right_type == "number") { both_numbers = yes }
                }
                @fixed = no
                (types.checker_is_fixed_type(left_type) == yes) { fixed = yes }
                (types.checker_is_fixed_type(right_type) == yes) { fixed = yes }
                (fixed == yes) {
                    both_numbers = yes
                    @message = ""
                    (left_type == "address") { message = "для арифметики адресов используй core.address.add(address, usize)" }
                    (right_type == "address") { message = "для арифметики адресов используй core.address.add(address, usize)" }
                    (left_type == "bits32") { message = core.str.add("операция '", core.str.add(operator, "' недоступна для bits32: используй операции core.bits32")) }
                    (right_type == "bits32") { message = core.str.add("операция '", core.str.add(operator, "' недоступна для bits32: используй операции core.bits32")) }
                    (core.str.len(message) == 0) {
                        (left_type == right_type) { message = "" }
                        (left_type == "number") { message = core.str.add("операция '", core.str.add(operator, core.str.add("' не может смешивать ", core.str.add(right_type, " и number")))) }
                        (right_type == "number") { message = core.str.add("операция '", core.str.add(operator, core.str.add("' не может смешивать ", core.str.add(left_type, " и number")))) }
                        (core.str.len(message) == 0) {
                            (left_type == right_type) { message = "" }
                            ((left_type == right_type) == no) { message = core.str.add("операция '", core.str.add(operator, core.str.add("' требует одинаковые фиксированные целые типы: получены ", core.str.add(left_type, core.str.add(" и ", right_type))))) }
                        }
                    }
                    (core.str.len(message) > 0) { diagnostics = checker_add(diagnostics, checker_diagnostic(node, "operator_type_mismatch", message)) }
                }
                (both_numbers == no) {
                    @message = core.str.add("operator '", operator)
                    message = core.str.add(message, "' expects numbers, got ")
                    message = core.str.add(message, types.checker_type_text(left_type))
                    message = core.str.add(message, " and ")
                    message = core.str.add(message, types.checker_type_text(right_type))
                    diagnostics = checker_add(diagnostics, CheckDiagnostic { code = "operator_type_mismatch" message = message })
                }
            }
        }
        out diagnostics
    }
    (tag == "call") {
        @callee = names.checker_plain(core.group.item(plain, 1))
        @skip_callee = no
        (core.group.item(callee, 0) == "path") {
            @callee_count = core.group.count(callee)
            (callee_count == 2) {
                (types.checker_is_fixed_type(core.group.item(callee, 1)) == yes) { skip_callee = yes }
                (core.str.len(scope.subject) > 0) {
                    (checker_box_has_skill(globals, scope.subject, core.group.item(callee, 1)) == yes) { skip_callee = yes }
                }
            }
            (callee_count == 3) {
                @receiver_path = ["path", core.group.item(callee, 1)]
                @receiver_type = types.checker_path_type(receiver_path, scope, globals)
                (core.str.starts_with(receiver_type, "box:") == yes) {
                    (checker_box_has_skill(globals, types.checker_tail(receiver_type, 4), core.group.item(callee, 2)) == yes) { skip_callee = yes }
                }
            }
        }
        @index = 1
        (skip_callee == yes) { index = 2 }
        @count = core.group.count(plain)
        drum (count) {
            (index < count) { diagnostics = checker_expression(core.group.item(plain, index), scope, globals, diagnostics) }
            index = index + 1
        }
        @full = names.checker_path_text(callee)
        (types.checker_is_fixed_type(full) == yes) {
            @text = types.checker_integer_text(core.group.item(plain, 2))
            (core.str.len(text) > 0) {
                (types.checker_fixed_range(full, text) == no) {
                    @message = core.str.add("значение ", text)
                    message = core.str.add(message, core.str.add(" не помещается в ", full))
                    message = core.str.add(message, core.str.add(": допустимо ", types.checker_fixed_range_text(full)))
                    diagnostics = checker_add(diagnostics, checker_diagnostic(node, "fixed_integer_out_of_range", message))
                }
            }
        }
        @expected = ""
        (full == "core.mem.store8") { expected = "u8" }
        (full == "core.mem.store16") { expected = "u16" }
        (full == "core.mem.store32") { expected = "u32" }
        (core.str.len(expected) > 0) {
            (types.checker_value_type(core.group.item(plain, 2), scope, globals) == "address") {
                @actual = types.checker_value_type(core.group.item(plain, 4), scope, globals)
                (actual == expected) { expected = "" }
                (core.str.len(expected) > 0) {
                    @message = core.str.add(full, core.str.add(" ожидает значение ", expected))
                    message = core.str.add(message, core.str.add(", получено ", actual))
                    diagnostics = checker_add(diagnostics, checker_diagnostic(node, "type_mismatch", message))
                }
            }
        }
        (core.str.starts_with(full, "core.bits32.") == yes) {
            @argument_index = 3
            @expected_type = "bits32"
            (full == "core.bits32.not") { argument_index = 0 }
            (full == "core.bits32.shift_left") { expected_type = "u8" }
            (full == "core.bits32.shift_right") { expected_type = "u8" }
            (argument_index > 0) {
                @actual = types.checker_value_type(core.group.item(plain, argument_index), scope, globals)
                (actual == expected_type) { expected_type = "" }
                (core.str.len(expected_type) > 0) {
                    @message = core.str.add(full, " ожидает ")
                    (expected_type == "u8") { message = core.str.add(message, "сдвиг ") }
                    message = core.str.add(message, expected_type)
                    message = core.str.add(message, core.str.add(", получено ", actual))
                    diagnostics = checker_add(diagnostics, checker_diagnostic(node, "type_mismatch", message))
                }
            }
        }
        out diagnostics
    }
    (tag == "group") {
        @index = 1
        @count = core.group.count(plain)
        drum (count) {
            (index < count) { diagnostics = checker_expression(core.group.item(plain, index), scope, globals, diagnostics) }
            index = index + 1
        }
        out diagnostics
    }
    (tag == "box-new") {
        @name = core.group.item(plain, 1)
        @resolved_box = names.checker_resolve_name(name, scope.module, globals)
        @model = names.checker_find(globals, resolved_box)
        (model.kind == "box") {
            @seen = []
            @index = 2
            @count = core.group.count(plain)
            drum (count) {
                (index < count) {
                    @override = core.group.item(plain, index)
                    @field_name = names.checker_part(override, 1)
                    @value = names.checker_part(override, 2)
                    diagnostics = checker_expression(value, scope, globals, diagnostics)
                    (names.checker_has(seen, field_name) == yes) {
                        @message = core.str.add("duplicate field '", field_name)
                        message = core.str.add(message, "' in Box literal '")
                        message = core.str.add(message, name)
                        message = core.str.add(message, "'")
                        diagnostics = checker_add(diagnostics, checker_diagnostic(node, "duplicate_definition", message))
                    }
                    seen = names.checker_put(seen, field_name, "field", "unknown")
                    @field = types.checker_box_field(globals, resolved_box, field_name)
                    (core.str.len(field.name) == 0) {
                        @message = core.str.add("Box '", name)
                        message = core.str.add(message, "' has no field '")
                        message = core.str.add(message, field_name)
                        message = core.str.add(message, "'")
                        diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", message))
                    }
                    (core.str.len(field.name) > 0) {
                        @value_type = types.checker_value_type(value, scope, globals)
                        (types.checker_compatible(field.type, value_type) == no) {
                            @message = core.str.add("cannot assign ", types.checker_type_text(value_type))
                            message = core.str.add(message, " to field '")
                            message = core.str.add(message, field_name)
                            message = core.str.add(message, "' of Box '")
                            message = core.str.add(message, name)
                            message = core.str.add(message, "' with type ")
                            message = core.str.add(message, types.checker_type_text(field.type))
                            diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", message))
                        }
                    }
                    index = index + 1
                }
            }
            out diagnostics
        }
        @message = core.str.add("unknown Box '", name)
        message = core.str.add(message, "'")
        diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", message))
        out diagnostics
    }
    (tag == "rescue") {
        diagnostics = checker_expression(core.group.item(plain, 1), scope, globals, diagnostics)
        @child = names.CheckScope { names = scope.names subject = scope.subject module = scope.module }
        child.names = names.checker_put(child.names, core.group.item(plain, 2), "variable", "error")
        out checker_block(core.group.item(plain, 3), child, globals, diagnostics)
    }
    out diagnostics
}

skill checker_statement(node, scope, globals, diagnostics) {
    @plain = names.checker_plain(node)
    @tag = core.group.item(plain, 0)
    (tag == "var") {
        @name = core.group.item(plain, 1)
        @value = core.group.item(plain, 2)
        diagnostics = checker_expression(value, scope, globals, diagnostics)
        (names.checker_has(scope.names, name) == yes) { diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", core.str.add("variable '", core.str.add(name, "' is already declared in this scope")))) }
        (names.checker_has(scope.names, name) == no) {
            (names.checker_has(globals, name) == yes) {
                @message = core.str.add("variable '", name)
                message = core.str.add(message, "' conflicts with top-level name")
                diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", message))
            }
            (names.checker_has(globals, name) == no) { scope.names = names.checker_put(scope.names, name, "variable", types.checker_value_type(value, scope, globals)) }
        }
        out diagnostics
    }
    (tag == "assign") {
        @name = core.group.item(plain, 1)
        @value = core.group.item(plain, 2)
        diagnostics = checker_expression(value, scope, globals, diagnostics)
        (names.checker_has(scope.names, name) == yes) {
            @old = names.checker_find(scope.names, name)
            @value_type = types.checker_value_type(value, scope, globals)
            (types.checker_compatible(old.type, value_type) == yes) { scope.names = names.checker_update(scope.names, name, types.checker_merge(old.type, value_type)) }
            (types.checker_compatible(old.type, value_type) == no) {
                @message = ""
                @fixed = types.checker_is_fixed_type(old.type)
                (types.checker_is_fixed_type(value_type) == yes) { fixed = yes }
                (fixed == yes) {
                    message = core.str.add("нельзя присвоить ", types.checker_type_text(value_type))
                    message = core.str.add(message, " переменной '")
                    message = core.str.add(message, name)
                    message = core.str.add(message, "' типа ")
                    message = core.str.add(message, types.checker_type_text(old.type))
                }
                (fixed == no) {
                    message = core.str.add("cannot assign ", types.checker_type_text(value_type))
                    message = core.str.add(message, " to variable '")
                    message = core.str.add(message, name)
                    message = core.str.add(message, "' of type ")
                    message = core.str.add(message, types.checker_type_text(old.type))
                }
                diagnostics = checker_add(diagnostics, checker_diagnostic(node, "type_mismatch", message))
            }
        }
        (names.checker_has(scope.names, name) == no) {
            @global = names.checker_find(globals, name)
            @is_constant = no
            (global.kind == "const") { is_constant = yes }
            (global.kind == "const") { diagnostics = checker_add(diagnostics, checker_diagnostic(node, "constant_assignment", core.str.add("cannot assign to constant '", core.str.add(name, "'")))) }
            (core.str.len(global.name) > 0) {
                (is_constant == no) {
                    @message = core.str.add("cannot assign to top-level name '", name)
                    message = core.str.add(message, "'")
                    diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", message))
                }
            }
            (core.str.len(global.name) == 0) { diagnostics = checker_add(diagnostics, checker_diagnostic(node, "variable_not_declared", core.str.add("variable '", core.str.add(name, "' is not declared")))) }
        }
        out diagnostics
    }
    (tag == "field-assign") {
        @target = names.checker_plain(core.group.item(plain, 1))
        @part_count = core.group.count(target)
        @base_parts = ["path"]
        @part_index = 1
        drum (part_count) {
            (part_index + 1 < part_count) { base_parts = core.group.add(base_parts, core.group.item(target, part_index)) }
            part_index = part_index + 1
        }
        diagnostics = checker_path(base_parts, scope, globals, diagnostics)
        @value = core.group.item(plain, 2)
        diagnostics = checker_expression(value, scope, globals, diagnostics)
        @base_type = types.checker_path_type(base_parts, scope, globals)
        (core.str.starts_with(base_type, "box:") == yes) {
            @box_name = types.checker_tail(base_type, 4)
            @field_name = core.group.item(target, part_count - 1)
            @field = types.checker_box_field(globals, box_name, field_name)
            (core.str.len(field.name) == 0) {
                @message = core.str.add("Box '", box_name)
                message = core.str.add(message, "' has no field '")
                message = core.str.add(message, field_name)
                message = core.str.add(message, "'")
                diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", message))
            }
            (core.str.len(field.name) > 0) {
                @value_type = types.checker_value_type(value, scope, globals)
                (types.checker_compatible(field.type, value_type) == no) {
                    @message = core.str.add("cannot assign ", types.checker_type_text(value_type))
                    message = core.str.add(message, " to field '")
                    message = core.str.add(message, field_name)
                    message = core.str.add(message, "' of Box '")
                    message = core.str.add(message, box_name)
                    message = core.str.add(message, "'")
                    diagnostics = checker_add(diagnostics, checker_diagnostic(node, "checker_error", message))
                }
            }
        }
        out diagnostics
    }
    (tag == "out") { out checker_expression(core.group.item(plain, 1), scope, globals, diagnostics) }
    (tag == "expr") { out checker_expression(core.group.item(plain, 1), scope, globals, diagnostics) }
    (tag == "if") {
        diagnostics = checker_expression(core.group.item(plain, 1), scope, globals, diagnostics)
        out checker_block(core.group.item(plain, 2), names.CheckScope { names = scope.names subject = scope.subject module = scope.module }, globals, diagnostics)
    }
    (tag == "drum") {
        diagnostics = checker_expression(core.group.item(plain, 1), scope, globals, diagnostics)
        out checker_block(core.group.item(plain, 2), names.CheckScope { names = scope.names subject = scope.subject module = scope.module }, globals, diagnostics)
    }
    (tag == "switch") {
        diagnostics = checker_expression(core.group.item(plain, 1), scope, globals, diagnostics)
        @index = 2
        @count = core.group.count(plain)
        drum (count) {
            (index < count) { diagnostics = checker_expression(names.checker_part(core.group.item(plain, index), 2), scope, globals, diagnostics) }
            index = index + 1
        }
        out diagnostics
    }
    out checker_add(diagnostics, checker_diagnostic(node, "checker_error", core.str.add("unsupported statement ", tag)))
}

skill checker_block(block, scope, globals, diagnostics) {
    @plain = names.checker_plain(block)
    @index = 1
    @count = core.group.count(plain)
    drum (count) {
        (index < count) { diagnostics = checker_statement(core.group.item(plain, index), scope, globals, diagnostics) }
        index = index + 1
    }
    out diagnostics
}

skill checker_params(params, globals, subject, module, body, diagnostics) {
    @scope = names.CheckScope { subject = subject module = module }
    (core.str.len(subject) > 0) {
        @model = names.checker_find(globals, subject)
        @member_index = 2
        @member_count = core.group.count(names.checker_plain(model.node))
        drum (member_count) {
            (member_index < member_count) {
                @member = names.checker_part(model.node, member_index)
                (names.checker_tag(member) == "field") { scope.names = names.checker_put(scope.names, names.checker_part(member, 1), "field", types.checker_type_in_module(names.checker_part(member, 2), module, globals)) }
                member_index = member_index + 1
            }
        }
    }
    @index = 0
    @count = core.group.count(params)
    drum (count) {
        @name = core.group.item(params, index)
        (names.checker_has(scope.names, name) == yes) { diagnostics = checker_add(diagnostics, CheckDiagnostic { code = "duplicate_definition" message = core.str.add("duplicate parameter '", core.str.add(name, "'")) }) }
        (names.checker_has(scope.names, name) == no) { scope.names = names.checker_put(scope.names, name, "parameter", "unknown") }
        index = index + 1
    }
    out checker_block(body, scope, globals, diagnostics)
}

skill checker_check(ast) {
    @result = checker_collect(ast)
    @index = 1
    @count = core.group.count(ast)
    drum (count) {
        (index < count) {
            @item = core.group.item(ast, index)
            @tag = names.checker_tag(item)
            @module = names.checker_module(item)
            (tag == "const") { result.diagnostics = checker_expression(names.checker_part(item, 2), names.CheckScope { module = module }, result.globals, result.diagnostics) }
            (tag == "skill") { result.diagnostics = checker_params(names.checker_part(item, 2), result.globals, "", module, names.checker_part(item, 3), result.diagnostics) }
            (tag == "entry") { result.diagnostics = checker_params(names.checker_part(item, 1), result.globals, "", module, names.checker_part(item, 2), result.diagnostics) }
            (tag == "box") {
                @seen_fields = []
                @seen_skills = []
                @member_index = 2
                @member_count = core.group.count(names.checker_plain(item))
                drum (member_count) {
                    (member_index < member_count) {
                        @member = names.checker_part(item, member_index)
                        @member_tag = names.checker_tag(member)
                        (member_tag == "field") {
                            @field_name = names.checker_part(member, 1)
                            (names.checker_has(seen_fields, field_name) == yes) {
                                @message = core.str.add("duplicate field '", field_name)
                                message = core.str.add(message, "' in Box '")
                                message = core.str.add(message, names.checker_part(item, 1))
                                message = core.str.add(message, "'")
                                result.diagnostics = checker_add(result.diagnostics, CheckDiagnostic { code = "duplicate_definition" message = message })
                            }
                            seen_fields = names.checker_put(seen_fields, field_name, "field", "unknown")
                            result.diagnostics = checker_expression(names.checker_part(member, 2), names.CheckScope { module = module }, result.globals, result.diagnostics)
                        }
                        (member_tag == "subject-skill") {
                            @skill_name = names.checker_part(member, 1)
                            (names.checker_has(seen_skills, skill_name) == yes) {
                                @message = core.str.add("duplicate skill '", skill_name)
                                message = core.str.add(message, "' in Box '")
                                message = core.str.add(message, names.checker_part(item, 1))
                                message = core.str.add(message, "'")
                                result.diagnostics = checker_add(result.diagnostics, CheckDiagnostic { code = "duplicate_definition" message = message })
                            }
                            seen_skills = names.checker_put(seen_skills, skill_name, "skill", "function")
                            result.diagnostics = checker_params(names.checker_part(member, 2), result.globals, names.checker_qualified(module, names.checker_part(item, 1)), module, names.checker_part(member, 3), result.diagnostics)
                        }
                        member_index = member_index + 1
                    }
                }
            }
            index = index + 1
        }
    }
    out result
}
