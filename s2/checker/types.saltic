use core
use s2.checker.names

skill tail(text, start) {
    out core.str.slice(text, start, core.str.len(text))
}

skill group_type(type) {
    out core.str.add("group:", type)
}

skill is_group_type(type) {
    out core.str.starts_with(type, "group:")
}

skill group_item_type(type) {
    (is_group_type(type) == yes) { out tail(type, 6) }
    out "unknown"
}

skill merge(left, right) {
    (left == "unknown") { out right }
    (right == "unknown") { out left }
    (left == right) { out left }
    (is_group_type(left) == yes) {
        (is_group_type(right) == yes) { out group_type(merge(group_item_type(left), group_item_type(right))) }
    }
    out "unknown"
}

skill compatible(left, right) {
    (left == "unknown") { out yes }
    (right == "unknown") { out yes }
    (left == right) { out yes }
    (is_group_type(left) == yes) {
        (is_group_type(right) == yes) { out compatible(group_item_type(left), group_item_type(right)) }
    }
    out no
}

skill type_text(type) {
    (type == "answer") { out "yes/no" }
    (core.str.starts_with(type, "box:") == yes) { out core.str.add("Box ", tail(type, 4)) }
    (core.str.starts_with(type, "enum:") == yes) { out core.str.add("enum ", tail(type, 5)) }
    (is_group_type(type) == yes) { out core.str.add("группа ", type_text(group_item_type(type))) }
    out type
}

skill is_fixed_type(type) {
    (type == "u8") { out yes }
    (type == "u16") { out yes }
    (type == "u32") { out yes }
    (type == "i32") { out yes }
    (type == "bits32") { out yes }
    (type == "address") { out yes }
    (type == "usize") { out yes }
    out no
}

skill integer_text(node) {
    @plain = names.plain(node)
    @tag = core.group.item(plain, 0)
    (tag == "number") { out core.num.text(core.group.item(plain, 1)) }
    (tag == "wide-number") { out core.group.item(plain, 1) }
    (tag == "binary") {
        (core.group.item(plain, 1) == "-") {
            @left = names.plain(core.group.item(plain, 2))
            (core.group.item(left, 0) == "number") {
                (core.group.item(left, 1) == 0) { out core.str.add("-", integer_text(core.group.item(plain, 3))) }
            }
        }
    }
    out ""
}

skill unsigned_greater(value, maximum) {
    @value_length = core.str.len(value)
    @maximum_length = core.str.len(maximum)
    (value_length > maximum_length) { out yes }
    (value_length < maximum_length) { out no }
    @index = 0
    drum (value_length) {
        @actual = digit(core.str.at(value, index))
        @limit = digit(core.str.at(maximum, index))
        (actual > limit) { out yes }
        (actual < limit) { out no }
        index = index + 1
    }
    out no
}

skill digit(ch) {
    (ch == "0") { out 0 }
    (ch == "1") { out 1 }
    (ch == "2") { out 2 }
    (ch == "3") { out 3 }
    (ch == "4") { out 4 }
    (ch == "5") { out 5 }
    (ch == "6") { out 6 }
    (ch == "7") { out 7 }
    (ch == "8") { out 8 }
    out 9
}


skill type_in_module(node, module, globals) {
    @type = type(node)
    (core.str.starts_with(type, "box:") == yes) {
        @name = tail(type, 4)
        @resolved = names.resolve_name(name, module, globals)
        (core.str.len(resolved) > 0) { out core.str.add("box:", resolved) }
    }
    out type
}


skill fixed_range(type, text) {
    @negative = core.str.starts_with(text, "-")
    @magnitude = text
    (negative == yes) { magnitude = core.str.slice(text, 1, core.str.len(text)) }
    (type == "u8") { (negative == yes) { out no } out unsigned_greater(magnitude, "255") == no }
    (type == "u16") { (negative == yes) { out no } out unsigned_greater(magnitude, "65535") == no }
    (type == "u32") { (negative == yes) { out no } out unsigned_greater(magnitude, "4294967295") == no }
    (type == "bits32") { (negative == yes) { out no } out unsigned_greater(magnitude, "4294967295") == no }
    (type == "usize") { (negative == yes) { out no } out unsigned_greater(magnitude, "4294967295") == no }
    (type == "i32") {
        (negative == yes) { out unsigned_greater(magnitude, "2147483648") == no }
        out unsigned_greater(magnitude, "2147483647") == no
    }
    out yes
}

skill fixed_range_text(type) {
    (type == "u8") { out "0..255" }
    (type == "u16") { out "0..65535" }
    (type == "i32") { out "-2147483648..2147483647" }
    out "0..4294967295"
}

skill type(node) {
    @tag = names.tag(node)
    (tag == "number") { out "number" }
    (tag == "wide-number") { out "number" }
    (tag == "string") { out "string" }
    (tag == "answer") { out "answer" }
    (tag == "none") { out "none" }
    (tag == "group") {
        @type = "unknown"
        @index = 1
        @plain = names.plain(node)
        @count = core.group.count(plain)
        drum (count) {
            (index < count) { type = merge(type, type(core.group.item(plain, index))) }
            index = index + 1
        }
        out group_type(type)
    }
    (tag == "box-new") { out core.str.add("box:", names.part(node, 1)) }
    out "unknown"
}

skill box_field(globals, box_name, field_name) {
    @box = names.find(globals, box_name)
    @result = names.Name {}
    @index = 2
    @count = core.group.count(names.plain(box.node))
    drum (count) {
        (index < count) {
            @member = names.part(box.node, index)
            (names.tag(member) == "field") {
                (names.part(member, 1) == field_name) { result = names.Name { name = field_name kind = "field" type = type_in_module(names.part(member, 2), names.name_module(box_name), globals) node = member } }
            }
            index = index + 1
        }
    }
    out result
}

skill path_type(node, scope, globals) {
    @parts = names.plain(node)
    @count = core.group.count(parts)
    @name = core.group.item(parts, 1)
    @resolved = names.resolve_path(node, scope, globals)
    (core.str.len(resolved) > 0) {
        @resolved_name = names.find(globals, resolved)
        out resolved_name.type
    }
    (count > 2) {
        @resolved_enum = names.resolve_name(names.path_prefix(node), scope.module, globals)
        @enum_symbol = names.find(globals, resolved_enum)
        (enum_symbol.kind == "enum") { out core.str.add("enum:", resolved_enum) }
    }
    (count == 2) {
        @local = names.find(scope.names, name)
        (core.str.len(local.name) > 0) { out local.type }
        @global = names.find(globals, name)
        (core.str.len(global.name) > 0) { out global.type }
        (name == "error") { out "error" }
        out "unknown"
    }
    (name == "host") { out "module-path" }
    (name == "world") { out "module-path" }
    (name == "visual") { out "module-path" }
    (name == "ui") { out "module-path" }
    (name == "core") { out "module-path" }
    (name == "error") { out "error" }
    @enum_model = names.find(globals, name)
    (enum_model.kind == "enum") {
        (count == 3) { out core.str.add("enum:", name) }
    }
    @local_value = names.find(scope.names, name)
    @type = local_value.type
    (type == "unknown") {
        @global_value = names.find(globals, name)
        type = global_value.type
    }
    @index = 2
    drum (count) {
        (index < count) {
            @was_box = core.str.starts_with(type, "box:")
            (was_box == yes) {
                @field = box_field(globals, tail(type, 4), core.group.item(parts, index))
                type = field.type
            }
            (was_box == no) { type = "unknown" }
            index = index + 1
        }
    }
    out type
}

skill call_type(node, scope, globals) {
    @plain = names.plain(node)
    @callee = names.plain(core.group.item(plain, 1))
    (core.group.item(callee, 0) == "path") {
        @name = core.group.item(callee, 1)
        @part_count = core.group.count(callee)
        (part_count == 2) {
            @global = names.find(globals, name)
            (global.kind == "box") { out core.str.add("box:", name) }
        }
        @full = name
        @part_index = 2
        drum (part_count) {
            (part_index < part_count) { full = core.str.add(full, core.str.add(".", core.group.item(callee, part_index))) part_index = part_index + 1 }
        }
        (is_fixed_type(full) == yes) { out full }
        (full == "core.u8.from") { out "u8" }
        (full == "core.u16.from") { out "u16" }
        (full == "core.u32.from") { out "u32" }
        (full == "core.i32.from") { out "i32" }
        (full == "core.usize.from") { out "usize" }
        (core.str.starts_with(full, "core.bits32.") == yes) { out "bits32" }
        (full == "core.address.add") { out "address" }
        (full == "core.group.count") { out "number" }
        (full == "core.group.at") { out group_item_type(value_type(core.group.item(plain, 2), scope, globals)) }
        (full == "core.group.item") { out group_item_type(value_type(core.group.item(plain, 2), scope, globals)) }
        (full == "core.group.add") { out group_type(merge(group_item_type(value_type(core.group.item(plain, 2), scope, globals)), value_type(core.group.item(plain, 3), scope, globals))) }
        (full == "core.group.append") { out group_type(merge(group_item_type(value_type(core.group.item(plain, 2), scope, globals)), value_type(core.group.item(plain, 3), scope, globals))) }
        (full == "core.mem.load8") { out "number" }
        (full == "core.mem.load16") { out "number" }
        (full == "core.mem.load32") { out "number" }
        (full == "core.mem.store8") { out "none" }
        (full == "core.mem.store16") { out "none" }
        (full == "core.mem.store32") { out "none" }
        (full == "core.mem.store_address32") { out "none" }
        (full == "core.cpu.wait") { out "none" }
        (full == "core.cpu.fence") { out "none" }
        (full == "core.file.read") { out "string" }
        (full == "core.str.line_count") { out "number" }
        (full == "core.str.len") { out "number" }
        (full == "core.str.at") { out "string" }
        (full == "core.str.byte") { out "number" }
        (full == "core.str.slice") { out "string" }
        (full == "core.str.join") { out "string" }
        (full == "core.str.add") { out "string" }
        (full == "core.str.eq") { out "answer" }
        (full == "core.str.is_empty") { out "answer" }
        (full == "core.str.starts_with") { out "answer" }
        (full == "core.str.ends_with") { out "answer" }
        (full == "core.str.contains") { out "answer" }
        (full == "core.str.trim") { out "string" }
        (full == "core.str.upper") { out "string" }
        (full == "core.str.lower") { out "string" }
        (full == "core.str.split") { out "group:string" }
        (full == "core.num.parse") { out "number" }
        (full == "core.num.abs") { out "number" }
        (full == "core.num.min") { out "number" }
        (full == "core.num.max") { out "number" }
        (full == "core.num.round") { out "number" }
        (full == "core.io.show") { out "none" }
        (full == "core.file.write") { out "none" }
    }
    out "unknown"
}

skill block_value_type(block, scope, globals) {
    @plain = names.plain(block)
    @count = core.group.count(plain)
    (count == 1) { out "none" }
    @last = names.plain(core.group.item(plain, count - 1))
    @tag = core.group.item(last, 0)
    (tag == "expr") { out value_type(core.group.item(last, 1), scope, globals) }
    (tag == "out") { out value_type(core.group.item(last, 1), scope, globals) }
    out "none"
}

skill value_type(node, scope, globals) {
    @plain = names.plain(node)
    @tag = core.group.item(plain, 0)
    (tag == "number") { out "number" }
    (tag == "wide-number") { out "number" }
    (tag == "string") { out "string" }
    (tag == "answer") { out "answer" }
    (tag == "none") { out "none" }
    (tag == "enum-value") { out "enum-value" }
    (tag == "path") { out path_type(node, scope, globals) }
    (tag == "box-new") {
        @box_name = names.resolve_name(core.group.item(plain, 1), scope.module, globals)
        out core.str.add("box:", box_name)
    }
    (tag == "call") { out call_type(node, scope, globals) }
    (tag == "group") {
        @type = "unknown"
        @index = 1
        @count = core.group.count(plain)
        drum (count) {
            (index < count) { type = merge(type, value_type(core.group.item(plain, index), scope, globals)) }
            index = index + 1
        }
        out group_type(type)
    }
    (tag == "binary") {
        @operator = core.group.item(plain, 1)
        (operator == "==") { out "answer" }
        (operator == ">") { out "answer" }
        (operator == "<") { out "answer" }
        @left_type = value_type(core.group.item(plain, 2), scope, globals)
        (is_fixed_type(left_type) == yes) { out left_type }
        out "number"
    }
    (tag == "rescue") {
        @left = value_type(core.group.item(plain, 1), scope, globals)
        @child = names.Scope { names = scope.names subject = scope.subject module = scope.module }
        child.names = names.put(child.names, core.group.item(plain, 2), "variable", "error")
        out merge(left, block_value_type(core.group.item(plain, 3), child, globals))
    }
    out "unknown"
}
