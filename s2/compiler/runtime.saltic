  lw t1, 4(t3)
  lw t2, 8(t3)
  srai t1, t1, 3
  srai t2, t2, 3
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  or t3, t1, t2
  sw t3, 0(t0)
  addi a0, zero, 2
