rt_mem_store_address32:
  andi t0, a0, -8
  lw t1, 4(t0)
  lw t2, 8(t0)
  srai t1, t1, 3
  srai t2, t2, 3
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  or t0, t1, t2
  srai a1, a1, 3
