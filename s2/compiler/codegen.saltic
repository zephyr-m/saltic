use core
use s2.compiler.state

skill compiler_box_field_symbol(compiler, box_name, field_name) {
    @box = state.compiler_symbol_find(compiler.boxes, box_name)
    @result = state.CompilerSymbol {}
    @index = 2
    @count = core.group.count(state.compiler_plain(box.node))
    drum (count) {
        (index < count) {
            @member = state.compiler_part(box.node, index)
            (state.compiler_tag(member) == "field") {
                (state.compiler_part(member, 1) == field_name) { result = state.CompilerSymbol { name = field_name kind = "field" node = member } }
            }
            index = index + 1
        }
    }
    out result
}

skill compiler_error_value(compiler, name) {
    (name == "FixedIntegerOverflow") { out 6 * 8 + state.COMPILER_TAG_ERROR }
    @error_item = state.compiler_symbol_find(compiler.errors, name)
    (core.str.len(error_item.name) == 0) {
        @id = core.group.count(compiler.errors) + 1
        compiler.errors = state.compiler_symbol_add(compiler.errors, name, "error", [], id)
        error_item = state.compiler_symbol_find(compiler.errors, name)
    }
    out error_item.value * 8 + state.COMPILER_TAG_ERROR
}

skill compiler_compile_path(compiler, node) {
    @parts = state.compiler_plain(node)
    @count = core.group.count(parts)
    @name = core.group.item(parts, 1)
    @path_name = state.compiler_path_text(parts)
    @constant_name = ""
    @constant = state.CompilerSymbol {}
    (name == "error") {
        (count == 3) { out state.compiler_load_immediate(compiler, "a0", compiler_error_value(compiler, core.group.item(parts, 2))) }
    }
    (count > 2) {
        @enum_text = core.group.item(parts, 1)
        @enum_index = 2
        drum (count - 1) {
            (enum_index < count - 1) { enum_text = core.str.add(enum_text, core.str.add(".", core.group.item(parts, enum_index))) enum_index = enum_index + 1 }
        }
        @enum_name = compiler_resolve_symbol(compiler.enums, compiler.aliases, enum_text, compiler.current_function.module)
        (core.str.len(enum_name) > 0) {
            @full_name = core.str.add(enum_name, ".")
            full_name = core.str.add(full_name, core.group.item(parts, count - 1))
            @variant = state.compiler_symbol_find(compiler.variants, full_name)
            out state.compiler_load_immediate(compiler, "a0", variant.value)
        }
    }
    (state.compiler_symbol_has(compiler.current_function.slots, name) == yes) {
        @slot = state.compiler_slot(compiler, name)
        compiler = state.compiler_emit(compiler, core.str.add("  lw a0, ", core.str.add(core.num.text(slot), "(s0)")))
    }
    (state.compiler_symbol_has(compiler.current_function.slots, name) == no) {
        constant_name = compiler_resolve_symbol(compiler.constants, compiler.aliases, path_name, compiler.current_function.module)
        constant = state.compiler_symbol_find(compiler.constants, constant_name)
        (core.str.len(constant.name) > 0) {
            @caller_module = compiler.current_function.module
            compiler.current_function.module = constant.text
            compiler = compiler_expression(compiler, constant.node)
            compiler.current_function.module = caller_module
        }
        (core.str.len(constant.name) == 0) {
            @subject_field = compiler_box_field_symbol(compiler, compiler.current_function.subject, name)
            (core.str.len(subject_field.name) > 0) {
                @self_slot = state.compiler_slot(compiler, "$self")
                compiler = state.compiler_emit(compiler, core.str.add("  lw a0, ", core.str.add(core.num.text(self_slot), "(s0)")))
                compiler = state.compiler_push(compiler, "a0")
                compiler = state.compiler_load_immediate(compiler, "a1", state.compiler_field(compiler, name))
                compiler = state.compiler_pop(compiler, "a0")
                compiler = state.compiler_emit(compiler, "  call rt_box_get")
            }
        }
    }
    @index = 2
    (core.str.len(constant.name) > 0) { index = count }
    drum (count) {
        (index < count) {
            compiler = state.compiler_push(compiler, "a0")
            compiler = state.compiler_load_immediate(compiler, "a1", state.compiler_field(compiler, core.group.item(parts, index)))
            compiler = state.compiler_pop(compiler, "a0")
            compiler = state.compiler_emit(compiler, "  call rt_box_get")
            index = index + 1
        }
    }
    out compiler
}

skill compiler_compile_binary(compiler, operator, left, right) {
    compiler = compiler_expression(compiler, left)
    compiler = state.compiler_push(compiler, "a0")
    compiler = compiler_expression(compiler, right)
    compiler = state.compiler_emit(compiler, "  addi a1, a0, 0")
    compiler = state.compiler_pop(compiler, "a0")
    @target = ""
    @fixed = compiler_is_fixed_type(compiler_infer_type(compiler, left))
    (operator == "+") { target = "rt_add" }
    (operator == "-") { target = "rt_sub" }
    (operator == "*") { target = "rt_mul" }
    (operator == "/") { target = "rt_div" }
    (operator == "==") { target = "rt_equal" }
    (operator == ">") { target = "rt_greater" }
    (operator == "<") { target = "rt_less" }
    (fixed == yes) {
        (operator == "+") { target = "rt_fixed_add" }
        (operator == "-") { target = "rt_fixed_sub" }
        (operator == "*") { target = "rt_fixed_mul" }
        (operator == "/") { target = "rt_fixed_div" }
        (operator == "==") { target = "rt_fixed_equal" }
        (operator == ">") { target = "rt_fixed_greater" }
        (operator == "<") { target = "rt_fixed_less" }
    }
    out state.compiler_emit(compiler, core.str.add("  call ", target))
}

skill compiler_is_fixed_type(type) {
    (type == "u8") { out yes }
    (type == "u16") { out yes }
    (type == "u32") { out yes }
    (type == "i32") { out yes }
    (type == "bits32") { out yes }
    (type == "address") { out yes }
    (type == "usize") { out yes }
    out no
}

skill compiler_fixed_kind(type) {
    (type == "u8") { out 1 }
    (type == "u16") { out 2 }
    (type == "u32") { out 3 }
    (type == "i32") { out 4 }
    (type == "bits32") { out 5 }
    (type == "address") { out 6 }
    out 7
}

skill compiler_compile_rescue(compiler, node) {
    @plain = state.compiler_plain(node)
    @done = state.compiler_label(compiler, "rescue_done")
    compiler = compiler_expression(compiler, core.group.item(plain, 1))
    compiler = state.compiler_emit(compiler, "  andi t0, a0, 7")
    compiler = state.compiler_emit(compiler, core.str.add("  addi t1, zero, ", core.num.text(state.COMPILER_TAG_ERROR)))
    compiler = state.compiler_emit(compiler, core.str.add("  bne t0, t1, ", done))
    @slot = state.compiler_slot(compiler, core.group.item(plain, 2))
    compiler = state.compiler_emit(compiler, core.str.add("  sw a0, ", core.str.add(core.num.text(slot), "(s0)")))
    compiler = compiler_compile_block(compiler, core.group.item(plain, 3), yes)
    out state.compiler_emit(compiler, core.str.add(done, ":"))
}

skill compiler_box_has_skill(compiler, box_name, skill_name) {
    @box = state.compiler_symbol_find(compiler.boxes, box_name)
    @found = no
    @index = 2
    @count = core.group.count(state.compiler_plain(box.node))
    drum (count) {
        (index < count) {
            @member = state.compiler_part(box.node, index)
            (state.compiler_tag(member) == "subject-skill") {
                (state.compiler_part(member, 1) == skill_name) { found = yes }
            }
            index = index + 1
        }
    }
    out found
}

skill compiler_infer_type(compiler, node) {
    @plain = state.compiler_plain(node)
    @tag = core.group.item(plain, 0)
    (tag == "box-new") {
        @box_name = compiler_resolve_symbol(compiler.boxes, compiler.aliases, core.group.item(plain, 1), compiler.current_function.module)
        out core.str.add("box:", box_name)
    }
    (tag == "path") {
        @name = core.group.item(plain, 1)
        @type_item = state.compiler_type_find(compiler.current_function.types, name)
        @type = type_item.text
        (core.group.count(plain) == 2) { out type }
        (core.str.starts_with(type, "box:") == yes) {
            @field = compiler_box_field_symbol(compiler, core.str.slice(type, 4, core.str.len(type)), core.group.item(plain, 2))
            (core.str.len(field.name) > 0) {
                @value = state.compiler_part(field.node, 2)
                (state.compiler_tag(value) == "box-new") { out core.str.add("box:", state.compiler_part(value, 1)) }
            }
        }
        out "unknown"
    }
    (tag == "call") {
        @callee = state.compiler_plain(core.group.item(plain, 1))
        (state.compiler_tag(callee) == "path") {
            @full = state.compiler_path_text(callee)
            (compiler_is_fixed_type(full) == yes) { out full }
            (full == "core.u8.from") { out "u8" }
            (full == "core.u16.from") { out "u16" }
            (full == "core.u32.from") { out "u32" }
            (full == "core.i32.from") { out "i32" }
            (full == "core.usize.from") { out "usize" }
            (core.str.starts_with(full, "core.bits32.") == yes) { out "bits32" }
            (full == "core.address.add") { out "address" }
            (core.group.count(plain) > 2) {
                (compiler_infer_type(compiler, core.group.item(plain, 2)) == "address") {
                    (full == "core.mem.load8") { out "u8" }
                    (full == "core.mem.load16") { out "u16" }
                    (full == "core.mem.load32") { out "u32" }
                }
            }
            @box_name = compiler_resolve_symbol(compiler.boxes, compiler.aliases, full, compiler.current_function.module)
            (core.str.len(box_name) > 0) { out core.str.add("box:", box_name) }
        }
        out "unknown"
    }
    (tag == "binary") {
        @operator = core.group.item(plain, 1)
        (operator == "==") { out "answer" }
        (operator == ">") { out "answer" }
        (operator == "<") { out "answer" }
        out compiler_infer_type(compiler, core.group.item(plain, 2))
    }
    (tag == "rescue") { out compiler_infer_type(compiler, core.group.item(plain, 1)) }
    out "unknown"
}

skill compiler_name_head(name) {
    @index = 0
    @count = core.str.len(name)
    drum (count) {
        (index < count) {
            (core.str.at(name, index) == ".") { out core.str.slice(name, 0, index) }
            index = index + 1
        }
    }
    out name
}

skill compiler_name_tail(name) {
    @index = 0
    @count = core.str.len(name)
    drum (count) {
        (index < count) {
            (core.str.at(name, index) == ".") { out core.str.slice(name, index, count) }
            index = index + 1
        }
    }
    out ""
}

skill compiler_resolve_symbol(symbols, aliases, name, module) {
    (state.compiler_symbol_has(symbols, name) == yes) { out name }
    @local = state.compiler_qualified(module, name)
    (state.compiler_symbol_has(symbols, local) == yes) { out local }
    @head = compiler_name_head(name)
    @import = state.compiler_symbol_find(aliases, state.compiler_alias_key(module, head))
    (import.kind == "import") {
        @candidate = core.str.add(import.text, compiler_name_tail(name))
        (state.compiler_symbol_has(symbols, candidate) == yes) { out candidate }
    }
    out ""
}

skill compiler_resolve_skill(compiler, path) {
    out compiler_resolve_symbol(compiler.skills, compiler.aliases, state.compiler_path_text(path), compiler.current_function.module)
}

skill compiler_call_arguments(node) {
    @plain = state.compiler_plain(node)
    out state.compiler_group_slice(plain, 2, core.group.count(plain))
}

skill compiler_compile_arguments(compiler, args) {
    @index = 0
    @count = core.group.count(args)
    drum (count) {
        (index < count) {
            compiler = compiler_expression(compiler, core.group.item(args, index))
            compiler = state.compiler_push(compiler, "a0")
            index = index + 1
        }
    }
    index = 0
    drum (count) {
        (index < count) {
            @register = core.str.add("a", core.num.text(index))
            @offset = core.num.text((count - index - 1) * 4)
            compiler = state.compiler_emit(compiler, core.str.add("  lw ", core.str.add(register, core.str.add(", ", core.str.add(offset, "(sp)")))))
            index = index + 1
        }
    }
    (count > 0) { compiler = state.compiler_emit(compiler, core.str.add("  addi sp, sp, ", core.num.text(count * 4))) }
    out compiler
}

skill compiler_compile_show(compiler, args) {
    @index = 0
    @count = core.group.count(args)
    drum (count) {
        (index < count) {
            compiler = compiler_expression(compiler, core.group.item(args, index))
            @type = compiler_infer_type(compiler, core.group.item(args, index))
            (compiler_is_fixed_type(type) == yes) { compiler = state.compiler_emit(compiler, "  call rt_fixed_show") }
            (compiler_is_fixed_type(type) == no) { compiler = state.compiler_emit(compiler, "  call rt_show") }
            index = index + 1
        }
    }
    compiler = state.compiler_emit(compiler, "  call rt_newline")
    out state.compiler_load_immediate(compiler, "a0", state.COMPILER_NONE)
}

skill compiler_intrinsic(name) {
    (name == "core.group.count") { out "rt_group_count" }
    (name == "core.group.at") { out "rt_group_at" }
    (name == "core.group.item") { out "rt_group_at" }
    (name == "core.group.add") { out "rt_group_add" }
    (name == "core.group.append") { out "rt_group_add" }
    (name == "core.mem.load8") { out "rt_mem_load8" }
    (name == "core.mem.load16") { out "rt_mem_load16" }
    (name == "core.mem.load32") { out "rt_mem_load32" }
    (name == "core.mem.store8") { out "rt_mem_store8" }
    (name == "core.mem.store16") { out "rt_mem_store16" }
    (name == "core.mem.store32") { out "rt_mem_store32" }
    (name == "core.mem.store_address32") { out "rt_mem_store_address32" }
    (name == "core.cpu.wait") { out "rt_cpu_wait" }
    (name == "core.cpu.fence") { out "rt_cpu_fence" }
    (name == "core.file.read") { out "rt_file_read" }
    (name == "core.file.write") { out "rt_file_write" }
    (name == "core.str.line_count") { out "rt_line_count" }
    (name == "core.str.add") { out "rt_string_add" }
    (name == "core.str.join") { out "rt_string_add" }
    (name == "core.str.len") { out "rt_string_len" }
    (name == "core.str.at") { out "rt_string_at" }
    (name == "core.str.byte") { out "rt_string_byte" }
    (name == "core.str.slice") { out "rt_string_slice" }
    (name == "core.str.contains") { out "rt_string_contains" }
    (name == "core.str.starts_with") { out "rt_string_starts_with" }
    (name == "core.str.ends_with") { out "rt_string_ends_with" }
    (name == "core.str.lower") { out "rt_string_lower" }
    (name == "core.str.upper") { out "rt_string_upper" }
    (name == "core.num.text") { out "rt_number_text" }
    out ""
}

skill compiler_ascii_code(ch) {
    (ch == "\n") { out 10 }
    (ch == "\t") { out 9 }
    @index = 0
    @length = core.str.len(state.COMPILER_PRINTABLE)
    @code = 0
    drum (length) {
        (index < length) {
            (core.str.at(state.COMPILER_PRINTABLE, index) == ch) { code = index + 32 }
            index = index + 1
        }
    }
    out code
}

skill compiler_string_find(compiler, text) {
    @result = state.CompilerSymbol {}
    @index = 0
    @count = core.group.count(compiler.strings)
    drum (count) {
        (index < count) {
            @item = core.group.item(compiler.strings, index)
            (item.text == text) { result = item }
            index = index + 1
        }
    }
    out result
}

skill compiler_string_label(compiler, text) {
    @known = compiler_string_find(compiler, text)
    (core.str.len(known.name) > 0) { out known.name }
    @label = state.compiler_label(compiler, "string")
    @values = state.CompilerOutput()
    @index = 0
    @length = core.str.len(text)
    drum (length) {
        (index < length) {
            (index > 0) { values = state.compiler_output_add(values, ", ") }
            values = state.compiler_output_add(values, core.num.text(core.str.byte(text, index)))
            index = index + 1
        }
    }
    (length > 0) { values = state.compiler_output_add(values, ", ") }
    values = state.compiler_output_add(values, "0")
    @values_text = state.compiler_output_text(values)
    @datum = core.str.add(label, ":\n  .word ")
    datum = core.str.add(datum, core.num.text(length))
    datum = core.str.add(datum, "\n  .byte ")
    datum = core.str.add(datum, values_text)
    datum = core.str.add(datum, "\n  .balign 8")
    compiler.data = core.group.add(compiler.data, datum)
    compiler.strings = core.group.add(compiler.strings, state.CompilerSymbol { name = label kind = "string" text = text })
    out label
}

skill compiler_compile_group(compiler, items) {
    @index = 0
    @count = core.group.count(items)
    drum (count) {
        (index < count) {
            compiler = compiler_expression(compiler, core.group.item(items, index))
            compiler = state.compiler_push(compiler, "a0")
            index = index + 1
        }
    }
    compiler = state.compiler_load_immediate(compiler, "a0", state.compiler_align8(4 + count * 4))
    compiler = state.compiler_emit(compiler, "  call rt_alloc")
    compiler = state.compiler_emit(compiler, core.str.add("  addi t3, zero, ", core.num.text(count)))
    compiler = state.compiler_emit(compiler, "  sw t3, 0(a0)")
    index = 0
    drum (count) {
        (index < count) {
            @source_offset = core.num.text((count - index - 1) * 4)
            @target_offset = core.num.text(4 + index * 4)
            compiler = state.compiler_emit(compiler, core.str.add("  lw t0, ", core.str.add(source_offset, "(sp)")))
            compiler = state.compiler_emit(compiler, core.str.add("  sw t0, ", core.str.add(target_offset, "(a0)")))
            index = index + 1
        }
    }
    (count > 0) { compiler = state.compiler_emit(compiler, core.str.add("  addi sp, sp, ", core.num.text(count * 4))) }
    out state.compiler_emit(compiler, core.str.add("  ori a0, a0, ", core.num.text(state.COMPILER_TAG_GROUP)))
}

skill compiler_box_override(overrides, field_name) {
    @result = []
    @index = 0
    @count = core.group.count(overrides)
    drum (count) {
        (index < count) {
            @field = state.compiler_plain(core.group.item(overrides, index))
            (core.group.item(field, 1) == field_name) { result = core.group.item(field, 2) }
            index = index + 1
        }
    }
    out result
}

skill compiler_compile_box(compiler, name, overrides) {
    @model = state.compiler_symbol_find(compiler.boxes, name)
    @fields = []
    @index = 2
    @member_count = core.group.count(state.compiler_plain(model.node))
    drum (member_count) {
        (index < member_count) {
            @member = state.compiler_part(model.node, index)
            (state.compiler_tag(member) == "field") { fields = core.group.add(fields, member) }
            index = index + 1
        }
    }
    @count = core.group.count(fields)
    index = 0
    drum (count) {
        (index < count) {
            @field = core.group.item(fields, index)
            @value = compiler_box_override(overrides, state.compiler_part(field, 1))
            @default_value = no
            (core.group.count(value) == 0) { value = state.compiler_part(field, 2) default_value = yes }
            @caller_module = compiler.current_function.module
            (default_value == yes) { compiler.current_function.module = model.text }
            compiler = compiler_expression(compiler, value)
            compiler.current_function.module = caller_module
            compiler = state.compiler_push(compiler, "a0")
            index = index + 1
        }
    }
    compiler = state.compiler_load_immediate(compiler, "a0", state.compiler_align8(4 + count * 8))
    compiler = state.compiler_emit(compiler, "  call rt_alloc")
    compiler = state.compiler_emit(compiler, core.str.add("  addi t3, zero, ", core.num.text(count)))
    compiler = state.compiler_emit(compiler, "  sw t3, 0(a0)")
    index = 0
    drum (count) {
        (index < count) {
            @field = core.group.item(fields, index)
            @field_id = state.compiler_field(compiler, state.compiler_part(field, 1))
            compiler = state.compiler_load_immediate(compiler, "t0", field_id)
            compiler = state.compiler_emit(compiler, core.str.add("  sw t0, ", core.str.add(core.num.text(4 + index * 8), "(a0)")))
            compiler = state.compiler_emit(compiler, core.str.add("  lw t0, ", core.str.add(core.num.text((count - index - 1) * 4), "(sp)")))
            compiler = state.compiler_emit(compiler, core.str.add("  sw t0, ", core.str.add(core.num.text(8 + index * 8), "(a0)")))
            index = index + 1
        }
    }
    (count > 0) { compiler = state.compiler_emit(compiler, core.str.add("  addi sp, sp, ", core.num.text(count * 4))) }
    out state.compiler_emit(compiler, core.str.add("  ori a0, a0, ", core.num.text(state.COMPILER_TAG_BOX)))
}

skill compiler_compile_call(compiler, node) {
    @plain = state.compiler_plain(node)
    @callee = state.compiler_plain(core.group.item(plain, 1))
    @args = compiler_call_arguments(node)
    @name = state.compiler_path_text(callee)
    (name == "core.io.show") { out compiler_compile_show(compiler, args) }
    (compiler_is_fixed_type(name) == yes) {
        @value = state.compiler_plain(core.group.item(args, 0))
        @value_tag = core.group.item(value, 0)
        (value_tag == "wide-number") { compiler = state.compiler_emit(compiler, core.str.add("  li a0, ", core.group.item(value, 1))) }
        (value_tag == "number") { compiler = state.compiler_load_immediate(compiler, "a0", core.group.item(value, 1)) }
        (value_tag == "binary") {
            (core.group.item(value, 1) == "-") {
                @left = state.compiler_plain(core.group.item(value, 2))
                @right = state.compiler_plain(core.group.item(value, 3))
                (core.group.item(left, 0) == "number") {
                    (core.group.item(left, 1) == 0) {
                        @right_tag = core.group.item(right, 0)
                        (right_tag == "number") { compiler = state.compiler_emit(compiler, core.str.add("  li a0, -", core.num.text(core.group.item(right, 1)))) value_tag = "ready" }
                        (right_tag == "wide-number") { compiler = state.compiler_emit(compiler, core.str.add("  li a0, -", core.group.item(right, 1))) value_tag = "ready" }
                    }
                }
            }
        }
        (value_tag == "wide-number") { value_tag = "ready" }
        (value_tag == "number") { value_tag = "ready" }
        (value_tag == "ready") { compiler = compiler }
        (value_tag == "ready") { value_tag = "done" }
        (value_tag == "done") { compiler = compiler }
        ((value_tag == "done") == no) {
            compiler = compiler_expression(compiler, core.group.item(args, 0))
            @source_type = compiler_infer_type(compiler, core.group.item(args, 0))
            (compiler_is_fixed_type(source_type) == yes) {
                compiler = state.compiler_emit(compiler, "  andi a0, a0, -8")
                compiler = state.compiler_emit(compiler, "  lw a0, 0(a0)")
            }
            (compiler_is_fixed_type(source_type) == no) { compiler = state.compiler_emit(compiler, "  srai a0, a0, 3") }
        }
        compiler = state.compiler_load_immediate(compiler, "a1", compiler_fixed_kind(name))
        out state.compiler_emit(compiler, "  call rt_fixed_new")
    }
    @conversion = ""
    (name == "core.u8.from") { conversion = "u8" }
    (name == "core.u16.from") { conversion = "u16" }
    (name == "core.u32.from") { conversion = "u32" }
    (name == "core.i32.from") { conversion = "i32" }
    (name == "core.usize.from") { conversion = "usize" }
    (core.str.len(conversion) > 0) {
        compiler = compiler_compile_arguments(compiler, args)
        compiler = state.compiler_load_immediate(compiler, "a1", compiler_fixed_kind(conversion))
        out state.compiler_emit(compiler, "  call rt_fixed_convert")
    }
    @fixed_target = ""
    (name == "core.bits32.and") { fixed_target = "rt_fixed_and" }
    (name == "core.bits32.or") { fixed_target = "rt_fixed_or" }
    (name == "core.bits32.xor") { fixed_target = "rt_fixed_xor" }
    (name == "core.bits32.not") { fixed_target = "rt_fixed_not" }
    (name == "core.bits32.shift_left") { fixed_target = "rt_fixed_shift_left" }
    (name == "core.bits32.shift_right") { fixed_target = "rt_fixed_shift_right" }
    (name == "core.address.add") { fixed_target = "rt_fixed_add" }
    (core.str.len(fixed_target) > 0) {
        compiler = compiler_compile_arguments(compiler, args)
        out state.compiler_emit(compiler, core.str.add("  call ", fixed_target))
    }
    @memory_target = ""
    (core.group.count(args) > 0) {
        (compiler_infer_type(compiler, core.group.item(args, 0)) == "address") {
            (name == "core.mem.load8") { memory_target = "rt_fixed_mem_load8" }
            (name == "core.mem.load16") { memory_target = "rt_fixed_mem_load16" }
            (name == "core.mem.load32") { memory_target = "rt_fixed_mem_load32" }
            (name == "core.mem.store8") { memory_target = "rt_fixed_mem_store8" }
            (name == "core.mem.store16") { memory_target = "rt_fixed_mem_store16" }
            (name == "core.mem.store32") { memory_target = "rt_fixed_mem_store32" }
        }
    }
    (core.str.len(memory_target) > 0) {
        compiler = compiler_compile_arguments(compiler, args)
        out state.compiler_emit(compiler, core.str.add("  call ", memory_target))
    }
    @resolved_box = compiler_resolve_symbol(compiler.boxes, compiler.aliases, name, compiler.current_function.module)
    (core.str.len(resolved_box) > 0) { out compiler_compile_box(compiler, resolved_box, []) }
    (core.group.count(callee) == 2) {
        @short_name = core.group.item(callee, 1)
        (core.str.len(compiler.current_function.subject) > 0) {
            (compiler_box_has_skill(compiler, compiler.current_function.subject, short_name) == yes) {
                @with_self = state.compiler_group_prepend(["path", "$self"], args)
                compiler = compiler_compile_arguments(compiler, with_self)
                @target = core.str.add(compiler.current_function.subject, ".")
                target = core.str.add(target, short_name)
                out state.compiler_emit(compiler, core.str.add("  call saltic_", state.compiler_safe(target)))
            }
        }
    }
    (core.group.count(callee) == 3) {
        @receiver = ["path", core.group.item(callee, 1)]
        @receiver_type = compiler_infer_type(compiler, receiver)
        (core.str.starts_with(receiver_type, "box:") == yes) {
            @box_name = core.str.slice(receiver_type, 4, core.str.len(receiver_type))
            @method = core.group.item(callee, 2)
            (compiler_box_has_skill(compiler, box_name, method) == yes) {
                @with_receiver = state.compiler_group_prepend(receiver, args)
                compiler = compiler_compile_arguments(compiler, with_receiver)
                @target = core.str.add(box_name, ".")
                target = core.str.add(target, method)
                out state.compiler_emit(compiler, core.str.add("  call saltic_", state.compiler_safe(target)))
            }
        }
    }
    @target = compiler_intrinsic(name)
    (core.str.len(target) == 0) {
        @resolved_skill = compiler_resolve_skill(compiler, callee)
        (core.str.len(resolved_skill) > 0) { target = core.str.add("saltic_", state.compiler_safe(resolved_skill)) }
    }
    compiler = compiler_compile_arguments(compiler, args)
    out state.compiler_emit(compiler, core.str.add("  call ", target))
}

skill compiler_expression(compiler, node) {
    @plain = state.compiler_plain(node)
    @tag = core.group.item(plain, 0)
    (tag == "number") { out state.compiler_load_immediate(compiler, "a0", core.group.item(plain, 1) * 8) }
    (tag == "string") {
        @label = compiler_string_label(compiler, core.group.item(plain, 1))
        compiler = state.compiler_emit(compiler, core.str.add("  la a0, ", label))
        out state.compiler_emit(compiler, core.str.add("  ori a0, a0, ", core.num.text(state.COMPILER_TAG_STRING)))
    }
    (tag == "answer") {
        (core.group.item(plain, 1) == "yes") { out state.compiler_load_immediate(compiler, "a0", state.COMPILER_YES) }
        out state.compiler_load_immediate(compiler, "a0", state.COMPILER_NO)
    }
    (tag == "none") { out state.compiler_load_immediate(compiler, "a0", state.COMPILER_NONE) }
    (tag == "path") { out compiler_compile_path(compiler, node) }
    (tag == "binary") { out compiler_compile_binary(compiler, core.group.item(plain, 1), core.group.item(plain, 2), core.group.item(plain, 3)) }
    (tag == "call") { out compiler_compile_call(compiler, node) }
    (tag == "group") { out compiler_compile_group(compiler, state.compiler_group_slice(plain, 1, core.group.count(plain))) }
    (tag == "box-new") {
        @box_name = compiler_resolve_symbol(compiler.boxes, compiler.aliases, core.group.item(plain, 1), compiler.current_function.module)
        out compiler_compile_box(compiler, box_name, state.compiler_group_slice(plain, 2, core.group.count(plain)))
    }
    (tag == "rescue") { out compiler_compile_rescue(compiler, node) }
    (tag == "enum-value") {
        @variant = state.compiler_symbol_find(compiler.variants, core.group.item(plain, 1))
        out state.compiler_load_immediate(compiler, "a0", variant.value)
    }
    out compiler
}

skill compiler_compile_block(compiler, block, keep) {
    @plain = state.compiler_plain(block)
    @index = 1
    @count = core.group.count(plain)
    drum (count) {
        (index < count) {
            @last = no
            (keep == yes) {
                (index + 1 == count) { last = yes }
            }
            compiler = compiler_compile_statement(compiler, core.group.item(plain, index), last)
            index = index + 1
        }
    }
    (keep == yes) {
        (count == 1) { compiler = state.compiler_load_immediate(compiler, "a0", state.COMPILER_NONE) }
    }
    out compiler
}

skill compiler_compile_statement(compiler, node, keep) {
    @plain = state.compiler_plain(node)
    @tag = core.group.item(plain, 0)
    (tag == "var") {
        @value = core.group.item(plain, 2)
        compiler = compiler_expression(compiler, value)
        @slot = state.compiler_slot(compiler, core.group.item(plain, 1))
        compiler = state.compiler_emit(compiler, core.str.add("  sw a0, ", core.str.add(core.num.text(slot), "(s0)")))
        @type = compiler_infer_type(compiler, value)
        @known = state.compiler_type_find(compiler.current_function.types, core.group.item(plain, 1))
        (type == "unknown") {
            (core.str.len(known.name) == 0) { compiler.current_function.types = state.compiler_type_set(compiler.current_function.types, core.group.item(plain, 1), type) }
        }
        (type == "unknown") { out compiler }
        compiler.current_function.types = state.compiler_type_set(compiler.current_function.types, core.group.item(plain, 1), type)
        out compiler
    }
    (tag == "assign") {
        @value = core.group.item(plain, 2)
        compiler = compiler_expression(compiler, value)
        @slot = state.compiler_slot(compiler, core.group.item(plain, 1))
        compiler = state.compiler_emit(compiler, core.str.add("  sw a0, ", core.str.add(core.num.text(slot), "(s0)")))
        @type = compiler_infer_type(compiler, value)
        @known = state.compiler_type_find(compiler.current_function.types, core.group.item(plain, 1))
        (type == "unknown") {
            (core.str.len(known.name) == 0) { compiler.current_function.types = state.compiler_type_set(compiler.current_function.types, core.group.item(plain, 1), type) }
        }
        (type == "unknown") { out compiler }
        compiler.current_function.types = state.compiler_type_set(compiler.current_function.types, core.group.item(plain, 1), type)
        out compiler
    }
    (tag == "field-assign") {
        @target = state.compiler_plain(core.group.item(plain, 1))
        @part_count = core.group.count(target)
        @base = state.compiler_group_slice(target, 0, part_count - 1)
        compiler = compiler_expression(compiler, base)
        compiler = state.compiler_push(compiler, "a0")
        compiler = compiler_expression(compiler, core.group.item(plain, 2))
        compiler = state.compiler_emit(compiler, "  addi a2, a0, 0")
        compiler = state.compiler_pop(compiler, "a0")
        compiler = state.compiler_load_immediate(compiler, "a1", state.compiler_field(compiler, core.group.item(target, part_count - 1)))
        out state.compiler_emit(compiler, "  call rt_box_set")
    }
    (tag == "out") {
        compiler = compiler_expression(compiler, core.group.item(plain, 1))
        out state.compiler_emit(compiler, core.str.add("  j ", compiler.current_function.end))
    }
    (tag == "expr") { out compiler_expression(compiler, core.group.item(plain, 1)) }
    (tag == "if") {
        @end = state.compiler_label(compiler, "if_end")
        compiler = compiler_expression(compiler, core.group.item(plain, 1))
        compiler = state.compiler_emit(compiler, core.str.add("  addi t0, zero, ", core.num.text(state.COMPILER_NO)))
        compiler = state.compiler_emit(compiler, core.str.add("  beq a0, t0, ", end))
        compiler = state.compiler_emit(compiler, core.str.add("  addi t0, zero, ", core.num.text(state.COMPILER_NONE)))
        compiler = state.compiler_emit(compiler, core.str.add("  beq a0, t0, ", end))
        compiler = state.compiler_emit(compiler, core.str.add("  beq a0, zero, ", end))
        compiler = compiler_compile_block(compiler, core.group.item(plain, 2), keep)
        out state.compiler_emit(compiler, core.str.add(end, ":"))
    }
    (tag == "switch") {
        @end = state.compiler_label(compiler, "switch_end")
        compiler = compiler_expression(compiler, core.group.item(plain, 1))
        compiler = state.compiler_emit(compiler, "  addi t2, a0, 0")
        @index = 2
        @count = core.group.count(plain)
        drum (count) {
            (index < count) {
                @case_node = state.compiler_plain(core.group.item(plain, index))
                @next = state.compiler_label(compiler, "case_next")
                @variant = state.compiler_symbol_find(compiler.variants, core.group.item(case_node, 1))
                compiler = state.compiler_load_immediate(compiler, "t0", variant.value)
                compiler = state.compiler_emit(compiler, core.str.add("  bne t2, t0, ", next))
                compiler = compiler_expression(compiler, core.group.item(case_node, 2))
                compiler = state.compiler_emit(compiler, core.str.add("  j ", end))
                compiler = state.compiler_emit(compiler, core.str.add(next, ":"))
                index = index + 1
            }
        }
        out state.compiler_emit(compiler, core.str.add(end, ":"))
    }
    (tag == "drum") {
        @drum_name = core.str.add("$drum:", core.num.text(compiler.current_function.next_drum))
        compiler.current_function.next_drum = compiler.current_function.next_drum + 1
        @counter = state.compiler_slot(compiler, drum_name)
        @start = state.compiler_label(compiler, "drum")
        @end = state.compiler_label(compiler, "drum_end")
        compiler = compiler_expression(compiler, core.group.item(plain, 1))
        compiler = state.compiler_emit(compiler, "  srai a0, a0, 3")
        compiler = state.compiler_emit(compiler, core.str.add("  sw a0, ", core.str.add(core.num.text(counter), "(s0)")))
        compiler = state.compiler_emit(compiler, core.str.add(start, ":"))
        compiler = state.compiler_emit(compiler, core.str.add("  lw t0, ", core.str.add(core.num.text(counter), "(s0)")))
        compiler = state.compiler_emit(compiler, core.str.add("  beq t0, zero, ", end))
        compiler = state.compiler_emit(compiler, "  addi t0, t0, -1")
        compiler = state.compiler_emit(compiler, core.str.add("  sw t0, ", core.str.add(core.num.text(counter), "(s0)")))
        compiler = compiler_compile_block(compiler, core.group.item(plain, 2), no)
        compiler = state.compiler_emit(compiler, core.str.add("  j ", start))
        out state.compiler_emit(compiler, core.str.add(end, ":"))
    }
    out compiler
}

skill compiler_compile_function(compiler, name, params, body, subject, module) {
    @locals = state.compiler_collect_locals(params, body)
    @local_count = core.group.count(locals.names)
    @frame = state.compiler_align16((local_count + 2) * 4)
    @slots = state.compiler_make_slots(locals.names)
    @end = state.compiler_label(compiler, core.str.add(name, "_return"))
    @types = []
    @type_index = 0
    @type_count = core.group.count(params)
    drum (type_count) {
        (type_index < type_count) {
            types = state.compiler_type_set(types, core.group.item(params, type_index), "unknown")
            type_index = type_index + 1
        }
    }
    (core.str.len(subject) > 0) { types = state.compiler_type_set(types, "$self", core.str.add("box:", subject)) }
    compiler.current_function = state.CompilerFunction { name = name slots = slots end = end subject = subject module = module types = types }
    compiler = state.compiler_emit(compiler, core.str.add("saltic_", core.str.add(state.compiler_safe(name), ":")))
    compiler = state.compiler_emit(compiler, core.str.add("  addi sp, sp, -", core.num.text(frame)))
    compiler = state.compiler_emit(compiler, core.str.add("  sw ra, ", core.str.add(core.num.text(frame - 4), "(sp)")))
    compiler = state.compiler_emit(compiler, core.str.add("  sw s0, ", core.str.add(core.num.text(frame - 8), "(sp)")))
    compiler = state.compiler_emit(compiler, core.str.add("  addi s0, sp, ", core.num.text(frame)))
    @index = 0
    @param_count = core.group.count(params)
    drum (param_count) {
        (index < param_count) {
            @register = core.str.add("a", core.num.text(index))
            @slot = state.compiler_slot(compiler, core.group.item(params, index))
            compiler = state.compiler_emit(compiler, core.str.add("  sw ", core.str.add(register, core.str.add(", ", core.str.add(core.num.text(slot), "(s0)")))))
            index = index + 1
        }
    }
    compiler = compiler_compile_block(compiler, body, no)
    compiler = state.compiler_emit(compiler, core.str.add("  addi a0, zero, ", core.num.text(state.COMPILER_NONE)))
    compiler = state.compiler_emit(compiler, core.str.add("  j ", end))
    compiler = state.compiler_emit(compiler, core.str.add(end, ":"))
    compiler = state.compiler_emit(compiler, "  lw ra, -4(s0)")
    compiler = state.compiler_emit(compiler, "  lw t0, -8(s0)")
    compiler = state.compiler_emit(compiler, "  addi sp, s0, 0")
    compiler = state.compiler_emit(compiler, "  addi s0, t0, 0")
    compiler = state.compiler_emit(compiler, "  jalr zero, 0(ra)")
    compiler = state.compiler_emit_blank(compiler)
    compiler.current_function = state.CompilerFunction {}
    out compiler
}

skill compiler_compile_functions(compiler) {
    @index = 0
    @count = core.group.count(compiler.skills)
    drum (count) {
        (index < count) {
            @symbol = core.group.item(compiler.skills, index)
            @skill_node = symbol.node
            compiler = compiler_compile_function(compiler, symbol.name, state.compiler_part(skill_node, 2), state.compiler_part(skill_node, 3), "", symbol.text)
            index = index + 1
        }
    }
    @box_index = 0
    @box_count = core.group.count(compiler.boxes)
    drum (box_count) {
        (box_index < box_count) {
            @box = core.group.item(compiler.boxes, box_index)
            @member_index = 2
            @member_count = core.group.count(state.compiler_plain(box.node))
            drum (member_count) {
                (member_index < member_count) {
                    @member = state.compiler_part(box.node, member_index)
                    (state.compiler_tag(member) == "subject-skill") {
                        @name = core.str.add(box.name, ".")
                        name = core.str.add(name, state.compiler_part(member, 1))
                        @params = state.compiler_group_prepend("$self", state.compiler_part(member, 2))
                        compiler = compiler_compile_function(compiler, name, params, state.compiler_part(member, 3), box.name, state.compiler_module(box.node))
                    }
                    member_index = member_index + 1
                }
            }
            box_index = box_index + 1
        }
    }
    compiler = compiler_compile_function(compiler, "program", state.compiler_part(compiler.entry, 1), state.compiler_part(compiler.entry, 2), "", "")
    out compiler
}
