use core

Symbol = Box {
    name = ""
    kind = ""
    node = []
    value = 0
    text = ""
}

Function = Box {
    name = ""
    slots = []
    end = ""
    subject = ""
    module = ""
    types = []
    next_drum = 1
}

Names = Box {
    names = []
    next_drum = 1
}

Output = Box {
    chunks = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
}

State = Box {
    ast = []
    lines = Output {}
    data = []
    strings = []
    serial = 0
    constants = []
    boxes = []
    enums = []
    variants = []
    errors = []
    fields = []
    skills = []
    aliases = []
    entry = []
    current_function = Function {}
    next_enum_id = 1
    next_field_id = 1
}

TAG_NUMBER = 0
TAG_ANSWER = 1
TAG_NONE = 2
TAG_STRING = 3
TAG_GROUP = 4
TAG_BOX = 5
TAG_ENUM = 6
TAG_ERROR = 7

NO = TAG_ANSWER
YES = 8 + TAG_ANSWER
NONE = TAG_NONE
PRINTABLE = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

skill plain(node) {
    @plain = node
    (core.group.count(plain) == 3) {
        (core.group.item(plain, 0) == "module") { plain = core.group.item(plain, 2) }
    }
    (core.group.count(plain) == 4) {
        (core.group.item(plain, 0) == "loc") { out core.group.item(plain, 3) }
    }
    out plain
}

skill module(node) {
    (core.group.count(node) == 3) {
        (core.group.item(node, 0) == "module") { out core.group.item(node, 1) }
    }
    out ""
}

skill tag(node) {
    out core.group.item(plain(node), 0)
}

skill part(node, index) {
    out core.group.item(plain(node), index)
}

skill symbol_find(symbols, name) {
    @result = Symbol {}
    @index = 0
    @count = core.group.count(symbols)
    drum (count) {
        (index < count) {
            @item = core.group.item(symbols, index)
            (item.name == name) { result = item }
            index = index + 1
        }
    }
    out result
}

skill symbol_has(symbols, name) {
    @item = symbol_find(symbols, name)
    out core.str.len(item.name) > 0
}

skill symbol_add(symbols, name, kind, node, value) {
    out core.group.add(symbols, Symbol { name = name kind = kind node = node value = value })
}

skill symbol_add_text(symbols, name, kind, node, text) {
    out core.group.add(symbols, Symbol { name = name kind = kind node = node text = text })
}

skill type_find(types, name) {
    out symbol_find(types, name)
}

skill type_set(types, name, type) {
    @result = []
    @found = no
    @index = 0
    @count = core.group.count(types)
    drum (count) {
        (index < count) {
            @item = core.group.item(types, index)
            @next_type = item.text
            (item.name == name) { next_type = type found = yes }
            result = core.group.add(result, Symbol { name = item.name kind = "type" text = next_type })
            index = index + 1
        }
    }
    (found == no) { result = core.group.add(result, Symbol { name = name kind = "type" text = type }) }
    out result
}

skill output_add(output, text) {
    @carry = text
    @chunks = []
    @index = 0
    @count = core.group.count(output.chunks)
    @active = yes
    drum (count) {
        @chunk = core.group.item(output.chunks, index)
        @handling = active
        (handling == no) { chunks = core.group.add(chunks, chunk) }
        (handling == yes) {
            (core.str.len(chunk) == 0) {
                chunks = core.group.add(chunks, carry)
                active = no
            }
            (core.str.len(chunk) > 0) {
                chunks = core.group.add(chunks, "")
                carry = core.str.add(chunk, carry)
            }
        }
        index = index + 1
    }
    (active == yes) { chunks = core.group.add(chunks, carry) }
    out Output { chunks = chunks }
}

skill output_text(output) {
    @result = ""
    @count = core.group.count(output.chunks)
    @index = count - 1
    drum (count) {
        @chunk = core.group.item(output.chunks, index)
        (core.str.len(chunk) > 0) { result = core.str.add(result, chunk) }
        index = index - 1
    }
    out result
}

skill emit(compiler, line) {
    compiler.lines = output_add(compiler.lines, core.str.add(line, "\n"))
    out compiler
}

skill emit_blank(compiler) {
    out emit(compiler, "")
}

skill safe(text) {
    @result = ""
    @index = 0
    @length = core.str.len(text)
    @allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    drum (length) {
        (index < length) {
            @ch = core.str.at(text, index)
            (core.str.contains(allowed, ch) == yes) { result = core.str.add(result, ch) }
            (core.str.contains(allowed, ch) == no) { result = core.str.add(result, "_") }
            index = index + 1
        }
    }
    out result
}

skill label(compiler, prefix) {
    @label = core.str.add(".L_", safe(prefix))
    label = core.str.add(label, "_")
    label = core.str.add(label, core.num.text(compiler.serial))
    compiler.serial = compiler.serial + 1
    out label
}

skill align16(value) {
    @quotient = value / 16
    (quotient * 16 == value) { out value }
    out (quotient + 1) * 16
}

skill align8(value) {
    @quotient = value / 8
    (quotient * 8 == value) { out value }
    out (quotient + 1) * 8
}

skill name_add(names, name) {
    (symbol_has(names.names, name) == no) { names.names = symbol_add(names.names, name, "local", [], 0) }
    out names
}

skill collect_expression_names(names, node) {
    @plain = plain(node)
    @tag = core.group.item(plain, 0)
    (tag == "binary") {
        names = collect_expression_names(names, core.group.item(plain, 2))
        names = collect_expression_names(names, core.group.item(plain, 3))
    }
    (tag == "call") {
        @index = 1
        @count = core.group.count(plain)
        drum (count) {
            (index < count) { names = collect_expression_names(names, core.group.item(plain, index)) }
            index = index + 1
        }
    }
    (tag == "group") {
        @index = 1
        @count = core.group.count(plain)
        drum (count) {
            (index < count) { names = collect_expression_names(names, core.group.item(plain, index)) }
            index = index + 1
        }
    }
    (tag == "box-new") {
        @index = 2
        @count = core.group.count(plain)
        drum (count) {
            (index < count) { names = collect_expression_names(names, part(core.group.item(plain, index), 2)) }
            index = index + 1
        }
    }
    (tag == "rescue") {
        names = collect_expression_names(names, core.group.item(plain, 1))
        names = name_add(names, core.group.item(plain, 2))
        names = collect_block_names(names, core.group.item(plain, 3))
    }
    out names
}

skill collect_statement_names(names, node) {
    @plain = plain(node)
    @tag = core.group.item(plain, 0)
    (tag == "var") {
        names = name_add(names, core.group.item(plain, 1))
        names = collect_expression_names(names, core.group.item(plain, 2))
    }
    (tag == "assign") { names = collect_expression_names(names, core.group.item(plain, 2)) }
    (tag == "field-assign") {
        names = collect_expression_names(names, core.group.item(plain, 1))
        names = collect_expression_names(names, core.group.item(plain, 2))
    }
    (tag == "out") { names = collect_expression_names(names, core.group.item(plain, 1)) }
    (tag == "expr") { names = collect_expression_names(names, core.group.item(plain, 1)) }
    (tag == "if") {
        names = collect_expression_names(names, core.group.item(plain, 1))
        names = collect_block_names(names, core.group.item(plain, 2))
    }
    (tag == "switch") {
        names = collect_expression_names(names, core.group.item(plain, 1))
        @index = 2
        @count = core.group.count(plain)
        drum (count) {
            (index < count) { names = collect_expression_names(names, part(core.group.item(plain, index), 2)) }
            index = index + 1
        }
    }
    (tag == "drum") {
        @drum_name = core.str.add("$drum:", core.num.text(names.next_drum))
        names.next_drum = names.next_drum + 1
        names = name_add(names, drum_name)
        names = collect_expression_names(names, core.group.item(plain, 1))
        names = collect_block_names(names, core.group.item(plain, 2))
    }
    out names
}

skill collect_block_names(names, block) {
    @plain = plain(block)
    @index = 1
    @count = core.group.count(plain)
    drum (count) {
        (index < count) { names = collect_statement_names(names, core.group.item(plain, index)) }
        index = index + 1
    }
    out names
}

skill collect_locals(params, body) {
    @names = Names {}
    @index = 0
    @count = core.group.count(params)
    drum (count) {
        (index < count) { names = name_add(names, core.group.item(params, index)) }
        index = index + 1
    }
    out collect_block_names(names, body)
}

skill make_slots(names) {
    @slots = []
    @slot = 0 - 12
    @index = 0
    @count = core.group.count(names)
    drum (count) {
        (index < count) {
            @item = core.group.item(names, index)
            slots = symbol_add(slots, item.name, "slot", [], slot)
            slot = slot - 4
            index = index + 1
        }
    }
    out slots
}

skill slot(compiler, name) {
    @slot = symbol_find(compiler.current_function.slots, name)
    out slot.value
}

skill group_prepend(value, group) {
    @result = [value]
    @index = 0
    @count = core.group.count(group)
    drum (count) {
        (index < count) { result = core.group.add(result, core.group.item(group, index)) }
        index = index + 1
    }
    out result
}

skill group_slice(group, start, end) {
    @result = []
    @index = start
    @count = core.group.count(group)
    drum (count) {
        (index < end) { result = core.group.add(result, core.group.item(group, index)) }
        index = index + 1
    }
    out result
}

skill push(compiler, register) {
    compiler = emit(compiler, "  addi sp, sp, -4")
    compiler = emit(compiler, core.str.add("  sw ", core.str.add(register, ", 0(sp)")))
    out compiler
}

skill pop(compiler, register) {
    compiler = emit(compiler, core.str.add("  lw ", core.str.add(register, ", 0(sp)")))
    compiler = emit(compiler, "  addi sp, sp, 4")
    out compiler
}

skill load_immediate(compiler, register, value) {
    out emit(compiler, core.str.add("  li ", core.str.add(register, core.str.add(", ", core.num.text(value)))))
}

skill field(compiler, name) {
    @field = symbol_find(compiler.fields, name)
    out field.value
}

skill render_lines(output) {
    out output_text(output)
}

skill collect_box(compiler, item, module) {
    @name = qualified(module, part(item, 1))
    compiler.boxes = symbol_add_text(compiler.boxes, name, "box", item, module)
    @index = 2
    @count = core.group.count(plain(item))
    drum (count) {
        (index < count) {
            @member = part(item, index)
            (tag(member) == "field") {
                @field_name = part(member, 1)
                (symbol_has(compiler.fields, field_name) == no) {
                    compiler.fields = symbol_add(compiler.fields, field_name, "field", member, compiler.next_field_id)
                    compiler.next_field_id = compiler.next_field_id + 1
                }
            }
            index = index + 1
        }
    }
    out compiler
}

skill collect_enum(compiler, item, module) {
    @name = qualified(module, part(item, 1))
    compiler.enums = symbol_add_text(compiler.enums, name, "enum", item, module)
    @index = 2
    @count = core.group.count(plain(item))
    drum (count) {
        (index < count) {
            @variant = part(item, index)
            @full_name = core.str.add(name, ".")
            full_name = core.str.add(full_name, variant)
            @value = compiler.next_enum_id * 8 + TAG_ENUM
            compiler.variants = symbol_add(compiler.variants, full_name, "variant", item, value)
            (symbol_has(compiler.variants, variant) == no) { compiler.variants = symbol_add(compiler.variants, variant, "variant", item, value) }
            compiler.next_enum_id = compiler.next_enum_id + 1
            index = index + 1
        }
    }
    out compiler
}

skill collect_top_level(compiler) {
    @index = 1
    @count = core.group.count(compiler.ast)
    drum (count) {
        (index < count) {
            @item = core.group.item(compiler.ast, index)
            @tag = tag(item)
            @module = module(item)
            (tag == "use") {
                @plain_use = plain(item)
                @alias = core.group.item(plain_use, core.group.count(plain_use) - 1)
                @target = path_text(item)
                compiler.aliases = symbol_add_text(compiler.aliases, alias_key(module, alias), "import", item, target)
            }
            (tag == "const") { compiler.constants = symbol_add_text(compiler.constants, qualified(module, part(item, 1)), "const", part(item, 2), module) }
            (tag == "box") { compiler = collect_box(compiler, item, module) }
            (tag == "enum") { compiler = collect_enum(compiler, item, module) }
            (tag == "skill") { compiler.skills = symbol_add_text(compiler.skills, qualified(module, part(item, 1)), "skill", item, module) }
            (tag == "entry") { compiler.entry = item }
            index = index + 1
        }
    }
    out compiler
}

skill header(compiler) {
    compiler = emit(compiler, ".option norvc")
    compiler = emit(compiler, ".option norelax")
    compiler = emit(compiler, ".section .text")
    compiler = emit(compiler, ".global _start")
    compiler = emit_blank(compiler)
    out compiler
}

skill start(compiler) {
    @params = part(compiler.entry, 1)
    @param_count = core.group.count(params)
    compiler = emit(compiler, "_start:")
    compiler = emit(compiler, "  lw a0, 0(sp)")
    compiler = emit(compiler, "  addi a1, sp, 4")
    compiler = emit(compiler, "  la s1, saltic_heap")
    compiler = emit(compiler, "  la s2, saltic_heap_end")
    @required = core.num.text(param_count + 1)
    compiler = emit(compiler, core.str.add("  addi t0, zero, ", required))
    compiler = emit(compiler, "  blt a0, t0, rt_missing_args")
    @index = 0
    drum (param_count) {
        @offset = core.num.text((index + 1) * 4)
        compiler = emit(compiler, core.str.add("  lw a0, ", core.str.add(offset, "(a1)")))
        compiler = emit(compiler, "  call rt_cstring")
        compiler = emit(compiler, "  addi sp, sp, -4")
        compiler = emit(compiler, "  sw a0, 0(sp)")
        index = index + 1
    }
    index = 0
    drum (param_count) {
        @register = core.str.add("a", core.num.text(index))
        @offset = core.num.text((param_count - index - 1) * 4)
        compiler = emit(compiler, core.str.add("  lw ", core.str.add(register, core.str.add(", ", core.str.add(offset, "(sp)")))))
        index = index + 1
    }
    (param_count > 0) { compiler = emit(compiler, core.str.add("  addi sp, sp, ", core.num.text(param_count * 4))) }
    compiler = emit(compiler, "  call saltic_program")
    compiler = emit(compiler, "  andi t0, a0, 7")
    compiler = emit(compiler, "  addi t1, zero, 7")
    compiler = emit(compiler, "  sub a0, t0, t1")
    compiler = emit(compiler, "  sltu a0, zero, a0")
    compiler = emit(compiler, "  xori a0, a0, 1")
    compiler = emit(compiler, "  call rt_platform_exit")
    compiler = emit_blank(compiler)
    out compiler
}

skill path_text(path) {
    @plain = plain(path)
    @result = core.group.item(plain, 1)
    @index = 2
    @count = core.group.count(plain)
    drum (count) {
        (index < count) {
            result = core.str.add(result, ".")
            result = core.str.add(result, core.group.item(plain, index))
            index = index + 1
        }
    }
    out result
}

skill qualified(module, name) {
    (core.str.len(module) == 0) { out name }
    out core.str.add(module, core.str.add(".", name))
}

skill alias_key(module, alias) {
    out core.str.add(module, core.str.add("|", alias))
}


skill join_data(data) {
    @result = ""
    @index = 0
    @count = core.group.count(data)
    drum (count) {
        (index < count) {
            (index > 0) { result = core.str.add(result, "\n") }
            result = core.str.add(result, core.group.item(data, index))
            index = index + 1
        }
    }
    out result
}

skill finish_data(compiler) {
    compiler = emit(compiler, ".section .rodata")
    compiler = emit(compiler, ".balign 8")
    compiler = emit(compiler, join_data(compiler.data))
    compiler = emit(compiler, ".section .bss")
    compiler = emit(compiler, ".balign 8")
    compiler = emit(compiler, "saltic_heap:")
    compiler = emit(compiler, ".space 16777216")
    compiler = emit(compiler, "saltic_heap_end:")
    out compiler
}
