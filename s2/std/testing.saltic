use core

Testing = Box {
    passed = 0
    failed = 0
}

skill testing_new() {
    out Testing {}
}

skill testing_pass(suite, name) {
    suite.passed = suite.passed + 1
    core.io.show("проверка пройдена: ", name)
    out suite
}

skill testing_fail(suite, name, actual, expected) {
    suite.failed = suite.failed + 1
    core.io.show("проверка провалена: ", name)
    core.io.show("  получено: ", actual)
    core.io.show("  ожидалось: ", expected)
    out suite
}

skill test_equal(suite, name, actual, expected) {
    (actual == expected) {
        out testing_pass(suite, name)
    }
    out testing_fail(suite, name, actual, expected)
}

skill test_yes(suite, name, actual) {
    (actual == yes) {
        out testing_pass(suite, name)
    }
    out testing_fail(suite, name, actual, yes)
}

skill test_no(suite, name, actual) {
    (actual == no) {
        out testing_pass(suite, name)
    }
    out testing_fail(suite, name, actual, no)
}

skill testing_summary(suite) {
    core.io.show("проверок пройдено: ", suite.passed)
    core.io.show("проверок провалено: ", suite.failed)
    out suite.failed
}

skill testing_finish(suite) {
    testing_summary(suite)
    (suite.failed > 0) {
        out error.TestsFailed
    }
    out none
}
