use core.str
use core.bits32

skill equal(left, right) {
    @size = str.len(left)
    ((str.len(right) == size) == no) { out no }
    @difference = bits32(0)
    drum (size) {
        @pair = bits32.xor(bits32(str.byte(left, beat)), bits32(str.byte(right, beat)))
        difference = bits32.or(difference, pair)
    }
    out difference == bits32(0)
}
