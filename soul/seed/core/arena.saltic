-- arena — своя служебная арена программы (saltic_arena): чтение и запись по
-- смещению-числу от её начала (Q-003, Q-040). Чужая память — core.mem по
-- address. Сдвиг вне арены (меньше 0 или дальше SIZE) — ArenaBounds.
--
-- SIZE — размер арены в байтах (тот же, что ARENA_BYTES в selfhost.memory.model)
-- load8 / load16 / load32(offset) -> число; ArenaBounds
-- store8 / store16 / store32(offset, value) — value — обычное число;
--     ArenaBounds, не влезло в ширину — FixedIntegerOverflow
-- start() -> address начала арены

use core.mem
use core.num
use core.u8
use core.u16
use core.u32
use core.usize
use core.address

SIZE = 4194304
HALF = 65536

skill start() {
    out address.from(u32.from(mem.arena(1)) * u32.from(HALF) + u32.from(mem.arena(0)))
}

skill place(offset, width) {
    (offset < 0) { out error.ArenaBounds }
    (offset + width > SIZE) { out error.ArenaBounds }
    out usize.from(offset)
}

skill load8(offset) {
    out num.from(mem.load8(start(), place(offset, 1)))
}

skill load16(offset) {
    out num.from(mem.load16(start(), place(offset, 2)))
}

skill load32(offset) {
    out num.from(mem.load32(start(), place(offset, 4)))
}

skill store8(offset, value) {
    mem.store8(start(), place(offset, 1), u8.from(value))
    out none
}

skill store16(offset, value) {
    mem.store16(start(), place(offset, 2), u16.from(value))
    out none
}

skill store32(offset, value) {
    mem.store32(start(), place(offset, 4), u32.from(value))
    out none
}
