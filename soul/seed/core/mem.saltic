-- mem — прямой доступ к памяти по адресу: чтение и запись 8/16/32 бит.
-- address — либо значение address (тогда offset — usize, value — u8/u16/u32),
-- либо группа [hi, lo] из двух 16-битных половин с обычными числами.
-- offset — в байтах. Порядок обращений к устройству закрепляет cpu.fence.
--
-- load8 / load16 / load32(address, offset) -> число
-- store8 / store16 / store32(address, offset, value)
-- store_address32(address, offset, [hi, lo]) — записать 32-битный адрес
-- arena(piece) -> 16-битная половина адреса служебной арены saltic_arena:
--     0 — младшая, 1 — старшая

skill load8(address, offset) native
skill load16(address, offset) native
skill load32(address, offset) native
skill store8(address, offset, value) native
skill store16(address, offset, value) native
skill store32(address, offset, value) native
skill store_address32(address, offset, value) native
skill arena(piece) native
