-- mem — прямой доступ к чужой памяти (устройства, прошивка) по address:
-- чтение и запись 8/16/32 бит. Только address (Q-003, Q-040): offset — usize в
-- байтах, value — u8/u16/u32; своя арена — core.arena по смещению-числу.
-- Порядок обращений к устройству закрепляет cpu.fence.
--
-- load8 / load16 / load32(address, offset) -> u8 / u16 / u32
-- store8 / store16 / store32(address, offset, value)
-- arena(piece) -> 16-битная половина адреса служебной арены saltic_arena:
--     0 — младшая, 1 — старшая
-- heap(piece) -> байт кучи программы: 0 — занято, 1 — список побегов (поля
--     долгих Box), 2 — квота сборки; рост занятого у вечной программы — утечка

skill load8(address, offset) native
skill load16(address, offset) native
skill load32(address, offset) native
skill store8(address, offset, value) native
skill store16(address, offset, value) native
skill store32(address, offset, value) native
skill arena(piece) native
skill heap(piece) native
