-- bytes — буфер байтов: сплошная память, байт занимает ровно байт.
-- Буфер изменяемый, как Box: set меняет его на месте, и изменение видят все,
-- у кого он есть. Новый буфер заполнен нулями.
--
-- new(size) -> буфер из size нулей; InvalidSize, если size < 0
-- count(buffer) -> число байтов
-- get(buffer, index) -> число 0…255; BytesBounds вне буфера
-- set(buffer, index, value) — записать байт; BytesBounds, ByteOutsideRange
-- read_u16(text, offset) -> число из двух байтов строки (младший первым)
-- make, load, store — родные операции без понятных ошибок, звать get/set

use core.str

skill make(size) native
skill count(buffer) native
skill load(buffer, index) native
skill store(buffer, index, value) native

skill new(size) {
    (size < 0) { out error.InvalidSize }
    out make(size)
}

skill get(buffer, index) {
    (index < 0) { out error.BytesBounds }
    (index > count(buffer) - 1) { out error.BytesBounds }
    out load(buffer, index)
}

skill set(buffer, index, value) {
    (index < 0) { out error.BytesBounds }
    (index > count(buffer) - 1) { out error.BytesBounds }
    (value < 0) { out error.ByteOutsideRange }
    (value > 255) { out error.ByteOutsideRange }
    out store(buffer, index, value)
}

skill read_u16(text, offset) {
    out str.byte(text, offset) + str.byte(text, offset + 1) * 256
}
