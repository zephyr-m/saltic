-- bytes — буфер байтов: сплошная память, байт занимает ровно байт.
-- Буфер изменяемый, как Box: set меняет его на месте, и изменение видят все,
-- у кого он есть. Новый буфер заполнен нулями.
--
-- new(size) -> буфер из size нулей; InvalidSize, если size < 0
-- count(buffer) -> число байтов
-- get(buffer, index) -> число 0…255; BytesBounds вне буфера
-- set(buffer, index, value) — записать байт; BytesBounds, ByteOutsideRange
-- slice(buffer, start, end) -> новый буфер, копия байтов start…end-1
-- from_group(items) -> буфер из группы чисел; ByteOutsideRange
-- to_group(buffer) -> группа чисел
-- read_u16(text, offset) — прежнее имя str.read_u16 (уйдёт, шаг 2)
-- make, load, store, copy — родные операции без понятных ошибок, звать
--   new, get, set, slice

use core.str
use core.group

skill make(size) native
skill count(buffer) native
skill load(buffer, index) native
skill store(buffer, index, value) native
skill copy(buffer, start, end) native

skill new(size) {
    (size < 0) { out error.InvalidSize }
    out make(size)
}

skill get(buffer, index) {
    (index < 0) { out error.BytesBounds }
    (index >= count(buffer)) { out error.BytesBounds }
    out load(buffer, index)
}

skill set(buffer, index, value) {
    (index < 0) { out error.BytesBounds }
    (index >= count(buffer)) { out error.BytesBounds }
    (value < 0) { out error.ByteOutsideRange }
    (value > 255) { out error.ByteOutsideRange }
    out store(buffer, index, value)
}

skill slice(buffer, start, end) {
    (start < 0) { out error.BytesBounds }
    (end < start) { out error.BytesBounds }
    (end > count(buffer)) { out error.BytesBounds }
    out copy(buffer, start, end)
}

skill from_group(items) {
    @buffer = make(group.count(items))
    drum (group.count(items)) { set(buffer, beat, group.get(items, beat)) }
    out buffer
}

skill to_group(buffer) {
    @items = []
    drum (count(buffer)) { items = group.add(items, load(buffer, beat)) }
    out items
}

skill read_u16(text, offset) {
    out str.read_u16(text, offset)
}
