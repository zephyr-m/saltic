-- system — номера системных вызовов, которыми пользуется рантайм.
-- Linux RV32I: ioctl, openat, close, lseek (на RV32I это _llseek: смещение
-- двумя словами, результат по указателю; на RV64 — обычный lseek), read,
-- write, exit, exit_group; для core.process: clone (SIGCHLD вместо fork),
-- execve, waitid (wait4 на RV32 нет), chdir, pipe2, dup3, faccessat, getdents64;
-- часы: clock_gettime64 (403, есть только на 32-битных), на RV64 — clock_gettime 113.
-- Собственные: SYSCALL_FIRMWARE = 500 и SYSCALL_FIRMWARE_CALL = 503 — вход в
-- прошивку (core.cpu.firmware / call), есть только на платформе с прошивкой.
-- Коды выхода программы: EXIT_MISSING_ARGUMENTS = 64, EXIT_OUT_OF_MEMORY = 65
-- (их пишет рантайм). Навыков нет.

EXIT_MISSING_ARGUMENTS = 64
EXIT_OUT_OF_MEMORY = 65
SYSCALL_IOCTL = 29
SYSCALL_OPENAT = 56
SYSCALL_CLOSE = 57
SYSCALL_LSEEK = 62
SYSCALL_READ = 63
SYSCALL_WRITE = 64
SYSCALL_EXIT = 93
SYSCALL_EXIT_GROUP = 94
SYSCALL_DUP3 = 24
SYSCALL_FACCESSAT = 48
SYSCALL_CHDIR = 49
SYSCALL_PIPE2 = 59
SYSCALL_GETDENTS64 = 61
SYSCALL_CLONE = 220
SYSCALL_EXECVE = 221
SYSCALL_WAITID = 95
SYSCALL_CLOCK_GETTIME = 403
SYSCALL_CLOCK_GETTIME_RV64 = 113
SYSCALL_FTRUNCATE = 46
SYSCALL_PWRITE = 68
SYSCALL_SOCKET = 198
SYSCALL_CONNECT = 203
SYSCALL_SENDMSG = 211
SYSCALL_MEMFD = 279
SYSCALL_NANOSLEEP = 101
SYSCALL_MMAP = 222
SYSCALL_FIRMWARE = 500
SYSCALL_FIRMWARE_CALL = 503
