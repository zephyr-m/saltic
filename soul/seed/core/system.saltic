-- system — номера системных вызовов, которыми пользуется рантайм.
-- Linux RV32I: ioctl, openat, close, lseek (на RV32I это _llseek: смещение
-- двумя словами, результат по указателю; на RV64 — обычный lseek), read,
-- write, exit, exit_group.
-- Собственные: SYSCALL_FIRMWARE = 500 и SYSCALL_FIRMWARE_CALL = 503 — вход в
-- прошивку (core.cpu.firmware / call), есть только на платформе с прошивкой.
-- Навыков нет.

SYSCALL_IOCTL = 29
SYSCALL_OPENAT = 56
SYSCALL_CLOSE = 57
SYSCALL_LSEEK = 62
SYSCALL_READ = 63
SYSCALL_WRITE = 64
SYSCALL_EXIT = 93
SYSCALL_EXIT_GROUP = 94
SYSCALL_FIRMWARE = 500
SYSCALL_FIRMWARE_CALL = 503
