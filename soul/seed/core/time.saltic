-- time — часы и счётчик тактов.
-- now() — миллисекунды от полуночи UTC (0…DAY_MILLISECONDS − 1), родное:
-- Linux — clock_gettime; на платформах без часов — NotSupported.
-- Счётчик тактов 28-битный: после COUNTER_LAST = 268435455 идёт ноль.
--
-- now() -> миллисекунды от полуночи UTC
-- text(milliseconds) -> "ЧЧ:ММ:СС" (сутки по кругу, минус — с конца суток)
-- elapsed(before, now) -> число тактов между отсчётами, переход через ноль учтён

use core.num

COUNTER_LAST = 268435455
DAY_MILLISECONDS = 86400000
HOUR_MILLISECONDS = 3600000

skill now() native

skill two(value) {
    (value < 10) { out "0{value}" }
    out "{value}"
}

skill text(milliseconds) {
    @day = num.mod(milliseconds, DAY_MILLISECONDS)
    (day < 0) { day = day + DAY_MILLISECONDS }
    @seconds = day / 1000
    @hh = two(seconds / 3600)
    @mm = two(num.mod(seconds / 60, 60))
    @ss = two(num.mod(seconds, 60))
    out "{hh}:{mm}:{ss}"
}

skill elapsed(before, now) {
    (now < before) { out COUNTER_LAST - before + now + 1 }
    out now - before
}
