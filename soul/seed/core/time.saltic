-- time — разница показаний счётчика тактов с учётом переполнения.
-- Счётчик 28-битный: после COUNTER_LAST = 268435455 идёт ноль.
--
-- elapsed(before, now) -> число тактов между отсчётами, переход через ноль учтён

COUNTER_LAST = 268435455

skill elapsed(before, now) {
    (now < before) { out COUNTER_LAST - before + now + 1 }
    out now - before
}
