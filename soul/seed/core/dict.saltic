-- dict — словарь: строковый ключ -> любое значение, таблица корзин по хэшу.
-- Словарь изменяемый, как Box: set меняет его на месте, и изменение видят все,
-- у кого он есть. Ключ — только строка; число превращай в ключ через num.text.
-- Корзины растут вдвое, когда ключей больше двух на корзину.
--
-- Dict — Box словаря; поля не трогать, звать навыки
-- new() -> пустой словарь
-- set(table, key, value) — положить значение; старое под тем же ключом заменяется
-- get(table, key) -> значение; UnknownKey, если ключа нет
-- has(table, key) -> yes/no
-- Entry, Bucket, hash, bucket_of, entry_of, link, fresh_buckets, relink,
--   grow — внутренности

use core.str
use core.group

DICT_FIRST_BUCKETS = 8
DICT_HASH_LIMIT = 8388593

Entry = Box {
    key = "",
    value = none,
    next = none
}

Bucket = Box {
    first = none
}

Dict = Box {
    buckets = [],
    size = 0
}

skill hash(key) {
    @code = str.bytes(key)
    drum (str.bytes(key)) { code = (code * 31 + str.byte(key, beat)) % DICT_HASH_LIMIT }
    out code
}

skill bucket_of(table, key) {
    out group.get(table.buckets, hash(key) % group.count(table.buckets))
}

skill entry_of(table, key) {
    @bucket = bucket_of(table, key)
    @entry = bucket.first
    drum (table.size) {
        (entry == none) { out none }
        (entry.key == key) { out entry }
        entry = entry.next
    }
    out none
}

skill link(table, entry) {
    @bucket = bucket_of(table, entry.key)
    entry.next = bucket.first
    bucket.first = entry
    out table
}

skill fresh_buckets(count) {
    @buckets = []
    drum (count) { buckets = group.add(buckets, Bucket {}) }
    out buckets
}

skill relink(table, bucket) {
    @entry = bucket.first
    drum (table.size) {
        (entry == none) { out table }
        @next = entry.next
        link(table, entry)
        entry = next
    }
    out table
}

skill grow(table) {
    @old = table.buckets
    table.buckets = fresh_buckets(group.count(old) * 2)
    drum (old) { relink(table, beat) }
    out table
}

skill new() {
    out Dict { buckets = fresh_buckets(DICT_FIRST_BUCKETS) }
}

skill set(table, key, value) {
    @found = entry_of(table, key)
    ((found == none) == no) {
        found.value = value
        out table
    }
    (table.size > group.count(table.buckets) * 2) { grow(table) }
    link(table, Entry { key = key, value = value })
    table.size = table.size + 1
    out table
}

skill get(table, key) {
    @found = entry_of(table, key)
    (found == none) { out error.UnknownKey }
    out found.value
}

skill has(table, key) {
    @found = entry_of(table, key)
    out (found == none) == no
}
