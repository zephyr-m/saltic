-- str — строки: длина, байты, срезы, поиск, регистр, разбиение и склейка.
-- Индексы get / byte / slice — в БАЙТАХ от нуля (кириллица — два байта на букву,
-- срез посреди буквы её рвёт); буквы — letters / letter (Q-020). slice берёт
-- [start, end). Выход за границы — StringBounds. Строки неизменяемы: concat и остальные
-- отдают новую строку.
--
-- bytes(text) -> число байт — для компилятора, сети, диска
-- count(text) -> число букв UTF-8 — для интерфейса; хвостовые байты 128…191
--     не считаются
-- line_count(text) -> число строк
-- concat(left, right) -> склейка
-- get(text, index) -> байт index как строка длины 1
-- letters(text) -> группа букв UTF-8 за один проход; letter(text, index) -> буква
--     номер index; StringBounds
-- byte(text, index) -> код байта; StringBounds
-- from_byte(code) -> строка из одного байта 0…255; StringBounds
-- from_bytes(buffer) -> строка из буфера bytes (копия) — сборка текста без n²
-- slice(text, start, end) -> подстрока; StringBounds
-- contains / starts_with / ends_with(text, needle) -> yes/no
-- lower / upper(text) -> строка в нижнем / верхнем регистре: латиница и кириллица
--     (а…я, ё)
-- is_digit(ch) -> yes для одного символа 0…9
-- is_empty(text) -> yes/no
-- starts_at(text, needle, index) -> yes, если needle стоит в text с index
-- lines(text) -> группа строк по "\n" (пустые выброшены)
-- split(text, separator) -> группа непустых частей; пустой separator — [text]
-- join(items, separator) -> строка; собирается в одном буфере bytes — линейно
-- read_u16(text, offset) -> число из двух байтов строки (младший первым; Q-019)

use core.group
use core.bytes

skill line_count(text) native
skill concat(left, right) native
skill bytes(text) native
skill get(text, index) native
skill byte(text, index) native
skill from_byte(code) native
skill from_bytes(buffer) native
skill slice(text, start, end) native
skill contains(text, needle) native
skill starts_with(text, prefix) native
skill ends_with(text, suffix) native
skill lower(text) native
skill upper(text) native

skill is_digit(ch) {
    ((bytes(ch) == 1) == no) { out no }
    @code = byte(ch, 0)
    (code < 48) { out no }
    out code < 58
}

skill count(text) {
    @letters = 0
    drum (bytes(text)) {
        @code = byte(text, beat)
        (code < 128) { letters = letters + 1 }
        (code >= 192) { letters = letters + 1 }
    }
    out letters
}

skill starts_letter(text, index) {
    @code = byte(text, index)
    (code < 128) { out yes }
    out code >= 192
}

skill letters(text) {
    @result = []
    @start = 0
    @size = bytes(text)
    drum (size) {
        (beat > 0) {
            (starts_letter(text, beat) == yes) {
                result = group.add(result, slice(text, start, beat))
                start = beat
            }
        }
    }
    (size > 0) { result = group.add(result, slice(text, start, size)) }
    out result
}

skill letter(text, index) {
    (index < 0) { out error.StringBounds }
    @found = -1
    @start = 0
    @size = bytes(text)
    drum (size) {
        (starts_letter(text, beat) == yes) {
            (found == index) { out slice(text, start, beat) }
            found = found + 1
            start = beat
        }
    }
    (found == index) { out slice(text, start, size) }
    out error.StringBounds
}

skill read_u16(text, offset) {
    out byte(text, offset) + byte(text, offset + 1) * 256
}

skill is_empty(text) {
    out bytes(text) == 0
}

skill starts_at(text, needle, index) {
    @needle_length = bytes(needle)
    @end = index + needle_length

    (end > bytes(text)) {
        out no
    }

    out slice(text, index, end) == needle
}

skill lines(text) {
    out split(text, "\n")
}

skill split(text, separator) {
    @separator_length = bytes(separator)
    @text_length = bytes(text)
    @items = []

    (separator_length == 0) {
        (is_empty(text) == no) {
            items = group.add(items, text)
        }
        out items
    }

    @start = 0
    @index = 0
    drum (text_length) {
        @matched = no

        (starts_at(text, separator, index) == yes) {
            @part = slice(text, start, index)
            (is_empty(part) == no) {
                items = group.add(items, part)
            }
            index = index + separator_length
            start = index
            matched = yes
        }

        (matched == no) {
            index = index + 1
        }
    }

    @tail = slice(text, start, text_length)
    (is_empty(tail) == no) {
        items = group.add(items, tail)
    }

    out items
}

skill join(items, separator) {
    @parts = group.count(items)
    @size = 0
    drum (items) { size = size + bytes(beat) }
    (parts > 1) { size = size + bytes(separator) * (parts - 1) }
    @buffer = bytes.new(size)
    @at = 0
    drum (parts) {
        (beat > 0) { at = put(buffer, at, separator) }
        at = put(buffer, at, group.get(items, beat))
    }
    out from_bytes(buffer)
}

skill put(buffer, at, text) {
    drum (bytes(text)) { bytes.set(buffer, at + beat, byte(text, beat)) }
    out at + bytes(text)
}
