-- bits32 — побитовые операции над значением bits32 (32 бита без знака).
-- Смешивать с обычными числами и другими фиксированными типами нельзя —
-- чекер откажет; amount сдвига — u8.
--
-- and / or / xor(left, right) -> bits32
-- not(value) -> bits32
-- shift_left / shift_right(value, amount) -> bits32

skill and(left, right) native
skill or(left, right) native
skill xor(left, right) native
skill not(value) native
skill shift_left(value, amount) native
skill shift_right(value, amount) native
