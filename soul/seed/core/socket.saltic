-- socket — сокет и кусок памяти хоста для клиента Wayland.
-- Числа возврата — ответ ядра: неотрицательное или -errno.
-- На слове в 4 байта send и place отвечают -1.
--
-- open(domain, type, protocol) -> дескриптор
-- connect(fd, address) -> 0 или -errno; address — байты sockaddr
-- write(fd, data, count) -> сколько байт ушло
-- read(fd, data) -> сколько байт легло в начало data
-- close(fd) -> 0 или -errno
-- memory(name) -> дескриптор memfd
-- resize(fd, bytes) -> 0 или -errno
-- send(fd, data, count, attached) -> write с одним приложенным дескриптором
-- place(fd, data, offset) -> записать data целиком со смещения
-- sleep(ms) -> 0; пауза, на 4-байтном слове отвечает -1
-- map(fd, size) -> адрес общего куска в младших 2 ГБ; на 4-байтном слове -1

skill open(domain, type, protocol) native
skill connect(fd, address) native
skill write(fd, data, count) native
skill read(fd, data) native
skill close(fd) native
skill memory(name) native
skill resize(fd, bytes) native
skill send(fd, data, count, attached) native
skill place(fd, data, offset) native
skill sleep(ms) native
skill map(fd, size) native

program() {
    out none
}
