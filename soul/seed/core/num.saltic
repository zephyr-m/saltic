-- num — числа: текст, выравнивание, цифры, степени двойки, шестнадцатеричные цифры.
-- Остаток от деления — оператор % (с 07.11.2026, вместо num.mod).
-- MAXIMUM = 268435455 — наибольшее обычное число, общее для всех целей (29 бит),
--     MAXIMUM_TEXT — оно же текстом (для сравнения литералов без перевода в текст);
--     на него опираются abi, счётчик тактов core.time и ожидания ОС
--
-- text(value) -> десятичная строка
-- from(value) -> обычное число из фиксированного; NumberOverflow, если не
--     помещается в обычное число (29 бит на RV32I, 61 бит на RV64 и x86-64)
-- align(value, boundary) -> value, поднятое до кратного boundary (boundary > 0)
-- digit_value(ch) -> число по символу-цифре (без проверки)
-- power2(width) -> 2 в степени width
-- hex_char(value) -> символ 0…f по числу 0…15
-- hex_value(ch) -> число 0…15 по шестнадцатеричной цифре любого регистра;
--     -1 для чужого символа
-- and / or / xor(left, right) -> число — биты обычного числа (Q-024; операторов нет)
-- shift_left / shift_right(value, count) -> число; влево с переполнением и сдвиг вне
--     0…ширина − 1 — NumberOverflow; вправо — со знаком (вниз)
-- bit(value, index) -> yes/no — бит index (0 — младший)
-- floor / ceil / trunc(fraction) -> целое вниз / вверх / к нулю; round_school —
--     половинка от нуля (2.5 → 3), round_bank — к чётному (2.5 → 2); NumberOverflow
--     от 2^59 (Q-044); только на 64-битных целях

use core.str

MAXIMUM = 268435455
MAXIMUM_TEXT = "268435455"
HEX_DIGITS = "0123456789abcdef"

skill text(value) native
skill from(value) native
skill and(left, right) native
skill or(left, right) native
skill xor(left, right) native
skill shift_left(value, count) native
skill shift_right(value, count) native
skill bit(value, index) native
skill floor(value) native
skill ceil(value) native
skill trunc(value) native
skill round_school(value) native
skill round_bank(value) native

skill align(value, boundary) {
    @remainder = value % boundary
    (remainder == 0) { out value }
    out value + boundary - remainder
}

skill digit_value(ch) {
    out str.byte(ch, 0) - 48
}

skill power2(width) {
    @value = 1
    drum (width) { value = value * 2 }
    out value
}

skill hex_char(value) {
    out str.get(HEX_DIGITS, value)
}

skill hex_value(ch) {
    @lower = str.lower(ch)
    drum (16) {
        (str.get(HEX_DIGITS, beat) == lower) { out beat }
    }
    out -1
}
