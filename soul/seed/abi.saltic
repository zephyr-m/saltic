use seed
use seed.abi.tags
use seed.abi.errors
use seed.abi.fixed
use seed.abi.value
use seed.abi.call
use seed.abi.object

TAG_SHIFT = tags.SHIFT
TAG_SCALE = tags.SCALE
TAG_MASK = tags.MASK
PAYLOAD_MASK = tags.PAYLOAD_MASK

TAG_NUMBER = tags.NUMBER
TAG_ANSWER = tags.ANSWER
TAG_NONE = tags.NONE
TAG_STRING = tags.STRING
TAG_GROUP = tags.GROUP
TAG_BOX = tags.BOX
TAG_ENUM = tags.ENUM
TAG_ERROR = tags.ERROR

NO = tags.NO
YES = tags.YES
NONE = tags.EMPTY

FIXED_UNKNOWN = fixed.UNKNOWN
FIXED_U8 = fixed.U8
FIXED_U16 = fixed.U16
FIXED_U32 = fixed.U32
FIXED_I32 = fixed.I32
FIXED_BITS32 = fixed.BITS32
FIXED_ADDRESS = fixed.ADDRESS
FIXED_USIZE = fixed.USIZE

VALUE_WORD_BITS = value.WORD_BITS
VALUE_WORD_BYTES = value.WORD_BYTES
VALUE_REPRESENTATION_UNKNOWN = value.REPRESENTATION_UNKNOWN
VALUE_REPRESENTATION_TAGGED = value.REPRESENTATION_TAGGED
VALUE_REPRESENTATION_RAW = value.REPRESENTATION_RAW
VALUE_TYPE_SOURCE_UNKNOWN = value.TYPE_SOURCE_UNKNOWN
VALUE_TYPE_SOURCE_TAG = value.TYPE_SOURCE_TAG
VALUE_TYPE_SOURCE_SIGNATURE = value.TYPE_SOURCE_SIGNATURE
NUMBER_MINIMUM_TEXT = value.NUMBER_MINIMUM_TEXT
NUMBER_MAXIMUM_TEXT = value.NUMBER_MAXIMUM_TEXT

CALL_ARGUMENT_LIMIT = call.ARGUMENT_LIMIT
CALL_STACK_ALIGNMENT = call.STACK_ALIGNMENT
CALL_ARGUMENT_REGISTER_FIRST = call.ARGUMENT_REGISTER_FIRST
CALL_RETURN_VALUE_REGISTER = call.RETURN_VALUE_REGISTER
CALL_RETURN_ERROR_REGISTER = call.RETURN_ERROR_REGISTER
CALL_FIXED_SOURCE_KIND_REGISTER = call.FIXED_SOURCE_KIND_REGISTER
CALL_FIXED_TARGET_KIND_REGISTER = call.FIXED_TARGET_KIND_REGISTER
CALL_NO_ERROR = call.NO_ERROR
CALL_RAW_TYPE_SOURCE = call.RAW_TYPE_SOURCE
CALL_ERROR_REPRESENTATION_RAW_ID = call.ERROR_REPRESENTATION_RAW_ID

OBJECT_ALIGNMENT = object.ALIGNMENT
OBJECT_HEADER_KIND_OFFSET = object.HEADER_KIND_OFFSET
OBJECT_HEADER_PAYLOAD_BYTES_OFFSET = object.HEADER_PAYLOAD_BYTES_OFFSET
OBJECT_HEADER_FLAGS_OFFSET = object.HEADER_FLAGS_OFFSET
OBJECT_HEADER_BYTES = object.HEADER_BYTES
OBJECT_PAYLOAD_OFFSET = object.PAYLOAD_OFFSET
OBJECT_KIND_STRING = object.KIND_STRING
OBJECT_KIND_GROUP = object.KIND_GROUP
OBJECT_KIND_BOX = object.KIND_BOX
OBJECT_FLAGS_NONE = object.FLAGS_NONE
OBJECT_FLAG_STATIC = object.FLAG_STATIC
OBJECT_FLAGS_MASK = object.FLAGS_MASK

ERROR_NONE = errors.NO_ERROR
ERROR_MISSING_FIELD = errors.MISSING_FIELD
ERROR_GROUP_BOUNDS = errors.GROUP_BOUNDS
ERROR_DIVISION_BY_ZERO = errors.DIVISION_BY_ZERO
ERROR_FILE = errors.FILE
ERROR_STRING_BOUNDS = errors.STRING_BOUNDS
ERROR_FIXED_INTEGER_OVERFLOW = errors.FIXED_INTEGER_OVERFLOW
ERROR_CONSTANT_CYCLE = errors.CONSTANT_CYCLE
SYSTEM_ERROR_FIRST = errors.SYSTEM_FIRST
SYSTEM_ERROR_LAST = errors.SYSTEM_LAST
USER_ERROR_FIRST = errors.USER_FIRST
ERROR_MAXIMUM_TEXT = errors.MAXIMUM_TEXT

skill tagged(id, tag) {
    out tags.tagged(id, tag)
}

skill id(value) {
    out tags.id(value)
}

skill tag(value) {
    out tags.tag(value)
}

skill payload(value) {
    out tags.payload(value)
}

skill valid_tag(tag) {
    out tags.valid(tag)
}

skill is_fixed_type(type) {
    out fixed.is_type(type)
}

skill fixed_type_kind(type) {
    out fixed.kind(type)
}

skill fixed_kind_type(kind) {
    out fixed.type(kind)
}

skill valid_fixed_kind(kind) {
    out fixed.valid_kind(kind)
}

skill fixed_type_width_bits(type) {
    out fixed.width_bits(type)
}

skill fixed_type_is_signed(type) {
    out fixed.is_signed(type)
}

skill fixed_type_in_range(type, text) {
    out fixed.in_range(type, text)
}

skill fixed_type_range_text(type) {
    out fixed.range_text(type)
}

skill representation(type) {
    out value.representation(type)
}

skill is_raw_value(type) {
    out value.is_raw(type)
}

skill is_tagged_value(type) {
    out value.is_tagged(type)
}

skill type_source(type) {
    out value.type_source(type)
}

skill valid_value_type(type) {
    out value.valid_type(type)
}

skill tag_for_type(type) {
    out value.type_tag(type)
}

skill type_for_tag(tag) {
    out value.tag_type(tag)
}

skill argument_register(index) {
    out call.argument_register(index)
}

skill valid_argument_count(count) {
    out call.valid_argument_count(count)
}

skill frame_bytes(local_count, saved_count) {
    out call.frame_bytes(local_count, saved_count)
}

skill argument_value_representation(type) {
    out call.argument_representation(type)
}

skill valid_call_type(type) {
    out call.valid_call_type(type)
}

skill success_result(word, type) {
    out call.success(word, type)
}

skill failure_result(error_id) {
    out call.failure(error_id)
}

skill result_failed(result) {
    out call.failed(result)
}

skill valid_call_result(result) {
    out call.valid_result(result)
}

skill allocation_size(payload_bytes) {
    out object.allocation_size(payload_bytes)
}

skill valid_object_kind(kind) {
    out object.valid_kind(kind)
}

skill has_object_flag(flags, flag) {
    out object.has_flag(flags, flag)
}

skill valid_object_flags(flags) {
    out object.valid_flags(flags)
}

skill error_value(id) {
    out errors.value(id)
}

skill valid_error_id(id) {
    out errors.valid_id(id)
}

skill user_error_id(index) {
    out errors.user_id(index)
}

skill user_error_value(index) {
    out errors.user_value(index)
}

skill is_system_error(id) {
    out errors.is_system(id)
}

skill is_user_error(id) {
    out errors.is_user(id)
}

skill definition(name, value) {
    @line = seed.str.add(".set ", name)
    line = seed.str.add(line, ", ")
    out seed.str.add(line, seed.str.add(seed.num.text(value), "\n"))
}

skill definition_text(name, value) {
    @line = seed.str.add(".set ", name)
    line = seed.str.add(line, ", ")
    out seed.str.add(line, seed.str.add(value, "\n"))
}

skill assembly() {
    @text = definition("SALTIC_ABI_TAG_SHIFT", TAG_SHIFT)
    text = seed.str.add(text, definition("SALTIC_ABI_TAG_SCALE", TAG_SCALE))
    text = seed.str.add(text, definition("SALTIC_ABI_TAG_MASK", TAG_MASK))
    text = seed.str.add(text, definition("SALTIC_ABI_PAYLOAD_MASK", PAYLOAD_MASK))

    text = seed.str.add(text, definition("SALTIC_ABI_TAG_NUMBER", TAG_NUMBER))
    text = seed.str.add(text, definition("SALTIC_ABI_TAG_ANSWER", TAG_ANSWER))
    text = seed.str.add(text, definition("SALTIC_ABI_TAG_NONE", TAG_NONE))
    text = seed.str.add(text, definition("SALTIC_ABI_TAG_STRING", TAG_STRING))
    text = seed.str.add(text, definition("SALTIC_ABI_TAG_GROUP", TAG_GROUP))
    text = seed.str.add(text, definition("SALTIC_ABI_TAG_BOX", TAG_BOX))
    text = seed.str.add(text, definition("SALTIC_ABI_TAG_ENUM", TAG_ENUM))
    text = seed.str.add(text, definition("SALTIC_ABI_TAG_ERROR", TAG_ERROR))
    text = seed.str.add(text, definition("SALTIC_ABI_NO", NO))
    text = seed.str.add(text, definition("SALTIC_ABI_YES", YES))
    text = seed.str.add(text, definition("SALTIC_ABI_NONE", NONE))

    text = seed.str.add(text, definition("SALTIC_ABI_FIXED_UNKNOWN", FIXED_UNKNOWN))
    text = seed.str.add(text, definition("SALTIC_ABI_FIXED_U8", FIXED_U8))
    text = seed.str.add(text, definition("SALTIC_ABI_FIXED_U16", FIXED_U16))
    text = seed.str.add(text, definition("SALTIC_ABI_FIXED_U32", FIXED_U32))
    text = seed.str.add(text, definition("SALTIC_ABI_FIXED_I32", FIXED_I32))
    text = seed.str.add(text, definition("SALTIC_ABI_FIXED_BITS32", FIXED_BITS32))
    text = seed.str.add(text, definition("SALTIC_ABI_FIXED_ADDRESS", FIXED_ADDRESS))
    text = seed.str.add(text, definition("SALTIC_ABI_FIXED_USIZE", FIXED_USIZE))

    text = seed.str.add(text, definition("SALTIC_ABI_VALUE_WORD_BITS", VALUE_WORD_BITS))
    text = seed.str.add(text, definition("SALTIC_ABI_VALUE_WORD_BYTES", VALUE_WORD_BYTES))
    text = seed.str.add(text, definition("SALTIC_ABI_VALUE_REPRESENTATION_UNKNOWN", VALUE_REPRESENTATION_UNKNOWN))
    text = seed.str.add(text, definition("SALTIC_ABI_VALUE_REPRESENTATION_TAGGED", VALUE_REPRESENTATION_TAGGED))
    text = seed.str.add(text, definition("SALTIC_ABI_VALUE_REPRESENTATION_RAW", VALUE_REPRESENTATION_RAW))
    text = seed.str.add(text, definition("SALTIC_ABI_VALUE_TYPE_SOURCE_UNKNOWN", VALUE_TYPE_SOURCE_UNKNOWN))
    text = seed.str.add(text, definition("SALTIC_ABI_VALUE_TYPE_SOURCE_TAG", VALUE_TYPE_SOURCE_TAG))
    text = seed.str.add(text, definition("SALTIC_ABI_VALUE_TYPE_SOURCE_SIGNATURE", VALUE_TYPE_SOURCE_SIGNATURE))

    text = seed.str.add(text, definition("SALTIC_ABI_CALL_ARGUMENT_LIMIT", CALL_ARGUMENT_LIMIT))
    text = seed.str.add(text, definition("SALTIC_ABI_CALL_STACK_ALIGNMENT", CALL_STACK_ALIGNMENT))
    text = seed.str.add(text, definition("SALTIC_ABI_CALL_ARGUMENT_REGISTER_FIRST", CALL_ARGUMENT_REGISTER_FIRST))
    text = seed.str.add(text, definition("SALTIC_ABI_CALL_RETURN_VALUE_REGISTER", CALL_RETURN_VALUE_REGISTER))
    text = seed.str.add(text, definition("SALTIC_ABI_CALL_RETURN_ERROR_REGISTER", CALL_RETURN_ERROR_REGISTER))
    text = seed.str.add(text, definition("SALTIC_ABI_CALL_FIXED_SOURCE_KIND_REGISTER", CALL_FIXED_SOURCE_KIND_REGISTER))
    text = seed.str.add(text, definition("SALTIC_ABI_CALL_FIXED_TARGET_KIND_REGISTER", CALL_FIXED_TARGET_KIND_REGISTER))
    text = seed.str.add(text, definition("SALTIC_ABI_CALL_NO_ERROR", CALL_NO_ERROR))
    text = seed.str.add(text, definition("SALTIC_ABI_CALL_RAW_TYPE_SOURCE", CALL_RAW_TYPE_SOURCE))
    text = seed.str.add(text, definition("SALTIC_ABI_CALL_ERROR_REPRESENTATION_RAW_ID", CALL_ERROR_REPRESENTATION_RAW_ID))

    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_ALIGNMENT", OBJECT_ALIGNMENT))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_HEADER_BYTES", OBJECT_HEADER_BYTES))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_HEADER_KIND_OFFSET", OBJECT_HEADER_KIND_OFFSET))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_HEADER_PAYLOAD_BYTES_OFFSET", OBJECT_HEADER_PAYLOAD_BYTES_OFFSET))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_HEADER_FLAGS_OFFSET", OBJECT_HEADER_FLAGS_OFFSET))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_PAYLOAD_OFFSET", OBJECT_PAYLOAD_OFFSET))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_KIND_STRING", OBJECT_KIND_STRING))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_KIND_GROUP", OBJECT_KIND_GROUP))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_KIND_BOX", OBJECT_KIND_BOX))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_FLAGS_NONE", OBJECT_FLAGS_NONE))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_FLAG_STATIC", OBJECT_FLAG_STATIC))
    text = seed.str.add(text, definition("SALTIC_ABI_OBJECT_FLAGS_MASK", OBJECT_FLAGS_MASK))

    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_NONE", ERROR_NONE))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_ID_MISSING_FIELD", ERROR_MISSING_FIELD))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_ID_GROUP_BOUNDS", ERROR_GROUP_BOUNDS))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_ID_DIVISION_BY_ZERO", ERROR_DIVISION_BY_ZERO))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_ID_FILE", ERROR_FILE))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_ID_STRING_BOUNDS", ERROR_STRING_BOUNDS))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_ID_FIXED_INTEGER_OVERFLOW", ERROR_FIXED_INTEGER_OVERFLOW))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_ID_CONSTANT_CYCLE", ERROR_CONSTANT_CYCLE))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_MISSING_FIELD", error_value(ERROR_MISSING_FIELD)))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_GROUP_BOUNDS", error_value(ERROR_GROUP_BOUNDS)))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_DIVISION_BY_ZERO", error_value(ERROR_DIVISION_BY_ZERO)))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_FILE", error_value(ERROR_FILE)))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_STRING_BOUNDS", error_value(ERROR_STRING_BOUNDS)))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_FIXED_INTEGER_OVERFLOW", error_value(ERROR_FIXED_INTEGER_OVERFLOW)))
    text = seed.str.add(text, definition("SALTIC_ABI_ERROR_CONSTANT_CYCLE", error_value(ERROR_CONSTANT_CYCLE)))
    text = seed.str.add(text, definition("SALTIC_ABI_SYSTEM_ERROR_FIRST", SYSTEM_ERROR_FIRST))
    text = seed.str.add(text, definition("SALTIC_ABI_SYSTEM_ERROR_LAST", SYSTEM_ERROR_LAST))
    text = seed.str.add(text, definition("SALTIC_ABI_USER_ERROR_FIRST", USER_ERROR_FIRST))
    text = seed.str.add(text, definition_text("SALTIC_ABI_ERROR_MAXIMUM", ERROR_MAXIMUM_TEXT))
    out seed.str.add(text, "\n")
}
