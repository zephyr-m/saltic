use seed
use seed.abi
use seed.memory.model
use seed.machine.instruction
use seed.machine.codec
use seed.machine.layout
use seed.compiler.state

skill emit_add(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_add")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.A0, codec.A0, codec.A1, 0)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_sub(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_sub")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.A0, codec.A0, codec.A1, 0)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_mul(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_mul")
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, codec.A0, codec.A0, codec.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, codec.A1, codec.A1, codec.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.ZERO, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.A1, codec.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, codec.T1, codec.ZERO, ".L_mul_positive")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.T1, codec.ZERO, codec.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.A0, codec.ZERO, codec.A0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_mul_positive")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T1, codec.ZERO, ".L_mul_done")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_mul_loop")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T2, codec.T1, codec.ZERO, 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T2, codec.ZERO, ".L_mul_skip")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.T0, codec.T0, codec.A0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_mul_skip")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, codec.A0, codec.A0, codec.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, codec.T1, codec.T1, codec.ZERO, 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T1, codec.ZERO, ".L_mul_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_mul_done")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, codec.A0, codec.T0, codec.ZERO, abi.TAG_SHIFT)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_div(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_div")
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, codec.A0, codec.A0, codec.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, codec.A1, codec.A1, codec.ZERO, abi.TAG_SHIFT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.A1, codec.ZERO, "rt_division_by_zero")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.ZERO, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.ZERO, codec.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, codec.A0, codec.ZERO, ".L_div_left")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.A0, codec.ZERO, codec.A0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XORI, codec.T1, codec.T1, codec.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_left")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, codec.A1, codec.ZERO, ".L_div_right")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.A1, codec.ZERO, codec.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XORI, codec.T1, codec.T1, codec.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_right")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, codec.A0, codec.A1, ".L_div_done")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_loop")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.A0, codec.A0, codec.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.T0, codec.ZERO, 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.A0, codec.A1, ".L_div_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T1, codec.ZERO, ".L_div_encode")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.T0, codec.ZERO, codec.T0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_encode")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, codec.A0, codec.T0, codec.ZERO, abi.TAG_SHIFT)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_division_by_zero(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_division_by_zero")
    @error_value = abi.error_value(abi.ERROR_DIVISION_BY_ZERO)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, error_value)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_equal(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_equal")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.A0, codec.A1, ".L_equal_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T0, codec.A0, codec.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T1, codec.A1, codec.ZERO, abi.TAG_MASK)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T0, codec.T1, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T2, codec.ZERO, codec.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T0, codec.T2, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.A0, codec.A0, codec.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.A1, codec.A1, codec.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.A0, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T1, codec.A1, codec.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T0, codec.T1, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T2, codec.ZERO, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_equal_string")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T2, codec.T0, ".L_equal_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.T3, codec.A0, codec.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.T4, codec.A1, codec.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, codec.T3, codec.T3, codec.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, codec.T4, codec.T4, codec.ZERO, 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T3, codec.T4, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T2, codec.T2, codec.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_equal_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_equal_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, abi.YES)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, abi.NO)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

