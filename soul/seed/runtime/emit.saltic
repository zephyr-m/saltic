    compiler = state.emit_op(compiler, instruction.Kind.ORI, codec.A0, codec.A0, codec.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_no")
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.A0, "rt_no_text", 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, codec.A0, codec.A0, codec.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_error")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, codec.T0, codec.A0, codec.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.ZERO, codec.ZERO, abi.ERROR_FIXED_INTEGER_OVERFLOW)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T0, codec.T1, ".L_show_error_unknown")
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.A0, "rt_fixed_overflow_text", 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, codec.A0, codec.A0, codec.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_error_unknown")
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.A0, "rt_unknown_text", 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, codec.A0, codec.A0, codec.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_string")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T0, codec.A0, codec.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A2, codec.T0, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.T0, codec.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, 0 - 16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.RA, 12)
    compiler.machine = layout.emit_call(compiler.machine, "rt_platform_write")
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.RA, codec.SP, codec.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, abi.NONE)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill append_runtime_text(compiler, label, text) {
    compiler.machine = layout.align_section(compiler.machine, layout.Section.RODATA, 8)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.RODATA, label)
    compiler.machine = layout.append_section_word(compiler.machine, layout.Section.RODATA, layout.address_from_number(seed.str.len(text)))
    compiler.machine = layout.append_section_text(compiler.machine, layout.Section.RODATA, text, yes)
    out compiler
}

skill append_runtime_data(compiler) {
    compiler = append_runtime_text(compiler, "rt_unknown_text", "<value>")
    compiler = append_runtime_text(compiler, "rt_fixed_overflow_text", "значение вышло за границы фиксированного целого")
    compiler = append_runtime_text(compiler, "rt_yes_text", "yes")
    compiler = append_runtime_text(compiler, "rt_no_text", "no")
    compiler.machine = layout.align_section(compiler.machine, layout.Section.RODATA, 8)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.RODATA, "rt_newline_text")
    compiler.machine = layout.append_section_byte(compiler.machine, layout.Section.RODATA, 10)
    out compiler
}

