    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T0, codec.ZERO, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T1, codec.A0, codec.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T1, codec.A1, ".L_box_set_found")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.A0, codec.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.T0, codec.ZERO, 0 - 1)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_box_set_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_found")
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.A2, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, abi.NONE)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

