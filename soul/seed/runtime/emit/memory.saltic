use seed.str
use seed.abi
use seed.memory.model
use seed.process
use seed.machine.instruction
use seed.machine.codec
use seed.machine.layout
use seed.compiler.state
use seed.compiler.constants

WORD_BYTES = abi.VALUE_WORD_BYTES
COUNT_OFFSET = abi.OBJECT_PAYLOAD_OFFSET
GROUP_ITEMS_OFFSET = abi.OBJECT_PAYLOAD_OFFSET + WORD_BYTES
GROUP_ITEM_BYTES = WORD_BYTES
BOX_VALUES_OFFSET = abi.OBJECT_PAYLOAD_OFFSET + WORD_BYTES * 2
BOX_FIELD_BYTES = WORD_BYTES * 2
SIZE_ROUNDING = abi.OBJECT_HEADER_BYTES + abi.OBJECT_ALIGNMENT - 1
POINTER_TAG_COUNT = abi.TAG_BOX - abi.TAG_STRING + 1
KIND_LIMIT = abi.OBJECT_KIND_BOX + 1

EXIT_FRAME_BYTES = 16
EXIT_VALUE_OFFSET = 4
EXIT_ERROR_OFFSET = 8
EXIT_RETURN_OFFSET = 12

skill emit_alloc(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.T1, codec.A0, codec.ZERO, 0)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, codec.S1, codec.S2, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.A0, codec.ZERO, abi.OBJECT_HEADER_BYTES + abi.OBJECT_ALIGNMENT - 1)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, codec.A0, codec.T0, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T0, codec.T0, codec.ZERO, 0 - abi.OBJECT_ALIGNMENT)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.T2, codec.S2, codec.S1, 0)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, codec.T0, codec.T2, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.S1, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.S1, codec.S1, codec.T0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.T1, abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.ZERO, codec.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_out_of_memory(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_out_of_memory")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.S0, codec.ZERO, ".L_out_of_memory_exit")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.ZERO, codec.ZERO, abi.ERROR_MEMORY_EXHAUSTED)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A2, codec.ZERO, codec.ZERO, model.REGION_EXIT_VALUE_SKIPPED)
    compiler.machine = layout.emit_call(compiler.machine, "rt_region_exit")
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.RA, codec.S0, codec.ZERO, constants.return_address_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.S4, codec.S0, codec.ZERO, constants.region_mark_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.S5, codec.S0, codec.ZERO, constants.region_escape_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.S0, codec.ZERO, constants.previous_frame_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.S0, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.S0, codec.T0, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_out_of_memory_exit")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, process.EXIT_OUT_OF_MEMORY)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, "rt_platform_exit")
    out compiler
}

skill emit_pointer_address(compiler, skip) {
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T0, codec.A7, codec.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.T0, codec.ZERO, 0 - abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, codec.T1, codec.T1, codec.ZERO, POINTER_TAG_COUNT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T1, codec.ZERO, skip)
    out state.emit_op(compiler, instruction.Kind.ANDI, codec.T2, codec.A7, codec.ZERO, abi.PAYLOAD_MASK)
}

skill emit_object_size(compiler, size, object) {
    compiler = state.emit_op(compiler, instruction.Kind.LW, size, object, codec.ZERO, abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, size, size, codec.ZERO, SIZE_ROUNDING)
    out state.emit_op(compiler, instruction.Kind.ANDI, size, size, codec.ZERO, 0 - abi.OBJECT_ALIGNMENT)
}

skill emit_visit(compiler, visitor, base, offset) {
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A7, base, codec.ZERO, offset)
    compiler.machine = layout.emit_call(compiler.machine, visitor)
    out state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, base, codec.A7, offset)
}

skill emit_escape_walk(compiler, visitor, prefix) {
    @loop = "{prefix}_escape"
    @fields = "{prefix}_escape_fields"
    @slot = "{prefix}_escape_slot"
    @next = "{prefix}_escape_next"
    @done = "{prefix}_escape_done"
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A5, codec.S2, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, loop)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.A5, codec.S5, done)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A6, codec.A5, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T0, codec.A6, codec.ZERO, model.ESCAPE_SLOT_FLAG)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T0, codec.ZERO, slot)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.A6, codec.S4, next)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A2, codec.A6, codec.ZERO, COUNT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A6, codec.A6, codec.ZERO, BOX_VALUES_OFFSET)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, fields)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.A2, codec.ZERO, next)
    compiler = emit_visit(compiler, visitor, codec.A6, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A6, codec.A6, codec.ZERO, BOX_FIELD_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A2, codec.A2, codec.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, fields)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, slot)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.A6, codec.A6, codec.ZERO, model.ESCAPE_ENTRY_MASK)
    compiler = emit_visit(compiler, visitor, codec.A6, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, next)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A5, codec.A5, codec.ZERO, model.ESCAPE_ENTRY_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, loop)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, done)
    out compiler
}

skill emit_block_walk(compiler, visitor, prefix) {
    @loop = "{prefix}_block"
    @group = "{prefix}_block_group"
    @box = "{prefix}_block_box"
    @items = "{prefix}_block_items"
    @next = "{prefix}_block_next"
    @done = "{prefix}_block_done"
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A5, codec.A3, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, loop)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.A5, codec.A4, done)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.A5, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A6, codec.A1, codec.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.ZERO, codec.ZERO, abi.OBJECT_KIND_GROUP)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.A6, codec.T0, group)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.ZERO, codec.ZERO, abi.OBJECT_KIND_BOX)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.A6, codec.T0, box)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, next)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, group)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A2, codec.A1, codec.ZERO, COUNT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A6, codec.A1, codec.ZERO, GROUP_ITEMS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A5, codec.ZERO, codec.ZERO, GROUP_ITEM_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, items)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, box)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A2, codec.A1, codec.ZERO, COUNT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A6, codec.A1, codec.ZERO, BOX_VALUES_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A5, codec.ZERO, codec.ZERO, BOX_FIELD_BYTES)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, items)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.A2, codec.ZERO, next)
    compiler = emit_visit(compiler, visitor, codec.A6, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.A6, codec.A6, codec.A5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A2, codec.A2, codec.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, items)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, next)
    compiler = emit_object_size(compiler, codec.T0, codec.A1)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.A5, codec.A1, codec.T0, 0)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, loop)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, done)
    out compiler
}

skill emit_region_forward(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_forward")
    compiler = emit_pointer_address(compiler, ".L_region_forward_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, codec.T2, codec.S4, ".L_region_forward_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.T2, codec.A3, ".L_region_forward_done")
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T3, codec.T2, codec.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, codec.T1, codec.T3, codec.ZERO, KIND_LIMIT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T1, codec.ZERO, ".L_region_forward_moved")
    compiler = emit_object_size(compiler, codec.T4, codec.T2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.T5, codec.A4, codec.T4, 0)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, codec.T5, codec.S2, ".L_region_abort")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.ZERO, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_forward_copy")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T1, codec.T4, ".L_region_forward_copied")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.T5, codec.T2, codec.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T5, codec.T5, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.T3, codec.A4, codec.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T3, codec.T5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.T1, codec.ZERO, WORD_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_region_forward_copy")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_forward_copied")
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A4, codec.T2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T2, codec.A4, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.OR, codec.A7, codec.A4, codec.T0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.A4, codec.A4, codec.T4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_forward_moved")
    compiler = state.emit_op(compiler, instruction.Kind.OR, codec.A7, codec.T3, codec.T0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_forward_done")
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_region_relocate(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_relocate")
    compiler = emit_pointer_address(compiler, ".L_region_relocate_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, codec.T2, codec.A3, ".L_region_relocate_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.T2, codec.A4, ".L_region_relocate_done")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.A7, codec.A7, codec.T6, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_relocate_done")
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_region_restore(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_restore")
    compiler = emit_pointer_address(compiler, ".L_region_restore_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, codec.T2, codec.A3, ".L_region_restore_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.T2, codec.A4, ".L_region_restore_done")
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T2, codec.T2, codec.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.OR, codec.A7, codec.T2, codec.T0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_restore_done")
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_copies_walk(compiler, prefix, undo) {
    @loop = "{prefix}_copies"
    @done = "{prefix}_copies_done"
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A5, codec.A3, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, loop)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.A5, codec.A4, done)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.A5, codec.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    (undo == no) {
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.T0, codec.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
        compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T0, codec.T0, codec.ZERO, abi.OBJECT_FLAGS_MASK)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A5, codec.T0, abi.OBJECT_HEADER_FLAGS_OFFSET)
    }
    (undo == yes) {
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T1, codec.A5, codec.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T0, codec.T1, abi.OBJECT_HEADER_KIND_OFFSET)
    }
    compiler = emit_object_size(compiler, codec.T0, codec.A5)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.A5, codec.A5, codec.T0, 0)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, loop)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, done)
    out compiler
}

skill emit_slide(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.A3, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.S4, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_slide")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.T0, codec.A4, ".L_region_slid")
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T2, codec.T0, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T1, codec.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.T0, codec.ZERO, WORD_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.T1, codec.ZERO, WORD_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_region_slide")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_slid")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.T0, codec.A4, codec.A3, 0)
    out state.emit_op(compiler, instruction.Kind.ADD, codec.S1, codec.S4, codec.T0, 0)
}

skill emit_escape_compact(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.S5, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.S5, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_compact")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.S2, codec.T1, ".L_region_compacted")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.T1, codec.ZERO, 0 - model.ESCAPE_ENTRY_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T2, codec.T1, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T3, codec.T2, codec.ZERO, model.ESCAPE_SLOT_FLAG)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T3, codec.ZERO, ".L_region_compact_keep")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.T2, codec.S4, ".L_region_compact")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_compact_keep")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.T0, codec.ZERO, 0 - model.ESCAPE_ENTRY_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T0, codec.T2, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T3, codec.ZERO, ".L_region_compact")
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T4, codec.T2, codec.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T4, codec.T4, codec.ZERO, model.ESCAPE_FLAGS_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.OR, codec.T4, codec.T4, codec.T0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T2, codec.T4, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_region_compact")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_compacted")
    out state.emit_op(compiler, instruction.Kind.ADDI, codec.S2, codec.T0, codec.ZERO, 0)
}

skill emit_region_exit(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_exit")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.S1, codec.S4, ".L_region_exit_work")
    compiler = state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_exit_work")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, 0 - EXIT_FRAME_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.RA, EXIT_RETURN_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.A1, EXIT_ERROR_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.A0, EXIT_VALUE_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A3, codec.S1, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A4, codec.S1, codec.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.A2, codec.ZERO, ".L_region_exit_roots")
    compiler = emit_visit(compiler, "rt_region_forward", codec.SP, EXIT_VALUE_OFFSET)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_exit_roots")
    compiler = emit_escape_walk(compiler, "rt_region_forward", ".L_region_forward")
    compiler = emit_block_walk(compiler, "rt_region_forward", ".L_region_scan")
    compiler = emit_copies_walk(compiler, ".L_region_settle", no)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.T6, codec.A3, codec.S4, 0)
    compiler = emit_visit(compiler, "rt_region_relocate", codec.SP, EXIT_VALUE_OFFSET)
    compiler = emit_escape_walk(compiler, "rt_region_relocate", ".L_region_relocate")
    compiler = emit_block_walk(compiler, "rt_region_relocate", ".L_region_relocated")
    compiler = emit_slide(compiler)
    compiler = emit_escape_compact(compiler)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ".L_region_exit_return")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_abort")
    compiler = emit_copies_walk(compiler, ".L_region_undo", yes)
    compiler = emit_visit(compiler, "rt_region_restore", codec.SP, EXIT_VALUE_OFFSET)
    compiler = emit_escape_walk(compiler, "rt_region_restore", ".L_region_restore")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_exit_return")
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A0, codec.SP, codec.ZERO, EXIT_VALUE_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A1, codec.SP, codec.ZERO, EXIT_ERROR_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.RA, codec.SP, codec.ZERO, EXIT_RETURN_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, EXIT_FRAME_BYTES)
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_region_barrier(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_barrier")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T0, codec.A2, codec.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.T0, codec.ZERO, 0 - abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, codec.T0, codec.T0, codec.ZERO, POINTER_TAG_COUNT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T0, codec.ZERO, ".L_region_barrier_done")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T1, codec.A2, codec.ZERO, abi.PAYLOAD_MASK)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.T2, codec.S4, ".L_region_barrier_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, codec.T2, codec.T1, ".L_region_barrier_done")
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.T2, codec.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T1, codec.T0, codec.ZERO, model.ESCAPE_ENTRY_MASK)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T1, codec.ZERO, ".L_region_barrier_record")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, codec.T1, codec.S5, ".L_region_barrier_done")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_barrier_record")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.S2, codec.ZERO, 0 - model.ESCAPE_ENTRY_BYTES)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, codec.T1, codec.S1, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.S2, codec.T1, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S2, codec.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T0, codec.T0, codec.ZERO, model.ESCAPE_FLAGS_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.OR, codec.T0, codec.T0, codec.S2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T2, codec.T0, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_barrier_done")
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill emit_region_remember_slot(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_remember_slot")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T1, codec.A0, codec.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.T1, codec.ZERO, 0 - abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, codec.T1, codec.T1, codec.ZERO, POINTER_TAG_COUNT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T1, codec.ZERO, ".L_region_remember_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.S2, codec.ZERO, 0 - model.ESCAPE_ENTRY_BYTES)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, codec.T1, codec.S1, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.S2, codec.T1, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, codec.T0, codec.T0, codec.ZERO, model.ESCAPE_SLOT_FLAG)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S2, codec.T0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_remember_done")
    out state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
}

skill append_runtime(compiler) {
    compiler = emit_alloc(compiler)
    compiler = emit_out_of_memory(compiler)
    compiler = emit_region_exit(compiler)
    compiler = emit_region_forward(compiler)
    compiler = emit_region_relocate(compiler)
    compiler = emit_region_restore(compiler)
    compiler = emit_region_barrier(compiler)
    out emit_region_remember_slot(compiler)
}
