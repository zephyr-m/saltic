+use seed
use seed.memory.model

skill assembly() {
    out seed.str.add(model.assembly(), "
rt_alloc:
  addi a0, a0, SALTIC_ABI_TAG_MASK
  andi a0, a0, SALTIC_ABI_PAYLOAD_MASK
  add t0, s1, a0
  bgtu t0, s2, rt_out_of_memory
  addi a0, s1, 0
  addi s1, t0, 0
  jalr zero, 0(ra)

rt_fixed_mem_load8:
  addi a2, zero, SALTIC_ABI_FIXED_U8
  j rt_fixed_mem_load
rt_fixed_mem_load16:
  addi a2, zero, SALTIC_ABI_FIXED_U16
  j rt_fixed_mem_load
rt_fixed_mem_load32:
  addi a2, zero, SALTIC_ABI_FIXED_U32
rt_fixed_mem_load:
  andi t0, a0, SALTIC_ABI_PAYLOAD_MASK
  andi t1, a1, SALTIC_ABI_PAYLOAD_MASK
  lw t0, 0(t0)
  lw t1, 0(t1)
  add t0, t0, t1
  add a1, a2, zero
  addi t1, zero, SALTIC_ABI_FIXED_U8
  beq a2, t1, .L_fixed_mem_load8
  addi t1, zero, SALTIC_ABI_FIXED_U16
  beq a2, t1, .L_fixed_mem_load16
  lw a0, 0(t0)
  j rt_fixed_new
.L_fixed_mem_load8:
  lbu a0, 0(t0)
  j rt_fixed_new
.L_fixed_mem_load16:
  lhu a0, 0(t0)
  j rt_fixed_new
rt_fixed_mem_store8:
  addi t3, zero, 1
  j rt_fixed_mem_store
rt_fixed_mem_store16:
  addi t3, zero, 2
  j rt_fixed_mem_store
rt_fixed_mem_store32:
  addi t3, zero, 3
rt_fixed_mem_store:
  andi t0, a0, SALTIC_ABI_PAYLOAD_MASK
  andi t1, a1, SALTIC_ABI_PAYLOAD_MASK
  andi t2, a2, SALTIC_ABI_PAYLOAD_MASK
  lw t0, 0(t0)
  lw t1, 0(t1)
  lw t2, 0(t2)
  add t0, t0, t1
  addi t1, zero, 1
  beq t3, t1, .L_fixed_mem_store8
  addi t1, zero, 2
  beq t3, t1, .L_fixed_mem_store16
  sw t2, 0(t0)
  j .L_fixed_mem_store_done
.L_fixed_mem_store8:
  sb t2, 0(t0)
  j .L_fixed_mem_store_done
.L_fixed_mem_store16:
  sh t2, 0(t0)
.L_fixed_mem_store_done:
  addi a0, zero, 2
  jalr zero, 0(ra)

rt_mem_load8:
  andi t0, a0, SALTIC_ABI_PAYLOAD_MASK
  lw t1, 4(t0)
  lw t2, 8(t0)
  srai t1, t1, SALTIC_ABI_TAG_SHIFT
  srai t2, t2, SALTIC_ABI_TAG_SHIFT
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  srai a1, a1, SALTIC_ABI_TAG_SHIFT
  or t0, t1, t2
  add t0, t0, a1
  lbu a0, 0(t0)
  slli a0, a0, SALTIC_ABI_TAG_SHIFT
  jalr zero, 0(ra)
rt_mem_load16:
  andi t0, a0, SALTIC_ABI_PAYLOAD_MASK
  lw t1, 4(t0)
  lw t2, 8(t0)
  srai t1, t1, SALTIC_ABI_TAG_SHIFT
  srai t2, t2, SALTIC_ABI_TAG_SHIFT
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  srai a1, a1, SALTIC_ABI_TAG_SHIFT
  or t0, t1, t2
  add t0, t0, a1
  lhu a0, 0(t0)
  slli a0, a0, SALTIC_ABI_TAG_SHIFT
  jalr zero, 0(ra)
rt_mem_load32:
  andi t0, a0, SALTIC_ABI_PAYLOAD_MASK
  lw t1, 4(t0)
  lw t2, 8(t0)
  srai t1, t1, SALTIC_ABI_TAG_SHIFT
  srai t2, t2, SALTIC_ABI_TAG_SHIFT
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  srai a1, a1, SALTIC_ABI_TAG_SHIFT
  or t0, t1, t2
  add t0, t0, a1
  lw a0, 0(t0)
  slli a0, a0, SALTIC_ABI_TAG_SHIFT
  jalr zero, 0(ra)
rt_mem_store8:
  andi t0, a0, SALTIC_ABI_PAYLOAD_MASK
  lw t1, 4(t0)
  lw t2, 8(t0)
  srai t1, t1, SALTIC_ABI_TAG_SHIFT
  srai t2, t2, SALTIC_ABI_TAG_SHIFT
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  srai a1, a1, SALTIC_ABI_TAG_SHIFT
  srai a2, a2, SALTIC_ABI_TAG_SHIFT
  or t0, t1, t2
  add t0, t0, a1
  sb a2, 0(t0)
  addi a0, zero, 2
  jalr zero, 0(ra)
rt_mem_store16:
  andi t0, a0, SALTIC_ABI_PAYLOAD_MASK
  lw t1, 4(t0)
  lw t2, 8(t0)
  srai t1, t1, SALTIC_ABI_TAG_SHIFT
  srai t2, t2, SALTIC_ABI_TAG_SHIFT
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  srai a1, a1, SALTIC_ABI_TAG_SHIFT
  srai a2, a2, SALTIC_ABI_TAG_SHIFT
  or t0, t1, t2
  add t0, t0, a1
  sh a2, 0(t0)
  addi a0, zero, 2
  jalr zero, 0(ra)
rt_mem_store32:
  andi t0, a0, SALTIC_ABI_PAYLOAD_MASK
  lw t1, 4(t0)
  lw t2, 8(t0)
  srai t1, t1, SALTIC_ABI_TAG_SHIFT
  srai t2, t2, SALTIC_ABI_TAG_SHIFT
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  srai a1, a1, SALTIC_ABI_TAG_SHIFT
  srai a2, a2, SALTIC_ABI_TAG_SHIFT
  or t0, t1, t2
  add t0, t0, a1
  sw a2, 0(t0)
  addi a0, zero, 2
  jalr zero, 0(ra)
rt_mem_store_address32:
  andi t0, a0, SALTIC_ABI_PAYLOAD_MASK
  lw t1, 4(t0)
  lw t2, 8(t0)
  srai t1, t1, SALTIC_ABI_TAG_SHIFT
  srai t2, t2, SALTIC_ABI_TAG_SHIFT
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  or t0, t1, t2
  srai a1, a1, SALTIC_ABI_TAG_SHIFT
  add t0, t0, a1
  andi t3, a2, SALTIC_ABI_PAYLOAD_MASK
  lw t1, 4(t3)
  lw t2, 8(t3)
  srai t1, t1, SALTIC_ABI_TAG_SHIFT
  srai t2, t2, SALTIC_ABI_TAG_SHIFT
  slli t1, t1, 16
  slli t2, t2, 16
  srli t2, t2, 16
  or t3, t1, t2
  sw t3, 0(t0)
  addi a0, zero, 2
  jalr zero, 0(ra)

rt_out_of_memory:
  addi a0, zero, SALTIC_MEMORY_OUT_OF_MEMORY_EXIT_STATUS
  j rt_platform_exit
")
}
