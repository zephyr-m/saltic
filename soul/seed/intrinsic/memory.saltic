use seed.intrinsic

skill is_load(kind) {
    (kind == intrinsic.Kind.MEM_LOAD8) { out yes }
    (kind == intrinsic.Kind.MEM_LOAD16) { out yes }
    (kind == intrinsic.Kind.MEM_LOAD32) { out yes }
    out no
}

skill is_store(kind) {
    (kind == intrinsic.Kind.MEM_STORE8) { out yes }
    (kind == intrinsic.Kind.MEM_STORE16) { out yes }
    (kind == intrinsic.Kind.MEM_STORE32) { out yes }
    (kind == intrinsic.Kind.MEM_STORE_ADDRESS32) { out yes }
    out no
}

skill load_type(kind, address_type) {
    (address_type == "address") {
        (kind == intrinsic.Kind.MEM_LOAD8) { out "u8" }
        (kind == intrinsic.Kind.MEM_LOAD16) { out "u16" }
        (kind == intrinsic.Kind.MEM_LOAD32) { out "u32" }
    }
    (is_load(kind) == yes) { out "number" }
    out "unknown"
}

skill store_type(kind, address_type) {
    (address_type == "address") {
        (kind == intrinsic.Kind.MEM_STORE8) { out "u8" }
        (kind == intrinsic.Kind.MEM_STORE16) { out "u16" }
        (kind == intrinsic.Kind.MEM_STORE32) { out "u32" }
    }
    out "unknown"
}

skill target(kind, address_type) {
    (address_type == "address") {
        (kind == intrinsic.Kind.MEM_LOAD8) { out "rt_fixed_mem_load8" }
        (kind == intrinsic.Kind.MEM_LOAD16) { out "rt_fixed_mem_load16" }
        (kind == intrinsic.Kind.MEM_LOAD32) { out "rt_fixed_mem_load32" }
        (kind == intrinsic.Kind.MEM_STORE8) { out "rt_fixed_mem_store8" }
        (kind == intrinsic.Kind.MEM_STORE16) { out "rt_fixed_mem_store16" }
        (kind == intrinsic.Kind.MEM_STORE32) { out "rt_fixed_mem_store32" }
    }
    (kind == intrinsic.Kind.MEM_LOAD8) { out "rt_mem_load8" }
    (kind == intrinsic.Kind.MEM_LOAD16) { out "rt_mem_load16" }
    (kind == intrinsic.Kind.MEM_LOAD32) { out "rt_mem_load32" }
    (kind == intrinsic.Kind.MEM_STORE8) { out "rt_mem_store8" }
    (kind == intrinsic.Kind.MEM_STORE16) { out "rt_mem_store16" }
    (kind == intrinsic.Kind.MEM_STORE32) { out "rt_mem_store32" }
    (kind == intrinsic.Kind.MEM_STORE_ADDRESS32) { out "rt_mem_store_address32" }
    out ""
}
