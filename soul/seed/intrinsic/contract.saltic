use seed.intrinsic
use seed.intrinsic.fixed
use seed.intrinsic.memory

skill find(name) {
    out intrinsic.find(name)
}

skill is_known(name) {
    out (find(name) == intrinsic.Kind.UNKNOWN) == no
}

skill minimum_arguments(kind) {
    out intrinsic.minimum_arguments(kind)
}

skill maximum_arguments(kind) {
    out intrinsic.maximum_arguments(kind)
}

skill result(kind, input_type) {
    (memory.is_load(kind) == yes) { out memory.load_type(kind, input_type) }
    out intrinsic.result(kind)
}

skill target(kind, input_type) {
    @target_name = memory.target(kind, input_type)
    ((target_name == "") == no) { out target_name }
    target_name = fixed.target(kind)
    ((target_name == "") == no) { out target_name }
    out intrinsic.target(kind)
}

skill conversion(kind) {
    out fixed.conversion(kind)
}

skill store_type(kind, input_type) {
    out memory.store_type(kind, input_type)
}

skill is_fixed_type(type) {
    out fixed.is_type(type)
}

skill fixed_kind(type) {
    out fixed.kind(type)
}

skill fixed_in_range(type, text) {
    out fixed.in_range(type, text)
}

skill fixed_range_text(type) {
    out fixed.range_text(type)
}

skill is_fixed_call(kind) {
    out fixed.is_call(kind)
}

skill is_show(kind) {
    out kind == intrinsic.Kind.IO_SHOW
}

skill is_memory(kind) {
    (memory.is_load(kind) == yes) { out yes }
    out memory.is_store(kind)
}

skill checked_argument(kind) {
    out fixed.checked_argument(kind)
}

skill checked_type(kind) {
    out fixed.checked_type(kind)
}
