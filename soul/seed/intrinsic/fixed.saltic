use seed.intrinsic
use seed.abi

skill is_type(type) {
    out abi.is_fixed_type(type)
}

skill kind(type) {
    out abi.fixed_type_kind(type)
}

skill in_range(type, text) {
    out abi.fixed_type_in_range(type, text)
}

skill range_text(type) {
    out abi.fixed_type_range_text(type)
}

skill conversion(kind) {
    (kind == intrinsic.Kind.U8_FROM) { out "u8" }
    (kind == intrinsic.Kind.U16_FROM) { out "u16" }
    (kind == intrinsic.Kind.U32_FROM) { out "u32" }
    (kind == intrinsic.Kind.I32_FROM) { out "i32" }
    (kind == intrinsic.Kind.USIZE_FROM) { out "usize" }
    out ""
}

skill target(kind) {
    (kind == intrinsic.Kind.BITS32_AND) { out "rt_fixed_and" }
    (kind == intrinsic.Kind.BITS32_OR) { out "rt_fixed_or" }
    (kind == intrinsic.Kind.BITS32_XOR) { out "rt_fixed_xor" }
    (kind == intrinsic.Kind.BITS32_NOT) { out "rt_fixed_not" }
    (kind == intrinsic.Kind.BITS32_SHIFT_LEFT) { out "rt_fixed_shift_left" }
    (kind == intrinsic.Kind.BITS32_SHIFT_RIGHT) { out "rt_fixed_shift_right" }
    (kind == intrinsic.Kind.ADDRESS_ADD) { out "rt_fixed_add" }
    out ""
}

skill is_call(kind) {
    out (target(kind) == "") == no
}

skill checked_argument(kind) {
    (kind == intrinsic.Kind.BITS32_NOT) { out 0 }
    (kind == intrinsic.Kind.BITS32_AND) { out 1 }
    (kind == intrinsic.Kind.BITS32_OR) { out 1 }
    (kind == intrinsic.Kind.BITS32_XOR) { out 1 }
    (kind == intrinsic.Kind.BITS32_SHIFT_LEFT) { out 1 }
    (kind == intrinsic.Kind.BITS32_SHIFT_RIGHT) { out 1 }
    out 0 - 1
}

skill checked_type(kind) {
    (kind == intrinsic.Kind.BITS32_SHIFT_LEFT) { out "u8" }
    (kind == intrinsic.Kind.BITS32_SHIFT_RIGHT) { out "u8" }
    ((checked_argument(kind) < 0) == no) { out "bits32" }
    out ""
}
