use seed

skill strip_location(value) {
    (seed.group.count(value) == 4) {
        (seed.group.item(value, 0) == "loc") { out seed.group.item(value, 3) }
    }
    out value
}

skill plain(value) {
    @datum = value
    (seed.group.count(datum) == 3) {
        (seed.group.item(datum, 0) == "module") { datum = seed.group.item(datum, 2) }
    }
    out strip_location(datum)
}

skill module_name(value) {
    (seed.group.count(value) == 3) {
        (seed.group.item(value, 0) == "module") { out seed.group.item(value, 1) }
    }
    out ""
}

skill location(value) {
    @datum = value
    (seed.group.count(datum) == 3) {
        (seed.group.item(datum, 0) == "module") { datum = seed.group.item(datum, 2) }
    }
    (seed.group.count(datum) == 4) {
        (seed.group.item(datum, 0) == "loc") { out [seed.group.item(datum, 1), seed.group.item(datum, 2)] }
    }
    out [0, 0]
}

skill located(datum, line, col) {
    out ["loc", line, col, datum]
}

skill in_module(name, value) {
    out ["module", name, value]
}

skill tag(value) {
    out seed.group.item(plain(value), 0)
}

skill part(value, index) {
    out seed.group.item(plain(value), index)
}

skill call_callee(value) {
    out part(value, 1)
}

skill call_argument_count(value) {
    out seed.group.count(plain(value)) - 2
}

skill call_argument(value, index) {
    out part(value, index + 2)
}

skill enum_variant_count(value) {
    out seed.group.count(plain(value)) - 2
}

skill enum_variant(value, index) {
    out part(value, index + 2)
}

skill switch_subject(value) {
    out part(value, 1)
}

skill switch_case_count(value) {
    out seed.group.count(plain(value)) - 2
}

skill switch_case(value, index) {
    out part(value, index + 2)
}

skill case_variant(value) {
    out part(value, 1)
}

skill case_body(value) {
    out part(value, 2)
}

skill path_text(path) {
    @datum = plain(path)
    @text = seed.group.item(datum, 1)
    @index = 2
    @count = seed.group.count(datum)
    drum (count) {
        (index < count) {
            text = seed.str.add(text, ".")
            text = seed.str.add(text, seed.group.item(datum, index))
            index = index + 1
        }
    }
    out text
}

skill path_prefix(path) {
    @datum = plain(path)
    @count = seed.group.count(datum)
    @text = seed.group.item(datum, 1)
    @index = 2
    drum (count - 1) {
        (index < count - 1) {
            text = seed.str.add(text, ".")
            text = seed.str.add(text, seed.group.item(datum, index))
            index = index + 1
        }
    }
    out text
}

skill qualified(module_name, name) {
    (seed.str.len(module_name) == 0) { out name }
    out seed.str.add(module_name, seed.str.add(".", name))
}

skill alias_key(module_name, alias) {
    out seed.str.add(module_name, seed.str.add("|", alias))
}

skill name_head(name) {
    @index = 0
    @count = seed.str.len(name)
    drum (count) {
        (index < count) {
            (seed.str.at(name, index) == ".") { out seed.str.slice(name, 0, index) }
            index = index + 1
        }
    }
    out name
}

skill name_tail(name) {
    @index = 0
    @count = seed.str.len(name)
    drum (count) {
        (index < count) {
            (seed.str.at(name, index) == ".") { out seed.str.slice(name, index, count) }
            index = index + 1
        }
    }
    out ""
}

skill name_module(name) {
    @last = 0
    @index = 0
    @count = seed.str.len(name)
    drum (count) {
        (index < count) {
            (seed.str.at(name, index) == ".") { last = index }
            index = index + 1
        }
    }
    (last == 0) { out "" }
    out seed.str.slice(name, 0, last)
}
