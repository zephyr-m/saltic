use seed

ALIGNMENT = 8

HEADER_KIND_OFFSET = 0
HEADER_PAYLOAD_BYTES_OFFSET = 4
HEADER_FLAGS_OFFSET = 8
HEADER_AUXILIARY_OFFSET = 12
HEADER_BYTES = 16
PAYLOAD_OFFSET = HEADER_BYTES

KIND_STRING = 1
KIND_GROUP = 2
KIND_BOX = 3

FLAGS_NONE = 0
FLAG_STATIC = 1
FLAG_MARKED = 2
FLAGS_MASK = FLAG_STATIC + FLAG_MARKED

skill aligned_size(bytes) {
    @remainder = bytes - bytes / ALIGNMENT * ALIGNMENT
    (remainder == 0) { out bytes }
    out bytes + ALIGNMENT - remainder
}

skill allocation_size(payload_bytes) {
    (payload_bytes < 0) { out 0 - 1 }
    out aligned_size(HEADER_BYTES + payload_bytes)
}

skill valid_kind(kind) {
    (kind == KIND_STRING) { out yes }
    (kind == KIND_GROUP) { out yes }
    (kind == KIND_BOX) { out yes }
    out no
}

skill has_flag(flags, flag) {
    (valid_flags(flags) == no) { out no }
    (valid_flag(flag) == no) { out no }
    @part = flags / flag
    out part - part / 2 * 2 == 1
}

skill valid_flag(flag) {
    (flag == FLAG_STATIC) { out yes }
    (flag == FLAG_MARKED) { out yes }
    out no
}

skill valid_flags(flags) {
    (flags < FLAGS_NONE) { out no }
    (flags > FLAGS_MASK) { out no }
    out yes
}

skill is_static(flags) {
    out has_flag(flags, FLAG_STATIC)
}

skill is_marked(flags) {
    out has_flag(flags, FLAG_MARKED)
}
