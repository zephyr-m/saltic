use seed.abi.tags

NO_ERROR = 0
MISSING_FIELD = 1
GROUP_BOUNDS = 2
DIVISION_BY_ZERO = 3
FILE = 4
STRING_BOUNDS = 5
FIXED_INTEGER_OVERFLOW = 6
CONSTANT_CYCLE = 7

SYSTEM_FIRST = MISSING_FIELD
SYSTEM_LAST = CONSTANT_CYCLE
USER_FIRST = SYSTEM_LAST + 1
MAXIMUM_TEXT = "268435455"

skill valid_id(id) {
    (id < SYSTEM_FIRST) { out no }
    out yes
}

skill value(id) {
    (valid_id(id) == no) { out tags.EMPTY }
    out tags.tagged(id, tags.ERROR)
}

skill user_id(index) {
    (index < 0) { out NO_ERROR }
    out USER_FIRST + index
}

skill user_value(index) {
    out value(user_id(index))
}

skill is_system(id) {
    (id < SYSTEM_FIRST) { out no }
    (id > SYSTEM_LAST) { out no }
    out yes
}

skill is_user(id) {
    (id < USER_FIRST) { out no }
    out yes
}
