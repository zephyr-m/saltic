SHIFT = 3
SCALE = 8
MASK = 7
PAYLOAD_MASK = 0 - SCALE

NUMBER = 0
ANSWER = 1
NONE = 2
STRING = 3
GROUP = 4
BOX = 5
ENUM = 6
ERROR = 7

NO = ANSWER
YES = SCALE + ANSWER
EMPTY = NONE

skill valid(tag) {
    (tag < NUMBER) { out no }
    (tag > ERROR) { out no }
    out yes
}

skill tagged(id, tag) {
    (valid(tag) == no) { out EMPTY }
    out id * SCALE + tag
}

skill id(value) {
    out value / SCALE
}

skill tag(value) {
    out value - id(value) * SCALE
}

skill payload(value) {
    out id(value)
}
