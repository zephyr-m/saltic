use seed.str
use seed.group
use seed.num
use seed.vm.state

skill word_small(word) {
    (word.b3 > 15) { out -1 }
    out state.word_address(word)
}

skill pointer(machine, word) {
    out state.memory_offset(machine.memory, word)
}

skill flag(value, flag) {
    out state.mod(value / flag, 2) == 1
}

skill memory_matches(machine, address, data) {
    @count = group.count(data)
    (address < 0) { out no }
    (address > machine.memory.size - count - 1) { out no }
    @same = yes
    drum (count) {
        @memory_byte = state.memory_raw_load8(machine.memory, address + beat)
        @data_byte = group.at(data, beat)
        (memory_byte < data_byte) { same = no }
        (memory_byte > data_byte) { same = no }
    }
    (state.memory_raw_load8(machine.memory, address + count) > 0) { same = no }
    out same
}

skill memory_name(machine, address) {
    drum (machine.names) {
        (memory_matches(machine, address, beat.data) == yes) { out beat }
    }
    out state.Name {}
}

skill file_index(machine, path) {
    @count = group.count(machine.files)
    drum (count) {
        @index = count - 1 - beat
        @file = group.at(machine.files, index)
        (file.path == path) { out index }
    }
    out -1
}

skill handle(machine, guest_fd) {
    drum (machine.handles) {
        (beat.guest_fd == guest_fd) {
            (beat.open == yes) { out beat }
        }
    }
    out state.Handle {}
}

skill file_set(file, position, value) {
    @count = group.count(file.data)
    (position < count) {
        @next = []
        drum (count) {
            @item = group.at(file.data, beat)
            (beat == position) { item = value }
            next = group.add(next, item)
        }
        file.data = next
        out none
    }
    drum (position - count) { file.data = group.add(file.data, 0) }
    file.data = group.add(file.data, value)
    out none
}

skill open(machine) {
    @address = pointer(machine, state.register(machine, 11))
    @flags = word_small(state.register(machine, 12))
    @name = memory_name(machine, address)
    (name.present == no) { out state.word_number(-1) }

    @access = state.mod(flags, 4)
    @readable = access == 0
    @writable = access > 0
    @create = flag(flags, 64)
    @exclusive = flag(flags, 128)
    @truncate = flag(flags, 512)
    @append = flag(flags, 1024)
    @file_index = file_index(machine, name.text)
    @existed = file_index > -1

    (file_index < 0) {
        (create == no) { out state.word_number(-1) }
        machine.files = group.add(machine.files, state.File { path = name.text data = [] })
        file_index = group.count(machine.files) - 1
    }
    (existed == yes) {
        (create == yes) {
            (exclusive == yes) { out state.word_number(-1) }
        }
    }

    @file = group.at(machine.files, file_index)
    (truncate == yes) { file.data = [] }
    @position = 0
    (append == yes) { position = group.count(file.data) }
    @fd = machine.next_fd
    machine.next_fd = machine.next_fd + 1
    machine.handles = group.add(machine.handles, state.Handle {
        guest_fd = fd
        file_index = file_index
        position = position
        readable = readable
        writable = writable
        append = append
        open = yes
    })
    out state.word_number(fd)
}

skill close(machine) {
    @fd = word_small(state.register(machine, 10))
    @handle = handle(machine, fd)
    (handle.open == no) { out state.word_number(-1) }
    handle.open = no
    out state.word_zero()
}

skill seek(machine) {
    @fd = word_small(state.register(machine, 10))
    @offset = state.word_signed_number(state.register(machine, 11))
    @whence = word_small(state.register(machine, 12))
    @handle = handle(machine, fd)
    (handle.open == no) { out state.word_number(-1) }
    @position = handle.position
    (whence == 0) { position = offset }
    (whence == 1) { position = position + offset }
    (whence == 2) {
        @file = group.at(machine.files, handle.file_index)
        position = group.count(file.data) + offset
    }
    (whence < 0) { out state.word_number(-1) }
    (whence > 2) { out state.word_number(-1) }
    (position < 0) { out state.word_number(-1) }
    handle.position = position
    out state.word_number(position)
}

skill read(machine) {
    @fd = word_small(state.register(machine, 10))
    @address = pointer(machine, state.register(machine, 11))
    @requested = word_small(state.register(machine, 12))
    @handle = handle(machine, fd)
    (handle.open == no) { out state.word_number(-1) }
    (handle.readable == no) { out state.word_number(-1) }
    (address < 0) { out state.word_number(-1) }
    (address > machine.memory.size - requested) { out state.word_number(-1) }
    @file = group.at(machine.files, handle.file_index)
    @available = group.count(file.data) - handle.position
    @count = requested
    (count > available) { count = available }
    drum (count) {
        state.memory_raw_store8(machine.memory, address + beat, group.at(file.data, handle.position + beat))
    }
    handle.position = handle.position + count
    out state.word_number(count)
}

skill write_file(machine, handle, address, count) {
    @file = group.at(machine.files, handle.file_index)
    drum (count) {
        file_set(file, handle.position + beat, state.memory_raw_load8(machine.memory, address + beat))
    }
    handle.position = handle.position + count
    out state.word_number(count)
}

skill write(machine) {
    @fd = word_small(state.register(machine, 10))
    @address = pointer(machine, state.register(machine, 11))
    @count = word_small(state.register(machine, 12))
    (address < 0) { out state.word_number(-1) }
    (address > machine.memory.size - count) { out state.word_number(-1) }
    (fd == 1) {
        drum (count) {
            machine.stdout = group.add(machine.stdout, state.memory_raw_load8(machine.memory, address + beat))
        }
        out state.word_number(count)
    }
    (fd == 2) {
        drum (count) {
            machine.stderr = group.add(machine.stderr, state.memory_raw_load8(machine.memory, address + beat))
        }
        out state.word_number(count)
    }
    @handle = handle(machine, fd)
    (handle.open == no) { out state.word_number(-1) }
    (handle.writable == no) { out state.word_number(-1) }
    out write_file(machine, handle, address, count)
}

skill ecall(machine) {
    @number = word_small(state.register(machine, 17))
    (number == 56) { state.set_register(machine, 10, open(machine)) out none }
    (number == 57) { state.set_register(machine, 10, close(machine)) out none }
    (number == 62) { state.set_register(machine, 10, seek(machine)) out none }
    (number == 29) { state.set_register(machine, 10, state.word_number(-25)) out none }
    (number == 63) { state.set_register(machine, 10, read(machine)) out none }
    (number == 64) { state.set_register(machine, 10, write(machine)) out none }
    (number == 93) {
        @code = state.register(machine, 10)
        machine.exit_code = code.b0
        machine.halted = yes
        machine.halt_reason = "exit"
        state.set_register(machine, 10, state.word_zero())
        out none
    }
    (number == 94) {
        @code = state.register(machine, 10)
        machine.exit_code = code.b0
        machine.halted = yes
        machine.halt_reason = "exit"
        state.set_register(machine, 10, state.word_zero())
        out none
    }
    state.trap(machine, "неподдерживаемый ecall", str.add("номер ", num.text(number)))
    out none
}
