use seed

PAGE_SIZE = 256
HEX = "0123456789abcdef"
PRINTABLE = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

Word = Box {
    b0 = 0
    b1 = 0
    b2 = 0
    b3 = 0
}

Byte = Box {
    value = 0
}

Page = Box {
    index = 0
    present = no
    cells = []
}

Memory = Box {
    size = 0
    pages = []
}

File = Box {
    path = ""
    data = []
}

Name = Box {
    text = ""
    data = []
    present = no
}

Handle = Box {
    guest_fd = 0
    file_index = 0
    position = 0
    readable = no
    writable = no
    append = no
    open = no
}

Options = Box {
    load_address = 4096
    memory_size = 262144
    step_limit = 100000
    program_name = "program"
    arguments = []
    files = []
}

Result = Box {
    exit_code = 0
    reason = ""
    pc = "00000000"
    steps = 0
    registers = []
    stdout = []
    stderr = []
    files = []
    trap = ""
}

Machine = Box {
    memory = Memory {}
    registers = []
    pc = 0
    halted = no
    halt_reason = ""
    exit_code = 0
    steps = 0
    trap = ""
    stdout = []
    stderr = []
    files = []
    names = []
    handles = []
    next_fd = 3
}

Instruction = Box {
    word = Word {}
    opcode = 0
    rd = 0
    funct3 = 0
    rs1 = 0
    rs2 = 0
    funct7 = 0
}

Control = Box {
    next_pc = 0
    handled = no
}

skill mod(value, divisor) {
    out value - value / divisor * divisor
}

skill word_bytes(b0, b1, b2, b3) {
    out Word { b0 = b0 b1 = b1 b2 = b2 b3 = b3 }
}

skill word_zero() {
    out Word {}
}

skill word_copy(word) {
    out word_bytes(word.b0, word.b1, word.b2, word.b3)
}

skill byte_and(left, right) {
    @a = left
    @b = right
    @weight = 1
    @result = 0
    drum (8) {
        @a_bit = mod(a, 2)
        @b_bit = mod(b, 2)
        (a_bit == 1) {
            (b_bit == 1) { result = result + weight }
        }
        a = a / 2
        b = b / 2
        weight = weight * 2
    }
    out result
}

skill byte_or(left, right) {
    @a = left
    @b = right
    @weight = 1
    @result = 0
    drum (8) {
        @bits = mod(a, 2) + mod(b, 2)
        (bits > 0) { result = result + weight }
        a = a / 2
        b = b / 2
        weight = weight * 2
    }
    out result
}

skill byte_xor(left, right) {
    @a = left
    @b = right
    @weight = 1
    @result = 0
    drum (8) {
        @bits = mod(a, 2) + mod(b, 2)
        (bits == 1) { result = result + weight }
        a = a / 2
        b = b / 2
        weight = weight * 2
    }
    out result
}

skill word_not(word) {
    out word_bytes(255 - word.b0, 255 - word.b1, 255 - word.b2, 255 - word.b3)
}

skill word_add(left, right) {
    @v0 = left.b0 + right.b0
    @c0 = v0 / 256
    @v1 = left.b1 + right.b1 + c0
    @c1 = v1 / 256
    @v2 = left.b2 + right.b2 + c1
    @c2 = v2 / 256
    @v3 = left.b3 + right.b3 + c2
    out word_bytes(mod(v0, 256), mod(v1, 256), mod(v2, 256), mod(v3, 256))
}

skill word_negate(word) {
    out word_add(word_not(word), word_bytes(1, 0, 0, 0))
}

skill word_number(value) {
    @negative = no
    @current = value
    (current < 0) { negative = yes current = 0 - current }
    @b0 = mod(current, 256)
    current = current / 256
    @b1 = mod(current, 256)
    current = current / 256
    @b2 = mod(current, 256)
    current = current / 256
    @b3 = mod(current, 256)
    @word = word_bytes(b0, b1, b2, b3)
    (negative == yes) { out word_negate(word) }
    out word
}

skill word_sub(left, right) {
    out word_add(left, word_negate(right))
}

skill word_and(left, right) {
    out word_bytes(byte_and(left.b0, right.b0), byte_and(left.b1, right.b1), byte_and(left.b2, right.b2), byte_and(left.b3, right.b3))
}

skill word_or(left, right) {
    out word_bytes(byte_or(left.b0, right.b0), byte_or(left.b1, right.b1), byte_or(left.b2, right.b2), byte_or(left.b3, right.b3))
}

skill word_xor(left, right) {
    out word_bytes(byte_xor(left.b0, right.b0), byte_xor(left.b1, right.b1), byte_xor(left.b2, right.b2), byte_xor(left.b3, right.b3))
}

skill word_shift_left_one(word) {
    @c0 = word.b0 / 128
    @c1 = word.b1 / 128
    @c2 = word.b2 / 128
    out word_bytes(mod(word.b0 * 2, 256), mod(word.b1 * 2 + c0, 256), mod(word.b2 * 2 + c1, 256), mod(word.b3 * 2 + c2, 256))
}

skill word_shift_right_one(word) {
    out word_bytes(word.b0 / 2 + mod(word.b1, 2) * 128, word.b1 / 2 + mod(word.b2, 2) * 128, word.b2 / 2 + mod(word.b3, 2) * 128, word.b3 / 2)
}

skill word_shift_right_arithmetic_one(word) {
    @high = word.b3 / 2
    (word.b3 > 127) { high = high + 128 }
    out word_bytes(word.b0 / 2 + mod(word.b1, 2) * 128, word.b1 / 2 + mod(word.b2, 2) * 128, word.b2 / 2 + mod(word.b3, 2) * 128, high)
}

skill word_shift_left(word, amount) {
    @result = word_copy(word)
    drum (amount) { result = word_shift_left_one(result) }
    out result
}

skill word_shift_right(word, amount) {
    @result = word_copy(word)
    drum (amount) { result = word_shift_right_one(result) }
    out result
}

skill word_shift_right_arithmetic(word, amount) {
    @result = word_copy(word)
    drum (amount) { result = word_shift_right_arithmetic_one(result) }
    out result
}

skill word_multiply(left, right) {
    @result = word_zero()
    @addend = word_copy(left)
    @multiplier = word_copy(right)
    drum (32) {
        (mod(multiplier.b0, 2) == 1) { result = word_add(result, addend) }
        addend = word_shift_left_one(addend)
        multiplier = word_shift_right_one(multiplier)
    }
    out result
}

skill word_equal(left, right) {
    (left.b0 == right.b0) {
        (left.b1 == right.b1) {
            (left.b2 == right.b2) {
                (left.b3 == right.b3) { out yes }
            }
        }
    }
    out no
}

skill word_unsigned_less(left, right) {
    (left.b3 < right.b3) { out yes }
    (left.b3 > right.b3) { out no }
    (left.b2 < right.b2) { out yes }
    (left.b2 > right.b2) { out no }
    (left.b1 < right.b1) { out yes }
    (left.b1 > right.b1) { out no }
    out left.b0 < right.b0
}

skill word_signed_less(left, right) {
    @left_negative = left.b3 > 127
    @right_negative = right.b3 > 127
    (left_negative == yes) {
        (right_negative == no) { out yes }
    }
    (left_negative == no) {
        (right_negative == yes) { out no }
    }
    out word_unsigned_less(left, right)
}

skill word_address(word) {
    (word.b3 > 15) { out 0 - 1 }
    out word.b0 + word.b1 * 256 + word.b2 * 65536 + word.b3 * 16777216
}

skill word_signed_number(word) {
    (word.b3 < 128) { out word_address(word) }
    @magnitude = word_address(word_negate(word))
    out 0 - magnitude
}

skill word_hex(word) {
    @text = seed.str.at(HEX, word.b3 / 16)
    text = seed.str.add(text, seed.str.at(HEX, mod(word.b3, 16)))
    text = seed.str.add(text, seed.str.at(HEX, word.b2 / 16))
    text = seed.str.add(text, seed.str.at(HEX, mod(word.b2, 16)))
    text = seed.str.add(text, seed.str.at(HEX, word.b1 / 16))
    text = seed.str.add(text, seed.str.at(HEX, mod(word.b1, 16)))
    text = seed.str.add(text, seed.str.at(HEX, word.b0 / 16))
    out seed.str.add(text, seed.str.at(HEX, mod(word.b0, 16)))
}

skill number_hex(value) {
    out word_hex(word_number(value))
}

skill memory_page(memory, page_index, create) {
    @index = 0
    @count = seed.group.count(memory.pages)
    drum (count) {
        @page = seed.group.at(memory.pages, index)
        (page.index == page_index) { out page }
        index = index + 1
    }
    (create == yes) {
        @cells = []
        @cell_index = 0
        drum (PAGE_SIZE) {
            cells = seed.group.add(cells, Byte {})
            cell_index = cell_index + 1
        }
        @page = Page { index = page_index present = yes cells = cells }
        memory.pages = seed.group.add(memory.pages, page)
        out page
    }
    out Page {}
}

skill memory_raw_load8(memory, address) {
    @page = memory_page(memory, address / PAGE_SIZE, no)
    (page.present == no) { out 0 }
    @cell = seed.group.at(page.cells, mod(address, PAGE_SIZE))
    out cell.value
}

skill memory_raw_store8(memory, address, value) {
    @page = memory_page(memory, address / PAGE_SIZE, no)
    (page.present == no) {
        (mod(value, 256) == 0) { out none }
        page = memory_page(memory, address / PAGE_SIZE, yes)
    }
    @cell = seed.group.at(page.cells, mod(address, PAGE_SIZE))
    cell.value = mod(value, 256)
    out none
}

skill memory_fill_zero(memory, address, size) {
    @end = address + size
    @page_index = 0
    @page_count = seed.group.count(memory.pages)
    drum (page_count) {
        @page = seed.group.at(memory.pages, page_index)
        @page_address = page.index * PAGE_SIZE
        @overlaps = yes
        (page_address > end - 1) { overlaps = no }
        (page_address + PAGE_SIZE < address + 1) { overlaps = no }
        (overlaps == yes) {
            @cell_index = 0
            drum (PAGE_SIZE) {
                @cell_address = page_address + cell_index
                @inside = yes
                (cell_address < address) { inside = no }
                (cell_address > end - 1) { inside = no }
                (inside == yes) {
                    @cell = seed.group.at(page.cells, cell_index)
                    cell.value = 0
                }
                cell_index = cell_index + 1
            }
        }
        page_index = page_index + 1
    }
    out none
}

skill trap(machine, reason, detail) {
    @message = seed.str.add(reason, " по адресу 0x")
    message = seed.str.add(message, number_hex(machine.pc))
    (seed.str.len(detail) > 0) {
        message = seed.str.add(message, ": ")
        message = seed.str.add(message, detail)
    }
    machine.trap = message
    machine.halted = yes
    out none
}

skill memory_check(machine, address, size, alignment, access) {
    @valid = yes
    (address < 0) { valid = no }
    (address > machine.memory.size - size) { valid = no }
    (valid == no) {
        @detail = seed.str.add("обращение к памяти 0x", number_hex(address))
        detail = seed.str.add(detail, "..0x")
        detail = seed.str.add(detail, number_hex(address + size - 1))
        detail = seed.str.add(detail, " выходит за пределы ОЗУ")
        trap(machine, seed.str.add("ошибка доступа: ", access), detail)
        out no
    }
    (mod(address, alignment) > 0) {
        @detail = seed.str.add("невыровненный доступ размером ", seed.num.text(alignment))
        detail = seed.str.add(detail, " байт по адресу 0x")
        detail = seed.str.add(detail, number_hex(address))
        trap(machine, seed.str.add("ошибка доступа: ", access), detail)
        out no
    }
    out yes
}

skill memory_load_word(memory, address) {
    out word_bytes(memory_raw_load8(memory, address), memory_raw_load8(memory, address + 1), memory_raw_load8(memory, address + 2), memory_raw_load8(memory, address + 3))
}

skill memory_store_word(memory, address, word, size) {
    memory_raw_store8(memory, address, word.b0)
    (size > 1) { memory_raw_store8(memory, address + 1, word.b1) }
    (size > 2) {
        memory_raw_store8(memory, address + 2, word.b2)
        memory_raw_store8(memory, address + 3, word.b3)
    }
    out none
}

skill register(machine, index) {
    (index == 0) { out word_zero() }
    out seed.group.at(machine.registers, index)
}

skill set_register(machine, index, word) {
    (index > 0) {
        @target = seed.group.at(machine.registers, index)
        target.b0 = word.b0
        target.b1 = word.b1
        target.b2 = word.b2
        target.b3 = word.b3
    }
    out none
}

skill ascii_code(ch) {
    (ch == "\n") { out 10 }
    (ch == "\t") { out 9 }
    @index = 0
    @length = seed.str.len(PRINTABLE)
    drum (length) {
        (seed.str.at(PRINTABLE, index) == ch) { out index + 32 }
        index = index + 1
    }
    out 0
}

skill text_bytes(text) {
    @bytes = []
    @index = 0
    @length = seed.str.len(text)
    drum (length) {
        bytes = seed.group.add(bytes, ascii_code(seed.str.at(text, index)))
        index = index + 1
    }
    out bytes
}

skill name_add(machine, text) {
    @index = 0
    @count = seed.group.count(machine.names)
    drum (count) {
        @name = seed.group.at(machine.names, index)
        (name.text == text) { out name.data }
        index = index + 1
    }
    @data = text_bytes(text)
    machine.names = seed.group.add(machine.names, Name { text = text data = data present = yes })
    out data
}

skill new_machine(options) {
    @registers = []
    @index = 0
    drum (32) {
        registers = seed.group.add(registers, word_zero())
        index = index + 1
    }
    @machine = Machine {
        memory = Memory { size = options.memory_size pages = [] }
        registers = registers
        files = options.files
    }
    name_add(machine, options.program_name)
    index = 0
    @argument_count = seed.group.count(options.arguments)
    drum (argument_count) {
        name_add(machine, seed.group.at(options.arguments, index))
        index = index + 1
    }
    index = 0
    @file_count = seed.group.count(options.files)
    drum (file_count) {
        @file = seed.group.at(options.files, index)
        name_add(machine, file.path)
        index = index + 1
    }
    out machine
}
