skill line_count(text) native
skill add(left, right) native
skill join(left, right) native
skill len(text) native
skill at(text, index) native
skill byte(text, index) native
skill slice(text, start, end) native
skill contains(text, needle) native
skill starts_with(text, prefix) native
skill ends_with(text, suffix) native
skill lower(text) native
skill upper(text) native

skill is_empty(text) {
    out seed.str.len(text) == 0
}

skill starts_at(text, needle, index) {
    @needle_length = seed.str.len(needle)
    @end = index + needle_length

    (end > seed.str.len(text)) {
        out no
    }

    out seed.str.slice(text, index, end) == needle
}

skill lines(text) {
    out split(text, "\n")
}

skill split(text, separator) {
    @separator_length = seed.str.len(separator)
    @text_length = seed.str.len(text)
    @items = []

    (separator_length == 0) {
        (is_empty(text) == no) {
            items = seed.group.add(items, text)
        }
        out items
    }

    @start = 0
    @index = 0
    drum (text_length) {
        @matched = no

        (starts_at(text, separator, index) == yes) {
            @part = seed.str.slice(text, start, index)
            (is_empty(part) == no) {
                items = seed.group.add(items, part)
            }
            index = index + separator_length
            start = index
            matched = yes
        }

        (matched == no) {
            index = index + 1
        }
    }

    @tail = seed.str.slice(text, start, text_length)
    (is_empty(tail) == no) {
        items = seed.group.add(items, tail)
    }

    out items
}
