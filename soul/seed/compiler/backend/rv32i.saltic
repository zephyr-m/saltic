use seed
use seed.machine.instruction
use seed.machine.codec
use seed.machine.layout
use seed.machine.image

Operation = Box {
    kind = instruction.Kind.UNKNOWN_INSTRUCTION
    rd = 0
    rs1 = 0
    rs2 = 0
    immediate = 0
}

skill operation(kind, rd, rs1, rs2, immediate) {
    out Operation {
        kind = kind
        rd = rd
        rs1 = rs1
        rs2 = rs2
        immediate = immediate
    }
}

skill encode(value) {
    out codec.encode_kind(value.kind, value.rd, value.rs1, value.rs2, value.immediate)
}

skill host(entry) {
    out layout.host(entry)
}

skill qemu_virt(entry) {
    out layout.qemu_virt(entry)
}

skill emit(target, value) {
    out layout.emit(target, value.kind, value.rd, value.rs1, value.rs2, value.immediate)
}

skill label(target, section, name) {
    out layout.define_label(target, section, name)
}

skill branch(target, kind, rs1, rs2, label_name) {
    out layout.emit_branch(target, kind, rs1, rs2, label_name)
}

skill jump(target, rd, label_name) {
    out layout.emit_jump(target, rd, label_name)
}

skill call(target, label_name) {
    out layout.emit_call(target, label_name)
}

skill relative_address(target, rd, label_name, addend) {
    out layout.emit_relative_address(target, rd, label_name, addend)
}

skill absolute_address(target, rd, label_name, addend) {
    out layout.emit_absolute_address(target, rd, label_name, addend)
}

skill resolve(target) {
    out layout.resolve(target)
}

skill executable(target) {
    out image.executable(target)
}

skill write(path, target) {
    out image.write(path, target)
}
