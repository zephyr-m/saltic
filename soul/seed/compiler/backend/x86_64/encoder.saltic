use seed.group
use seed.machine.codec

EAX = 0
ECX = 1
EDX = 2

ADD = 0
OR = 1
AND = 4
SUB = 5
XOR = 6
CMP = 7

SHIFT_LEFT = 4
SHIFT_RIGHT = 5
SHIFT_ARITHMETIC = 7

EQUAL = 4
NOT_EQUAL = 5
BELOW = 2
ABOVE_OR_EQUAL = 3
LESS = 12
GREATER_OR_EQUAL = 13

REGISTER_FILE_PREFIX = 65
LOAD_OPCODE = 139
STORE_OPCODE = 137
DISPLACEMENT8_R15 = 71
ADDRESS32_PREFIX = 103
OPERAND16_PREFIX = 102
GUEST_PREFIX = 65
GUEST_MODRM_EAX = 4
GUEST_MODRM_ECX = 12
GUEST_SIB = 6
TWO_BYTE_OPCODE = 15
REX = 64
REX_REGISTER = 4
REX_BASE = 1
REGISTER_COUNT = 32

HOST_OF_REGISTER = [
    -1, 8, 3, -1, -1, 7, 10, 12, 2, -1, 5, 6, 9, -1, -1, -1,
    -1, -1, -1, -1, 11, -1, -1, -1, -1, -1, -1, -1, 13, -1, -1, -1,
]

skill bytes(code, items) {
    drum (items) { code = codec.append_byte(code, beat) }
    out code
}

skill signed_word(value) {
    (value < 0) { out codec.negate_word(codec.word_from_number(0 - value)) }
    out codec.word_from_number(value)
}

skill immediate32(code, value) {
    out codec.append_word(code, signed_word(value))
}

skill host_register(index) {
    out group.item(HOST_OF_REGISTER, index)
}

skill low_bits(register) {
    (register > 7) { out register - 8 }
    out register
}

skill file_prefix(register) {
    (register > 7) { out REGISTER_FILE_PREFIX + REX_REGISTER }
    out REGISTER_FILE_PREFIX
}

skill move_register(code, target, source) {
    @prefix = REX
    (source > 7) { prefix = prefix + REX_REGISTER }
    (target > 7) { prefix = prefix + REX_BASE }
    (prefix > REX) { code = codec.append_byte(code, prefix) }
    out bytes(code, [STORE_OPCODE, 192 + low_bits(source) * 8 + low_bits(target)])
}

skill load_file_register(code, target, index) {
    out bytes(code, [file_prefix(target), LOAD_OPCODE, DISPLACEMENT8_R15 + low_bits(target) * 8, index * 4])
}

skill store_file_register(code, index, source) {
    out bytes(code, [file_prefix(source), STORE_OPCODE, DISPLACEMENT8_R15 + low_bits(source) * 8, index * 4])
}

skill load_register(code, target, index) {
    @host = host_register(index)
    (host > -1) { out move_register(code, target, host) }
    out load_file_register(code, target, index)
}

skill store_register(code, index, source) {
    @host = host_register(index)
    (host > -1) { out move_register(code, host, source) }
    out store_file_register(code, index, source)
}

skill spill_registers(code) {
    drum (REGISTER_COUNT) {
        @host = host_register(beat)
        (host > -1) { code = store_file_register(code, beat, host) }
    }
    out code
}

skill reload_registers(code) {
    drum (REGISTER_COUNT) {
        @host = host_register(beat)
        (host > -1) { code = load_file_register(code, host, beat) }
    }
    out code
}

skill move_immediate(code, target, value) {
    code = codec.append_byte(code, 184 + target)
    out immediate32(code, value)
}

skill move_word(code, target, word) {
    code = codec.append_byte(code, 184 + target)
    out codec.append_word(code, word)
}

skill operate(code, operation, target, source) {
    @opcode = operation * 8 + 1
    (operation == CMP) { opcode = 57 }
    out bytes(code, [opcode, 192 + source * 8 + target])
}

skill operate_immediate(code, operation, target, value) {
    code = bytes(code, [129, 192 + operation * 8 + target])
    out immediate32(code, value)
}

skill shift_by_count(code, operation, target) {
    out bytes(code, [211, 192 + operation * 8 + target])
}

skill shift_immediate(code, operation, target, amount) {
    out bytes(code, [193, 192 + operation * 8 + target, amount])
}

skill set_condition(code, condition) {
    out bytes(code, [TWO_BYTE_OPCODE, 144 + condition, 192, TWO_BYTE_OPCODE, 182, 192])
}

skill jump(code) {
    out bytes(code, [233, 0, 0, 0, 0])
}

skill jump_condition(code, condition) {
    out bytes(code, [TWO_BYTE_OPCODE, 128 + condition, 0, 0, 0, 0])
}

skill call(code) {
    out bytes(code, [232, 0, 0, 0, 0])
}

skill load_word_from(code, displacement) {
    code = bytes(code, [ADDRESS32_PREFIX, LOAD_OPCODE, 128])
    out codec.append_word(code, displacement)
}

skill load_memory(code, width, signed) {
    (width == 4) { out bytes(code, [GUEST_PREFIX, LOAD_OPCODE, GUEST_MODRM_EAX, GUEST_SIB]) }
    @opcode = 182
    (width == 2) { opcode = 183 }
    (signed == yes) { opcode = opcode + 8 }
    out bytes(code, [GUEST_PREFIX, TWO_BYTE_OPCODE, opcode, GUEST_MODRM_EAX, GUEST_SIB])
}

skill store_memory(code, width) {
    (width == 4) { out bytes(code, [GUEST_PREFIX, STORE_OPCODE, GUEST_MODRM_ECX, GUEST_SIB]) }
    (width == 2) { out bytes(code, [OPERAND16_PREFIX, GUEST_PREFIX, STORE_OPCODE, GUEST_MODRM_ECX, GUEST_SIB]) }
    out bytes(code, [GUEST_PREFIX, 136, GUEST_MODRM_ECX, GUEST_SIB])
}

skill jump_to_eax(code) {
    out bytes(code, [255, 224])
}

skill breakpoint(code) {
    out codec.append_byte(code, 204)
}

skill undefined(code) {
    out bytes(code, [TWO_BYTE_OPCODE, 11])
}
