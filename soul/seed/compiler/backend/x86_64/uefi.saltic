use seed.machine.codec
use seed.compiler.backend.x86_64.encoder

SYSCALL_STUB = [
    65, 139, 71, 68, 131, 248, 64, 116, 59, 131, 248, 63, 15, 132, 160, 0,
    0, 0, 131, 248, 93, 116, 23, 131, 248, 29, 116, 9, 65, 199, 71, 40,
    218, 255, 255, 255, 195, 65, 199, 71, 40, 231, 255, 255, 255, 195, 73, 139,
    167, 16, 1, 0, 0, 65, 95, 65, 94, 65, 93, 65, 92, 95, 94, 93,
    91, 49, 192, 195, 65, 139, 119, 44, 76, 1, 246, 65, 139, 95, 48, 133,
    219, 116, 86, 15, 182, 6, 72, 255, 198, 255, 203, 60, 10, 117, 23, 65,
    199, 135, 0, 2, 0, 0, 13, 0, 10, 0, 102, 65, 199, 135, 4, 2,
    0, 0, 0, 0, 235, 20, 60, 128, 114, 6, 60, 192, 114, 209, 176, 63,
    15, 182, 192, 65, 137, 135, 0, 2, 0, 0, 73, 139, 135, 0, 1, 0,
    0, 72, 139, 72, 64, 73, 141, 151, 0, 2, 0, 0, 72, 131, 236, 32,
    255, 81, 8, 72, 131, 196, 32, 235, 166, 65, 139, 71, 48, 65, 137, 71,
    40, 195, 73, 139, 135, 0, 1, 0, 0, 72, 139, 72, 48, 73, 141, 151,
    88, 2, 0, 0, 72, 131, 236, 32, 255, 81, 8, 72, 131, 196, 32, 72,
    133, 192, 116, 45, 73, 139, 135, 0, 1, 0, 0, 76, 139, 80, 96, 72,
    139, 80, 48, 72, 131, 194, 16, 185, 1, 0, 0, 0, 77, 141, 135, 96,
    2, 0, 0, 72, 131, 236, 32, 65, 255, 82, 96, 72, 131, 196, 32, 235,
    177, 65, 15, 183, 135, 90, 2, 0, 0, 133, 192, 117, 5, 184, 27, 0,
    0, 0, 61, 128, 0, 0, 0, 114, 5, 184, 63, 0, 0, 0, 65, 139,
    79, 44, 65, 136, 4, 14, 65, 199, 71, 40, 1, 0, 0, 0, 195,
]

ENTRY_SAVE = [83, 85, 86, 87, 65, 84, 65, 85, 65, 86, 65, 87]
ENTRY_SETUP = [
    73, 137, 151, 0, 1, 0, 0, 73, 137, 143, 8, 1, 0, 0, 73, 137,
    167, 16, 1, 0, 0, 72, 139, 66, 96, 49, 201, 49, 210, 69, 49, 192,
    69, 49, 201, 72, 131, 236, 40, 255, 144, 0, 1, 0, 0, 72, 131, 196,
    40,
]
LEA_R15 = [76, 141, 61]
LEA_RCX = [72, 141, 13]
LEA_RAX = [72, 141, 5]
LOAD_COUNT = [186]
RELOCATE_TABLE = [72, 1, 8, 72, 131, 192, 8, 255, 202, 117, 245]
LEA_R14 = [76, 141, 53]
SUBTRACT_R14 = [73, 129, 238]
STORE_STACK = [65, 199, 71, 8]
STORE_ARGUMENT_COUNT = [65, 199, 134]
ARGUMENT_COUNT = 1
ENTRY_JUMP = 233
DISPLACEMENT_BYTES = 4

Entry = Box {
    rva = 0,
    register_file = 0,
    table = 0,
    count = 0,
    guest = 0,
    load_address = 0,
    stack_top = 0
}

skill append_syscall_stub(code) {
    out encoder.bytes(code, SYSCALL_STUB)
}

skill relative(code, start, entry, target) {
    @next = entry.rva + code.length - start + DISPLACEMENT_BYTES
    out encoder.immediate32(code, target - next)
}

skill append_entry_stub(code, entry) {
    @start = code.length
    code = encoder.bytes(code, ENTRY_SAVE)
    code = encoder.bytes(code, LEA_R15)
    code = relative(code, start, entry, entry.register_file)
    code = encoder.bytes(code, ENTRY_SETUP)
    code = encoder.bytes(code, LEA_RCX)
    code = relative(code, start, entry, 0)
    code = encoder.bytes(code, LEA_RAX)
    code = relative(code, start, entry, entry.table)
    code = encoder.bytes(code, LOAD_COUNT)
    code = encoder.immediate32(code, entry.count)
    code = encoder.bytes(code, RELOCATE_TABLE)
    code = encoder.bytes(code, LEA_R14)
    code = relative(code, start, entry, entry.guest)
    code = encoder.bytes(code, SUBTRACT_R14)
    code = encoder.immediate32(code, entry.load_address)
    code = encoder.bytes(code, STORE_ARGUMENT_COUNT)
    code = encoder.immediate32(code, entry.stack_top)
    code = encoder.immediate32(code, ARGUMENT_COUNT)
    code = encoder.bytes(code, STORE_STACK)
    code = encoder.immediate32(code, entry.stack_top)
    code = encoder.reload_registers(code)
    code = codec.append_byte(code, ENTRY_JUMP)
    out codec.append_word(code, codec.word(0, 0, 0, 0))
}

skill entry_bytes() {
    @sample = append_entry_stub(codec.buffer(), Entry {})
    out sample.length
}
