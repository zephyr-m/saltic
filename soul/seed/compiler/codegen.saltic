use seed.str
use seed.group
use seed.num
use seed.abi
use seed.ast
use seed.intrinsic.contract
use seed.compiler.state
use seed.compiler.constants
use seed.machine.instruction
use seed.machine.codec
use seed.machine.layout

skill box_field_symbol(compiler, box_name, field_name) {
    @box = state.symbol_find(compiler.boxes, box_name)
    @count = group.count(ast.plain(box.node))
    drum (count - 2) {
        @member = ast.part(box.node, count - 1 - beat)
        (ast.tag(member) == "field") {
            (ast.part(member, 1) == field_name) { out state.Symbol { name = field_name kind = "field" node = member } }
        }
    }
    out state.Symbol {}
}

skill error_id(compiler, name) {
    (name == "FixedIntegerOverflow") { out abi.ERROR_FIXED_INTEGER_OVERFLOW }
    (name == "MemoryExhausted") { out abi.ERROR_MEMORY_EXHAUSTED }
    @error_item = state.symbol_find(compiler.errors, name)
    (str.len(error_item.name) == 0) {
        @id = abi.user_error_id(group.count(compiler.errors))
        compiler.errors = state.symbol_add(compiler.errors, name, "error", [], id)
        error_item = state.symbol_find(compiler.errors, name)
    }
    out error_item.value
}

skill negative_literal(node) {
    @plain = ast.plain(node)
    (group.item(plain, 0) == "binary") {
        (group.item(plain, 1) == "-") {
            @left = ast.plain(group.item(plain, 2))
            @right = ast.plain(group.item(plain, 3))
            (group.item(left, 0) == "number") {
                (group.item(left, 1) == 0) { out group.item(right, 0) == "number" }
            }
        }
    }
    out no
}

skill constant_literal(node) {
    @tag = ast.tag(node)
    (tag == "number") { out yes }
    (negative_literal(node) == yes) { out yes }
    (tag == "answer") { out yes }
    (tag == "none") { out yes }
    out no
}

skill emit_field_get(compiler, name) {
    @field = state.symbol_find(compiler.fields, name)
    compiler = state.load_immediate(compiler, "a1", codec.A1, field.value)
    compiler = state.load_immediate(compiler, "a2", codec.A2, field.slot)
    compiler.machine = layout.emit_call(compiler.machine, "rt_box_get")
    out compiler
}

skill emit_field_set(compiler, name) {
    @field = state.symbol_find(compiler.fields, name)
    compiler = state.load_immediate(compiler, "a1", codec.A1, field.value)
    compiler = state.load_immediate(compiler, "a3", codec.A3, field.slot)
    compiler.machine = layout.emit_call(compiler.machine, "rt_box_set")
    out compiler
}

skill compile_path(compiler, node) {
    @parts = ast.plain(node)
    @count = group.count(parts)
    @name = group.item(parts, 1)
    @path_name = ast.path_text(parts)
    @constant_name = ""
    @constant = state.Symbol {}
    (name == "error") {
        (count == 3) {
            compiler = state.load_immediate(compiler, "a0", codec.A0, 0)
            out state.load_immediate(compiler, "a1", codec.A1, error_id(compiler, group.item(parts, 2)))
        }
    }
    (count > 2) {
        @enum_name = resolve_symbol(compiler.enums, compiler.aliases, ast.path_prefix(parts), compiler.current_function.module)
        (str.len(enum_name) > 0) {
            @full_name = "{enum_name}."
            full_name = str.add(full_name, group.item(parts, count - 1))
            @variant = state.symbol_find(compiler.variants, full_name)
            out state.load_immediate(compiler, "a0", codec.A0, variant.value)
        }
    }
    (state.symbol_has(compiler.current_function.slots, name) == yes) {
        @slot = state.slot(compiler, name)
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A0, codec.S0, codec.ZERO, slot)
    }
    (state.symbol_has(compiler.current_function.slots, name) == no) {
        constant_name = resolve_symbol(compiler.constants, compiler.aliases, path_name, compiler.current_function.module)
        constant = state.symbol_find(compiler.constants, constant_name)
        (str.len(constant.name) > 0) {
            (constant_literal(constant.node) == yes) {
                compiler = compile_expression(compiler, constant.node)
                compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.ZERO, codec.ZERO, abi.CALL_NO_ERROR)
            }
            (constant_literal(constant.node) == no) {
                @getter = constants.getter_label(constant.name)
                compiler.machine = layout.emit_call(compiler.machine, getter)
            }
        }
        (str.len(constant.name) == 0) {
            @subject_field = box_field_symbol(compiler, compiler.current_function.subject, name)
            (str.len(subject_field.name) > 0) {
                @self_slot = state.slot(compiler, "$self")
                compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A0, codec.S0, codec.ZERO, self_slot)
                compiler = emit_field_get(compiler, name)
            }
        }
    }
    (str.len(constant.name) > 0) { out compiler }
    drum (count - 2) {
        compiler = emit_field_get(compiler, group.item(parts, beat + 2))
    }
    out compiler
}

skill compile_binary(compiler, operator, left, right) {
    compiler = compile_expression(compiler, left)
    compiler = state.push(compiler, "a0", codec.A0)
    compiler = compile_expression(compiler, right)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.A0, codec.ZERO, 0)
    compiler = state.pop(compiler, "a0", codec.A0)
    @target = ""
    @fixed_type = infer_type(compiler, left)
    @fixed = contract.is_fixed_type(fixed_type)
    (operator == "+") { target = "rt_add" }
    (operator == "-") { target = "rt_sub" }
    (operator == "*") { target = "rt_mul" }
    (operator == "/") { target = "rt_div" }
    (operator == "==") { target = "rt_equal" }
    (operator == ">") { target = "rt_greater" }
    (operator == "<") { target = "rt_less" }
    (fixed == yes) {
        (operator == "+") { target = "rt_fixed_add" }
        (operator == "-") { target = "rt_fixed_sub" }
        (operator == "*") { target = "rt_fixed_mul" }
        (operator == "/") { target = "rt_fixed_div" }
        (operator == "==") { target = "rt_fixed_equal" }
        (operator == ">") { target = "rt_fixed_greater" }
        (operator == "<") { target = "rt_fixed_less" }
        compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(fixed_type))
    }
    (fixed == no) {
        (operator == "+") { out emit_word_result(state.emit_op(compiler, instruction.Kind.ADD, codec.A0, codec.A0, codec.A1, 0)) }
        (operator == "-") { out emit_word_result(state.emit_op(compiler, instruction.Kind.SUB, codec.A0, codec.A0, codec.A1, 0)) }
        (operator == "<") { out emit_number_less(compiler, codec.A0, codec.A1) }
        (operator == ">") { out emit_number_less(compiler, codec.A1, codec.A0) }
        (operator == "==") {
            (immediate_operand(compiler, left) == yes) { out emit_word_equal(compiler) }
            (immediate_operand(compiler, right) == yes) { out emit_word_equal(compiler) }
            out emit_equal_fast_path(compiler)
        }
    }
    compiler.machine = layout.emit_call(compiler.machine, target)
    out compiler
}

skill emit_word_result(compiler) {
    out state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.ZERO, codec.ZERO, abi.CALL_NO_ERROR)
}

skill emit_answer_from_bit(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, codec.A0, codec.A0, codec.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.A0, codec.ZERO, abi.NO)
    out emit_word_result(compiler)
}

skill emit_number_less(compiler, smaller, larger) {
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, codec.A0, codec.A0, codec.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, codec.A1, codec.A1, codec.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SLT, codec.A0, smaller, larger, 0)
    out emit_answer_from_bit(compiler)
}

skill emit_word_equal(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.SUB, codec.A0, codec.A0, codec.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, codec.A0, codec.A0, codec.ZERO, 1)
    out emit_answer_from_bit(compiler)
}

skill emit_equal_fast_path(compiler) {
    @slow = state.label(compiler, "equal_slow")
    @done = state.label(compiler, "equal_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.A0, codec.A1, slow)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, abi.YES)
    compiler = emit_word_result(compiler)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, done)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, slow)
    compiler.machine = layout.emit_call(compiler.machine, "rt_equal")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, done)
    out compiler
}

skill immediate_operand(compiler, node) {
    @tag = ast.tag(node)
    (constant_literal(node) == yes) { out yes }
    (tag == "enum-value") { out yes }
    (tag == "path") {
        @parts = ast.plain(node)
        @count = group.count(parts)
        (count > 2) {
            (str.len(resolve_symbol(compiler.enums, compiler.aliases, ast.path_prefix(parts), compiler.current_function.module)) > 0) { out yes }
        }
        (state.symbol_has(compiler.current_function.slots, group.item(parts, 1)) == no) {
            @constant_name = resolve_symbol(compiler.constants, compiler.aliases, ast.path_text(parts), compiler.current_function.module)
            @constant = state.symbol_find(compiler.constants, constant_name)
            (str.len(constant.name) > 0) { out constant_literal(constant.node) }
        }
    }
    out no
}

skill compile_rescue(compiler, node) {
    @plain = ast.plain(node)
    @done = state.label(compiler, "rescue_done")
    compiler = compile_expression(compiler, group.item(plain, 1))
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.A1, codec.ZERO, 8)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, done)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, codec.A0, codec.A1, codec.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, codec.A0, codec.A0, codec.ZERO, abi.TAG_ERROR)
    @slot = state.slot(compiler, group.item(plain, 2))
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.A0, slot)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.ZERO, codec.ZERO, abi.CALL_NO_ERROR)
    compiler = compile_block(compiler, group.item(plain, 3), yes)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, done)
    out compiler
}

skill box_has_skill(compiler, box_name, skill_name) {
    @box = state.symbol_find(compiler.boxes, box_name)
    drum (group.count(ast.plain(box.node)) - 2) {
        @member = ast.part(box.node, beat + 2)
        (ast.tag(member) == "subject-skill") {
            (ast.part(member, 1) == skill_name) { out yes }
        }
    }
    out no
}

skill infer_type(compiler, node) {
    @plain = ast.plain(node)
    @tag = group.item(plain, 0)
    (tag == "box-new") {
        @box_name = resolve_symbol(compiler.boxes, compiler.aliases, group.item(plain, 1), compiler.current_function.module)
        out "box:{box_name}"
    }
    (tag == "template") { out "string" }
    (tag == "path") {
        @name = group.item(plain, 1)
        @type_item = state.type_find(compiler.current_function.types, name)
        @type = type_item.text
        (group.count(plain) == 2) { out type }
        (str.starts_with(type, "box:") == yes) {
            @field = box_field_symbol(compiler, str.slice(type, 4, str.len(type)), group.item(plain, 2))
            (str.len(field.name) > 0) {
                @value = ast.part(field.node, 2)
                (ast.tag(value) == "box-new") { out str.add("box:", ast.part(value, 1)) }
            }
        }
        out "unknown"
    }
    (tag == "call") {
        @callee = ast.plain(group.item(plain, 1))
        (ast.tag(callee) == "path") {
            @full = call_name(compiler, callee)
            (contract.is_fixed_type(full) == yes) { out full }
            @input_type = "unknown"
            (group.count(plain) > 2) { input_type = infer_type(compiler, group.item(plain, 2)) }
            @result_type = contract.result(contract.find(full), input_type)
            ((result_type == "unknown") == no) {
                (result_type == "group-item") { out "unknown" }
                (result_type == "group-add") { out "unknown" }
                out result_type
            }
            @box_name = resolve_symbol(compiler.boxes, compiler.aliases, full, compiler.current_function.module)
            (str.len(box_name) > 0) { out "box:{box_name}" }
        }
        out "unknown"
    }
    (tag == "binary") {
        @operator = group.item(plain, 1)
        (operator == "==") { out "answer" }
        (operator == ">") { out "answer" }
        (operator == "<") { out "answer" }
        out infer_type(compiler, group.item(plain, 2))
    }
    (tag == "rescue") { out infer_type(compiler, group.item(plain, 1)) }
    out "unknown"
}

skill resolve_symbol(symbols, aliases, name, module) {
    (state.symbol_has(symbols, name) == yes) { out name }
    @local = ast.qualified(module, name)
    (state.symbol_has(symbols, local) == yes) { out local }
    @head = ast.name_head(name)
    @import = state.symbol_find(aliases, ast.alias_key(module, head))
    (import.kind == "import") {
        @candidate = str.add(import.text, ast.name_tail(name))
        (state.symbol_has(symbols, candidate) == yes) { out candidate }
    }
    out ""
}

skill call_name(compiler, callee) {
    @name = ast.path_text(callee)
    @resolved = resolve_symbol(compiler.natives, compiler.aliases, name, compiler.current_function.module)
    (str.len(resolved) > 0) { out resolved }
    out name
}

skill resolve_skill(compiler, path) {
    out resolve_symbol(compiler.skills, compiler.aliases, ast.path_text(path), compiler.current_function.module)
}

skill call_arguments(node) {
    @plain = ast.plain(node)
    out state.group_slice(plain, 2, group.count(plain))
}

skill compile_arguments(compiler, args) {
    @count = group.count(args)
    drum (args) {
        compiler = compile_expression(compiler, beat)
        compiler = state.push(compiler, "a0", codec.A0)
    }
    drum (count) {
        compiler = state.emit_op(compiler, instruction.Kind.LW, abi.argument_register(beat), codec.SP, codec.ZERO, constants.stack_source_offset(count, beat))
    }
    (count > 0) {
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, constants.stack_bytes(count))
    }
    out compiler
}

skill compile_show(compiler, args) {
    drum (args) {
        compiler = compile_expression(compiler, beat)
        @type = infer_type(compiler, beat)
        pick {
            (contract.is_fixed_type(type) == yes) {
                compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(type))
                compiler.machine = layout.emit_call(compiler.machine, "rt_fixed_show")
            }
            { compiler.machine = layout.emit_call(compiler.machine, "rt_show") }
        }
    }
    compiler.machine = layout.emit_call(compiler.machine, "rt_newline")
    out state.load_immediate(compiler, "a0", codec.A0, abi.NONE)
}

skill intrinsic(name) {
    out contract.target(contract.find(name), "unknown")
}

skill ascii_code(ch) {
    (ch == "\n") { out 10 }
    (ch == "\t") { out 9 }
    @length = str.len(state.PRINTABLE)
    drum (length) {
        @index = length - 1 - beat
        (str.at(state.PRINTABLE, index) == ch) { out index + 32 }
    }
    out 0
}

skill string_find(compiler, text) {
    @count = group.count(compiler.strings)
    drum (count) {
        @item = group.item(compiler.strings, count - 1 - beat)
        (item.text == text) { out item }
    }
    out state.Symbol {}
}

skill emit_string_data(compiler, text) {
    @line = "  .byte "
    @line_bytes = 0
    @length = str.len(text)
    @total = length + 1
    drum (total) {
        @value = 0
        (beat < length) { value = str.byte(text, beat) }
        (line_bytes > 0) { line = "{line}, " }
        line = str.add(line, num.text(value))
        line_bytes = line_bytes + 1

        @flush = line_bytes == constants.STRING_DATA_LINE_BYTES
        (beat + 1 == total) { flush = yes }
        (flush == yes) {
            compiler = state.emit_data(compiler, line)
            line = "  .byte "
            line_bytes = 0
        }
    }
    out compiler
}

skill string_label(compiler, text) {
    @known = string_find(compiler, text)
    (str.len(known.name) > 0) { out known.name }
    @label = state.label(compiler, "string")
    @length = str.len(text)
    @payload_bytes = constants.string_storage_bytes(length)
    compiler = state.emit_data(compiler, "{label}:")
    compiler = state.emit_data(compiler, "  .word {abi.OBJECT_KIND_STRING}")
    compiler = state.emit_data(compiler, "  .word {payload_bytes}")
    compiler = state.emit_data(compiler, "  .word {abi.OBJECT_FLAG_STATIC}")
    compiler = state.emit_data(compiler, "  .word {length}")
    compiler = emit_string_data(compiler, text)
    compiler = state.emit_data(compiler, "  .balign {constants.DATA_ALIGNMENT}")
    compiler.machine = layout.align_section(compiler.machine, layout.Section.RODATA, constants.DATA_ALIGNMENT)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.RODATA, label)
    compiler.machine = layout.append_section_word(compiler.machine, layout.Section.RODATA, layout.address_from_number(abi.OBJECT_KIND_STRING))
    compiler.machine = layout.append_section_word(compiler.machine, layout.Section.RODATA, layout.address_from_number(payload_bytes))
    compiler.machine = layout.append_section_word(compiler.machine, layout.Section.RODATA, layout.address_from_number(abi.OBJECT_FLAG_STATIC))
    compiler.machine = layout.append_section_word(compiler.machine, layout.Section.RODATA, layout.address_from_number(length))
    compiler.machine = layout.append_section_text(compiler.machine, layout.Section.RODATA, text, yes)
    compiler.machine = layout.align_section(compiler.machine, layout.Section.RODATA, constants.DATA_ALIGNMENT)
    compiler.strings = group.add(compiler.strings, state.Symbol { name = label kind = "string" text = text })
    out label
}

skill compile_group(compiler, items) {
    @count = group.count(items)
    drum (items) {
        compiler = compile_expression(compiler, beat)
        compiler = state.push(compiler, "a0", codec.A0)
    }
    compiler = state.load_immediate(compiler, "a0", codec.A0, constants.group_storage_bytes(count))
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T3, codec.ZERO, codec.ZERO, abi.OBJECT_KIND_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T3, codec.ZERO, codec.ZERO, count)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.T3, abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_COUNT_OFFSET)
    drum (count) {
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.SP, codec.ZERO, constants.stack_source_offset(count, beat))
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.group_item_offset(beat))
    }
    (count > 0) {
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, constants.stack_bytes(count))
    }
    out state.emit_op(compiler, instruction.Kind.ORI, codec.A0, codec.A0, codec.ZERO, abi.TAG_GROUP)
}

skill box_override(overrides, field_name) {
    @count = group.count(overrides)
    drum (count) {
        @field = ast.plain(group.item(overrides, count - 1 - beat))
        (group.item(field, 1) == field_name) { out group.item(field, 2) }
    }
    out []
}

skill compile_box(compiler, name, overrides) {
    @model = state.symbol_find(compiler.boxes, name)
    @fields = []
    @member_count = group.count(ast.plain(model.node))
    drum (member_count - 2) {
        @member = ast.part(model.node, beat + 2)
        (ast.tag(member) == "field") { fields = group.add(fields, member) }
    }
    @count = group.count(fields)
    drum (fields) {
        @value = box_override(overrides, ast.part(beat, 1))
        @default_value = no
        (group.count(value) == 0) { value = ast.part(beat, 2) default_value = yes }
        @caller_module = compiler.current_function.module
        (default_value == yes) { compiler.current_function.module = model.text }
        compiler = compile_expression(compiler, value)
        compiler.current_function.module = caller_module
        compiler = state.push(compiler, "a0", codec.A0)
    }
    compiler = state.load_immediate(compiler, "a0", codec.A0, constants.box_storage_bytes(count))
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T3, codec.ZERO, codec.ZERO, abi.OBJECT_KIND_BOX)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T3, codec.ZERO, codec.ZERO, count)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.T3, abi.OBJECT_PAYLOAD_OFFSET + constants.BOX_COUNT_OFFSET)
    drum (count) {
        @field_id = state.field(compiler, ast.part(group.item(fields, beat), 1))
        compiler = state.load_immediate(compiler, "t0", codec.T0, field_id)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.box_field_id_offset(beat))
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.SP, codec.ZERO, constants.stack_source_offset(count, beat))
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.A0, codec.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.box_field_value_offset(beat))
    }
    (count > 0) {
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, constants.stack_bytes(count))
    }
    out state.emit_op(compiler, instruction.Kind.ORI, codec.A0, codec.A0, codec.ZERO, abi.TAG_BOX)
}

skill compile_call(compiler, node) {
    @plain = ast.plain(node)
    @callee = ast.plain(group.item(plain, 1))
    @args = call_arguments(node)
    @name = call_name(compiler, callee)
    @seed_kind = contract.find(name)
    (contract.is_show(seed_kind) == yes) { out compile_show(compiler, args) }
    (contract.is_fixed_type(name) == yes) {
        @value = ast.plain(group.item(args, 0))
        @value_tag = group.item(value, 0)
        (value_tag == "wide-number") {
            @wide = group.item(value, 1)
            compiler.machine = layout.emit_load_word(compiler.machine, codec.A0, codec.word_from_decimal(wide))
        }
        (value_tag == "number") { compiler = state.load_immediate(compiler, "a0", codec.A0, group.item(value, 1)) }
        (value_tag == "binary") {
            (group.item(value, 1) == "-") {
                @left = ast.plain(group.item(value, 2))
                @right = ast.plain(group.item(value, 3))
                (group.item(left, 0) == "number") {
                    (group.item(left, 1) == 0) {
                        @right_tag = group.item(right, 0)
                        (right_tag == "number") { compiler = state.load_immediate(compiler, "a0", codec.A0, 0 - group.item(right, 1)) value_tag = "ready" }
                        (right_tag == "wide-number") {
                            @wide = str.add("-", group.item(right, 1))
                            compiler.machine = layout.emit_load_word(compiler.machine, codec.A0, codec.word_from_decimal(wide))
                            value_tag = "ready"
                        }
                    }
                }
            }
        }
        (value_tag == "wide-number") { value_tag = "ready" }
        (value_tag == "number") { value_tag = "ready" }
        (value_tag == "ready") { compiler = compiler }
        (value_tag == "ready") { value_tag = "done" }
        (value_tag == "done") { compiler = compiler }
        ((value_tag == "done") == no) {
            compiler = compile_expression(compiler, group.item(args, 0))
            @source_type = infer_type(compiler, group.item(args, 0))
            (contract.is_fixed_type(source_type) == no) {
                compiler = state.emit_op(compiler, instruction.Kind.SRAI, codec.A0, codec.A0, codec.ZERO, abi.TAG_SHIFT)
            }
        }
        compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(name))
        compiler.machine = layout.emit_call(compiler.machine, "rt_fixed_new")
        out compiler
    }
    @conversion = contract.conversion(seed_kind)
    (str.len(conversion) > 0) {
        compiler = compile_arguments(compiler, args)
        @source_type = infer_type(compiler, group.item(args, 0))
        compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(source_type))
        compiler = state.load_immediate(compiler, "a7", abi.CALL_FIXED_TARGET_KIND_REGISTER, contract.fixed_kind(conversion))
        compiler.machine = layout.emit_call(compiler.machine, "rt_fixed_convert")
        out compiler
    }
    @fixed_target = ""
    (contract.is_fixed_call(seed_kind) == yes) { fixed_target = contract.target(seed_kind, "unknown") }
    (str.len(fixed_target) > 0) {
        compiler = compile_arguments(compiler, args)
        @fixed_type = infer_type(compiler, group.item(args, 0))
        compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(fixed_type))
        compiler.machine = layout.emit_call(compiler.machine, fixed_target)
        out compiler
    }
    @memory_target = ""
    (group.count(args) > 0) {
        @input_type = infer_type(compiler, group.item(args, 0))
        (contract.is_memory(seed_kind) == yes) { memory_target = contract.target(seed_kind, input_type) }
    }
    (str.len(memory_target) > 0) {
        compiler = compile_arguments(compiler, args)
        compiler.machine = layout.emit_call(compiler.machine, memory_target)
        out compiler
    }
    @resolved_box = resolve_symbol(compiler.boxes, compiler.aliases, name, compiler.current_function.module)
    (str.len(resolved_box) > 0) { out compile_box(compiler, resolved_box, []) }
    (group.count(callee) == 2) {
        @short_name = group.item(callee, 1)
        (str.len(compiler.current_function.subject) > 0) {
            (box_has_skill(compiler, compiler.current_function.subject, short_name) == yes) {
                @with_self = state.group_prepend(["path", "$self"], args)
                compiler = compile_arguments(compiler, with_self)
                @target = "{compiler.current_function.subject}."
                target = str.add(target, short_name)
                @method_target = str.add("saltic_", state.safe(target))
                compiler.machine = layout.emit_call(compiler.machine, method_target)
                out compiler
            }
        }
    }
    (group.count(callee) == 3) {
        @receiver = ["path", group.item(callee, 1)]
        @receiver_type = infer_type(compiler, receiver)
        (str.starts_with(receiver_type, "box:") == yes) {
            @box_name = str.slice(receiver_type, 4, str.len(receiver_type))
            @method = group.item(callee, 2)
            (box_has_skill(compiler, box_name, method) == yes) {
                @with_receiver = state.group_prepend(receiver, args)
                compiler = compile_arguments(compiler, with_receiver)
                @target = "{box_name}."
                target = str.add(target, method)
                @method_target = str.add("saltic_", state.safe(target))
                compiler.machine = layout.emit_call(compiler.machine, method_target)
                out compiler
            }
        }
    }
    @target = intrinsic(name)
    (str.len(target) == 0) {
        @resolved_skill = resolve_skill(compiler, callee)
        (str.len(resolved_skill) > 0) { target = str.add("saltic_", state.safe(resolved_skill)) }
    }
    compiler = compile_arguments(compiler, args)
    compiler.machine = layout.emit_call(compiler.machine, target)
    out compiler
}

skill emit_string_join(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.A0, codec.ZERO, 0)
    compiler = state.pop(compiler, "a0", codec.A0)
    compiler.machine = layout.emit_call(compiler.machine, "rt_string_add")
    out state.push(compiler, "a0", codec.A0)
}

skill compile_template(compiler, plain) {
    compiler = compile_expression(compiler, ["string", group.item(plain, 1)])
    compiler = state.push(compiler, "a0", codec.A0)
    drum ((group.count(plain) - 2) / 2) {
        compiler = compile_expression(compiler, group.item(plain, beat * 2 + 2))
        compiler.machine = layout.emit_call(compiler.machine, "rt_value_text")
        compiler = emit_string_join(compiler)
        @text = group.item(plain, beat * 2 + 3)
        (str.len(text) > 0) {
            compiler = compile_expression(compiler, ["string", text])
            compiler = emit_string_join(compiler)
        }
    }
    out state.pop(compiler, "a0", codec.A0)
}

skill compile_expression(compiler, node) {
    @plain = ast.plain(node)
    @tag = group.item(plain, 0)
    (tag == "number") { out state.load_immediate(compiler, "a0", codec.A0, abi.tagged(group.item(plain, 1), abi.TAG_NUMBER)) }
    (tag == "template") { out compile_template(compiler, plain) }
    (tag == "string") {
        @label = string_label(compiler, group.item(plain, 1))
        compiler.machine = layout.emit_relative_address(compiler.machine, codec.A0, label, 0)
        out state.emit_op(compiler, instruction.Kind.ORI, codec.A0, codec.A0, codec.ZERO, abi.TAG_STRING)
    }
    (tag == "answer") {
        (group.item(plain, 1) == "yes") { out state.load_immediate(compiler, "a0", codec.A0, abi.YES) }
        out state.load_immediate(compiler, "a0", codec.A0, abi.NO)
    }
    (tag == "none") { out state.load_immediate(compiler, "a0", codec.A0, abi.NONE) }
    (tag == "path") { out compile_path(compiler, node) }
    (tag == "binary") {
        (negative_literal(node) == yes) {
            @magnitude = ast.plain(group.item(plain, 3))
            out state.load_immediate(compiler, "a0", codec.A0, abi.tagged(0 - group.item(magnitude, 1), abi.TAG_NUMBER))
        }
        out compile_binary(compiler, group.item(plain, 1), group.item(plain, 2), group.item(plain, 3))
    }
    (tag == "call") { out compile_call(compiler, node) }
    (tag == "group") { out compile_group(compiler, state.group_slice(plain, 1, group.count(plain))) }
    (tag == "box-new") {
        @box_name = resolve_symbol(compiler.boxes, compiler.aliases, group.item(plain, 1), compiler.current_function.module)
        out compile_box(compiler, box_name, state.group_slice(plain, 2, group.count(plain)))
    }
    (tag == "rescue") { out compile_rescue(compiler, node) }
    (tag == "enum-value") {
        @variant = state.symbol_find(compiler.variants, group.item(plain, 1))
        out state.load_immediate(compiler, "a0", codec.A0, variant.value)
    }
    out compiler
}

skill compile_block(compiler, block, keep) {
    @plain = ast.plain(block)
    @count = group.count(plain)
    drum (count - 1) {
        @last = no
        (keep == yes) {
            (beat + 2 == count) { last = yes }
        }
        compiler = compile_statement(compiler, group.item(plain, beat + 1), last)
    }
    (keep == yes) {
        (count == 1) { compiler = state.load_immediate(compiler, "a0", codec.A0, abi.NONE) }
    }
    out compiler
}

skill compile_statement(compiler, node, keep) {
    @plain = ast.plain(node)
    @tag = group.item(plain, 0)
    (tag == "var") {
        @value = group.item(plain, 2)
        compiler = compile_expression(compiler, value)
        @slot = state.slot(compiler, group.item(plain, 1))
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.A0, slot)
        @type = infer_type(compiler, value)
        @known = state.type_find(compiler.current_function.types, group.item(plain, 1))
        (type == "unknown") {
            (str.len(known.name) == 0) { compiler.current_function.types = state.type_set(compiler.current_function.types, group.item(plain, 1), type) }
        }
        (type == "unknown") { out compiler }
        compiler.current_function.types = state.type_set(compiler.current_function.types, group.item(plain, 1), type)
        out compiler
    }
    (tag == "assign") {
        @value = group.item(plain, 2)
        compiler = compile_expression(compiler, value)
        @slot = state.slot(compiler, group.item(plain, 1))
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.A0, slot)
        @type = infer_type(compiler, value)
        @known = state.type_find(compiler.current_function.types, group.item(plain, 1))
        (type == "unknown") {
            (str.len(known.name) == 0) { compiler.current_function.types = state.type_set(compiler.current_function.types, group.item(plain, 1), type) }
        }
        (type == "unknown") { out compiler }
        compiler.current_function.types = state.type_set(compiler.current_function.types, group.item(plain, 1), type)
        out compiler
    }
    (tag == "field-assign") {
        @target = ast.plain(group.item(plain, 1))
        @part_count = group.count(target)
        @base = state.group_slice(target, 0, part_count - 1)
        compiler = compile_expression(compiler, base)
        compiler = state.push(compiler, "a0", codec.A0)
        compiler = compile_expression(compiler, group.item(plain, 2))
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A2, codec.A0, codec.ZERO, 0)
        compiler = state.pop(compiler, "a0", codec.A0)
        out emit_field_set(compiler, group.item(target, part_count - 1))
    }
    (tag == "out") {
        compiler = compile_expression(compiler, group.item(plain, 1))
        @value_root = constants.REGION_VALUE_ROOT
        (abi.is_raw_value(infer_type(compiler, group.item(plain, 1))) == yes) { value_root = constants.REGION_VALUE_SKIPPED }
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A2, codec.ZERO, codec.ZERO, value_root)
        compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, compiler.current_function.end)
        out compiler
    }
    (tag == "expr") { out compile_expression(compiler, group.item(plain, 1)) }
    (tag == "pick") {
        @end = state.label(compiler, "pick_end")
        drum (group.count(plain) - 1) {
            @choice = ast.plain(group.item(plain, beat + 1))
            (group.item(choice, 0) == "if") {
                @next = state.label(compiler, "pick_next")
                compiler = compile_expression(compiler, group.item(choice, 1))
                compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.ZERO, codec.ZERO, abi.NO)
                compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.A0, codec.T0, 8)
                compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, next)
                compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.ZERO, codec.ZERO, abi.NONE)
                compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.A0, codec.T0, 8)
                compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, next)
                compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.A0, codec.ZERO, 8)
                compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, next)
                compiler = compile_block(compiler, group.item(choice, 2), keep)
                compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, end)
                compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, next)
            }
            (group.item(choice, 0) == "otherwise") {
                compiler = compile_block(compiler, group.item(choice, 1), keep)
            }
        }
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, end)
        out compiler
    }
    (tag == "leave") {
        compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, compiler.current_function.drum_exit)
        out compiler
    }
    (tag == "if") {
        @end = state.label(compiler, "if_end")
        compiler = compile_expression(compiler, group.item(plain, 1))
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.ZERO, codec.ZERO, abi.NO)
        compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.A0, codec.T0, 8)
        compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, end)
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.ZERO, codec.ZERO, abi.NONE)
        compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.A0, codec.T0, 8)
        compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, end)
        compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.A0, codec.ZERO, 8)
        compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, end)
        compiler = compile_block(compiler, group.item(plain, 2), keep)
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, end)
        out compiler
    }
    (tag == "switch") {
        @end = state.label(compiler, "switch_end")
        compiler = compile_expression(compiler, group.item(plain, 1))
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T2, codec.A0, codec.ZERO, 0)
        drum (group.count(plain) - 2) {
            @case_node = ast.plain(group.item(plain, beat + 2))
            @next = state.label(compiler, "case_next")
            @variant = state.symbol_find(compiler.variants, group.item(case_node, 1))
            compiler = state.load_immediate(compiler, "t0", codec.T0, variant.value)
            compiler.machine = layout.emit(compiler.machine, instruction.Kind.BEQ, codec.ZERO, codec.T2, codec.T0, 8)
            compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, next)
            compiler = compile_expression(compiler, group.item(case_node, 2))
            compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, end)
            compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, next)
        }
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, end)
        out compiler
    }
    (tag == "drum") {
        @drum_number = num.text(compiler.current_function.next_drum)
        compiler.current_function.next_drum = compiler.current_function.next_drum + 1
        @counter = state.slot(compiler, "$drum:{drum_number}")
        @source = state.slot(compiler, "$drum_source:{drum_number}")
        @position = state.slot(compiler, "$drum_index:{drum_number}")
        @saved = state.slot(compiler, "$drum_saved:{drum_number}")
        @beat_slot = state.slot(compiler, state.DRUM_BEAT)
        @start = state.label(compiler, "drum")
        @end = state.label(compiler, "drum_end")
        @numeric = state.label(compiler, "drum_numeric")
        @counted = state.label(compiler, "drum_counted")
        @beat_number = state.label(compiler, "drum_beat_number")
        @beat_ready = state.label(compiler, "drum_beat_ready")
        @uses_beat = state.block_uses_beat(group.item(plain, 2))
        compiler = compile_expression(compiler, group.item(plain, 1))
        (uses_beat == no) {
            compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T1, codec.A0, codec.ZERO, abi.TAG_MASK)
            compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T2, codec.ZERO, codec.ZERO, abi.TAG_GROUP)
            compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T1, codec.T2, numeric)
            compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T1, codec.A0, codec.ZERO, abi.PAYLOAD_MASK)
            compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A0, codec.T1, codec.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
            compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, counted)
            compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, numeric)
            compiler = state.emit_op(compiler, instruction.Kind.SRAI, codec.A0, codec.A0, codec.ZERO, abi.TAG_SHIFT)
            compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, counted)
            compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.A0, counter)
            compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, start)
            compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.S0, codec.ZERO, counter)
            compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.T0, codec.ZERO, 8)
            compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, end)
            compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.T0, codec.ZERO, -1)
            compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.T0, counter)
            @light_exit = compiler.current_function.drum_exit
            compiler.current_function.drum_exit = end
            compiler = compile_block(compiler, group.item(plain, 2), no)
            compiler.current_function.drum_exit = light_exit
            compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, start)
            compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, end)
            out compiler
        }
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.A0, source)
        compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T1, codec.A0, codec.ZERO, abi.TAG_MASK)
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T2, codec.ZERO, codec.ZERO, abi.TAG_GROUP)
        compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, codec.T1, codec.T2, numeric)
        compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T1, codec.A0, codec.ZERO, abi.PAYLOAD_MASK)
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A0, codec.T1, codec.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
        compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, counted)
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, numeric)
        compiler = state.emit_op(compiler, instruction.Kind.SRAI, codec.A0, codec.A0, codec.ZERO, abi.TAG_SHIFT)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.ZERO, source)
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, counted)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.A0, counter)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.ZERO, position)
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.S0, codec.ZERO, beat_slot)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.T0, saved)
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, start)
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.S0, codec.ZERO, counter)
        compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.T0, codec.ZERO, 8)
        compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, end)
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T0, codec.T0, codec.ZERO, -1)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.T0, counter)
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T1, codec.S0, codec.ZERO, position)
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T2, codec.S0, codec.ZERO, source)
        compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.T2, codec.ZERO, beat_number)
        compiler = state.emit_op(compiler, instruction.Kind.ANDI, codec.T2, codec.T2, codec.ZERO, abi.PAYLOAD_MASK)
        compiler = state.emit_op(compiler, instruction.Kind.SLLI, codec.T3, codec.T1, codec.ZERO, 2)
        compiler = state.emit_op(compiler, instruction.Kind.ADD, codec.T2, codec.T2, codec.T3, 0)
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T2, codec.T2, codec.ZERO, abi.OBJECT_PAYLOAD_OFFSET + abi.VALUE_WORD_BYTES)
        compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, beat_ready)
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, beat_number)
        compiler = state.emit_op(compiler, instruction.Kind.SLLI, codec.T2, codec.T1, codec.ZERO, abi.TAG_SHIFT)
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, beat_ready)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.T2, beat_slot)
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.T1, codec.ZERO, 1)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.T1, position)
        @outer_exit = compiler.current_function.drum_exit
        compiler.current_function.drum_exit = end
        compiler = compile_block(compiler, group.item(plain, 2), no)
        compiler.current_function.drum_exit = outer_exit
        compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, start)
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, end)
        compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.S0, codec.ZERO, saved)
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, codec.T0, beat_slot)
        out compiler
    }
    out compiler
}

skill compile_function(compiler, name, params, body, subject, module) {
    @locals = state.collect_locals(params, body)
    @local_count = group.count(locals.names)
    @frame = constants.frame_bytes(local_count)
    @slots = state.make_slots(locals.names, constants.local_offset(0))
    @end = state.label(compiler, "{name}_return")
    @types = []
    drum (params) { types = state.type_set(types, beat, "unknown") }
    (str.len(subject) > 0) { types = state.type_set(types, "$self", "box:{subject}") }
    compiler.current_function = state.Function { name = name slots = slots end = end subject = subject module = module types = types }
    @function_label = str.add("saltic_", state.safe(name))
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, function_label)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, 0 - frame)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.RA, constants.return_address_save_offset(frame))
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.S0, constants.previous_frame_save_offset(frame))
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.S4, constants.region_mark_save_offset(frame))
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.S5, constants.region_escape_save_offset(frame))
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.S0, codec.SP, codec.ZERO, frame)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.S4, codec.S1, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.S5, codec.S2, codec.ZERO, 0)
    drum (group.count(params)) {
        @slot = state.slot(compiler, group.item(params, beat))
        compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.S0, abi.argument_register(beat), slot)
    }
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.ZERO, codec.ZERO, abi.CALL_NO_ERROR)
    compiler = compile_block(compiler, body, no)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.ZERO, codec.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, end)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, end)
    @region_done = "{end}_region"
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, codec.S1, codec.S4, region_done)
    compiler.machine = layout.emit_call(compiler.machine, "rt_region_exit")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, region_done)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.RA, codec.S0, codec.ZERO, constants.return_address_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.S4, codec.S0, codec.ZERO, constants.region_mark_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.S5, codec.S0, codec.ZERO, constants.region_escape_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T0, codec.S0, codec.ZERO, constants.previous_frame_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.S0, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.S0, codec.T0, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
    compiler = state.emit_blank(compiler)
    compiler.current_function = state.Function {}
    out compiler
}

skill compile_constant(compiler, constant) {
    @ready = state.label(compiler, "constant_ready")
    @cycle = state.label(compiler, "constant_cycle")
    @failure = state.label(compiler, "constant_failure")
    @finish = state.label(compiler, "constant_finish")
    @before = compiler.current_function
    compiler.current_function = state.Function { name = constant.name module = constant.text }

    @getter = constants.getter_label(constant.name)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, getter)
    @frame = constants.constant_frame_bytes()
    @return_address_offset = constants.constant_return_address_offset()
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, 0 - frame)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.RA, return_address_offset)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.ZERO, codec.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.T0, constants.state_label(constant.name), 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.T1, codec.T0, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T2, codec.ZERO, codec.ZERO, constants.STATE_READY)
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.T1, codec.T2, 8)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, ready)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T2, codec.ZERO, codec.ZERO, constants.STATE_INITIALIZING)
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, codec.ZERO, codec.T1, codec.T2, 8)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, cycle)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.ZERO, codec.ZERO, constants.STATE_INITIALIZING)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T0, codec.T1, 0)

    compiler = compile_expression(compiler, constant.node)
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.BEQ, codec.ZERO, codec.A1, codec.ZERO, 8)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, failure)
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.T0, constants.value_label(constant.name), 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T0, codec.A0, 0)
    compiler.machine = layout.emit_call(compiler.machine, "rt_region_remember_slot")
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.T0, constants.state_label(constant.name), 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.ZERO, codec.ZERO, constants.STATE_READY)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T0, codec.T1, 0)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, finish)

    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ready)
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.T0, constants.value_label(constant.name), 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.A0, codec.T0, codec.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.ZERO, codec.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit_jump(compiler.machine, codec.ZERO, finish)

    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, cycle)
    compiler = state.load_immediate(compiler, "a0", codec.A0, 0)
    compiler = state.load_immediate(compiler, "a1", codec.A1, abi.ERROR_CONSTANT_CYCLE)

    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, failure)
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.T0, constants.state_label(constant.name), 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.T1, codec.ZERO, codec.ZERO, constants.STATE_EMPTY)
    compiler = state.emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.T0, codec.T1, 0)

    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, finish)
    compiler = state.emit_op(compiler, instruction.Kind.LW, codec.RA, codec.SP, codec.ZERO, return_address_offset)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, frame)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, codec.ZERO, codec.RA, codec.ZERO, 0)
    compiler = state.emit_blank(compiler)
    compiler.current_function = before
    out compiler
}

skill compile_constants(compiler) {
    drum (compiler.constants) { compiler = compile_constant(compiler, beat) }
    out compiler
}

skill compile_functions(compiler) {
    drum (compiler.skills) {
        compiler = compile_function(compiler, beat.name, ast.part(beat.node, 2), ast.part(beat.node, 3), "", beat.text)
    }
    drum (compiler.boxes) {
        @box = beat
        drum (group.count(ast.plain(box.node)) - 2) {
            @member = ast.part(box.node, beat + 2)
            (ast.tag(member) == "subject-skill") {
                @name = "{box.name}."
                name = str.add(name, ast.part(member, 1))
                @params = state.group_prepend("$self", ast.part(member, 2))
                compiler = compile_function(compiler, name, params, ast.part(member, 3), box.name, ast.module_name(box.node))
            }
        }
    }
    compiler = compile_function(compiler, "program", ast.part(compiler.entry, 1), ast.part(compiler.entry, 2), "", "")
    out compiler
}
