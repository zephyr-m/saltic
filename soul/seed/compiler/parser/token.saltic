-- token — токен: общий язык лексера и парсера. Лексер токены делает, парсер
-- читает их поля; вид токена — вложенный enum Kind (снаружи Token.Kind.IDENT).
--
-- Token = Box { kind, value, parts, line, col } — parts у TEMPLATE: [текст, имя,
--     текст, …]; describe() -> текст для сообщений парсера
--     Kind — enum { INVALID, IDENT, NUMBER, STRING, NEWLINE, EOF, ключевые
--         слова, знаки, TEMPLATE, NEAR (~=), AND (○), OR (○○) }

Token = Box {
    kind = Kind.INVALID,
    value = "",
    parts = [],
    line = 1,
    col = 1

    Kind = enum {
        INVALID, IDENT, NUMBER, STRING, NEWLINE, EOF,
        SKILL, PROGRAM, USE, BOX, OUT, ENUM, DRUM, RESCUE,
        YES, NO, NONE,
        AT, LBRACE, RBRACE, LBRACKET, RBRACKET, LPAREN, RPAREN,
        COMMA, DOT, PIPE, ASSIGN, EQ, ARROW,
        GT, LT, GE, LE, PLUS, MINUS, STAR, SLASH,
        LEAVE, PICK, NATIVE, TEMPLATE, ALWAYS, PERCENT, NEAR, AND, OR
    }

    skill describe() {
        (kind == Kind.NEWLINE) {
            out "конец строки"
        }
        (kind == Kind.EOF) {
            out "конец файла"
        }
        (kind == Kind.STRING) {
            out "строка"
        }
        (kind == Kind.TEMPLATE) {
            out "строка"
        }
        out "'{value}'"
    }
}
