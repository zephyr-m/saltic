-- expressions — выражения: от листьев (литералы, имя, enum-значение, скобки)
-- через вызов и литерал Box к знакам по приоритету и rescue. Приоритет и
-- правила звеньев ○ ○○ — у leaves (Literals); поле у результата вызова
-- `f().x` — call_field. Блок rescue разбирает Statements, перечни — Lists.
--
-- Expressions = Box { look, leaves } — look — Reader, leaves — Literals; навыки:
-- expression(start) -> Read выражения (binary, logic, call, box-new, rescue…)
-- binary(start, minimum, linked) -> Read по приоритету (linked — справа от
--     звена: сравнение там — в своих скобках)
-- postfix(start) -> Read: вызовы и литерал Box после primary
-- primary(start) -> Read листа; group_literal(start) -> Read "group"
-- lists() / steps() -> соседи Lists и Statements на тех же look и leaves

use core.str
use core.group
use compiler.report.errors
use compiler.parser.token
use compiler.parser.syntax.reader
use compiler.parser.syntax.literals
use compiler.parser.syntax.lists
use compiler.parser.syntax.statements

Expressions = Box {
    look = Reader {},
    leaves = Literals {}

    skill expression(start) {
        @value = binary(start, 0, no)
        (value.broken() == yes) {
            out value
        }
        (look.is(value.next, Token.Kind.RESCUE) == yes) {
            @rescue_token = look.at(value.next)
            @pipe = look.expect(value.next + 1, Token.Kind.PIPE, "expected_pipe")
            (pipe.broken() == yes) {
                out pipe
            }
            (look.is(pipe.next, Token.Kind.IDENT) == no) {
                out look.fail(pipe.next, "expected_rescue_name")
            }
            @error_token = look.at(pipe.next)
            @error_name = error_token.value
            @pipe2 = look.expect(pipe.next + 1, Token.Kind.PIPE, "expected_pipe")
            (pipe2.broken() == yes) {
                out pipe2
            }
            @stepping = steps()
            @body = stepping.block(pipe2.next)
            (body.broken() == yes) {
                out body
            }
            out look.ok("rescue", look.loc(["rescue", value.datum(), error_name, body.datum()], rescue_token, look.locations), body.next)
        }
        out value
    }

    skill binary(start, minimum, linked) {
        @first = postfix(start)
        (first.broken() == yes) {
            out first
        }
        @left = first.node
        @next = first.next
        @diagnostics = []
        @before = ""
        @stream = look.tokens
        drum (stream.count()) {
            @operator = look.at(next)
            @level = leaves.precedence(operator.kind)
            (level < minimum) { leave }
            diagnostics = leaves.order(next, operator, before, linked)
            (group.count(diagnostics) > 0) { leave }
            @right = binary(next + 1, level + 1, leaves.linking(operator.kind))
            (right.broken() == yes) {
                diagnostics = right.diagnostics
                leave
            }
            left = leaves.joined(operator, left, right.datum())
            before = operator.value
            next = right.next
        }
        out look.read(left, next, diagnostics)
    }

    skill postfix(start) {
        @base = primary(start)
        (base.broken() == yes) {
            out base
        }
        @node = base.node
        @next = base.next
        @diagnostics = []
        @stream = look.tokens
        drum (stream.count()) {
            (look.is(next, Token.Kind.LPAREN) == yes) {
                @call_token = look.at(next)
                @listing = lists()
                @arguments = listing.args(next)
                (arguments.broken() == yes) {
                    diagnostics = arguments.diagnostics
                    leave
                }
                @call = ["call", node.datum]
                call = look.append_tail(call, arguments.datum(), 0)
                node = look.make_node("call", look.loc(call, call_token, look.locations))
                next = arguments.next
            }
            (look.is(next, Token.Kind.LPAREN) == no) {
                (node.tag == "call") {
                    (look.is(next, Token.Kind.DOT) == yes) {
                        @close_token = look.at(next - 1)
                        @dot_token = look.at(next)
                        (dot_token.line == close_token.line) {
                            (dot_token.col == close_token.col + 1) {
                                @field_failure = look.fail_with(next, errors.call_field())
                                diagnostics = field_failure.diagnostics
                                leave
                            }
                        }
                    }
                }
                ((node.tag == "path") == no) { leave }
                (look.is(next, Token.Kind.LBRACE) == no) { leave }
                @box_token = look.at(next)
                @gathering = lists()
                @box_fields = gathering.fields(next)
                (box_fields.broken() == yes) {
                    diagnostics = box_fields.diagnostics
                    leave
                }
                @plain_name = node.datum
                (look.locations == yes) { plain_name = group.get(node.datum, 3) }
                @box_name = group.get(plain_name, 1)
                @name_index = 2
                drum (group.count(plain_name) - 2) {
                    box_name = str.concat(box_name, str.concat(".", group.get(plain_name, name_index)))
                    name_index = name_index + 1
                }
                @box = ["box-new", box_name]
                box = look.append_tail(box, box_fields.datum(), 0)
                node = look.make_node("box-new", look.loc(box, box_token, look.locations))
                next = box_fields.next
            }
        }
        out look.read(node, next, diagnostics)
    }

    skill primary(start) {
        @word = look.at(start)
        (word.kind == Token.Kind.NUMBER) {
            out leaves.number_literal(word, "", word.value, start + 1)
        }
        (word.kind == Token.Kind.MINUS) {
            @digits = look.at(start + 1)
            (digits.kind == Token.Kind.NUMBER) {
                (digits.line == word.line) {
                    (digits.col == word.col + 1) {
                        out leaves.number_literal(word, "-", digits.value, start + 2)
                    }
                }
            }
            @operand = postfix(start + 1)
            (operand.broken() == yes) {
                out operand
            }
            out look.ok("negate", look.loc(["negate", operand.datum()], word, look.locations), operand.next)
        }
        (word.kind == Token.Kind.STRING) {
            out look.ok("string", look.loc(["string", word.value], word, look.locations), start + 1)
        }
        (word.kind == Token.Kind.TEMPLATE) {
            out leaves.template(word, start)
        }
        (word.kind == Token.Kind.YES) {
            out look.ok("answer", look.loc(["answer", "yes"], word, look.locations), start + 1)
        }
        (word.kind == Token.Kind.NO) {
            out look.ok("answer", look.loc(["answer", "no"], word, look.locations), start + 1)
        }
        (word.kind == Token.Kind.NONE) {
            out look.ok("none", look.loc(["none"], word, look.locations), start + 1)
        }
        (word.kind == Token.Kind.DOT) {
            (look.is(start + 1, Token.Kind.IDENT) == no) {
                out look.fail(start + 1, "expected_enum_value")
            }
            @name_token = look.at(start + 1)
            out look.ok("enum-value", look.loc(["enum-value", name_token.value], word, look.locations), start + 2)
        }
        (word.kind == Token.Kind.LBRACKET) {
            out group_literal(start)
        }
        (word.kind == Token.Kind.IDENT) {
            out look.path_at(start, look.locations)
        }
        (word.kind == Token.Kind.LPAREN) {
            @inside = expression(start + 1)
            (inside.broken() == yes) {
                out inside
            }
            @close = look.expect(inside.next, Token.Kind.RPAREN, "expected_close_paren")
            (close.broken() == yes) {
                out close
            }
            out look.read(inside.node, close.next, [])
        }
        out look.fail(start, "expected_expression")
    }

    skill group_literal(start) {
        @word = look.at(start)
        @listing = lists()
        @list = listing.expression_list(start + 1, Token.Kind.RBRACKET)
        (list.broken() == yes) {
            out list
        }
        @items = ["group"]
        items = look.append_tail(items, list.datum(), 0)
        out look.ok("group", look.loc(items, word, look.locations), list.next)
    }

    skill lists() {
        out Lists {
            look = look,
            leaves = leaves
        }
    }

    skill steps() {
        out Statements {
            look = look,
            leaves = leaves
        }
    }
}
