-- parser — публичное лицо разбора, вход папки parser/ (use compiler.parser):
-- текст одного файла -> AST. С locations = yes узлы обёрнуты местом
-- (ast.located) для диагностик. Файл со всеми его use собирает архитектор
-- (billet.architect) — ступенью раньше.
--
-- Parser = Box { locations } — ставить ли место:
--     parse_text(source, path) -> Syntax.Parse { ast, tokens, diagnostics }
--
-- Дети: lexer/ (main — Lexer, text — Text), token, syntax/ (main — Syntax,
-- reader, literals, declarations, statements,
-- expressions, lists), nest.

use compiler.parser.syntax

Parser = Box {
    locations = no

    skill parse_text(source, path) {
        @reading = Syntax {
            path = path,
            locations = locations
        }
        out reading.parse(source)
    }
}
