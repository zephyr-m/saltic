-- text — строки исходника для лексера: "…" — строго одна строка, текст в
-- несколько строк — блок #: открывающий # в конце строки, закрывающий # один на
-- своей строке; его отступ снимается со всех строк, перенос перед ним в текст
-- не входит; {…} делает TEMPLATE с parts = [текст, имя, текст, …], \-escape
-- одни и те же. Текст не склеивается посимвольно: run — начало нетронутого
-- отрезка исходника, он берётся одним срезом; после экранирования срез и
-- расшифровка копятся в piece и по TEXT_PIECE байт уходят в value (collected
-- их сводит). Ошибка — Lexeme без токена и с диагностикой (failed).
--
-- Text = Box { source, path } — исходник и путь для мест ошибок; навыки:
--     Placeholder — Box { name, next, found } — {имя} в строке
--     text(start, line, col) -> Lexer.Lexeme — строка "…" или блок #…#
--     text_block / literal / placeholder — блок, тело строки, {имя}
--     closed(value, parts, line, col) -> Token STRING или TEMPLATE
--     newline_at(index) / blank_end(index) / line_end(index) / indented(begin,
--         margin) — где кончается строка, пробелы, пустой ли хвост, отступ блока
--     collected(value, piece, run, stop); failed(line, col, diagnostics, problem)
-- QUOTE, ESCAPE, ESCAPE_NEWLINE, ESCAPE_TAB, TEXT_PIECE — знаки и порог куска

use core.str
use core.group
use compiler.report
use compiler.report.writing
use compiler.parser.token
use compiler.parser.lexer

QUOTE = "\""
ESCAPE = "\\"
ESCAPE_NEWLINE = "n"
ESCAPE_TAB = "t"
TEXT_PIECE = 4096

Text = Box {
    writing_errors = writing.Writing {},
    source = "",
    path = ""

    Placeholder = Box {
        name = "",
        next = 0,
        found = no
    }

    skill text(start, line, col) {
        (str.get(source, start) == "#") {
            out text_block(start, line, col)
        }
        out literal(start + 1, str.bytes(source), "", yes, line, col, line, col + 1)
    }

    skill text_block(start, line, col) {
        @length = str.bytes(source)
        @open_end = blank_end(start + 1)
        (line_end(start + 1) == no) {
            out failed(line, col + open_end - start, [], writing_errors.text_after_open())
        }
        @begin = open_end
        @close_line = line
        drum (length - open_end) {
            (begin == length) { leave }
            begin = begin + 1
            close_line = close_line + 1
            @mark = blank_end(begin)
            (str.starts_at(source, "#", mark) == yes) {
                (line_end(mark + 1) == yes) {
                    @margin = str.slice(source, begin, mark)
                    @first = open_end
                    (begin > open_end + 1) { first = indented(open_end + 1, margin) }
                    (first < 0) {
                        out failed(line + 1, 1, [], writing_errors.text_left_of_close())
                    }
                    @lexeme = literal(first, begin - 1, margin, no, line, col, line + 1, first - open_end)
                    out Lexer.Lexeme {
                        token = lexeme.token,
                        next = mark + 1,
                        line = close_line,
                        col = mark - begin + 2,
                        diagnostics = lexeme.diagnostics
                    }
                }
            }
            begin = newline_at(mark)
        }
        out failed(line, col, [], writing_errors.unterminated_string())
    }

    skill literal(first, stop, margin, quoted, line, col, at_line, at_col) {
        @index = first
        @next_line = at_line
        @next_col = at_col
        @run = first
        @piece = ""
        @value = ""
        @parts = []
        @diagnostics = []
        drum (stop - first + 1) {
            (index == stop) {
                (quoted == yes) {
                    out failed(line, col, diagnostics, writing_errors.unterminated_string())
                }
                out Lexer.Lexeme {
                    token = closed(collected(value, piece, run, index), parts, line, col)
                }
            }
            @ch = str.get(source, index)
            (ch == QUOTE) {
                (quoted == yes) {
                    @done = closed(collected(value, piece, run, index), parts, line, col)
                    out Lexer.Lexeme {
                        token = done,
                        next = index + 1,
                        line = next_line,
                        col = next_col + 1,
                        diagnostics = diagnostics
                    }
                }
            }
            pick {
                (ch == ESCAPE) {
                    @escape = lexer.NEWLINE
                    (index + 1 < stop) { escape = str.get(source, index + 1) }
                    (escape == lexer.NEWLINE) {
                        out failed(next_line, next_col, diagnostics, writing_errors.unterminated_escape())
                    }
                    @decoded = escape
                    (escape == ESCAPE_NEWLINE) { decoded = lexer.NEWLINE }
                    (escape == ESCAPE_TAB) { decoded = lexer.TAB }
                    (escape == QUOTE) { decoded = QUOTE }
                    (escape == ESCAPE) { decoded = ESCAPE }
                    piece = str.concat(str.concat(piece, str.slice(source, run, index)), decoded)
                    (str.bytes(piece) > TEXT_PIECE) {
                        value = str.concat(value, piece)
                        piece = ""
                    }
                    index = index + 2
                    run = index
                    next_col = next_col + 2
                }
                (ch == lexer.NEWLINE) {
                    (quoted == yes) {
                        out failed(line, col, diagnostics, writing_errors.unterminated_string())
                    }
                    @skip = indented(index + 1, margin)
                    (skip < 0) {
                        out failed(next_line + 1, 1, diagnostics, writing_errors.text_left_of_close())
                    }
                    piece = str.concat(piece, str.slice(source, run, index + 1))
                    next_line = next_line + 1
                    next_col = skip - index
                    index = skip
                    run = index
                }
                (ch == "\{") {
                    @found = placeholder(index)
                    (found.found == no) {
                        out failed(next_line, next_col, diagnostics, writing_errors.template_expects_name())
                    }
                    parts = group.add(group.add(parts, collected(value, piece, run, index)), found.name)
                    value = ""
                    piece = ""
                    next_col = next_col + found.next - index
                    index = found.next
                    run = index
                }
                (ch == "\}") {
                    out failed(next_line, next_col, diagnostics, writing_errors.lone_closing_brace())
                }
                {
                    index = index + 1
                    next_col = next_col + 1
                }
            }
        }
        out failed(line, col, diagnostics, writing_errors.unterminated_string())
    }

    skill placeholder(start) {
        @reading = Lexer {
            source = source,
            path = path
        }
        @index = start + 1
        drum (str.bytes(source) - index) {
            @ch = str.get(source, index)
            pick {
                (ch == "\}") {
                    (index == start + 1) {
                        out Placeholder {}
                    }
                    out Placeholder {
                        name = str.slice(source, start + 1, index),
                        next = index + 1,
                        found = yes
                    }
                }
                (ch == ".") { index = index + 1 }
                (reading.ident_part(ch) == yes) { index = index + 1 }
                {
                    out Placeholder {}
                }
            }
        }
        out Placeholder {}
    }

    skill closed(value, parts, line, col) {
        (group.count(parts) > 0) {
            out Token {
                kind = Token.Kind.TEMPLATE,
                value = value,
                parts = group.add(parts, value),
                line = line,
                col = col
            }
        }
        out Token {
            kind = Token.Kind.STRING,
            value = value,
            line = line,
            col = col
        }
    }

    skill collected(value, piece, run, stop) {
        out str.concat(str.concat(value, piece), str.slice(source, run, stop))
    }

    skill failed(line, col, diagnostics, problem) {
        out Lexer.Lexeme {
            token = none,
            line = line,
            col = col,
            diagnostics = group.add(diagnostics, problem.placed_at(path, line, col))
        }
    }

    skill indented(begin, margin) {
        (str.starts_at(source, margin, begin) == yes) {
            out begin + str.bytes(margin)
        }
        (line_end(begin) == yes) {
            out blank_end(begin)
        }
        out -1
    }

    skill line_end(index) {
        out (newline_at(index) == blank_end(index))
    }

    skill blank_end(index) {
        @next = index
        drum (str.bytes(source) - index) {
            @ch = str.get(source, next)
            pick {
                (ch == " ") { next = next + 1 }
                (ch == lexer.TAB) { next = next + 1 }
                {
                    out next
                }
            }
        }
        out next
    }

    skill newline_at(index) {
        @next = index
        drum (str.bytes(source) - index) {
            (str.get(source, next) == lexer.NEWLINE) {
                out next
            }
            next = next + 1
        }
        out next
    }
}
