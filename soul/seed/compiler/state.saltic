use seed
use seed.abi
use seed.ast
use seed.memory.model
use seed.machine.instruction
use seed.machine.codec
use seed.machine.layout

Symbol = Box {
    name = ""
    kind = ""
    node = []
    value = 0
    text = ""
    slot = 0
}

Function = Box {
    name = ""
    slots = []
    end = ""
    subject = ""
    module = ""
    types = []
    next_drum = 1
    drum_exit = ""
}

Names = Box {
    names = []
    next_drum = 1
}

Output = Box {
    chunks = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
}

State = Box {
    ast = []
    lines = Output {}
    data = Output {}
    writable = Output {}
    machine = layout.Program {}
    heap_bytes = codec.Word {}
    strings = []
    serial = 0
    constants = []
    boxes = []
    enums = []
    variants = []
    errors = []
    fields = []
    skills = []
    aliases = []
    entry = []
    current_function = Function {}
    next_enum_id = 1
    next_field_id = 1
}

DRUM_BEAT = "beat"
WIDE_OFFSET_REGISTER = codec.T6

PRINTABLE = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

skill symbol_find(symbols, name) {
    @count = seed.group.count(symbols)
    drum (count) {
        @item = seed.group.item(symbols, count - 1 - beat)
        (item.name == name) { out item }
    }
    out Symbol {}
}

skill symbol_has(symbols, name) {
    @item = symbol_find(symbols, name)
    out seed.str.len(item.name) > 0
}

skill symbol_add(symbols, name, kind, node, value) {
    out seed.group.add(symbols, Symbol { name = name kind = kind node = node value = value })
}

skill symbol_add_text(symbols, name, kind, node, text) {
    out seed.group.add(symbols, Symbol { name = name kind = kind node = node text = text })
}

skill type_find(types, name) {
    out symbol_find(types, name)
}

skill type_set(types, name, type) {
    @item = symbol_find(types, name)
    (seed.str.len(item.name) == 0) { out seed.group.add(types, Symbol { name = name kind = "type" text = type }) }
    item.text = type
    out types
}

skill output_add(output, text) {
    @carry = text
    @chunks = []
    @active = yes
    drum (output.chunks) {
        pick {
            (active == no) { chunks = seed.group.add(chunks, beat) }
            (seed.str.len(beat) == 0) {
                chunks = seed.group.add(chunks, carry)
                active = no
            }
            {
                chunks = seed.group.add(chunks, "")
                carry = seed.str.add(beat, carry)
            }
        }
    }
    (active == yes) { chunks = seed.group.add(chunks, carry) }
    out Output { chunks = chunks }
}

skill output_text(output) {
    @result = ""
    @count = seed.group.count(output.chunks)
    drum (count) {
        @chunk = seed.group.item(output.chunks, count - 1 - beat)
        (seed.str.len(chunk) > 0) { result = seed.str.add(result, chunk) }
    }
    out result
}

skill emit(compiler, line) {
    out compiler
}

skill emit_data(compiler, line) {
    out compiler
}

skill emit_writable(compiler, line) {
    out compiler
}

skill emit_blank(compiler) {
    out compiler
}

skill fits_immediate(value) {
    (value < -2048) { out no }
    (value > 2047) { out no }
    out yes
}

skill wide_offset_kind(kind) {
    (kind == instruction.Kind.ADDI) { out yes }
    (kind == instruction.Kind.LW) { out yes }
    (kind == instruction.Kind.LB) { out yes }
    (kind == instruction.Kind.LBU) { out yes }
    (kind == instruction.Kind.LH) { out yes }
    (kind == instruction.Kind.LHU) { out yes }
    (kind == instruction.Kind.SW) { out yes }
    (kind == instruction.Kind.SB) { out yes }
    (kind == instruction.Kind.SH) { out yes }
    out no
}

skill emit_op(compiler, kind, rd, rs1, rs2, immediate) {
    (fits_immediate(immediate) == no) {
        (wide_offset_kind(kind) == yes) {
            compiler.machine = layout.emit_load_immediate(compiler.machine, WIDE_OFFSET_REGISTER, immediate)
            compiler.machine = layout.emit(compiler.machine, instruction.Kind.ADD, WIDE_OFFSET_REGISTER, WIDE_OFFSET_REGISTER, rs1, 0)
            compiler.machine = layout.emit(compiler.machine, kind, rd, WIDE_OFFSET_REGISTER, rs2, 0)
            out compiler
        }
    }
    compiler.machine = layout.emit(compiler.machine, kind, rd, rs1, rs2, immediate)
    out compiler
}

skill safe(text) {
    @result = ""
    @allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    drum (seed.str.len(text)) {
        @ch = seed.str.at(text, beat)
        pick {
            (seed.str.contains(allowed, ch) == yes) { result = seed.str.add(result, ch) }
            { result = seed.str.add(result, "_") }
        }
    }
    out result
}

skill label(compiler, prefix) {
    @label = seed.str.add(".L_", safe(prefix))
    label = seed.str.add(label, "_")
    label = seed.str.add(label, seed.num.text(compiler.serial))
    compiler.serial = compiler.serial + 1
    out label
}

skill align16(value) {
    @quotient = value / abi.CALL_STACK_ALIGNMENT
    (quotient * abi.CALL_STACK_ALIGNMENT == value) { out value }
    out (quotient + 1) * abi.CALL_STACK_ALIGNMENT
}

skill align8(value) {
    @quotient = value / abi.OBJECT_ALIGNMENT
    (quotient * abi.OBJECT_ALIGNMENT == value) { out value }
    out (quotient + 1) * abi.OBJECT_ALIGNMENT
}

skill name_add(names, name) {
    (symbol_has(names.names, name) == no) { names.names = symbol_add(names.names, name, "local", [], 0) }
    out names
}

skill collect_expression_names(names, node) {
    @plain = ast.plain(node)
    @tag = seed.group.item(plain, 0)
    (tag == "binary") {
        names = collect_expression_names(names, seed.group.item(plain, 2))
        names = collect_expression_names(names, seed.group.item(plain, 3))
    }
    (tag == "call") {
        drum (seed.group.count(plain) - 1) { names = collect_expression_names(names, seed.group.item(plain, beat + 1)) }
    }
    (tag == "group") {
        drum (seed.group.count(plain) - 1) { names = collect_expression_names(names, seed.group.item(plain, beat + 1)) }
    }
    (tag == "box-new") {
        drum (seed.group.count(plain) - 2) { names = collect_expression_names(names, ast.part(seed.group.item(plain, beat + 2), 2)) }
    }
    (tag == "rescue") {
        names = collect_expression_names(names, seed.group.item(plain, 1))
        names = name_add(names, seed.group.item(plain, 2))
        names = collect_block_names(names, seed.group.item(plain, 3))
    }
    out names
}

skill collect_statement_names(names, node) {
    @plain = ast.plain(node)
    @tag = seed.group.item(plain, 0)
    (tag == "var") {
        names = name_add(names, seed.group.item(plain, 1))
        names = collect_expression_names(names, seed.group.item(plain, 2))
    }
    (tag == "assign") { names = collect_expression_names(names, seed.group.item(plain, 2)) }
    (tag == "field-assign") {
        names = collect_expression_names(names, seed.group.item(plain, 1))
        names = collect_expression_names(names, seed.group.item(plain, 2))
    }
    (tag == "out") { names = collect_expression_names(names, seed.group.item(plain, 1)) }
    (tag == "expr") { names = collect_expression_names(names, seed.group.item(plain, 1)) }
    (tag == "if") {
        names = collect_expression_names(names, seed.group.item(plain, 1))
        names = collect_block_names(names, seed.group.item(plain, 2))
    }
    (tag == "pick") {
        drum (seed.group.count(plain) - 1) {
            @choice = ast.plain(seed.group.item(plain, beat + 1))
            (seed.group.item(choice, 0) == "if") { names = collect_statement_names(names, choice) }
            (seed.group.item(choice, 0) == "otherwise") { names = collect_block_names(names, seed.group.item(choice, 1)) }
        }
    }
    (tag == "switch") {
        names = collect_expression_names(names, seed.group.item(plain, 1))
        drum (seed.group.count(plain) - 2) { names = collect_expression_names(names, ast.part(seed.group.item(plain, beat + 2), 2)) }
    }
    (tag == "drum") {
        @drum_number = seed.num.text(names.next_drum)
        names.next_drum = names.next_drum + 1
        names = name_add(names, seed.str.add("$drum:", drum_number))
        names = name_add(names, seed.str.add("$drum_source:", drum_number))
        names = name_add(names, seed.str.add("$drum_index:", drum_number))
        names = name_add(names, seed.str.add("$drum_saved:", drum_number))
        names = name_add(names, DRUM_BEAT)
        names = collect_expression_names(names, seed.group.item(plain, 1))
        names = collect_block_names(names, seed.group.item(plain, 2))
    }
    out names
}

skill collect_block_names(names, block) {
    @plain = ast.plain(block)
    drum (seed.group.count(plain) - 1) { names = collect_statement_names(names, seed.group.item(plain, beat + 1)) }
    out names
}

skill expression_uses_beat(node) {
    @plain = ast.plain(node)
    @tag = seed.group.item(plain, 0)
    (tag == "path") { out seed.group.item(plain, 1) == DRUM_BEAT }
    (tag == "binary") {
        (expression_uses_beat(seed.group.item(plain, 2)) == yes) { out yes }
        out expression_uses_beat(seed.group.item(plain, 3))
    }
    (tag == "call") { out items_use_beat(plain, 1) }
    (tag == "group") { out items_use_beat(plain, 1) }
    (tag == "box-new") {
        drum (seed.group.count(plain) - 2) {
            (expression_uses_beat(ast.part(seed.group.item(plain, beat + 2), 2)) == yes) { out yes }
        }
        out no
    }
    (tag == "rescue") {
        (expression_uses_beat(seed.group.item(plain, 1)) == yes) { out yes }
        out block_uses_beat(seed.group.item(plain, 3))
    }
    out no
}

skill items_use_beat(plain, first) {
    drum (seed.group.count(plain) - first) {
        (expression_uses_beat(seed.group.item(plain, beat + first)) == yes) { out yes }
    }
    out no
}

skill statement_uses_beat(node) {
    @plain = ast.plain(node)
    @tag = seed.group.item(plain, 0)
    (tag == "var") { out expression_uses_beat(seed.group.item(plain, 2)) }
    (tag == "assign") { out expression_uses_beat(seed.group.item(plain, 2)) }
    (tag == "field-assign") {
        (expression_uses_beat(seed.group.item(plain, 1)) == yes) { out yes }
        out expression_uses_beat(seed.group.item(plain, 2))
    }
    (tag == "out") { out expression_uses_beat(seed.group.item(plain, 1)) }
    (tag == "expr") { out expression_uses_beat(seed.group.item(plain, 1)) }
    (tag == "if") {
        (expression_uses_beat(seed.group.item(plain, 1)) == yes) { out yes }
        out block_uses_beat(seed.group.item(plain, 2))
    }
    (tag == "switch") {
        (expression_uses_beat(seed.group.item(plain, 1)) == yes) { out yes }
        drum (seed.group.count(plain) - 2) {
            (expression_uses_beat(ast.part(seed.group.item(plain, beat + 2), 2)) == yes) { out yes }
        }
        out no
    }
    (tag == "drum") { out expression_uses_beat(seed.group.item(plain, 1)) }
    (tag == "pick") {
        drum (seed.group.count(plain) - 1) {
            @choice = ast.plain(seed.group.item(plain, beat + 1))
            (seed.group.item(choice, 0) == "if") {
                (statement_uses_beat(choice) == yes) { out yes }
            }
            (seed.group.item(choice, 0) == "otherwise") {
                (block_uses_beat(seed.group.item(choice, 1)) == yes) { out yes }
            }
        }
        out no
    }
    out no
}

skill block_uses_beat(block) {
    @plain = ast.plain(block)
    drum (seed.group.count(plain) - 1) {
        (statement_uses_beat(seed.group.item(plain, beat + 1)) == yes) { out yes }
    }
    out no
}

skill collect_locals(params, body) {
    @names = Names {}
    drum (params) { names = name_add(names, beat) }
    out collect_block_names(names, body)
}

skill make_slots(names, first_slot) {
    @slots = []
    @slot = first_slot
    drum (names) {
        slots = symbol_add(slots, beat.name, "slot", [], slot)
        slot = slot - abi.VALUE_WORD_BYTES
    }
    out slots
}

skill slot(compiler, name) {
    @slot = symbol_find(compiler.current_function.slots, name)
    out slot.value
}

skill group_prepend(value, group) {
    @result = [value]
    drum (group) { result = seed.group.add(result, beat) }
    out result
}

skill group_slice(group, start, end) {
    @result = []
    drum (end - start) { result = seed.group.add(result, seed.group.item(group, start + beat)) }
    out result
}

skill push(compiler, register, machine_register) {
    compiler = emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, 0 - abi.VALUE_WORD_BYTES)
    compiler = emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, machine_register, 0)
    out compiler
}

skill pop(compiler, register, machine_register) {
    compiler = emit_op(compiler, instruction.Kind.LW, machine_register, codec.SP, codec.ZERO, 0)
    compiler = emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, abi.VALUE_WORD_BYTES)
    out compiler
}

skill load_immediate(compiler, register, machine_register, value) {
    compiler.machine = layout.emit_load_immediate(compiler.machine, machine_register, value)
    out compiler
}

skill field(compiler, name) {
    @field = symbol_find(compiler.fields, name)
    out field.value
}

skill render_lines(output) {
    out output_text(output)
}

skill collect_box(compiler, item, module) {
    @name = ast.qualified(module, ast.part(item, 1))
    compiler.boxes = symbol_add_text(compiler.boxes, name, "box", item, module)
    @slot = 0
    drum (seed.group.count(ast.plain(item)) - 2) {
        @member = ast.part(item, beat + 2)
        (ast.tag(member) == "field") {
            @field_name = ast.part(member, 1)
            (symbol_has(compiler.fields, field_name) == no) {
                compiler.fields = seed.group.add(compiler.fields, Symbol { name = field_name kind = "field" node = member value = compiler.next_field_id slot = slot })
                compiler.next_field_id = compiler.next_field_id + 1
            }
            slot = slot + 1
        }
    }
    out compiler
}

skill collect_enum(compiler, item, module) {
    @name = ast.qualified(module, ast.part(item, 1))
    compiler.enums = symbol_add_text(compiler.enums, name, "enum", item, module)
    drum (seed.group.count(ast.plain(item)) - 2) {
        @variant = ast.part(item, beat + 2)
        @full_name = seed.str.add(name, ".")
        full_name = seed.str.add(full_name, variant)
        @value = abi.tagged(compiler.next_enum_id, abi.TAG_ENUM)
        compiler.variants = symbol_add(compiler.variants, full_name, "variant", item, value)
        (symbol_has(compiler.variants, variant) == no) { compiler.variants = symbol_add(compiler.variants, variant, "variant", item, value) }
        compiler.next_enum_id = compiler.next_enum_id + 1
    }
    out compiler
}

skill collect_top_level(compiler) {
    drum (seed.group.count(compiler.ast) - 1) {
        @item = seed.group.item(compiler.ast, beat + 1)
        @tag = ast.tag(item)
        @module = ast.module_name(item)
        (tag == "use") {
            @plain_use = ast.plain(item)
            @alias = seed.group.item(plain_use, seed.group.count(plain_use) - 1)
            @target = ast.path_text(item)
            compiler.aliases = symbol_add_text(compiler.aliases, ast.alias_key(module, alias), "import", item, target)
        }
        (tag == "const") { compiler.constants = symbol_add_text(compiler.constants, ast.qualified(module, ast.part(item, 1)), "const", ast.part(item, 2), module) }
        (tag == "box") { compiler = collect_box(compiler, item, module) }
        (tag == "enum") { compiler = collect_enum(compiler, item, module) }
        (tag == "skill") { compiler.skills = symbol_add_text(compiler.skills, ast.qualified(module, ast.part(item, 1)), "skill", item, module) }
        (tag == "entry") { compiler.entry = item }
    }
    out compiler
}

skill header(compiler) {
    (codec.word_is_zero(compiler.heap_bytes) == yes) {
        compiler.heap_bytes = layout.address_from_number(model.DEFAULT_HEAP_BYTES)
    }
    compiler.machine = layout.host("_start")
    compiler.machine.heap_size = compiler.heap_bytes
    compiler = emit_blank(compiler)
    out compiler
}

skill start(compiler) {
    @params = ast.part(compiler.entry, 1)
    @param_count = seed.group.count(params)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "_start")
    compiler = emit_op(compiler, instruction.Kind.LW, codec.A0, codec.SP, codec.ZERO, 0)
    compiler = emit_op(compiler, instruction.Kind.ADDI, codec.A1, codec.SP, codec.ZERO, abi.VALUE_WORD_BYTES)
    compiler = emit_op(compiler, instruction.Kind.ADDI, codec.S3, codec.A1, codec.ZERO, 0)
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.S1, "saltic_heap", 0)
    compiler.machine = layout.emit_load_word(compiler.machine, codec.S2, compiler.heap_bytes)
    compiler = emit_op(compiler, instruction.Kind.ADD, codec.S2, codec.S1, codec.S2, 0)
    compiler = emit_op(compiler, instruction.Kind.ADDI, codec.S0, codec.ZERO, codec.ZERO, 0)
    compiler = emit_op(compiler, instruction.Kind.ADDI, codec.S4, codec.S1, codec.ZERO, 0)
    compiler = emit_op(compiler, instruction.Kind.ADDI, codec.S5, codec.S2, codec.ZERO, 0)
    compiler.machine = layout.emit_load_immediate(compiler.machine, codec.T0, param_count + 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, codec.A0, codec.T0, ".L_start_args_ready")
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.T1, "rt_missing_args", 0)
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.JALR, codec.ZERO, codec.T1, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_start_args_ready")
    drum (param_count) {
        compiler = emit_op(compiler, instruction.Kind.LW, codec.A0, codec.S3, codec.ZERO, (beat + 1) * abi.VALUE_WORD_BYTES)
        compiler.machine = layout.emit_call(compiler.machine, "rt_cstring")
        compiler = emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, 0 - abi.VALUE_WORD_BYTES)
        compiler = emit_op(compiler, instruction.Kind.SW, codec.ZERO, codec.SP, codec.A0, 0)
    }
    drum (param_count) {
        compiler = emit_op(compiler, instruction.Kind.LW, abi.argument_register(beat), codec.SP, codec.ZERO, (param_count - beat - 1) * abi.VALUE_WORD_BYTES)
    }
    (param_count > 0) {
        compiler = emit_op(compiler, instruction.Kind.ADDI, codec.SP, codec.SP, codec.ZERO, param_count * abi.VALUE_WORD_BYTES)
    }
    compiler.machine = layout.emit_call(compiler.machine, "saltic_program")
    compiler = emit_op(compiler, instruction.Kind.SLTU, codec.A0, codec.ZERO, codec.A1, 0)
    compiler.machine = layout.emit_call(compiler.machine, "rt_platform_exit")
    compiler = emit_blank(compiler)
    out compiler
}

skill finish_data(compiler) {
    (codec.word_is_zero(compiler.heap_bytes) == yes) {
        compiler.heap_bytes = layout.address_from_number(model.DEFAULT_HEAP_BYTES)
    }
    compiler.machine.heap_size = compiler.heap_bytes
    compiler.lines = output_add(compiler.lines, output_text(compiler.writable))
    compiler.lines = output_add(compiler.lines, output_text(compiler.data))
    compiler.machine = layout.align_section(compiler.machine, layout.Section.DATA, abi.OBJECT_ALIGNMENT)
    compiler.machine = layout.align_section(compiler.machine, layout.Section.RODATA, abi.OBJECT_ALIGNMENT)
    compiler.machine = layout.align_section(compiler.machine, layout.Section.BSS, abi.OBJECT_ALIGNMENT)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.BSS, "saltic_heap")
    compiler.machine = layout.reserve_bss(compiler.machine, compiler.heap_bytes)
    out compiler
}
