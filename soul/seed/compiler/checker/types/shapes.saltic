-- shapes — что за вещь тип: текст типа ("number", "group:…", "box:…",
-- "enum:…", фиксированные), его части и слияние; как показать тип в
-- сообщении; узел поля литерала Box (общий с кодогеном).

use core.str
use core.group
use core.num
use compiler.nodes
use compiler.contract.intrinsic.contract

Shapes = Box {
    skill tail_text(text, start) {
        out str.slice(text, start, str.bytes(text))
    }

    skill group_type(type) {
        out "group:{type}"
    }

    skill is_group_type(type) {
        out str.starts_with(type, "group:")
    }

    skill group_item_type(type) {
        (is_group_type(type) == yes) {
            out tail_text(type, 6)
        }
        out "unknown"
    }

    skill box_type(name) {
        out "box:{name}"
    }

    skill is_box_type(type) {
        out str.starts_with(type, "box:")
    }

    skill box_name(type) {
        (is_box_type(type) == yes) {
            out tail_text(type, 4)
        }
        out ""
    }

    skill is_enum_type(type) {
        out str.starts_with(type, "enum:")
    }

    skill enum_name(type) {
        (is_enum_type(type) == yes) {
            out tail_text(type, 5)
        }
        out ""
    }

    skill merge_types(left, right) {
        (left == "unknown") {
            out right
        }
        (right == "unknown") {
            out left
        }
        (left == right) {
            out left
        }
        (is_group_type(left) == yes) {
            (is_group_type(right) == yes) {
                out group_type(merge_types(group_item_type(left), group_item_type(right)))
            }
        }
        out "unknown"
    }

    skill stored(type) {
        (contract.is_fixed_type(type) == yes) {
            out "number"
        }
        out type
    }

    skill inferable(type) {
        (type == "fraction") {
            out yes
        }
        out contract.is_fixed_type(type)
    }

    skill fraction_marked(type, node) {
        (type == "fraction") {
            out nodes.typed(type, node)
        }
        out node
    }

    skill fixed_marked(type, node) {
        (contract.is_fixed_type(type) == yes) {
            out nodes.typed(type, node)
        }
        out node
    }

    skill compatible(left, right) {
        (left == "unknown") {
            out yes
        }
        (left == "none") {
            out yes
        }
        (right == "unknown") {
            out yes
        }
        (left == right) {
            out yes
        }
        (is_group_type(left) == yes) {
            (is_group_type(right) == yes) {
                out compatible(group_item_type(left), group_item_type(right))
            }
        }
        out no
    }

    skill present_type(type) {
        (type == "none") {
            out "unknown"
        }
        out type
    }

    skill type_text(type) {
        (type == "answer") {
            out "yes/no"
        }
        (is_box_type(type) == yes) {
            out str.concat("Box ", box_name(type))
        }
        (is_enum_type(type) == yes) {
            out str.concat("enum ", enum_name(type))
        }
        (is_group_type(type) == yes) {
            out str.concat("группа ", type_text(group_item_type(type)))
        }
        out type
    }

    skill integer_text(node) {
        @plain = nodes.plain(node)
        @tag = group.get(plain, 0)
        (tag == "number") {
            out num.text(group.get(plain, 1))
        }
        (tag == "wide-number") {
            out group.get(plain, 1)
        }
        (tag == "binary") {
            (group.get(plain, 1) == "-") {
                @left = nodes.plain(group.get(plain, 2))
                (group.get(left, 0) == "number") {
                    (group.get(left, 1) == 0) {
                        @right = nodes.tag(nodes.plain(group.get(plain, 3)))
                        (right == "number") {
                            out str.concat("-", integer_text(group.get(plain, 3)))
                        }
                        (right == "wide-number") {
                            out str.concat("-", integer_text(group.get(plain, 3)))
                        }
                    }
                }
            }
        }
        out ""
    }

    skill box_member(box_node, field_name) {
        @count = group.count(nodes.plain(box_node))
        (count < 2) {
            out []
        }
        drum (count - 2) {
            @member = nodes.part(box_node, count - 1 - beat)
            (nodes.tag(member) == "field") {
                (nodes.part(member, 1) == field_name) {
                    out member
                }
            }
        }
        out []
    }
}
