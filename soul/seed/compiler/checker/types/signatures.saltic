-- signatures — что принимает и отдаёт вызываемое: арность навыка, метода
-- Box, intrinsic и фиксированного типа; выведенные фиксированные типы
-- параметров и результатов (Q-001, Q-042) по проверенному дереву.

use core.str
use core.group
use compiler.nodes
use compiler.contract.intrinsic.contract
use compiler.report.meaning
use compiler.checker.names
use compiler.checker.names.paths
use compiler.checker.notes
use compiler.checker.rules.numbers
use compiler.checker.types
use compiler.checker.types.shapes

OUT_MARKER = "$out"
PACK = "pack:"
MIXED = "$mixed"
OTHER = "$other"

Signatures = Box {
    contract_ops = contract.Contract {},
    meaning_errors = meaning.Meaning {},
    node_ops = nodes.Nodes {},
    register = Names {},
    journal = Notes {},
    arithmetic = Numbers {},
    routes = Paths {},
    forms = Shapes {},
    typing = Types {}

    Signature = Box {
        found = no,
        name = "",
        minimum = 0,
        maximum = 0
    }

    skill exact_signature(name, count) {
        out Signature {
            found = yes,
            name = name,
            minimum = count,
            maximum = count
        }
    }

    skill spread(name, minimum, maximum) {
        out Signature {
            found = yes,
            name = name,
            minimum = minimum,
            maximum = maximum
        }
    }

    skill from_skill(name, node) {
        out exact_signature(name, group.count(node_ops.part(node, 2)))
    }

    skill intrinsic(name) {
        @kind = contract_ops.find(name)
        @minimum = contract_ops.minimum_arguments(kind)
        (minimum < 0) {
            out Signature {}
        }
        out spread(name, minimum, contract_ops.maximum_arguments(kind))
    }

    skill subject_signature(globals, box_name, skill_name) {
        @box = register.table_find(globals, box_name)
        ((box.kind == "box") == no) {
            out Signature {}
        }
        drum (group.count(node_ops.plain(box.node)) - 2) {
            @member = node_ops.part(box.node, beat + 2)
            (node_ops.tag(member) == "subject-skill") {
                (node_ops.part(member, 1) == skill_name) {
                    out from_skill("{box_name}.{skill_name}", member)
                }
            }
        }
        out Signature {}
    }

    skill resolve_signature(callee, scope, globals, receiver_type) {
        @plain = node_ops.plain(callee)
        @count = group.count(plain)
        @name = routes.call_name(plain, scope, globals)

        @builtin = intrinsic(name)
        (builtin.found == yes) {
            out builtin
        }

        (count == 2) {
            @short_name = group.get(plain, 1)
            (str.bytes(scope.subject) > 0) {
                @method = subject_signature(globals, scope.subject, short_name)
                (method.found == yes) {
                    out method
                }
            }
        }

        (count == 3) {
            (forms.is_box_type(receiver_type) == yes) {
                @box_name = forms.box_name(receiver_type)
                @method = subject_signature(globals, box_name, group.get(plain, 2))
                (method.found == yes) {
                    out method
                }
            }
        }

        @resolved = routes.resolve_path(callee, scope, globals)
        @global = register.table_find(globals, resolved)
        (global.kind == "skill") {
            out from_skill(resolved, global.node)
        }

        out Signature {}
    }

    Observed = Box {
        globals = [],
        calls = [],
        strict = no,
        changed = no
    }

    skill owner_name(owner, subject, module) {
        (str.bytes(subject) > 0) {
            @skill_name = node_ops.part(owner, 1)
            (node_ops.tag(owner) == "subject-skill") {
                out "{subject}.{skill_name}"
            }
            out ""
        }
        (node_ops.tag(owner) == "skill") {
            out node_ops.qualified(module, node_ops.part(owner, 1))
        }
        out ""
    }

    skill param_type(globals, owner, params, name) {
        drum (group.count(params)) {
            (group.get(params, beat) == name) {
                @found = register.table_find(globals, register.param_key(owner, beat))
                (forms.inferable(found.type) == yes) {
                    out found.type
                }
            }
        }
        out "unknown"
    }

    skill argument_mark(node, index, full, fixed_call, scope, globals) {
        @type = typing.value_type(node_ops.call_argument(node, index), scope, globals)
        @fixed = contract_ops.is_fixed_type(type)
        @callee = register.table_find(globals, routes.resolve_path(node_ops.call_callee(node), scope, globals))
        @method = typing.method_key(node_ops.call_callee(node), scope, globals)
        (str.bytes(method) > 0) {
            callee = Names.Name {
                name = method,
                kind = "skill"
            }
        }
        (callee.kind == "skill") {
            @param = register.table_find(globals, register.param_key(callee.name, index))
            (fixed == yes) {
                ((param.type == type) == no) {
                    out str.concat(PACK, type)
                }
            }
            (type == "unknown") {
                out ""
            }
            out type
        }
        (fixed_call == yes) {
            out type
        }
        (contract_ops.is_known(full) == yes) {
            out type
        }
        (fixed == yes) {
            out type
        }
        out ""
    }

    skill noted_call(seen, key, type, node) {
        (forms.inferable(type) == no) {
            out seen
        }
        (register.table_has(seen.globals, key) == yes) {
            out seen
        }
        seen.globals = register.table_put_node(seen.globals, key, "inferred", type, node)
        seen.changed = yes
        out seen
    }

    skill summary_of(old, type) {
        (str.bytes(old) == 0) {
            out type
        }
        (old == type) {
            out type
        }
        out MIXED
    }

    skill passed_calls(seen, key, argument) {
        @type = node_ops.type_of(argument)
        (str.starts_with(type, PACK) == yes) { type = str.slice(type, str.bytes(PACK), str.bytes(type)) }
        (forms.inferable(type) == no) {
            (seen.strict == no) {
                out seen
            }
            type = OTHER
        }
        @old = register.table_find(seen.calls, key)
        (str.bytes(old.name) > 0) {
            seen.calls = register.table_update(seen.calls, key, summary_of(old.type, type))
            out seen
        }
        seen.calls = register.table_put(seen.calls, key, "call", type)
        out seen
    }

    skill merged_calls(seen, key, type) {
        @found = register.table_find(seen.globals, key)
        @old = found.type
        @next = old
        pick {
            (type == OTHER) { (forms.inferable(old) == yes) { next = MIXED } }
            (type == MIXED) { next = MIXED }
            (str.bytes(found.name) == 0) { next = type }
            ((old == type) == no) { next = MIXED }
        }
        (next == old) {
            out seen
        }
        seen.changed = yes
        (str.bytes(found.name) > 0) {
            seen.globals = register.table_update(seen.globals, key, next)
            out seen
        }
        seen.globals = register.table_put(seen.globals, key, "inferred", next)
        seen.changed = yes
        out seen
    }

    skill observe_node(seen, node, owner, module) {
        @plain = node_ops.plain(node)
        @tag = group.get(plain, 0)
        (tag == "out") {
            (str.bytes(owner) > 0) { seen = noted_call(seen, register.result_key(owner), node_ops.type_of(group.get(plain, 1)), node) }
        }
        (tag == "call") {
            @module_scope = Names.Scope {
                module = module
            }
            @callee = routes.resolve_path(group.get(plain, 1), module_scope, seen.globals)
            @global = register.table_find(seen.globals, callee)
            @method = typing.method_key(group.get(plain, 1), module_scope, seen.globals)
            (str.bytes(method) > 0) {
                global = Names.Name {
                    name = method,
                    kind = "skill"
                }
            }
            (global.kind == "skill") {
                drum (node_ops.call_argument_count(node)) {
                    seen = passed_calls(seen, register.param_key(global.name, beat), node_ops.call_argument(node, beat))
                }
            }
        }
        drum (node_ops.children(node)) {
            seen = observe_node(seen, beat, owner, module)
        }
        out seen
    }

    skill observe_tree(tree, globals, strict) {
        @seen = Observed {
            globals = globals,
            strict = strict
        }
        drum (group.count(tree) - 1) {
            @item = group.get(tree, beat + 1)
            @module = node_ops.module_name(item)
            @tag = node_ops.tag(item)
            (tag == "skill") { seen = observe_node(seen, node_ops.part(item, 3), owner_name(item, "", module), module) }
            (tag == "entry") { seen = observe_node(seen, node_ops.part(item, 2), "", module) }
            (tag == "box") {
                drum (group.count(node_ops.plain(item)) - 2) {
                    @member = node_ops.part(item, beat + 2)
                    (node_ops.tag(member) == "subject-skill") { seen = observe_node(seen, node_ops.part(member, 3), owner_name(member, node_ops.qualified(module, node_ops.part(item, 1)), module), module) }
                }
            }
        }
        drum (seen.calls) {
            drum (beat) {
                seen = merged_calls(seen, beat.name, beat.type)
            }
        }
        out seen
    }

    skill check_call(node, full, scope, globals, diagnostics) {
        @callee = register.table_find(globals, routes.resolve_path(node_ops.call_callee(node), scope, globals))
        (callee.kind == "skill") {
            out diagnostics
        }
        (str.bytes(typing.method_key(node_ops.call_callee(node), scope, globals)) > 0) {
            out diagnostics
        }
        (callee.kind == "native") {
            @seed = contract_ops.find(full)
            @fraction = (contract_ops.result_for(seed, "unknown") == "fraction")
            (contract_ops.argument_type(seed, 0) == "fraction") { fraction = yes }
            (fraction == yes) {
                (register.table_has(globals, numbers.WIDE_MARK) == no) {
                    out journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.fraction_not_supported()))
                }
            }
            out diagnostics
        }
        drum (node_ops.call_argument_count(node)) {
            @argument = node_ops.call_argument(node, beat)
            diagnostics = arithmetic.check_fixed_escape(node, argument, "передать в '{full}'", scope, globals, diagnostics)
            (typing.value_type(argument, scope, globals) == "fraction") { diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.fraction_escape(full))) }
        }
        out diagnostics
    }

    skill check_out(node, value, scope, globals, diagnostics) {
        @expected = register.find_name(scope.names, OUT_MARKER)
        (str.bytes(expected.name) == 0) {
            out arithmetic.check_fixed_escape(node, value, "вернуть из навыка", scope, globals, diagnostics)
        }
        (forms.inferable(expected.type) == no) {
            out diagnostics
        }
        @actual = typing.value_type(value, scope, globals)
        (actual == expected.type) {
            out diagnostics
        }
        (actual == "error") {
            out diagnostics
        }
        out journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.result_type_mismatch(expected.type, forms.type_text(actual))))
    }

    skill check_ending(owner, full, body, globals, diagnostics) {
        @result = register.table_find(globals, register.result_key(full))
        (forms.inferable(result.type) == no) {
            out diagnostics
        }
        @plain = node_ops.plain(body)
        @count = group.count(plain)
        (count > 1) {
            (node_ops.tag(group.get(plain, count - 1)) == "out") {
                out diagnostics
            }
        }
        out journal.add_diagnostic(diagnostics, journal.placed(owner, meaning_errors.result_falls_through(full, result.type)))
    }
}
