-- bodies — второй проход: тела навыков и методов обходятся, пока
-- signatures что-то меняет в выведенных типах; проходов конечно.

use core.str
use core.group
use compiler.nodes
use compiler.report
use compiler.report.errors
use compiler.contract.abi.call
use compiler.checker.names
use compiler.checker.notes
use compiler.checker.passes
use compiler.checker.types
use compiler.checker.types.shapes
use compiler.checker.types.signatures
use compiler.checker.walk

Bodies = Box {
    register = Names {},
    journal = Notes {},
    passing = Passes {},
    forms = Shapes {},
    signing = Signatures {},
    typing = Types {},
    walker = Walk {}

    skill inspect(program_ast, path, wide) {
        @base = passing.collect(program_ast, path, wide)
        @result = check_bodies(program_ast, path, base)
        @strict = no
        drum (group.count(program_ast) * (call.ARGUMENT_LIMIT + 1) * 2 + 2) {
            @seen = signing.observe_tree(result.tree, result.globals, strict)
            (seen.changed == no) {
                (strict == yes) { leave }
                strict = yes
            }
            (seen.changed == yes) {
                base.globals = seen.globals
                result = check_bodies(program_ast, path, base)
            }
        }
        out result
    }

    skill check_bodies(program_ast, path, base) {
        @result = Passes.Result {
            diagnostics = base.diagnostics,
            globals = base.globals
        }
        @tree = [group.get(program_ast, 0)]
        drum (group.count(program_ast) - 1) {
            @item = group.get(program_ast, beat + 1)
            @tag = nodes.tag(item)
            @module = nodes.module_name(item)
            @first = group.count(result.diagnostics)
            @checked_item = item
            (tag == "const") {
                @value_scope = Names.Scope {
                    module = module
                }
                @value_walked = walker.check_expression(nodes.part(item, 2), value_scope, result.globals, result.diagnostics)
                result.diagnostics = value_walked.diagnostics
                checked_item = nodes.with_part(item, 2, value_walked.node)
            }
            (tag == "skill") {
                @body_walked = walker.check_params(item, nodes.part(item, 2), result.globals, "", module, nodes.part(item, 3), result.diagnostics)
                result.diagnostics = signing.check_ending(item, signing.owner_name(item, "", module), nodes.part(item, 3), result.globals, body_walked.diagnostics)
                checked_item = nodes.with_part(item, 3, body_walked.node)
            }
            (tag == "entry") {
                @body_walked = walker.check_params(item, nodes.part(item, 1), result.globals, "", module, nodes.part(item, 2), result.diagnostics)
                result.diagnostics = body_walked.diagnostics
                checked_item = nodes.with_part(item, 2, body_walked.node)
            }
            (tag == "box") {
                @seen_fields = []
                @seen_skills = []
                drum (group.count(nodes.plain(item)) - 2) {
                    @member = nodes.part(item, beat + 2)
                    @member_tag = nodes.tag(member)
                    (member_tag == "field") {
                        @field_name = nodes.part(member, 1)
                        @field_value = nodes.part(member, 2)
                        (register.has_name(seen_fields, field_name) == yes) {
                            @box_name = nodes.part(item, 1)
                            result.diagnostics = journal.add_diagnostic(result.diagnostics, journal.placed(field_value, errors.duplicate_field(field_name, box_name)))
                        }
                        seen_fields = register.put_name(seen_fields, field_name, "field", "unknown")
                        @default_scope = Names.Scope {
                            module = module
                        }
                        @default_walked = walker.check_expression(field_value, default_scope, result.globals, result.diagnostics)
                        result.diagnostics = default_walked.diagnostics
                        @default_type = typing.value_type(field_value, default_scope, result.globals)
                        checked_item = nodes.with_part(checked_item, beat + 2, nodes.with_part(member, 2, forms.fixed_marked(default_type, default_walked.node)))
                    }
                    (member_tag == "subject-skill") {
                        @skill_name = nodes.part(member, 1)
                        (register.has_name(seen_skills, skill_name) == yes) {
                            @box_name = nodes.part(item, 1)
                            result.diagnostics = journal.add_diagnostic(result.diagnostics, journal.placed(member, errors.duplicate_box_skill(skill_name, box_name)))
                        }
                        seen_skills = register.put_name(seen_skills, skill_name, "skill", "function")
                        @subject = nodes.qualified(module, nodes.part(item, 1))
                        @method_walked = walker.check_params(member, nodes.part(member, 2), result.globals, subject, module, nodes.part(member, 3), result.diagnostics)
                        result.diagnostics = signing.check_ending(member, signing.owner_name(member, subject, module), nodes.part(member, 3), result.globals, method_walked.diagnostics)
                        checked_item = nodes.with_part(checked_item, beat + 2, nodes.with_part(member, 3, method_walked.node))
                    }
                }
            }
            result.diagnostics = report.in_module(result.diagnostics, first, passing.source(module, path))
            tree = group.add(tree, checked_item)
        }
        result.tree = tree
        out result
    }
}
