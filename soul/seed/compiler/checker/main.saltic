-- checker — публичное лицо проверки дерева: вход для toolchain и вопрос
-- компилятора (есть ли у Box навык). Работа — у детей: passes, walk,
-- types, names, rules, notes.

use io
use compiler.checker.names
use compiler.checker.passes.bodies
use compiler.checker.types

Checker = Box {
    passes = Bodies {},
    register = Names {},
    typing = Types {}

    skill check(ast) {
        out passes.inspect(ast, "", no)
    }

    skill check_file(ast, path) {
        out passes.inspect(ast, path, no)
    }

    skill check_wide(ast, path) {
        out passes.inspect(ast, path, yes)
    }

    skill check_for(ast, path, wide) {
        out passes.inspect(ast, path, wide)
    }

    skill box_has_skill(boxes, box_name, skill_name) {
        @box = register.find_name(boxes, box_name)
        out typing.box_node_has_skill(box.node, skill_name)
    }
}
