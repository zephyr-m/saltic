-- bindings — обход @имя =, присваивания, поле =, out и выражения-инструкции.

use core.str
use core.group
use compiler.nodes
use compiler.report.meaning
use compiler.contract.intrinsic.contract
use compiler.checker.names
use compiler.checker.names.paths
use compiler.checker.notes
use compiler.checker.rules.cycles
use compiler.checker.rules
use compiler.checker.rules.numbers
use compiler.checker.types
use compiler.checker.types.shapes
use compiler.checker.types.signatures
use compiler.checker.walk
use compiler.checker.walk.values

Bindings = Box {
    meaning_errors = meaning.Meaning {},
    node_ops = nodes.Nodes {},
    register = Names {},
    routes = Paths {},
    journal = Notes {},
    forms = Shapes {},
    typing = Types {},
    signing = Signatures {},
    arithmetic = Numbers {},
    law = Rules {},
    knots = Cycles {}

    skill walk_node(tag, node, plain, scope, globals, diagnostics) {
        (tag == "var") {
            out walk_var(node, plain, scope, globals, diagnostics)
        }
        (tag == "assign") {
            out walk_assign(node, plain, scope, globals, diagnostics)
        }
        (tag == "field-assign") {
            out walk_field_assign(node, plain, scope, globals, diagnostics)
        }
        (tag == "out") {
            out walk_out(node, plain, scope, globals, diagnostics)
        }
        (tag == "expr") {
            out walk_expr(node, plain, scope, globals, diagnostics)
        }
        out none
    }

    skill walk_var(node, plain, scope, globals, diagnostics) {
        @walker = walking()
        @name = group.get(plain, 1)
        @value = group.get(plain, 2)
        @value_walked = walker.check_expression(value, scope, globals, diagnostics)
        diagnostics = value_walked.diagnostics
        @value_type = typing.value_type(value, scope, globals)
        @current = node_ops.with_part(node, 2, node_ops.typed(value_type, value_walked.node))
        (register.has_name(scope.names, name) == yes) { diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.duplicate_variable(name))) }
        (register.has_name(scope.names, name) == no) {
            (routes.visible(globals, scope.module, name) == yes) {
                diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.variable_shadows_global(name)))
            }
            (routes.visible(globals, scope.module, name) == no) {
                diagnostics = routes.check_module_name(node, name, scope.module, globals, diagnostics)
                scope.names = register.put_name(scope.names, name, "variable", value_type)
            }
        }
        out journal.walked(current, diagnostics)
    }

    skill walk_assign(node, plain, scope, globals, diagnostics) {
        @walker = walking()
        @name = group.get(plain, 1)
        @value = group.get(plain, 2)
        @value_walked = walker.check_expression(value, scope, globals, diagnostics)
        diagnostics = value_walked.diagnostics
        @value_type = typing.value_type(value, scope, globals)
        @current = node_ops.with_part(node, 2, node_ops.typed(value_type, value_walked.node))
        (register.has_name(scope.names, name) == yes) {
            @old = register.find_name(scope.names, name)
            (forms.compatible(old.type, value_type) == yes) { scope.names = register.update_name(scope.names, name, forms.merge_types(old.type, value_type)) }
            (forms.compatible(old.type, value_type) == no) {
                @value_name = forms.type_text(value_type)
                @old_name = forms.type_text(old.type)
                diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.variable_type_mismatch(value_name, name, old_name)))
            }
            @always_problem = law.always_assign(scope.names, name, value_type)
            (always_problem.is_ok() == no) { diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, always_problem)) }
        }
        (register.has_name(scope.names, name) == no) {
            @global = routes.find_visible(globals, scope.module, name)
            @is_constant = no
            (global.kind == "const") { is_constant = yes }
            (global.kind == "const") { diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.constant_assignment(name))) }
            (str.bytes(global.name) > 0) {
                (is_constant == no) {
                    diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.assign_to_global(name)))
                }
            }
            (str.bytes(global.name) == 0) { diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.variable_not_declared(name))) }
        }
        out journal.walked(current, diagnostics)
    }

    skill walk_field_assign(node, plain, scope, globals, diagnostics) {
        @walker = walking()
        @target = node_ops.plain(group.get(plain, 1))
        @part_count = group.count(target)
        @base_parts = ["path"]
        drum (part_count - 2) {
            base_parts = group.add(base_parts, group.get(target, beat + 1))
        }
        @valuing_part = valuing()
        diagnostics = journal.issues_of(valuing_part.check_path(node_ops.rebuild(group.get(plain, 1), base_parts), scope, globals, diagnostics))
        @value = group.get(plain, 2)
        @value_walked = walker.check_expression(value, scope, globals, diagnostics)
        diagnostics = value_walked.diagnostics
        @current = node_ops.with_part(node, 2, forms.fixed_marked(typing.value_type(value, scope, globals), value_walked.node))
        @base_type = typing.path_type(base_parts, scope, globals)
        (forms.is_box_type(base_type) == yes) {
            @box_name = forms.box_name(base_type)
            @field_name = group.get(target, part_count - 1)
            @field = typing.box_field(globals, box_name, field_name)
            (str.bytes(field.name) == 0) {
                diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.unknown_field(box_name, field_name)))
            }
            (str.bytes(field.name) > 0) {
                @value_type = forms.stored(typing.value_type(value, scope, globals))
                (forms.compatible(field.type, value_type) == no) {
                    @value_name = forms.type_text(value_type)
                    diagnostics = journal.add_diagnostic(diagnostics, journal.placed(node, meaning_errors.field_type_mismatch(value_name, field_name, box_name, forms.type_text(field.type))))
                }
            }
        }
        out journal.walked(current, diagnostics)
    }

    skill walk_out(node, plain, scope, globals, diagnostics) {
        @walker = walking()
        diagnostics = signing.check_out(node, group.get(plain, 1), scope, globals, diagnostics)
        @value_walked = walker.check_expression(group.get(plain, 1), scope, globals, diagnostics)
        @out_type = typing.value_type(group.get(plain, 1), scope, globals)
        out journal.walked(node_ops.with_part(node, 1, node_ops.typed(out_type, value_walked.node)), value_walked.diagnostics)
    }

    skill walk_expr(node, plain, scope, globals, diagnostics) {
        @walker = walking()
        @value_walked = walker.check_expression(group.get(plain, 1), scope, globals, diagnostics)
        out journal.walked(node_ops.with_part(node, 1, value_walked.node), value_walked.diagnostics)
    }

    skill valuing() {
        out Values {
            register = register,
            routes = routes,
            journal = journal,
            forms = forms,
            typing = typing,
            signing = signing,
            arithmetic = arithmetic,
            law = law,
            knots = knots
        }
    }

    skill walking() {
        out Walk {
            register = register,
            routes = routes,
            journal = journal,
            forms = forms,
            typing = typing,
            signing = signing,
            arithmetic = arithmetic,
            law = law,
            knots = knots
        }
    }
}
