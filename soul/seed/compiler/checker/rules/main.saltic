-- rules — правила вызова и циклов: число и тип аргументов, что считает drum,
-- что нельзя присвоить внешней переменной в always.

use core.str
use compiler.nodes
use compiler.contract.intrinsic.contract
use compiler.report
use compiler.report.laws
use core.group
use compiler.contract.abi.call
use compiler.checker.types.shapes

ALWAYS_MARKER = "$always"

Rules = Box {
    contract_ops = contract.Contract {},
    law_errors = laws.Laws {},
    forms = Shapes {}

    skill arity_rule(signature, actual) {
        (actual > call.ARGUMENT_LIMIT) {
            out law_errors.too_many_arguments(call.ARGUMENT_LIMIT)
        }
        (signature.found == no) {
            out report.ok()
        }
        (actual < signature.minimum) {
            out law_errors.too_few_arguments(signature.name, signature.minimum, actual)
        }
        (actual > signature.maximum) {
            out law_errors.too_many_for_skill(signature.name, signature.maximum, actual)
        }
        out report.ok()
    }

    skill argument_rule(name, index, expected, actual) {
        @unknown_fixed = no
        (actual == "unknown") { unknown_fixed = contract_ops.is_fixed_type(expected) }
        (unknown_fixed == no) {
            (forms.compatible(expected, actual) == yes) {
                out report.ok()
            }
        }
        @expected_text = forms.type_text(expected)
        (expected == "group:unknown") { expected_text = "группа" }
        @actual_text = forms.type_text(actual)
        @position = index + 1
        out law_errors.argument_type_mismatch(name, position, actual_text, expected_text)
    }

    skill drum_count(type) {
        (type == "number") {
            out report.ok()
        }
        (type == "unknown") {
            out report.ok()
        }
        (forms.is_group_type(type) == yes) {
            out report.ok()
        }
        out law_errors.drum_type(type)
    }

    skill always_assign(scope_names, name, type) {
        @declared = -1
        @marker = -1
        drum (group.count(scope_names)) {
            @item = group.get(scope_names, beat)
            (item.name == ALWAYS_MARKER) { marker = beat }
            (item.name == name) {
                (declared < 0) { declared = beat }
            }
        }
        (marker < 0) {
            out report.ok()
        }
        (declared > marker) {
            out report.ok()
        }
        @memory = forms.is_box_type(type)
        (type == "string") { memory = yes }
        (str.starts_with(type, "group") == yes) { memory = yes }
        (memory == no) {
            out report.ok()
        }
        out law_errors.always_outer_value(forms.type_text(type), name)
    }
}
