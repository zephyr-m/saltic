-- architect — первая ступень сборки (architect → parser → checker → billet):
-- главный файл и все его use -> одно дерево. Зона и законы — README.md рядом.
--
-- Путь модуля — по углам (21.11.2026): soul/seed/, потом soul/, потом root.
-- Два корня (решение автора 17.11.2026):
-- root — проект (его модули и tarantul/), дом Saltic — переменная окружения
-- HOME_VARIABLE (core, io, os, registry…); модуля нет в проекте — берётся из
-- дома; без переменной — один root, как прежде. Узлы модуля обёрнуты ast.in_module;
-- entry (program) берётся только из корневого файла; повторный use
-- пропускается, и use по кругу тоже (решение автора 21.11.2026: модули — граф,
-- не дерево; файл уже в пути — он уже подгружается); вложенные Box и enum
-- поднимаются наверх (parser.nest).
-- use a.b ищет a/b.saltic, иначе a/b/main.saltic (20.11.2026). Законы пока —
-- советы, не ошибки (21.11.2026): «один способ» — файл и папка того же имени
-- рядом — module_doubled; одно имя в двух углах — module_shadowed; told печатает.
--
-- Architect = Box { root, locations, eyes } — корень проекта, ставить ли узлам
--     место, eyes — Reader для склейки групп:
--     Load — Box { ast, included, diagnostics, advice } — итог; advice — советы
--     gather(path) -> Load — программа из файла и всех его use
--     told(load) — печатает советы итога, по строке на совет
--     expand(path, included, stack, module_name, place) -> Load; place =
--         [строка, столбец] узла use, которым файл подключён ([0, 0] у корня)
--     join_path(base, relative) -> путь; module_path(parts, under) -> путь к
--         файлу модуля от корня under; corners(under) -> углы поиска; home() -> дом Saltic из HOME_VARIABLE или "";
--         located(parts) -> путь модуля: в проекте, а если там нет и дом задан —
--         в доме; entrance(parts, under) -> файл модуля или main.saltic его папки;
--         found(path) -> yes, если файл читается; failure(path, problem,
--         included, place) -> Load с одной ошибкой; MAIN — имя входа папки;
--         doubled(path) -> yes, если рядом с файлом папка того же имени;
--         modules_in(folder) -> имена модулей папки; shadowed(path) -> о тени

use io
use io.file
use core.str
use core.group
use core.process
use compiler.ast
use compiler.diagnostic
use compiler.errors
use compiler.parser.syntax
use compiler.parser.syntax.reader
use compiler.parser.nest

HOME_VARIABLE = "SALTIC_HOME"
MAIN = "main"
SEED = "soul/seed"
SOUL = "soul"

Architect = Box {
    root = ".",
    locations = no,
    eyes = Reader {}

    Load = Box {
        ast = [],
        included = [],
        diagnostics = [],
        advice = []
    }

    skill join_path(base, relative) {
        (str.ends_with(base, "/") == yes) {
            out str.concat(base, relative)
        }
        out "{base}/{relative}"
    }

    skill module_path(parts, under) {
        out join_path(under, str.concat(str.join(parts, "/"), ".saltic"))
    }

    skill corners(under) {
        out [
            join_path(under, SEED),
            join_path(under, SOUL),
            under
        ]
    }

    skill home() {
        @head = "{HOME_VARIABLE}="
        drum (process.environment()) {
            (str.starts_with(beat, head) == yes) {
                out str.slice(beat, str.bytes(head), str.bytes(beat))
            }
        }
        out ""
    }

    skill found(path) {
        file.read(path) rescue |err| {
            out no
        }
        out yes
    }

    skill entrance(parts, under) {
        drum (corners(under)) {
            @single = module_path(parts, beat)
            (found(single) == yes) {
                out single
            }
            @inside = module_path(group.add(parts, MAIN), beat)
            (found(inside) == yes) {
                out inside
            }
        }
        out module_path(parts, under)
    }

    skill located(parts) {
        @here = entrance(parts, root)
        @other = home()
        (str.bytes(other) == 0) {
            out here
        }
        (other == root) {
            out here
        }
        (found(here) == yes) {
            out here
        }
        out entrance(parts, other)
    }

    skill doubled(path) {
        @folder = str.slice(path, 0, str.bytes(path) - str.bytes(".saltic"))
        file.list(folder) rescue |err| {
            out no
        }
        out yes
    }

    skill modules_in(folder) {
        @found_names = []
        @entries = file.list(folder) rescue |err| {
            out []
        }
        drum (entries) {
            (str.ends_with(beat, ".saltic") == yes) {
                found_names = group.add(found_names, str.slice(beat, 0, str.bytes(beat) - str.bytes(".saltic")))
            }
            (str.contains(beat, ".") == no) {
                found_names = group.add(found_names, beat)
            }
        }
        out found_names
    }

    skill shadowed(path) {
        @advice = []
        @seen = []
        drum (corners(root)) {
            @corner = beat
            drum (modules_in(corner)) {
                (group.contains(seen, beat) == yes) {
                    advice = group.add(advice, diagnostic.place(errors.module_shadowed(beat, corner), path, 0, 0))
                }
                seen = group.add(seen, beat)
            }
        }
        out advice
    }

    skill failure(path, problem, included, place) {
        out Load {
            ast = ["program"],
            included = included,
            diagnostics = [diagnostic.place(problem, path, group.get(place, 0), group.get(place, 1))]
        }
    }

    skill expand(path, included, stack, module_name, place) {
        @name = path
        (str.bytes(module_name) > 0) {
            name = "{module_name} ({path})"
        }
        @importer = path
        (group.count(stack) > 0) {
            importer = group.get(stack, group.count(stack) - 1)
        }
        (group.contains(included, path) == yes) {
            out Load {
                ast = ["program"],
                included = included,
                diagnostics = []
            }
        }
        @next_included = group.add(included, path)
        @source = file.read(path) rescue |error| {
            out failure(importer, errors.module_not_found(name), next_included, place)
        }
        @advice = []
        (doubled(path) == yes) {
            advice = [diagnostic.place(errors.module_doubled(name), importer, group.get(place, 0), group.get(place, 1))]
        }
        @reading = Syntax {
            path = path,
            locations = locations
        }
        @parsed = reading.parse(source)
        (group.count(parsed.diagnostics) > 0) {
            out Load {
                ast = ["program"],
                included = next_included,
                diagnostics = parsed.diagnostics
            }
        }
        @output = ["program"]
        @next_stack = group.add(stack, path)
        @diagnostics = []
        drum (group.count(parsed.ast) - 1) {
            @item = group.get(parsed.ast, beat + 1)
            @plain = ast.plain(item)
            @include_item = yes
            (group.get(plain, 0) == "entry") {
                (group.count(stack) > 0) {
                    include_item = no
                }
            }
            (include_item == yes) {
                @folded = Nest {}
                drum (folded.lift(item, "")) {
                    @output_item = beat
                    (str.bytes(module_name) > 0) {
                        output_item = ast.in_module(module_name, beat)
                    }
                    output = group.add(output, output_item)
                }
            }
            (group.get(plain, 0) == "use") {
                @parts = eyes.append_tail([], plain, 1)
                @module_file = located(parts)
                @loaded = expand(module_file, next_included, next_stack, str.join(parts, "."), ast.location(item))
                next_included = loaded.included
                advice = group.concat(advice, loaded.advice)
                (group.count(loaded.diagnostics) > 0) {
                    diagnostics = loaded.diagnostics
                    leave
                }
                output = eyes.append_tail(output, loaded.ast, 1)
            }
        }
        out Load {
            ast = output,
            included = next_included,
            diagnostics = diagnostics,
            advice = advice
        }
    }

    skill gather(path) {
        @load = expand(path, [], [], "", [0, 0])
        out Load {
            ast = load.ast,
            included = load.included,
            diagnostics = load.diagnostics,
            advice = group.concat(shadowed(path), load.advice)
        }
    }

    skill told(load) {
        drum (load.advice) {
            io.show("архитектор советует: {beat.message}")
        }
        out none
    }
}
