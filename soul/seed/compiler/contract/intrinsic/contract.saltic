-- contract — единый вход к таблице intrinsic для чекера и компилятора:
-- склеивает общую таблицу с особенностями памяти (memory) и фиксированных
-- типов (fixed). input_type — тип первого аргумента вызова.
--
-- find(name) -> Kind; is_known(name) -> answer
-- minimum_arguments / maximum_arguments(kind) -> число
-- result_for(kind, input_type) -> тип результата (загрузка по address даёт u8/u16/u32)
-- target_for(kind, input_type) -> имя rt_* или ""
-- conversion(kind) -> "u8"… для U8_FROM… или ""
-- store_type(kind, input_type) -> ожидаемый тип значения для store по address
-- is_fixed_type(type) / fixed_kind(type) / fixed_in_range(type, text, wide) / fixed_range_text(type, wide)
-- is_fixed_call(kind) / is_show(kind) / is_memory(kind) -> answer
-- argument_type(kind, index) -> ожидаемый тип или "unknown"
-- checked_argument(kind) -> номер аргумента bits32-операции или -1; checked_type(kind) -> его тип

use compiler.contract.intrinsic
use compiler.contract.intrinsic.fixed
use compiler.contract.intrinsic.memory

Contract = Box {
    memory_intrinsics = memory.MemoryIntrinsics {},
    fixed_intrinsics = fixed.FixedIntrinsics {},
    intrinsics = intrinsic.Intrinsics {}

    skill find(name) {
        out intrinsics.find(name)
    }

    skill is_known(name) {
        out (find(name) == intrinsic.Kind.UNKNOWN) == no
    }

    skill minimum_arguments(kind) {
        out intrinsics.minimum_arguments(kind)
    }

    skill maximum_arguments(kind) {
        out intrinsics.maximum_arguments(kind)
    }

    skill result_for(kind, input_type) {
        (memory_intrinsics.is_load(kind) == yes) {
            out memory_intrinsics.load_type(kind, input_type)
        }
        out intrinsics.result(kind)
    }

    skill target_for(kind, input_type) {
        @target_name = memory_intrinsics.target_for(kind, input_type)
        ((target_name == "") == no) {
            out target_name
        }
        target_name = fixed_intrinsics.target(kind)
        ((target_name == "") == no) {
            out target_name
        }
        out intrinsics.target(kind)
    }

    skill conversion(kind) {
        out fixed_intrinsics.conversion(kind)
    }

    skill store_type(kind, input_type) {
        out memory_intrinsics.store_type(kind, input_type)
    }

    skill is_fixed_type(type) {
        out fixed_intrinsics.is_type(type)
    }

    skill fixed_kind(type) {
        out fixed_intrinsics.kind(type)
    }

    skill fixed_in_range(type, text, wide) {
        out fixed_intrinsics.in_range(type, text, wide)
    }

    skill fixed_range_text(type, wide) {
        out fixed_intrinsics.range_text(type, wide)
    }

    skill is_fixed_call(kind) {
        out fixed_intrinsics.is_call(kind)
    }

    skill is_show(kind) {
        out kind == intrinsic.Kind.IO_SHOW
    }

    skill is_memory(kind) {
        (memory_intrinsics.is_load(kind) == yes) {
            out yes
        }
        out memory_intrinsics.is_store(kind)
    }

    skill argument_type(kind, index) {
        out intrinsics.argument_type(kind, index)
    }

    skill checked_argument(kind) {
        out fixed_intrinsics.checked_argument(kind)
    }

    skill checked_type(kind) {
        out fixed_intrinsics.checked_type(kind)
    }
}
