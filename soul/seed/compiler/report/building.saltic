-- building — тексты ошибок сборки: модули архитектора, метки и кодировка горна, дальние вызовы toolchain.
--
-- Каждый навык отдаёт Diagnostic без места; место приписывает вызывающий (report.placed).
--
-- Building:
--     module_not_found / module_doubled / module_shadowed / unresolved_call / missing_label /
--     encoding_failed / near_calls_failed / far_calls_failed

use compiler.report

Building = Box {
    skill module_not_found(name) {
        out report.found("module_not_found", "модули: модуль не найден: {name}")
    }

    skill module_doubled(name) {
        out report.found("module_doubled", "модуль {name} записан двумя способами — файл и папка того же имени рядом; перенеси файл в папку как main.saltic")
    }

    skill module_shadowed(name, corner) {
        out report.found("module_shadowed", "имя {name} есть и в {corner}, и в углу поиска раньше него; use всегда возьмёт раннее, а это останется в тени — переименуй одно")
    }

    skill unresolved_call(call, function) {
        out report.found("unresolved_call", "компилятор: не найден навык для вызова '{call}' в '{function}'")
    }

    skill missing_label(label) {
        out report.found("missing_label", "layout: нет метки {label}")
    }

    skill encoding_failed(count) {
        out report.found("encoding_failed", "layout: не удалось закодировать инструкций: {count}")
    }

    skill near_calls_failed() {
        out report.found("near_calls_failed", "toolchain: ближние ссылки не разрешились, собираю с дальними вызовами")
    }

    skill far_calls_failed() {
        out report.found("far_calls_failed", "toolchain: ссылки не разрешились и с дальними вызовами")
    }
}
