-- writing — тексты ошибок записи: лексер и парсер. EXPECTED: [код, «чего ждали»] для unexpected_token(code, got).
--
-- Каждый навык отдаёт Diagnostic без места; место приписывает вызывающий (report.placed).
--
-- Writing:
--     unterminated_string / text_after_open / text_left_of_close / unterminated_escape /
--     template_expects_name / lone_closing_brace / unexpected_symbol / comment_outside_header /
--     unexpected_token / call_field / comparison_needs_parens / links_mixed / trailing_comma /
--     bad_template_name

use core.group
use compiler.report

EXPECTED = [
    ["expected_open_brace", "ожидалась \{"],
    ["expected_close_brace", "ожидалась \}"],
    ["expected_close_paren", "ожидалась )"],
    ["expected_pipe", "ожидался |"],
    ["expected_skill_name", "ожидалось имя skill"],
    ["expected_expression", "ожидалось выражение"],
    ["expected_statement", "ожидалась инструкция"],
    ["expected_open_paren", "ожидалась ("],
    ["expected_separator", "ожидался разделитель"],
    ["expected_field_equals", "ожидался = после имени поля"],
    ["expected_variable_equals", "ожидался = после имени переменной"],
    ["expected_identifier", "ожидался идентификатор"],
    ["expected_closing_token", "ожидался закрывающий токен"],
    ["expected_pick_branch", "ожидался вариант pick: (условие) \{ \} или \{ \}"],
    ["expected_enum_variant", "ожидался вариант enum"],
    ["expected_arrow", "ожидался =>"],
    ["expected_equals", "ожидался ="],
    ["expected_field_or_skill", "ожидалось поле или skill"],
    ["expected_declaration", "ожидалось объявление верхнего уровня"],
    ["expected_field_name", "ожидалось имя поля"],
    ["expected_variable_name", "ожидалось имя переменной"],
    ["expected_parameter_name", "ожидалось имя параметра"],
    ["expected_rescue_name", "ожидалось имя ошибки rescue"],
    ["expected_present_name", "ожидалось имя значения: (выражение) |имя| и блок"],
    ["expected_enum_value", "ожидалось значение enum"],
    ["expected_program_paren", "ожидалась ( после program"],
    ["expected_pick_close", "ожидалась \} после pick"],
    ["expected_pick_open", "ожидалась \{ после pick"],
    ["expected_drum_paren", "ожидалась ( после drum"],
    ["expected_case_label", "ожидалась метка ветки выбора"],
    ["expected_dot", "ожидалась ."],
    ["field_trailing_comma", "запятая ставится только между полями, после последнего поля её нет"],
    ["missing_field_comma", "между полями нужна запятая"]
]

Writing = Box {
    skill unterminated_string() {
        out report.found("unterminated_string", "незавершённая строка: \"…\" закрывается на той же строке, закрывающий # — один на своей строке")
    }

    skill text_after_open() {
        out report.found("text_after_open", "после открывающего # — только конец строки, текст начинается со следующей")
    }

    skill text_left_of_close() {
        out report.found("text_left_of_close", "строка текста левее закрывающего #: отступ снимается по нему")
    }

    skill unterminated_escape() {
        out report.found("unterminated_escape", "незавершённая escape-последовательность")
    }

    skill template_expects_name() {
        out report.found("template_expects_name", "в подстановке ожидалось имя: \{имя\} или \{имя.поле\}")
    }

    skill lone_closing_brace() {
        out report.found("lone_closing_brace", "одиночная \} в строке: пиши \\\}")
    }

    skill unexpected_symbol(ch) {
        out report.found("unexpected_symbol", "неожиданный символ {ch}")
    }

    skill comment_outside_header() {
        out report.found("comment_outside_header", "комментарий -- разрешён только в начале файла, до кода")
    }

    skill unexpected_token(code, got) {
        drum (EXPECTED) {
            (group.get(beat, 0) == code) {
                @text = group.get(beat, 1)
                out report.found(code, "{text}, получено: {got}")
            }
        }
        out report.found("unexpected_token", "{code}, получено: {got}")
    }

    skill field_called() {
        out report.found("call_field", "поле у результата вызова не берётся: положи результат в переменную — @x = f(), потом x.поле")
    }

    skill comparison_needs_parens(sign) {
        out report.found("comparison_needs_parens", "сравнение '{sign}' — в свои скобки: (a {sign} b); порядок в языке только скобками")
    }

    skill links_mixed() {
        out report.found("links_mixed", "○ и ○○ в одном ряду не смешиваются — поставь скобки: ((a) ○ (b)) ○○ (c)")
    }

    skill trailing_comma() {
        out report.found("trailing_comma", "запятая ставится только между элементами, после последнего её нет")
    }

    skill bad_template_name(part) {
        out report.found("bad_template_name", "неверное имя в подстановке: {part}")
    }
}
