-- naming — тексты ошибок имён: пространства, Box, занятые имена, длинные пути.
--
-- Каждый навык отдаёт Diagnostic без места; место приписывает вызывающий (report.placed).
--
-- Naming:
--     unknown_namespace / unknown_box / ambiguous_part / name_taken_by_module / name_taken_by_root /
--     long_reference / long_call

use compiler.report

Naming = Box {
    skill unknown_namespace(name) {
        out report.found("unknown_namespace", "неизвестное пространство имён '{name}'")
    }

    skill unknown_box(name) {
        out report.found("unknown_box", "неизвестный Box '{name}'")
    }

    skill ambiguous_part(name) {
        out report.found("ambiguous_part", "'{name}' — часть нескольких хозяев этого модуля: пиши полное имя Хозяин.{name}")
    }

    skill name_taken_by_module(name, target) {
        out report.found("name_taken_by_module", "имя '{name}' занято модулем '{target}': назови переменную иначе")
    }

    skill name_taken_by_root(name) {
        out report.found("name_taken_by_root", "имя '{name}' — корень модулей ({name}.…): назови переменную иначе")
    }

    skill long_reference(text, module, short) {
        out report.found("long_reference", "длинный путь '{text}': подключи 'use {module}' и пиши '{short}'")
    }

    skill call_too_long(full, module, short) {
        out report.found("long_call", "длинный путь вызова '{full}': подключи 'use {module}' и пиши '{short}'")
    }
}
