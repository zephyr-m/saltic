-- declarations — тексты ошибок объявлений: повторы, program, арность методов.
--
-- Каждый навык отдаёт Diagnostic без места; место приписывает вызывающий (report.placed).
--
-- Declarations:
--     duplicate_alias / duplicate_program / duplicate_global / duplicate_field / duplicate_box_skill /
--     duplicate_enum_variant / missing_program / method_arity

use compiler.report

Declarations = Box {
    skill duplicate_alias(alias) {
        out report.found("duplicate_alias", "повторный псевдоним модуля '{alias}'")
    }

    skill duplicate_program() {
        out report.found("duplicate_program", "повторное объявление program")
    }

    skill duplicate_global(name) {
        out report.found("duplicate_global", "повторное имя верхнего уровня '{name}'")
    }

    skill duplicate_field(field_name, box_name) {
        out report.found("duplicate_field", "повторное поле '{field_name}' в Box '{box_name}'")
    }

    skill duplicate_box_skill(skill_name, box_name) {
        out report.found("duplicate_box_skill", "повторный skill '{skill_name}' в Box '{box_name}'")
    }

    skill duplicate_enum_variant(variant) {
        out report.found("duplicate_enum_variant", "вариант '{variant}' уже есть в этом enum")
    }

    skill missing_program() {
        out report.found("missing_program", "объявление program обязательно")
    }

    skill method_arity(method, box_name, count, other) {
        out report.found("method_arity", "метод '{method}' у {box_name} берёт {count}, а у другого Box — {other}: у метода одного имени одна арность")
    }
}
