-- meaning — тексты ошибок смысла: имена, поля, типы, присваивания, выбор, барабан.
--
-- Каждый навык отдаёт Diagnostic без места; место приписывает вызывающий (report.placed).
--
-- Meaning:
--     duplicate_literal_field / duplicate_param / unknown_name / enum_lacks_variant / maybe_none /
--     field_on_non_box / unknown_field / fraction_not_supported / number_out_of_range /
--     fixed_integer_out_of_range / store_type_mismatch / fixed_argument_type_mismatch /
--     field_type_mismatch / duplicate_variable / variable_shadows_global / variable_type_mismatch /
--     constant_assignment / assign_to_global / variable_not_declared / pick_branch_not_condition /
--     pick_default_not_last / leave_outside_drum / duplicate_switch_case / unknown_enum_variant /
--     negate_expects_number / expression_without_effect / case_bare_value / switch_incomplete /
--     condition_type / short_enum_outside_match / ambiguous_enum_case / enum_type_mismatch /
--     unknown_statement / operator_expects_numbers / template_type / address_arithmetic /
--     bits32_operator / fixed_remainder / fraction_escape / result_type_mismatch /
--     fraction_text_module / result_falls_through

use compiler.report

Meaning = Box {
    skill duplicate_literal_field(field_name, name) {
        out report.found("duplicate_literal_field", "повторное поле '{field_name}' в литерале Box '{name}'")
    }

    skill duplicate_param(item) {
        out report.found("duplicate_param", "повторный параметр '{item}'")
    }

    skill unknown_name(name) {
        out report.found("unknown_name", "неизвестное имя '{name}'")
    }

    skill enum_lacks_variant(enum_name, variant) {
        out report.found("enum_lacks_variant", "в enum '{enum_name}' нет варианта '{variant}'")
    }

    skill maybe_none(path) {
        out report.found("maybe_none", "'{path}' может быть пустым (none) — сначала проверь: ({path}) |имя| и блок")
    }

    skill field_on_non_box(field_name, type_name) {
        out report.found("field_on_non_box", "нельзя обратиться к полю '{field_name}' у {type_name}")
    }

    skill unknown_field(box_name, field_name) {
        out report.found("unknown_field", "в Box '{box_name}' нет поля '{field_name}'")
    }

    skill fraction_not_supported() {
        out report.found("fraction_not_supported", "дробные — только на 64-битных целях (RV64, x86-64)")
    }

    skill number_out_of_range() {
        out report.found("number_out_of_range", "обычное число не помещается в непосредственное значение; используй фиксированный целый тип")
    }

    skill fixed_integer_out_of_range(text, full, range) {
        out report.found("fixed_integer_out_of_range", "значение {text} не помещается в {full}: допустимо {range}")
    }

    skill store_type_mismatch(full, expected, actual) {
        out report.found("store_type_mismatch", "{full} ожидает значение {expected}, получено {actual}")
    }

    skill fixed_argument_type_mismatch(full, expected_text, actual) {
        out report.found("fixed_argument_type_mismatch", "{full} ожидает {expected_text}, получено {actual}")
    }

    skill field_type_mismatch(value_name, field_name, name, field_type) {
        out report.found("field_type_mismatch", "нельзя присвоить {value_name} полю '{field_name}' Box '{name}' типа {field_type}")
    }

    skill duplicate_variable(name) {
        out report.found("duplicate_variable", "переменная '{name}' уже объявлена в этой области")
    }

    skill variable_shadows_global(name) {
        out report.found("variable_shadows_global", "переменная '{name}' конфликтует с именем верхнего уровня")
    }

    skill variable_type_mismatch(value_name, name, old_name) {
        out report.found("variable_type_mismatch", "нельзя присвоить {value_name} переменной '{name}' типа {old_name}")
    }

    skill constant_assignment(name) {
        out report.found("constant_assignment", "нельзя присвоить значение константе '{name}'")
    }

    skill assign_to_global(name) {
        out report.found("assign_to_global", "нельзя присвоить значение имени верхнего уровня '{name}'")
    }

    skill variable_not_declared(name) {
        out report.found("variable_not_declared", "переменная '{name}' не объявлена")
    }

    skill pick_branch_not_condition() {
        out report.found("pick_branch_not_condition", "вариант pick должен быть условием, а не выбором по enum")
    }

    skill pick_default_not_last() {
        out report.found("pick_default_not_last", "блок без условия в pick должен быть последним")
    }

    skill leave_outside_drum() {
        out report.found("leave_outside_drum", "leave допустим только внутри drum или always")
    }

    skill duplicate_switch_case(variant_name) {
        out report.found("duplicate_switch_case", "повторная ветка enum '{variant_name}'")
    }

    skill unknown_enum_variant(variant_name) {
        out report.found("unknown_enum_variant", "неизвестный вариант enum '{variant_name}'")
    }

    skill negate_expects_number(type) {
        out report.found("negate_expects_number", "унарный минус — у числа, дробного или фиксированного, а здесь {type}")
    }

    skill expression_without_effect() {
        out report.found("expression_without_effect", "выражение без действия: значение на своей строке выбрасывается (минус в начале строки — это -x, а не продолжение)")
    }

    skill case_bare_value() {
        out report.found("case_bare_value", "в ветке => — действие (вызов, присваивание, out) или блок; голое значение выбрасывается")
    }

    skill switch_incomplete(missing) {
        out report.found("switch_incomplete", "сопоставление перечисляет не все варианты: нет {missing}; ничего не делать — \{ \}")
    }

    skill condition_type(type) {
        out report.found("condition_type", "в условии — только yes/no, а здесь {type}")
    }

    skill short_enum_outside_match(variant) {
        out report.found("short_enum_outside_match", "короткое .{variant} — только в ветках сопоставления; здесь пиши Enum.{variant}")
    }

    skill ambiguous_enum_case(variant) {
        out report.found("ambiguous_enum_case", "вариант '{variant}' есть у нескольких enum, а тип значения неизвестен")
    }

    skill enum_type_mismatch(variant_name, owner_name, subject_name) {
        out report.found("enum_type_mismatch", "вариант '{variant_name}' принадлежит {owner_name}, а выбирается {subject_name}")
    }

    skill unknown_statement(tag) {
        out report.found("unknown_statement", "неподдерживаемая инструкция {tag}")
    }

    skill operator_expects_numbers(operator, left_name, right_name) {
        out report.found("operator_expects_numbers", "оператор '{operator}' ожидает числа, получено {left_name} и {right_name}")
    }

    skill template_type(placeholder, type) {
        out report.found("template_type", "в строку можно подставить только текст, число (и фиксированное), yes/no или ошибку, а '{placeholder}' — {type}")
    }

    skill address_arithmetic() {
        out report.found("address_arithmetic", "для арифметики адресов используй address.add(address, usize)")
    }

    skill bits32_operator(operator) {
        out report.found("bits32_operator", "операция '{operator}' недоступна для bits32: используй операции core.bits32")
    }

    skill fixed_remainder(type) {
        out report.found("fixed_remainder", "операция '%' — только для обычных чисел, а здесь {type}")
    }

    skill fraction_escape(full) {
        out report.found("fraction_escape", "дробное нельзя передать в '{full}': навык выбирается во время работы, тип дробного теряется — дай хозяину известный Box")
    }

    skill result_type_mismatch(expected, actual) {
        out report.found("result_type_mismatch", "навык отдаёт {expected} (по другому out), а здесь — {actual}")
    }

    skill fraction_text_module() {
        out report.found("fraction_text_module", "показ дробного в \{…\} — подключи use core.fraction")
    }

    skill result_falls_through(name, type) {
        out report.found("result_falls_through", "{name} отдаёт {type}: тело должно кончаться out")
    }
}
