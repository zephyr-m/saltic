-- laws — тексты ошибок правил: аргументы, дробные, fixed, циклы, звенья.
--
-- Каждый навык отдаёт Diagnostic без места; место приписывает вызывающий (report.placed).
--
-- Laws:
--     always_outer_value / operator_mixes_number / operator_mixes_fixed / too_many_arguments /
--     too_few_arguments / too_many_for_skill / fixed_fraction / fixed_wrong_value /
--     argument_type_mismatch / cycle_reference / fixed_escape / fixed_unknown_partner / fraction_mixes
--     / fraction_equality / fraction_remainder / near_expects_fractions / drum_type /
--     link_expects_answer

use compiler.report

Laws = Box {
    skill always_outer_value(type_name, name) {
        out report.found("always_outer_value", "в always нельзя присвоить {type_name} внешней переменной '{name}' — память оборота убирается; объяви её внутри always или положи в поле Box")
    }

    skill operator_mixes_number(operator, fixed_type) {
        out report.found("operator_mixes_number", "операция '{operator}' не может смешивать {fixed_type} и number")
    }

    skill operator_mixes_fixed(operator, left_type, right_type) {
        out report.found("operator_mixes_fixed", "операция '{operator}' требует одинаковые фиксированные целые типы: получены {left_type} и {right_type}")
    }

    skill too_many_arguments(limit) {
        out report.found("too_many_arguments", "вызов не может содержать больше {limit} аргументов")
    }

    skill too_few_arguments(name, minimum, actual) {
        out report.found("too_few_arguments", "вызов '{name}' ожидает {minimum}, получено {actual}")
    }

    skill too_many_for_skill(name, maximum, actual) {
        out report.found("too_many_for_skill", "вызов '{name}' допускает не больше {maximum}, получено {actual}")
    }

    skill fixed_fraction() {
        out report.found("fixed_fraction", "фиксированный целый тип не принимает дробное значение")
    }

    skill fixed_wrong_value(type) {
        out report.found("fixed_wrong_value", "фиксированный целый тип не принимает {type}")
    }

    skill argument_type_mismatch(name, position, actual, expected) {
        out report.found("argument_type_mismatch", "{name}: аргумент {position} — {actual}, ожидается {expected}")
    }

    skill cycle_reference(owner, field, value) {
        out report.found("cycle_reference", "запись {owner}.{field} = {value} замыкает цикл ссылок: '{owner}' достижим из '{value}' — храни номер, а не объект")
    }

    skill fixed_escape(type, place) {
        out report.found("fixed_escape", "{type} нельзя {place}: там фиксированный тип теряется")
    }

    skill fixed_unknown_partner(operator, type) {
        out report.found("fixed_unknown_partner", "операция '{operator}': {type} рядом со значением неизвестного типа — тип неизвестен, сделай {type}.from(…)")
    }

    skill fraction_mixes(operator, other) {
        out report.found("fraction_mixes", "операция '{operator}': дробное и {other} вместе нельзя — сделай fraction.from(…)")
    }

    skill fraction_equality() {
        out report.found("fraction_equality", "== у дробных нельзя: ~= (точность NEAR) или fraction.near(a, b, eps)")
    }

    skill fraction_remainder() {
        out report.found("fraction_remainder", "операция '%' — только для целых, у дробных её нет")
    }

    skill near_expects_fractions(left, right) {
        out report.found("near_expects_fractions", "~= — только для двух дробных, получено {left} и {right}")
    }

    skill drum_type(type) {
        out report.found("drum_type", "drum ожидает число или группу, получено {type}")
    }

    skill link_expects_answer(type) {
        out report.found("link_expects_answer", "○ и ○○ сцепляют только yes/no, а здесь {type}")
    }
}
