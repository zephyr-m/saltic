-- report — сообщение об ошибке с кодом и местом в исходнике.
-- Выводится toolchain как «код|строка|столбец|сообщение»; путь файла и имя
-- модуля приписываются к тексту сообщения, а не хранятся отдельно.
-- Тексты ошибок — у детей по этапам: writing, declarations, naming, meaning,
-- laws, building.
--
-- Diagnostic = Box { code, message, line, col }
--     is_ok() -> answer: пустой код — ошибки нет
--     placed_at(path, at_line, at_col) -> Diagnostic с местом и «path: » в тексте
-- Report:
--     with_module(items, first, module) -> группа, где к items[first…] приписан модуль
--     has(items) -> answer
-- make(code, line, col, message) / make_at(code, path, line, col, message) -> Diagnostic
-- found(code, message) -> Diagnostic без места; ok() -> пустая

use core.str
use core.group

Diagnostic = Box {
    code = "language_error",
    message = "",
    line = 0,
    col = 0

    skill is_ok() {
        out (str.bytes(code) == 0)
    }

    skill placed_at(path, at_line, at_col) {
        out make_at(code, path, at_line, at_col, message)
    }
}

Report = Box {
    skill with_module(items, first, module) {
        (str.bytes(module) == 0) {
            out items
        }
        @result = []
        drum (group.count(items)) {
            @item = group.get(items, beat)
            (beat >= first) {
                item.message = "{module}: {item.message}"
            }
            result = group.add(result, item)
        }
        out result
    }

    skill has(items) {
        out (group.count(items) > 0)
    }
}

skill make(code, line, col, message) {
    out Diagnostic {
        code = code,
        message = message,
        line = line,
        col = col
    }
}

skill make_at(code, path, line, col, message) {
    @text = message
    (str.bytes(path) > 0) {
        text = "{path}: {message}"
    }
    out make(code, line, col, text)
}

skill found(code, message) {
    out make(code, 0, 0, message)
}

skill ok() {
    out found("", "")
}
