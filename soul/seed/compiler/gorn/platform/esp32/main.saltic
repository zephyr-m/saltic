-- platform — голое железо ESP32-D0WD. Вход ставит стек, гасит сторожей
-- TIMG0 и RTC, переводит ядро с кварца 40 МГц на PLL 160 МГц (CPU_PER_CONF = 1,
-- CLK_CONF: источник PLL; RTC — по адресу AHB), шина APB — 80 МГц, делитель
-- UART0 на 115200 от неё, печатает «S» —
-- платформа жива, обнуляет BSS. write пишет FIFO UART0. Свободной DRAM около
-- 180 КБ на всё: ARENA_BYTES и HEAP_BYTES — арена и куча по умолчанию.
-- exit крутится на месте. now — 28-битный счётчик тактов ядра числом Saltic.

use compiler.contract.abi
use compiler.gorn.backend
use compiler.gorn.platform
use compiler.gorn.backend.xtensa.lx6.asm

ARENA_BYTES = 16384
HEAP_BYTES = 65536

MISSING = ["key", "file_read", "file_write", "file_write_program", "firmware", "call", "process_pipe", "process_wait", "process_read", "process_close", "process_executable", "environment", "file_list", "process_open", "process_input", "process_write", "log_open", "read_line", "stack"]

Esp32 = Box {
    platform_ops = platform.Platform {},
    name = "esp32",
    arena_bytes = ARENA_BYTES,
    default_heap_bytes = HEAP_BYTES

    skill append(billet) {
        @e = billet.executor
        billet = e.label(billet, "platform_start")
        billet = e.load_immediate(billet, backend.STACK, stack_top())
        billet = unlock(billet, timg_prot(), timg_cfg())
        billet = unlock(billet, rtc_prot(), rtc_cfg())
        billet = e.load_immediate(billet, backend.SCRATCH0, cpu_per_conf())
        billet = e.load_immediate(billet, backend.SCRATCH1, 1)
        billet = e.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = e.load_immediate(billet, backend.SCRATCH0, clk_conf())
        billet = e.load_immediate(billet, backend.SCRATCH1, clk_pll())
        billet = e.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = e.load_immediate(billet, backend.SCRATCH0, uart_clk())
        billet = e.load_immediate(billet, backend.SCRATCH1, uart_div())
        billet = e.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = putc(billet, "s", 83)
        billet = putc(billet, "n", 10)
        billet = e.load_address(billet, backend.VALUE, asm.BSS_START, 0)
        billet = e.load_address(billet, backend.ERROR, asm.BSS_SIZE, 0)
        billet = e.label(billet, ".L_xt_zero")
        billet = e.branch_zero(billet, backend.ERROR, ".L_xt_zero_done")
        billet = e.store_zero(billet, backend.VALUE, 0)
        billet = e.add_immediate(billet, backend.VALUE, backend.VALUE, 4)
        billet = e.add_immediate(billet, backend.ERROR, backend.ERROR, 0 - 4)
        billet = e.jump(billet, ".L_xt_zero")
        billet = e.label(billet, ".L_xt_zero_done")
        billet = e.add_immediate(billet, backend.STACK, backend.STACK, 0 - 16)
        billet = e.load_immediate(billet, backend.SCRATCH0, 1)
        billet = e.store(billet, backend.SCRATCH0, backend.STACK, 0)
        billet = e.load_address(billet, backend.SCRATCH0, "xt_argv0", 0)
        billet = e.store(billet, backend.SCRATCH0, backend.STACK, 4)
        billet = e.store_zero(billet, backend.STACK, 8)
        billet = e.store_zero(billet, backend.STACK, 12)
        billet = e.jump(billet, "_start")
        billet = e.data_label(billet, backend.RODATA, "xt_argv0")
        billet = e.data_text(billet, backend.RODATA, "saltic")
        billet = write_loop(billet)
        billet = e.label(billet, "rt_platform_exit")
        billet = e.label(billet, ".L_xt_hang")
        billet = e.jump(billet, ".L_xt_hang")
        billet = e.label(billet, platform.WAIT)
        billet = e.wait(billet)
        billet = e.load_immediate(billet, backend.VALUE, abi.NONE)
        billet = e.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
        billet = e.ret(billet)
        billet = e.label(billet, platform.NOW)
        billet = e.read_cycles(billet)
        billet = e.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        billet = e.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
        billet = e.ret(billet)
        billet = platform_ops.append_heap_reserve(billet)
        drum (MISSING) { billet = platform_ops.emit_unsupported(billet, beat) }
        out billet
    }

    skill pack(b0, b1, b2, b3) {
        out b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    }

    skill stack_top() {
        out pack(0, 224, 253, 63)
    }
    skill timg_prot() {
        out pack(100, 240, 245, 63)
    }
    skill timg_cfg() {
        out pack(72, 240, 245, 63)
    }
    skill rtc_prot() {
        out pack(164, 128, 244, 63)
    }
    skill rtc_cfg() {
        out pack(140, 128, 244, 63)
    }
    skill wdt_key() {
        out pack(161, 58, 216, 80)
    }
    skill uart_status() {
        out pack(28, 0, 244, 63)
    }
    skill uart_fifo() {
        out pack(0, 0, 244, 63)
    }
    skill uart_clk() {
        out pack(20, 0, 244, 63)
    }
    skill uart_div() {
        out pack(182, 2, 112, 0)
    }
    skill cpu_per_conf() {
        out pack(60, 0, 240, 63)
    }
    skill clk_conf() {
        out pack(112, 128, 0, 96)
    }
    skill clk_pll() {
        out pack(16, 50, 0, 8)
    }

    skill putc(billet, mark, byte) {
        @e = billet.executor
        @wait = ".L_xt_putc_{mark}"
        billet = e.label(billet, wait)
        billet = e.load_immediate(billet, backend.SCRATCH0, uart_status())
        billet = e.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = e.shift_right_unsigned(billet, backend.SCRATCH1, backend.SCRATCH1, 16)
        billet = e.and_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 128)
        billet = e.branch_nonzero(billet, backend.SCRATCH1, wait)
        billet = e.load_immediate(billet, backend.SCRATCH1, byte)
        billet = e.load_immediate(billet, backend.SCRATCH0, uart_fifo())
        out e.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
    }

    skill unlock(billet, prot, cfg) {
        @e = billet.executor
        billet = e.load_immediate(billet, backend.SCRATCH0, prot)
        billet = e.load_immediate(billet, backend.SCRATCH1, wdt_key())
        billet = e.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = e.load_immediate(billet, backend.SCRATCH0, cfg)
        billet = e.load_immediate(billet, backend.SCRATCH1, 0)
        out e.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
    }

    skill write_loop(billet) {
        @e = billet.executor
        billet = e.label(billet, "rt_platform_write")
        billet = e.move(billet, backend.SCRATCH2, backend.ARG2)
        billet = e.label(billet, ".L_xt_write")
        billet = e.branch_zero(billet, backend.ARG2, ".L_xt_write_done")
        billet = e.label(billet, ".L_xt_wait")
        billet = e.load_immediate(billet, backend.SCRATCH0, uart_status())
        billet = e.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = e.shift_right_unsigned(billet, backend.SCRATCH1, backend.SCRATCH1, 16)
        billet = e.and_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 128)
        billet = e.branch_nonzero(billet, backend.SCRATCH1, ".L_xt_wait")
        billet = e.load_byte(billet, backend.SCRATCH1, backend.ERROR, 0)
        billet = e.load_immediate(billet, backend.SCRATCH0, uart_fifo())
        billet = e.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = e.add_immediate(billet, backend.ERROR, backend.ERROR, 1)
        billet = e.add_immediate(billet, backend.ARG2, backend.ARG2, 0 - 1)
        billet = e.jump(billet, ".L_xt_write")
        billet = e.label(billet, ".L_xt_write_done")
        billet = e.move(billet, backend.VALUE, backend.SCRATCH2)
        billet = e.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
        out e.ret(billet)
    }
}
