-- socket — rt_platform_socket_*: сокет, memfd и запись в него.
-- Аргументы в VALUE, ERROR, ARG2, ARG3. Результат — число с тегом,
-- как его вернул системный вызов (0 и выше, либо -errno).
-- send и place на 4-байтном слове отвечают -1: msghdr и lseek+write
-- собраны для слова в 8 байт.
--
-- append(billet) — все девять меток

use compiler.contract.abi
use core.system
use compiler.gorn.backend
use compiler.gorn.backend.runtime.tails

SEEK_SET = 0
SEND_FRAME = 17
PLACE_FRAME = 5
SAVE_FD = 96
SAVE_PTR = 104
SAVE_LEN = 112
SAVE_ATTACHED = 120
MSG_IOV = 16
MSG_IOVLEN = 24
MSG_CONTROL = 32
MSG_CONTROLLEN = 40
IOV = 56
IOV_LEN = 64
CMSG_LEN = 72
CMSG_LEVEL = 80
CMSG_TYPE = 84
CMSG_FD = 88

Socket = Box {
    skill number(billet, to, from) {
        @executor = billet.executor
        out executor.shift_right_signed(billet, to, from, abi.TAG_SHIFT)
    }

    skill tag_number(billet) {
        @executor = billet.executor
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        out executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_NUMBER)
    }

    skill enter(billet, frame) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * frame)
        out executor.store(billet, backend.RETURN, backend.STACK, words.bytes * (frame - 1))
    }

    skill finish_socket(billet, frame) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * (frame - 1))
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * frame)
        out executor.ret(billet)
    }

    skill refuse(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        billet = executor.load_immediate(billet, backend.VALUE, -1)
        billet = tag_number(billet)
        out endings.succeeded(billet)
    }

    skill emit_open(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        billet = executor.label(billet, "rt_platform_socket_open")
        billet = number(billet, backend.VALUE, backend.VALUE)
        billet = number(billet, backend.ERROR, backend.ERROR)
        billet = number(billet, backend.ARG2, backend.ARG2)
        billet = executor.syscall(billet, system.SYSCALL_SOCKET)
        billet = tag_number(billet)
        out endings.succeeded(billet)
    }

    skill emit_connect(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_platform_socket_connect")
        billet = number(billet, backend.VALUE, backend.VALUE)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.ERROR, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.ARG2, backend.SCRATCH0, words.payload)
        billet = executor.add_immediate(billet, backend.ERROR, backend.SCRATCH0, words.payload + words.string_data)
        billet = executor.syscall(billet, system.SYSCALL_CONNECT)
        billet = tag_number(billet)
        out endings.succeeded(billet)
    }

    skill emit_write(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_platform_socket_write")
        billet = number(billet, backend.VALUE, backend.VALUE)
        billet = number(billet, backend.ARG2, backend.ARG2)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.ERROR, abi.PAYLOAD_MASK)
        billet = executor.add_immediate(billet, backend.ERROR, backend.SCRATCH0, words.payload + words.string_data)
        billet = executor.syscall(billet, system.SYSCALL_WRITE)
        billet = tag_number(billet)
        out endings.succeeded(billet)
    }

    skill emit_read(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_platform_socket_read")
        billet = number(billet, backend.VALUE, backend.VALUE)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.ERROR, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.ARG2, backend.SCRATCH0, words.payload)
        billet = executor.add_immediate(billet, backend.ERROR, backend.SCRATCH0, words.payload + words.string_data)
        billet = executor.syscall(billet, system.SYSCALL_READ)
        billet = tag_number(billet)
        out endings.succeeded(billet)
    }

    skill emit_close(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        billet = executor.label(billet, "rt_platform_socket_close")
        billet = number(billet, backend.VALUE, backend.VALUE)
        billet = executor.syscall(billet, system.SYSCALL_CLOSE)
        billet = tag_number(billet)
        out endings.succeeded(billet)
    }

    skill emit_memory(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_platform_socket_memory")
        billet = number(billet, backend.ERROR, backend.ERROR)
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.add_immediate(billet, backend.VALUE, backend.VALUE, words.payload + words.string_data)
        billet = executor.syscall(billet, system.SYSCALL_MEMFD)
        billet = tag_number(billet)
        out endings.succeeded(billet)
    }

    skill emit_resize(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        billet = executor.label(billet, "rt_platform_socket_resize")
        billet = number(billet, backend.VALUE, backend.VALUE)
        billet = number(billet, backend.ERROR, backend.ERROR)
        billet = executor.syscall(billet, system.SYSCALL_FTRUNCATE)
        billet = tag_number(billet)
        out endings.succeeded(billet)
    }

    skill emit_send(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_platform_socket_send")
        (words.bytes == 8) {
            billet = enter(billet, SEND_FRAME)
            billet = number(billet, backend.VALUE, backend.VALUE)
            billet = executor.store(billet, backend.VALUE, backend.STACK, SAVE_FD)
            billet = number(billet, backend.ARG2, backend.ARG2)
            billet = executor.store(billet, backend.ARG2, backend.STACK, SAVE_LEN)
            billet = number(billet, backend.ARG3, backend.ARG3)
            billet = executor.store(billet, backend.ARG3, backend.STACK, SAVE_ATTACHED)
            billet = executor.and_immediate(billet, backend.SCRATCH0, backend.ERROR, abi.PAYLOAD_MASK)
            billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, words.payload + words.string_data)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, SAVE_PTR)
            billet = executor.store_zero(billet, backend.STACK, 0)
            billet = executor.store_zero(billet, backend.STACK, 8)
            billet = executor.store_zero(billet, backend.STACK, MSG_IOV)
            billet = executor.store_zero(billet, backend.STACK, MSG_IOVLEN)
            billet = executor.store_zero(billet, backend.STACK, MSG_CONTROL)
            billet = executor.store_zero(billet, backend.STACK, MSG_CONTROLLEN)
            billet = executor.store_zero(billet, backend.STACK, 48)
            billet = executor.store_zero(billet, backend.STACK, IOV)
            billet = executor.store_zero(billet, backend.STACK, IOV_LEN)
            billet = executor.store_zero(billet, backend.STACK, CMSG_LEN)
            billet = executor.store_zero(billet, backend.STACK, CMSG_LEVEL)
            billet = executor.store_zero(billet, backend.STACK, CMSG_FD)
            billet = executor.load(billet, backend.SCRATCH0, backend.STACK, SAVE_PTR)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, IOV)
            billet = executor.load(billet, backend.SCRATCH0, backend.STACK, SAVE_LEN)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, IOV_LEN)
            billet = executor.add_immediate(billet, backend.SCRATCH0, backend.STACK, IOV)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, MSG_IOV)
            billet = executor.load_immediate(billet, backend.SCRATCH0, 1)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, MSG_IOVLEN)
            billet = executor.add_immediate(billet, backend.SCRATCH0, backend.STACK, CMSG_LEN)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, MSG_CONTROL)
            billet = executor.load_immediate(billet, backend.SCRATCH0, 24)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, MSG_CONTROLLEN)
            billet = executor.load_immediate(billet, backend.SCRATCH0, 20)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, CMSG_LEN)
            billet = executor.load_immediate(billet, backend.SCRATCH0, 1)
            billet = executor.store32(billet, backend.SCRATCH0, backend.STACK, CMSG_LEVEL)
            billet = executor.store32(billet, backend.SCRATCH0, backend.STACK, CMSG_TYPE)
            billet = executor.load(billet, backend.SCRATCH0, backend.STACK, SAVE_ATTACHED)
            billet = executor.store32(billet, backend.SCRATCH0, backend.STACK, CMSG_FD)
            billet = executor.load(billet, backend.VALUE, backend.STACK, SAVE_FD)
            billet = executor.move(billet, backend.ERROR, backend.STACK)
            billet = executor.load_immediate(billet, backend.ARG2, 0)
            billet = executor.syscall(billet, system.SYSCALL_SENDMSG)
            billet = tag_number(billet)
            out finish_socket(billet, SEND_FRAME)
        }
        out refuse(billet)
    }

    skill emit_place(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_platform_socket_place")
        (words.bytes == 8) {
            billet = enter(billet, PLACE_FRAME)
            billet = number(billet, backend.VALUE, backend.VALUE)
            billet = executor.store(billet, backend.VALUE, backend.STACK, 0)
            billet = number(billet, backend.ARG2, backend.ARG2)
            billet = executor.store(billet, backend.ARG2, backend.STACK, words.bytes * 3)
            billet = executor.and_immediate(billet, backend.SCRATCH0, backend.ERROR, abi.PAYLOAD_MASK)
            billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
            billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes * 2)
            billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, words.payload + words.string_data)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes)
            billet = executor.load(billet, backend.VALUE, backend.STACK, 0)
            billet = executor.load(billet, backend.ERROR, backend.STACK, words.bytes * 3)
            billet = executor.load_immediate(billet, backend.ARG2, SEEK_SET)
            billet = executor.syscall(billet, system.SYSCALL_LSEEK)
            billet = executor.branch_negative(billet, backend.VALUE, ".L_socket_place_done")
            billet = executor.load(billet, backend.VALUE, backend.STACK, 0)
            billet = executor.load(billet, backend.ERROR, backend.STACK, words.bytes)
            billet = executor.load(billet, backend.ARG2, backend.STACK, words.bytes * 2)
            billet = executor.syscall(billet, system.SYSCALL_WRITE)
            billet = executor.label(billet, ".L_socket_place_done")
            billet = tag_number(billet)
            out finish_socket(billet, PLACE_FRAME)
        }
        out refuse(billet)
    }

    skill emit_sleep(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_platform_socket_sleep")
        (words.bytes == 8) {
            billet = enter(billet, 3)
            billet = number(billet, backend.SCRATCH0, backend.VALUE)
            billet = executor.load_immediate(billet, backend.SCRATCH1, 1000)
            billet = executor.divide_unsigned(billet, backend.SCRATCH2, backend.SCRATCH0, backend.SCRATCH1)
            billet = executor.remainder_unsigned(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH1)
            billet = executor.load_immediate(billet, backend.SCRATCH1, 1000000)
            billet = executor.multiply(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH1)
            billet = executor.store(billet, backend.SCRATCH2, backend.STACK, 0)
            billet = executor.store(billet, backend.SCRATCH0, backend.STACK, 8)
            billet = executor.move(billet, backend.VALUE, backend.STACK)
            billet = executor.load_immediate(billet, backend.ERROR, 0)
            billet = executor.syscall(billet, system.SYSCALL_NANOSLEEP)
            billet = tag_number(billet)
            out finish_socket(billet, 3)
        }
        out refuse(billet)
    }

    skill emit_map(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        billet = executor.label(billet, "rt_platform_socket_map")
        (billet.words.bytes == 8) {
            billet = number(billet, backend.SCRATCH0, backend.VALUE)
            billet = number(billet, backend.ERROR, backend.ERROR)
            billet = executor.load_immediate(billet, backend.VALUE, 0)
            billet = executor.load_immediate(billet, backend.ARG2, 3)
            billet = executor.load_immediate(billet, backend.ARG3, 65)
            billet = executor.move(billet, backend.ARG4, backend.SCRATCH0)
            billet = executor.load_immediate(billet, backend.ARG5, 0)
            billet = executor.syscall(billet, system.SYSCALL_MMAP)
            billet = tag_number(billet)
            out endings.succeeded(billet)
        }
        out refuse(billet)
    }

    skill append(billet) {
        billet = emit_open(billet)
        billet = emit_connect(billet)
        billet = emit_write(billet)
        billet = emit_read(billet)
        billet = emit_close(billet)
        billet = emit_memory(billet)
        billet = emit_resize(billet)
        billet = emit_send(billet)
        billet = emit_place(billet)
        billet = emit_sleep(billet)
        out emit_map(billet)
    }
}
