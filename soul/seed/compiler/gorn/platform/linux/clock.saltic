-- clock — часы Linux: rt_platform_now (core.time.now) -> миллисекунды от
-- полуночи UTC, 0…86 399 999 (влезает в число и на 4-байтном слове).
-- clock_gettime(CLOCK_REALTIME) кладёт timespec { секунды, наносекунды } по
-- 8 байт в кадр на стеке. На 8-байтном слове — remu / mul / divu исполнителя;
-- на rv32i деления нет: остаток от суток — сдвиговым делением младшего слова
-- секунд (без знака, хватит до 2106 года), наносекунды в миллисекунды —
-- вычитанием по миллиону, умножение на 1000 — сдвигами (1024 − 16 − 8).
--
-- emit_now(billet) — метка rt_platform_now; emit_wide / emit_narrow — счёт,
--     finish — число с тегом в VALUE и возврат

use core.system
use compiler.contract.abi
use compiler.gorn.backend
use compiler.gorn.platform
use compiler.gorn.backend.runtime.tails

CLOCK_REALTIME = 0
FRAME_BYTES = 16
NANOSECONDS_OFFSET = 8
DAY_SECONDS = 86400
MILLISECOND = 1000
MILLION = 1000000

skill emit_now(billet) {
    @executor = billet.executor
    billet = executor.label(billet, platform.NOW)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -FRAME_BYTES)
    billet = executor.load_immediate(billet, backend.VALUE, CLOCK_REALTIME)
    billet = executor.move(billet, backend.ERROR, backend.STACK)
    billet = executor.syscall(billet, system.SYSCALL_CLOCK_GETTIME)
    billet = executor.load(billet, backend.SCRATCH0, backend.STACK, 0)
    billet = executor.load(billet, backend.SCRATCH1, backend.STACK, NANOSECONDS_OFFSET)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, FRAME_BYTES)
    (billet.words.bytes == 8) { out finish(emit_wide(billet)) }
    out finish(emit_narrow(billet))
}

skill finish(billet) {
    @endings = tails.Tails {}
    @executor = billet.executor
    billet = executor.shift_left(billet, backend.VALUE, backend.SCRATCH0, abi.TAG_SHIFT)
    out endings.succeeded(billet)
}

skill emit_wide(billet) {
    @executor = billet.executor
    billet = executor.load_immediate(billet, backend.SCRATCH2, DAY_SECONDS)
    billet = executor.remainder_unsigned(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH2)
    billet = executor.load_immediate(billet, backend.SCRATCH2, MILLISECOND)
    billet = executor.multiply(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH2)
    billet = executor.load_immediate(billet, backend.SCRATCH2, MILLION)
    billet = executor.divide_unsigned(billet, backend.SCRATCH1, backend.SCRATCH1, backend.SCRATCH2)
    out executor.add(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH1)
}

skill emit_narrow(billet) {
    @executor = billet.executor
    billet = executor.load_immediate(billet, backend.SCRATCH2, 0)
    billet = executor.load_immediate(billet, backend.SCRATCH3, abi.VALUE_WORD_BITS)
    billet = executor.load_immediate(billet, backend.SCRATCH4, DAY_SECONDS)
    billet = executor.label(billet, ".L_now_day")
    billet = executor.shift_right_unsigned(billet, backend.SCRATCH5, backend.SCRATCH0, abi.VALUE_WORD_BITS - 1)
    billet = executor.shift_left(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
    billet = executor.or(billet, backend.SCRATCH2, backend.SCRATCH2, backend.SCRATCH5)
    billet = executor.shift_left(billet, backend.SCRATCH0, backend.SCRATCH0, 1)
    billet = executor.branch_less_unsigned(billet, backend.SCRATCH2, backend.SCRATCH4, ".L_now_day_next")
    billet = executor.sub(billet, backend.SCRATCH2, backend.SCRATCH2, backend.SCRATCH4)
    billet = executor.label(billet, ".L_now_day_next")
    billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, -1)
    billet = executor.branch_nonzero(billet, backend.SCRATCH3, ".L_now_day")
    billet = executor.shift_left(billet, backend.SCRATCH0, backend.SCRATCH2, 10)
    billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH2, 4)
    billet = executor.sub(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH3)
    billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH2, 3)
    billet = executor.sub(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH3)
    billet = executor.load_immediate(billet, backend.SCRATCH4, MILLION)
    billet = executor.label(billet, ".L_now_milli")
    billet = executor.branch_less_unsigned(billet, backend.SCRATCH1, backend.SCRATCH4, ".L_now_done")
    billet = executor.sub(billet, backend.SCRATCH1, backend.SCRATCH1, backend.SCRATCH4)
    billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, 1)
    billet = executor.jump(billet, ".L_now_milli")
    out executor.label(billet, ".L_now_done")
}
