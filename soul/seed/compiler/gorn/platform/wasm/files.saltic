-- files — чтение и запись файла через WASI path_open. Каталог — fd 3,
-- его даёт хост (preopen). Путь относительно этого каталога.
-- file_read -> строка; file_write -> none; ошибка — File.

use compiler.contract.abi
use compiler.gorn.backend
use compiler.gorn.platform
use compiler.gorn.backend.wasm.wasm32.asm
use compiler.gorn.backend.runtime.tails

FRAME = 32
RET = 28
FD = 24
TEXT = 20
OBJ = 20
TOTAL = 16
CAP = 12
CHUNK = 4096
IOV = 2048
OPENED = 2064
CREAT = 9

Files = Box {
    skill emit_iov(billet, kind) {
        @executor = billet.executor
        billet = executor.load_immediate(billet, backend.SCRATCH5, IOV)
        billet = executor.store(billet, backend.ERROR, backend.SCRATCH5, 0)
        billet = executor.store(billet, backend.ARG2, backend.SCRATCH5, 4)
        billet = executor.store_zero(billet, backend.SCRATCH5, 8)
        billet = executor.move(billet, backend.ERROR, backend.SCRATCH5)
        billet = executor.add_immediate(billet, backend.ARG3, backend.SCRATCH5, 8)
        billet = executor.load_immediate(billet, backend.ARG2, 1)
        out executor.wasi(billet, kind)
    }

    skill emit_file_open(billet, oflags) {
        @executor = billet.executor
        billet = executor.load_immediate(billet, backend.ARG2, oflags)
        billet = executor.load_immediate(billet, backend.ARG3, OPENED)
        out executor.wasi(billet, asm.WASI_OPEN)
    }

    skill take_path(billet) {
        @executor = billet.executor
        @at = billet.words.payload + billet.words.string_data
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.ERROR, backend.SCRATCH0, billet.words.payload)
        out executor.add_immediate(billet, backend.VALUE, backend.SCRATCH0, at)
    }

    skill emit_fail(billet) {
        @executor = billet.executor
        billet = executor.label(billet, ".L_wa_file_fail")
        billet = executor.load(billet, backend.VALUE, backend.STACK, FD)
        billet = executor.branch_negative(billet, backend.VALUE, ".L_wa_file_closed")
        billet = executor.wasi(billet, asm.WASI_CLOSE)
        billet = executor.label(billet, ".L_wa_file_closed")
        billet = executor.load_immediate(billet, backend.VALUE, 0)
        billet = executor.load_immediate(billet, backend.ERROR, abi.ERROR_FILE)
        billet = executor.load(billet, backend.RETURN, backend.STACK, RET)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, FRAME)
        out executor.ret(billet)
    }

    skill emit_read(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        @words = billet.words
        @at = words.payload + words.string_data
        billet = executor.label(billet, platform.FILE_READ)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -FRAME)
        billet = executor.store(billet, backend.RETURN, backend.STACK, RET)
        billet = executor.load_immediate(billet, backend.SCRATCH0, -1)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, FD)
        billet = take_path(billet)
        billet = emit_file_open(billet, 0)
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_wa_file_fail")
        billet = executor.store(billet, backend.VALUE, backend.STACK, FD)
        billet = executor.load_immediate(billet, backend.SCRATCH0, CHUNK)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, CAP)
        billet = executor.label(billet, ".L_wa_read_alloc")
        billet = executor.load(billet, backend.VALUE, backend.STACK, CAP)
        billet = executor.add_immediate(billet, backend.VALUE, backend.VALUE, words.string_data + 1)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load_immediate(billet, backend.SCRATCH0, abi.OBJECT_KIND_STRING)
        billet = executor.store32(billet, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.store(billet, backend.VALUE, backend.STACK, OBJ)
        billet = executor.load_immediate(billet, backend.SCRATCH0, 0)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, TOTAL)
        billet = executor.label(billet, ".L_wa_read_loop")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, TOTAL)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, CAP)
        billet = executor.branch_greater_equal(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_wa_read_grow")
        billet = executor.load(billet, backend.ERROR, backend.STACK, OBJ)
        billet = executor.add_immediate(billet, backend.ERROR, backend.ERROR, at)
        billet = executor.add(billet, backend.ERROR, backend.ERROR, backend.SCRATCH0)
        billet = executor.sub(billet, backend.ARG2, backend.SCRATCH1, backend.SCRATCH0)
        billet = executor.load(billet, backend.VALUE, backend.STACK, FD)
        billet = emit_iov(billet, asm.WASI_READ)
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_wa_file_fail")
        billet = executor.branch_zero(billet, backend.VALUE, ".L_wa_read_done")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, TOTAL)
        billet = executor.add(billet, backend.SCRATCH0, backend.SCRATCH0, backend.VALUE)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, TOTAL)
        billet = executor.jump(billet, ".L_wa_read_loop")
        billet = executor.label(billet, ".L_wa_read_grow")
        billet = executor.load(billet, backend.VALUE, backend.STACK, CAP)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, 1)
        billet = executor.store(billet, backend.VALUE, backend.STACK, CAP)
        billet = executor.add_immediate(billet, backend.VALUE, backend.VALUE, words.string_data + 1)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load_immediate(billet, backend.SCRATCH0, abi.OBJECT_KIND_STRING)
        billet = executor.store32(billet, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, OBJ)
        billet = executor.store(billet, backend.VALUE, backend.STACK, OBJ)
        billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, at)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.VALUE, at)
        billet = executor.load(billet, backend.SCRATCH2, backend.STACK, TOTAL)
        billet = executor.label(billet, ".L_wa_read_copy")
        billet = executor.jump_if_zero(billet, backend.SCRATCH2, ".L_wa_read_loop")
        billet = executor.load_byte(billet, backend.SCRATCH3, backend.SCRATCH0, 0)
        billet = executor.store_byte(billet, backend.SCRATCH3, backend.SCRATCH1, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, 1)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 1)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, -1)
        billet = executor.jump(billet, ".L_wa_read_copy")
        billet = executor.label(billet, ".L_wa_read_done")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, OBJ)
        billet = executor.load(billet, backend.SCRATCH2, backend.STACK, TOTAL)
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH0, words.payload)
        billet = executor.add(billet, backend.SCRATCH1, backend.SCRATCH0, backend.SCRATCH2)
        billet = executor.store_byte_zero(billet, backend.SCRATCH1, at)
        billet = executor.load(billet, backend.VALUE, backend.STACK, FD)
        billet = executor.wasi(billet, asm.WASI_CLOSE)
        billet = executor.load(billet, backend.VALUE, backend.STACK, OBJ)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        billet = executor.load(billet, backend.RETURN, backend.STACK, RET)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, FRAME)
        out endings.succeeded(billet)
    }

    skill emit_write(billet) {
        @endings = tails.Tails {}
        @executor = billet.executor
        @words = billet.words
        @at = words.payload + words.string_data
        billet = executor.label(billet, platform.FILE_WRITE)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -FRAME)
        billet = executor.store(billet, backend.RETURN, backend.STACK, RET)
        billet = executor.store(billet, backend.ERROR, backend.STACK, TEXT)
        billet = executor.load_immediate(billet, backend.SCRATCH0, -1)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, FD)
        billet = take_path(billet)
        billet = emit_file_open(billet, CREAT)
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_wa_file_fail")
        billet = executor.store(billet, backend.VALUE, backend.STACK, FD)
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, TEXT)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.ARG2, backend.SCRATCH0, words.payload)
        billet = executor.add_immediate(billet, backend.ERROR, backend.SCRATCH0, at)
        billet = executor.load(billet, backend.VALUE, backend.STACK, FD)
        billet = emit_iov(billet, asm.WASI_WRITE)
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_wa_file_fail")
        billet = executor.load(billet, backend.VALUE, backend.STACK, FD)
        billet = executor.wasi(billet, asm.WASI_CLOSE)
        billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
        billet = executor.load(billet, backend.RETURN, backend.STACK, RET)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, FRAME)
        out endings.succeeded(billet)
    }

    skill emit_files(billet) {
        billet = emit_read(billet)
        billet = emit_write(billet)
        out emit_fail(billet)
    }
}
