-- functions — пролог/эпилог навыков, ленивые константы и диспетчеры методов.
-- Навык: метка saltic_<имя>, страж стека (STACK ниже STACK_LIMIT — ошибка
-- StackExhausted вызывающему прямо на месте: до rt_stack_exhausted прыжок RISC-V не дотянется), кадр по constants,
-- аргументы из ARG0… в слоты, выход через <имя>_return с rt_region_exit (ARG3 =
-- FRAME — откуда сканировать стек при разборе карантина; зовётся всегда:
-- карантин разбирается и без выделений в регионе); ошибка — <имя>_failure
-- (кладёт в путь ошибки «навык · файл» и строку из слота FAIL_LINE — rt_trail_push;
-- строку туда пишет заглушка оператора, emitters.on_error; в прологе — 0).
-- Константа: геттер saltic_constant_get_<имя> считает один раз (значение
-- переезжает в хранилище навсегда — rt_store_eternal), цикл — ERROR_CONSTANT_CYCLE. Метод Box: диспетчер по номеру типа в последнем поле.
-- Команды — методами billet.executor (договор backend).
--
-- compile_function(billet, name, params, body, subject, module) — один навык
--     или метод (subject — имя Box, $self первым параметром)
-- compile_constant(billet, constant) — геттер константы
-- compile_constants(billet, seen) — константы, чьё имя есть в seen (reach)
-- compile_functions(billet, seen) — навыки и методы из seen, program и диспетчеры
-- reach(billet) -> dict коротких имён, достижимых от program, tree_add и text
--     (их зовут рантайм и codegen); имя — хвост пути после последней точки, так что
--     одноимённые навыки разных модулей остаются вместе — с запасом, но без промаха
-- compile_dispatch(billet, method) — выбор метода по Box; ERROR_NO_METHOD

use core.str
use core.group
use core.dict
use compiler.abi
use compiler.ast
use compiler.gorn.state
use compiler.gorn.constants
use compiler.gorn.backend
use compiler.gorn.codegen
use compiler.gorn.codegen.emitters
use compiler.gorn.codegen.failures
use compiler.checker
use compiler.gorn.backend.runtime.tails

skill compile_function(billet, name, params, body, subject, module) {
    @executor = billet.executor
    @locals = state.collect_locals(params, body)
    @local_count = group.count(locals.names)
    @frame = constants.frame_bytes(billet.words, local_count)
    @slots = state.make_slots(billet.words, locals.names, constants.local_offset(billet.words, 0))
    @end = state.label(billet, "{name}_return")
    @failure = state.label(billet, "{name}_failure")
    @types = []
    drum (params) { types = state.type_set(types, beat, "unknown") }
    (str.bytes(subject) > 0) { types = state.type_set(types, "$self", "box:{subject}") }
    billet.current_function = state.Function { name = name, slots = slots, end = end, failure = failure, subject = subject, module = module, types = types, lined = yes }
    @function_label = str.concat("saltic_", state.safe(name))
    billet = executor.label(billet, function_label)
    (billet.signals == yes) { billet.placed = group.add(billet.placed, [function_label, emitters.string_label(billet, failures.place_text(billet))]) }
    @stack_ready = state.label(billet, "stack_ready")
    billet = executor.branch_greater_equal_unsigned(billet, backend.STACK, backend.STACK_LIMIT, stack_ready)
    billet = executor.load_immediate(billet, backend.VALUE, 0)
    billet = executor.load_immediate(billet, backend.ERROR, abi.ERROR_STACK_EXHAUSTED)
    billet = executor.ret(billet)
    billet = executor.label(billet, stack_ready)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -frame)
    billet = executor.store(billet, backend.RETURN, backend.STACK, constants.return_address_save_offset(billet.words, frame))
    billet = executor.store(billet, backend.FRAME, backend.STACK, constants.previous_frame_save_offset(billet.words, frame))
    billet = executor.store(billet, backend.REGION_MARK, backend.STACK, constants.region_mark_save_offset(billet.words, frame))
    billet = executor.add_immediate(billet, backend.FRAME, backend.STACK, frame)
    billet = executor.move(billet, backend.REGION_MARK, backend.HEAP_TOP)
    drum (group.count(params)) {
        @slot = state.slot(billet, group.get(params, beat))
        billet = executor.store(billet, backend.argument(beat), backend.FRAME, slot)
    }
    billet = executor.store_zero(billet, backend.FRAME, state.slot(billet, state.FAIL_LINE))
    billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
    billet = codegen.compile_block(billet, body, no)
    billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
    billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
    billet = executor.jump(billet, end)
    billet = emitters.emit_stubs(billet)
    billet = executor.label(billet, failure)
    billet = executor.load_address(billet, backend.VALUE, emitters.string_label(billet, failures.place_text(billet)), 0)
    billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    billet = executor.load(billet, backend.ARG2, backend.FRAME, state.slot(billet, state.FAIL_LINE))
    billet = executor.call(billet, "rt_trail_push")
    billet = executor.load_immediate(billet, backend.VALUE, 0)
    billet = executor.load_immediate(billet, backend.ARG2, constants.REGION_VALUE_SKIPPED)
    billet = executor.label(billet, end)
    billet = executor.move(billet, backend.ARG3, backend.FRAME)
    billet = executor.call(billet, "rt_region_exit")
    billet = executor.load(billet, backend.RETURN, backend.FRAME, constants.return_address_load_offset(billet.words))
    billet = executor.load(billet, backend.REGION_MARK, backend.FRAME, constants.region_mark_load_offset(billet.words))
    billet = executor.load(billet, backend.SCRATCH0, backend.FRAME, constants.previous_frame_load_offset(billet.words))
    billet = executor.move(billet, backend.STACK, backend.FRAME)
    billet = executor.move(billet, backend.FRAME, backend.SCRATCH0)
    billet = executor.ret(billet)
    billet.current_function = state.Function {}
    out billet
}

skill compile_constant(billet, constant) {
    @executor = billet.executor
    @ready = state.label(billet, "constant_ready")
    @cycle = state.label(billet, "constant_cycle")
    @failure = state.label(billet, "constant_failure")
    @finish = state.label(billet, "constant_finish")
    @before = billet.current_function
    billet.current_function = state.Function { name = constant.name, module = constant.text }

    @getter = constants.getter_label(constant.name)
    billet = executor.label(billet, getter)
    @frame = constants.constant_frame_bytes(billet.words)
    @return_address_offset = constants.constant_return_address_offset(billet.words)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -frame)
    billet = executor.store(billet, backend.RETURN, backend.STACK, return_address_offset)
    billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
    billet = executor.load_address(billet, backend.SCRATCH0, constants.state_label(constant.name), 0)
    billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
    billet = executor.load_immediate(billet, backend.SCRATCH2, constants.STATE_READY)
    billet = executor.jump_if_equal(billet, backend.SCRATCH1, backend.SCRATCH2, ready)
    billet = executor.load_immediate(billet, backend.SCRATCH2, constants.STATE_INITIALIZING)
    billet = executor.jump_if_equal(billet, backend.SCRATCH1, backend.SCRATCH2, cycle)
    billet = executor.load_immediate(billet, backend.SCRATCH1, constants.STATE_INITIALIZING)
    billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)

    billet = codegen.compile_expression(billet, constant.node)
    billet = executor.jump_if_nonzero(billet, backend.ERROR, failure)
    billet = executor.call(billet, "rt_store_eternal")
    billet = executor.jump_if_nonzero(billet, backend.ERROR, failure)
    billet = executor.load_address(billet, backend.SCRATCH0, constants.value_label(constant.name), 0)
    billet = executor.store(billet, backend.VALUE, backend.SCRATCH0, 0)
    billet = executor.load_address(billet, backend.SCRATCH0, constants.state_label(constant.name), 0)
    billet = executor.load_immediate(billet, backend.SCRATCH1, constants.STATE_READY)
    billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
    billet = executor.jump(billet, finish)

    billet = executor.label(billet, ready)
    billet = executor.load_address(billet, backend.SCRATCH0, constants.value_label(constant.name), 0)
    billet = executor.load(billet, backend.VALUE, backend.SCRATCH0, 0)
    billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
    billet = executor.jump(billet, finish)

    billet = executor.label(billet, cycle)
    billet = executor.load_immediate(billet, backend.VALUE, 0)
    billet = executor.load_immediate(billet, backend.ERROR, abi.ERROR_CONSTANT_CYCLE)

    billet = executor.label(billet, failure)
    billet = executor.load_address(billet, backend.SCRATCH0, constants.state_label(constant.name), 0)
    billet = executor.load_immediate(billet, backend.SCRATCH1, constants.STATE_EMPTY)
    billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)

    billet = executor.label(billet, finish)
    billet = executor.load(billet, backend.RETURN, backend.STACK, return_address_offset)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, frame)
    billet = executor.ret(billet)
    billet.current_function = before
    out billet
}

skill short_name(name) {
    @parts = str.split(name, ".")
    (group.count(parts) == 0) { out name }
    out group.get(parts, group.count(parts) - 1)
}

skill index_add(index, name, node) {
    @key = short_name(name)
    @nodes = []
    (dict.has(index, key) == yes) { nodes = dict.get(index, key) }
    dict.set(index, key, group.add(nodes, node))
}

skill mark(seen, index, name) {
    @key = short_name(name)
    (dict.has(seen, key) == yes) { out none }
    dict.set(seen, key, yes)
    (dict.has(index, key) == yes) {
        drum (dict.get(index, key)) { walk(seen, index, beat) }
    }
    out none
}

skill walk(seen, index, node) {
    @tag = ast.tag(node)
    (tag == "path") {
        @path = ast.plain(node)
        drum (group.count(path) - 1) { mark(seen, index, group.get(path, beat + 1)) }
    }
    (tag == "box-new") { mark(seen, index, ast.part(node, 1)) }
    drum (ast.children(node)) { walk(seen, index, beat) }
    out none
}

skill reach(billet) {
    @index = dict.new()
    drum (billet.skills) { index_add(index, beat.name, ast.part(beat.node, 3)) }
    drum (billet.constants) { index_add(index, beat.name, beat.node) }
    drum (billet.boxes) {
        @box = beat
        drum (group.count(ast.plain(box.node)) - 2) {
            @member = ast.part(box.node, beat + 2)
            (ast.tag(member) == "field") { index_add(index, box.name, ast.part(member, 2)) }
            (ast.tag(member) == "subject-skill") { index_add(index, ast.part(member, 1), ast.part(member, 3)) }
        }
    }
    @seen = dict.new()
    mark(seen, index, "tree_add")
    mark(seen, index, "text")
    walk(seen, index, ast.part(billet.entry, 2))
    out seen
}

skill compile_constants(billet, seen) {
    drum (billet.constants) {
        (dict.has(seen, short_name(beat.name)) == yes) { billet = compile_constant(billet, beat) }
    }
    out billet
}

skill compile_functions(billet, seen) {
    drum (billet.skills) {
        (dict.has(seen, short_name(beat.name)) == yes) {
            billet = compile_function(billet, beat.name, ast.part(beat.node, 2), ast.part(beat.node, 3), "", beat.text)
        }
    }
    drum (billet.boxes) {
        @box = beat
        drum (group.count(ast.plain(box.node)) - 2) {
            @member = ast.part(box.node, beat + 2)
            @method = ast.tag(member) == "subject-skill"
            (method == yes) { method = dict.has(seen, ast.part(member, 1)) }
            (method == yes) {
                @name = "{box.name}."
                name = str.concat(name, ast.part(member, 1))
                @params = group.concat(["$self"], ast.part(member, 2))
                billet = compile_function(billet, name, params, ast.part(member, 3), box.name, ast.module_name(box.node))
            }
        }
    }
    billet = compile_function(billet, "program", ast.part(billet.entry, 1), ast.part(billet.entry, 2), "", "")
    drum (billet.dispatches) { billet = compile_dispatch(billet, beat) }
    out billet
}

skill compile_dispatch(billet, method) {
    @executor = billet.executor
    @words = billet.words
    @label = state.dispatch_label(method)
    @missing = "{label}_missing"
    billet = executor.label(billet, label)
    billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.TAG_MASK)
    billet = executor.load_immediate(billet, backend.SCRATCH1, abi.TAG_BOX)
    billet = executor.branch_not_equal(billet, backend.SCRATCH0, backend.SCRATCH1, missing)
    billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload + constants.BOX_COUNT_OFFSET)
    billet = executor.shift_left(billet, backend.SCRATCH1, backend.SCRATCH1, words.shift + 1)
    billet = executor.add(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH1)
    billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH0, words.payload + words.box_fields + words.box_field_value - words.box_field)
    drum (group.count(billet.boxes)) {
        @box = group.get(billet.boxes, beat)
        @inspector = Checker {}
        (inspector.box_has_skill(billet.boxes, box.name, method) == yes) {
            @next = "{label}_{beat}"
            billet = executor.load_immediate(billet, backend.SCRATCH1, abi.tagged(beat + 1, abi.TAG_NUMBER))
            billet = executor.branch_not_equal(billet, backend.SCRATCH2, backend.SCRATCH1, next)
            billet = executor.jump(billet, str.concat("saltic_", state.safe(str.concat("{box.name}.", method))))
            billet = executor.label(billet, next)
        }
    }
    out tails.fail(billet, missing, abi.ERROR_NO_METHOD)
}
