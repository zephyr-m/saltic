-- platform — Linux для AArch64: вход arm64_start. Вызовы ядра — прямо svc #0
-- (control.syscall): номера общей таблицы Linux (asm-generic) у ARM64 те же,
-- что у RISC-V, поэтому подпрограмм-переводчиков, как у x86-64, нет. Вход
-- кладёт sp ядра ([argc, argv…] по 8 байт) в x28 — стек договора — и прыгает
-- на _start; сам sp дальше не трогается (он для сигналов ядра).
-- Страница у ядер ARM бывает 4, 16 (новые телефоны) и 64 КБ (часть серверов):
-- сегменты выровнены на PAGE = 64 КБ — rodata дополнена нулями до границы, так
-- что data (layout ставит её на 4096 после rodata) начинается с новой страницы.
--
-- ENTRY = "arm64_start"; PAGE = 65536
-- append(machine) -> machine с входом, machine.entry = ENTRY
-- pages(machine) -> machine, у которой data начинается на границе PAGE
-- Хозяин — LinuxRuntime { coder } (СОП, 22.11.2026): навыки ниже — его методы.

use core.num
use compiler.gorn.backend.layout
use compiler.gorn.backend.buffer
use compiler.gorn.backend.arm.arm64.encoder
use compiler.gorn.backend.arm.arm64.roles

ENTRY = "arm64_start"
START = "_start"
PAGE = 65536

LinuxRuntime = Box {
    coder = encoder.Encoder {}

    skill append(machine) {
        machine.define_label(Layout.Section.CODE, ENTRY)
        machine.emit_word(coder.add_immediate_word(roles.STACK_REGISTER, roles.SP, 0))
        @start = machine.find_label(START)
        machine.emit_word(coder.branch_word(no, (start.offset - machine.code.length) / 4))
        machine.entry = ENTRY
        out machine
    }

    skill pages(machine) {
        @current = machine.layout()
        @end = current.rodata_offset + machine.rodata.length
        @machine_rodata = machine.rodata
        machine_rodata.append_zeroes(num.align(end, PAGE) - end)
        @padded = machine.rodata
        machine.assign_section(Layout.Section.RODATA, padded)
        out machine
    }
}
