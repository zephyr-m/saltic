-- arm64 — родной бэкенд AArch64: исполнитель договора машины (Executor) и
-- запись образа. Слово 8 байт, числа 61-битные, как у x86_64 и rv64. Общих
-- команд у ARM ни с кем нет — исполнитель целиком свой, раскладка — общая
-- (backend.layout, адрес 65536, без низкой памяти), ELF — общий
-- (linker.elf64). Все роли в регистрах (roles), стек договора — x28.
-- Переходы к меткам — правки control.Fixups исполнителя (не layout.Patch):
-- toolchain создаёт исполнитель со своим списком и отдаёт его в write.
--
-- Executor — все методы договора backend (../../main.saltic), плюс multiply… /
--     divide… / load_wide / fraction… 8-байтного слова
-- write_linux(path, machine) — ELF64 AArch64 для Linux: вход дописан, сегменты
--     на страницах 64 КБ, правки и патчи разрешены, образ записан; UnresolvedPatch, WriteFailed
--
-- Дети: encoder (слова команд), roles (роль → регистр), ops (константы,
-- арифметика, сравнения), access (память и стек), control (переходы, вызовы,
-- адреса, вызов ядра, правки), platform (вход Linux).

use compiler.gorn.backend
use compiler.gorn.backend.layout
use compiler.gorn.backend.arm.arm64.encoder
use compiler.gorn.backend.arm.arm64.roles
use compiler.gorn.backend.arm.arm64.ops
use compiler.gorn.backend.arm.arm64.access
use compiler.gorn.backend.arm.arm64.control
use compiler.gorn.backend.arm.arm64.platform
use compiler.gorn.linker.elf64
use compiler.abi.shape

Executor = Box {
    coder = encoder.Encoder {},
    places = roles.Roles {},
    arithmetic = ops.Ops {},
    access_ops = access.Access {},
    flow = control.Control {},
    linux = platform.LinuxRuntime {}

    skill section(value) {
        (value == backend.CODE) {
            out Layout.Section.CODE
        }
        (value == backend.RODATA) {
            out Layout.Section.RODATA
        }
        (value == backend.DATA) {
            out Layout.Section.DATA
        }
        out Layout.Section.BSS
    }

    skill new_program(billet, entry) {
        billet.words = shape.of(8)
        billet.machine = layout.host(entry)
        billet.machine.low_memory_size = 0
        out billet
    }

    skill heap_size(billet, bytes) {
        billet.machine.heap_size = bytes
        out billet
    }

    skill label(billet, name) {
        @billet_machine = billet.machine
        billet_machine.define_label(Layout.Section.CODE, name)
        out billet
    }

    skill data_label(billet, where, name) {
        @billet_machine = billet.machine
        billet_machine.define_label(section(where), name)
        out billet
    }

    skill align(billet, where, boundary) {
        @billet_machine = billet.machine
        billet_machine.align_section(section(where), boundary)
        out billet
    }

    skill data_byte(billet, where, value) {
        @billet_machine = billet.machine
        billet_machine.append_section_byte(section(where), value)
        out billet
    }

    skill data32(billet, where, value) {
        @billet_machine = billet.machine
        billet_machine.append_section_word(section(where), value)
        out billet
    }

    skill data_word(billet, where, value) {
        @billet_machine = billet.machine
        billet_machine.append_section_word(section(where), value)
        @fill = 0
        (value.b3 > 127) {
            fill = 255
        }
        billet_machine = billet.machine
        drum (4) {
            billet_machine.append_section_byte(section(where), fill)
        }
        out billet
    }

    skill data_text(billet, where, text) {
        @billet_machine = billet.machine
        billet_machine.append_section_text(section(where), text, yes)
        out billet
    }

    skill reserve(billet, bytes) {
        @billet_machine = billet.machine
        billet_machine.reserve_bss(bytes)
        out billet
    }

    skill load_immediate(billet, to, value) {
        out arithmetic.load_immediate(billet, to, value)
    }

    skill load_word(billet, to, value) {
        out arithmetic.load_word(billet, to, value)
    }

    skill load_address(billet, to, name, addend) {
        out flow.load_address(billet, to, name, addend)
    }

    skill move(billet, to, from) {
        out arithmetic.move(billet, to, from)
    }

    skill negate(billet, to, from) {
        out arithmetic.negate(billet, to, from)
    }

    skill add_immediate(billet, to, from, value) {
        out arithmetic.add_immediate(billet, to, from, value)
    }

    skill add(billet, to, left, right) {
        out arithmetic.binary_op(billet, encoder.ADD, to, left, right)
    }

    skill sub(billet, to, left, right) {
        out arithmetic.binary_op(billet, encoder.SUB, to, left, right)
    }

    skill and(billet, to, left, right) {
        out arithmetic.binary_op(billet, encoder.AND, to, left, right)
    }

    skill or(billet, to, left, right) {
        out arithmetic.binary_op(billet, encoder.ORR, to, left, right)
    }

    skill xor(billet, to, left, right) {
        out arithmetic.binary_op(billet, encoder.EOR, to, left, right)
    }

    skill and_immediate(billet, to, from, value) {
        out arithmetic.logical(billet, encoder.AND, to, from, value)
    }

    skill or_immediate(billet, to, from, value) {
        out arithmetic.logical(billet, encoder.ORR, to, from, value)
    }

    skill xor_immediate(billet, to, from, value) {
        out arithmetic.logical(billet, encoder.EOR, to, from, value)
    }

    skill shift_left(billet, to, from, count) {
        out arithmetic.shift(billet, ops.SHIFT_LEFT, to, from, count)
    }

    skill shift_right_signed(billet, to, from, count) {
        out arithmetic.shift(billet, ops.SHIFT_ARITHMETIC, to, from, count)
    }

    skill shift_right_unsigned(billet, to, from, count) {
        out arithmetic.shift(billet, ops.SHIFT_RIGHT, to, from, count)
    }

    skill shift_left_by(billet, to, from, count) {
        out arithmetic.data2_op(billet, encoder.LSLV, to, from, count)
    }

    skill shift_right_unsigned_by(billet, to, from, count) {
        out arithmetic.data2_op(billet, encoder.LSRV, to, from, count)
    }

    skill set_less(billet, to, left, right) {
        out arithmetic.compare_op(billet, encoder.LT, to, left, right)
    }

    skill set_less_unsigned(billet, to, left, right) {
        out arithmetic.compare_op(billet, encoder.LO, to, left, right)
    }

    skill set_less_unsigned_immediate(billet, to, from, value) {
        out arithmetic.compare_immediate_op(billet, encoder.LO, to, from, value)
    }

    skill set_zero(billet, to, from) {
        out arithmetic.compare_immediate_op(billet, encoder.EQ, to, from, 0)
    }

    skill set_nonzero(billet, to, from) {
        out arithmetic.compare_immediate_op(billet, encoder.NE, to, from, 0)
    }

    skill add_checked(billet) {
        out arithmetic.checked(billet, encoder.ADDS)
    }

    skill sub_checked(billet) {
        out arithmetic.checked(billet, encoder.SUBS)
    }

    skill load(billet, to, base, offset) {
        out access_ops.transfer(billet, encoder.X, yes, places.register(to), base, offset)
    }

    skill load32(billet, to, base, offset) {
        out access_ops.transfer(billet, encoder.W, yes, places.register(to), base, offset)
    }

    skill store32(billet, from, base, offset) {
        out access_ops.transfer(billet, encoder.W, no, places.register(from), base, offset)
    }

    skill load_byte(billet, to, base, offset) {
        out access_ops.transfer(billet, encoder.B, yes, places.register(to), base, offset)
    }

    skill load_half(billet, to, base, offset) {
        out access_ops.transfer(billet, encoder.H, yes, places.register(to), base, offset)
    }

    skill store(billet, from, base, offset) {
        out access_ops.transfer(billet, encoder.X, no, places.register(from), base, offset)
    }

    skill store_byte(billet, from, base, offset) {
        out access_ops.transfer(billet, encoder.B, no, places.register(from), base, offset)
    }

    skill store_half(billet, from, base, offset) {
        out access_ops.transfer(billet, encoder.H, no, places.register(from), base, offset)
    }

    skill store_zero(billet, base, offset) {
        out access_ops.transfer(billet, encoder.X, no, encoder.ZERO_REGISTER, base, offset)
    }

    skill store_byte_zero(billet, base, offset) {
        out access_ops.transfer(billet, encoder.B, no, encoder.ZERO_REGISTER, base, offset)
    }

    skill push(billet, from) {
        out access_ops.push(billet, from)
    }

    skill pop(billet, to) {
        out access_ops.pop(billet, to)
    }

    skill branch_equal(billet, left, right, name) {
        out flow.branch(billet, encoder.EQ, left, right, name)
    }

    skill branch_not_equal(billet, left, right, name) {
        out flow.branch(billet, encoder.NE, left, right, name)
    }

    skill branch_less(billet, left, right, name) {
        out flow.branch(billet, encoder.LT, left, right, name)
    }

    skill branch_greater_equal(billet, left, right, name) {
        out flow.branch(billet, encoder.GE, left, right, name)
    }

    skill branch_less_unsigned(billet, left, right, name) {
        out flow.branch(billet, encoder.LO, left, right, name)
    }

    skill branch_greater_equal_unsigned(billet, left, right, name) {
        out flow.branch(billet, encoder.HS, left, right, name)
    }

    skill branch_zero(billet, from, name) {
        out flow.branch_test(billet, control.ZERO, from, name)
    }

    skill branch_nonzero(billet, from, name) {
        out flow.branch_test(billet, control.NONZERO, from, name)
    }

    skill branch_negative(billet, from, name) {
        out flow.branch_test(billet, encoder.MI, from, name)
    }

    skill branch_not_negative(billet, from, name) {
        out flow.branch_test(billet, encoder.PL, from, name)
    }

    skill branch_not_positive(billet, from, name) {
        out flow.branch_test(billet, encoder.LE, from, name)
    }

    skill jump(billet, name) {
        out flow.jump(billet, name)
    }

    skill jump_if_equal(billet, left, right, name) {
        out flow.jump_if(billet, encoder.EQ, left, right, name)
    }

    skill jump_if_not_equal(billet, left, right, name) {
        out flow.jump_if(billet, encoder.NE, left, right, name)
    }

    skill jump_if_zero(billet, from, name) {
        out flow.jump_if_test(billet, no, from, name)
    }

    skill jump_if_nonzero(billet, from, name) {
        out flow.jump_if_test(billet, yes, from, name)
    }

    skill jump_far(billet, name) {
        out flow.jump(billet, name)
    }

    skill call(billet, name) {
        out flow.call(billet, name)
    }

    skill ret(billet) {
        out arithmetic.emit(billet, coder.ret_word())
    }

    skill syscall(billet, number) {
        out flow.syscall(billet, number)
    }

    skill wait(billet) {
        out arithmetic.emit(billet, coder.wfi())
    }

    skill fence(billet) {
        out arithmetic.emit(billet, coder.dmb())
    }

    skill multiply(billet, to, left, right) {
        out arithmetic.multiply_op(billet, encoder.MADD, to, left, right)
    }

    skill multiply_high(billet, to, left, right) {
        out arithmetic.multiply_op(billet, encoder.SMULH, to, left, right)
    }

    skill multiply_high_unsigned(billet, to, left, right) {
        out arithmetic.multiply_op(billet, encoder.UMULH, to, left, right)
    }

    skill divide(billet, to, left, right) {
        out arithmetic.data2_op(billet, encoder.SDIV, to, left, right)
    }

    skill remainder(billet, to, left, right) {
        out arithmetic.remainder_op(billet, encoder.SDIV, to, left, right)
    }

    skill divide_unsigned(billet, to, left, right) {
        out arithmetic.data2_op(billet, encoder.UDIV, to, left, right)
    }

    skill remainder_unsigned(billet, to, left, right) {
        out arithmetic.remainder_op(billet, encoder.UDIV, to, left, right)
    }

    skill load_wide(billet, to, value) {
        out arithmetic.load_wide(billet, to, value)
    }

    skill fraction(billet, op, to, left, right) {
        out arithmetic.fraction(billet, op, to, left, right)
    }

    skill fraction_from(billet, to, from) {
        out arithmetic.fraction_from(billet, to, from)
    }

    skill fraction_to(billet, to, from, mode) {
        out arithmetic.fraction_to(billet, to, from, mode)
    }

    skill write_linux(path, machine) {
        @paged = linux.pages(linux.append(machine))
        @resolved = layout.resolve(paged) rescue |failure| {
            out error.UnresolvedPatch
        }
        out elf64.write(path, resolved, elf64.AARCH64, platform.PAGE)
    }
}

