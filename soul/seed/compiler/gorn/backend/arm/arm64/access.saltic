-- access — память и стек договора на AArch64: ldr / str слов (8 байт), 32-битных
-- полей, байтов и полуслов, store нуля (xzr), push / pop. Смещение, которое не
-- ложится в команду (масштабное 12 бит или 9 бит со знаком), — в roles.TEMP и
-- адрес [база, TEMP]. Стек договора — x28 (roles.STACK_REGISTER), слово на нём
-- 8 байт: push — str [x28, #-8]!, pop — ldr [x28], #8.
--
-- transfer(billet, size, load, register, base, offset) — size encoder.X / W / H / B,
--     register — номер регистра (xzr — store нуля), base — роль
-- push(billet, from) / pop(billet, to) — роли
-- Хозяин — Access { coder, places, arithmetic } (СОП, 22.11.2026): навыки ниже — его методы.

use compiler.gorn.backend.arm.arm64.encoder
use compiler.gorn.backend.arm.arm64.roles
use compiler.gorn.backend.arm.arm64.ops

WORD_BYTES = 8

Access = Box {
    coder = encoder.Encoder {},
    places = roles.Roles {},
    arithmetic = ops.Ops {}

    skill transfer(billet, size, load, register, base, offset) {
        @rn = places.register(base)
        (coder.memory_fits(size, offset) == yes) { out arithmetic.emit(billet, coder.memory_word(size, load, register, rn, offset)) }
        billet = arithmetic.number(billet, roles.TEMP, offset)
        out arithmetic.emit(billet, coder.memory_register(size, load, register, rn, roles.TEMP))
    }

    skill push(billet, from) {
        out arithmetic.emit(billet, coder.push_word(places.register(from), roles.STACK_REGISTER, WORD_BYTES))
    }

    skill pop(billet, to) {
        out arithmetic.emit(billet, coder.pop_word(places.register(to), roles.STACK_REGISTER, WORD_BYTES))
    }
}
