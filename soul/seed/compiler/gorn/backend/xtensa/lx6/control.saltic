-- control — переходы и CALL0. К метке идём через J: дальности IRAM хватает.
-- Если операнд в слоте DRAM, перед прыжком регистры a14 и a15 возвращаются.
-- Хозяин — Control { coder, places, writer, access_ops } (СОП, 22.11.2026): навыки ниже — его методы.

use compiler.gorn.backend.xtensa.lx6.asm
use compiler.gorn.backend.xtensa.lx6.encode
use compiler.gorn.backend.xtensa.lx6.roles
use compiler.gorn.backend.xtensa.lx6.access

Control = Box {
    coder = encode.Encoder {},
    places = roles.Roles {},
    writer = asm.Assembler {},
    access_ops = access.Access {}

    skill over(prog, word, name) {
        prog = writer.emit3(prog, word)
        out writer.jump_to(prog, name)
    }

    skill taken(prog, name) {
        prog = access_ops.unspill(prog)
        prog = writer.jump_to(prog, name)
        out access_ops.unspill(prog)
    }

    skill pair(prog, left, right, kind, name) {
        @rs = places.reg(left)
        @rt = places.reg(right)
        ((rs >= 0) ○ (rt >= 0)) {
            (kind == 0) {
                out over(prog, coder.bne(rs, rt, 6), name)
            }
            (kind == 1) {
                out over(prog, coder.beq(rs, rt, 6), name)
            }
            (kind == 2) {
                out over(prog, coder.bge(rs, rt, 6), name)
            }
            (kind == 3) {
                out over(prog, coder.blt(rs, rt, 6), name)
            }
            (kind == 4) {
                out over(prog, coder.bgeu(rs, rt, 6), name)
            }
            out over(prog, coder.bltu(rs, rt, 6), name)
        }
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, left, 14)
        prog = access_ops.fetch(prog, right, 15)
        (kind == 0) {
            prog = writer.emit3(prog, coder.bne(14, 15, 15))
        }
        (kind == 1) {
            prog = writer.emit3(prog, coder.beq(14, 15, 15))
        }
        (kind == 2) {
            prog = writer.emit3(prog, coder.bge(14, 15, 15))
        }
        (kind == 3) {
            prog = writer.emit3(prog, coder.blt(14, 15, 15))
        }
        (kind == 4) {
            prog = writer.emit3(prog, coder.bgeu(14, 15, 15))
        }
        (kind == 5) {
            prog = writer.emit3(prog, coder.bltu(14, 15, 15))
        }
        out taken(prog, name)
    }

    skill one(prog, src, kind, name) {
        @rs = places.reg(src)
        (rs >= 0) {
            (kind == 0) {
                out over(prog, coder.bnez(rs, 6), name)
            }
            (kind == 1) {
                out over(prog, coder.beqz(rs, 6), name)
            }
            (kind == 2) {
                out over(prog, coder.bgez(rs, 6), name)
            }
            out over(prog, coder.bltz(rs, 6), name)
        }
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, src, 14)
        (kind == 0) {
            prog = writer.emit3(prog, coder.bnez(14, 15))
        }
        (kind == 1) {
            prog = writer.emit3(prog, coder.beqz(14, 15))
        }
        (kind == 2) {
            prog = writer.emit3(prog, coder.bgez(14, 15))
        }
        (kind == 3) {
            prog = writer.emit3(prog, coder.bltz(14, 15))
        }
        out taken(prog, name)
    }

    skill not_positive(prog, src, name) {
        @rs = places.reg(src)
        (rs >= 0) {
            prog = writer.emit3(prog, coder.bltz(rs, 9))
            prog = writer.emit3(prog, coder.beqz(rs, 6))
            prog = writer.emit3(prog, coder.jump_word(6))
            out writer.jump_to(prog, name)
        }
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, src, 14)
        prog = writer.emit3(prog, coder.bltz(14, 18))
        prog = writer.emit3(prog, coder.beqz(14, 15))
        prog = access_ops.unspill(prog)
        prog = writer.emit3(prog, coder.jump_word(15))
        prog = access_ops.unspill(prog)
        out writer.jump_to(prog, name)
    }
}
