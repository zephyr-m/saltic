-- xtensa — исполнитель договора машины для LX6, CALL0, без окон.
-- Слово 4 байта. Образ собирает asm.image_of.

use compiler.contract.abi.shape
use compiler.gorn.backend
use compiler.gorn.backend.xtensa.lx6.asm
use compiler.gorn.backend.xtensa.lx6.encode
use compiler.gorn.backend.xtensa.lx6.roles
use compiler.gorn.backend.xtensa.lx6.ops
use compiler.gorn.backend.xtensa.lx6.access
use compiler.gorn.backend.xtensa.lx6.control
use compiler.gorn.machine.word

Executor = Box {
    coder = encode.Encoder {},
    places = roles.Roles {},
    writer = asm.Assembler {},
    access_ops = access.Access {},
    arithmetic = ops.Ops {},
    flow = control.Control {}

    skill new_program(billet, entry) {
        billet.words = shape.of(4)
        billet.machine = writer.fresh(entry)
        out billet
    }

    skill heap_size(billet, bytes) {
        bytes = bytes
        out billet
    }

    skill label(billet, name) {
        billet.machine = writer.define(billet.machine, asm.SEC_CODE, name)
        out billet
    }

    skill data_label(billet, where, name) {
        billet.machine = writer.define(billet.machine, where, name)
        out billet
    }

    skill align(billet, where, boundary) {
        billet.machine = writer.align_in(billet.machine, where, boundary)
        out billet
    }

    skill data_byte(billet, where, value) {
        billet.machine = writer.add_byte(billet.machine, where, value)
        out billet
    }

    skill data32(billet, where, value) {
        out data_word(billet, where, value)
    }

    skill data_word(billet, where, value) {
        billet.machine = writer.add_word(billet.machine, where, value)
        out billet
    }

    skill data_text(billet, where, text) {
        billet.machine = writer.add_text(billet.machine, where, text)
        billet.machine = writer.add_byte(billet.machine, where, 0)
        out billet
    }

    skill reserve(billet, bytes) {
        @high_word = bytes.high
        (high_word.is_zero() == no) {
            out error.ValueOutsideRange
        }
        @low_word = bytes.low
        billet.machine = writer.reserve(billet.machine, low_word.as_number())
        out billet
    }

    skill load_immediate(billet, to, value) {
        @r = places.reg(to)
        (r >= 0) {
            billet.machine = arithmetic.imm_reg(billet.machine, r, value)
        }
        (r < 0) {
            billet.machine = access_ops.spill(billet.machine)
            billet.machine = arithmetic.imm_reg(billet.machine, 14, value)
            billet.machine = access_ops.finish(billet.machine, to)
        }
        out billet
    }

    skill load_word(billet, to, value) {
        @n = value.b0 + value.b1 * 256 + value.b2 * 65536 + value.b3 * 16777216
        out load_immediate(billet, to, n)
    }

    skill load_address(billet, to, name, addend) {
        @r = places.reg(to)
        (r < 0) {
            billet.machine = access_ops.spill(billet.machine)
            billet.machine = writer.label_addr_fix(billet.machine, 14, name, addend)
            billet.machine = access_ops.finish(billet.machine, to)
            out billet
        }
        billet.machine = writer.label_addr_fix(billet.machine, r, name, addend)
        out billet
    }

    skill move(billet, to, from) {
        billet.machine = arithmetic.move(billet.machine, to, from)
        out billet
    }

    skill negate(billet, to, from) {
        billet.machine = arithmetic.neg(billet.machine, to, from)
        out billet
    }

    skill add_immediate(billet, to, from, value) {
        billet.machine = arithmetic.binary_imm(billet.machine, to, from, value, 0)
        out billet
    }

    skill add(billet, to, left, right) {
        billet.machine = arithmetic.binary_op(billet.machine, to, left, right, 0)
        out billet
    }

    skill sub(billet, to, left, right) {
        billet.machine = arithmetic.binary_op(billet.machine, to, left, right, 1)
        out billet
    }

    skill and(billet, to, left, right) {
        billet.machine = arithmetic.binary_op(billet.machine, to, left, right, 2)
        out billet
    }

    skill or(billet, to, left, right) {
        billet.machine = arithmetic.binary_op(billet.machine, to, left, right, 3)
        out billet
    }

    skill xor(billet, to, left, right) {
        billet.machine = arithmetic.binary_op(billet.machine, to, left, right, 4)
        out billet
    }

    skill and_immediate(billet, to, from, value) {
        billet.machine = arithmetic.binary_imm(billet.machine, to, from, value, 2)
        out billet
    }

    skill or_immediate(billet, to, from, value) {
        billet.machine = arithmetic.binary_imm(billet.machine, to, from, value, 3)
        out billet
    }

    skill xor_immediate(billet, to, from, value) {
        billet.machine = arithmetic.binary_imm(billet.machine, to, from, value, 4)
        out billet
    }

    skill shift_left(billet, to, from, count) {
        billet.machine = arithmetic.shift_c(billet.machine, to, from, count, 0)
        out billet
    }

    skill shift_right_signed(billet, to, from, count) {
        billet.machine = arithmetic.shift_c(billet.machine, to, from, count, 2)
        out billet
    }

    skill shift_right_unsigned(billet, to, from, count) {
        billet.machine = arithmetic.shift_c(billet.machine, to, from, count, 1)
        out billet
    }

    skill shift_left_by(billet, to, from, count) {
        billet.machine = arithmetic.shift_by(billet.machine, to, from, count, 0)
        out billet
    }

    skill shift_right_unsigned_by(billet, to, from, count) {
        billet.machine = arithmetic.shift_by(billet.machine, to, from, count, 1)
        out billet
    }

    skill set_less(billet, to, left, right) {
        billet.machine = arithmetic.flag(billet.machine, to, left, right, 0)
        out billet
    }

    skill set_less_unsigned(billet, to, left, right) {
        billet.machine = arithmetic.flag(billet.machine, to, left, right, 1)
        out billet
    }

    skill set_less_unsigned_immediate(billet, to, from, value) {
        billet.machine = access_ops.spill(billet.machine)
        billet.machine = access_ops.fetch(billet.machine, from, 14)
        billet.machine = arithmetic.imm_reg(billet.machine, 15, value)
        billet.machine = writer.emit3(billet.machine, coder.bltu(14, 15, 9))
        billet.machine = writer.emit3(billet.machine, coder.movi(14, 0))
        billet.machine = writer.emit3(billet.machine, coder.jump_word(6))
        billet.machine = writer.emit3(billet.machine, coder.movi(14, 1))
        billet.machine = access_ops.finish(billet.machine, to)
        out billet
    }

    skill set_zero(billet, to, from) {
        billet.machine = arithmetic.flag_zero(billet.machine, to, from, yes)
        out billet
    }

    skill set_nonzero(billet, to, from) {
        billet.machine = arithmetic.flag_zero(billet.machine, to, from, no)
        out billet
    }

    skill add_checked(billet) {
        billet.machine = arithmetic.checked(billet.machine, 0)
        out billet
    }

    skill sub_checked(billet) {
        billet.machine = arithmetic.checked(billet.machine, 1)
        out billet
    }

    skill load(billet, to, base, offset) {
        billet.machine = access_ops.load_from(billet.machine, to, base, offset, 4)
        out billet
    }

    skill load32(billet, to, base, offset) {
        out load(billet, to, base, offset)
    }

    skill load_byte(billet, to, base, offset) {
        billet.machine = access_ops.load_from(billet.machine, to, base, offset, 1)
        out billet
    }

    skill load_half(billet, to, base, offset) {
        billet.machine = access_ops.load_from(billet.machine, to, base, offset, 2)
        out billet
    }

    skill store(billet, from, base, offset) {
        billet.machine = access_ops.store_to(billet.machine, from, base, offset, 4)
        out billet
    }

    skill store32(billet, from, base, offset) {
        out store(billet, from, base, offset)
    }

    skill store_byte(billet, from, base, offset) {
        billet.machine = access_ops.store_to(billet.machine, from, base, offset, 1)
        out billet
    }

    skill store_half(billet, from, base, offset) {
        billet.machine = access_ops.store_to(billet.machine, from, base, offset, 2)
        out billet
    }

    skill store_zero(billet, base, offset) {
        billet.machine = access_ops.zero(billet.machine, base, offset, 4)
        out billet
    }

    skill store_byte_zero(billet, base, offset) {
        billet.machine = access_ops.zero(billet.machine, base, offset, 1)
        out billet
    }

    skill push(billet, from) {
        billet = add_immediate(billet, backend.STACK, backend.STACK, 0 - billet.words.bytes)
        out store(billet, from, backend.STACK, 0)
    }

    skill pop(billet, to) {
        billet = load(billet, to, backend.STACK, 0)
        out add_immediate(billet, backend.STACK, backend.STACK, billet.words.bytes)
    }

    skill branch_equal(billet, left, right, name) {
        billet.machine = flow.pair(billet.machine, left, right, 0, name)
        out billet
    }

    skill branch_not_equal(billet, left, right, name) {
        billet.machine = flow.pair(billet.machine, left, right, 1, name)
        out billet
    }

    skill branch_less(billet, left, right, name) {
        billet.machine = flow.pair(billet.machine, left, right, 2, name)
        out billet
    }

    skill branch_greater_equal(billet, left, right, name) {
        billet.machine = flow.pair(billet.machine, left, right, 3, name)
        out billet
    }

    skill branch_less_unsigned(billet, left, right, name) {
        billet.machine = flow.pair(billet.machine, left, right, 4, name)
        out billet
    }

    skill branch_greater_equal_unsigned(billet, left, right, name) {
        billet.machine = flow.pair(billet.machine, left, right, 5, name)
        out billet
    }

    skill branch_zero(billet, from, name) {
        billet.machine = flow.one(billet.machine, from, 0, name)
        out billet
    }

    skill branch_nonzero(billet, from, name) {
        billet.machine = flow.one(billet.machine, from, 1, name)
        out billet
    }

    skill branch_negative(billet, from, name) {
        billet.machine = flow.one(billet.machine, from, 2, name)
        out billet
    }

    skill branch_not_negative(billet, from, name) {
        billet.machine = flow.one(billet.machine, from, 3, name)
        out billet
    }

    skill branch_not_positive(billet, from, name) {
        billet.machine = flow.not_positive(billet.machine, from, name)
        out billet
    }

    skill jump(billet, name) {
        billet.machine = writer.jump_to(billet.machine, name)
        out billet
    }

    skill jump_if_equal(billet, left, right, name) {
        out branch_equal(billet, left, right, name)
    }

    skill jump_if_not_equal(billet, left, right, name) {
        out branch_not_equal(billet, left, right, name)
    }

    skill jump_if_zero(billet, from, name) {
        out branch_zero(billet, from, name)
    }

    skill jump_if_nonzero(billet, from, name) {
        out branch_nonzero(billet, from, name)
    }

    skill jump_far(billet, name) {
        out jump(billet, name)
    }

    skill call(billet, name) {
        billet.machine = writer.call_to(billet.machine, name)
        out billet
    }

    skill ret(billet) {
        billet.machine = writer.emit3(billet.machine, coder.ret_word())
        out billet
    }

    skill syscall(billet, number) {
        number = number
        out load_immediate(billet, backend.VALUE, 0)
    }

    skill wait(billet) {
        billet.machine = writer.emit3(billet.machine, coder.waiti(0))
        out billet
    }

    skill fence(billet) {
        billet.machine = writer.emit3(billet.machine, coder.memw())
        out billet
    }

    skill read_cycles(billet) {
        billet.machine = writer.emit3(billet.machine, coder.rsr(2, 234))
        billet.machine = writer.emit3(billet.machine, coder.slli(2, 2, 4))
        billet.machine = writer.emit3(billet.machine, coder.srli(2, 2, 4))
        out billet
    }
}
