-- ops — константы, арифметика, сдвиги и сравнения. Временные a14 и a15
-- прячутся на стек, если команде не хватает поля.
-- Хозяин — Ops { coder, places, writer, access_ops } (СОП, 22.11.2026): навыки ниже — его методы.

use compiler.abi
use compiler.gorn.backend.xtensa.lx6.asm
use compiler.gorn.backend.xtensa.lx6.encode
use compiler.gorn.backend.xtensa.lx6.roles
use compiler.gorn.backend.xtensa.lx6.access

Ops = Box {
    coder = encode.Encoder {},
    places = roles.Roles {},
    writer = asm.Assembler {},
    access_ops = access.Access {}

    skill imm_reg(prog, reg, value) {
        ((value > 2047) ○○ (value < 0 - 2048)) {
            out writer.pool_literal(prog, reg, value)
        }
        out writer.emit3(prog, coder.movi(reg, value))
    }

    skill move(prog, dest, src) {
        @rd = places.reg(dest)
        @rs = places.reg(src)
        ((rd >= 0) ○ (rs >= 0)) {
            (rd == rs) {
                out prog
            }
            out writer.emit3(prog, coder.or_word(rd, rs, rs))
        }
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, src, 14)
        out access_ops.finish(prog, dest)
    }

    skill alu(prog, kind, rd, rs, rt) {
        (kind == 0) {
            out writer.emit3(prog, coder.add_word(rd, rs, rt))
        }
        (kind == 1) {
            out writer.emit3(prog, coder.sub_word(rd, rs, rt))
        }
        (kind == 2) {
            out writer.emit3(prog, coder.and_word(rd, rs, rt))
        }
        (kind == 3) {
            out writer.emit3(prog, coder.or_word(rd, rs, rt))
        }
        out writer.emit3(prog, coder.xor_word(rd, rs, rt))
    }

    skill binary_op(prog, dest, left, right, kind) {
        @rd = places.reg(dest)
        @rs = places.reg(left)
        @rt = places.reg(right)
        (((rd >= 0) ○ (rs >= 0)) ○ (rt >= 0)) {
            out alu(prog, kind, rd, rs, rt)
        }
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, left, 14)
        prog = access_ops.fetch(prog, right, 15)
        prog = alu(prog, kind, 14, 14, 15)
        out access_ops.finish(prog, dest)
    }

    skill imm_alu(prog, kind, rd, rs) {
        (kind == 0) {
            out writer.emit3(prog, coder.add_word(rd, rs, 15))
        }
        (kind == 2) {
            out writer.emit3(prog, coder.and_word(rd, rs, 15))
        }
        (kind == 3) {
            out writer.emit3(prog, coder.or_word(rd, rs, 15))
        }
        out writer.emit3(prog, coder.xor_word(rd, rs, 15))
    }

    skill binary_imm(prog, dest, src, value, kind) {
        @rd = places.reg(dest)
        @rs = places.reg(src)
        (((((kind == 0) ○ (rd >= 0)) ○ (rs >= 0)) ○ (value < 128)) ○ (value > 0 - 129)) {
            out writer.emit3(prog, coder.addi(rd, rs, value))
        }
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, src, 14)
        prog = imm_reg(prog, 15, value)
        prog = imm_alu(prog, kind, 14, 14)
        out access_ops.finish(prog, dest)
    }

    skill neg(prog, dest, src) {
        @rd = places.reg(dest)
        @rs = places.reg(src)
        ((rd >= 0) ○ (rs >= 0)) {
            out writer.emit3(prog, coder.neg_word(rd, rs))
        }
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, src, 14)
        prog = writer.emit3(prog, coder.neg_word(14, 14))
        out access_ops.finish(prog, dest)
    }

    skill shift_mask(prog, reg, count) {
        @left = count
        (left < 0) {
            left = 0
        }
        (left > 31) {
            left = 31
        }
        drum (left / 8) {
            prog = writer.emit3(prog, coder.srli(reg, reg, 8))
            left = left - 8
        }
        (left > 0) {
            prog = writer.emit3(prog, coder.srli(reg, reg, left))
        }
        out prog
    }

    skill shift_arith(prog, reg, count) {
        @left = count
        (left < 0) {
            left = 0
        }
        (left > 31) {
            left = 31
        }
        drum (left / 15) {
            prog = writer.emit3(prog, coder.srai(reg, reg, 15))
            left = left - 15
        }
        (left > 0) {
            prog = writer.emit3(prog, coder.srai(reg, reg, left))
        }
        out prog
    }

    skill shift_left_op(prog, reg, count) {
        (count < 0) {
            out prog
        }
        (count > 31) {
            count = 31
        }
        (count == 0) {
            out prog
        }
        out writer.emit3(prog, coder.slli(reg, reg, count))
    }

    skill shift_c(prog, dest, src, count, kind) {
        @rd = places.reg(dest)
        @rs = places.reg(src)
        ((rd >= 0) ○ (rs >= 0)) {
            (rd == rs) {
                (kind == 0) {
                    out shift_left_op(prog, rd, count)
                }
                (kind == 1) {
                    out shift_mask(prog, rd, count)
                }
                out shift_arith(prog, rd, count)
            }
            prog = writer.emit3(prog, coder.or_word(rd, rs, rs))
            (kind == 0) {
                out shift_left_op(prog, rd, count)
            }
            (kind == 1) {
                out shift_mask(prog, rd, count)
            }
            out shift_arith(prog, rd, count)
        }
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, src, 14)
        (kind == 0) {
            prog = shift_left_op(prog, 14, count)
        }
        (kind == 1) {
            prog = shift_mask(prog, 14, count)
        }
        (kind == 2) {
            prog = shift_arith(prog, 14, count)
        }
        out access_ops.finish(prog, dest)
    }

    skill shift_by(prog, dest, src, count, kind) {
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, src, 14)
        prog = access_ops.fetch(prog, count, 15)
        (kind == 0) {
            prog = writer.emit3(prog, coder.ssl(15))
            prog = writer.emit3(prog, coder.sll_reg(14, 14))
        }
        (kind == 1) {
            prog = writer.emit3(prog, coder.ssr(15))
            prog = writer.emit3(prog, coder.srl_reg(14, 14))
        }
        out access_ops.finish(prog, dest)
    }

    skill flag(prog, dest, left, right, kind) {
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, left, 14)
        prog = access_ops.fetch(prog, right, 15)
        (kind == 0) {
            prog = writer.emit3(prog, coder.blt(14, 15, 9))
        }
        (kind == 1) {
            prog = writer.emit3(prog, coder.bltu(14, 15, 9))
        }
        prog = writer.emit3(prog, coder.movi(14, 0))
        prog = writer.emit3(prog, coder.jump_word(6))
        prog = writer.emit3(prog, coder.movi(14, 1))
        out access_ops.finish(prog, dest)
    }

    skill flag_zero(prog, dest, src, yes_on_zero) {
        prog = access_ops.spill(prog)
        prog = access_ops.fetch(prog, src, 14)
        (yes_on_zero == yes) {
            prog = writer.emit3(prog, coder.bnez(14, 9))
        }
        (yes_on_zero == no) {
            prog = writer.emit3(prog, coder.beqz(14, 9))
        }
        prog = writer.emit3(prog, coder.movi(14, 1))
        prog = writer.emit3(prog, coder.jump_word(6))
        prog = writer.emit3(prog, coder.movi(14, 0))
        out access_ops.finish(prog, dest)
    }

    skill checked(prog, kind) {
        (kind == 0) {
            prog = writer.emit3(prog, coder.add_word(6, 2, 3))
        }
        (kind == 1) {
            prog = writer.emit3(prog, coder.sub_word(6, 2, 3))
        }
        prog = writer.emit3(prog, coder.xor_word(7, 2, 3))
        (kind == 0) {
            prog = writer.emit3(prog, coder.bltz(7, 9))
        }
        (kind == 1) {
            prog = writer.emit3(prog, coder.bgez(7, 9))
        }
        prog = writer.emit3(prog, coder.xor_word(7, 2, 6))
        prog = writer.emit3(prog, coder.bltz(7, 12))
        prog = writer.emit3(prog, coder.movi(3, abi.CALL_NO_ERROR))
        prog = writer.emit3(prog, coder.or_word(2, 6, 6))
        prog = writer.emit3(prog, coder.jump_word(9))
        prog = writer.emit3(prog, coder.or_word(2, 6, 6))
        out writer.emit3(prog, coder.movi(3, abi.ERROR_NUMBER_OVERFLOW))
    }
}
