-- access — чтение и запись. Короткое смещение остаётся в команде.
-- Длинное и слот DRAM идут через a14/a15, их прежние значения лежат на стеке
-- (spill сдвигает a1 на 8). После spill роли a14, a15 и a1 читаются только
-- через fetch: он берёт прежние a14/a15 со стека и a1 с поправкой на 8.
-- Хозяин — Access { coder, places, writer } (СОП, 22.11.2026): навыки ниже — его методы.

use compiler.gorn.backend.xtensa.lx6.asm
use compiler.gorn.backend.xtensa.lx6.encode
use compiler.gorn.backend.xtensa.lx6.roles

Access = Box {
    coder = encode.Encoder {},
    places = roles.Roles {},
    writer = asm.Assembler {}

    skill spill(prog) {
        prog = writer.emit3(prog, coder.addi(1, 1, 0 - 8))
        prog = writer.emit3(prog, coder.s32i(14, 1, 0))
        out writer.emit3(prog, coder.s32i(15, 1, 4))
    }

    skill unspill(prog) {
        prog = writer.emit3(prog, coder.l32i(15, 1, 4))
        prog = writer.emit3(prog, coder.l32i(14, 1, 0))
        out writer.emit3(prog, coder.addi(1, 1, 8))
    }

    skill drop(prog) {
        out writer.emit3(prog, coder.addi(1, 1, 8))
    }

    skill fits_range(offset, shift, limit) {
        ((offset < 0) ○○ (offset > limit) ○○ (offset % shift > 0)) {
            out no
        }
        out yes
    }

    skill fetch(prog, role, into) {
        @r = places.reg(role)
        (r < 0) {
            prog = writer.pool_literal(prog, 15, places.addr(role))
            out writer.emit3(prog, coder.l32i(into, 15, 0))
        }
        (r == 14) {
            out writer.emit3(prog, coder.l32i(into, 1, 0))
        }
        (r == 15) {
            out writer.emit3(prog, coder.l32i(into, 1, 4))
        }
        (r == 1) {
            out writer.emit3(prog, coder.addi(into, 1, 8))
        }
        (r == into) {
            out prog
        }
        out writer.emit3(prog, coder.or_word(into, r, r))
    }

    skill deliver(prog, role, from) {
        @r = places.reg(role)
        (r < 0) {
            prog = writer.pool_literal(prog, 15, places.addr(role))
            out writer.emit3(prog, coder.s32i(from, 15, 0))
        }
        (r == from) {
            out prog
        }
        out writer.emit3(prog, coder.or_word(r, from, from))
    }

    skill finish(prog, role) {
        @r = places.reg(role)
        (r == 14) {
            prog = writer.emit3(prog, coder.l32i(15, 1, 4))
            out drop(prog)
        }
        (r == 15) {
            prog = writer.emit3(prog, coder.or_word(15, 14, 14))
            prog = writer.emit3(prog, coder.l32i(14, 1, 0))
            out drop(prog)
        }
        (r == 1) {
            prog = writer.emit3(prog, coder.l32i(15, 1, 0))
            prog = writer.emit3(prog, coder.s32i(14, 1, 0))
            prog = writer.emit3(prog, coder.or_word(14, 15, 15))
            prog = writer.emit3(prog, coder.l32i(15, 1, 4))
            out writer.emit3(prog, coder.l32i(1, 1, 0))
        }
        (r >= 0) {
            prog = writer.emit3(prog, coder.or_word(r, 14, 14))
        }
        (r < 0) {
            prog = deliver(prog, role, 14)
        }
        out unspill(prog)
    }

    skill op_load(prog, dest, base, offset, width) {
        (width == 1) {
            out writer.emit3(prog, coder.l8ui(dest, base, offset))
        }
        (width == 2) {
            out writer.emit3(prog, coder.l16ui(dest, base, offset))
        }
        out writer.emit3(prog, coder.l32i(dest, base, offset))
    }

    skill op_store(prog, src, base, offset, width) {
        (width == 1) {
            out writer.emit3(prog, coder.s8i(src, base, offset))
        }
        (width == 2) {
            out writer.emit3(prog, coder.s16i(src, base, offset))
        }
        out writer.emit3(prog, coder.s32i(src, base, offset))
    }

    skill limit_of(width) {
        (width == 1) {
            out 255
        }
        (width == 2) {
            out 510
        }
        out 1020
    }

    skill load_from(prog, dest_role, base_role, offset, width) {
        @base = places.reg(base_role)
        @dest = places.reg(dest_role)
        (((base >= 0) ○ (dest >= 0)) ○ (fits_range(offset, width, limit_of(width)) == yes)) {
            out op_load(prog, dest, base, offset, width)
        }
        prog = spill(prog)
        prog = fetch(prog, base_role, 14)
        (fits_range(offset, width, limit_of(width)) == yes) {
            prog = op_load(prog, 14, 14, offset, width)
            out finish(prog, dest_role)
        }
        prog = writer.pool_literal(prog, 15, offset)
        prog = writer.emit3(prog, coder.add_word(14, 14, 15))
        prog = op_load(prog, 14, 14, 0, width)
        out finish(prog, dest_role)
    }

    skill store_to(prog, src_role, base_role, offset, width) {
        @base = places.reg(base_role)
        @src = places.reg(src_role)
        (((base >= 0) ○ (src >= 0)) ○ (fits_range(offset, width, limit_of(width)) == yes)) {
            out op_store(prog, src, base, offset, width)
        }
        prog = spill(prog)
        prog = fetch(prog, src_role, 14)
        prog = fetch(prog, base_role, 15)
        (fits_range(offset, width, limit_of(width)) == yes) {
            prog = op_store(prog, 14, 15, offset, width)
            out unspill(prog)
        }
        prog = writer.emit3(prog, coder.addi(1, 1, 0 - 4))
        prog = writer.emit3(prog, coder.s32i(14, 1, 0))
        prog = writer.pool_literal(prog, 14, offset)
        prog = writer.emit3(prog, coder.add_word(15, 15, 14))
        prog = writer.emit3(prog, coder.l32i(14, 1, 0))
        prog = writer.emit3(prog, coder.addi(1, 1, 4))
        prog = op_store(prog, 14, 15, 0, width)
        out unspill(prog)
    }

    skill zero(prog, base_role, offset, width) {
        prog = spill(prog)
        prog = fetch(prog, base_role, 15)
        (fits_range(offset, width, limit_of(width)) == yes) {
            prog = writer.emit3(prog, coder.movi(14, 0))
            prog = op_store(prog, 14, 15, offset, width)
            out unspill(prog)
        }
        prog = writer.pool_literal(prog, 14, offset)
        prog = writer.emit3(prog, coder.add_word(15, 15, 14))
        prog = writer.emit3(prog, coder.movi(14, 0))
        prog = op_store(prog, 14, 15, 0, width)
        out unspill(prog)
    }
}
