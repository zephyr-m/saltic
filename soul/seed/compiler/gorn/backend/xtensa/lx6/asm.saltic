-- asm — поток команд Xtensa: байты, метки, правки L32R/J/CALL0.
-- Пул литералов встаёт перед кодом в IRAM. Адрес кода зависит от длины пула,
-- поэтому L32R дописывается в конце. Начало и размер BSS — служебные метки
-- BSS_START и BSS_SIZE для load_address. Куча больше HEAP_LIMIT — ошибка.
-- Хозяин — Assembler { coder } (СОП, 22.11.2026): навыки ниже — его методы.

use core.group
use core.bytes
use io
use compiler.gorn.backend.buffer
use compiler.gorn.backend.xtensa.lx6.encode
use formats.esp.image

SEC_CODE = 0
SEC_RODATA = 1
SEC_DATA = 2
SEC_BSS = 3
FIX_J = 0
FIX_CALL = 1
FIX_LIT = 2
FIX_LABEL = 3
BSS_START = "xt_bss_start"
BSS_SIZE = "xt_bss_size"
HEAP_LIMIT = 65536

XtLabel = Box {
    xt_name = "",
    xt_section = 0,
    xt_at = 0
}

XtFix = Box {
    xt_kind = 0,
    xt_at = 0,
    xt_reg = 0,
    xt_name = "",
    xt_add = 0,
    xt_value = 0,
    xt_slot = 0
}

XtProg = Box {
    xt_code = none,
    xt_rodata = none,
    xt_data = none,
    xt_bss = 0,
    xt_labels = [],
    xt_fixes = [],
    xt_entry = "_start"
}

Assembler = Box {
    coder = encode.Encoder {}

    skill pack(b0, b1, b2, b3) {
        out b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    }

    skill iram() {
        out pack(0, 4, 8, 64)
    }

    skill dram() {
        out pack(0, 0, 251, 63)
    }

    skill fresh(entry) {
        out XtProg {
            xt_code = buffer.empty(),
            xt_rodata = buffer.empty(),
            xt_data = buffer.empty(),
            xt_bss = 0,
            xt_labels = [],
            xt_fixes = [],
            xt_entry = entry
        }
    }

    skill emit3(prog, word) {
        @prog_xt_code = prog.xt_code
        prog_xt_code.append_byte(word % 256)
        prog_xt_code = prog.xt_code
        prog_xt_code.append_byte(word / 256 % 256)
        prog_xt_code = prog.xt_code
        prog_xt_code.append_byte(word / 65536 % 256)
        out prog
    }

    skill emit2(prog, word) {
        @prog_xt_code = prog.xt_code
        prog_xt_code.append_byte(word % 256)
        prog_xt_code = prog.xt_code
        prog_xt_code.append_byte(word / 256 % 256)
        out prog
    }

    skill poke3(prog, at, word) {
        @prog_xt_code = prog.xt_code
        prog_xt_code.set_byte(at, word % 256)
        prog_xt_code = prog.xt_code
        prog_xt_code.set_byte(at + 1, word / 256 % 256)
        prog_xt_code = prog.xt_code
        prog_xt_code.set_byte(at + 2, word / 65536 % 256)
        out prog
    }

    skill align4(prog) {
        @n = prog.xt_code.length % 4
        (n == 0) {
            out prog
        }
        (n == 1) {
            out emit3(prog, coder.nop())
        }
        (n == 2) {
            out emit2(prog, coder.mov_n(0, 0))
        }
        prog = emit3(prog, coder.nop())
        out emit2(prog, coder.mov_n(0, 0))
    }

    skill note_fix(prog, kind, reg, name, add, value) {
        @fix = XtFix {
            xt_kind = kind,
            xt_at = prog.xt_code.length - 3,
            xt_reg = reg,
            xt_name = name,
            xt_add = add,
            xt_value = value,
            xt_slot = 0
        }
        prog.xt_fixes = group.add(prog.xt_fixes, fix)
        out prog
    }

    skill pool_literal(prog, reg, value) {
        prog = emit3(prog, coder.l32r(reg, 0))
        out note_fix(prog, FIX_LIT, reg, "", 0, value)
    }

    skill jump_to(prog, name) {
        prog = emit3(prog, coder.jump_word(0))
        out note_fix(prog, FIX_J, 0, name, 0, 0)
    }

    skill call_to(prog, name) {
        prog = align4(prog)
        prog = emit3(prog, coder.call0(0))
        out note_fix(prog, FIX_CALL, 0, name, 0, 0)
    }

    skill label_addr_fix(prog, reg, name, add) {
        prog = emit3(prog, coder.l32r(reg, 0))
        out note_fix(prog, FIX_LABEL, reg, name, add, 0)
    }

    skill label_at(prog, name) {
        drum (group.count(prog.xt_labels)) {
            @item = group.get(prog.xt_labels, beat)
            (item.xt_name == name) {
                out item
            }
        }
        out none
    }

    skill define(prog, section, name) {
        (section == SEC_CODE) {
            prog = align4(prog)
        }
        @at = prog.xt_code.length
        (section == SEC_RODATA) {
            at = prog.xt_rodata.length
        }
        (section == SEC_DATA) {
            at = prog.xt_data.length
        }
        (section == SEC_BSS) {
            at = prog.xt_bss
        }
        @label = XtLabel {
            xt_name = name,
            xt_section = section,
            xt_at = at
        }
        prog.xt_labels = group.add(prog.xt_labels, label)
        out prog
    }

    skill section_buf(prog, section) {
        (section == SEC_RODATA) {
            out prog.xt_rodata
        }
        (section == SEC_DATA) {
            out prog.xt_data
        }
        out prog.xt_code
    }

    skill put_buf(prog, section, buf) {
        (section == SEC_RODATA) {
            prog.xt_rodata = buf
        }
        (section == SEC_DATA) {
            prog.xt_data = buf
        }
        (section == SEC_CODE) {
            prog.xt_code = buf
        }
        out prog
    }

    skill pad_buf(buf, boundary) {
        (boundary < 2) {
            out buf
        }
        @n = buf.length % boundary
        (n == 0) {
            out buf
        }
        buf.append_zeroes(boundary - n)
        out buf
    }

    skill align_in(prog, section, boundary) {
        (section == SEC_BSS) {
            (boundary < 2) {
                out prog
            }
            @n = prog.xt_bss % boundary
            (n == 0) {
                out prog
            }
            prog.xt_bss = prog.xt_bss + boundary - n
            out prog
        }
        out put_buf(prog, section, pad_buf(section_buf(prog, section), boundary))
    }

    skill add_byte(prog, section, value) {
        @target = section_buf(prog, section)
        target.append_byte(value)
        out put_buf(prog, section, target)
    }

    skill add_word(prog, section, value) {
        prog = add_byte(prog, section, value.b0)
        prog = add_byte(prog, section, value.b1)
        prog = add_byte(prog, section, value.b2)
        out add_byte(prog, section, value.b3)
    }

    skill add_text(prog, section, text) {
        @target = section_buf(prog, section)
        target.append_text(text)
        out put_buf(prog, section, target)
    }

    skill reserve(prog, count) {
        (count > HEAP_LIMIT) {
            io.show("куча {count} байт больше {HEAP_LIMIT}")
            out error.ValueOutsideRange
        }
        prog.xt_bss = prog.xt_bss + count
        out prog
    }

    skill here(prog, name, add, code_base, data_base) {
        @item = label_at(prog, name)
        (item == none) {
            out 0 - 1
        }
        (item.xt_section == SEC_CODE) {
            out code_base + item.xt_at + add
        }
        (item.xt_section == SEC_RODATA) {
            out data_base + item.xt_at + add
        }
        (item.xt_section == SEC_DATA) {
            out data_base + prog.xt_rodata.length + item.xt_at + add
        }
        out data_base + prog.xt_rodata.length + prog.xt_data.length + item.xt_at + add
    }

    skill pool_value(prog, fix, code_base, data_base, base, size) {
        (fix.xt_kind == FIX_LIT) {
            out fix.xt_value
        }
        (fix.xt_name == BSS_START) {
            out base
        }
        (fix.xt_name == BSS_SIZE) {
            out size
        }
        out here(prog, fix.xt_name, fix.xt_add, code_base, data_base)
    }

    skill fill_pool(prog, pool, code_base, data_base, base, size) {
        drum (group.count(prog.xt_fixes)) {
            @fix = group.get(prog.xt_fixes, beat)
            (fix.xt_kind > FIX_CALL) {
                @value = pool_value(prog, fix, code_base, data_base, base, size)
                ((fix.xt_kind == FIX_LABEL) ○ (value < 0)) {
                    io.show("метка {fix.xt_name}")
                    out error.XtensaLink
                }
                @pc = code_base + fix.xt_at
                @literal = iram() + fix.xt_slot * 4
                prog = poke3(prog, fix.xt_at, coder.l32r_at(fix.xt_reg, pc, literal))
                pool = group.add(pool, value)
            }
        }
        out pool
    }

    skill fill_jump(prog, code_base) {
        drum (group.count(prog.xt_fixes)) {
            @fix = group.get(prog.xt_fixes, beat)
            (fix.xt_kind < FIX_LIT) {
                @target = here(prog, fix.xt_name, 0, code_base, 0)
                (target < 0) {
                    io.show("метка {fix.xt_name}")
                    out error.XtensaLink
                }
                @pc = code_base + fix.xt_at
                @distance = target - pc
                (fix.xt_kind == FIX_CALL) {
                    prog = poke3(prog, fix.xt_at, coder.call0(distance))
                }
                (fix.xt_kind == FIX_J) {
                    prog = poke3(prog, fix.xt_at, coder.jump_word(distance))
                }
            }
        }
        out prog
    }

    skill image_of(prog) {
        @slot = 0
        drum (group.count(prog.xt_fixes)) {
            @fix = group.get(prog.xt_fixes, beat)
            (fix.xt_kind > FIX_CALL) {
                fix.xt_slot = slot
                slot = slot + 1
            }
        }
        @code_base = iram() + slot * 4
        @data_base = dram()
        @base = data_base + prog.xt_rodata.length + prog.xt_data.length
        @size = prog.xt_bss
        @rest = size % 4
        (rest > 0) {
            size = size + 4 - rest
        }
        @pool = fill_pool(prog, [], code_base, data_base, base, size)
        prog = fill_jump(prog, code_base)
        @blob = buffer.empty()
        drum (group.count(pool)) {
            @value = group.get(pool, beat)
            (value < 0) {
                value = value + 4294967296
            }
            blob.append_byte(value % 256)
            blob.append_byte(value / 256 % 256)
            blob.append_byte(value / 65536 % 256)
            blob.append_byte(value / 16777216 % 256)
        }
        blob.append_buffer(prog.xt_code)
        blob = pad_buf(blob, 4)
        @data = buffer.empty()
        data.append_buffer(prog.xt_rodata)
        data.append_buffer(prog.xt_data)
        data = pad_buf(data, 4)
        (label_at(prog, "platform_start") == none) {
            io.show("нет входа")
            out error.XtensaLink
        }
        @entry_at = here(prog, "platform_start", 0, code_base, data_base)
        out image.app(entry_at, iram(), blob.whole(), data_base, data.whole())
    }
}
