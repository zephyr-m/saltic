-- layout — программа в сборке, общая для всех исполнителей: секции
-- code/rodata/data/bss, метки, общие правки (patch) и их разрешение в адреса.
-- Program — хозяин своих навыков (СОП, 22.11.2026): меняет себя на месте,
-- после изменения resolved = no. Правки семьи — у чинильщика в Program.fixer:
-- resolve чинит общие сам (resolve_own), остальное отдаёт fixer.fixed.
-- Раскладка: rodata на 8, data на 4096, bss на 8 после data. Метки — хеш-корзины.
--
-- Section = enum { CODE, RODATA, DATA, BSS }; PatchKind = enum { ADDRESS_WORD, REL32, ABS32 }
-- Label { name, section, offset, present, next } / LabelBucket { labels } — в корзине
--     копии меток без next (иначе проверка цикла обходила бы все новые)
-- Patch { kind, section, offset, label, addend } — REL32: rel32 от конца поля,
--     ABS32 — адрес метки + addend, ADDRESS_WORD — слово-адрес в секции
-- Layout { code_offset, rodata_offset, data_offset, bss_offset, file_size, memory_size }
-- Program { load_address, low_memory_size, entry, code, rodata, data, bss_size,
--     heap_size, labels_*, patches_*, resolved, far_calls, encoding_errors, fixer }:
--     меняют: emit_word(word), note_patch(Patch), define_label(section, name) —
--     DuplicateLabel, reserve_bss(wide), align_section(section, boundary),
--     append_section_byte / _word / _text(section, …), append_label_address(section,
--     label, addend), set_section_word(section, offset, word), assign_section,
--     resolve_patch(layout, patch) — UnknownPatch, resolve_own() — InstructionEncoding;
--     отвечают: section_buffer / section_length(section), find_label(name) -> Label,
--     layout() -> Layout, label_offset(layout, name) / label_address(layout, name,
--     addend) — UnknownLabel, patches() -> сколько правок ждёт (общие и семьи),
--     payload(layout) -> Buffer тела образа: code, rodata, data по раскладке
-- host(entry) / qemu_virt(entry) -> Program (адрес 65536 с низкой памятью / 0x80000000)
-- word_address(b0, b1, b2, b3) / address_from_number(n) / address_add(word, n) -> Word;
--     InvalidAddress, AddressOverflow; align(value, boundary) — InvalidAlignment
-- align_buffer(buffer, boundary); label_hash / index_label; section_offset(layout, section)
-- resolve(program) -> Program — общие правки и правки семьи; UnresolvedPatch

use core.str
use core.group
use io
use core.num
use compiler.machine.word
use compiler.machine.wide
use compiler.gorn.backend.buffer
use compiler.errors

Section = enum {
    CODE,
    RODATA,
    DATA,
    BSS
}

PatchKind = enum {
    ADDRESS_WORD,
    REL32,
    ABS32
}

LABEL_BUCKETS = 512

Label = Box {
    name = "",
    section = Section.CODE,
    offset = 0,
    present = no,
    next = none
}

LabelBucket = Box {
    labels = []
}

Patch = Box {
    kind = PatchKind.ADDRESS_WORD,
    section = Section.CODE,
    offset = 0,
    label = "",
    addend = 0,
    next = none
}

Layout = Box {
    code_offset = 0,
    rodata_offset = 0,
    data_offset = 0,
    bss_offset = 0,
    file_size = 0,
    memory_size = wide.Wide {}
}

Program = Box {
    load_address = word.Word {},
    low_memory_size = 0,
    entry = "",
    code = buffer.Buffer {},
    rodata = buffer.Buffer {},
    data = buffer.Buffer {},
    bss_size = wide.Wide {},
    heap_size = wide.Wide {},
    labels_first = none,
    labels_last = none,
    label_buckets = [],
    label_count = 0,
    patches_first = none,
    patches_last = none,
    patch_count = 0,
    resolved = no,
    far_calls = no,
    encoding_errors = 0,
    fixer = none

    skill assign_section(section, target) {
        (section == Section.CODE) { code = target }
        (section == Section.RODATA) { rodata = target }
        (section == Section.DATA) { data = target }
        resolved = no
        out none
    }

    skill emit_word(encoded) {
        code.append_word(encoded)
        resolved = no
        out none
    }

    skill note_patch(patch) {
        (patch_count == 0) { patches_first = patch }
        (patch_count > 0) { patches_last.next = patch }
        patches_last = patch
        patch_count = patch_count + 1
        resolved = no
        out none
    }

    skill define_label(section, name) {
        @old = find_label(name)
        (old.present == yes) { out error.DuplicateLabel }
        @label = Label {
            name = name,
            section = section,
            offset = section_length(section),
            present = yes
        }
        (label_count == 0) { labels_first = label }
        (label_count > 0) { labels_last.next = label }
        labels_last = label
        label_count = label_count + 1
        index_label(label_bucket(name), Label { name = name, section = section, offset = label.offset, present = yes })
        resolved = no
        out none
    }

    skill reserve_bss(count) {
        bss_size = wide.add(bss_size, count)
        resolved = no
        out none
    }

    skill append_section_byte(section, byte) {
        @target = section_buffer(section)
        target.append_byte(byte)
        assign_section(section, target)
        out none
    }

    skill append_section_word(section, data_value) {
        @target = section_buffer(section)
        target.append_word(data_value)
        assign_section(section, target)
        out none
    }

    skill append_section_text(section, text, terminated) {
        @target = section_buffer(section)
        target.append_text(text)
        (terminated == yes) {
            target.append_byte(0)
        }
        assign_section(section, target)
        out none
    }

    skill align_section(section, boundary) {
        (section == Section.BSS) {
            bss_size = wide.align(bss_size, boundary)
            resolved = no
            out none
        }
        @target = section_buffer(section)
        target = align_buffer(target, boundary)
        assign_section(section, target)
        out none
    }

    skill append_label_address(section, label, addend) {
        @target = section_buffer(section)
        @offset = target.length
        target.append_word(word.from_bytes(0, 0, 0, 0))
        assign_section(section, target)
        @patch = Patch {
            kind = PatchKind.ADDRESS_WORD,
            section = section,
            offset = offset,
            label = label,
            addend = addend
        }
        (patch_count == 0) { patches_first = patch }
        (patch_count > 0) { patches_last.next = patch }
        patches_last = patch
        patch_count = patch_count + 1
        resolved = no
        out none
    }

    skill set_section_word(section, offset, data_value) {
        @target = section_buffer(section)
        target.set_word(offset, data_value)
        assign_section(section, target)
        out none
    }

    skill resolve_patch(current_layout, patch) {
        @label_base = label_offset(current_layout, patch.label) rescue |failure| {
            (str.bytes(patch.label) > 0) {
                @problem = errors.missing_label(patch.label)
                io.show(problem.message)
            }
            out error.UnknownLabel
        }
        @target_offset = label_base + patch.addend
        (patch.kind == PatchKind.ADDRESS_WORD) {
            @target = label_address(current_layout, patch.label, patch.addend)
            set_section_word(patch.section, patch.offset, target)
            out none
        }
        (patch.kind == PatchKind.REL32) {
            @distance = target_offset - patch.offset - 4
            set_section_word(Section.CODE, patch.offset, word.from_signed(distance))
            out none
        }
        (patch.kind == PatchKind.ABS32) {
            @target = label_address(current_layout, patch.label, patch.addend)
            set_section_word(Section.CODE, patch.offset, target)
            out none
        }
        out error.UnknownPatch
    }

    skill resolve_own() {
        (encoding_errors > 0) {
            @problem = errors.encoding_failed(encoding_errors)
            io.show(problem.message)
            out error.InstructionEncoding
        }
        @current_layout = layout()
        @patch = patches_first
        drum (patch_count) {
            (patch) |item| {
                resolve_patch(current_layout, item) rescue |failure| {
                    out error.UnresolvedPatch
                }
                patch = item.next
            }
        }
        out none
    }

    skill section_buffer(section) {
        (section == Section.CODE) { out code }
        (section == Section.RODATA) { out rodata }
        (section == Section.DATA) { out data }
        out error.SectionHasNoFileData
    }

    skill section_length(section) {
        (section == Section.CODE) { out code.length }
        (section == Section.RODATA) { out rodata.length }
        (section == Section.DATA) { out data.length }
        out wide.to_word(bss_size)
    }

    skill label_bucket(name) {
        (group.count(label_buckets) == 0) {
            @buckets = []
            drum (LABEL_BUCKETS) { buckets = group.add(buckets, LabelBucket {}) }
            label_buckets = buckets
        }
        out group.get(label_buckets, label_hash(name))
    }

    skill find_label(name) {
        (label_count == 0) { out Label {} }
        @bucket = label_bucket(name)
        drum (bucket.labels) {
            (beat.name == name) { out beat }
        }
        out Label {}
    }

    skill layout() {
        @rodata_offset = align(code.length, 8)
        @data_offset = align(rodata_offset + rodata.length, 4096)
        @bss_offset = align(data_offset + data.length, 8)
        out Layout {
            code_offset = 0,
            rodata_offset = rodata_offset,
            data_offset = data_offset,
            bss_offset = bss_offset,
            file_size = bss_offset,
            memory_size = wide.add_number(bss_size, bss_offset)
        }
    }

    skill label_offset(current_layout, name) {
        @label = find_label(name)
        (label.present == no) { out error.UnknownLabel }
        (label.section == Section.BSS) {
            out word.to_number(word.add_number(label.offset, current_layout.bss_offset))
        }
        out section_offset(current_layout, label.section) + label.offset
    }

    skill label_address(current_layout, name, addend) {
        @label = find_label(name)
        (label.present == no) { out error.UnknownLabel }
        (label.section == Section.BSS) {
            @offset = word.add_number(label.offset, current_layout.bss_offset + addend)
            out word.add(load_address, offset)
        }
        @offset = label_offset(current_layout, name) + addend
        (offset < 0) { out error.InvalidAddress }
        out address_add(load_address, offset)
    }

    skill payload(current_layout) {
        @result = buffer.empty()
        result.append_buffer(code)
        result.pad_to(current_layout.rodata_offset)
        result.append_buffer(rodata)
        result.pad_to(current_layout.data_offset)
        result.append_buffer(data)
        result.pad_to(current_layout.file_size)
        out result
    }

    skill patches() {
        @total = patch_count
        (fixer) |keeper| {
            total = total + keeper.count
        }
        out total
    }
}

skill word_address(b0, b1, b2, b3) {
    drum ([b0, b1, b2, b3]) {
        (beat < 0) { out error.InvalidAddress }
        (beat > 255) { out error.InvalidAddress }
    }
    out word.from_bytes(b0, b1, b2, b3)
}

skill address_from_number(value) {
    out word.from_number(value)
}

skill address_add(value, amount) {
    (amount < 0) { out error.InvalidAddress }
    @v0 = value.b0 + amount % 256
    amount = amount / 256
    @v1 = value.b1 + amount % 256 + v0 / 256
    amount = amount / 256
    @v2 = value.b2 + amount % 256 + v1 / 256
    amount = amount / 256
    @v3 = value.b3 + amount % 256 + v2 / 256
    (v3 > 255) { out error.AddressOverflow }
    out word.from_bytes(v0 % 256, v1 % 256, v2 % 256, v3)
}

skill align(value, boundary) {
    (boundary < 1) { out error.InvalidAlignment }
    out num.align(value, boundary)
}

skill host(entry) {
    out Program {
        load_address = address_from_number(65536),
        low_memory_size = 65536,
        entry = entry
    }
}

skill qemu_virt(entry) {
    out Program {
        load_address = word_address(0, 0, 0, 128),
        entry = entry
    }
}

skill align_buffer(target, boundary) {
    @target_length = align(target.length, boundary)
    target.append_zeroes(target_length - target.length)
    out target
}

skill label_hash(name) {
    @hash = 0
    drum (str.bytes(name)) { hash = hash + str.byte(name, beat) * (beat + 1) }
    out hash % LABEL_BUCKETS
}

skill index_label(bucket, label) {
    bucket.labels = group.add(bucket.labels, label)
    out bucket
}

skill section_offset(current_layout, section) {
    (section == Section.CODE) { out current_layout.code_offset }
    (section == Section.RODATA) { out current_layout.rodata_offset }
    (section == Section.DATA) { out current_layout.data_offset }
    out current_layout.bss_offset
}

skill resolve(value) {
    value.resolve_own()
    @current_layout = value.layout()
    (value.fixer) |keeper| {
        value = keeper.fixed(value, current_layout) rescue |failure| {
            out error.UnresolvedPatch
        }
    }
    value.resolved = yes
    out value
}
