-- patch — общая правка программы в сборке (решение автора: общее не знает
-- семью): слово по метке, которое resolve дописывает, когда метки на местах.
-- Правки семей — у их чинильщиков (Program.fixer).
--
-- Patch { kind, section, offset, label, addend, next } — Kind = enum {
--     ADDRESS_WORD — слово-адрес метки + addend в секции, REL32 — 4 байта rel32
--     от конца поля, ABS32 — адрес метки + addend в коде } (снаружи Patch.Kind.REL32)

use compiler.gorn.backend.layout

Patch = Box {
    kind = Kind.ADDRESS_WORD,
    section = Layout.Section.CODE,
    offset = 0,
    label = "",
    addend = 0,
    next = none

    Kind = enum {
        ADDRESS_WORD,
        REL32,
        ABS32
    }
}
