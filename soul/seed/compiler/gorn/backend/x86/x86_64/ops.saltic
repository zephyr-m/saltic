-- ops — операции договора над ролями: пересылки, арифметика, логика, сдвиги,
-- сравнения в 0/1. Ширина команд — billet.words.bytes: 4 в окне гостя, 8 без окна; роли в памяти (roles.MEMORY)
-- проходят через временный регистр с push/pop. STACK (rsp) — особые случаи:
-- move(to, STACK) = mov r64, rsp; sub r64, r14; move(STACK, from) = lea rsp,
-- [r14 + from]; add_immediate(STACK, STACK, n) = add rsp, n.
--
-- move / negate(billet, to, from)
-- operate_binary(billet, op, to, left, right, commutative) — add/sub/and/or/xor;
--     STACK среди операндов — только add (stack_plus: lea от rsp минус r14)
-- immediate_op(billet, op, to, from, value) — add/and/or/xor с числом
-- add_immediate(billet, to, from, value) — с особыми случаями STACK
-- shift(billet, op, to, from, amount) / shift_by(billet, op, to, from, count)
-- compare(code, size, left, right) -> code — cmp ролей (флаги)
-- compare_immediate(code, size, role, value) -> code — cmp роли с числом
-- test(code, size, role) -> code — test роли на ноль
-- set(billet, condition, to) — setcc + movzx в роль
-- load_immediate(billet, to, value) / load_word(billet, to, word) — слово
--     со знаком (без окна — movabs с расширением знака); copy_word(code, size, r, word)
-- wide_arith(billet, kind, to, left, right) — без окна: WIDE_MULTIPLY (imul),
--     _HIGH / _HIGH_UNSIGNED (imul / mul → rdx), WIDE_DIVIDE / REMAINDER (cqo +
--     idiv), _UNSIGNED (div); rax, rdx, rcx сохраняются на стеке
-- load_wide(billet, to, wide) — movabs 64-битной константы
-- fraction(billet, kind, to, left, right) — дробные на SSE2 через xmm0/xmm1:
--     backend.FRACTION_* (addsd / subsd / mulsd / divsd, comisd + setb / setbe),
--     FRACTION_FROM (cvtsi2sd), FRACTION_TO + mode (cvtsd2si / cvttsd2si); rax,
--     rdx, rcx сохраняются; sse(code, bytes) — байты команды как есть
-- Хозяин — Ops { coder, places } (СОП, 22.11.2026): навыки ниже — его методы.

use core.group
use compiler.gorn.backend
use compiler.machine.word
use compiler.gorn.backend.buffer
use compiler.gorn.backend.x86.x86_64.encoder
use compiler.gorn.backend.x86.x86_64.roles

WIDE_MULTIPLY = 0
WIDE_MULTIPLY_HIGH = 1
WIDE_MULTIPLY_HIGH_UNSIGNED = 2
WIDE_DIVIDE = 3
WIDE_REMAINDER = 4
WIDE_DIVIDE_UNSIGNED = 5
WIDE_REMAINDER_UNSIGNED = 6
FRACTION_FROM = 6
FRACTION_TO = 7
SSE_ARITHMETIC = [88, 92, 89, 94]
SSE_TO_XMM0 = [102, 72, 15, 110, 192]
SSE_TO_XMM1 = [102, 72, 15, 110, 201]
SSE_FROM_XMM0 = [102, 72, 15, 126, 192]
CONDITION_BELOW = 2
CONDITION_BELOW_EQUAL = 6

Ops = Box {
    coder = encoder.Encoder {},
    places = roles.Roles {}

    skill with_temp(code, avoid1, avoid2) {
        out places.temp(avoid1, avoid2, encoder.NONE)
    }

    skill move(billet, to, from) {
        @size = billet.words.bytes
        @code = billet.machine.code
        (to == from) { out billet }
        (from == backend.STACK) {
            @target = places.register(to)
            (target == roles.MEMORY) {
                @x = with_temp(code, encoder.NONE, encoder.NONE)
                code = coder.register64(code, encoder.PUSH, x)
                code = coder.memory(code, encoder.ADDRESS64, x, encoder.RSP, encoder.NONE, 8)
                code = coder.operate(code, 8, encoder.SUB, x, encoder.R14)
                code = places.store_into(code, size, to, x)
                out places.emit(billet, coder.register64(code, encoder.POP, x))
            }
            code = coder.operate(code, 8, encoder.MOVE, target, encoder.RSP)
            out places.emit(billet, coder.operate(code, 8, encoder.SUB, target, encoder.R14))
        }
        (to == backend.STACK) {
            (places.in_memory(from) == yes) {
                code = coder.memory(code, places.load_form(size), encoder.RSP, encoder.R14, encoder.NONE, places.slot(from, size))
                out places.emit(billet, coder.operate(code, 8, encoder.ADD, encoder.RSP, encoder.R14))
            }
            out places.emit(billet, coder.memory(code, encoder.ADDRESS64, encoder.RSP, encoder.R14, places.register(from), 0))
        }
        @target = places.register(to)
        (target == roles.MEMORY) {
            (places.in_memory(from) == yes) {
                @x = with_temp(code, encoder.NONE, encoder.NONE)
                code = coder.register64(code, encoder.PUSH, x)
                code = places.move_into(code, size, x, from)
                code = places.store_into(code, size, to, x)
                out places.emit(billet, coder.register64(code, encoder.POP, x))
            }
            out places.emit(billet, places.store_into(code, size, to, places.register(from)))
        }
        out places.emit(billet, places.move_into(code, size, target, from))
    }

    skill negate(billet, to, from) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @target = places.register(to)
        (target == roles.MEMORY) {
            @x = with_temp(code, places.register(from), encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = places.move_into(code, size, x, from)
            code = coder.unary(code, size, encoder.NEGATE, x)
            code = places.store_into(code, size, to, x)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        code = places.move_into(code, size, target, from)
        out places.emit(billet, coder.unary(code, size, encoder.NEGATE, target))
    }

    skill stack_plus(billet, to, right) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @target = places.register(to)
        @second = places.register(right)
        (target == roles.MEMORY) {
            @x = with_temp(code, second, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            pick {
                (second == roles.MEMORY) {
                    code = coder.memory(code, encoder.ADDRESS64, x, encoder.RSP, encoder.NONE, 8)
                    code = places.operate_from(code, size, encoder.ADD, x, right)
                }
                { code = coder.memory(code, encoder.ADDRESS64, x, encoder.RSP, second, 8) }
            }
            code = coder.operate(code, 8, encoder.SUB, x, encoder.R14)
            code = places.store_into(code, size, to, x)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        pick {
            (second == roles.MEMORY) {
                code = coder.operate(code, 8, encoder.MOVE, target, encoder.RSP)
                code = places.operate_from(code, size, encoder.ADD, target, right)
            }
            { code = coder.memory(code, encoder.ADDRESS64, target, encoder.RSP, second, 0) }
        }
        out places.emit(billet, coder.operate(code, 8, encoder.SUB, target, encoder.R14))
    }

    skill operate_binary(billet, op, to, left, right, commutative) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @target = places.register(to)
        @first = places.register(left)
        @second = places.register(right)
        (left == backend.STACK) { out stack_plus(billet, to, right) }
        (right == backend.STACK) { out stack_plus(billet, to, left) }
        (target == roles.MEMORY) {
            @x = with_temp(code, first, second)
            code = coder.register64(code, encoder.PUSH, x)
            code = places.move_into(code, size, x, left)
            code = places.operate_from(code, size, op, x, right)
            code = places.store_into(code, size, to, x)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        (target == first) { out places.emit(billet, places.operate_from(code, size, op, target, right)) }
        (target == second) {
            (commutative == yes) { out places.emit(billet, places.operate_from(code, size, op, target, left)) }
            code = coder.unary(code, size, encoder.NEGATE, target)
            out places.emit(billet, places.operate_from(code, size, encoder.ADD, target, left))
        }
        code = places.move_into(code, size, target, left)
        out places.emit(billet, places.operate_from(code, size, op, target, right))
    }

    skill immediate_op(billet, op, to, from, value) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @target = places.register(to)
        (target == roles.MEMORY) {
            @x = with_temp(code, places.register(from), encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = places.move_into(code, size, x, from)
            code = coder.operate_immediate(code, size, op, x, value)
            code = places.store_into(code, size, to, x)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        code = places.move_into(code, size, target, from)
        out places.emit(billet, coder.operate_immediate(code, size, op, target, value))
    }

    skill add_immediate(billet, to, from, value) {
        @size = billet.words.bytes
        @code = billet.machine.code
        (to == backend.STACK) {
            (from == backend.STACK) { out places.emit(billet, coder.operate_immediate(code, 8, encoder.ADD, encoder.RSP, value)) }
            out places.emit(billet, coder.memory(code, encoder.ADDRESS64, encoder.RSP, encoder.R14, places.register(from), value))
        }
        (from == backend.STACK) {
            @target = places.register(to)
            (target == roles.MEMORY) {
                @x = with_temp(code, encoder.NONE, encoder.NONE)
                code = coder.register64(code, encoder.PUSH, x)
                code = coder.memory(code, encoder.ADDRESS64, x, encoder.RSP, encoder.NONE, value + 8)
                code = coder.operate(code, 8, encoder.SUB, x, encoder.R14)
                code = places.store_into(code, size, to, x)
                out places.emit(billet, coder.register64(code, encoder.POP, x))
            }
            code = coder.memory(code, encoder.ADDRESS64, target, encoder.RSP, encoder.NONE, value)
            out places.emit(billet, coder.operate(code, 8, encoder.SUB, target, encoder.R14))
        }
        out immediate_op(billet, encoder.ADD, to, from, value)
    }

    skill shift(billet, op, to, from, amount) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @target = places.register(to)
        (target == roles.MEMORY) {
            @x = with_temp(code, places.register(from), encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = places.move_into(code, size, x, from)
            code = coder.shift(code, size, op, x, amount)
            code = places.store_into(code, size, to, x)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        code = places.move_into(code, size, target, from)
        out places.emit(billet, coder.shift(code, size, op, target, amount))
    }

    skill shift_by(billet, op, to, from, count) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @target = places.register(to)
        @counter = places.register(count)
        (counter == encoder.ECX) {
            (target == roles.MEMORY) { out shift_by_memory(billet, op, to, from, count) }
            code = places.move_into(code, size, target, from)
            out places.emit(billet, coder.shift(code, size, op, target, encoder.BY_CL))
        }
        (target == encoder.ECX) { out shift_by_memory(billet, op, to, from, count) }
        (target == roles.MEMORY) { out shift_by_memory(billet, op, to, from, count) }
        code = coder.register64(code, encoder.PUSH, encoder.ECX)
        code = places.move_into(code, size, target, from)
        code = places.move_into(code, size, encoder.ECX, count)
        code = coder.shift(code, size, op, target, encoder.BY_CL)
        out places.emit(billet, coder.register64(code, encoder.POP, encoder.ECX))
    }

    skill shift_by_memory(billet, op, to, from, count) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @x = places.temp(encoder.ECX, places.register(count), places.register(to))
        code = coder.register64(code, encoder.PUSH, x)
        code = coder.register64(code, encoder.PUSH, encoder.ECX)
        code = places.move_into(code, size, x, from)
        code = places.move_into(code, size, encoder.ECX, count)
        code = coder.shift(code, size, op, x, encoder.BY_CL)
        code = coder.register64(code, encoder.POP, encoder.ECX)
        code = places.store_into(code, size, to, x)
        out places.emit(billet, coder.register64(code, encoder.POP, x))
    }

    skill compare(code, size, left, right) {
        @first = places.register(left)
        (first == roles.MEMORY) {
            @second = places.register(right)
            (second == roles.MEMORY) {
                @x = with_temp(code, encoder.NONE, encoder.NONE)
                code = coder.register64(code, encoder.PUSH, x)
                code = places.move_into(code, size, x, left)
                code = places.operate_from(code, size, encoder.CMP, x, right)
                out coder.register64(code, encoder.POP, x)
            }
            out coder.memory(code, places.to_memory(encoder.CMP, size), second, encoder.R14, encoder.NONE, places.slot(left, size))
        }
        out places.operate_from(code, size, encoder.CMP, first, right)
    }

    skill compare_immediate(code, size, role, value) {
        (places.in_memory(role) == yes) {
            code = coder.memory(code, places.cmp_memory_byte(size), 0, encoder.R14, encoder.NONE, places.slot(role, size))
            code.append_byte(value)
            out code
        }
        out coder.operate_immediate(code, size, encoder.CMP, places.register(role), value)
    }

    skill test(code, size, role) {
        (places.in_memory(role) == yes) { out compare_immediate(code, size, role, 0) }
        @target = places.register(role)
        out coder.operate(code, size, encoder.TEST, target, target)
    }

    skill set(billet, condition, to) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @target = places.register(to)
        (target == roles.MEMORY) {
            @x = with_temp(code, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = coder.set_condition(code, condition, x)
            code = places.store_into(code, size, to, x)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        out places.emit(billet, coder.set_condition(code, condition, target))
    }

    skill load_immediate(billet, to, value) {
        @size = billet.words.bytes
        @code = billet.machine.code
        (places.in_memory(to) == yes) {
            out places.emit(billet, coder.store_immediate(code, size, encoder.R14, encoder.NONE, places.slot(to, size), value))
        }
        out places.emit(billet, coder.operate_immediate(code, size, encoder.MOVE, places.register(to), value))
    }

    skill load_word(billet, to, data) {
        @size = billet.words.bytes
        @code = billet.machine.code
        (places.in_memory(to) == yes) {
            @x = with_temp(code, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = copy_word(code, size, x, data)
            code = places.store_into(code, size, to, x)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        out places.emit(billet, copy_word(code, size, places.register(to), data))
    }

    skill copy_word(code, size, target, data) {
        (size == 4) { out coder.move_word(code, target, data) }
        @fill = word.from_number(0)
        (data.b3 > 127) { fill = word.from_bytes(255, 255, 255, 255) }
        out coder.move_quad(code, target, data, fill)
    }

    skill saved_offset(register) {
        (register == encoder.EAX) { out 0 }
        (register == encoder.EDX) { out 8 }
        (register == encoder.ECX) { out 16 }
        out -1
    }

    skill wide_operand(code, target, role) {
        @source = places.register(role)
        @offset = saved_offset(source)
        pick {
            (source == target) { }
            (offset >= 0) { code = coder.memory(code, encoder.LOAD64, target, encoder.RSP, encoder.NONE, offset) }
            { code = places.move_into(code, 8, target, role) }
        }
        out code
    }

    skill wide_arith(billet, kind, to, left, right) {
        @code = billet.machine.code
        code = coder.register64(code, encoder.PUSH, encoder.ECX)
        code = coder.register64(code, encoder.PUSH, encoder.EDX)
        code = coder.register64(code, encoder.PUSH, encoder.EAX)
        code = wide_operand(code, encoder.ECX, right)
        code = wide_operand(code, encoder.EAX, left)
        @result = encoder.EAX
        pick {
            (kind == WIDE_MULTIPLY) { code = coder.operate(code, 8, encoder.MULTIPLY, encoder.EAX, encoder.ECX) }
            (kind == WIDE_MULTIPLY_HIGH) {
                code = coder.unary(code, 8, encoder.MULTIPLY_WIDE_SIGNED, encoder.ECX)
                result = encoder.EDX
            }
            (kind == WIDE_MULTIPLY_HIGH_UNSIGNED) {
                code = coder.unary(code, 8, encoder.MULTIPLY_WIDE_UNSIGNED, encoder.ECX)
                result = encoder.EDX
            }
            (kind < WIDE_DIVIDE_UNSIGNED) {
                code = coder.single(code, encoder.CQO)
                code = coder.unary(code, 8, encoder.DIVIDE, encoder.ECX)
                (kind == WIDE_REMAINDER) { result = encoder.EDX }
            }
            {
                code = coder.operate(code, 4, encoder.XOR, encoder.EDX, encoder.EDX)
                code = coder.unary(code, 8, encoder.DIVIDE_UNSIGNED, encoder.ECX)
                (kind == WIDE_REMAINDER_UNSIGNED) { result = encoder.EDX }
            }
        }
        @target = places.register(to)
        @offset = saved_offset(target)
        pick {
            (offset >= 0) { code = coder.memory(code, encoder.STORE64, result, encoder.RSP, encoder.NONE, offset) }
            { code = places.store_into(code, 8, to, result) }
        }
        code = coder.register64(code, encoder.POP, encoder.EAX)
        code = coder.register64(code, encoder.POP, encoder.EDX)
        out places.emit(billet, coder.register64(code, encoder.POP, encoder.ECX))
    }

    skill load_wide(billet, to, value) {
        @code = billet.machine.code
        (places.in_memory(to) == yes) {
            @x = with_temp(code, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = coder.move_quad(code, x, value.low, value.high)
            code = places.store_into(code, 8, to, x)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        out places.emit(billet, coder.move_quad(code, places.register(to), value.low, value.high))
    }

    skill sse(code, bytes) {
        drum (bytes) {
            code.append_byte(beat)
        }
        out code
    }

    skill fraction(billet, kind, to, left, right) {
        @code = billet.machine.code
        code = coder.register64(code, encoder.PUSH, encoder.ECX)
        code = coder.register64(code, encoder.PUSH, encoder.EDX)
        code = coder.register64(code, encoder.PUSH, encoder.EAX)
        code = wide_operand(code, encoder.ECX, right)
        code = wide_operand(code, encoder.EAX, left)
        pick {
            (kind == FRACTION_FROM) { code = sse(sse(code, [242, 72, 15, 42, 192]), SSE_FROM_XMM0) }
            (kind >= FRACTION_TO) {
                @convert = 45
                (kind == FRACTION_TO + backend.FRACTION_TRUNC) { convert = 44 }
                code = sse(sse(code, SSE_TO_XMM0), [242, 72, 15, convert, 192])
            }
            {
                code = sse(sse(code, SSE_TO_XMM0), SSE_TO_XMM1)
                pick {
                    (kind < backend.FRACTION_LESS) { code = sse(sse(code, [242, 15, group.get(SSE_ARITHMETIC, kind), 193]), SSE_FROM_XMM0) }
                    {
                        @condition = CONDITION_BELOW
                        (kind == backend.FRACTION_LESS_EQUAL) { condition = CONDITION_BELOW_EQUAL }
                        code = coder.set_condition(sse(code, [102, 15, 47, 193]), condition, encoder.EAX)
                    }
                }
            }
        }
        @target = places.register(to)
        @offset = saved_offset(target)
        pick {
            (offset >= 0) { code = coder.memory(code, encoder.STORE64, encoder.EAX, encoder.RSP, encoder.NONE, offset) }
            { code = places.store_into(code, 8, to, encoder.EAX) }
        }
        code = coder.register64(code, encoder.POP, encoder.EAX)
        code = coder.register64(code, encoder.POP, encoder.EDX)
        out places.emit(billet, coder.register64(code, encoder.POP, encoder.ECX))
    }
}
