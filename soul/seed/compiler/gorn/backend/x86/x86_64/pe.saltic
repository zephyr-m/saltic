-- pe — PE32+ для UEFI из layout.Program родного бэкенда: одна секция .text
-- (чтение, запись, исполнение) с RVA = адресу загрузки гостя (65536), так
-- что r14 = база образа и адрес гостя X — это RVA X; низкая память гостя
-- 0…65535 — заголовки и резерв образа (её никто не трогает). Тело секции —
-- payload (страница ячеек, код, rodata, data) и пустая таблица релокаций;
-- виртуальный размер — до конца стека гостя (bss, куча, строки, стек внутри
-- образа, стража нет). Вход — RVA метки machine.entry (x86_efi_main).
--
-- append_dos_header / append_coff_header(target) — заголовки
-- append_optional_header(target, entry_rva, raw_bytes, image_bytes, relocation_rva)
-- append_pe_section(target, raw_bytes, virtual_bytes)
-- build(machine) -> buffer PE32+; UnresolvedPatch
-- save(path, machine) — записать файл; WriteFailed
-- Хозяин — Pe32 { linux } (СОП, 22.11.2026): навыки ниже — его методы.

use core.num
use compiler.gorn.backend.layout
use compiler.gorn.backend.x86.x86_64.platform
use compiler.gorn.machine.word
use compiler.gorn.backend.buffer

PE_OFFSET = 64
HEADERS_BYTES = 512
FILE_ALIGNMENT = 512
SECTION_ALIGNMENT = 4096
SECTION_RVA = 65536
MACHINE_X86_64 = 34404
SECTION_COUNT = 1
OPTIONAL_HEADER_BYTES = 240
EXECUTABLE_IMAGE = 34
PE32_PLUS = 523
EFI_APPLICATION = 10
DIRECTORY_COUNT = 16
RELOCATION_DIRECTORY = 5
RELOCATION_BYTES = 12
STACK_RESERVE = 1048576

Pe32 = Box {
    linux = platform.LinuxRuntime {}

    skill append_dos_header(target) {
        target.append_text("MZ")
        target.pad_to(60)
        target.append_number32(PE_OFFSET)
        target.pad_to(PE_OFFSET)
        out target
    }

    skill append_coff_header(target) {
        target.append_text("PE")
        target.append_u16(0)
        target.append_u16(MACHINE_X86_64)
        target.append_u16(SECTION_COUNT)
        target.append_number32(0)
        target.append_number32(0)
        target.append_number32(0)
        target.append_u16(OPTIONAL_HEADER_BYTES)
        target.append_u16(EXECUTABLE_IMAGE)
        out target
    }

    skill append_optional_header(target, entry_rva, raw_bytes, image_bytes, relocation_rva) {
        target.append_u16(PE32_PLUS)
        target.append_u16(0)
        target.append_number32(raw_bytes)
        target.append_number32(raw_bytes)
        target.append_number32(0)
        target.append_number32(entry_rva)
        target.append_number32(SECTION_RVA)
        target.append_word(word.from_bytes(0, 0, 0, 16))
        target.append_number32(0)
        target.append_number32(SECTION_ALIGNMENT)
        target.append_number32(FILE_ALIGNMENT)
        target.append_number32(0)
        target.append_number32(0)
        target.append_number32(0)
        target.append_number32(0)
        target.append_word(image_bytes)
        target.append_number32(HEADERS_BYTES)
        target.append_number32(0)
        target.append_u16(EFI_APPLICATION)
        target.append_u16(0)
        drum (4) {
            target.append_number32(STACK_RESERVE)
            target.append_number32(0)
        }
        target.append_number32(0)
        target.append_number32(DIRECTORY_COUNT)
        drum (DIRECTORY_COUNT) {
            pick {
                (beat == RELOCATION_DIRECTORY) {
                    target.append_number32(relocation_rva)
                    target.append_number32(RELOCATION_BYTES)
                }
                {
                    target.append_number32(0)
                    target.append_number32(0)
                }
            }
        }
        out target
    }

    skill append_pe_section(target, raw_bytes, virtual_bytes) {
        target.append_text(".text")
        target.append_zeroes(3)
        target.append_word(virtual_bytes)
        target.append_number32(SECTION_RVA)
        target.append_number32(raw_bytes)
        target.append_number32(HEADERS_BYTES)
        target.append_number32(0)
        target.append_number32(0)
        target.append_u16(0)
        target.append_u16(0)
        target.append_word(word.from_bytes(224, 0, 0, 224))
        out target
    }

    skill build(machine) {
        (machine.resolved == no) {
            out error.UnresolvedPatch
        }
        @current = machine.layout()
        @guest = linux.map(machine)
        @body = machine.payload(current)
        @relocation_offset = num.align(body.length, 4)
        body.pad_to(relocation_offset)
        body.append_number32(SECTION_ALIGNMENT)
        body.append_number32(RELOCATION_BYTES)
        body.append_number32(0)
        @raw_bytes = num.align(body.length, FILE_ALIGNMENT)
        @image_end = word.align_page(word.add_number(guest.stack, platform.STACK_BYTES))
        @virtual_bytes = word.from_number(word.to_number(image_end) - SECTION_RVA)
        @entry_rva = word.to_number(machine.label_address(current, machine.entry, 0))
        @result = buffer.empty()
        result = append_dos_header(result)
        result = append_coff_header(result)
        result = append_optional_header(result, entry_rva, raw_bytes, image_end, SECTION_RVA + relocation_offset)
        result = append_pe_section(result, raw_bytes, virtual_bytes)
        result.pad_to(HEADERS_BYTES)
        result.append_buffer(body)
        result.pad_to(HEADERS_BYTES + raw_bytes)
        out result
    }

    skill save(path, machine) {
        @finished = build(machine)
        out finished.write_file(path)
    }
}
