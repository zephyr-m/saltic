-- control — переходы, вызовы, адреса меток и платформа договора на x86-64.
-- Все переходы — cmp/test + jcc rel32 (6 байт) или jmp/call rel32 (5), патч
-- layout.PatchKind.REL32 на последние 4 байта; адрес метки — mov r32, imm32 с
-- патчем ABS32 (адрес гостя). Проверенная арифметика — add/sub + jo, внутренние
-- переходы считаются по длине выпущенного кода, без меток. syscall(n) — call
-- подпрограммы x86_syscall_<n>, которую даёт платформа при записи образа.
--
-- relative_to(billet, kind, name) — jcc / jmp / call на метку
-- branch(billet, condition, left, right, name) — cmp + jcc
-- branch_test(billet, condition, from, name) — test + jcc
-- jump / call(billet, name); ret(billet)
-- checked(billet, op) — VALUE = VALUE op ERROR, ERROR = NO_ERROR / NUMBER_OVERFLOW
-- load_address(billet, to, name, addend)
-- syscall(billet, number); wait(billet, firmware) — hlt / pause; fence(billet)

use compiler.abi
use compiler.machine.word
use compiler.gorn.backend
use compiler.gorn.backend.buffer
use compiler.gorn.backend.layout
use compiler.gorn.backend.x86.x86_64.encoder
use compiler.gorn.backend.x86.x86_64.roles
use compiler.gorn.backend.x86.x86_64.ops

REL32_BYTES = 4

skill note(billet, kind, name, addend) {
    @offset = billet.machine.code.length - REL32_BYTES
    @billet_machine = billet.machine
    billet_machine.note_patch(layout.Patch { kind = kind, label = name, offset = offset, addend = addend })
    out billet
}

skill relative_to(billet, kind, name) {
    billet = roles.emit(billet, encoder.relative(billet.machine.code, kind, 0))
    out note(billet, layout.PatchKind.REL32, name, 0)
}

skill branch(billet, condition, left, right, name) {
    billet = roles.emit(billet, ops.compare(billet.machine.code, billet.words.bytes, left, right))
    out relative_to(billet, condition, name)
}

skill branch_test(billet, condition, from, name) {
    billet = roles.emit(billet, ops.test(billet.machine.code, billet.words.bytes, from))
    out relative_to(billet, condition, name)
}

skill jump(billet, name) {
    out relative_to(billet, encoder.JUMP, name)
}

skill call(billet, name) {
    out relative_to(billet, encoder.CALL, name)
}

skill ret(billet) {
    out roles.emit(billet, encoder.single(billet.machine.code, encoder.RET))
}

skill checked(billet, op) {
    @size = billet.words.bytes
    @code = billet.machine.code
    code = encoder.operate(code, size, op, encoder.EAX, encoder.EDX)
    code = encoder.relative(code, encoder.OVERFLOW, 0)
    @overflow_from = code.length
    code = encoder.operate_immediate(code, size, encoder.MOVE, encoder.EDX, abi.CALL_NO_ERROR)
    code = encoder.relative(code, encoder.JUMP, 0)
    @done_from = code.length
    code = encoder.operate_immediate(code, size, encoder.MOVE, encoder.EDX, abi.ERROR_NUMBER_OVERFLOW)
    code = buffer.set_word(code, overflow_from - REL32_BYTES, word.from_signed(done_from - overflow_from))
    code = buffer.set_word(code, done_from - REL32_BYTES, word.from_signed(code.length - done_from))
    out roles.emit(billet, code)
}

skill load_address(billet, to, name, addend) {
    @size = billet.words.bytes
    @code = billet.machine.code
    @target = roles.register(to)
    (target == roles.MEMORY) {
        @x = roles.temp(encoder.NONE, encoder.NONE, encoder.NONE)
        code = encoder.register64(code, encoder.PUSH, x)
        code = encoder.move_word(code, x, word.from_number(0))
        billet = note(roles.emit(billet, code), layout.PatchKind.ABS32, name, addend)
        code = roles.store_into(billet.machine.code, size, to, x)
        out roles.emit(billet, encoder.register64(code, encoder.POP, x))
    }
    code = encoder.move_word(code, target, word.from_number(0))
    out note(roles.emit(billet, code), layout.PatchKind.ABS32, name, addend)
}

skill syscall(billet, number) {
    @n = number
    out call(billet, "x86_syscall_{n}")
}

skill wait(billet, firmware) {
    (firmware == yes) { out roles.emit(billet, encoder.single(billet.machine.code, encoder.HLT)) }
    out roles.emit(billet, encoder.single(billet.machine.code, encoder.PAUSE))
}

skill fence(billet) {
    out roles.emit(billet, encoder.single(billet.machine.code, encoder.MFENCE))
}
