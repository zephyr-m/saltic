-- x86_64 — родной бэкенд x86-64: исполнитель договора машины (Executor)
-- и запись образа. Слово 8 байт (wide = yes — так toolchain собирает все
-- цели x86-64; wide = no — прежние 4-байтные ячейки в окне по r14). Код x86
-- лежит по тем же адресам, что и метки layout (65536…). Роли — roles (14 в регистрах, редкие в памяти), команды
-- — encoder; переходы rel32 и адреса ABS32 — патчи layout. Адрес возврата —
-- на родном стеке: store/load роли RETURN пусты, call/ret родные.
-- firmware = yes — исполнитель для прошивки (UEFI): wait — hlt, load в STACK
-- под cli/sti.
--
-- wide = yes — слово 8 байт (billet.words = abi.shape.of(8)), числа
--     61-битные; плюс multiply… / divide… / load_wide для рантайма 8-байтного
--     слова. Linux — без окна: r14 = 0, адреса настоящие. UEFI — в окне: r14 =
--     база образа, адреса — смещения от неё (прошивка грузит образ куда хочет).
-- Executor { firmware, wide } — все методы договора backend (../../main.saltic)
-- write(path, machine) — ELF64 для Linux: платформа (вход, syscall) дописана,
--     патчи разрешены, образ записан; UnresolvedPatch, WriteFailed
-- write_wide(path, machine) — ELF64 для Linux без окна (platform.append_wide)
-- write_uefi(path, machine) — PE32+ для UEFI: вход и вызовы прошивки (uefi)
--
-- Дети: encoder (байты команд), roles (роль → регистр / ячейка), ops
-- (пересылки, арифметика, сравнения), access (память и стек), control
-- (переходы, вызовы, платформа), platform (вход и syscall Linux), image (ELF64),
-- uefi (вход и вызовы прошивки), pe (PE32+).

use compiler.gorn.backend
use compiler.gorn.backend.layout
use compiler.gorn.backend.x86.x86_64.encoder
use compiler.gorn.backend.x86.x86_64.roles
use compiler.gorn.backend.x86.x86_64.ops
use compiler.gorn.backend.x86.x86_64.access
use compiler.gorn.backend.x86.x86_64.control
use compiler.gorn.backend.x86.x86_64.platform
use compiler.gorn.backend.x86.x86_64.image
use compiler.gorn.backend.x86.x86_64.uefi
use compiler.gorn.backend.x86.x86_64.pe
use compiler.abi.shape

Executor = Box {
    firmware = no,
    wide = no,
    places = roles.Roles {},
    access_ops = access.Access {},
    flow = control.Control {},
    arithmetic = ops.Ops {},
    linux = platform.LinuxRuntime {},
    efi = uefi.UefiRuntime {},
    elf64 = image.Elf64 {},
    portable = pe.Pe32 {}

    skill section(value) {
        (value == backend.CODE) { out Layout.Section.CODE }
        (value == backend.RODATA) { out Layout.Section.RODATA }
        (value == backend.DATA) { out Layout.Section.DATA }
        out Layout.Section.BSS
    }

    skill new_program(billet, entry) {
        (wide == yes) { billet.words = shape.of(8) }
        billet.machine = layout.host(entry)
        @billet_machine = billet.machine
        billet_machine.append_section_byte(Layout.Section.CODE, 0)
        billet_machine = billet.machine
        billet_machine.align_section(Layout.Section.CODE, roles.SLOTS_BYTES)
        out billet
    }

    skill heap_size(billet, bytes) {
        billet.machine.heap_size = bytes
        out billet
    }

    skill label(billet, name) {
        @billet_machine = billet.machine
        billet_machine.define_label(Layout.Section.CODE, name)
        out billet
    }

    skill data_label(billet, where, name) {
        @billet_machine = billet.machine
        billet_machine.define_label(section(where), name)
        out billet
    }

    skill align(billet, where, boundary) {
        @billet_machine = billet.machine
        billet_machine.align_section(section(where), boundary)
        out billet
    }

    skill data_byte(billet, where, value) {
        @billet_machine = billet.machine
        billet_machine.append_section_byte(section(where), value)
        out billet
    }

    skill data32(billet, where, value) {
        @billet_machine = billet.machine
        billet_machine.append_section_word(section(where), value)
        out billet
    }

    skill data_word(billet, where, value) {
        @billet_machine = billet.machine
        billet_machine.append_section_word(section(where), value)
        (wide == no) { out billet }
        @fill = 0
        (value.b3 > 127) { fill = 255 }
        billet_machine = billet.machine
        drum (4) {
            billet_machine.append_section_byte(section(where), fill)
        }
        out billet
    }

    skill data_text(billet, where, text) {
        @billet_machine = billet.machine
        billet_machine.append_section_text(section(where), text, yes)
        out billet
    }

    skill reserve(billet, bytes) {
        @billet_machine = billet.machine
        billet_machine.reserve_bss(bytes)
        out billet
    }

    skill load_immediate(billet, to, value) {
        out arithmetic.load_immediate(billet, to, value)
    }

    skill load_word(billet, to, value) {
        out arithmetic.load_word(billet, to, value)
    }

    skill load_address(billet, to, name, addend) {
        out flow.load_address(billet, to, name, addend)
    }

    skill move(billet, to, from) {
        out arithmetic.move(billet, to, from)
    }

    skill negate(billet, to, from) {
        out arithmetic.negate(billet, to, from)
    }

    skill add_immediate(billet, to, from, value) {
        out arithmetic.add_immediate(billet, to, from, value)
    }

    skill add(billet, to, left, right) {
        out arithmetic.operate_binary(billet, encoder.ADD, to, left, right, yes)
    }

    skill sub(billet, to, left, right) {
        out arithmetic.operate_binary(billet, encoder.SUB, to, left, right, no)
    }

    skill and(billet, to, left, right) {
        out arithmetic.operate_binary(billet, encoder.AND, to, left, right, yes)
    }

    skill or(billet, to, left, right) {
        out arithmetic.operate_binary(billet, encoder.OR, to, left, right, yes)
    }

    skill xor(billet, to, left, right) {
        out arithmetic.operate_binary(billet, encoder.XOR, to, left, right, yes)
    }

    skill and_immediate(billet, to, from, value) {
        out arithmetic.immediate_op(billet, encoder.AND, to, from, value)
    }

    skill or_immediate(billet, to, from, value) {
        out arithmetic.immediate_op(billet, encoder.OR, to, from, value)
    }

    skill xor_immediate(billet, to, from, value) {
        out arithmetic.immediate_op(billet, encoder.XOR, to, from, value)
    }

    skill shift_left(billet, to, from, count) {
        out arithmetic.shift(billet, encoder.SHIFT_LEFT, to, from, count)
    }

    skill shift_right_signed(billet, to, from, count) {
        out arithmetic.shift(billet, encoder.SHIFT_ARITHMETIC, to, from, count)
    }

    skill shift_right_unsigned(billet, to, from, count) {
        out arithmetic.shift(billet, encoder.SHIFT_RIGHT, to, from, count)
    }

    skill shift_left_by(billet, to, from, count) {
        out arithmetic.shift_by(billet, encoder.SHIFT_LEFT, to, from, count)
    }

    skill shift_right_unsigned_by(billet, to, from, count) {
        out arithmetic.shift_by(billet, encoder.SHIFT_RIGHT, to, from, count)
    }

    skill set_less(billet, to, left, right) {
        billet = places.emit(billet, arithmetic.compare(billet.machine.code, billet.words.bytes, left, right))
        out arithmetic.set(billet, encoder.LESS, to)
    }

    skill set_less_unsigned(billet, to, left, right) {
        billet = places.emit(billet, arithmetic.compare(billet.machine.code, billet.words.bytes, left, right))
        out arithmetic.set(billet, encoder.BELOW, to)
    }

    skill set_less_unsigned_immediate(billet, to, from, value) {
        billet = places.emit(billet, arithmetic.compare_immediate(billet.machine.code, billet.words.bytes, from, value))
        out arithmetic.set(billet, encoder.BELOW, to)
    }

    skill set_zero(billet, to, from) {
        billet = places.emit(billet, arithmetic.test(billet.machine.code, billet.words.bytes, from))
        out arithmetic.set(billet, encoder.EQUAL, to)
    }

    skill set_nonzero(billet, to, from) {
        billet = places.emit(billet, arithmetic.test(billet.machine.code, billet.words.bytes, from))
        out arithmetic.set(billet, encoder.NOT_EQUAL, to)
    }

    skill add_checked(billet) {
        out flow.checked(billet, encoder.ADD)
    }

    skill sub_checked(billet) {
        out flow.checked(billet, encoder.SUB)
    }

    skill load(billet, to, base, offset) {
        (to == backend.RETURN) { out billet }
        out access_ops.read_memory(billet, places.load_form(billet.words.bytes), to, base, offset, firmware)
    }

    skill load32(billet, to, base, offset) {
        out access_ops.read_memory(billet, encoder.LOAD, to, base, offset, firmware)
    }

    skill store32(billet, from, base, offset) {
        out access_ops.write_memory(billet, encoder.STORE, from, base, offset)
    }

    skill load_byte(billet, to, base, offset) {
        out access_ops.read_memory(billet, encoder.LOAD_ZERO_BYTE, to, base, offset, firmware)
    }

    skill load_half(billet, to, base, offset) {
        out access_ops.read_memory(billet, encoder.LOAD_ZERO_HALF, to, base, offset, firmware)
    }

    skill store(billet, from, base, offset) {
        (from == backend.RETURN) { out billet }
        out access_ops.write_memory(billet, places.store_form(billet.words.bytes), from, base, offset)
    }

    skill store_byte(billet, from, base, offset) {
        out access_ops.write_memory(billet, encoder.STORE_BYTE, from, base, offset)
    }

    skill store_half(billet, from, base, offset) {
        out access_ops.write_memory(billet, encoder.STORE_HALF, from, base, offset)
    }

    skill store_zero(billet, base, offset) {
        out access_ops.clear_memory(billet, billet.words.bytes, base, offset)
    }

    skill store_byte_zero(billet, base, offset) {
        out access_ops.clear_memory(billet, 1, base, offset)
    }

    skill push(billet, from) {
        out access_ops.push(billet, from)
    }

    skill pop(billet, to) {
        out access_ops.pop(billet, to)
    }

    skill branch_equal(billet, left, right, name) {
        out flow.branch(billet, encoder.EQUAL, left, right, name)
    }

    skill branch_not_equal(billet, left, right, name) {
        out flow.branch(billet, encoder.NOT_EQUAL, left, right, name)
    }

    skill branch_less(billet, left, right, name) {
        out flow.branch(billet, encoder.LESS, left, right, name)
    }

    skill branch_greater_equal(billet, left, right, name) {
        out flow.branch(billet, encoder.GREATER_OR_EQUAL, left, right, name)
    }

    skill branch_less_unsigned(billet, left, right, name) {
        out flow.branch(billet, encoder.BELOW, left, right, name)
    }

    skill branch_greater_equal_unsigned(billet, left, right, name) {
        out flow.branch(billet, encoder.ABOVE_OR_EQUAL, left, right, name)
    }

    skill branch_zero(billet, from, name) {
        out flow.branch_test(billet, encoder.EQUAL, from, name)
    }

    skill branch_nonzero(billet, from, name) {
        out flow.branch_test(billet, encoder.NOT_EQUAL, from, name)
    }

    skill branch_negative(billet, from, name) {
        out flow.branch_test(billet, encoder.SIGN, from, name)
    }

    skill branch_not_negative(billet, from, name) {
        out flow.branch_test(billet, encoder.NO_SIGN, from, name)
    }

    skill branch_not_positive(billet, from, name) {
        out flow.branch_test(billet, encoder.LESS_OR_EQUAL, from, name)
    }

    skill jump(billet, name) {
        out flow.jump(billet, name)
    }

    skill jump_if_equal(billet, left, right, name) {
        out flow.branch(billet, encoder.EQUAL, left, right, name)
    }

    skill jump_if_not_equal(billet, left, right, name) {
        out flow.branch(billet, encoder.NOT_EQUAL, left, right, name)
    }

    skill jump_if_zero(billet, from, name) {
        out flow.branch_test(billet, encoder.EQUAL, from, name)
    }

    skill jump_if_nonzero(billet, from, name) {
        out flow.branch_test(billet, encoder.NOT_EQUAL, from, name)
    }

    skill jump_far(billet, name) {
        out flow.jump(billet, name)
    }

    skill call(billet, name) {
        out flow.call(billet, name)
    }

    skill ret(billet) {
        out flow.ret(billet)
    }

    skill syscall(billet, number) {
        out flow.syscall(billet, number)
    }

    skill wait(billet) {
        out flow.wait_for(billet, firmware)
    }

    skill fence(billet) {
        out flow.fence(billet)
    }

    skill multiply(billet, to, left, right) {
        out arithmetic.wide_arith(billet, ops.WIDE_MULTIPLY, to, left, right)
    }

    skill multiply_high(billet, to, left, right) {
        out arithmetic.wide_arith(billet, ops.WIDE_MULTIPLY_HIGH, to, left, right)
    }

    skill multiply_high_unsigned(billet, to, left, right) {
        out arithmetic.wide_arith(billet, ops.WIDE_MULTIPLY_HIGH_UNSIGNED, to, left, right)
    }

    skill divide(billet, to, left, right) {
        out arithmetic.wide_arith(billet, ops.WIDE_DIVIDE, to, left, right)
    }

    skill remainder(billet, to, left, right) {
        out arithmetic.wide_arith(billet, ops.WIDE_REMAINDER, to, left, right)
    }

    skill divide_unsigned(billet, to, left, right) {
        out arithmetic.wide_arith(billet, ops.WIDE_DIVIDE_UNSIGNED, to, left, right)
    }

    skill remainder_unsigned(billet, to, left, right) {
        out arithmetic.wide_arith(billet, ops.WIDE_REMAINDER_UNSIGNED, to, left, right)
    }

    skill load_wide(billet, to, value) {
        out arithmetic.load_wide(billet, to, value)
    }

    skill fraction(billet, op, to, left, right) {
        out arithmetic.fraction(billet, op, to, left, right)
    }

    skill fraction_from(billet, to, from) {
        out arithmetic.fraction(billet, ops.FRACTION_FROM, to, from, from)
    }

    skill fraction_to(billet, to, from, mode) {
        out arithmetic.fraction(billet, ops.FRACTION_TO + mode, to, from, from)
    }

    skill write_wide(path, machine) {
        machine = linux.append_wide(machine)
        machine = layout.resolve(machine) rescue |failure| { out error.UnresolvedPatch }
        out elf64.save_wide(path, machine)
    }

    skill write_uefi(path, machine) {
        machine = efi.append(machine)
        machine = layout.resolve(machine) rescue |failure| { out error.UnresolvedPatch }
        out portable.save(path, machine)
    }
}
