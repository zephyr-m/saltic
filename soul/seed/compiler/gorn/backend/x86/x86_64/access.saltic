-- access — память и стек договора на x86-64: load / store слов, байтов и
-- полуслов, store нуля, push / pop. Адрес гостя — [r14 + база + смещение];
-- база STACK — [rsp + смещение] без r14. Роли в памяти (roles.MEMORY) идут
-- через временный регистр с push/pop; пока временный лежит на стеке, смещения
-- от STACK увеличены на 8. load в STACK — mov esp, [m]; add rsp, r14, на
-- прошивке (firmware) в обёртке cli … sti.
--
-- read_memory(billet, form, to, base, offset, firmware) — form: encoder.LOAD /
--     LOAD_ZERO_BYTE / LOAD_ZERO_HALF
-- write_memory(billet, form, from, base, offset) — encoder.STORE / STORE_BYTE / STORE_HALF
-- clear_memory(billet, size, base, offset) — size 4 или 1
-- push(billet, from) / pop(billet, to) — ячейка в слово (4 или 8 байт) на стеке
-- Хозяин — Access { coder, places } (СОП, 22.11.2026): навыки ниже — его методы.

use compiler.gorn.backend
use compiler.gorn.backend.x86.x86_64.encoder
use compiler.gorn.backend.x86.x86_64.roles

TEMP_BYTES = 8

Access = Box {
    coder = encoder.Encoder {},
    places = roles.Roles {}

    skill read_memory(billet, form, to, base, offset, firmware) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @target = places.register(to)
        (base == backend.STACK) {
            (target == roles.MEMORY) {
                @x = places.temp(encoder.NONE, encoder.NONE, encoder.NONE)
                code = coder.register64(code, encoder.PUSH, x)
                code = coder.memory(code, form, x, encoder.RSP, encoder.NONE, offset + TEMP_BYTES)
                code = places.store_into(code, size, to, x)
                out places.emit(billet, coder.register64(code, encoder.POP, x))
            }
            out places.emit(billet, coder.memory(code, form, target, encoder.RSP, encoder.NONE, offset))
        }
        @bases = places.register(base)
        (bases == roles.MEMORY) {
            @x = places.temp(target, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = places.move_into(code, size, x, base)
            pick {
                (target == roles.MEMORY) {
                    code = coder.memory(code, form, x, encoder.R14, x, offset)
                    code = places.store_into(code, size, to, x)
                }
                { code = coder.memory(code, form, target, encoder.R14, x, offset) }
            }
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        (to == backend.STACK) {
            (firmware == yes) { code = coder.single(code, encoder.CLI) }
            code = coder.memory(code, form, encoder.RSP, encoder.R14, bases, offset)
            code = coder.operate(code, 8, encoder.ADD, encoder.RSP, encoder.R14)
            (firmware == yes) { code = coder.single(code, encoder.STI) }
            out places.emit(billet, code)
        }
        (target == roles.MEMORY) {
            @x = places.temp(bases, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = coder.memory(code, form, x, encoder.R14, bases, offset)
            code = places.store_into(code, size, to, x)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        out places.emit(billet, coder.memory(code, form, target, encoder.R14, bases, offset))
    }

    skill write_memory(billet, form, from, base, offset) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @source = places.register(from)
        @bases = places.register(base)
        (from == backend.STACK) {
            @x = places.temp(bases, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = coder.memory(code, encoder.ADDRESS64, x, encoder.RSP, encoder.NONE, TEMP_BYTES)
            code = coder.operate(code, 8, encoder.SUB, x, encoder.R14)
            pick {
                (base == backend.STACK) { code = coder.memory(code, form, x, encoder.RSP, encoder.NONE, offset + TEMP_BYTES) }
                (bases == roles.MEMORY) {
                    @y = places.temp(x, encoder.NONE, encoder.NONE)
                    code = coder.register64(code, encoder.PUSH, y)
                    code = places.move_into(code, size, y, base)
                    code = coder.memory(code, form, x, encoder.R14, y, offset)
                    code = coder.register64(code, encoder.POP, y)
                }
                { code = coder.memory(code, form, x, encoder.R14, bases, offset) }
            }
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        (base == backend.STACK) {
            (source == roles.MEMORY) {
                @x = places.temp(encoder.NONE, encoder.NONE, encoder.NONE)
                code = coder.register64(code, encoder.PUSH, x)
                code = places.move_into(code, size, x, from)
                code = coder.memory(code, form, x, encoder.RSP, encoder.NONE, offset + TEMP_BYTES)
                out places.emit(billet, coder.register64(code, encoder.POP, x))
            }
            out places.emit(billet, coder.memory(code, form, source, encoder.RSP, encoder.NONE, offset))
        }
        (bases == roles.MEMORY) {
            @x = places.temp(source, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = places.move_into(code, size, x, base)
            pick {
                (source == roles.MEMORY) {
                    @y = places.temp(x, encoder.NONE, encoder.NONE)
                    code = coder.register64(code, encoder.PUSH, y)
                    code = places.move_into(code, size, y, from)
                    code = coder.memory(code, form, y, encoder.R14, x, offset)
                    code = coder.register64(code, encoder.POP, y)
                }
                { code = coder.memory(code, form, source, encoder.R14, x, offset) }
            }
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        (source == roles.MEMORY) {
            @x = places.temp(bases, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = places.move_into(code, size, x, from)
            code = coder.memory(code, form, x, encoder.R14, bases, offset)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        out places.emit(billet, coder.memory(code, form, source, encoder.R14, bases, offset))
    }

    skill clear_memory(billet, size, base, offset) {
        @word = billet.words.bytes
        @code = billet.machine.code
        (base == backend.STACK) { out places.emit(billet, coder.store_immediate(code, size, encoder.RSP, encoder.NONE, offset, 0)) }
        @bases = places.register(base)
        (bases == roles.MEMORY) {
            @x = places.temp(encoder.NONE, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = places.move_into(code, word, x, base)
            code = coder.store_immediate(code, size, encoder.R14, x, offset, 0)
            out places.emit(billet, coder.register64(code, encoder.POP, x))
        }
        out places.emit(billet, coder.store_immediate(code, size, encoder.R14, bases, offset, 0))
    }

    skill push(billet, from) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @source = places.register(from)
        (source == roles.MEMORY) {
            @x = places.temp(encoder.NONE, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = places.move_into(code, size, x, from)
            code = coder.memory(code, places.store_form(size), x, encoder.RSP, encoder.NONE, TEMP_BYTES - size)
            code = coder.register64(code, encoder.POP, x)
            out places.emit(billet, coder.operate_immediate(code, 8, encoder.SUB, encoder.RSP, size))
        }
        code = coder.operate_immediate(code, 8, encoder.SUB, encoder.RSP, size)
        out places.emit(billet, coder.memory(code, places.store_form(size), source, encoder.RSP, encoder.NONE, 0))
    }

    skill pop(billet, to) {
        @size = billet.words.bytes
        @code = billet.machine.code
        @target = places.register(to)
        (target == roles.MEMORY) {
            @x = places.temp(encoder.NONE, encoder.NONE, encoder.NONE)
            code = coder.register64(code, encoder.PUSH, x)
            code = coder.memory(code, places.load_form(size), x, encoder.RSP, encoder.NONE, TEMP_BYTES)
            code = places.store_into(code, size, to, x)
            code = coder.register64(code, encoder.POP, x)
            out places.emit(billet, coder.operate_immediate(code, 8, encoder.ADD, encoder.RSP, size))
        }
        code = coder.memory(code, places.load_form(size), target, encoder.RSP, encoder.NONE, 0)
        out places.emit(billet, coder.operate_immediate(code, 8, encoder.ADD, encoder.RSP, size))
    }
}
