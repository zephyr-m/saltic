-- terminal — рантайм терминала: io.key через платформу (rt_platform_key —
-- имя клавиши или байты) и io.clear (ESC-последовательность в rt_platform_write).
-- Каждый навык берёт и отдаёт compiler.
-- Команды — методами billet.executor (договор backend), регистры — его роли.
--
-- emit_key(billet) — rt_io_key -> rt_platform_key; emit_clear(billet) — rt_io_clear
-- append_text(billet, label, text) — статическая строка-объект в rodata
-- append_data(billet) — rt_clear_sequence
-- append_runtime(billet) — rt_io_key + rt_io_clear

use core.str
use core.group
use compiler.abi
use compiler.gorn.backend
use compiler.gorn.constants
use compiler.machine.word
use compiler.gorn.platform
use compiler.gorn.backend.rv32i.runtime.tails

STDOUT = 1

CLEAR_SEQUENCE = [27, 91, 50, 74, 27, 91, 72]

skill emit_key(billet) {
    @executor = billet.executor
    billet = executor.label(billet, "rt_io_key")
    out executor.jump(billet, platform.KEY)
}

skill emit_clear(billet) {
    @executor = billet.executor
    @words = billet.words
    billet = executor.label(billet, "rt_io_clear")
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
    billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.load_immediate(billet, backend.VALUE, STDOUT)
    billet = executor.load_address(billet, backend.ERROR, "rt_clear_sequence", 0)
    billet = executor.load_immediate(billet, backend.ARG2, group.count(CLEAR_SEQUENCE))
    billet = executor.call(billet, platform.WRITE)
    billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
    billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
    out tails.ok(billet)
}
skill append_text(billet, label, text) {
    @executor = billet.executor
    billet = executor.align(billet, backend.RODATA, 8)
    billet = executor.data_label(billet, backend.RODATA, label)
    billet = constants.emit_static_header(billet, backend.RODATA, abi.OBJECT_KIND_STRING, constants.string_storage_bytes(billet.words, str.bytes(text)))
    billet = executor.data_word(billet, backend.RODATA, word.from_number(str.bytes(text)))
    billet = executor.data_text(billet, backend.RODATA, text)
    out billet
}

skill append_data(billet) {
    @executor = billet.executor
    billet = executor.data_label(billet, backend.RODATA, "rt_clear_sequence")
    drum (CLEAR_SEQUENCE) {
        billet = executor.data_byte(billet, backend.RODATA, beat)
    }
    out billet
}
skill append_runtime(billet) {
    billet = emit_key(billet)
    out emit_clear(billet)
}
