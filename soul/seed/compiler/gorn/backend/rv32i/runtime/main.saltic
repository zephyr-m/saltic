-- runtime — собирает рантайм rt_* из детей в фиксированном порядке и
-- добавляет его к машине после кода программы. Платформенного кода здесь
-- нет: метки rt_platform_* выпускает платформа (compiler/gorn/platform) следом.
-- Порядок вызовов задаёт раскладку меток и не меняется без нужды; провалов
-- меток между вызовами нет (они внутри навыков детей).
-- Команды — методами billet.executor (договор backend).
--
-- append_runtime(billet) — весь рантайм
-- append_runtime_data(billet) — тексты сообщений в rodata
--
-- Дети: numbers, collections, strings, bytes, fixed, fraction, raw_memory, memory, terminal, host, crash.

use compiler.abi
use compiler.gorn.backend
use compiler.gorn.backend.rv32i.runtime.tails
use compiler.gorn.backend.rv32i.runtime.memory
use compiler.gorn.backend.rv32i.runtime.terminal
use compiler.gorn.backend.rv32i.runtime.numbers
use compiler.gorn.backend.rv32i.runtime.collections
use compiler.gorn.backend.rv32i.runtime.strings
use compiler.gorn.backend.rv32i.runtime.bytes
use compiler.gorn.backend.rv32i.runtime.fixed
use compiler.gorn.backend.rv32i.runtime.fraction
use compiler.gorn.backend.rv32i.runtime.raw_memory
use compiler.gorn.backend.rv32i.runtime.host
use compiler.gorn.backend.rv32i.runtime.crash

skill append_runtime_data(billet) {
    @executor = billet.executor
    billet = terminal.append_text(billet, "rt_unknown_text", "<value>")
    billet = terminal.append_text(billet, "rt_fixed_overflow_text", "значение вышло за границы фиксированного целого")
    billet = terminal.append_text(billet, "rt_memory_exhausted_text", "память исчерпана")
    billet = terminal.append_text(billet, "rt_stack_exhausted_text", "стек исчерпан")
    billet = terminal.append_text(billet, "rt_cycle_forbidden_text", "цикл ссылок запрещён: храни номер, а не объект")
    billet = terminal.append_text(billet, "rt_cycle_check_exhausted_text", "проверка цикла ссылок не уложилась в бюджет объектов")
    billet = terminal.append_text(billet, "rt_yes_text", "yes")
    billet = terminal.append_text(billet, "rt_no_text", "no")
    billet = terminal.append_text(billet, "rt_need_text", "нужно ")
    billet = terminal.append_text(billet, "rt_arguments_text", " аргументов")
    billet = terminal.append_text(billet, "rt_failure_text", "ошибка: ")
    billet = crash.append_data(billet)
    billet = executor.align(billet, backend.RODATA, 8)
    billet = executor.data_label(billet, backend.RODATA, "rt_newline_text")
    billet = executor.data_byte(billet, backend.RODATA, 10)
    out billet
}

skill append_runtime(billet) {
    billet = crash.emit_runtime_begin(billet)
    billet = numbers.emit_mul(billet)
    billet = numbers.emit_div(billet)
    billet = numbers.emit_mod(billet)
    billet = numbers.emit_division_by_zero(billet)
    billet = numbers.emit_number_overflow(billet)
    billet = numbers.emit_bits(billet)
    billet = numbers.emit_equal(billet)
    billet = numbers.emit_value_equal(billet)
    billet = collections.emit_box_get(billet)
    billet = collections.emit_box_set(billet)
    billet = collections.emit_missing_field(billet)
    billet = collections.emit_empty_touched(billet)
    billet = collections.emit_group_count(billet)
    billet = collections.emit_group_at(billet)
    billet = collections.emit_group_bounds(billet)
    billet = collections.emit_group_tree_at(billet)
    billet = collections.emit_group_tree_parts(billet)
    billet = collections.emit_group_tree_make(billet)
    billet = collections.emit_group_flatten(billet)
    billet = collections.emit_group_replaced(billet)
    billet = strings.emit_string_len(billet)
    billet = strings.emit_string_byte(billet)
    billet = strings.emit_string_bounds(billet)
    billet = strings.emit_string_starts_with(billet)
    billet = strings.emit_string_ends_with(billet)
    billet = strings.emit_string_contains(billet)
    billet = strings.emit_line_count(billet)
    billet = host.emit_newline(billet)
    billet = host.emit_missing_args(billet)
    billet = host.emit_start_failure(billet)
    billet = crash.emit_trail_push(billet)
    billet = crash.emit_trail_clear(billet)
    billet = crash.emit_trail_print(billet)
    billet = crash.emit_clock(billet)
    billet = crash.emit_report(billet)
    billet = crash.emit_signals(billet)
    billet = crash.append_bss(billet)
    billet = host.emit_cpu_wait(billet)
    billet = host.emit_cpu_firmware(billet)
    billet = host.emit_cpu_fence(billet)
    billet = host.emit_environment_capture(billet)
    billet = fixed.emit_fixed_overflow(billet)
    billet = fixed.emit_fixed_equal(billet)
    billet = fixed.emit_fixed_less(billet)
    billet = fixed.emit_fixed_greater(billet)
    billet = fixed.emit_fixed_new(billet)
    (billet.words.bytes == 8) { billet = fixed.emit_fixed_wrap(billet) }
    billet = fixed.emit_fixed_mem_load8(billet)
    billet = fixed.emit_fixed_mem_load16(billet)
    billet = fixed.emit_fixed_mem_load(billet)
    billet = fixed.emit_fixed_mem_store8(billet)
    billet = fixed.emit_fixed_mem_store16(billet)
    billet = fixed.emit_fixed_mem_store(billet)
    billet = fixed.emit_fixed_text(billet)
    billet = collections.emit_group_add(billet)
    billet = strings.emit_cstring(billet)
    billet = strings.emit_string_add(billet)
    billet = strings.emit_string_at(billet)
    billet = strings.emit_string_from_byte(billet)
    billet = strings.emit_string_from_bytes(billet)
    billet = strings.emit_string_slice(billet)
    billet = strings.emit_string_lower(billet)
    billet = strings.emit_string_case(billet)
    billet = numbers.emit_number_text(billet)
    billet = host.emit_file_bytes_text(billet)
    billet = fixed.emit_fixed_add(billet)
    billet = fixed.emit_fixed_sub(billet)
    billet = fixed.emit_fixed_mul(billet)
    billet = fixed.emit_fixed_div(billet)
    billet = fixed.emit_fixed_and(billet)
    billet = fixed.emit_fixed_or(billet)
    billet = fixed.emit_fixed_xor(billet)
    billet = fixed.emit_fixed_not(billet)
    billet = fixed.emit_fixed_shift_left(billet)
    billet = fixed.emit_fixed_shift_right(billet)
    billet = fixed.emit_fixed_convert(billet)
    billet = fixed.emit_fixed_to_number(billet, "rt_fixed_to_number", "rt_number_overflow")
    billet = fraction.append(billet)
    billet = fixed.emit_fixed_to_number(billet, "rt_fixed_pack", "rt_fixed_too_big")
    billet = tails.fail(billet, "rt_fixed_too_big", abi.ERROR_FIXED_TOO_BIG)
    billet = host.emit_show(billet)
    billet = host.emit_value_text(billet)
    billet = memory.append_runtime(billet)
    billet = terminal.append_runtime(billet)
    billet = append_runtime_data(billet)
    billet = host.emit_error_text(billet)
    billet = raw_memory.emit_mem_arena(billet)
    billet = raw_memory.emit_mem_heap(billet)
    billet = host.emit_cpu_call(billet)
    billet = bytes.emit_bytes_new(billet)
    billet = bytes.emit_bytes_checked(billet)
    out terminal.append_data(billet)
}
