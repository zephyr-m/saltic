-- rv32i — бэкенд RV32I: исполнитель договора машины (Executor) и тонкий
-- фасад над machine.layout / machine.image для платформ (qemu_virt) и тестов.
-- Executor — Box с методами договора (см. ../main.saltic): роль → регистр
-- по REGISTER_OF_ROLE (порядок совпадает с номерами ролей в backend), команды
-- через assembler.emit_op (широкие смещения — t6, свободный от ролей).
-- far_calls = yes — вызовы auipc+jalr. Фасад: target — layout.Program,
-- каждый навык отдаёт его обновлённым.
--
-- Executor { far_calls } — все 67 методов договора backend (../main.saltic); внутренние
--     register(role) -> номер регистра, section(value) -> layout.Section,
--     checked(billet, kind) — общая часть add_checked / sub_checked
-- Operation { kind, rd, rs1, rs2, immediate } / operation(kind, rd, rs1, rs2, immediate)
-- host(entry) / qemu_virt(entry) -> Program; emit(target, operation)
-- label(target, section, name) / branch(target, kind, rs1, rs2, label)
-- branch_unsigned_greater(target, rs1, rs2, label) / jump(target, rd, label) / call(target, label)
-- load_immediate(target, rd, immediate) / relative_address / absolute_address(target, rd, label, addend)
-- resolve(target) -> Program; executable(target) -> байты ELF

use core.group
use compiler.abi
use compiler.gorn.backend
use compiler.gorn.backend.rv32i.assembler
use compiler.gorn.backend.rv32i.machine.instruction
use compiler.gorn.backend.rv32i.machine.layout
use compiler.gorn.backend.rv32i.machine.image
use compiler.gorn.backend.rv32i.machine.registers

REGISTER_OF_ROLE = [
    registers.A0, registers.A1, registers.A2, registers.A3,
    registers.A4, registers.A5, registers.A6, registers.A7,
    registers.T0, registers.T1, registers.T2, registers.T3, registers.T4,
    registers.S0, registers.SP, registers.RA,
    registers.S1, registers.S2, registers.S4, registers.S5,
    registers.T5
]

SKIP_NEXT = 8
FENCE_READ_WRITE = 51

Executor = Box {
    far_calls = no

    skill register(role) {
        out group.get(REGISTER_OF_ROLE, role)
    }

    skill section(value) {
        (value == backend.CODE) { out layout.Section.CODE }
        (value == backend.RODATA) { out layout.Section.RODATA }
        (value == backend.DATA) { out layout.Section.DATA }
        out layout.Section.BSS
    }

    skill new_program(billet, entry) {
        billet.machine = layout.host(entry)
        billet.machine.far_calls = far_calls
        out billet
    }

    skill heap_size(billet, bytes) {
        billet.machine.heap_size = bytes
        out billet
    }

    skill label(billet, name) {
        billet.machine = layout.define_label(billet.machine, layout.Section.CODE, name)
        out billet
    }

    skill data_label(billet, where, name) {
        billet.machine = layout.define_label(billet.machine, section(where), name)
        out billet
    }

    skill align(billet, where, boundary) {
        billet.machine = layout.align_section(billet.machine, section(where), boundary)
        out billet
    }

    skill data32(billet, where, value) {
        out data_word(billet, where, value)
    }

    skill data_word(billet, where, value) {
        billet.machine = layout.append_section_word(billet.machine, section(where), value)
        out billet
    }

    skill data_byte(billet, where, value) {
        billet.machine = layout.append_section_byte(billet.machine, section(where), value)
        out billet
    }

    skill data_text(billet, where, text) {
        billet.machine = layout.append_section_text(billet.machine, section(where), text, yes)
        out billet
    }

    skill reserve(billet, bytes) {
        billet.machine = layout.reserve_bss(billet.machine, bytes)
        out billet
    }

    skill load_immediate(billet, to, value) {
        billet.machine = layout.emit_load_immediate(billet.machine, register(to), value)
        out billet
    }

    skill load_word(billet, to, value) {
        billet.machine = layout.emit_load_word(billet.machine, register(to), value)
        out billet
    }

    skill load_address(billet, to, name, addend) {
        billet.machine = layout.emit_relative_address(billet.machine, register(to), name, addend)
        out billet
    }

    skill move(billet, to, from) {
        out assembler.emit_op(billet, instruction.Kind.ADDI, register(to), register(from), registers.ZERO, 0)
    }

    skill negate(billet, to, from) {
        out assembler.emit_op(billet, instruction.Kind.SUB, register(to), registers.ZERO, register(from), 0)
    }

    skill add_immediate(billet, to, from, value) {
        out assembler.emit_op(billet, instruction.Kind.ADDI, register(to), register(from), registers.ZERO, value)
    }

    skill add(billet, to, left, right) {
        out assembler.emit_op(billet, instruction.Kind.ADD, register(to), register(left), register(right), 0)
    }

    skill sub(billet, to, left, right) {
        out assembler.emit_op(billet, instruction.Kind.SUB, register(to), register(left), register(right), 0)
    }

    skill and(billet, to, left, right) {
        out assembler.emit_op(billet, instruction.Kind.AND, register(to), register(left), register(right), 0)
    }

    skill or(billet, to, left, right) {
        out assembler.emit_op(billet, instruction.Kind.OR, register(to), register(left), register(right), 0)
    }

    skill xor(billet, to, left, right) {
        out assembler.emit_op(billet, instruction.Kind.XOR, register(to), register(left), register(right), 0)
    }

    skill and_immediate(billet, to, from, value) {
        out assembler.emit_op(billet, instruction.Kind.ANDI, register(to), register(from), registers.ZERO, value)
    }

    skill or_immediate(billet, to, from, value) {
        out assembler.emit_op(billet, instruction.Kind.ORI, register(to), register(from), registers.ZERO, value)
    }

    skill xor_immediate(billet, to, from, value) {
        out assembler.emit_op(billet, instruction.Kind.XORI, register(to), register(from), registers.ZERO, value)
    }

    skill shift_left(billet, to, from, count) {
        out assembler.emit_op(billet, instruction.Kind.SLLI, register(to), register(from), registers.ZERO, count)
    }

    skill shift_right_signed(billet, to, from, count) {
        out assembler.emit_op(billet, instruction.Kind.SRAI, register(to), register(from), registers.ZERO, count)
    }

    skill shift_right_unsigned(billet, to, from, count) {
        out assembler.emit_op(billet, instruction.Kind.SRLI, register(to), register(from), registers.ZERO, count)
    }

    skill shift_left_by(billet, to, from, count) {
        out assembler.emit_op(billet, instruction.Kind.SLL, register(to), register(from), register(count), 0)
    }

    skill shift_right_unsigned_by(billet, to, from, count) {
        out assembler.emit_op(billet, instruction.Kind.SRL, register(to), register(from), register(count), 0)
    }

    skill set_less(billet, to, left, right) {
        out assembler.emit_op(billet, instruction.Kind.SLT, register(to), register(left), register(right), 0)
    }

    skill set_less_unsigned(billet, to, left, right) {
        out assembler.emit_op(billet, instruction.Kind.SLTU, register(to), register(left), register(right), 0)
    }

    skill set_less_unsigned_immediate(billet, to, from, value) {
        out assembler.emit_op(billet, instruction.Kind.SLTIU, register(to), register(from), registers.ZERO, value)
    }

    skill set_zero(billet, to, from) {
        out assembler.emit_op(billet, instruction.Kind.SLTIU, register(to), register(from), registers.ZERO, 1)
    }

    skill set_nonzero(billet, to, from) {
        out assembler.emit_op(billet, instruction.Kind.SLTU, register(to), registers.ZERO, register(from), 0)
    }

    skill checked(billet, kind) {
        billet = assembler.emit_op(billet, kind, registers.T0, registers.A0, registers.A1, 0)
        pick {
            (kind == instruction.Kind.ADD) { billet = assembler.emit_op(billet, instruction.Kind.SLT, registers.T1, registers.T0, registers.A0, 0) }
            { billet = assembler.emit_op(billet, instruction.Kind.SLT, registers.T1, registers.A0, registers.T0, 0) }
        }
        billet = assembler.emit_op(billet, instruction.Kind.SLTI, registers.T2, registers.A1, registers.ZERO, 0)
        billet = assembler.emit_op(billet, instruction.Kind.ADDI, registers.A0, registers.T0, registers.ZERO, 0)
        billet = assembler.emit_op(billet, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
        billet.machine = layout.emit(billet.machine, instruction.Kind.BEQ, registers.ZERO, registers.T1, registers.T2, SKIP_NEXT)
        out assembler.emit_op(billet, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_NUMBER_OVERFLOW)
    }

    skill add_checked(billet) {
        out checked(billet, instruction.Kind.ADD)
    }

    skill sub_checked(billet) {
        out checked(billet, instruction.Kind.SUB)
    }

    skill load(billet, to, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.LW, register(to), register(base), registers.ZERO, offset)
    }

    skill load32(billet, to, base, offset) {
        out load(billet, to, base, offset)
    }

    skill store32(billet, from, base, offset) {
        out store(billet, from, base, offset)
    }

    skill load_byte(billet, to, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.LBU, register(to), register(base), registers.ZERO, offset)
    }

    skill load_half(billet, to, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.LHU, register(to), register(base), registers.ZERO, offset)
    }

    skill store(billet, from, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.SW, registers.ZERO, register(base), register(from), offset)
    }

    skill store_byte(billet, from, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.SB, registers.ZERO, register(base), register(from), offset)
    }

    skill store_half(billet, from, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.SH, registers.ZERO, register(base), register(from), offset)
    }

    skill store_zero(billet, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.SW, registers.ZERO, register(base), registers.ZERO, offset)
    }

    skill store_byte_zero(billet, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.SB, registers.ZERO, register(base), registers.ZERO, offset)
    }

    skill push(billet, from) {
        billet = assembler.emit_op(billet, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -abi.VALUE_WORD_BYTES)
        out assembler.emit_op(billet, instruction.Kind.SW, registers.ZERO, registers.SP, register(from), 0)
    }

    skill pop(billet, to) {
        billet = assembler.emit_op(billet, instruction.Kind.LW, register(to), registers.SP, registers.ZERO, 0)
        out assembler.emit_op(billet, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, abi.VALUE_WORD_BYTES)
    }

    skill branch_equal(billet, left, right, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BEQ, register(left), register(right), name)
        out billet
    }

    skill branch_not_equal(billet, left, right, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BNE, register(left), register(right), name)
        out billet
    }

    skill branch_less(billet, left, right, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BLT, register(left), register(right), name)
        out billet
    }

    skill branch_greater_equal(billet, left, right, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BGE, register(left), register(right), name)
        out billet
    }

    skill branch_less_unsigned(billet, left, right, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BLTU, register(left), register(right), name)
        out billet
    }

    skill branch_greater_equal_unsigned(billet, left, right, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BGEU, register(left), register(right), name)
        out billet
    }

    skill branch_zero(billet, from, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BEQ, register(from), registers.ZERO, name)
        out billet
    }

    skill branch_nonzero(billet, from, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BNE, register(from), registers.ZERO, name)
        out billet
    }

    skill branch_negative(billet, from, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BLT, register(from), registers.ZERO, name)
        out billet
    }

    skill branch_not_negative(billet, from, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BGE, register(from), registers.ZERO, name)
        out billet
    }

    skill branch_not_positive(billet, from, name) {
        billet.machine = layout.emit_branch(billet.machine, instruction.Kind.BGE, registers.ZERO, register(from), name)
        out billet
    }

    skill jump(billet, name) {
        billet.machine = layout.emit_jump(billet.machine, registers.ZERO, name)
        out billet
    }

    skill jump_if_equal(billet, left, right, name) {
        billet.machine = layout.emit(billet.machine, instruction.Kind.BNE, registers.ZERO, register(left), register(right), SKIP_NEXT)
        out jump(billet, name)
    }

    skill jump_if_not_equal(billet, left, right, name) {
        billet.machine = layout.emit(billet.machine, instruction.Kind.BEQ, registers.ZERO, register(left), register(right), SKIP_NEXT)
        out jump(billet, name)
    }

    skill jump_if_zero(billet, from, name) {
        billet.machine = layout.emit(billet.machine, instruction.Kind.BNE, registers.ZERO, register(from), registers.ZERO, SKIP_NEXT)
        out jump(billet, name)
    }

    skill jump_if_nonzero(billet, from, name) {
        billet.machine = layout.emit(billet.machine, instruction.Kind.BEQ, registers.ZERO, register(from), registers.ZERO, SKIP_NEXT)
        out jump(billet, name)
    }

    skill jump_far(billet, name) {
        billet.machine = layout.emit_relative_address(billet.machine, registers.T1, name, 0)
        billet.machine = layout.emit(billet.machine, instruction.Kind.JALR, registers.ZERO, registers.T1, registers.ZERO, 0)
        out billet
    }

    skill call(billet, name) {
        billet.machine = layout.emit_call(billet.machine, name)
        out billet
    }

    skill ret(billet) {
        out assembler.emit_op(billet, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    }

    skill syscall(billet, number) {
        billet = assembler.emit_op(billet, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, number)
        out assembler.emit_op(billet, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    }

    skill wait(billet) {
        out assembler.emit_op(billet, instruction.Kind.WFI, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    }

    skill fence(billet) {
        out assembler.emit_op(billet, instruction.Kind.FENCE, registers.ZERO, registers.ZERO, registers.ZERO, FENCE_READ_WRITE)
    }
}

Operation = Box {
    kind = instruction.Kind.UNKNOWN_INSTRUCTION,
    rd = 0,
    rs1 = 0,
    rs2 = 0,
    immediate = 0
}

skill operation(kind, rd, rs1, rs2, immediate) {
    out Operation {
        kind = kind,
        rd = rd,
        rs1 = rs1,
        rs2 = rs2,
        immediate = immediate
    }
}

skill host(entry) {
    out layout.host(entry)
}

skill qemu_virt(entry) {
    out layout.qemu_virt(entry)
}

skill emit(target, value) {
    out layout.emit(target, value.kind, value.rd, value.rs1, value.rs2, value.immediate)
}

skill label(target, section, name) {
    out layout.define_label(target, section, name)
}

skill branch(target, kind, rs1, rs2, label_name) {
    out layout.emit_branch(target, kind, rs1, rs2, label_name)
}

skill jump(target, rd, label_name) {
    out layout.emit_jump(target, rd, label_name)
}

skill load_immediate(target, rd, immediate) {
    out layout.emit_load_immediate(target, rd, immediate)
}

skill branch_unsigned_greater(target, rs1, rs2, label_name) {
    out layout.emit_branch_unsigned_greater(target, rs1, rs2, label_name)
}

skill call(target, label_name) {
    out layout.emit_call(target, label_name)
}

skill relative_address(target, rd, label_name, addend) {
    out layout.emit_relative_address(target, rd, label_name, addend)
}

skill absolute_address(target, rd, label_name, addend) {
    out layout.emit_absolute_address(target, rd, label_name, addend)
}

skill resolve(target) {
    out layout.resolve(target)
}

skill executable(target) {
    out image.executable(target)
}
