-- profile — паспорт канонической машины RV32I: ширина слова, число
-- регистров, размер команды, набор расширений (все выключены, кроме CSR,
-- mret и wfi).
--
-- Profile { catalog } — паспорт как хозяин (СОП, 22.11.2026):
--     supports(name) -> yes/no — есть ли команда в таблице;
--     is_machine(kind) -> yes/no — машинная (не базовая) команда;
--     valid() -> yes/no — профиль согласован с abi и таблицей команд

use compiler.contract.abi
use compiler.gorn.backend.riscv.instruction

NAME = "saltic-rv32i-machine"

WORD_BITS = 32
WORD_BYTES = 4
REGISTER_COUNT = 32
INSTRUCTION_BYTES = 4
INSTRUCTION_ALIGNMENT = 4

ENDIAN_LITTLE = 1
ENDIAN = ENDIAN_LITTLE

BASE_INSTRUCTION_COUNT = 40
MACHINE_INSTRUCTION_COUNT = 4
INSTRUCTION_COUNT = BASE_INSTRUCTION_COUNT + MACHINE_INSTRUCTION_COUNT

HAS_COMPRESSED_INSTRUCTIONS = no
HAS_ATOMIC_INSTRUCTIONS = no
HAS_MULTIPLICATION_EXTENSION = no
HAS_FLOATING_POINT = no
HAS_CSR_ACCESS = yes
HAS_MACHINE_RETURN = yes
HAS_MACHINE_WAIT = yes

Profile = Box {
    catalog = instruction.Catalog {}

    skill supports(name) {
        @item = catalog.find(name)
        out (item.kind == Instruction.Kind.UNKNOWN_INSTRUCTION) == no
    }

    skill is_machine(kind) {
        (kind == Instruction.Kind.CSRRW) {
            out yes
        }
        ((kind == Instruction.Kind.CSRRS) ○○ (kind == Instruction.Kind.MRET) ○○ (kind == Instruction.Kind.WFI)) {
            out yes
        }
        out no
    }

    skill valid() {
        ((WORD_BITS == abi.VALUE_WORD_BITS) == no) {
            out no
        }
        ((WORD_BYTES == abi.VALUE_WORD_BYTES) == no) {
            out no
        }
        ((INSTRUCTION_BYTES == INSTRUCTION_ALIGNMENT) == no) {
            out no
        }
        ((INSTRUCTION_COUNT == catalog.count()) == no) {
            out no
        }
        ((BASE_INSTRUCTION_COUNT == instruction.BASE_COUNT) == no) {
            out no
        }
        ((MACHINE_INSTRUCTION_COUNT == instruction.MACHINE_COUNT) == no) {
            out no
        }
        (catalog.valid() == no) {
            out no
        }
        (supports("csrrw") == no) {
            out no
        }
        ((supports("csrrs") == no) ○○ (supports("mret") == no) ○○ (supports("wfi") == no)) {
            out no
        }
        out yes
    }
}
