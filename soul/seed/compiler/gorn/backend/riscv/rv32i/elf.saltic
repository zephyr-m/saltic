-- elf — ELF32 RISC-V из layout.Program: сегменты, секции .text/.rodata/
-- .data/.bss и таблица символов из меток. Общая запись байтов — backend.image.
-- Тело (payload) начинается с файлового смещения 4096; load_address должен
-- быть выровнен на страницу (LoadAddressNotAligned). Низкая память
-- (low_memory_size) — отдельный сегмент с адреса 0.
--
-- Tables { symbols, names } / ProgramHeader { … } / SectionHeader { … }
-- section_index(section) -> номер секции в ELF
-- symbol_tables(program, layout) -> Tables; section_names() -> buffer
-- append_header / append_program_header / append_section_header(target, …)
-- executable(program) -> buffer ELF; UnresolvedPatch, LoadAddressNotAligned
-- write(path, program) — ELF через image.write_program

use compiler.gorn.backend.layout
use compiler.machine.word
use compiler.machine.wide
use compiler.gorn.backend.buffer
use compiler.gorn.backend.image

Tables = Box {
    symbols = buffer.Buffer {},
    names = buffer.Buffer {}
}

ProgramHeader = Box {
    type = 0,
    offset = 0,
    virtual_address = word.Word {},
    physical_address = word.Word {},
    file_size = 0,
    memory_size = word.Word {},
    flags = 0,
    alignment = 0
}

SectionHeader = Box {
    name = 0,
    type = 0,
    flags = 0,
    address = word.Word {},
    offset = 0,
    size = word.Word {},
    link = 0,
    info = 0,
    alignment = 0,
    entry_size = 0
}

skill section_index(section) {
    (section == layout.Section.CODE) { out 1 }
    (section == layout.Section.RODATA) { out 2 }
    (section == layout.Section.DATA) { out 3 }
    out 4
}

skill symbol_tables(value, current_layout) {
    @symbols = buffer.empty()
    symbols.append_zeroes(16)
    @names = buffer.empty()
    names.append_byte(0)
    @label = value.labels_first
    drum (value.label_count) {
        @name_offset = names.length
        names = image.append_cstring(names, label.name)
        @address = value.label_address(current_layout, label.name, 0)
        @info = 17
        (label.section == layout.Section.CODE) { info = 18 }
        symbols = image.append_number32(symbols, name_offset)
        symbols = image.append_u32(symbols, address)
        symbols = image.append_number32(symbols, 0)
        symbols.append_byte(info)
        symbols.append_byte(0)
        symbols.append_u16(section_index(label.section))
        label = label.next
    }
    out Tables { symbols = symbols, names = names }
}

skill section_names() {
    @names = buffer.empty()
    names.append_byte(0)
    names = image.append_cstring(names, ".text")
    names = image.append_cstring(names, ".rodata")
    names = image.append_cstring(names, ".data")
    names = image.append_cstring(names, ".bss")
    names = image.append_cstring(names, ".symtab")
    names = image.append_cstring(names, ".strtab")
    names = image.append_cstring(names, ".shstrtab")
    out names
}

skill append_program_header(target, header) {
    target = image.append_number32(target, header.type)
    target = image.append_number32(target, header.offset)
    target = image.append_u32(target, header.virtual_address)
    target = image.append_u32(target, header.physical_address)
    target = image.append_number32(target, header.file_size)
    target = image.append_u32(target, header.memory_size)
    target = image.append_number32(target, header.flags)
    target = image.append_number32(target, header.alignment)
    out target
}

skill append_section_header(target, header) {
    target = image.append_number32(target, header.name)
    target = image.append_number32(target, header.type)
    target = image.append_number32(target, header.flags)
    target = image.append_u32(target, header.address)
    target = image.append_number32(target, header.offset)
    target = image.append_u32(target, header.size)
    target = image.append_number32(target, header.link)
    target = image.append_number32(target, header.info)
    target = image.append_number32(target, header.alignment)
    target = image.append_number32(target, header.entry_size)
    out target
}

skill append_header(target, entry, program_count, section_table_offset) {
    target.append_byte(127)
    target.append_byte(69)
    target.append_byte(76)
    target.append_byte(70)
    target.append_byte(1)
    target.append_byte(1)
    target.append_byte(1)
    target.append_zeroes(9)
    target.append_u16(2)
    target.append_u16(243)
    target = image.append_number32(target, 1)
    target = image.append_u32(target, entry)
    target = image.append_number32(target, 52)
    target = image.append_number32(target, section_table_offset)
    target = image.append_number32(target, 0)
    target.append_u16(52)
    target.append_u16(32)
    target.append_u16(program_count)
    target.append_u16(40)
    target.append_u16(8)
    target.append_u16(7)
    out target
}

skill executable(value) {
    (value.resolved == no) { value = layout.resolve(value) rescue |failure| { out error.UnresolvedPatch } }
    @current_layout = value.layout()
    @entry = value.label_address(current_layout, value.entry, 0)
    @page_offset = value.load_address.b0 + value.load_address.b1 % 16 * 256
    (page_offset > 0) { out error.LoadAddressNotAligned }

    @body = image.payload(value, current_layout)
    @tables = symbol_tables(value, current_layout)
    @names = section_names()
    @segment_offset = 4096
    @symbols_offset = layout.align(segment_offset + body.length, 4)
    @strings_offset = symbols_offset + tables.symbols.length
    @section_names_offset = strings_offset + tables.names.length
    @section_table_offset = layout.align(section_names_offset + names.length, 4)
    @has_writable = value.data.length > 0
    (wide.is_zero(value.bss_size) == no) { has_writable = yes }
    @program_count = 1
    (has_writable == yes) { program_count = program_count + 1 }
    (value.low_memory_size > 0) { program_count = 2 }
    (value.low_memory_size > 0) {
        (has_writable == yes) { program_count = 3 }
    }

    @result = buffer.empty()
    result = append_header(result, entry, program_count, section_table_offset)
    (value.low_memory_size > 0) {
        result = append_program_header(result, ProgramHeader {
            type = 1,
            offset = 0,
            virtual_address = word.from_bytes(0, 0, 0, 0),
            physical_address = word.from_bytes(0, 0, 0, 0),
            file_size = 52 + program_count * 32,
            memory_size = layout.address_from_number(value.low_memory_size),
            flags = 6,
            alignment = 4096
        })
    }
    result = append_program_header(result, ProgramHeader {
        type = 1,
        offset = segment_offset,
        virtual_address = value.load_address,
        physical_address = value.load_address,
        file_size = current_layout.data_offset,
        memory_size = layout.address_from_number(current_layout.data_offset),
        flags = 5,
        alignment = 4096
    })
    (has_writable == yes) {
        @data_file_size = current_layout.file_size - current_layout.data_offset
        @data_address = layout.address_add(value.load_address, current_layout.data_offset)
        result = append_program_header(result, ProgramHeader {
            type = 1,
            offset = segment_offset + current_layout.data_offset,
            virtual_address = data_address,
            physical_address = data_address,
            file_size = data_file_size,
            memory_size = wide.to_word(wide.add_number(value.bss_size, data_file_size)),
            flags = 6,
            alignment = 4096
        })
    }
    result = image.pad_to(result, segment_offset)
    result.append_buffer(body)
    result = image.pad_to(result, symbols_offset)
    result.append_buffer(tables.symbols)
    result.append_buffer(tables.names)
    result.append_buffer(names)
    result = image.pad_to(result, section_table_offset)

    result.append_zeroes(40)
    result = append_section_header(result, SectionHeader {
        name = 1, type = 1, flags = 6,
        address = layout.address_add(value.load_address, current_layout.code_offset),
        offset = segment_offset + current_layout.code_offset,
        size = layout.address_from_number(value.code.length), link = 0, info = 0, alignment = 4, entry_size = 0
    })
    result = append_section_header(result, SectionHeader {
        name = 7, type = 1, flags = 2,
        address = layout.address_add(value.load_address, current_layout.rodata_offset),
        offset = segment_offset + current_layout.rodata_offset,
        size = layout.address_from_number(value.rodata.length), link = 0, info = 0, alignment = 8, entry_size = 0
    })
    result = append_section_header(result, SectionHeader {
        name = 15, type = 1, flags = 3,
        address = layout.address_add(value.load_address, current_layout.data_offset),
        offset = segment_offset + current_layout.data_offset,
        size = layout.address_from_number(value.data.length), link = 0, info = 0, alignment = 8, entry_size = 0
    })
    result = append_section_header(result, SectionHeader {
        name = 21, type = 8, flags = 3,
        address = layout.address_add(value.load_address, current_layout.bss_offset),
        offset = segment_offset + current_layout.bss_offset,
        size = wide.to_word(value.bss_size), link = 0, info = 0, alignment = 8, entry_size = 0
    })
    result = append_section_header(result, SectionHeader {
        name = 26, type = 2, flags = 0, address = word.from_bytes(0, 0, 0, 0),
        offset = symbols_offset, size = layout.address_from_number(tables.symbols.length),
        link = 6, info = 1, alignment = 4, entry_size = 16
    })
    result = append_section_header(result, SectionHeader {
        name = 34, type = 3, flags = 0, address = word.from_bytes(0, 0, 0, 0),
        offset = strings_offset, size = layout.address_from_number(tables.names.length),
        link = 0, info = 0, alignment = 1, entry_size = 0
    })
    result = append_section_header(result, SectionHeader {
        name = 42, type = 3, flags = 0, address = word.from_bytes(0, 0, 0, 0),
        offset = section_names_offset, size = layout.address_from_number(names.length),
        link = 0, info = 0, alignment = 1, entry_size = 0
    })
    out result
}

skill write(path, value) {
    @output = executable(value) rescue |failure| { out error.UnresolvedPatch }
    out image.write_program(path, output)
}
