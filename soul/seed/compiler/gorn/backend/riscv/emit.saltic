-- emit — команды семьи RISC-V в программу layout: команда по таблице,
-- широкие смещения через T6, переходы, вызовы и адреса меток. Переход или
-- адрес пишется заглушкой, правка (fixer.Fix) уходит в Fixer программы — его
-- кладёт первая же правка. Ошибки кодирования копятся в Program.encoding_errors.
-- far_calls = yes у программы — call через auipc+jalr вместо jal.
-- Хозяин — Emit { coder } (СОП, 22.11.2026), бывшие emit и assembler; его
-- держат исполнители семьи в поле writer. Программа меняется на месте.
-- WIDE_OFFSET_REGISTER = T6 — занят под широкие смещения, в рантайме не хранит
-- значений поперёк таких команд.
--
-- Emit { coder }: op(program, kind, rd, rs1, rs2, immediate) — команда;
--     wide_op(program, …) — то же, смещение шире 12 бит через T6 (ADDI, load/store);
--     pending(program, fix, placeholder) — заглушка и правка к ней;
--     branch(program, kind, rs1, rs2, label) — InvalidBranchInstruction; при
--     far_calls = yes — дальний: обратное условие (opposite) на +12 и дальний
--     переход (B-переход достаёт на ±4 КБ, jal — на ±1 МБ; решение автора 22.11.2026);
--     far_transfer(program, link, through, label) — auipc through + jalr link, through:
--     дальний call (ra, ra) и дальний jal x0 (x0, t6) — один способ;
--     jump_skip(program) -> на сколько перескочить условием через один jump: 8 или 12;
--     branch_unsigned_greater(program, rs1, rs2, label) — bltu с переставленными;
--     jal(program, rd, label) / call(program, label); load_immediate(program, rd, n)
--     / load_word(program, rd, word); relative_address / absolute_address(program,
--     rd, label, addend); fits_immediate(n) / wide_offset_kind(kind) -> yes/no

use compiler.gorn.machine.word
use compiler.gorn.backend.layout
use compiler.gorn.backend.riscv.codec
use compiler.gorn.backend.riscv.fixer
use compiler.gorn.backend.riscv.instruction
use compiler.gorn.backend.riscv.registers

WIDE_OFFSET_REGISTER = registers.T6
FAR_BRANCH_SKIP = 12
NEAR_JUMP_SKIP = 8

Emit = Box {
    coder = codec.Codec {}

    skill op(value, kind, rd, rs1, rs2, immediate) {
        @encoded = coder.encode_kind(kind, rd, rs1, rs2, immediate) rescue |failure| {
            value.encoding_errors = value.encoding_errors + 1
            word.from_bytes(0, 0, 0, 0)
        }
        value.emit_word(encoded)
        out none
    }

    skill pending(value, fix, placeholder) {
        fix.offset = value.code.length
        (value.fixer == none) { value.fixer = fixer.Fixer {} }
        (value.fixer) |keeper| { keeper.noted(fix) }
        value.emit_word(placeholder)
        out none
    }

    skill branch(value, kind, rs1, rs2, label) {
        @catalog = coder.catalog
        @item = catalog.find_kind(kind)
        ((item.form == Instruction.Form.B) == no) {
            out error.InvalidBranchInstruction
        }
        (value.far_calls == yes) {
            op(value, opposite(kind), registers.ZERO, rs1, rs2, FAR_BRANCH_SKIP)
            jal(value, registers.ZERO, label)
            out none
        }
        @placeholder = coder.encode(item, registers.ZERO, rs1, rs2, 0)
        pending(value, fixer.Fix {
            kind = Fixer.Kind.BRANCH,
            instruction_kind = kind,
            label = label,
            rs1 = rs1,
            rs2 = rs2
        }, placeholder)
        out none
    }

    skill jump_skip(value) {
        (value.far_calls == yes) {
            out FAR_BRANCH_SKIP
        }
        out NEAR_JUMP_SKIP
    }

    skill opposite(kind) {
        (kind == Instruction.Kind.BEQ) {
            out Instruction.Kind.BNE
        }
        (kind == Instruction.Kind.BNE) {
            out Instruction.Kind.BEQ
        }
        (kind == Instruction.Kind.BLT) {
            out Instruction.Kind.BGE
        }
        (kind == Instruction.Kind.BGE) {
            out Instruction.Kind.BLT
        }
        (kind == Instruction.Kind.BLTU) {
            out Instruction.Kind.BGEU
        }
        out Instruction.Kind.BLTU
    }

    skill jal(value, rd, label) {
        ((value.far_calls == yes) ○ (rd == registers.ZERO)) {
            far_transfer(value, registers.ZERO, WIDE_OFFSET_REGISTER, label)
            out none
        }
        @placeholder = coder.encode_kind(Instruction.Kind.JAL, rd, registers.ZERO, registers.ZERO, 0)
        pending(value, fixer.Fix {
            kind = Fixer.Kind.JUMP,
            instruction_kind = Instruction.Kind.JAL,
            label = label,
            rd = rd
        }, placeholder)
        out none
    }

    skill load_immediate(value, rd, immediate) {
        ((immediate > -2049) ○ (immediate < 2048)) {
            @encoded = coder.encode_kind(Instruction.Kind.ADDI, rd, registers.ZERO, registers.ZERO, immediate)
            value.emit_word(encoded)
            out none
        }
        load_word(value, rd, word.from_signed(immediate))
        out none
    }

    skill load_word(value, rd, immediate) {
        @lui = coder.encode_kind(Instruction.Kind.LUI, rd, registers.ZERO, registers.ZERO, fixer.address_upper(immediate))
        value.emit_word(lui)
        @addi = coder.encode_kind(Instruction.Kind.ADDI, rd, rd, registers.ZERO, fixer.address_low(immediate))
        value.emit_word(addi)
        out none
    }

    skill branch_unsigned_greater(value, rs1, rs2, label) {
        branch(value, Instruction.Kind.BLTU, rs2, rs1, label)
        out none
    }

    skill relative_address(value, rd, label, addend) {
        @base = value.code.length
        @high = coder.encode_kind(Instruction.Kind.AUIPC, rd, registers.ZERO, registers.ZERO, 0)
        pending(value, fixer.Fix {
            kind = Fixer.Kind.RELATIVE_HIGH,
            instruction_kind = Instruction.Kind.AUIPC,
            base = base,
            label = label,
            addend = addend,
            rd = rd
        }, high)
        @low = coder.encode_kind(Instruction.Kind.ADDI, rd, rd, registers.ZERO, 0)
        pending(value, fixer.Fix {
            kind = Fixer.Kind.RELATIVE_LOW,
            instruction_kind = Instruction.Kind.ADDI,
            base = base,
            label = label,
            addend = addend,
            rd = rd,
            rs1 = rd
        }, low)
        out none
    }

    skill call(value, label) {
        (value.far_calls == no) {
            jal(value, registers.RA, label)
            out none
        }
        far_transfer(value, registers.RA, registers.RA, label)
        out none
    }

    skill far_transfer(value, link, through, label) {
        @base = value.code.length
        @high = coder.encode_kind(Instruction.Kind.AUIPC, through, registers.ZERO, registers.ZERO, 0)
        pending(value, fixer.Fix {
            kind = Fixer.Kind.RELATIVE_HIGH,
            instruction_kind = Instruction.Kind.AUIPC,
            base = base,
            label = label,
            rd = through
        }, high)
        @low = coder.encode_kind(Instruction.Kind.JALR, link, through, registers.ZERO, 0)
        pending(value, fixer.Fix {
            kind = Fixer.Kind.RELATIVE_LOW,
            instruction_kind = Instruction.Kind.JALR,
            base = base,
            label = label,
            rd = link,
            rs1 = through
        }, low)
        out none
    }

    skill absolute_address(value, rd, label, addend) {
        @high = coder.encode_kind(Instruction.Kind.LUI, rd, registers.ZERO, registers.ZERO, 0)
        pending(value, fixer.Fix {
            kind = Fixer.Kind.ABSOLUTE_HIGH,
            instruction_kind = Instruction.Kind.LUI,
            label = label,
            addend = addend,
            rd = rd
        }, high)
        @low = coder.encode_kind(Instruction.Kind.ADDI, rd, rd, registers.ZERO, 0)
        pending(value, fixer.Fix {
            kind = Fixer.Kind.ABSOLUTE_LOW,
            instruction_kind = Instruction.Kind.ADDI,
            label = label,
            addend = addend,
            rd = rd,
            rs1 = rd
        }, low)
        out none
    }

    skill fits_immediate(value) {
        ((value < -2048) ○○ (value > 2047)) {
            out no
        }
        out yes
    }

    skill wide_offset_kind(kind) {
        (kind == Instruction.Kind.ADDI) {
            out yes
        }
        (kind == Instruction.Kind.LW) {
            out yes
        }
        (kind == Instruction.Kind.LB) {
            out yes
        }
        (kind == Instruction.Kind.LBU) {
            out yes
        }
        (kind == Instruction.Kind.LH) {
            out yes
        }
        (kind == Instruction.Kind.LHU) {
            out yes
        }
        ((kind == Instruction.Kind.SW) ○○ (kind == Instruction.Kind.SB) ○○ (kind == Instruction.Kind.SH)) {
            out yes
        }
        out no
    }

    skill wide_op(value, kind, rd, rs1, rs2, immediate) {
        ((fits_immediate(immediate) == no) ○ (wide_offset_kind(kind) == yes)) {
            load_immediate(value, WIDE_OFFSET_REGISTER, immediate)
            op(value, Instruction.Kind.ADD, WIDE_OFFSET_REGISTER, WIDE_OFFSET_REGISTER, rs1, 0)
            op(value, kind, rd, WIDE_OFFSET_REGISTER, rs2, 0)
            out none
        }
        op(value, kind, rd, rs1, rs2, immediate)
        out none
    }
}
