-- rv64 — исполнитель договора машины для RV64 (канон RVA23). Всё, что на
-- RV64 кодируется так же, как на RV32I — арифметика, сравнения, переходы,
-- вызовы, auipc + addi, lui + addi, ecall, — отдаёт исполнителю RV32I (поле
-- narrow_executor, один на сборку) на той же раскладке (rv32i.machine.layout).
-- Сам делает 64-битное: слово 8 байт (ld / sd, push / pop, data_word),
-- 32-битные поля (lwu / sw / data32), сдвиги до 63 — по форме (machine.forms);
-- общие с RV32I (addi, lui, lbu…) — через rv32i.assembler. Широкое смещение
-- (не влезает в 12 бит) — через t6, как у RV32I. 32-битная константа — lui +
-- addiw (не addi: иначе значение чуть ниже 2^31 после lui расширится знаком).
-- Раскладка памяти — abi.shape на 8 байт (WORDS). Вызов ядра — номер RV32 из
-- core.system, кроме часов: clock_gettime64 (403) на RV64 — clock_gettime 113.
--
-- Executor { far_calls, narrow_executor } — методы договора backend (../../main.saltic);
--     внутренние: narrow() -> narrow_executor (rv32i, один на сборку; far_calls
--     берёт программа), emit(billet, encoded) — слово команды в код,
--     wide_offset(billet, base, offset) — t6 = base + offset
-- Сверх договора RV32I: multiply / multiply_high / multiply_high_unsigned / divide / remainder /
--     divide_unsigned / remainder_unsigned(to, left, right) — M; load_wide(to,
--     wide) — константа из rodata (auipc + addi + ld); WORDS — abi.shape.of(8)

use core.group
use core.system
use compiler.gorn.backend
use compiler.gorn.backend.riscv.rv32i
use compiler.gorn.backend.layout
use compiler.gorn.backend.riscv.registers
use compiler.gorn.backend.riscv.rv64.machine.forms
use compiler.gorn.backend.riscv.assembler
use compiler.gorn.backend.riscv.instruction
use compiler.abi.shape
use compiler.machine.word
use compiler.machine.wide
use compiler.gorn.state
use compiler.gorn.backend.riscv.emit
use compiler.gorn.backend.riscv.fixer

WORDS = shape.of(8)
WORD_BYTES = 8
WIDE_OFFSET_REGISTER = registers.T6

Executor = Box {
    far_calls = no,
    narrow_executor = rv32i.Executor {}

    skill narrow() {
        out narrow_executor
    }

    skill register(role) {
        out group.get(rv32i.REGISTER_OF_ROLE, role)
    }

    skill emit(billet, encoded) {
        @billet_machine = billet.machine
        billet_machine.emit_word(encoded)
        out billet
    }

    skill wide_offset(billet, base, offset) {
        billet.machine = emit.load_immediate(billet.machine, WIDE_OFFSET_REGISTER, offset)
        out assembler.emit_op(billet, instruction.Kind.ADD, WIDE_OFFSET_REGISTER, WIDE_OFFSET_REGISTER, base, 0)
    }

    skill new_program(billet, entry) {
        @narrowed = narrow()
        billet = narrowed.new_program(billet, entry)
        billet.machine.far_calls = far_calls
        billet.words = WORDS
        out billet
    }

    skill heap_size(billet, bytes) {
        @base = narrow()
        out base.heap_size(billet, bytes)
    }

    skill label(billet, name) {
        @base = narrow()
        out base.label(billet, name)
    }

    skill data_label(billet, where, name) {
        @base = narrow()
        out base.data_label(billet, where, name)
    }

    skill align(billet, where, boundary) {
        @base = narrow()
        out base.align(billet, where, boundary)
    }

    skill data32(billet, where, value) {
        @base = narrow()
        out base.data_word(billet, where, value)
    }

    skill data_word(billet, where, value) {
        @base = narrow()
        billet = base.data_word(billet, where, value)
        @fill = 0
        (value.b3 > 127) { fill = 255 }
        drum (4) { billet = base.data_byte(billet, where, fill) }
        out billet
    }

    skill data_byte(billet, where, value) {
        @base = narrow()
        out base.data_byte(billet, where, value)
    }

    skill data_text(billet, where, text) {
        @base = narrow()
        out base.data_text(billet, where, text)
    }

    skill reserve(billet, bytes) {
        @base = narrow()
        out base.reserve(billet, bytes)
    }

    skill load_immediate(billet, to, value) {
        (assembler.fits_immediate(value) == yes) {
            out assembler.emit_op(billet, instruction.Kind.ADDI, register(to), registers.ZERO, registers.ZERO, value)
        }
        out load_word(billet, to, word.from_signed(value))
    }

    skill load_word(billet, to, value) {
        billet = assembler.emit_op(billet, instruction.Kind.LUI, register(to), registers.ZERO, registers.ZERO, fixer.address_upper(value))
        out emit(billet, forms.addiw(register(to), register(to), fixer.address_low(value)))
    }

    skill load_address(billet, to, name, addend) {
        @base = narrow()
        out base.load_address(billet, to, name, addend)
    }

    skill move(billet, to, from) {
        @base = narrow()
        out base.move(billet, to, from)
    }

    skill negate(billet, to, from) {
        @base = narrow()
        out base.negate(billet, to, from)
    }

    skill add_immediate(billet, to, from, value) {
        @base = narrow()
        out base.add_immediate(billet, to, from, value)
    }

    skill add(billet, to, left, right) {
        @base = narrow()
        out base.add(billet, to, left, right)
    }

    skill sub(billet, to, left, right) {
        @base = narrow()
        out base.sub(billet, to, left, right)
    }

    skill and(billet, to, left, right) {
        @base = narrow()
        out base.and(billet, to, left, right)
    }

    skill or(billet, to, left, right) {
        @base = narrow()
        out base.or(billet, to, left, right)
    }

    skill xor(billet, to, left, right) {
        @base = narrow()
        out base.xor(billet, to, left, right)
    }

    skill and_immediate(billet, to, from, value) {
        @base = narrow()
        out base.and_immediate(billet, to, from, value)
    }

    skill or_immediate(billet, to, from, value) {
        @base = narrow()
        out base.or_immediate(billet, to, from, value)
    }

    skill xor_immediate(billet, to, from, value) {
        @base = narrow()
        out base.xor_immediate(billet, to, from, value)
    }

    skill shift_left(billet, to, from, count) {
        out emit(billet, forms.slli(register(to), register(from), count))
    }

    skill shift_right_signed(billet, to, from, count) {
        out emit(billet, forms.srai(register(to), register(from), count))
    }

    skill shift_right_unsigned(billet, to, from, count) {
        out emit(billet, forms.srli(register(to), register(from), count))
    }

    skill shift_left_by(billet, to, from, count) {
        @base = narrow()
        out base.shift_left_by(billet, to, from, count)
    }

    skill shift_right_unsigned_by(billet, to, from, count) {
        @base = narrow()
        out base.shift_right_unsigned_by(billet, to, from, count)
    }

    skill set_less(billet, to, left, right) {
        @base = narrow()
        out base.set_less(billet, to, left, right)
    }

    skill set_less_unsigned(billet, to, left, right) {
        @base = narrow()
        out base.set_less_unsigned(billet, to, left, right)
    }

    skill set_less_unsigned_immediate(billet, to, from, value) {
        @base = narrow()
        out base.set_less_unsigned_immediate(billet, to, from, value)
    }

    skill set_zero(billet, to, from) {
        @base = narrow()
        out base.set_zero(billet, to, from)
    }

    skill set_nonzero(billet, to, from) {
        @base = narrow()
        out base.set_nonzero(billet, to, from)
    }

    skill add_checked(billet) {
        @base = narrow()
        out base.add_checked(billet)
    }

    skill sub_checked(billet) {
        @base = narrow()
        out base.sub_checked(billet)
    }

    skill load(billet, to, base, offset) {
        (assembler.fits_immediate(offset) == no) {
            billet = wide_offset(billet, register(base), offset)
            out emit(billet, forms.ld(register(to), WIDE_OFFSET_REGISTER, 0))
        }
        out emit(billet, forms.ld(register(to), register(base), offset))
    }

    skill load32(billet, to, base, offset) {
        (assembler.fits_immediate(offset) == no) {
            billet = wide_offset(billet, register(base), offset)
            out emit(billet, forms.lwu(register(to), WIDE_OFFSET_REGISTER, 0))
        }
        out emit(billet, forms.lwu(register(to), register(base), offset))
    }

    skill store32(billet, from, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.SW, registers.ZERO, register(base), register(from), offset)
    }

    skill load_byte(billet, to, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.LBU, register(to), register(base), registers.ZERO, offset)
    }

    skill load_half(billet, to, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.LHU, register(to), register(base), registers.ZERO, offset)
    }

    skill store(billet, from, base, offset) {
        (assembler.fits_immediate(offset) == no) {
            billet = wide_offset(billet, register(base), offset)
            out emit(billet, forms.sd(register(from), WIDE_OFFSET_REGISTER, 0))
        }
        out emit(billet, forms.sd(register(from), register(base), offset))
    }

    skill store_byte(billet, from, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.SB, registers.ZERO, register(base), register(from), offset)
    }

    skill store_half(billet, from, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.SH, registers.ZERO, register(base), register(from), offset)
    }

    skill store_zero(billet, base, offset) {
        (assembler.fits_immediate(offset) == no) {
            billet = wide_offset(billet, register(base), offset)
            out emit(billet, forms.sd(registers.ZERO, WIDE_OFFSET_REGISTER, 0))
        }
        out emit(billet, forms.sd(registers.ZERO, register(base), offset))
    }

    skill store_byte_zero(billet, base, offset) {
        out assembler.emit_op(billet, instruction.Kind.SB, registers.ZERO, register(base), registers.ZERO, offset)
    }

    skill push(billet, from) {
        billet = assembler.emit_op(billet, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -WORD_BYTES)
        out emit(billet, forms.sd(register(from), registers.SP, 0))
    }

    skill pop(billet, to) {
        billet = emit(billet, forms.ld(register(to), registers.SP, 0))
        out assembler.emit_op(billet, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, WORD_BYTES)
    }

    skill branch_equal(billet, left, right, name) {
        @base = narrow()
        out base.branch_equal(billet, left, right, name)
    }

    skill branch_not_equal(billet, left, right, name) {
        @base = narrow()
        out base.branch_not_equal(billet, left, right, name)
    }

    skill branch_less(billet, left, right, name) {
        @base = narrow()
        out base.branch_less(billet, left, right, name)
    }

    skill branch_greater_equal(billet, left, right, name) {
        @base = narrow()
        out base.branch_greater_equal(billet, left, right, name)
    }

    skill branch_less_unsigned(billet, left, right, name) {
        @base = narrow()
        out base.branch_less_unsigned(billet, left, right, name)
    }

    skill branch_greater_equal_unsigned(billet, left, right, name) {
        @base = narrow()
        out base.branch_greater_equal_unsigned(billet, left, right, name)
    }

    skill branch_zero(billet, from, name) {
        @base = narrow()
        out base.branch_zero(billet, from, name)
    }

    skill branch_nonzero(billet, from, name) {
        @base = narrow()
        out base.branch_nonzero(billet, from, name)
    }

    skill branch_negative(billet, from, name) {
        @base = narrow()
        out base.branch_negative(billet, from, name)
    }

    skill branch_not_negative(billet, from, name) {
        @base = narrow()
        out base.branch_not_negative(billet, from, name)
    }

    skill branch_not_positive(billet, from, name) {
        @base = narrow()
        out base.branch_not_positive(billet, from, name)
    }

    skill jump(billet, name) {
        @base = narrow()
        out base.jump(billet, name)
    }

    skill jump_if_equal(billet, left, right, name) {
        @base = narrow()
        out base.jump_if_equal(billet, left, right, name)
    }

    skill jump_if_not_equal(billet, left, right, name) {
        @base = narrow()
        out base.jump_if_not_equal(billet, left, right, name)
    }

    skill jump_if_zero(billet, from, name) {
        @base = narrow()
        out base.jump_if_zero(billet, from, name)
    }

    skill jump_if_nonzero(billet, from, name) {
        @base = narrow()
        out base.jump_if_nonzero(billet, from, name)
    }

    skill jump_far(billet, name) {
        @base = narrow()
        out base.jump_far(billet, name)
    }

    skill call(billet, name) {
        @base = narrow()
        out base.call(billet, name)
    }

    skill ret(billet) {
        @base = narrow()
        out base.ret(billet)
    }

    skill syscall(billet, number) {
        @base = narrow()
        (number == system.SYSCALL_CLOCK_GETTIME) { out base.syscall(billet, system.SYSCALL_CLOCK_GETTIME_RV64) }
        out base.syscall(billet, number)
    }

    skill wait(billet) {
        @base = narrow()
        out base.wait(billet)
    }

    skill fence(billet) {
        @base = narrow()
        out base.fence(billet)
    }

    skill multiply(billet, to, left, right) {
        out emit(billet, forms.mul(register(to), register(left), register(right)))
    }

    skill multiply_high(billet, to, left, right) {
        out emit(billet, forms.mulh(register(to), register(left), register(right)))
    }

    skill multiply_high_unsigned(billet, to, left, right) {
        out emit(billet, forms.mulhu(register(to), register(left), register(right)))
    }

    skill divide(billet, to, left, right) {
        out emit(billet, forms.div(register(to), register(left), register(right)))
    }

    skill remainder(billet, to, left, right) {
        out emit(billet, forms.rem(register(to), register(left), register(right)))
    }

    skill divide_unsigned(billet, to, left, right) {
        out emit(billet, forms.divu(register(to), register(left), register(right)))
    }

    skill remainder_unsigned(billet, to, left, right) {
        out emit(billet, forms.remu(register(to), register(left), register(right)))
    }

    skill fraction(billet, op, to, left, right) {
        billet = emit(billet, forms.fmv_d_x(0, register(left)))
        billet = emit(billet, forms.fmv_d_x(1, register(right)))
        (op == backend.FRACTION_LESS) { out emit(billet, forms.flt(register(to), 0, 1)) }
        (op == backend.FRACTION_LESS_EQUAL) { out emit(billet, forms.fle(register(to), 0, 1)) }
        billet = emit(billet, forms.fop(op, 0, 0, 1))
        out emit(billet, forms.fmv_x_d(register(to), 0))
    }

    skill fraction_from(billet, to, from) {
        billet = emit(billet, forms.fcvt_d_l(0, register(from)))
        out emit(billet, forms.fmv_x_d(register(to), 0))
    }

    skill fraction_to(billet, to, from, mode) {
        billet = emit(billet, forms.fmv_d_x(0, register(from)))
        out emit(billet, forms.fcvt_l_d(register(to), 0, mode))
    }

    skill load_wide(billet, to, value) {
        @base = narrow()
        @name = state.label(billet, "wide")
        billet = base.align(billet, backend.RODATA, 8)
        billet = base.data_label(billet, backend.RODATA, name)
        billet = base.data_word(billet, backend.RODATA, value.low)
        billet = base.data_word(billet, backend.RODATA, value.high)
        billet = base.load_address(billet, to, name, 0)
        out load(billet, to, to, 0)
    }
}
