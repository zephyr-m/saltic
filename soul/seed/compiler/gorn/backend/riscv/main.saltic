-- riscv — исполнитель базового набора RISC-V (RV32I, слово 4 байта): цель
-- rv32i берёт его как есть, rv64 зовёт его для всего, что кодируется так же
-- (решение автора 22.11.2026: общее семьи — в папке семьи, у детей — своё:
-- rv32i/{profile,elf}, rv64/). Фасад над layout / emit / elf — в архиве.
-- Executor — Box с методами договора (см. ../../main.saltic): роль → регистр
-- по REGISTER_OF_ROLE (порядок совпадает с номерами ролей в backend), команды
-- через writer.wide_op (широкие смещения — t6, свободный от ролей).
-- far_calls = yes — вызовы auipc+jalr.
--
-- Executor { far_calls } — все 67 методов договора backend (../../main.saltic); внутренние
--     register(role) -> номер регистра, section(value) -> Layout.Section,
--     checked(billet, kind) — общая часть add_checked / sub_checked

use core.group
use compiler.abi
use compiler.gorn.backend
use compiler.gorn.backend.riscv.instruction
use compiler.gorn.backend.layout
use compiler.gorn.backend.riscv.rv32i.elf
use compiler.gorn.backend.riscv.registers
use compiler.gorn.backend.riscv.emit

REGISTER_OF_ROLE = [
    registers.A0, registers.A1, registers.A2, registers.A3,
    registers.A4, registers.A5, registers.A6, registers.A7,
    registers.T0, registers.T1, registers.T2, registers.T3, registers.T4,
    registers.S0, registers.SP, registers.RA,
    registers.S1, registers.S2, registers.S4, registers.S5,
    registers.T5
]

SKIP_NEXT = 8
FENCE_READ_WRITE = 51

Executor = Box {
    writer = emit.Emit {},
    far_calls = no

    skill register(role) {
        out group.get(REGISTER_OF_ROLE, role)
    }

    skill section(value) {
        (value == backend.CODE) {
            out Layout.Section.CODE
        }
        (value == backend.RODATA) {
            out Layout.Section.RODATA
        }
        (value == backend.DATA) {
            out Layout.Section.DATA
        }
        out Layout.Section.BSS
    }

    skill new_program(billet, entry) {
        billet.machine = layout.host(entry)
        billet.machine.far_calls = far_calls
        out billet
    }

    skill heap_size(billet, bytes) {
        billet.machine.heap_size = bytes
        out billet
    }

    skill label(billet, name) {
        @billet_machine = billet.machine
        billet_machine.define_label(Layout.Section.CODE, name)
        out billet
    }

    skill data_label(billet, where, name) {
        @billet_machine = billet.machine
        billet_machine.define_label(section(where), name)
        out billet
    }

    skill align(billet, where, boundary) {
        @billet_machine = billet.machine
        billet_machine.align_section(section(where), boundary)
        out billet
    }

    skill data32(billet, where, value) {
        out data_word(billet, where, value)
    }

    skill data_word(billet, where, value) {
        @billet_machine = billet.machine
        billet_machine.append_section_word(section(where), value)
        out billet
    }

    skill data_byte(billet, where, value) {
        @billet_machine = billet.machine
        billet_machine.append_section_byte(section(where), value)
        out billet
    }

    skill data_text(billet, where, text) {
        @billet_machine = billet.machine
        billet_machine.append_section_text(section(where), text, yes)
        out billet
    }

    skill reserve(billet, bytes) {
        @billet_machine = billet.machine
        billet_machine.reserve_bss(bytes)
        out billet
    }

    skill load_immediate(billet, to, value) {
        writer.load_immediate(billet.machine, register(to), value)
        out billet
    }

    skill load_word(billet, to, value) {
        writer.load_word(billet.machine, register(to), value)
        out billet
    }

    skill load_address(billet, to, name, addend) {
        writer.relative_address(billet.machine, register(to), name, addend)
        out billet
    }

    skill move(billet, to, from) {
        writer.wide_op(billet.machine, Instruction.Kind.ADDI, register(to), register(from), registers.ZERO, 0)
        out billet
    }

    skill negate(billet, to, from) {
        writer.wide_op(billet.machine, Instruction.Kind.SUB, register(to), registers.ZERO, register(from), 0)
        out billet
    }

    skill add_immediate(billet, to, from, value) {
        writer.wide_op(billet.machine, Instruction.Kind.ADDI, register(to), register(from), registers.ZERO, value)
        out billet
    }

    skill add(billet, to, left, right) {
        writer.wide_op(billet.machine, Instruction.Kind.ADD, register(to), register(left), register(right), 0)
        out billet
    }

    skill sub(billet, to, left, right) {
        writer.wide_op(billet.machine, Instruction.Kind.SUB, register(to), register(left), register(right), 0)
        out billet
    }

    skill and(billet, to, left, right) {
        writer.wide_op(billet.machine, Instruction.Kind.AND, register(to), register(left), register(right), 0)
        out billet
    }

    skill or(billet, to, left, right) {
        writer.wide_op(billet.machine, Instruction.Kind.OR, register(to), register(left), register(right), 0)
        out billet
    }

    skill xor(billet, to, left, right) {
        writer.wide_op(billet.machine, Instruction.Kind.XOR, register(to), register(left), register(right), 0)
        out billet
    }

    skill and_immediate(billet, to, from, value) {
        writer.wide_op(billet.machine, Instruction.Kind.ANDI, register(to), register(from), registers.ZERO, value)
        out billet
    }

    skill or_immediate(billet, to, from, value) {
        writer.wide_op(billet.machine, Instruction.Kind.ORI, register(to), register(from), registers.ZERO, value)
        out billet
    }

    skill xor_immediate(billet, to, from, value) {
        writer.wide_op(billet.machine, Instruction.Kind.XORI, register(to), register(from), registers.ZERO, value)
        out billet
    }

    skill shift_left(billet, to, from, count) {
        writer.wide_op(billet.machine, Instruction.Kind.SLLI, register(to), register(from), registers.ZERO, count)
        out billet
    }

    skill shift_right_signed(billet, to, from, count) {
        writer.wide_op(billet.machine, Instruction.Kind.SRAI, register(to), register(from), registers.ZERO, count)
        out billet
    }

    skill shift_right_unsigned(billet, to, from, count) {
        writer.wide_op(billet.machine, Instruction.Kind.SRLI, register(to), register(from), registers.ZERO, count)
        out billet
    }

    skill shift_left_by(billet, to, from, count) {
        writer.wide_op(billet.machine, Instruction.Kind.SLL, register(to), register(from), register(count), 0)
        out billet
    }

    skill shift_right_unsigned_by(billet, to, from, count) {
        writer.wide_op(billet.machine, Instruction.Kind.SRL, register(to), register(from), register(count), 0)
        out billet
    }

    skill set_less(billet, to, left, right) {
        writer.wide_op(billet.machine, Instruction.Kind.SLT, register(to), register(left), register(right), 0)
        out billet
    }

    skill set_less_unsigned(billet, to, left, right) {
        writer.wide_op(billet.machine, Instruction.Kind.SLTU, register(to), register(left), register(right), 0)
        out billet
    }

    skill set_less_unsigned_immediate(billet, to, from, value) {
        writer.wide_op(billet.machine, Instruction.Kind.SLTIU, register(to), register(from), registers.ZERO, value)
        out billet
    }

    skill set_zero(billet, to, from) {
        writer.wide_op(billet.machine, Instruction.Kind.SLTIU, register(to), register(from), registers.ZERO, 1)
        out billet
    }

    skill set_nonzero(billet, to, from) {
        writer.wide_op(billet.machine, Instruction.Kind.SLTU, register(to), registers.ZERO, register(from), 0)
        out billet
    }

    skill checked(billet, kind) {
        writer.wide_op(billet.machine, kind, registers.T0, registers.A0, registers.A1, 0)
        pick {
            (kind == Instruction.Kind.ADD) {
                writer.wide_op(billet.machine, Instruction.Kind.SLT, registers.T1, registers.T0, registers.A0, 0)
            }
            {
                writer.wide_op(billet.machine, Instruction.Kind.SLT, registers.T1, registers.A0, registers.T0, 0)
            }
        }
        writer.wide_op(billet.machine, Instruction.Kind.SLTI, registers.T2, registers.A1, registers.ZERO, 0)
        writer.wide_op(billet.machine, Instruction.Kind.ADDI, registers.A0, registers.T0, registers.ZERO, 0)
        writer.wide_op(billet.machine, Instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
        writer.op(billet.machine, Instruction.Kind.BEQ, registers.ZERO, registers.T1, registers.T2, SKIP_NEXT)
        writer.wide_op(billet.machine, Instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_NUMBER_OVERFLOW)
        out billet
    }

    skill add_checked(billet) {
        out checked(billet, Instruction.Kind.ADD)
    }

    skill sub_checked(billet) {
        out checked(billet, Instruction.Kind.SUB)
    }

    skill load(billet, to, base, offset) {
        writer.wide_op(billet.machine, Instruction.Kind.LW, register(to), register(base), registers.ZERO, offset)
        out billet
    }

    skill load32(billet, to, base, offset) {
        out load(billet, to, base, offset)
    }

    skill store32(billet, from, base, offset) {
        out store(billet, from, base, offset)
    }

    skill load_byte(billet, to, base, offset) {
        writer.wide_op(billet.machine, Instruction.Kind.LBU, register(to), register(base), registers.ZERO, offset)
        out billet
    }

    skill load_half(billet, to, base, offset) {
        writer.wide_op(billet.machine, Instruction.Kind.LHU, register(to), register(base), registers.ZERO, offset)
        out billet
    }

    skill store(billet, from, base, offset) {
        writer.wide_op(billet.machine, Instruction.Kind.SW, registers.ZERO, register(base), register(from), offset)
        out billet
    }

    skill store_byte(billet, from, base, offset) {
        writer.wide_op(billet.machine, Instruction.Kind.SB, registers.ZERO, register(base), register(from), offset)
        out billet
    }

    skill store_half(billet, from, base, offset) {
        writer.wide_op(billet.machine, Instruction.Kind.SH, registers.ZERO, register(base), register(from), offset)
        out billet
    }

    skill store_zero(billet, base, offset) {
        writer.wide_op(billet.machine, Instruction.Kind.SW, registers.ZERO, register(base), registers.ZERO, offset)
        out billet
    }

    skill store_byte_zero(billet, base, offset) {
        writer.wide_op(billet.machine, Instruction.Kind.SB, registers.ZERO, register(base), registers.ZERO, offset)
        out billet
    }

    skill push(billet, from) {
        writer.wide_op(billet.machine, Instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -abi.VALUE_WORD_BYTES)
        writer.wide_op(billet.machine, Instruction.Kind.SW, registers.ZERO, registers.SP, register(from), 0)
        out billet
    }

    skill pop(billet, to) {
        writer.wide_op(billet.machine, Instruction.Kind.LW, register(to), registers.SP, registers.ZERO, 0)
        writer.wide_op(billet.machine, Instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, abi.VALUE_WORD_BYTES)
        out billet
    }

    skill branch_equal(billet, left, right, name) {
        writer.branch(billet.machine, Instruction.Kind.BEQ, register(left), register(right), name)
        out billet
    }

    skill branch_not_equal(billet, left, right, name) {
        writer.branch(billet.machine, Instruction.Kind.BNE, register(left), register(right), name)
        out billet
    }

    skill branch_less(billet, left, right, name) {
        writer.branch(billet.machine, Instruction.Kind.BLT, register(left), register(right), name)
        out billet
    }

    skill branch_greater_equal(billet, left, right, name) {
        writer.branch(billet.machine, Instruction.Kind.BGE, register(left), register(right), name)
        out billet
    }

    skill branch_less_unsigned(billet, left, right, name) {
        writer.branch(billet.machine, Instruction.Kind.BLTU, register(left), register(right), name)
        out billet
    }

    skill branch_greater_equal_unsigned(billet, left, right, name) {
        writer.branch(billet.machine, Instruction.Kind.BGEU, register(left), register(right), name)
        out billet
    }

    skill branch_zero(billet, from, name) {
        writer.branch(billet.machine, Instruction.Kind.BEQ, register(from), registers.ZERO, name)
        out billet
    }

    skill branch_nonzero(billet, from, name) {
        writer.branch(billet.machine, Instruction.Kind.BNE, register(from), registers.ZERO, name)
        out billet
    }

    skill branch_negative(billet, from, name) {
        writer.branch(billet.machine, Instruction.Kind.BLT, register(from), registers.ZERO, name)
        out billet
    }

    skill branch_not_negative(billet, from, name) {
        writer.branch(billet.machine, Instruction.Kind.BGE, register(from), registers.ZERO, name)
        out billet
    }

    skill branch_not_positive(billet, from, name) {
        writer.branch(billet.machine, Instruction.Kind.BGE, registers.ZERO, register(from), name)
        out billet
    }

    skill jump(billet, name) {
        writer.jal(billet.machine, registers.ZERO, name)
        out billet
    }

    skill jump_if_equal(billet, left, right, name) {
        writer.op(billet.machine, Instruction.Kind.BNE, registers.ZERO, register(left), register(right), SKIP_NEXT)
        out jump(billet, name)
    }

    skill jump_if_not_equal(billet, left, right, name) {
        writer.op(billet.machine, Instruction.Kind.BEQ, registers.ZERO, register(left), register(right), SKIP_NEXT)
        out jump(billet, name)
    }

    skill jump_if_zero(billet, from, name) {
        writer.op(billet.machine, Instruction.Kind.BNE, registers.ZERO, register(from), registers.ZERO, SKIP_NEXT)
        out jump(billet, name)
    }

    skill jump_if_nonzero(billet, from, name) {
        writer.op(billet.machine, Instruction.Kind.BEQ, registers.ZERO, register(from), registers.ZERO, SKIP_NEXT)
        out jump(billet, name)
    }

    skill jump_far(billet, name) {
        writer.relative_address(billet.machine, registers.T1, name, 0)
        writer.op(billet.machine, Instruction.Kind.JALR, registers.ZERO, registers.T1, registers.ZERO, 0)
        out billet
    }

    skill call(billet, name) {
        writer.call(billet.machine, name)
        out billet
    }

    skill ret(billet) {
        writer.wide_op(billet.machine, Instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
        out billet
    }

    skill syscall(billet, number) {
        writer.wide_op(billet.machine, Instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, number)
        writer.wide_op(billet.machine, Instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
        out billet
    }

    skill wait(billet) {
        writer.wide_op(billet.machine, Instruction.Kind.WFI, registers.ZERO, registers.ZERO, registers.ZERO, 0)
        out billet
    }

    skill fence(billet) {
        writer.wide_op(billet.machine, Instruction.Kind.FENCE, registers.ZERO, registers.ZERO, registers.ZERO, FENCE_READ_WRITE)
        out billet
    }
}
