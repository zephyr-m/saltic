-- assembler — команды RV32I по номерам регистров: для рантайма на ассемблере
-- (runtime/*) и для исполнителя договора (main.saltic).
-- emit_op разворачивает смещение, не влезающее в 12 бит, через T6
-- (WIDE_OFFSET_REGISTER) — только для ADDI и load/store; T6 занят, в рантайме
-- он не хранит значений поперёк таких команд.
--
-- fits_immediate(value) / wide_offset_kind(kind) -> yes/no
-- emit_op(billet, kind, rd, rs1, rs2, immediate) — команда в billet.machine
-- load_immediate(billet, rd, value) — число любой ширины (addi или lui+addi)

use compiler.gorn.backend.riscv.instruction
use compiler.gorn.backend.layout
use compiler.gorn.backend.riscv.registers
use compiler.gorn.backend.riscv.emit

WIDE_OFFSET_REGISTER = registers.T6

skill fits_immediate(value) {
    (value < -2048) { out no }
    (value > 2047) { out no }
    out yes
}

skill wide_offset_kind(kind) {
    (kind == Instruction.Kind.ADDI) { out yes }
    (kind == Instruction.Kind.LW) { out yes }
    (kind == Instruction.Kind.LB) { out yes }
    (kind == Instruction.Kind.LBU) { out yes }
    (kind == Instruction.Kind.LH) { out yes }
    (kind == Instruction.Kind.LHU) { out yes }
    (kind == Instruction.Kind.SW) { out yes }
    (kind == Instruction.Kind.SB) { out yes }
    (kind == Instruction.Kind.SH) { out yes }
    out no
}

skill emit_op(billet, kind, rd, rs1, rs2, immediate) {
    (fits_immediate(immediate) == no) {
        (wide_offset_kind(kind) == yes) {
            billet.machine = emit.load_immediate(billet.machine, WIDE_OFFSET_REGISTER, immediate)
            billet.machine = emit.op(billet.machine, Instruction.Kind.ADD, WIDE_OFFSET_REGISTER, WIDE_OFFSET_REGISTER, rs1, 0)
            billet.machine = emit.op(billet.machine, kind, rd, WIDE_OFFSET_REGISTER, rs2, 0)
            out billet
        }
    }
    billet.machine = emit.op(billet.machine, kind, rd, rs1, rs2, immediate)
    out billet
}

skill load_immediate(billet, rd, value) {
    billet.machine = emit.load_immediate(billet.machine, rd, value)
    out billet
}
