-- buffer — растущий буфер байтов машинного кода: куски core.bytes по
-- CHUNK_SIZE байтов в группе chunks, последний кусок заполняется. Байт
-- занимает ровно байт. Buffer — хозяин своих навыков (СОП, 22.11.2026):
-- дописывает и переписывает себя на месте. Проверка байта — своя, без
-- кодека семьи: общее не знает семью.
--
-- Buffer { chunks, used (байтов в последнем куске), length }:
--     меняют: append_byte, append_u16, append_word, append_text, append_zeroes,
--     append_buffer — дописать в конец; ByteOutsideRange, ValueOutsideRange;
--     set_byte, set_word(offset, …) — переписать на месте;
--     отвечают: byte_at(offset) -> байт; chunk_count() -> число кусков;
--     chunk_of(offset) -> кусок; BufferOutsideRange; in_pieces(size) -> группа
--     групп чисел по size байтов; InvalidChunkSize; whole() -> буфер core.bytes
--     ровно на length байтов (для записи в файл)
-- empty() -> пустой буфер

use core.str
use core.group
use core.bytes

CHUNK_SIZE = 4096
BYTE_LIMIT = 256
U16_LIMIT = 65536

Buffer = Box {
    chunks = [],
    used = 0,
    length = 0

    skill chunk_count() {
        out group.count(chunks)
    }

    skill chunk_of(offset) {
        (offset < 0) {
            out error.BufferOutsideRange
        }
        (offset >= length) {
            out error.BufferOutsideRange
        }
        out group.get(chunks, offset / CHUNK_SIZE)
    }

    skill append_byte(value) {
        (value < 0) {
            out error.ByteOutsideRange
        }
        (value >= BYTE_LIMIT) {
            out error.ByteOutsideRange
        }
        @count = group.count(chunks)
        (count == 0) {
            chunks = group.add(chunks, bytes.new(CHUNK_SIZE))
            used = 0
            count = 1
        }
        (used == CHUNK_SIZE) {
            chunks = group.add(chunks, bytes.new(CHUNK_SIZE))
            used = 0
            count = count + 1
        }
        bytes.set(group.get(chunks, count - 1), used, value)
        used = used + 1
        length = length + 1
        out none
    }

    skill append_text(text) {
        drum (str.bytes(text)) {
            append_byte(str.byte(text, beat))
        }
        out none
    }

    skill append_word(value) {
        append_byte(value.b0)
        append_byte(value.b1)
        append_byte(value.b2)
        append_byte(value.b3)
        out none
    }

    skill byte_at(offset) {
        @chunk = chunk_of(offset)
        out bytes.get(chunk, offset % CHUNK_SIZE)
    }

    skill set_byte(offset, value) {
        (value < 0) {
            out error.ByteOutsideRange
        }
        (value >= BYTE_LIMIT) {
            out error.ByteOutsideRange
        }
        @chunk = chunk_of(offset)
        bytes.set(chunk, offset % CHUNK_SIZE, value)
        out none
    }

    skill set_word(offset, value) {
        set_byte(offset, value.b0)
        set_byte(offset + 1, value.b1)
        set_byte(offset + 2, value.b2)
        set_byte(offset + 3, value.b3)
        out none
    }

    skill append_zeroes(count) {
        drum (count) {
            append_byte(0)
        }
        out none
    }

    skill append_buffer(source) {
        drum (source.length) {
            append_byte(source.byte_at(beat))
        }
        out none
    }

    skill whole() {
        @result = bytes.new(length)
        @offset = 0
        drum (chunks) {
            @size = CHUNK_SIZE
            (length - offset < size) {
                size = length - offset
            }
            @chunk = beat
            drum (size) {
                bytes.set(result, offset + beat, bytes.get(chunk, beat))
            }
            offset = offset + size
        }
        out result
    }

    skill in_pieces(size) {
        (size < 1) {
            out error.InvalidChunkSize
        }
        (size > CHUNK_SIZE) {
            out error.InvalidChunkSize
        }
        @result = []
        @piece = []
        drum (length) {
            piece = group.add(piece, byte_at(beat))
            (group.count(piece) == size) {
                result = group.add(result, piece)
                piece = []
            }
        }
        (group.count(piece) > 0) {
            result = group.add(result, piece)
        }
        out result
    }

    skill append_u16(value) {
        (value < 0) {
            out error.ValueOutsideRange
        }
        (value >= U16_LIMIT) {
            out error.ValueOutsideRange
        }
        append_byte(value % 256)
        append_byte(value / 256)
        out none
    }
}

skill empty() {
    out Buffer {}
}
