-- image — запись образа, общая для всех исполнителей: нули до смещения,
-- 32-битные числа, текст с нулём, тело программы из секций layout и запись
-- файла (с правом исполнения или без).
--
-- pad_to(target, offset) — нули до смещения; InvalidFileLayout
-- append_u32(target, word) / append_number32(target, value); ValueOutsideRange
-- append_cstring(target, text) — текст с нулём
-- payload(program, layout) -> buffer кода, rodata и data
-- write_buffer(path, buffer) — записать файл; write_program(path, buffer) — то же с правом
--     исполнения (ELF для Linux, Q-027)

use io.file
use compiler.gorn.backend.layout
use compiler.gorn.backend.buffer

skill pad_to(target, offset) {
    (offset < target.length) {
        out error.InvalidFileLayout
    }
    target.append_zeroes(offset - target.length)
    out target
}

skill append_u32(target, value) {
    target.append_word(value)
    out target
}

skill append_number32(target, value) {
    (value < 0) {
        out error.ValueOutsideRange
    }
    @address = layout.address_from_number(value)
    out append_u32(target, address)
}

skill append_cstring(target, text) {
    target.append_text(text)
    target.append_byte(0)
    out target
}

skill payload(value, current_layout) {
    @result = buffer.empty()
    result.append_buffer(value.code)
    result = pad_to(result, current_layout.rodata_offset)
    result.append_buffer(value.rodata)
    result = pad_to(result, current_layout.data_offset)
    result.append_buffer(value.data)
    out pad_to(result, current_layout.file_size)
}

skill write_buffer(path, output) {
    out file.write_bytes(path, output.whole())
}

skill write_program(path, output) {
    out file.write_program(path, output.whole())
}
