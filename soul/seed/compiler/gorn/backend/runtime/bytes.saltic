-- bytes — рантайм core.bytes: буфер — строка-объект, байт — ячейка. Буфер
-- изменяем, поэтому рождается сразу в хранилище (rt_store_cell, в карантине до
-- первого выхода региона, где его никто не держит): так у него один адрес на всю
-- жизнь, и запись в долгий Box его не копирует. Буфер, пришедший из региона
-- (file.read_bytes), после переезда в хранилище читается и пишется по адресу
-- переезда (бит FORWARDED).
-- Каждый навык берёт и отдаёт billet, определяя метку rt_bytes_* в коде.
--
-- emit_bytes_new(billet) — rt_bytes_new(n) -> нулевой буфер; InvalidSize, если n < 0;
--     MemoryExhausted
-- emit_bytes_checked(billet) — rt_bytes_get / rt_bytes_set (BytesBounds,
--     ByteOutsideRange), rt_bytes_slice (BytesBounds) — копия в хранилище; get после
--     проверки уходит в rt_string_byte
-- Внутри: emit_bytes_index(billet, label) — метка, пересылка и проверка индекса;
--     emit_bytes_store(billet, prefix) — ячейка хранилища под VALUE байт и карантин

use compiler.abi
use compiler.memory.model
use compiler.gorn.backend
use compiler.gorn.backend.runtime.tails

Bytes = Box {
    endings = tails.Tails {}

    skill emit_bytes_store(billet, prefix) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.add_immediate(billet, backend.VALUE, backend.VALUE, words.payload + words.string_data + abi.OBJECT_ALIGNMENT)
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, -abi.OBJECT_ALIGNMENT)
        billet = executor.call(billet, "rt_store_cell")
        billet = executor.branch_nonzero(billet, backend.ERROR, "{prefix}_refused")
        billet = executor.load_immediate(billet, backend.SCRATCH0, abi.OBJECT_KIND_STRING)
        billet = executor.store32(billet, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes * 2)
        billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH1, words.string_data + 1)
        billet = executor.store32(billet, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET)
        billet = executor.store(billet, backend.SCRATCH1, backend.VALUE, words.payload)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.VALUE, words.payload + words.string_data)
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH2, backend.SCRATCH1)
        billet = executor.label(billet, "{prefix}_clear")
        billet = executor.store_byte_zero(billet, backend.SCRATCH2, 0)
        billet = executor.branch_equal(billet, backend.SCRATCH2, backend.SCRATCH3, "{prefix}_ready")
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.jump(billet, "{prefix}_clear")
        billet = executor.label(billet, "{prefix}_ready")
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.call(billet, "rt_quarantine_add")
        billet = executor.load(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.label(billet, "{prefix}_refused")
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        out executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
    }

    skill emit_bytes_new(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_bytes_new")
        billet = executor.shift_right_signed(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        billet = executor.branch_negative(billet, backend.VALUE, ".L_bytes_size")
        billet = emit_bytes_store(billet, ".L_bytes_new")
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_bytes_new_failed")
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_bytes_new_failed")
        billet = executor.load_immediate(billet, backend.VALUE, 0)
        out executor.ret(billet)
    }

    skill emit_bytes_resolve(billet, prefix) {
        @executor = billet.executor
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_FLAGS_OFFSET)
        billet = executor.and_immediate(billet, backend.SCRATCH2, backend.SCRATCH1, model.FORWARDED)
        billet = executor.branch_zero(billet, backend.SCRATCH2, "{prefix}_here")
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.SCRATCH1, abi.PAYLOAD_MASK)
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_MASK)
        billet = executor.or(billet, backend.VALUE, backend.VALUE, backend.SCRATCH0)
        out executor.label(billet, "{prefix}_here")
    }

    skill emit_bytes_index(billet, label) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, label)
        billet = emit_bytes_resolve(billet, label)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.shift_right_signed(billet, backend.SCRATCH2, backend.ERROR, abi.TAG_SHIFT)
        out executor.branch_greater_equal_unsigned(billet, backend.SCRATCH2, backend.SCRATCH1, ".L_bytes_bounds")
    }

    skill emit_bytes_checked(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = emit_bytes_index(billet, "rt_bytes_get")
        billet = executor.jump(billet, "rt_string_byte")
        billet = emit_bytes_index(billet, "rt_bytes_set")
        billet = executor.shift_right_signed(billet, backend.SCRATCH3, backend.ARG2, abi.TAG_SHIFT)
        billet = executor.load_immediate(billet, backend.SCRATCH4, 256)
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH3, backend.SCRATCH4, ".L_bytes_value")
        billet = executor.add(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH2)
        billet = executor.store_byte(billet, backend.SCRATCH3, backend.SCRATCH0, words.payload + words.string_data)
        billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, "rt_bytes_slice")
        billet = emit_bytes_resolve(billet, "rt_bytes_slice")
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.shift_right_signed(billet, backend.SCRATCH2, backend.ERROR, abi.TAG_SHIFT)
        billet = executor.shift_right_signed(billet, backend.SCRATCH3, backend.ARG2, abi.TAG_SHIFT)
        billet = executor.branch_negative(billet, backend.SCRATCH2, ".L_bytes_bounds")
        billet = executor.branch_less(billet, backend.SCRATCH3, backend.SCRATCH2, ".L_bytes_bounds")
        billet = executor.branch_less(billet, backend.SCRATCH1, backend.SCRATCH3, ".L_bytes_bounds")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH2)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
        billet = executor.sub(billet, backend.VALUE, backend.SCRATCH3, backend.SCRATCH2)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes)
        billet = emit_bytes_store(billet, ".L_bytes_slice")
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_bytes_slice_failed")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.VALUE, words.payload + words.string_data)
        billet = executor.add(billet, backend.SCRATCH1, backend.SCRATCH2, backend.SCRATCH1)
        billet = executor.label(billet, ".L_bytes_slice_copy")
        billet = executor.branch_equal(billet, backend.SCRATCH2, backend.SCRATCH1, ".L_bytes_slice_copied")
        billet = executor.load_byte(billet, backend.SCRATCH3, backend.SCRATCH0, words.payload + words.string_data)
        billet = executor.store_byte(billet, backend.SCRATCH3, backend.SCRATCH2, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, 1)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.jump(billet, ".L_bytes_slice_copy")
        billet = executor.label(billet, ".L_bytes_slice_copied")
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
        billet = executor.label(billet, ".L_bytes_slice_failed")
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.ret(billet)
        billet = endings.error_stub(billet, ".L_bytes_bounds", abi.ERROR_BYTES_BOUNDS)
        billet = endings.error_stub(billet, ".L_bytes_value", abi.ERROR_BYTE_OUTSIDE_RANGE)
        out endings.error_stub(billet, ".L_bytes_size", abi.ERROR_INVALID_SIZE)
    }
}
