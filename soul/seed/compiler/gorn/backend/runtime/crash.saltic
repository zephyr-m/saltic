-- crash — страховочная сетка рантайма: путь непойманной ошибки и журнал
-- yamatakudasai.log. Навык, через который прошла ошибка, кладёт «навык · файл» в
-- TRAIL и строку оператора в TRAIL_LINES (до TRAIL_SIZE, внутренний — первым);
-- rescue путь очищает. Печать звена — «навык · файл:строка» (строка 0 — без неё). В конце
-- программы rt_start_failure зовёт rt_crash_report: «путь: a ← b ← program» на
-- экран (путь из одного навыка — сама программа — не печатается), затем — если
-- платформа открыла журнал на дозапись (Linux; у прочих
-- log_open — NotSupported) — туда же «ЧЧ:ММ:СС UTC  ошибка: Имя» и путь.
-- Вывод rt_show / rt_newline идёт в OUT_FD (0 — экран, fd 1).
--
-- out_fd(billet, label) — VALUE = fd вывода (метка label — своя у каждого места)
-- emit_trail_push(billet) — rt_trail_push(VALUE место-строка, ARG2 строка числом),
--     ERROR не трогает
-- emit_trail_clear(billet) — rt_trail_clear
-- emit_trail_print / emit_report / emit_clock(billet) — rt_trail_print,
--     rt_crash_report(VALUE ошибка), rt_crash_clock — «ЧЧ:ММ:СС UTC  »
-- append_data(billet) — подписи; append_bss(billet) — TRAIL, счётчик, OUT_FD
-- Сбой памяти (billet.signals — x86-64 Linux, вход x86_signal_entry платформы):
-- emit_runtime_begin(billet) — метка RUNTIME_BEGIN: начало кода рантайма
--     (граница последнего навыка); emit_signals(billet) — rt_install_signals
--     (SIGSEGV и SIGBUS — на вход платформы, rt_sigaction), rt_crash_signal
--     (VALUE — адрес сбоя, ERROR — адрес команды, ARG2 — вершина стека в момент
--     сбоя, FRAME — кадр навыка: «сбой памяти: адрес …» и «путь: …», выход
--     SIGNAL_EXIT) и rt_where (ERROR — адрес → VALUE «навык · файл» по
--     billet.placed: последний навык, начало которого не выше адреса; ERROR =
--     WHERE_SKILL, WHERE_RUNTIME или WHERE_NOWHERE; цепочка сравнений —
--     исполняется только при сбое). Путь: место сбоя; если это рантайм — первый
--     адрес возврата в навык на стеке от вершины до FRAME (кто позвал рантайм);
--     дальше по кадрам x86: [FRAME] — адрес возврата, предыдущий кадр — в слоте
--     previous_frame (не дальше SIGNAL_DEPTH звеньев)

use core.group
use compiler.abi
use compiler.gorn.backend
use compiler.machine.wide
use compiler.gorn.platform
use compiler.gorn.constants
use compiler.gorn.backend.runtime.tails
use compiler.gorn.backend.runtime.terminal

TRAIL = "saltic_trail"
TRAIL_COUNT = "saltic_trail_count"
TRAIL_LINES = "saltic_trail_lines"
TRAIL_SIZE = 16
OUT_FD = "saltic_out_fd"
STDOUT = 1
MILLISECONDS = 1000
HOUR = 3600
MINUTE = 60
RUNTIME_BEGIN = "rt_runtime_begin"
SIGNAL_ENTRY = "x86_signal_entry"
SIGNAL_FAULT = "saltic_signal_fault"
SIGNAL_AT = "saltic_signal_at"
SIGNAL_SP = "saltic_signal_sp"
SIGNAL_FRAME = "saltic_signal_frame"
SIGNAL_DEPTH = 16
WHERE_SKILL = 0
WHERE_RUNTIME = 2
WHERE_NOWHERE = 1
SIGNALS = [11, 7]
SIGACTION = 134
SIGNAL_FLAGS = 67108868
SIGNAL_EXIT = 139

Crash = Box {
    endings = tails.Tails {},
    console = terminal.Terminal {}

    skill out_fd(billet, label) {
        @executor = billet.executor
        billet = executor.load_address(billet, backend.VALUE, OUT_FD, 0)
        billet = executor.load(billet, backend.VALUE, backend.VALUE, 0)
        billet = executor.branch_nonzero(billet, backend.VALUE, label)
        billet = executor.load_immediate(billet, backend.VALUE, STDOUT)
        out executor.label(billet, label)
    }

    skill emit_trail_push(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_trail_push")
        billet = executor.load_address(billet, backend.SCRATCH0, TRAIL_COUNT, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load_immediate(billet, backend.SCRATCH2, TRAIL_SIZE)
        billet = executor.branch_greater_equal(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_trail_full")
        billet = executor.shift_left(billet, backend.SCRATCH2, backend.SCRATCH1, words.shift)
        billet = executor.load_address(billet, backend.SCRATCH3, TRAIL, 0)
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH3, backend.SCRATCH2)
        billet = executor.store(billet, backend.VALUE, backend.SCRATCH3, 0)
        billet = executor.load_address(billet, backend.SCRATCH3, TRAIL_LINES, 0)
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH3, backend.SCRATCH2)
        billet = executor.store(billet, backend.ARG2, backend.SCRATCH3, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 1)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.label(billet, ".L_trail_full")
        out executor.ret(billet)
    }

    skill emit_trail_clear(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_trail_clear")
        billet = executor.load_address(billet, backend.SCRATCH0, TRAIL_COUNT, 0)
        billet = executor.store_zero(billet, backend.SCRATCH0, 0)
        out executor.ret(billet)
    }

    skill show_text(billet, label) {
        @executor = billet.executor
        billet = executor.load_address(billet, backend.VALUE, label, 0)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        out executor.call(billet, "rt_show")
    }

    skill emit_trail_print(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_trail_print")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.load_address(billet, backend.SCRATCH0, TRAIL_COUNT, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load_immediate(billet, backend.SCRATCH2, 2)
        billet = executor.branch_less(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_trail_print_done")
        billet = show_text(billet, "rt_path_text")
        billet = executor.store_zero(billet, backend.STACK, 0)
        billet = executor.label(billet, ".L_trail_print_next")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, 0)
        billet = executor.load_address(billet, backend.SCRATCH1, TRAIL_COUNT, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH1, 0)
        billet = executor.branch_greater_equal(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_trail_print_end")
        billet = executor.branch_zero(billet, backend.SCRATCH0, ".L_trail_print_name")
        billet = show_text(billet, "rt_arrow_text")
        billet = executor.label(billet, ".L_trail_print_name")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, 0)
        billet = executor.shift_left(billet, backend.SCRATCH0, backend.SCRATCH0, words.shift)
        billet = executor.load_address(billet, backend.SCRATCH1, TRAIL, 0)
        billet = executor.add(billet, backend.SCRATCH1, backend.SCRATCH1, backend.SCRATCH0)
        billet = executor.load(billet, backend.VALUE, backend.SCRATCH1, 0)
        billet = executor.call(billet, "rt_show")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, 0)
        billet = executor.shift_left(billet, backend.SCRATCH0, backend.SCRATCH0, words.shift)
        billet = executor.load_address(billet, backend.SCRATCH1, TRAIL_LINES, 0)
        billet = executor.add(billet, backend.SCRATCH1, backend.SCRATCH1, backend.SCRATCH0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH1, 0)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_trail_print_no_line")
        billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes)
        billet = show_text(billet, "rt_colon_text")
        billet = executor.load(billet, backend.VALUE, backend.STACK, words.bytes)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        billet = executor.call(billet, "rt_show")
        billet = executor.label(billet, ".L_trail_print_no_line")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, 1)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, 0)
        billet = executor.jump(billet, ".L_trail_print_next")
        billet = executor.label(billet, ".L_trail_print_end")
        billet = executor.call(billet, "rt_newline")
        billet = executor.label(billet, ".L_trail_print_done")
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
        out endings.succeeded(billet)
    }

    skill tagged(billet, register, number) {
        @executor = billet.executor
        out executor.load_immediate(billet, register, number * abi.TAG_SCALE)
    }

    skill two_digits(billet, slot, label) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * slot)
        billet = tagged(billet, backend.SCRATCH1, 10)
        billet = executor.branch_greater_equal(billet, backend.SCRATCH0, backend.SCRATCH1, label)
        billet = show_text(billet, "rt_zero_text")
        billet = executor.label(billet, label)
        billet = executor.load(billet, backend.VALUE, backend.STACK, words.bytes * slot)
        out executor.call(billet, "rt_show")
    }

    skill emit_clock(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_crash_clock")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.call(billet, platform.NOW)
        billet = tagged(billet, backend.ERROR, MILLISECONDS)
        billet = executor.call(billet, "rt_div")
        billet = executor.store(billet, backend.VALUE, backend.STACK, 0)
        billet = tagged(billet, backend.ERROR, HOUR)
        billet = executor.call(billet, "rt_div")
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes)
        billet = two_digits(billet, 1, ".L_clock_hours")
        billet = show_text(billet, "rt_colon_text")
        billet = executor.load(billet, backend.VALUE, backend.STACK, 0)
        billet = tagged(billet, backend.ERROR, MINUTE)
        billet = executor.call(billet, "rt_div")
        billet = tagged(billet, backend.ERROR, MINUTE)
        billet = executor.call(billet, "rt_mod")
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes)
        billet = two_digits(billet, 1, ".L_clock_minutes")
        billet = show_text(billet, "rt_colon_text")
        billet = executor.load(billet, backend.VALUE, backend.STACK, 0)
        billet = tagged(billet, backend.ERROR, MINUTE)
        billet = executor.call(billet, "rt_mod")
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes)
        billet = two_digits(billet, 1, ".L_clock_seconds")
        billet = show_text(billet, "rt_utc_text")
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
        out endings.succeeded(billet)
    }

    skill emit_report(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_crash_report")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.VALUE, backend.STACK, 0)
        billet = executor.call(billet, "rt_trail_print")
        billet = executor.call(billet, platform.LOG_OPEN)
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_crash_done")
        billet = executor.load_address(billet, backend.SCRATCH0, OUT_FD, 0)
        billet = executor.store(billet, backend.VALUE, backend.SCRATCH0, 0)
        billet = executor.call(billet, "rt_crash_clock")
        billet = show_text(billet, "rt_failure_text")
        billet = executor.load(billet, backend.VALUE, backend.STACK, 0)
        billet = executor.call(billet, "rt_show")
        billet = executor.call(billet, "rt_newline")
        billet = executor.call(billet, "rt_trail_print")
        billet = executor.load_address(billet, backend.SCRATCH0, OUT_FD, 0)
        billet = executor.load(billet, backend.VALUE, backend.SCRATCH0, 0)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        billet = executor.call(billet, platform.PROCESS_CLOSE)
        billet = executor.load_address(billet, backend.SCRATCH0, OUT_FD, 0)
        billet = executor.store_zero(billet, backend.SCRATCH0, 0)
        billet = executor.label(billet, ".L_crash_done")
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
        out endings.succeeded(billet)
    }

    skill emit_runtime_begin(billet) {
        (billet.signals == no) {
            out billet
        }
        @executor = billet.executor
        out executor.label(billet, RUNTIME_BEGIN)
    }

    skill emit_install(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_install_signals")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -48)
        billet = executor.store(billet, backend.RETURN, backend.STACK, 40)
        billet = executor.load_address(billet, backend.SCRATCH0, SIGNAL_ENTRY, 0)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, 0)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, 16)
        billet = executor.load_immediate(billet, backend.SCRATCH0, SIGNAL_FLAGS)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, 8)
        billet = executor.store_zero(billet, backend.STACK, 24)
        drum (SIGNALS) {
            billet = executor.load_immediate(billet, backend.VALUE, beat)
            billet = executor.move(billet, backend.ERROR, backend.STACK)
            billet = executor.load_immediate(billet, backend.ARG2, 0)
            billet = executor.load_immediate(billet, backend.ARG3, 8)
            billet = executor.syscall(billet, SIGACTION)
        }
        billet = executor.load(billet, backend.RETURN, backend.STACK, 40)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, 48)
        billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
        out executor.ret(billet)
    }

    skill slot_load(billet, register, label) {
        @executor = billet.executor
        billet = executor.load_address(billet, backend.SCRATCH0, label, 0)
        out executor.load(billet, register, backend.SCRATCH0, 0)
    }

    skill slot_store(billet, register, label) {
        @executor = billet.executor
        billet = executor.load_address(billet, backend.SCRATCH0, label, 0)
        out executor.store(billet, register, backend.SCRATCH0, 0)
    }

    skill emit_crash_signal(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_crash_signal")
        billet = slot_store(billet, backend.VALUE, SIGNAL_FAULT)
        billet = slot_store(billet, backend.ERROR, SIGNAL_AT)
        billet = slot_store(billet, backend.ARG2, SIGNAL_SP)
        billet = slot_store(billet, backend.FRAME, SIGNAL_FRAME)
        billet = show_text(billet, "rt_signal_text")
        billet = slot_load(billet, backend.VALUE, SIGNAL_FAULT)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        billet = executor.call(billet, "rt_show")
        billet = executor.call(billet, "rt_newline")
        billet = show_text(billet, "rt_path_text")
        billet = slot_load(billet, backend.ERROR, SIGNAL_AT)
        billet = executor.call(billet, "rt_where")
        billet = slot_store(billet, backend.ERROR, SIGNAL_FAULT)
        billet = executor.call(billet, "rt_show")
        billet = slot_load(billet, backend.ERROR, SIGNAL_FAULT)
        billet = executor.load_immediate(billet, backend.SCRATCH1, WHERE_RUNTIME)
        billet = executor.branch_not_equal(billet, backend.ERROR, backend.SCRATCH1, ".L_signal_frames")
        billet = executor.label(billet, ".L_signal_scan")
        billet = slot_load(billet, backend.SCRATCH1, SIGNAL_SP)
        billet = slot_load(billet, backend.SCRATCH2, SIGNAL_FRAME)
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_signal_frames")
        billet = executor.load(billet, backend.ERROR, backend.SCRATCH1, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 8)
        billet = slot_store(billet, backend.SCRATCH1, SIGNAL_SP)
        billet = executor.call(billet, "rt_where")
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_signal_scan")
        billet = slot_store(billet, backend.VALUE, SIGNAL_AT)
        billet = show_text(billet, "rt_arrow_text")
        billet = slot_load(billet, backend.VALUE, SIGNAL_AT)
        billet = executor.call(billet, "rt_show")
        billet = executor.label(billet, ".L_signal_frames")
        billet = executor.load_immediate(billet, backend.SCRATCH1, SIGNAL_DEPTH)
        billet = slot_store(billet, backend.SCRATCH1, SIGNAL_SP)
        billet = executor.label(billet, ".L_signal_frame")
        billet = slot_load(billet, backend.SCRATCH1, SIGNAL_SP)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_signal_done")
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, -1)
        billet = slot_store(billet, backend.SCRATCH1, SIGNAL_SP)
        billet = slot_load(billet, backend.SCRATCH1, SIGNAL_FRAME)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_signal_done")
        billet = executor.load(billet, backend.ERROR, backend.SCRATCH1, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH1, constants.previous_frame_load_offset(billet.words))
        billet = slot_store(billet, backend.SCRATCH1, SIGNAL_FRAME)
        billet = executor.call(billet, "rt_where")
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_signal_done")
        billet = slot_store(billet, backend.VALUE, SIGNAL_AT)
        billet = show_text(billet, "rt_arrow_text")
        billet = slot_load(billet, backend.VALUE, SIGNAL_AT)
        billet = executor.call(billet, "rt_show")
        billet = executor.jump(billet, ".L_signal_frame")
        billet = executor.label(billet, ".L_signal_done")
        billet = executor.call(billet, "rt_newline")
        billet = executor.load_immediate(billet, backend.VALUE, SIGNAL_EXIT)
        out executor.jump(billet, platform.EXIT)
    }

    skill emit_where(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_where")
        billet = executor.load_address(billet, backend.ARG3, "rt_signal_nowhere_text", 0)
        billet = executor.load_immediate(billet, backend.SCRATCH1, WHERE_NOWHERE)
        @spots = group.add(billet.placed, [RUNTIME_BEGIN, "rt_signal_runtime_text"])
        @index = 0
        drum (spots) {
            @next = ".L_where_next_{index}"
            billet = executor.load_address(billet, backend.SCRATCH0, group.get(beat, 0), 0)
            billet = executor.branch_greater_equal_unsigned(billet, backend.ERROR, backend.SCRATCH0, next)
            billet = executor.jump(billet, ".L_where_found")
            billet = executor.label(billet, next)
            billet = executor.load_address(billet, backend.ARG3, group.get(beat, 1), 0)
            @kind = WHERE_SKILL
            (group.get(beat, 0) == RUNTIME_BEGIN) {
                kind = WHERE_RUNTIME
            }
            billet = executor.load_immediate(billet, backend.SCRATCH1, kind)
            index = index + 1
        }
        billet = executor.label(billet, ".L_where_found")
        billet = executor.move(billet, backend.ERROR, backend.SCRATCH1)
        billet = executor.move(billet, backend.VALUE, backend.ARG3)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        out executor.ret(billet)
    }

    skill emit_signals(billet) {
        (billet.signals == no) {
            out billet
        }
        billet = emit_install(billet)
        billet = emit_crash_signal(billet)
        out emit_where(billet)
    }

    skill append_data(billet) {
        billet = console.append_message(billet, "rt_path_text", "  путь: ")
        billet = console.append_message(billet, "rt_arrow_text", " ← ")
        billet = console.append_message(billet, "rt_zero_text", "0")
        billet = console.append_message(billet, "rt_colon_text", ":")
        billet = console.append_message(billet, "rt_utc_text", " UTC  ")
        (billet.signals == no) {
            out billet
        }
        billet = console.append_message(billet, "rt_signal_text", "сбой памяти: адрес ")
        billet = console.append_message(billet, "rt_signal_where_text", "  в навыке: ")
        billet = console.append_message(billet, "rt_signal_nowhere_text", "вне навыков Saltic (вход, прошивка или ядро)")
        out console.append_message(billet, "rt_signal_runtime_text", "рантайм Saltic")
    }

    skill append_bss(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.align(billet, backend.BSS, words.bytes)
        billet = executor.data_label(billet, backend.BSS, TRAIL)
        billet = executor.reserve(billet, wide.from_number(words.bytes * TRAIL_SIZE))
        billet = executor.data_label(billet, backend.BSS, TRAIL_LINES)
        billet = executor.reserve(billet, wide.from_number(words.bytes * TRAIL_SIZE))
        billet = executor.data_label(billet, backend.BSS, TRAIL_COUNT)
        billet = executor.reserve(billet, wide.from_number(words.bytes))
        billet = executor.data_label(billet, backend.BSS, OUT_FD)
        billet = executor.reserve(billet, wide.from_number(words.bytes))
        (billet.signals == no) {
            out billet
        }
        billet = executor.data_label(billet, backend.BSS, SIGNAL_FAULT)
        billet = executor.reserve(billet, wide.from_number(words.bytes))
        billet = executor.data_label(billet, backend.BSS, SIGNAL_AT)
        billet = executor.reserve(billet, wide.from_number(words.bytes))
        billet = executor.data_label(billet, backend.BSS, SIGNAL_SP)
        billet = executor.reserve(billet, wide.from_number(words.bytes))
        billet = executor.data_label(billet, backend.BSS, SIGNAL_FRAME)
        out executor.reserve(billet, wide.from_number(words.bytes))
    }
}
