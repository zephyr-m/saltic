-- runtime — собирает рантайм rt_* из детей в фиксированном порядке и
-- добавляет его к машине после кода программы. Платформенного кода здесь
-- нет: метки rt_platform_* выпускает платформа (compiler/gorn/platform) следом.
-- Порядок вызовов задаёт раскладку меток и не меняется без нужды; провалов
-- меток между вызовами нет (они внутри навыков детей).
-- Команды — методами billet.executor (договор backend).
--
-- append_runtime(billet) — весь рантайм
-- append_runtime_data(billet) — тексты сообщений в rodata
--
-- Дети: numbers, collections, strings, bytes, fixed, fraction, raw_memory, memory, terminal, host, crash.

use compiler.abi
use compiler.gorn.backend
use compiler.gorn.backend.runtime.tails
use compiler.gorn.backend.runtime.memory
use compiler.gorn.backend.runtime.terminal
use compiler.gorn.backend.runtime.numbers
use compiler.gorn.backend.runtime.collections
use compiler.gorn.backend.runtime.strings
use compiler.gorn.backend.runtime.bytes
use compiler.gorn.backend.runtime.fixed
use compiler.gorn.backend.runtime.fraction
use compiler.gorn.backend.runtime.raw_memory
use compiler.gorn.backend.runtime.host
use compiler.gorn.backend.runtime.crash
use compiler.gorn.backend.runtime.fixed.cells
use compiler.gorn.backend.runtime.fixed.bits

Runtime = Box {
    endings = tails.Tails {},
    console = terminal.Terminal {},
    crashes = crash.Crash {},
    numerals = numbers.Numbers {},
    containers = collections.Collections {},
    string_ops = strings.Strings {},
    fixeds = fixed.Fixed {},
    fractions = fraction.Fraction {},
    host_calls = host.Host {},
    byte_ops = bytes.Bytes {},
    raw_access = raw_memory.RawMemory {},
    memory_ops = memory.Memory {},
    fixed_cells = cells.FixedCells {},
    fixed_bits = bits.FixedBits {}

    skill append_runtime_data(billet) {
        @executor = billet.executor
        billet = console.append_message(billet, "rt_unknown_text", "<value>")
        billet = console.append_message(billet, "rt_fixed_overflow_text", "значение вышло за границы фиксированного целого")
        billet = console.append_message(billet, "rt_memory_exhausted_text", "память исчерпана")
        billet = console.append_message(billet, "rt_stack_exhausted_text", "стек исчерпан")
        billet = console.append_message(billet, "rt_cycle_forbidden_text", "цикл ссылок запрещён: храни номер, а не объект")
        billet = console.append_message(billet, "rt_cycle_check_exhausted_text", "проверка цикла ссылок не уложилась в бюджет объектов")
        billet = console.append_message(billet, "rt_yes_text", "yes")
        billet = console.append_message(billet, "rt_no_text", "no")
        billet = console.append_message(billet, "rt_need_text", "нужно ")
        billet = console.append_message(billet, "rt_arguments_text", " аргументов")
        billet = console.append_message(billet, "rt_failure_text", "ошибка: ")
        billet = crashes.append_data(billet)
        billet = executor.align(billet, backend.RODATA, 8)
        billet = executor.data_label(billet, backend.RODATA, "rt_newline_text")
        billet = executor.data_byte(billet, backend.RODATA, 10)
        out billet
    }

    skill append_runtime(billet) {
        billet = crashes.emit_runtime_begin(billet)
        billet = numerals.emit_mul(billet)
        billet = numerals.emit_div(billet)
        billet = numerals.emit_mod(billet)
        billet = numerals.emit_division_by_zero(billet)
        billet = numerals.emit_number_overflow(billet)
        billet = numerals.emit_bits(billet)
        billet = numerals.emit_equal(billet)
        billet = numerals.emit_value_equal(billet)
        billet = containers.emit_box_get(billet)
        billet = containers.emit_box_set(billet)
        billet = containers.emit_missing_field(billet)
        billet = containers.emit_empty_touched(billet)
        billet = containers.emit_group_count(billet)
        billet = containers.emit_group_at(billet)
        billet = containers.emit_group_bounds(billet)
        billet = containers.emit_group_tree_at(billet)
        billet = containers.emit_group_tree_parts(billet)
        billet = containers.emit_group_tree_make(billet)
        billet = containers.emit_group_flatten(billet)
        billet = containers.emit_group_replaced(billet)
        billet = string_ops.emit_string_len(billet)
        billet = string_ops.emit_string_byte(billet)
        billet = string_ops.emit_string_bounds(billet)
        billet = string_ops.emit_string_starts_with(billet)
        billet = string_ops.emit_string_ends_with(billet)
        billet = string_ops.emit_string_contains(billet)
        billet = string_ops.emit_line_count(billet)
        billet = host_calls.emit_newline(billet)
        billet = host_calls.emit_missing_args(billet)
        billet = host_calls.emit_start_failure(billet)
        billet = crashes.emit_trail_push(billet)
        billet = crashes.emit_trail_clear(billet)
        billet = crashes.emit_trail_print(billet)
        billet = crashes.emit_clock(billet)
        billet = crashes.emit_report(billet)
        billet = crashes.emit_signals(billet)
        billet = crashes.append_bss(billet)
        billet = host_calls.emit_cpu_wait(billet)
        billet = host_calls.emit_cpu_firmware(billet)
        billet = host_calls.emit_cpu_fence(billet)
        billet = host_calls.emit_environment_capture(billet)
        billet = fixeds.emit_fixed_overflow(billet)
        billet = fixeds.emit_fixed_equal(billet)
        billet = fixeds.emit_fixed_less(billet)
        billet = fixeds.emit_fixed_greater(billet)
        billet = fixeds.emit_fixed_new(billet)
        (billet.words.bytes == 8) {
            billet = fixeds.emit_fixed_wrap(billet)
        }
        billet = fixed_cells.emit_fixed_mem_load8(billet)
        billet = fixed_cells.emit_fixed_mem_load16(billet)
        billet = fixed_cells.emit_fixed_mem_load(billet)
        billet = fixed_cells.emit_fixed_mem_store8(billet)
        billet = fixed_cells.emit_fixed_mem_store16(billet)
        billet = fixed_cells.emit_fixed_mem_store(billet)
        billet = fixeds.emit_fixed_text(billet)
        billet = containers.emit_group_add(billet)
        billet = string_ops.emit_cstring(billet)
        billet = string_ops.emit_string_add(billet)
        billet = string_ops.emit_string_at(billet)
        billet = string_ops.emit_string_from_byte(billet)
        billet = string_ops.emit_string_from_bytes(billet)
        billet = string_ops.emit_string_slice(billet)
        billet = string_ops.emit_string_lower(billet)
        billet = string_ops.emit_string_case(billet)
        billet = numerals.emit_number_text(billet)
        billet = host_calls.emit_file_bytes_text(billet)
        billet = fixeds.emit_fixed_add(billet)
        billet = fixeds.emit_fixed_sub(billet)
        billet = fixeds.emit_fixed_mul(billet)
        billet = fixeds.emit_fixed_div(billet)
        billet = fixed_bits.emit_fixed_and(billet)
        billet = fixed_bits.emit_fixed_or(billet)
        billet = fixed_bits.emit_fixed_xor(billet)
        billet = fixed_bits.emit_fixed_not(billet)
        billet = fixed_bits.emit_fixed_shift_left(billet)
        billet = fixed_bits.emit_fixed_shift_right(billet)
        billet = fixeds.emit_fixed_convert(billet)
        billet = fixeds.emit_fixed_to_number(billet, "rt_fixed_to_number", "rt_number_overflow")
        billet = fractions.append(billet)
        billet = fixeds.emit_fixed_to_number(billet, "rt_fixed_pack", "rt_fixed_too_big")
        billet = endings.error_stub(billet, "rt_fixed_too_big", abi.ERROR_FIXED_TOO_BIG)
        billet = host_calls.emit_show(billet)
        billet = host_calls.emit_value_text(billet)
        billet = memory_ops.append_runtime(billet)
        billet = console.append_runtime(billet)
        billet = append_runtime_data(billet)
        billet = host_calls.emit_error_text(billet)
        billet = raw_access.emit_mem_arena(billet)
        billet = raw_access.emit_mem_heap(billet)
        billet = host_calls.emit_cpu_call(billet)
        billet = byte_ops.emit_bytes_new(billet)
        billet = byte_ops.emit_bytes_checked(billet)
        out console.append_data(billet)
    }
}
