-- cells — рантайм фиксированных целых: чтение и запись в память (rt_fixed_mem_load8/16/32,
-- rt_fixed_mem_store8/16/32); load32 / store32 проваливаются в load / store.
-- Вынесено из fixed (22.11.2026). Хозяин — FixedCells (СОП).

use compiler.abi
use compiler.abi.fixed
use compiler.gorn.backend
use compiler.gorn.backend.runtime.tails

FixedCells = Box {
    endings = tails.Tails {}

    skill emit_fixed_mem_load8(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_mem_load8")
        billet = executor.load_immediate(billet, backend.ARG2, fixed.U8)
        billet = executor.jump(billet, "rt_fixed_mem_load")
        out billet
    }

    skill emit_fixed_mem_load16(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_mem_load16")
        billet = executor.load_immediate(billet, backend.ARG2, fixed.U16)
        billet = executor.jump(billet, "rt_fixed_mem_load")
        out billet
    }

    skill emit_fixed_mem_load(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_mem_load32")
        billet = executor.load_immediate(billet, backend.ARG2, fixed.U32)
        billet = executor.label(billet, "rt_fixed_mem_load")
        billet = executor.add(billet, backend.SCRATCH0, backend.VALUE, backend.ERROR)
        billet = executor.load_immediate(billet, backend.SCRATCH1, fixed.U8)
        billet = executor.branch_equal(billet, backend.ARG2, backend.SCRATCH1, ".L_fixed_mem_load8")
        billet = executor.load_immediate(billet, backend.SCRATCH1, fixed.U16)
        billet = executor.branch_equal(billet, backend.ARG2, backend.SCRATCH1, ".L_fixed_mem_load16")
        billet = executor.load32(billet, backend.VALUE, backend.SCRATCH0, 0)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_fixed_mem_load8")
        billet = executor.load_byte(billet, backend.VALUE, backend.SCRATCH0, 0)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_fixed_mem_load16")
        billet = executor.load_half(billet, backend.VALUE, backend.SCRATCH0, 0)
        billet = endings.succeeded(billet)
        out billet
    }

    skill emit_fixed_mem_store8(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_mem_store8")
        billet = executor.load_immediate(billet, backend.SCRATCH3, 1)
        billet = executor.jump(billet, "rt_fixed_mem_store")
        out billet
    }

    skill emit_fixed_mem_store16(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_mem_store16")
        billet = executor.load_immediate(billet, backend.SCRATCH3, 2)
        billet = executor.jump(billet, "rt_fixed_mem_store")
        out billet
    }

    skill emit_fixed_mem_store(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_mem_store32")
        billet = executor.load_immediate(billet, backend.SCRATCH3, 3)
        billet = executor.label(billet, "rt_fixed_mem_store")
        billet = executor.add(billet, backend.SCRATCH0, backend.VALUE, backend.ERROR)
        billet = executor.load_immediate(billet, backend.SCRATCH1, 1)
        billet = executor.branch_equal(billet, backend.SCRATCH3, backend.SCRATCH1, ".L_fixed_mem_store8")
        billet = executor.load_immediate(billet, backend.SCRATCH1, 2)
        billet = executor.branch_equal(billet, backend.SCRATCH3, backend.SCRATCH1, ".L_fixed_mem_store16")
        billet = executor.store32(billet, backend.ARG2, backend.SCRATCH0, 0)
        billet = executor.jump(billet, ".L_fixed_mem_store_done")
        billet = executor.label(billet, ".L_fixed_mem_store8")
        billet = executor.store_byte(billet, backend.ARG2, backend.SCRATCH0, 0)
        billet = executor.jump(billet, ".L_fixed_mem_store_done")
        billet = executor.label(billet, ".L_fixed_mem_store16")
        billet = executor.store_half(billet, backend.ARG2, backend.SCRATCH0, 0)
        billet = executor.label(billet, ".L_fixed_mem_store_done")
        billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
        out endings.succeeded(billet)
    }
}
