-- bits — рантайм фиксированных целых: and, or, xor, not, сдвиги (rt_fixed_and…);
-- not и сдвиг влево 32-битных видов обрезаются через rt_fixed_wrap (wrap_label).
-- Вынесено из fixed (22.11.2026). Хозяин — FixedBits (СОП).

use compiler.gorn.backend

FixedBits = Box {
    skill emit_fixed_and(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_and")
        billet = executor.and(billet, backend.VALUE, backend.VALUE, backend.ERROR)
        billet = executor.jump(billet, "rt_fixed_new")
        out billet
    }

    skill emit_fixed_or(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_or")
        billet = executor.or(billet, backend.VALUE, backend.VALUE, backend.ERROR)
        billet = executor.jump(billet, "rt_fixed_new")
        out billet
    }

    skill emit_fixed_xor(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_xor")
        billet = executor.xor(billet, backend.VALUE, backend.VALUE, backend.ERROR)
        billet = executor.jump(billet, "rt_fixed_new")
        out billet
    }

    skill wrap_label(billet) {
        (billet.words.bytes == 8) {
            out "rt_fixed_wrap"
        }
        out "rt_fixed_new"
    }

    skill emit_fixed_not(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_not")
        billet = executor.xor_immediate(billet, backend.VALUE, backend.VALUE, -1)
        billet = executor.jump(billet, wrap_label(billet))
        out billet
    }

    skill emit_fixed_shift_left(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_shift_left")
        billet = executor.shift_left_by(billet, backend.VALUE, backend.VALUE, backend.ERROR)
        billet = executor.jump(billet, wrap_label(billet))
        out billet
    }

    skill emit_fixed_shift_right(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fixed_shift_right")
        billet = executor.shift_right_unsigned_by(billet, backend.VALUE, backend.VALUE, backend.ERROR)
        billet = executor.jump(billet, "rt_fixed_new")
        out billet
    }
}
