-- strings — рантайм строк: длина, байт, поиск, склейка, срез,
-- регистр, строка из C-строки аргументов.
-- Каждый навык берёт и отдаёт billet, определяя метку rt_* в коде.
-- Команды — методами billet.executor (договор backend), регистры — его роли.
-- Строка — объект STRING: длина, затем байты и нулевой байт. Новые строки —
-- через rt_alloc. Выход за границы — rt_string_bounds (ERROR_STRING_BOUNDS);
-- проверка границ идёт до кадра: ret должен быть из той же точки стека, что и call.
-- starts_with прыгает в цикл .L_string_match_loop внутри ends_with;
-- rt_string_upper проваливается в rt_string_case внутри одного навыка.
--
-- emit_string_len / emit_string_byte(billet) — rt_string_len / rt_string_byte
-- emit_string_bounds(billet) — метка ошибки
-- emit_string_starts_with / emit_string_ends_with / emit_string_contains(billet)
-- emit_line_count(billet) — rt_line_count: число строк по переводам
-- emit_cstring(billet) — rt_cstring: из нуль-терминированной C-строки
-- emit_string_add / emit_string_at / emit_string_slice(billet)
-- emit_string_from_byte(billet) — rt_string_from_byte: число 0…255 → строка из
--     одного байта, иначе StringBounds; хвост — .L_string_one_byte в rt_string_at
-- emit_string_from_bytes(billet) — rt_string_from_bytes: буфер bytes → новая строка
--     той же длины (bytes — тот же объект STRING); хвост — rt_string_slice [0, длина)
-- emit_string_lower / emit_string_case(billet) — ASCII и кириллица (а…я, ё; пары байтов
--     D0/D1 UTF-8, Q-020); case даёт и rt_string_upper; emit_case_pair — ветка пар

use compiler.abi
use compiler.gorn.backend
use compiler.gorn.backend.runtime.tails

CYRILLIC_LOW = 208
CYRILLIC_HIGH = 209

Strings = Box {
    endings = tails.Tails {}

    skill emit_string_len(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_len")
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.VALUE, backend.VALUE, words.payload)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        out endings.succeeded(billet)
    }

    skill emit_string_byte(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_byte")
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.shift_right_signed(billet, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.branch_greater_equal_unsigned(billet, backend.ERROR, backend.SCRATCH1, "rt_string_bounds")
        billet = executor.add(billet, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
        billet = executor.load_byte(billet, backend.VALUE, backend.SCRATCH0, words.payload + words.string_data)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        out endings.succeeded(billet)
    }

    skill emit_string_bounds(billet) {
        @executor = billet.executor
        out endings.error_stub(billet, "rt_string_bounds", abi.ERROR_STRING_BOUNDS)
    }

    skill emit_string_starts_with(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_starts_with")
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.and_immediate(billet, backend.ERROR, backend.ERROR, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH0, backend.VALUE, words.payload)
        billet = executor.load(billet, backend.SCRATCH1, backend.ERROR, words.payload)
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_string_match_no")
        billet = executor.load_immediate(billet, backend.SCRATCH2, 0)
        billet = executor.jump(billet, ".L_string_match_loop")
        out billet
    }

    skill emit_string_ends_with(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_ends_with")
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.and_immediate(billet, backend.ERROR, backend.ERROR, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH0, backend.VALUE, words.payload)
        billet = executor.load(billet, backend.SCRATCH1, backend.ERROR, words.payload)
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_string_match_no")
        billet = executor.move(billet, backend.VALUE, backend.VALUE)
        billet = executor.sub(billet, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH1)
        billet = executor.add(billet, backend.VALUE, backend.VALUE, backend.SCRATCH3)
        billet = executor.load_immediate(billet, backend.SCRATCH2, 0)
        billet = executor.label(billet, ".L_string_match_loop")
        billet = executor.branch_equal(billet, backend.SCRATCH2, backend.SCRATCH1, ".L_string_match_yes")
        billet = executor.add(billet, backend.SCRATCH3, backend.VALUE, backend.SCRATCH2)
        billet = executor.add(billet, backend.SCRATCH4, backend.ERROR, backend.SCRATCH2)
        billet = executor.load_byte(billet, backend.SCRATCH3, backend.SCRATCH3, words.payload + words.string_data)
        billet = executor.load_byte(billet, backend.SCRATCH4, backend.SCRATCH4, words.payload + words.string_data)
        billet = executor.branch_not_equal(billet, backend.SCRATCH3, backend.SCRATCH4, ".L_string_match_no")
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.jump(billet, ".L_string_match_loop")
        billet = executor.label(billet, ".L_string_match_yes")
        billet = executor.load_immediate(billet, backend.VALUE, abi.YES)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_string_match_no")
        billet = executor.load_immediate(billet, backend.VALUE, abi.NO)
        out endings.succeeded(billet)
    }

    skill emit_string_contains(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_contains")
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.and_immediate(billet, backend.ERROR, backend.ERROR, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH0, backend.VALUE, words.payload)
        billet = executor.load(billet, backend.SCRATCH1, backend.ERROR, words.payload)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_contains_yes")
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_contains_no")
        billet = executor.sub(billet, backend.SCRATCH2, backend.SCRATCH0, backend.SCRATCH1)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.load_immediate(billet, backend.SCRATCH3, 0)
        billet = executor.label(billet, ".L_contains_outer")
        billet = executor.branch_equal(billet, backend.SCRATCH3, backend.SCRATCH2, ".L_contains_no")
        billet = executor.load_immediate(billet, backend.SCRATCH4, 0)
        billet = executor.label(billet, ".L_contains_inner")
        billet = executor.branch_equal(billet, backend.SCRATCH4, backend.SCRATCH1, ".L_contains_yes")
        billet = executor.add(billet, backend.SCRATCH5, backend.SCRATCH3, backend.SCRATCH4)
        billet = executor.add(billet, backend.SCRATCH5, backend.VALUE, backend.SCRATCH5)
        billet = executor.load_byte(billet, backend.SCRATCH5, backend.SCRATCH5, words.payload + words.string_data)
        billet = executor.add(billet, backend.ARG2, backend.ERROR, backend.SCRATCH4)
        billet = executor.load_byte(billet, backend.ARG2, backend.ARG2, words.payload + words.string_data)
        billet = executor.branch_not_equal(billet, backend.SCRATCH5, backend.ARG2, ".L_contains_next")
        billet = executor.add_immediate(billet, backend.SCRATCH4, backend.SCRATCH4, 1)
        billet = executor.jump(billet, ".L_contains_inner")
        billet = executor.label(billet, ".L_contains_next")
        billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, 1)
        billet = executor.jump(billet, ".L_contains_outer")
        billet = executor.label(billet, ".L_contains_yes")
        billet = executor.load_immediate(billet, backend.VALUE, abi.YES)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_contains_no")
        billet = executor.load_immediate(billet, backend.VALUE, abi.NO)
        out endings.succeeded(billet)
    }

    skill emit_line_count(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_line_count")
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH0, backend.VALUE, words.payload)
        billet = executor.branch_zero(billet, backend.SCRATCH0, ".L_line_empty")
        billet = executor.load_immediate(billet, backend.SCRATCH1, 0)
        billet = executor.load_immediate(billet, backend.SCRATCH2, 0)
        billet = executor.label(billet, ".L_line_loop")
        billet = executor.branch_equal(billet, backend.SCRATCH2, backend.SCRATCH0, ".L_line_done")
        billet = executor.add(billet, backend.SCRATCH3, backend.VALUE, backend.SCRATCH2)
        billet = executor.load_byte(billet, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
        billet = executor.load_immediate(billet, backend.SCRATCH5, 10)
        billet = executor.branch_not_equal(billet, backend.SCRATCH4, backend.SCRATCH5, ".L_line_next")
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 1)
        billet = executor.label(billet, ".L_line_next")
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.jump(billet, ".L_line_loop")
        billet = executor.label(billet, ".L_line_done")
        billet = executor.add(billet, backend.SCRATCH3, backend.VALUE, backend.SCRATCH0)
        billet = executor.load_byte(billet, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data - 1)
        billet = executor.load_immediate(billet, backend.SCRATCH5, 10)
        billet = executor.branch_equal(billet, backend.SCRATCH4, backend.SCRATCH5, ".L_line_encode")
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 1)
        billet = executor.label(billet, ".L_line_encode")
        billet = executor.shift_left(billet, backend.VALUE, backend.SCRATCH1, abi.TAG_SHIFT)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_line_empty")
        billet = executor.load_immediate(billet, backend.VALUE, 0)
        out endings.succeeded(billet)
    }

    skill emit_cstring(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_cstring")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.move(billet, backend.SCRATCH0, backend.VALUE)
        billet = executor.load_immediate(billet, backend.SCRATCH1, 0)
        billet = executor.label(billet, ".L_cstring_len")
        billet = executor.load_byte(billet, backend.SCRATCH2, backend.SCRATCH0, 0)
        billet = executor.branch_zero(billet, backend.SCRATCH2, ".L_cstring_alloc")
        billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, 1)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 1)
        billet = executor.jump(billet, ".L_cstring_len")
        billet = executor.label(billet, ".L_cstring_alloc")
        billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes)
        billet = executor.add_immediate(billet, backend.VALUE, backend.SCRATCH1, words.string_data + 1)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes)
        billet = executor.load_immediate(billet, backend.SCRATCH2, abi.OBJECT_KIND_STRING)
        billet = executor.store32(billet, backend.SCRATCH2, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.store(billet, backend.SCRATCH1, backend.VALUE, words.payload)
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
        billet = executor.load_immediate(billet, backend.SCRATCH2, 0)
        billet = executor.label(billet, ".L_cstring_copy")
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_cstring_done")
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH2)
        billet = executor.load_byte(billet, backend.SCRATCH4, backend.SCRATCH3, 0)
        billet = executor.add(billet, backend.SCRATCH3, backend.VALUE, backend.SCRATCH2)
        billet = executor.store_byte(billet, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.jump(billet, ".L_cstring_copy")
        billet = executor.label(billet, ".L_cstring_done")
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        out endings.succeeded(billet)
    }

    skill emit_string_add(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_add")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 8)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.and_immediate(billet, backend.SCRATCH1, backend.ERROR, abi.PAYLOAD_MASK)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes * 6)
        billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes * 5)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH0, words.payload)
        billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH1, words.payload)
        billet = executor.store(billet, backend.SCRATCH2, backend.STACK, words.bytes * 4)
        billet = executor.store(billet, backend.SCRATCH3, backend.STACK, words.bytes * 3)
        billet = executor.add(billet, backend.SCRATCH4, backend.SCRATCH2, backend.SCRATCH3)
        billet = executor.store(billet, backend.SCRATCH4, backend.STACK, words.bytes * 2)
        billet = executor.add_immediate(billet, backend.VALUE, backend.SCRATCH4, words.string_data + 1)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load(billet, backend.SCRATCH4, backend.STACK, words.bytes * 2)
        billet = executor.load_immediate(billet, backend.SCRATCH5, abi.OBJECT_KIND_STRING)
        billet = executor.store32(billet, backend.SCRATCH5, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.store(billet, backend.SCRATCH4, backend.VALUE, words.payload)
        billet = executor.load_immediate(billet, backend.SCRATCH5, 0)
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 6)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes * 5)
        billet = executor.load(billet, backend.SCRATCH2, backend.STACK, words.bytes * 4)
        billet = executor.label(billet, ".L_string_left")
        billet = executor.branch_equal(billet, backend.SCRATCH5, backend.SCRATCH2, ".L_string_right_start")
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH5)
        billet = executor.load_byte(billet, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
        billet = executor.add(billet, backend.SCRATCH3, backend.VALUE, backend.SCRATCH5)
        billet = executor.store_byte(billet, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
        billet = executor.add_immediate(billet, backend.SCRATCH5, backend.SCRATCH5, 1)
        billet = executor.jump(billet, ".L_string_left")
        billet = executor.label(billet, ".L_string_right_start")
        billet = executor.load_immediate(billet, backend.ARG2, 0)
        billet = executor.load(billet, backend.SCRATCH2, backend.STACK, words.bytes * 3)
        billet = executor.label(billet, ".L_string_right")
        billet = executor.branch_equal(billet, backend.ARG2, backend.SCRATCH2, ".L_string_done")
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH1, backend.ARG2)
        billet = executor.load_byte(billet, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
        billet = executor.add(billet, backend.SCRATCH3, backend.VALUE, backend.SCRATCH5)
        billet = executor.store_byte(billet, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
        billet = executor.add_immediate(billet, backend.SCRATCH5, backend.SCRATCH5, 1)
        billet = executor.add_immediate(billet, backend.ARG2, backend.ARG2, 1)
        billet = executor.jump(billet, ".L_string_right")
        billet = executor.label(billet, ".L_string_done")
        billet = executor.add(billet, backend.SCRATCH3, backend.VALUE, backend.SCRATCH5)
        billet = executor.store_byte_zero(billet, backend.SCRATCH3, words.payload + words.string_data)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 8)
        out endings.succeeded(billet)
    }

    skill emit_string_at(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_at")
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.shift_right_signed(billet, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.branch_greater_equal_unsigned(billet, backend.ERROR, backend.SCRATCH1, "rt_string_bounds")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add(billet, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
        billet = executor.load_byte(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload + words.string_data)
        billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes * 2)
        billet = executor.label(billet, ".L_string_one_byte")
        billet = executor.load_immediate(billet, backend.VALUE, words.string_data + 2)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load_immediate(billet, backend.SCRATCH0, abi.OBJECT_KIND_STRING)
        billet = executor.store32(billet, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load_immediate(billet, backend.SCRATCH0, 1)
        billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes * 2)
        billet = executor.store_byte(billet, backend.SCRATCH1, backend.VALUE, words.payload + words.string_data)
        billet = executor.store_byte_zero(billet, backend.VALUE, words.payload + words.string_data + 1)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        out endings.succeeded(billet)
    }

    skill emit_string_from_byte(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_from_byte")
        billet = executor.shift_right_signed(billet, backend.SCRATCH1, backend.VALUE, abi.TAG_SHIFT)
        billet = executor.load_immediate(billet, backend.SCRATCH0, 256)
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH1, backend.SCRATCH0, "rt_string_bounds")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes * 2)
        out executor.jump(billet, ".L_string_one_byte")
    }

    skill emit_string_from_bytes(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_from_bytes")
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.ARG2, backend.SCRATCH0, words.payload)
        billet = executor.shift_left(billet, backend.ARG2, backend.ARG2, abi.TAG_SHIFT)
        billet = executor.load_immediate(billet, backend.ERROR, 0)
        out executor.jump(billet, "rt_string_slice")
    }

    skill emit_string_slice(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_slice")
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.shift_right_signed(billet, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
        billet = executor.shift_right_signed(billet, backend.ARG2, backend.ARG2, abi.TAG_SHIFT)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.branch_less_unsigned(billet, backend.ARG2, backend.ERROR, "rt_string_bounds")
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH1, backend.ARG2, "rt_string_bounds")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 8)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.sub(billet, backend.SCRATCH2, backend.ARG2, backend.ERROR)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes * 6)
        billet = executor.store(billet, backend.ERROR, backend.STACK, words.bytes * 5)
        billet = executor.store(billet, backend.SCRATCH2, backend.STACK, words.bytes * 4)
        billet = executor.add_immediate(billet, backend.VALUE, backend.SCRATCH2, words.string_data + 1)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 6)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes * 5)
        billet = executor.load(billet, backend.SCRATCH2, backend.STACK, words.bytes * 4)
        billet = executor.load_immediate(billet, backend.SCRATCH3, abi.OBJECT_KIND_STRING)
        billet = executor.store32(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.store(billet, backend.SCRATCH2, backend.VALUE, words.payload)
        billet = executor.load_immediate(billet, backend.SCRATCH3, 0)
        billet = executor.label(billet, ".L_slice_copy")
        billet = executor.branch_equal(billet, backend.SCRATCH3, backend.SCRATCH2, ".L_slice_done")
        billet = executor.add(billet, backend.SCRATCH4, backend.SCRATCH1, backend.SCRATCH3)
        billet = executor.add(billet, backend.SCRATCH4, backend.SCRATCH0, backend.SCRATCH4)
        billet = executor.load_byte(billet, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.string_data)
        billet = executor.add(billet, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
        billet = executor.store_byte(billet, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.string_data)
        billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, 1)
        billet = executor.jump(billet, ".L_slice_copy")
        billet = executor.label(billet, ".L_slice_done")
        billet = executor.add(billet, backend.SCRATCH4, backend.VALUE, backend.SCRATCH2)
        billet = executor.store_byte_zero(billet, backend.SCRATCH4, words.payload + words.string_data)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 8)
        out endings.succeeded(billet)
    }

    skill emit_string_lower(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_string_lower")
        billet = executor.load_immediate(billet, backend.ERROR, 0)
        billet = executor.jump(billet, "rt_string_case")
        out billet
    }

    skill emit_string_case(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_string_upper")
        billet = executor.load_immediate(billet, backend.ERROR, 1)
        billet = executor.label(billet, "rt_string_case")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 8)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes * 6)
        billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes * 5)
        billet = executor.store(billet, backend.ERROR, backend.STACK, words.bytes * 4)
        billet = executor.add_immediate(billet, backend.VALUE, backend.SCRATCH1, words.string_data + 1)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 6)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes * 5)
        billet = executor.load(billet, backend.SCRATCH2, backend.STACK, words.bytes * 4)
        billet = executor.load_immediate(billet, backend.SCRATCH3, abi.OBJECT_KIND_STRING)
        billet = executor.store32(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.store(billet, backend.SCRATCH1, backend.VALUE, words.payload)
        billet = executor.load_immediate(billet, backend.SCRATCH3, 0)
        billet = executor.label(billet, ".L_case_loop")
        billet = executor.branch_equal(billet, backend.SCRATCH3, backend.SCRATCH1, ".L_case_done")
        billet = executor.add(billet, backend.SCRATCH4, backend.SCRATCH0, backend.SCRATCH3)
        billet = executor.load_byte(billet, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.string_data)
        billet = executor.load_immediate(billet, backend.ERROR, CYRILLIC_LOW)
        billet = executor.branch_equal(billet, backend.SCRATCH5, backend.ERROR, ".L_case_pair")
        billet = executor.load_immediate(billet, backend.ERROR, CYRILLIC_HIGH)
        billet = executor.branch_equal(billet, backend.SCRATCH5, backend.ERROR, ".L_case_pair")
        billet = executor.label(billet, ".L_case_single")
        billet = executor.branch_zero(billet, backend.SCRATCH2, ".L_case_lower")
        billet = executor.load_immediate(billet, backend.SCRATCH4, 97)
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH5, backend.SCRATCH4, ".L_case_store")
        billet = executor.load_immediate(billet, backend.SCRATCH4, 123)
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH5, backend.SCRATCH4, ".L_case_store")
        billet = executor.add_immediate(billet, backend.SCRATCH5, backend.SCRATCH5, -32)
        billet = executor.jump(billet, ".L_case_store")
        billet = executor.label(billet, ".L_case_lower")
        billet = executor.load_immediate(billet, backend.SCRATCH4, 65)
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH5, backend.SCRATCH4, ".L_case_store")
        billet = executor.load_immediate(billet, backend.SCRATCH4, 91)
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH5, backend.SCRATCH4, ".L_case_store")
        billet = executor.add_immediate(billet, backend.SCRATCH5, backend.SCRATCH5, 32)
        billet = executor.label(billet, ".L_case_store")
        billet = executor.add(billet, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
        billet = executor.store_byte(billet, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.string_data)
        billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, 1)
        billet = executor.jump(billet, ".L_case_loop")
        billet = emit_case_pair(billet)
        billet = executor.label(billet, ".L_case_done")
        billet = executor.add(billet, backend.SCRATCH4, backend.VALUE, backend.SCRATCH1)
        billet = executor.store_byte_zero(billet, backend.SCRATCH4, words.payload + words.string_data)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_STRING)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 8)
        out endings.succeeded(billet)
    }

    skill within(billet, value, low, high, miss) {
        @executor = billet.executor
        billet = executor.load_immediate(billet, backend.SCRATCH4, low)
        billet = executor.branch_less_unsigned(billet, value, backend.SCRATCH4, miss)
        billet = executor.load_immediate(billet, backend.SCRATCH4, high + 1)
        out executor.branch_greater_equal_unsigned(billet, value, backend.SCRATCH4, miss)
    }

    skill pair_to(billet, lead, shift, label) {
        @executor = billet.executor
        billet = executor.load_immediate(billet, backend.SCRATCH5, lead)
        billet = executor.add_immediate(billet, backend.ARG2, backend.ARG2, shift)
        out executor.jump(billet, label)
    }

    skill emit_case_pair(billet) {
        @executor = billet.executor
        @words = billet.words
        @store = ".L_case_pair_store"
        billet = executor.label(billet, ".L_case_pair")
        billet = executor.add_immediate(billet, backend.ERROR, backend.SCRATCH3, 1)
        billet = executor.branch_greater_equal_unsigned(billet, backend.ERROR, backend.SCRATCH1, ".L_case_single")
        billet = executor.add(billet, backend.SCRATCH4, backend.SCRATCH0, backend.SCRATCH3)
        billet = executor.load_byte(billet, backend.ARG2, backend.SCRATCH4, words.payload + words.string_data + 1)
        billet = executor.load_immediate(billet, backend.ERROR, CYRILLIC_LOW)
        billet = executor.branch_zero(billet, backend.SCRATCH2, ".L_case_pair_lower")
        billet = executor.branch_not_equal(billet, backend.SCRATCH5, backend.ERROR, ".L_case_upper_high")
        billet = within(billet, backend.ARG2, 176, 191, store)
        billet = pair_to(billet, CYRILLIC_LOW, -32, store)
        billet = executor.label(billet, ".L_case_upper_high")
        billet = executor.load_immediate(billet, backend.SCRATCH4, 145)
        billet = executor.branch_equal(billet, backend.ARG2, backend.SCRATCH4, ".L_case_upper_yo")
        billet = within(billet, backend.ARG2, 128, 143, store)
        billet = pair_to(billet, CYRILLIC_LOW, 32, store)
        billet = executor.label(billet, ".L_case_upper_yo")
        billet = pair_to(billet, CYRILLIC_LOW, -16, store)
        billet = executor.label(billet, ".L_case_pair_lower")
        billet = executor.branch_not_equal(billet, backend.SCRATCH5, backend.ERROR, store)
        billet = executor.load_immediate(billet, backend.SCRATCH4, 129)
        billet = executor.branch_equal(billet, backend.ARG2, backend.SCRATCH4, ".L_case_lower_yo")
        billet = within(billet, backend.ARG2, 144, 175, store)
        billet = executor.load_immediate(billet, backend.SCRATCH4, 160)
        billet = executor.branch_less_unsigned(billet, backend.ARG2, backend.SCRATCH4, ".L_case_lower_first")
        billet = pair_to(billet, CYRILLIC_HIGH, -32, store)
        billet = executor.label(billet, ".L_case_lower_first")
        billet = pair_to(billet, CYRILLIC_LOW, 32, store)
        billet = executor.label(billet, ".L_case_lower_yo")
        billet = pair_to(billet, CYRILLIC_HIGH, 16, store)
        billet = executor.label(billet, store)
        billet = executor.add(billet, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
        billet = executor.store_byte(billet, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.string_data)
        billet = executor.store_byte(billet, backend.ARG2, backend.SCRATCH4, words.payload + words.string_data + 1)
        billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, 2)
        out executor.jump(billet, ".L_case_loop")
    }
}
