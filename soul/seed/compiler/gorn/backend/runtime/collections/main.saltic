-- collections — рантайм Box и групп: rt_box_get/set, rt_group_*.
-- Каждый навык берёт и отдаёт billet, определяя метку rt_* в коде.
-- Команды — методами billet.executor (договор backend), регистры — его роли.
-- Box: поля парами (id, значение), быстрый путь по слоту, иначе перебор.
-- Группа: плоская до GROUP_FLAT_LIMIT, дальше дерево (tree_add из
-- core.group, если он есть в программе; rt_group_tree_at — спуск по уровням).
--
-- emit_box_get(billet) — rt_box_get(VALUE box, ERROR id, ARG2 slot) -> VALUE;
--     Box, переехавший в хранилище, читается по адресу переезда (emit_box_resolve)
-- emit_box_set(billet) — rt_box_set(VALUE box, ERROR id, ARG2 value, ARG3 slot)
--     -> none. Box в хранилище — путь хранилища; Box старше региона и значение —
--     указатель кучи — Box переезжает в хранилище (rt_store_move) и в карантин,
--     потом путь хранилища; иначе простая запись. Путь хранилища: место в
--     карантине на два объекта, rt_store_move значения (rt_cycle_box = Box), для Box
--     с рёбрами — rt_cycle_reach (ARG2 — старое слово ячейки: достижимое из него
--     не обходится), счётчик нового +1, запись, счётчик старого −1,
--     ноль — в карантин. Ошибки MemoryExhausted, CycleForbidden, CycleCheckExhausted —
--     вызывающему. Кадр: SET_BOX, SET_CELL, SET_VALUE, SET_NEW, SET_RETURN
-- emit_missing_field(billet) — rt_missing_field: ERROR_MISSING_FIELD; emit_empty_touched —
--     rt_empty_touched: ERROR_EMPTY_TOUCHED; only_box(billet, label) — у rt_box_get /
--     rt_box_set: VALUE не Box — none → EmptyTouched, иначе MissingField
-- emit_group_count(billet) — rt_group_count(VALUE) -> число
-- emit_group_at(billet) — rt_group_at(VALUE, ERROR index) -> элемент; bounds
-- emit_group_bounds(billet) — rt_group_bounds: ERROR_GROUP_BOUNDS
-- emit_group_add(billet) — rt_group_add(VALUE, ERROR item) -> новая группа
-- emit_tree_switch(billet) — переход в tree_add для больших групп
-- emit_group_tree_at / emit_group_tree_parts / emit_group_tree_make(billet)
-- emit_times_shift(billet, target, scratch) — target × TREE_SHIFT для спуска по
--     уровням: x + (x << k), годится для TREE_SHIFT = 1 + 2^k, иначе TreeShiftUnsupported
-- emit_group_flatten(billet) — rt_group_flatten: дерево → плоская
-- emit_group_replaced(billet) — rt_group_replaced(VALUE, ERROR index, ARG2 value) ->
--     новая плоская (копия; дерево — через rt_group_flatten); index вне count — rt_group_bounds

use compiler.contract.abi
use compiler.gorn.memory.model
use compiler.gorn.state
use compiler.gorn.constants
use compiler.gorn.backend
use compiler.gorn.backend.runtime.memory.walk
use compiler.gorn.backend.runtime.tails

BOX_ROLE = backend.SCRATCH2
SET_FRAME_WORDS = 8
SET_BOX = 0
SET_CELL = 1
SET_VALUE = 2
SET_NEW = 3
SET_RETURN = 7

Collections = Box {
    endings = tails.Tails {},
    walks = walk.Walk {},
    constant_ops = constants.Constants {}

    skill emit_group_count(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_group_count")
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.VALUE, backend.VALUE, words.payload)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        out endings.succeeded(billet)
    }

    skill emit_group_at(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_group_at")
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.shift_right_signed(billet, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
        billet = executor.load32(billet, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load_immediate(billet, backend.SCRATCH1, abi.OBJECT_KIND_TREE)
        billet = executor.branch_equal(billet, backend.SCRATCH0, backend.SCRATCH1, "rt_group_tree_at")
        billet = executor.load(billet, backend.SCRATCH0, backend.VALUE, words.payload)
        billet = executor.branch_greater_equal_unsigned(billet, backend.ERROR, backend.SCRATCH0, "rt_group_bounds")
        billet = executor.shift_left(billet, backend.ERROR, backend.ERROR, words.shift)
        billet = executor.add(billet, backend.VALUE, backend.VALUE, backend.ERROR)
        billet = executor.load(billet, backend.VALUE, backend.VALUE, words.payload + words.group_items)
        out endings.succeeded(billet)
    }

    skill emit_group_bounds(billet) {
        @executor = billet.executor
        out endings.error_stub(billet, "rt_group_bounds", abi.ERROR_GROUP_BOUNDS)
    }

    skill emit_group_add(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_group_add")
        @billet_skills = billet.skills
        @tree_add = billet_skills.find(constants.TREE_ADD_SKILL)
        (tree_add.name == constants.TREE_ADD_SKILL) {
            billet = emit_tree_switch(billet)
        }
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.store(billet, backend.ERROR, backend.STACK, words.bytes)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.add_immediate(billet, backend.VALUE, backend.SCRATCH1, 2)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, words.shift)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH1, 1)
        billet = executor.load_immediate(billet, backend.SCRATCH3, abi.OBJECT_KIND_GROUP)
        billet = executor.store32(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.store(billet, backend.SCRATCH2, backend.VALUE, words.payload)
        billet = executor.load_immediate(billet, backend.SCRATCH2, 0)
        billet = executor.label(billet, ".L_group_copy")
        billet = executor.branch_equal(billet, backend.SCRATCH2, backend.SCRATCH1, ".L_group_copy_done")
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH2, words.shift)
        billet = executor.add(billet, backend.SCRATCH4, backend.SCRATCH0, backend.SCRATCH3)
        billet = executor.load(billet, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.group_items)
        billet = executor.add(billet, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
        billet = executor.store(billet, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.group_items)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.jump(billet, ".L_group_copy")
        billet = executor.label(billet, ".L_group_copy_done")
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH1, words.shift)
        billet = executor.add(billet, backend.SCRATCH3, backend.VALUE, backend.SCRATCH3)
        billet = executor.load(billet, backend.SCRATCH4, backend.STACK, words.bytes)
        billet = executor.store(billet, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.group_items)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        out endings.succeeded(billet)
    }

    skill emit_times_shift(billet, target, scratch) {
        @executor = billet.executor
        @high = constants.TREE_SHIFT - 1
        @bit = 0
        always {
            (high < 2) {
                leave
            }
            (high % 2 == 1) {
                out error.TreeShiftUnsupported
            }
            high = high / 2
            bit = bit + 1
        }
        ((high == 1) == no) {
            out error.TreeShiftUnsupported
        }
        billet = executor.shift_left(billet, scratch, target, bit)
        out executor.add(billet, target, target, scratch)
    }

    skill emit_group_tree_at(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_group_tree_at")
        billet = executor.load(billet, backend.SCRATCH0, backend.VALUE, words.payload)
        billet = executor.branch_greater_equal_unsigned(billet, backend.ERROR, backend.SCRATCH0, "rt_group_bounds")
        billet = executor.load(billet, backend.SCRATCH1, backend.VALUE, words.payload + words.tree_tail)
        billet = executor.and_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH1, words.payload)
        billet = executor.sub(billet, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH2)
        billet = executor.branch_greater_equal_unsigned(billet, backend.ERROR, backend.SCRATCH3, ".L_tree_tail")
        billet = executor.load(billet, backend.SCRATCH4, backend.VALUE, words.payload + words.tree_levels)
        billet = executor.load(billet, backend.SCRATCH5, backend.VALUE, words.payload + words.tree_root)
        billet = executor.and_immediate(billet, backend.SCRATCH5, backend.SCRATCH5, abi.PAYLOAD_MASK)
        billet = executor.add_immediate(billet, backend.ARG2, backend.SCRATCH4, -1)
        billet = emit_times_shift(billet, backend.ARG2, backend.SCRATCH3)
        billet = executor.label(billet, ".L_tree_down")
        billet = executor.branch_zero(billet, backend.ARG2, ".L_tree_leaf")
        billet = executor.shift_right_unsigned_by(billet, backend.SCRATCH3, backend.ERROR, backend.ARG2)
        billet = executor.and_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, constants.TREE_MASK)
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH3, words.shift)
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH5, backend.SCRATCH3)
        billet = executor.load(billet, backend.SCRATCH5, backend.SCRATCH3, words.payload + words.group_items)
        billet = executor.and_immediate(billet, backend.SCRATCH5, backend.SCRATCH5, abi.PAYLOAD_MASK)
        billet = executor.add_immediate(billet, backend.ARG2, backend.ARG2, -constants.TREE_SHIFT)
        billet = executor.jump(billet, ".L_tree_down")
        billet = executor.label(billet, ".L_tree_leaf")
        billet = executor.and_immediate(billet, backend.SCRATCH3, backend.ERROR, constants.TREE_MASK)
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH3, words.shift)
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH5, backend.SCRATCH3)
        billet = executor.load(billet, backend.VALUE, backend.SCRATCH3, words.payload + words.group_items)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_tree_tail")
        billet = executor.sub(billet, backend.SCRATCH3, backend.ERROR, backend.SCRATCH3)
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH3, words.shift)
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH1, backend.SCRATCH3)
        billet = executor.load(billet, backend.VALUE, backend.SCRATCH3, words.payload + words.group_items)
        out endings.succeeded(billet)
    }

    skill emit_tree_switch(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load32(billet, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load_immediate(billet, backend.SCRATCH2, abi.OBJECT_KIND_TREE)
        billet = executor.branch_equal(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_group_add_tree")
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.load_immediate(billet, backend.SCRATCH2, constants.GROUP_FLAT_LIMIT)
        billet = executor.branch_less(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_group_add_flat")
        billet = executor.label(billet, ".L_group_add_tree")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.call(billet, constants.TREE_ADD_LABEL)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.ret(billet)
        billet = executor.label(billet, ".L_group_add_flat")
        out billet
    }

    skill emit_group_tree_parts(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_group_tree_parts")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
        billet = executor.load32(billet, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load_immediate(billet, backend.SCRATCH2, abi.OBJECT_KIND_TREE)
        billet = executor.load_immediate(billet, backend.VALUE, constant_ops.group_storage_bytes(billet.words, 0))
        billet = executor.store_zero(billet, backend.STACK, words.bytes)
        billet = executor.branch_not_equal(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_tree_parts_alloc")
        billet = executor.load_immediate(billet, backend.VALUE, constant_ops.group_storage_bytes(billet.words, 3))
        billet = executor.load_immediate(billet, backend.SCRATCH3, 3)
        billet = executor.store(billet, backend.SCRATCH3, backend.STACK, words.bytes)
        billet = executor.label(billet, ".L_tree_parts_alloc")
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load_immediate(billet, backend.SCRATCH3, abi.OBJECT_KIND_GROUP)
        billet = executor.store32(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes)
        billet = executor.store(billet, backend.SCRATCH1, backend.VALUE, words.payload)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_tree_parts_done")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH0, words.payload + words.tree_levels)
        billet = executor.shift_left(billet, backend.SCRATCH2, backend.SCRATCH2, abi.TAG_SHIFT)
        billet = executor.store(billet, backend.SCRATCH2, backend.VALUE, words.payload + words.group_items)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH0, words.payload + words.tree_root)
        billet = executor.store(billet, backend.SCRATCH2, backend.VALUE, words.payload + words.group_items + words.group_item)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH0, words.payload + words.tree_tail)
        billet = executor.store(billet, backend.SCRATCH2, backend.VALUE, words.payload + words.group_items + 2 * words.group_item)
        billet = executor.label(billet, ".L_tree_parts_done")
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        out endings.succeeded(billet)
    }

    skill emit_group_tree_make(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_group_tree_make")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 8)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes * 6)
        billet = executor.store(billet, backend.ERROR, backend.STACK, words.bytes * 5)
        billet = executor.store(billet, backend.ARG2, backend.STACK, words.bytes * 4)
        billet = executor.store(billet, backend.ARG3, backend.STACK, words.bytes * 3)
        billet = executor.load_immediate(billet, backend.VALUE, words.tree_payload)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load_immediate(billet, backend.SCRATCH0, abi.OBJECT_KIND_TREE)
        billet = executor.store32(billet, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 6)
        billet = executor.shift_right_signed(billet, backend.SCRATCH0, backend.SCRATCH0, abi.TAG_SHIFT)
        billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload)
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 5)
        billet = executor.shift_right_signed(billet, backend.SCRATCH0, backend.SCRATCH0, abi.TAG_SHIFT)
        billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload + words.tree_levels)
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 4)
        billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload + words.tree_root)
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload + words.tree_tail)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 8)
        out endings.succeeded(billet)
    }

    skill emit_group_flatten(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_group_flatten")
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load32(billet, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load_immediate(billet, backend.SCRATCH2, abi.OBJECT_KIND_TREE)
        billet = executor.branch_equal(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_flatten_tree")
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_flatten_tree")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes)
        billet = executor.add_immediate(billet, backend.VALUE, backend.SCRATCH1, 1)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, words.shift)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load_immediate(billet, backend.SCRATCH3, abi.OBJECT_KIND_GROUP)
        billet = executor.store32(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes)
        billet = executor.store(billet, backend.SCRATCH1, backend.VALUE, words.payload)
        billet = executor.store(billet, backend.VALUE, backend.STACK, 0)
        billet = executor.load_immediate(billet, backend.SCRATCH4, 0)
        billet = executor.label(billet, ".L_flatten_loop")
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes)
        billet = executor.branch_equal(billet, backend.SCRATCH4, backend.SCRATCH1, ".L_flatten_done")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.SCRATCH4, backend.STACK, words.bytes * 3)
        billet = executor.load(billet, backend.VALUE, backend.STACK, words.bytes * 6)
        billet = executor.shift_left(billet, backend.ERROR, backend.SCRATCH4, abi.TAG_SHIFT)
        billet = executor.call(billet, "rt_group_at")
        billet = executor.load(billet, backend.SCRATCH4, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, 0)
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH4, words.shift)
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH3)
        billet = executor.store(billet, backend.VALUE, backend.SCRATCH3, words.payload + words.group_items)
        billet = executor.add_immediate(billet, backend.SCRATCH4, backend.SCRATCH4, 1)
        billet = executor.jump(billet, ".L_flatten_loop")
        billet = executor.label(billet, ".L_flatten_done")
        billet = executor.load(billet, backend.VALUE, backend.STACK, 0)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        out endings.succeeded(billet)
    }

    skill emit_group_replaced(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_group_replaced")
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.shift_right_signed(billet, backend.SCRATCH1, backend.ERROR, abi.TAG_SHIFT)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH0, words.payload)
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH1, backend.SCRATCH2, "rt_group_bounds")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.store(billet, backend.ERROR, backend.STACK, words.bytes)
        billet = executor.store(billet, backend.ARG2, backend.STACK, 0)
        billet = executor.load32(billet, backend.SCRATCH3, backend.SCRATCH0, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load_immediate(billet, backend.SCRATCH4, abi.OBJECT_KIND_TREE)
        billet = executor.branch_not_equal(billet, backend.SCRATCH3, backend.SCRATCH4, ".L_replaced_flat")
        billet = executor.call(billet, "rt_group_flatten")
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.jump(billet, ".L_replaced_put")
        billet = executor.label(billet, ".L_replaced_flat")
        billet = executor.add_immediate(billet, backend.VALUE, backend.SCRATCH2, 1)
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, words.shift)
        billet = executor.call(billet, "rt_alloc")
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, words.payload)
        billet = executor.load_immediate(billet, backend.SCRATCH3, abi.OBJECT_KIND_GROUP)
        billet = executor.store32(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.store(billet, backend.SCRATCH1, backend.VALUE, words.payload)
        billet = executor.load_immediate(billet, backend.SCRATCH2, 0)
        billet = executor.label(billet, ".L_replaced_copy")
        billet = executor.branch_equal(billet, backend.SCRATCH2, backend.SCRATCH1, ".L_replaced_put")
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH2, words.shift)
        billet = executor.add(billet, backend.SCRATCH4, backend.SCRATCH0, backend.SCRATCH3)
        billet = executor.load(billet, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.group_items)
        billet = executor.add(billet, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
        billet = executor.store(billet, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.group_items)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.jump(billet, ".L_replaced_copy")
        billet = executor.label(billet, ".L_replaced_put")
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes)
        billet = executor.shift_right_signed(billet, backend.SCRATCH1, backend.SCRATCH1, abi.TAG_SHIFT)
        billet = executor.shift_left(billet, backend.SCRATCH1, backend.SCRATCH1, words.shift)
        billet = executor.add(billet, backend.SCRATCH1, backend.VALUE, backend.SCRATCH1)
        billet = executor.load(billet, backend.SCRATCH2, backend.STACK, 0)
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH1, words.payload + words.group_items)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        out endings.succeeded(billet)
    }
}
