-- fraction — рантайм дробных (Q-014, Q-041, Q-044): урезанная плавающая — биты
-- double, три младших — метка FRACTION. Только у 64-битных исполнителей
-- (billet.words.bytes = 8): команды backend.fraction / fraction_from / fraction_to.
-- Результат округляется к 50 значимым битам (к ближайшему, посередине — к
-- чётному); порядок за пределами double — FractionOverflow, делитель ноль —
-- DivisionByZero. Сравнения отдают yes/no. Целое из дробного — по модулю меньше
-- 2^59, иначе NumberOverflow.
--
-- append(billet) — все метки ниже, если слово 8 байт; иначе ничего
-- rt_fraction_add / sub / mul / div(VALUE, ERROR) -> дробное
-- rt_fraction_less / greater(VALUE, ERROR) -> yes/no; rt_fraction_near — ~= с NEAR
-- rt_fraction_from(VALUE число) -> дробное; rt_fraction_bits(VALUE) -> число — биты без метки,
--     rt_fraction_from_bits — обратно (для хранилищ вроде core.matrix)
-- rt_fraction_trunc / floor / ceil / round_bank / round_school(VALUE) -> число
-- Внутри: round — округлить и пометить VALUE; whole_part(name) — начало перевода в целое

use compiler.abi
use compiler.machine.wide
use compiler.gorn.backend
use compiler.gorn.backend.runtime.tails

EXPONENT_SHIFT = 53
EXPONENT_FULL = 2047
WHOLE_LIMIT = 1082
NEAR_BITS = "4472406533629990549"
HALF_BITS = "4602678819172646912"

Fraction = Box {
    endings = tails.Tails {}

    skill round(billet) {
        @executor = billet.executor
        billet = executor.label(billet, "rt_fraction_round")
        billet = executor.load_immediate(billet, backend.SCRATCH1, EXPONENT_FULL)
        billet = executor.shift_left(billet, backend.SCRATCH0, backend.VALUE, 1)
        billet = executor.shift_right_unsigned(billet, backend.SCRATCH0, backend.SCRATCH0, EXPONENT_SHIFT)
        billet = executor.branch_equal(billet, backend.SCRATCH0, backend.SCRATCH1, "rt_fraction_overflow")
        billet = executor.shift_right_unsigned(billet, backend.SCRATCH0, backend.VALUE, abi.TAG_SHIFT)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, 1)
        billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, 3)
        billet = executor.add(billet, backend.VALUE, backend.VALUE, backend.SCRATCH0)
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.shift_left(billet, backend.SCRATCH0, backend.VALUE, 1)
        billet = executor.shift_right_unsigned(billet, backend.SCRATCH0, backend.SCRATCH0, EXPONENT_SHIFT)
        billet = executor.branch_equal(billet, backend.SCRATCH0, backend.SCRATCH1, "rt_fraction_overflow")
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_FRACTION)
        billet = endings.succeeded(billet)
        out endings.error_stub(billet, "rt_fraction_overflow", abi.ERROR_FRACTION_OVERFLOW)
    }

    skill clear(billet) {
        @executor = billet.executor
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        out executor.and_immediate(billet, backend.ERROR, backend.ERROR, abi.PAYLOAD_MASK)
    }

    skill arithmetic(billet, name, op) {
        @executor = billet.executor
        billet = clear(executor.label(billet, name))
        (op == backend.FRACTION_DIV) {
            billet = executor.shift_left(billet, backend.SCRATCH0, backend.ERROR, 1)
            billet = executor.jump_if_zero(billet, backend.SCRATCH0, "rt_division_by_zero")
        }
        billet = executor.fraction(billet, op, backend.VALUE, backend.VALUE, backend.ERROR)
        out executor.jump(billet, "rt_fraction_round")
    }

    skill answer(billet) {
        @executor = billet.executor
        billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.NO)
        out endings.succeeded(billet)
    }

    skill compare(billet, name, left, right) {
        @executor = billet.executor
        billet = clear(executor.label(billet, name))
        out answer(executor.fraction(billet, backend.FRACTION_LESS, backend.VALUE, left, right))
    }

    skill absolute(billet, to, from) {
        @executor = billet.executor
        billet = executor.shift_left(billet, to, from, 1)
        out executor.shift_right_unsigned(billet, to, to, 1)
    }

    skill near(billet) {
        @executor = billet.executor
        billet = clear(executor.label(billet, "rt_fraction_near"))
        billet = executor.fraction(billet, backend.FRACTION_SUB, backend.SCRATCH2, backend.VALUE, backend.ERROR)
        billet = absolute(billet, backend.SCRATCH2, backend.SCRATCH2)
        billet = absolute(billet, backend.SCRATCH3, backend.VALUE)
        billet = absolute(billet, backend.SCRATCH4, backend.ERROR)
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH3, backend.SCRATCH4, ".L_fraction_near_most")
        billet = executor.move(billet, backend.SCRATCH3, backend.SCRATCH4)
        billet = executor.label(billet, ".L_fraction_near_most")
        billet = executor.load_wide(billet, backend.SCRATCH4, wide.from_decimal(NEAR_BITS))
        billet = executor.fraction(billet, backend.FRACTION_MUL, backend.SCRATCH3, backend.SCRATCH3, backend.SCRATCH4)
        out answer(executor.fraction(billet, backend.FRACTION_LESS_EQUAL, backend.VALUE, backend.SCRATCH2, backend.SCRATCH3))
    }

    skill whole_part(billet, name) {
        @executor = billet.executor
        billet = executor.label(billet, name)
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.shift_left(billet, backend.SCRATCH0, backend.VALUE, 1)
        billet = executor.shift_right_unsigned(billet, backend.SCRATCH0, backend.SCRATCH0, EXPONENT_SHIFT)
        billet = executor.load_immediate(billet, backend.SCRATCH1, WHOLE_LIMIT)
        billet = executor.branch_less(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_{name}_fits")
        billet = executor.jump(billet, "rt_number_overflow")
        billet = executor.label(billet, ".L_{name}_fits")
        out executor.fraction_to(billet, backend.SCRATCH2, backend.VALUE, backend.FRACTION_TRUNC)
    }

    skill to_number(billet, from) {
        @executor = billet.executor
        billet = executor.shift_left(billet, backend.VALUE, from, abi.TAG_SHIFT)
        out endings.succeeded(billet)
    }

    skill nearest(billet, name, mode, later) {
        @executor = billet.executor
        billet = whole_part(billet, name)
        billet = executor.fraction_from(billet, backend.SCRATCH3, backend.SCRATCH2)
        (mode == 0) {
            billet = executor.fraction(billet, backend.FRACTION_LESS, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
        }
        (mode == 1) {
            billet = executor.fraction(billet, backend.FRACTION_LESS, backend.SCRATCH4, backend.SCRATCH3, backend.VALUE)
        }
        (later == yes) {
            billet = executor.add(billet, backend.SCRATCH2, backend.SCRATCH2, backend.SCRATCH4)
        }
        (later == no) {
            billet = executor.sub(billet, backend.SCRATCH2, backend.SCRATCH2, backend.SCRATCH4)
        }
        out to_number(billet, backend.SCRATCH2)
    }

    skill school(billet) {
        @executor = billet.executor
        billet = whole_part(billet, "rt_fraction_round_school")
        billet = executor.fraction_from(billet, backend.SCRATCH3, backend.SCRATCH2)
        billet = executor.fraction(billet, backend.FRACTION_SUB, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
        billet = absolute(billet, backend.SCRATCH4, backend.SCRATCH4)
        billet = executor.load_wide(billet, backend.SCRATCH5, wide.from_decimal(HALF_BITS))
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH4, backend.SCRATCH5, ".L_fraction_school_done")
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.branch_not_negative(billet, backend.VALUE, ".L_fraction_school_done")
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, -2)
        billet = executor.label(billet, ".L_fraction_school_done")
        out to_number(billet, backend.SCRATCH2)
    }

    skill append(billet) {
        @executor = billet.executor
        ((billet.words.bytes == 8) == no) {
            out billet
        }
        billet = round(billet)
        billet = arithmetic(billet, "rt_fraction_add", backend.FRACTION_ADD)
        billet = arithmetic(billet, "rt_fraction_sub", backend.FRACTION_SUB)
        billet = arithmetic(billet, "rt_fraction_mul", backend.FRACTION_MUL)
        billet = arithmetic(billet, "rt_fraction_div", backend.FRACTION_DIV)
        billet = compare(billet, "rt_fraction_less", backend.VALUE, backend.ERROR)
        billet = compare(billet, "rt_fraction_greater", backend.ERROR, backend.VALUE)
        billet = near(billet)
        billet = executor.label(billet, "rt_fraction_from")
        billet = executor.shift_right_signed(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        billet = executor.fraction_from(billet, backend.VALUE, backend.VALUE)
        billet = executor.jump(billet, "rt_fraction_round")
        billet = executor.label(billet, "rt_fraction_bits")
        billet = executor.and_immediate(billet, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, "rt_fraction_from_bits")
        billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_FRACTION)
        billet = endings.succeeded(billet)
        billet = to_number(whole_part(billet, "rt_fraction_trunc"), backend.SCRATCH2)
        billet = nearest(billet, "rt_fraction_floor", 0, no)
        billet = nearest(billet, "rt_fraction_ceil", 1, yes)
        billet = whole_part(billet, "rt_fraction_round_bank")
        billet = executor.fraction_to(billet, backend.SCRATCH2, backend.VALUE, backend.FRACTION_NEAREST_EVEN)
        billet = to_number(billet, backend.SCRATCH2)
        out school(billet)
    }
}
