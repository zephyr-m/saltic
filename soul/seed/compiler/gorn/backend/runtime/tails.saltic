-- tails — общие хвосты навыков рантайма и платформ: успешный возврат и
-- заглушка системной ошибки. Команды — методами billet.executor.
--
-- Хозяин — Tails (СОП, 22.11.2026).
-- succeeded(billet) — ERROR = CALL_NO_ERROR и возврат (VALUE не трогает)
-- error_stub(billet, label, error_id) — метка label: VALUE = 0, ERROR = error_id, возврат

use compiler.abi
use compiler.gorn.backend

Tails = Box {
    skill succeeded(billet) {
        @executor = billet.executor
        billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
        out executor.ret(billet)
    }

    skill error_stub(billet, label, error_id) {
        @executor = billet.executor
        billet = executor.label(billet, label)
        billet = executor.load_immediate(billet, backend.VALUE, 0)
        billet = executor.load_immediate(billet, backend.ERROR, error_id)
        out executor.ret(billet)
    }
}
