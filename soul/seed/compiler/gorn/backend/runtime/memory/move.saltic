-- move — перенос значения региона в хранилище: rt_store_move(VALUE слово) ->
-- слово. Строка и группа — копией с пометкой FORWARDED у оригинала (общие
-- подобъекты не дублируются), Box — переездом: оригинал остаётся пересылкой до
-- конца региона. Обход — очередью пар (копия, оригинал) над HEAP_TOP ([ARG3, ARG4),
-- rt_store_floor = ARG4, чтобы страницы не легли на неё). Потом: индексы и
-- STORE_MARK у копий, степени входа внутри перевезённого (массив за очередью),
-- Кан по очереди (ещё массив) — не все сняты — цикл, ERROR_CYCLE_FORBIDDEN;
-- счётчики (+1 на каждое ребро из копии), пометка STORE_BOX_FREE у групп без Box
-- (с конца очереди: дети раньше родителей). Указатель хранилища, равный
-- rt_cycle_box, внутри перевозимого — ERROR_CYCLE_FORBIDDEN. Нехватка —
-- откат (пересылки сняты, ячейки отданы), ERROR_MEMORY_EXHAUSTED.
-- Команды — методами billet.executor (договор backend).
--
-- emit_store_copy(billet) — rt_store_copy(ARG7 адрес оригинала) -> ARG7 копия, пара в
--     очередь; rt_store_floor = место следующей пары ещё до взятия ячейки, чтобы
--     страница хранилища не легла на очередь
-- emit_store_visit_copy / _count / _peel / _rc / _boxfree(billet) — посетители проходов
-- emit_pairs_walk(billet, visitor, prefix) — обход всех копий очереди посетителем
-- emit_store_move(billet) — rt_store_move
-- emit_store_keep(billet) — rt_store_keep (перенос и карантин, если без рёбер —
--     внешняя переменная оборота always); rt_store_eternal (перенос и счётчик +1
--     навсегда — значение константы)

use compiler.abi
use compiler.memory.model
use compiler.gorn.backend
use compiler.gorn.backend.runtime.tails
use compiler.gorn.backend.runtime.memory.walk

skill emit_store_copy(billet) {
    @executor = billet.executor
    @words = billet.words
    billet = executor.label(billet, "rt_store_copy")
    billet = executor.add_immediate(billet, backend.SCRATCH0, backend.ARG4, words.bytes * 2)
    billet = executor.branch_less_unsigned(billet, backend.STORE_BOTTOM, backend.SCRATCH0, ".L_store_copy_full")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.STORE_FLOOR_LABEL, 0)
    billet = executor.store(billet, backend.SCRATCH0, backend.SCRATCH1, 0)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
    billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.store(billet, backend.ARG7, backend.STACK, words.bytes * 2)
    billet = walk.emit_object_size(billet, backend.VALUE, backend.ARG7)
    billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes)
    billet = executor.call(billet, "rt_store_cell")
    billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.load(billet, backend.ARG7, backend.STACK, words.bytes * 2)
    billet = executor.load(billet, backend.SCRATCH4, backend.STACK, words.bytes)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
    billet = executor.branch_nonzero(billet, backend.ERROR, ".L_store_copy_refused")
    billet = executor.load_immediate(billet, backend.SCRATCH1, 0)
    billet = executor.label(billet, ".L_store_copy_words")
    billet = executor.branch_equal(billet, backend.SCRATCH1, backend.SCRATCH4, ".L_store_copy_copied")
    billet = executor.add(billet, backend.SCRATCH2, backend.ARG7, backend.SCRATCH1)
    billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH2, 0)
    billet = executor.add(billet, backend.SCRATCH3, backend.VALUE, backend.SCRATCH1)
    billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH3, 0)
    billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, words.bytes)
    billet = executor.jump(billet, ".L_store_copy_words")
    billet = executor.label(billet, ".L_store_copy_copied")
    billet = executor.store_zero(billet, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.or_immediate(billet, backend.SCRATCH2, backend.VALUE, model.FORWARDED)
    billet = executor.store(billet, backend.SCRATCH2, backend.ARG7, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.store(billet, backend.VALUE, backend.ARG4, 0)
    billet = executor.store(billet, backend.ARG7, backend.ARG4, words.bytes)
    billet = executor.add_immediate(billet, backend.ARG4, backend.ARG4, words.bytes * 2)
    billet = executor.move(billet, backend.ARG7, backend.VALUE)
    billet = tails.ok(billet)
    billet = executor.label(billet, ".L_store_copy_refused")
    billet = executor.ret(billet)
    out tails.fail(billet, ".L_store_copy_full", abi.ERROR_MEMORY_EXHAUSTED)
}

skill emit_store_visit_copy(billet) {
    @executor = billet.executor
    @words = billet.words
    billet = executor.label(billet, "rt_store_visit_copy")
    billet = walk.emit_pointer_address(billet, ".L_visit_copy_done")
    billet = executor.branch_less_unsigned(billet, backend.SCRATCH2, backend.STORE_BOTTOM, ".L_visit_copy_region")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.CYCLE_BOX_LABEL, 0)
    billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH1, 0)
    billet = executor.branch_not_equal(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_visit_copy_done")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_ERROR_LABEL, 0)
    billet = executor.load_immediate(billet, backend.SCRATCH3, abi.ERROR_CYCLE_FORBIDDEN)
    billet = executor.store(billet, backend.SCRATCH3, backend.SCRATCH1, 0)
    billet = executor.ret(billet)
    billet = executor.label(billet, ".L_visit_copy_region")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.HEAP_START_LABEL, 0)
    billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH1, 0)
    billet = executor.branch_less_unsigned(billet, backend.SCRATCH2, backend.SCRATCH1, ".L_visit_copy_done")
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.and_immediate(billet, backend.SCRATCH1, backend.SCRATCH3, model.FORWARDED)
    billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_visit_copy_fresh")
    billet = executor.and_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, abi.PAYLOAD_MASK)
    billet = executor.or(billet, backend.ARG7, backend.SCRATCH3, backend.SCRATCH0)
    billet = executor.ret(billet)
    billet = executor.label(billet, ".L_visit_copy_fresh")
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
    billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
    billet = executor.move(billet, backend.ARG7, backend.SCRATCH2)
    billet = executor.call(billet, "rt_store_copy")
    billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
    billet = executor.branch_zero(billet, backend.ERROR, ".L_visit_copy_made")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_ERROR_LABEL, 0)
    billet = executor.store(billet, backend.ERROR, backend.SCRATCH1, 0)
    billet = executor.ret(billet)
    billet = executor.label(billet, ".L_visit_copy_made")
    billet = executor.or(billet, backend.ARG7, backend.ARG7, backend.SCRATCH0)
    billet = executor.label(billet, ".L_visit_copy_done")
    out executor.ret(billet)
}

skill emit_store_visit_count(billet) {
    @executor = billet.executor
    @words = billet.words
    billet = executor.label(billet, "rt_store_visit_count")
    billet = walk.emit_store_pointer(billet, ".L_visit_count_done")
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.and_immediate(billet, backend.SCRATCH1, backend.SCRATCH3, model.STORE_MARK)
    billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_visit_count_done")
    billet = executor.shift_right_unsigned(billet, backend.SCRATCH3, backend.SCRATCH3, model.STORE_RC_SHIFT)
    billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH3, words.shift)
    billet = executor.add(billet, backend.SCRATCH3, backend.ARG4, backend.SCRATCH3)
    billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH3, 0)
    billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 1)
    billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH3, 0)
    billet = executor.label(billet, ".L_visit_count_done")
    out executor.ret(billet)
}

skill emit_store_visit_peel(billet) {
    @executor = billet.executor
    @words = billet.words
    billet = executor.label(billet, "rt_store_visit_peel")
    billet = walk.emit_store_pointer(billet, ".L_visit_peel_done")
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.and_immediate(billet, backend.SCRATCH1, backend.SCRATCH3, model.STORE_MARK)
    billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_visit_peel_done")
    billet = executor.shift_right_unsigned(billet, backend.SCRATCH3, backend.SCRATCH3, model.STORE_RC_SHIFT)
    billet = executor.shift_left(billet, backend.SCRATCH4, backend.SCRATCH3, words.shift)
    billet = executor.add(billet, backend.SCRATCH4, backend.ARG4, backend.SCRATCH4)
    billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH4, 0)
    billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, -1)
    billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH4, 0)
    billet = executor.branch_nonzero(billet, backend.SCRATCH1, ".L_visit_peel_done")
    billet = executor.load_address(billet, backend.SCRATCH4, walk.REACH_END_LABEL, 0)
    billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH4, 0)
    billet = executor.store(billet, backend.SCRATCH3, backend.SCRATCH1, 0)
    billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, words.bytes)
    billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH4, 0)
    billet = executor.label(billet, ".L_visit_peel_done")
    out executor.ret(billet)
}

skill emit_store_visit_rc(billet) {
    @executor = billet.executor
    billet = executor.label(billet, "rt_store_visit_rc")
    billet = walk.emit_store_pointer(billet, ".L_visit_rc_done")
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, model.STORE_RC_UNIT)
    billet = executor.store(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.label(billet, ".L_visit_rc_done")
    out executor.ret(billet)
}

skill emit_store_visit_boxfree(billet) {
    @executor = billet.executor
    billet = executor.label(billet, "rt_store_visit_boxfree")
    billet = walk.emit_store_pointer(billet, ".L_visit_boxfree_done")
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.and_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, model.STORE_BOX_FREE)
    billet = executor.branch_nonzero(billet, backend.SCRATCH3, ".L_visit_boxfree_done")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_FLAG_LABEL, 0)
    billet = executor.store_zero(billet, backend.SCRATCH1, 0)
    billet = executor.label(billet, ".L_visit_boxfree_done")
    out executor.ret(billet)
}

skill emit_pairs_walk(billet, visitor, prefix) {
    @executor = billet.executor
    @words = billet.words
    @loop = "{prefix}_pairs"
    @done = "{prefix}_pairs_done"
    billet = executor.move(billet, backend.ARG5, backend.ARG3)
    billet = executor.label(billet, loop)
    billet = executor.branch_greater_equal_unsigned(billet, backend.ARG5, backend.ARG4, done)
    billet = executor.load(billet, backend.ERROR, backend.ARG5, 0)
    billet = walk.emit_object_walk(billet, visitor, "{prefix}_walk")
    billet = executor.add_immediate(billet, backend.ARG5, backend.ARG5, words.bytes * 2)
    billet = executor.jump(billet, loop)
    billet = executor.label(billet, done)
    out billet
}

skill emit_store_move(billet) {
    @executor = billet.executor
    @words = billet.words
    billet = executor.label(billet, "rt_store_move")
    billet = executor.move(billet, backend.ARG7, backend.VALUE)
    billet = walk.emit_region_pointer(billet, ".L_store_move_same")
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.and_immediate(billet, backend.SCRATCH1, backend.SCRATCH3, model.FORWARDED)
    billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_store_move_work")
    billet = executor.and_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, abi.PAYLOAD_MASK)
    billet = executor.or(billet, backend.VALUE, backend.SCRATCH3, backend.SCRATCH0)
    billet = executor.label(billet, ".L_store_move_same")
    billet = tails.ok(billet)
    billet = executor.label(billet, ".L_store_move_work")
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
    billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.store(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_ERROR_LABEL, 0)
    billet = executor.store_zero(billet, backend.SCRATCH1, 0)
    billet = executor.move(billet, backend.ARG3, backend.HEAP_TOP)
    billet = executor.move(billet, backend.ARG4, backend.HEAP_TOP)
    billet = executor.move(billet, backend.ARG7, backend.SCRATCH2)
    billet = executor.call(billet, "rt_store_copy")
    billet = executor.jump_if_nonzero(billet, backend.ERROR, ".L_store_move_refused")
    billet = executor.move(billet, backend.ARG5, backend.ARG3)
    billet = executor.label(billet, ".L_store_move_copying")
    billet = executor.branch_greater_equal_unsigned(billet, backend.ARG5, backend.ARG4, ".L_store_move_copied")
    billet = executor.load(billet, backend.ERROR, backend.ARG5, 0)
    billet = walk.emit_object_walk(billet, "rt_store_visit_copy", ".L_store_move_copy")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_ERROR_LABEL, 0)
    billet = executor.load(billet, backend.ERROR, backend.SCRATCH1, 0)
    billet = executor.jump_if_nonzero(billet, backend.ERROR, ".L_store_move_undo")
    billet = executor.add_immediate(billet, backend.ARG5, backend.ARG5, words.bytes * 2)
    billet = executor.jump(billet, ".L_store_move_copying")
    billet = executor.label(billet, ".L_store_move_copied")
    billet = executor.sub(billet, backend.SCRATCH3, backend.ARG4, backend.ARG3)
    billet = executor.shift_right_unsigned(billet, backend.SCRATCH3, backend.SCRATCH3, 1)
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_BYTES_LABEL, 0)
    billet = executor.store(billet, backend.SCRATCH3, backend.SCRATCH1, 0)
    billet = executor.add(billet, backend.SCRATCH4, backend.ARG4, backend.SCRATCH3)
    billet = executor.add(billet, backend.SCRATCH4, backend.SCRATCH4, backend.SCRATCH3)
    billet = executor.load_immediate(billet, backend.ERROR, abi.ERROR_MEMORY_EXHAUSTED)
    billet = executor.set_less_unsigned(billet, backend.SCRATCH1, backend.STORE_BOTTOM, backend.SCRATCH4)
    billet = executor.jump_if_nonzero(billet, backend.SCRATCH1, ".L_store_move_undo")
    billet = executor.move(billet, backend.ARG5, backend.ARG3)
    billet = executor.move(billet, backend.SCRATCH4, backend.ARG4)
    billet = executor.load_immediate(billet, backend.SCRATCH3, model.STORE_MARK)
    billet = executor.label(billet, ".L_store_move_index")
    billet = executor.branch_greater_equal_unsigned(billet, backend.ARG5, backend.ARG4, ".L_store_move_indexed")
    billet = executor.load(billet, backend.SCRATCH0, backend.ARG5, 0)
    billet = executor.store(billet, backend.SCRATCH3, backend.SCRATCH0, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.store_zero(billet, backend.SCRATCH4, 0)
    billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, model.STORE_RC_UNIT)
    billet = executor.add_immediate(billet, backend.SCRATCH4, backend.SCRATCH4, words.bytes)
    billet = executor.add_immediate(billet, backend.ARG5, backend.ARG5, words.bytes * 2)
    billet = executor.jump(billet, ".L_store_move_index")
    billet = executor.label(billet, ".L_store_move_indexed")
    billet = emit_pairs_walk(billet, "rt_store_visit_count", ".L_store_move_count")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_ERROR_LABEL, 0)
    billet = executor.load(billet, backend.ERROR, backend.SCRATCH1, 0)
    billet = executor.jump_if_nonzero(billet, backend.ERROR, ".L_store_move_undo")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_BYTES_LABEL, 0)
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH1, 0)
    billet = executor.add(billet, backend.SCRATCH4, backend.ARG4, backend.SCRATCH3)
    billet = executor.load_address(billet, backend.SCRATCH1, walk.REACH_END_LABEL, 0)
    billet = executor.store(billet, backend.SCRATCH4, backend.SCRATCH1, 0)
    billet = executor.load(billet, backend.SCRATCH0, backend.ARG4, 0)
    billet = executor.jump_if_nonzero(billet, backend.SCRATCH0, ".L_store_move_cycle")
    billet = executor.store_zero(billet, backend.SCRATCH4, 0)
    billet = executor.add_immediate(billet, backend.SCRATCH4, backend.SCRATCH4, words.bytes)
    billet = executor.store(billet, backend.SCRATCH4, backend.SCRATCH1, 0)
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_BYTES_LABEL, 0)
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH1, 0)
    billet = executor.add(billet, backend.ARG6, backend.ARG4, backend.SCRATCH3)
    billet = executor.label(billet, ".L_store_move_peel")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.REACH_END_LABEL, 0)
    billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH1, 0)
    billet = executor.branch_greater_equal_unsigned(billet, backend.ARG6, backend.SCRATCH1, ".L_store_move_peeled")
    billet = executor.load(billet, backend.SCRATCH0, backend.ARG6, 0)
    billet = executor.add_immediate(billet, backend.ARG6, backend.ARG6, words.bytes)
    billet = executor.shift_left(billet, backend.SCRATCH0, backend.SCRATCH0, words.shift + 1)
    billet = executor.add(billet, backend.SCRATCH0, backend.ARG3, backend.SCRATCH0)
    billet = executor.load(billet, backend.ERROR, backend.SCRATCH0, 0)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 2)
    billet = executor.store(billet, backend.ARG6, backend.STACK, 0)
    billet = walk.emit_object_walk(billet, "rt_store_visit_peel", ".L_store_move_peel_walk")
    billet = executor.load(billet, backend.ARG6, backend.STACK, 0)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 2)
    billet = executor.jump(billet, ".L_store_move_peel")
    billet = executor.label(billet, ".L_store_move_peeled")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_BYTES_LABEL, 0)
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH1, 0)
    billet = executor.add(billet, backend.SCRATCH3, backend.ARG4, backend.SCRATCH3)
    billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH3, backend.SCRATCH3)
    billet = executor.sub(billet, backend.SCRATCH3, backend.SCRATCH3, backend.ARG4)
    billet = executor.jump_if_not_equal(billet, backend.ARG6, backend.SCRATCH3, ".L_store_move_cycle")
    billet = executor.move(billet, backend.ARG5, backend.ARG3)
    billet = executor.label(billet, ".L_store_move_zero")
    billet = executor.branch_greater_equal_unsigned(billet, backend.ARG5, backend.ARG4, ".L_store_move_zeroed")
    billet = executor.load(billet, backend.SCRATCH0, backend.ARG5, 0)
    billet = executor.store_zero(billet, backend.SCRATCH0, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.add_immediate(billet, backend.ARG5, backend.ARG5, words.bytes * 2)
    billet = executor.jump(billet, ".L_store_move_zero")
    billet = executor.label(billet, ".L_store_move_zeroed")
    billet = emit_pairs_walk(billet, "rt_store_visit_rc", ".L_store_move_rc")
    billet = executor.move(billet, backend.ARG5, backend.ARG4)
    billet = executor.label(billet, ".L_store_move_boxfree")
    billet = executor.branch_greater_equal_unsigned(billet, backend.ARG3, backend.ARG5, ".L_store_move_done")
    billet = executor.add_immediate(billet, backend.ARG5, backend.ARG5, -words.bytes * 2)
    billet = executor.load(billet, backend.ERROR, backend.ARG5, 0)
    billet = executor.load32(billet, backend.SCRATCH0, backend.ERROR, abi.OBJECT_HEADER_KIND_OFFSET)
    billet = executor.load_immediate(billet, backend.SCRATCH1, abi.OBJECT_KIND_BOX)
    billet = executor.branch_equal(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_store_move_boxfree")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_FLAG_LABEL, 0)
    billet = executor.load_immediate(billet, backend.SCRATCH0, 1)
    billet = executor.store(billet, backend.SCRATCH0, backend.SCRATCH1, 0)
    billet = walk.emit_object_walk(billet, "rt_store_visit_boxfree", ".L_store_move_boxfree_walk")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.MOVE_FLAG_LABEL, 0)
    billet = executor.load(billet, backend.SCRATCH0, backend.SCRATCH1, 0)
    billet = executor.branch_zero(billet, backend.SCRATCH0, ".L_store_move_boxfree")
    billet = executor.load(billet, backend.SCRATCH0, backend.ERROR, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.or_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, model.STORE_BOX_FREE)
    billet = executor.store(billet, backend.SCRATCH0, backend.ERROR, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.jump(billet, ".L_store_move_boxfree")
    billet = executor.label(billet, ".L_store_move_done")
    billet = executor.load(billet, backend.VALUE, backend.ARG3, 0)
    billet = executor.load(billet, backend.SCRATCH0, backend.STACK, words.bytes * 2)
    billet = executor.or(billet, backend.VALUE, backend.VALUE, backend.SCRATCH0)
    billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
    billet = executor.jump(billet, ".L_store_move_return")
    billet = executor.label(billet, ".L_store_move_cycle")
    billet = executor.load_immediate(billet, backend.ERROR, abi.ERROR_CYCLE_FORBIDDEN)
    billet = executor.label(billet, ".L_store_move_undo")
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 2)
    billet = executor.store(billet, backend.ERROR, backend.STACK, 0)
    billet = executor.move(billet, backend.ARG5, backend.ARG3)
    billet = executor.label(billet, ".L_store_move_undo_loop")
    billet = executor.branch_greater_equal_unsigned(billet, backend.ARG5, backend.ARG4, ".L_store_move_undone")
    billet = executor.load(billet, backend.SCRATCH0, backend.ARG5, words.bytes)
    billet = executor.store_zero(billet, backend.SCRATCH0, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.load(billet, backend.VALUE, backend.ARG5, 0)
    billet = executor.call(billet, "rt_store_free")
    billet = executor.add_immediate(billet, backend.ARG5, backend.ARG5, words.bytes * 2)
    billet = executor.jump(billet, ".L_store_move_undo_loop")
    billet = executor.label(billet, ".L_store_move_undone")
    billet = executor.load(billet, backend.ERROR, backend.STACK, 0)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 2)
    billet = executor.label(billet, ".L_store_move_refused")
    billet = executor.load_immediate(billet, backend.VALUE, 0)
    billet = executor.label(billet, ".L_store_move_return")
    billet = executor.load_address(billet, backend.SCRATCH1, walk.STORE_FLOOR_LABEL, 0)
    billet = executor.store_zero(billet, backend.SCRATCH1, 0)
    billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
    out executor.ret(billet)
}

skill emit_store_keep(billet) {
    @executor = billet.executor
    @words = billet.words
    billet = executor.label(billet, "rt_store_keep")
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
    billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.load_address(billet, backend.SCRATCH1, walk.CYCLE_BOX_LABEL, 0)
    billet = executor.store_zero(billet, backend.SCRATCH1, 0)
    billet = executor.call(billet, "rt_store_move")
    billet = executor.branch_nonzero(billet, backend.ERROR, ".L_store_keep_return")
    billet = executor.move(billet, backend.ARG7, backend.VALUE)
    billet = walk.emit_store_pointer(billet, ".L_store_keep_return")
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.shift_right_unsigned(billet, backend.SCRATCH1, backend.SCRATCH3, model.STORE_RC_SHIFT)
    billet = executor.branch_nonzero(billet, backend.SCRATCH1, ".L_store_keep_return")
    billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes)
    billet = executor.move(billet, backend.VALUE, backend.SCRATCH2)
    billet = executor.call(billet, "rt_quarantine_add")
    billet = executor.load(billet, backend.VALUE, backend.STACK, words.bytes)
    billet = executor.label(billet, ".L_store_keep_return")
    billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
    billet = executor.ret(billet)
    billet = executor.label(billet, "rt_store_eternal")
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
    billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.load_address(billet, backend.SCRATCH1, walk.CYCLE_BOX_LABEL, 0)
    billet = executor.store_zero(billet, backend.SCRATCH1, 0)
    billet = executor.call(billet, "rt_store_move")
    billet = executor.branch_nonzero(billet, backend.ERROR, ".L_store_eternal_return")
    billet = executor.move(billet, backend.ARG7, backend.VALUE)
    billet = walk.emit_store_pointer(billet, ".L_store_eternal_return")
    billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, model.STORE_RC_UNIT)
    billet = executor.store(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    billet = executor.label(billet, ".L_store_eternal_return")
    billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
    billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
    out executor.ret(billet)
}
