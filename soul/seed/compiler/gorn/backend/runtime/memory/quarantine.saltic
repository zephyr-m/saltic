-- quarantine — карантин хранилища: объекты без рёбер хранилище → хранилище
-- (счётчик 0), которые ещё могут держать слоты стека или объекты живой кучи.
-- Страницы [следующая, занято, записи (адрес, подсказка)…] с низа хранилища.
-- Разбор при каждом выходе региона (rt_region_exit → rt_quarantine_sweep): не
-- больше rt_sweep_batch (QUARANTINE_BATCH) записей за раз, по кругу от курсора
-- (rt_sweep_page / rt_sweep_index), не больше одного круга; записи, добавленные
-- каскадом во время разбора, входят в тот же круг. rt_quarantine_drain —
-- разбор до конца (круги, пока записи убывают; стек — от текущего STACK), зовёт
-- rt_store_pages при отказе: единственный путь без границы времени — восстановление
-- после нехватки. rt_sweep_busy — страж повторного входа. Запись: счётчик стал больше нуля —
-- снята; держатель есть (значение out, слово стека [ARG3 выхода, rt_stack_base)
-- или живой кучи [heap_start, HEAP_TOP); куча больше QUARANTINE_HEAP_SCAN_WORDS слов —
-- объект считается удержанным без сканирования) — остаётся, с подсказкой «где нашли» для
-- следующего раза; иначе объект освобождается: у детей счётчик −1, ноль — в
-- карантин (место обеспечивается заранее, нет места — объект ждёт).
-- Команды — методами billet.executor (договор backend).
--
-- emit_quarantine(billet) — rt_quarantine_ensure(VALUE мест) / rt_quarantine_add(VALUE
--     адрес) и остальные метки: rt_quarantine_held(VALUE адрес, ERROR запись) -> 1/0,
--     rt_store_release(VALUE адрес) — освободить с каскадом, rt_quarantine_sweep
-- emit_store_visit_drop(billet) — посетитель освобождения (счётчик −1 у детей)
-- quarantine_entries / quarantine_capacity(words) — раскладка страницы

use compiler.contract.abi
use compiler.gorn.memory.model
use compiler.gorn.backend
use compiler.gorn.backend.runtime.tails
use compiler.gorn.backend.runtime.memory.walk

DRAIN_BATCH = 268435455

Quarantine = Box {
    endings = tails.Tails {},
    walks = walk.Walk {}

    skill quarantine_entries(words) {
        out words.bytes * 2
    }

    skill quarantine_capacity(words) {
        out (model.STORE_PAGE_BYTES - quarantine_entries(words)) / (words.bytes * 2)
    }

    skill emit_store_visit_drop(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_store_visit_drop")
        billet = walks.emit_store_pointer(billet, ".L_visit_drop_done")
        billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
        billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, -model.STORE_RC_UNIT)
        billet = executor.store(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
        billet = executor.shift_right_unsigned(billet, backend.SCRATCH1, backend.SCRATCH3, model.STORE_RC_SHIFT)
        billet = executor.branch_nonzero(billet, backend.SCRATCH1, ".L_visit_drop_done")
        billet = executor.and_immediate(billet, backend.SCRATCH1, backend.SCRATCH3, model.STORE_QUARANTINED)
        billet = executor.branch_nonzero(billet, backend.SCRATCH1, ".L_visit_drop_done")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.ARG7, backend.STACK, words.bytes * 2)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes)
        billet = executor.move(billet, backend.VALUE, backend.SCRATCH2)
        billet = executor.call(billet, "rt_quarantine_add")
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.load(billet, backend.ARG7, backend.STACK, words.bytes * 2)
        billet = executor.load(billet, backend.VALUE, backend.STACK, words.bytes)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.label(billet, ".L_visit_drop_done")
        out executor.ret(billet)
    }

    skill emit_quarantine(billet) {
        @executor = billet.executor
        @words = billet.words
        @entries = quarantine_entries(words)
        @capacity = quarantine_capacity(words)
        billet = executor.label(billet, "rt_quarantine_ensure")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_quarantine_grow")
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
        billet = executor.add(billet, backend.SCRATCH2, backend.SCRATCH2, backend.VALUE)
        billet = executor.load_immediate(billet, backend.SCRATCH3, capacity)
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH3, backend.SCRATCH2, ".L_quarantine_grow")
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_quarantine_grow")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.load_immediate(billet, backend.VALUE, 1)
        billet = executor.call(billet, "rt_store_pages")
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_quarantine_refused")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.store(billet, backend.SCRATCH1, backend.VALUE, 0)
        billet = executor.store_zero(billet, backend.VALUE, words.bytes)
        billet = executor.store(billet, backend.VALUE, backend.SCRATCH0, 0)
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_quarantine_refused")
        billet = executor.ret(billet)

        billet = executor.label(billet, "rt_quarantine_add")
        billet = executor.load(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
        billet = executor.and_immediate(billet, backend.SCRATCH1, backend.SCRATCH3, model.STORE_QUARANTINED)
        billet = executor.branch_nonzero(billet, backend.SCRATCH1, ".L_quarantine_added")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.load_immediate(billet, backend.VALUE, 1)
        billet = executor.call(billet, "rt_quarantine_ensure")
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.load(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_quarantine_add_refused")
        billet = executor.load(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
        billet = executor.or_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, model.STORE_QUARANTINED)
        billet = executor.store(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH2, words.shift + 1)
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH1, backend.SCRATCH3)
        billet = executor.store(billet, backend.VALUE, backend.SCRATCH3, entries)
        billet = executor.store_zero(billet, backend.SCRATCH3, entries + words.bytes)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, 1)
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 1)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BUSY_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_quarantine_added")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_LEFT_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 1)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.label(billet, ".L_quarantine_added")
        billet = endings.succeeded(billet)
        billet = executor.label(billet, ".L_quarantine_add_refused")
        billet = executor.ret(billet)

        billet = emit_quarantine_held(billet)
        billet = emit_store_release(billet)
        out emit_quarantine_sweep(billet)
    }

    skill emit_quarantine_held(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_quarantine_held")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_VALUE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH0, backend.SCRATCH0, 0)
        billet = executor.and_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, abi.PAYLOAD_MASK)
        billet = executor.branch_equal(billet, backend.SCRATCH0, backend.VALUE, ".L_held_yes_plain")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_FROM_LABEL, 0)
        billet = executor.load(billet, backend.ARG6, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.STACK_BASE_LABEL, 0)
        billet = executor.load(billet, backend.ARG7, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.HEAP_START_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH4, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.ERROR, words.bytes)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_held_scan_stack")
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH1, backend.ARG6, ".L_held_hint_heap")
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH1, backend.ARG7, ".L_held_hint_heap")
        billet = executor.jump(billet, ".L_held_hint_check")
        billet = executor.label(billet, ".L_held_hint_heap")
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH1, backend.SCRATCH4, ".L_held_scan_stack")
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH1, backend.HEAP_TOP, ".L_held_scan_stack")
        billet = executor.label(billet, ".L_held_hint_check")
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH1, 0)
        billet = executor.and_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, abi.PAYLOAD_MASK)
        billet = executor.branch_equal(billet, backend.SCRATCH2, backend.VALUE, ".L_held_yes_plain")
        billet = executor.label(billet, ".L_held_scan_stack")
        billet = executor.sub(billet, backend.SCRATCH2, backend.HEAP_TOP, backend.SCRATCH4)
        billet = executor.load_immediate(billet, backend.SCRATCH3, model.QUARANTINE_HEAP_SCAN_WORDS * words.bytes)
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH3, backend.SCRATCH2, ".L_held_yes_plain")
        billet = executor.move(billet, backend.SCRATCH1, backend.ARG6)
        billet = executor.label(billet, ".L_held_stack")
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH1, backend.ARG7, ".L_held_scan_heap")
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH1, 0)
        billet = executor.and_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, abi.PAYLOAD_MASK)
        billet = executor.branch_equal(billet, backend.SCRATCH2, backend.VALUE, ".L_held_yes")
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, words.bytes)
        billet = executor.jump(billet, ".L_held_stack")
        billet = executor.label(billet, ".L_held_scan_heap")
        billet = executor.move(billet, backend.SCRATCH1, backend.SCRATCH4)
        billet = executor.label(billet, ".L_held_heap")
        billet = executor.branch_greater_equal_unsigned(billet, backend.SCRATCH1, backend.HEAP_TOP, ".L_held_no")
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH1, 0)
        billet = executor.and_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, abi.PAYLOAD_MASK)
        billet = executor.branch_equal(billet, backend.SCRATCH2, backend.VALUE, ".L_held_yes")
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, words.bytes)
        billet = executor.jump(billet, ".L_held_heap")
        billet = executor.label(billet, ".L_held_yes")
        billet = executor.store(billet, backend.SCRATCH1, backend.ERROR, words.bytes)
        billet = executor.label(billet, ".L_held_yes_plain")
        billet = executor.load_immediate(billet, backend.VALUE, 1)
        billet = executor.ret(billet)
        billet = executor.label(billet, ".L_held_no")
        billet = executor.load_immediate(billet, backend.VALUE, 0)
        out executor.ret(billet)
    }

    skill emit_store_release(billet) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.label(billet, "rt_store_release")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.store(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.load32(billet, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load_immediate(billet, backend.SCRATCH1, abi.OBJECT_KIND_STRING)
        billet = executor.load_immediate(billet, backend.SCRATCH2, 0)
        billet = executor.branch_equal(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_release_counted")
        billet = executor.load_immediate(billet, backend.SCRATCH1, abi.OBJECT_KIND_TREE)
        billet = executor.load_immediate(billet, backend.SCRATCH2, 2)
        billet = executor.branch_equal(billet, backend.SCRATCH0, backend.SCRATCH1, ".L_release_counted")
        billet = executor.load(billet, backend.SCRATCH2, backend.VALUE, words.payload)
        billet = executor.label(billet, ".L_release_counted")
        billet = executor.move(billet, backend.VALUE, backend.SCRATCH2)
        billet = executor.call(billet, "rt_quarantine_ensure")
        billet = executor.load(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.branch_nonzero(billet, backend.ERROR, ".L_release_return")
        billet = executor.move(billet, backend.ERROR, backend.VALUE)
        billet = walks.emit_object_walk(billet, "rt_store_visit_drop", ".L_release")
        billet = executor.load(billet, backend.VALUE, backend.STACK, words.bytes * 2)
        billet = executor.call(billet, "rt_store_free")
        billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
        billet = executor.label(billet, ".L_release_return")
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        out executor.ret(billet)
    }

    skill emit_quarantine_sweep(billet) {
        @executor = billet.executor
        @words = billet.words
        @entries = quarantine_entries(words)
        billet = executor.label(billet, "rt_quarantine_sweep")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.branch_nonzero(billet, backend.SCRATCH1, ".L_sweep_start")
        billet = executor.ret(billet)
        billet = executor.label(billet, ".L_sweep_start")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BUSY_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH0, 0)
        billet = executor.branch_zero(billet, backend.SCRATCH2, ".L_sweep_begin")
        billet = executor.ret(billet)
        billet = executor.label(billet, ".L_sweep_begin")
        billet = executor.load_immediate(billet, backend.SCRATCH2, 1)
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH0, 0)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 4)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_LEFT_LABEL, 0)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BATCH_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BUDGET_LABEL, 0)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.branch_nonzero(billet, backend.SCRATCH1, ".L_sweep_next")
        billet = executor.label(billet, ".L_sweep_top")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_PREV_LABEL, 0)
        billet = executor.store_zero(billet, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_INDEX_LABEL, 0)
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH0, 0)
        billet = executor.label(billet, ".L_sweep_next")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BUDGET_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.jump_if_zero(billet, backend.SCRATCH1, ".L_sweep_done")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_LEFT_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.jump_if_zero(billet, backend.SCRATCH1, ".L_sweep_done")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.jump_if_zero(billet, backend.SCRATCH1, ".L_sweep_top")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_INDEX_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH1, words.bytes)
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH3, backend.SCRATCH2, ".L_sweep_page_end")
        billet = executor.branch_zero(billet, backend.SCRATCH2, ".L_sweep_page_end")
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, -1)
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH0, 0)
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH2, words.shift + 1)
        billet = executor.add(billet, backend.SCRATCH3, backend.SCRATCH1, backend.SCRATCH3)
        billet = executor.add_immediate(billet, backend.SCRATCH3, backend.SCRATCH3, entries)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_ENTRY_LABEL, 0)
        billet = executor.store(billet, backend.SCRATCH3, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_LEFT_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, -1)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BUDGET_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, -1)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.VALUE, backend.SCRATCH3, 0)
        billet = executor.load(billet, backend.SCRATCH4, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
        billet = executor.shift_right_unsigned(billet, backend.SCRATCH1, backend.SCRATCH4, model.STORE_RC_SHIFT)
        billet = executor.branch_nonzero(billet, backend.SCRATCH1, ".L_sweep_referenced")
        billet = executor.move(billet, backend.ERROR, backend.SCRATCH3)
        billet = executor.call(billet, "rt_quarantine_held")
        billet = executor.jump_if_nonzero(billet, backend.VALUE, ".L_sweep_next")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_ENTRY_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.VALUE, backend.SCRATCH3, 0)
        billet = executor.call(billet, "rt_store_release")
        billet = executor.jump_if_nonzero(billet, backend.ERROR, ".L_sweep_next")
        billet = executor.jump(billet, ".L_sweep_remove")
        billet = executor.label(billet, ".L_sweep_referenced")
        billet = executor.and_immediate(billet, backend.SCRATCH4, backend.SCRATCH4, -model.STORE_QUARANTINED - 1)
        billet = executor.store(billet, backend.SCRATCH4, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
        billet = executor.label(billet, ".L_sweep_remove")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_ENTRY_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
        billet = executor.add_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, -1)
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
        billet = executor.shift_left(billet, backend.SCRATCH4, backend.SCRATCH2, words.shift + 1)
        billet = executor.add(billet, backend.SCRATCH4, backend.SCRATCH1, backend.SCRATCH4)
        billet = executor.load(billet, backend.SCRATCH0, backend.SCRATCH4, entries)
        billet = executor.store(billet, backend.SCRATCH0, backend.SCRATCH3, 0)
        billet = executor.load(billet, backend.SCRATCH0, backend.SCRATCH4, entries + words.bytes)
        billet = executor.store(billet, backend.SCRATCH0, backend.SCRATCH3, words.bytes)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, -1)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.jump(billet, ".L_sweep_next")
        billet = executor.label(billet, ".L_sweep_page_end")
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH1, 0)
        billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH1, words.bytes)
        billet = executor.branch_nonzero(billet, backend.SCRATCH3, ".L_sweep_page_kept")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_PREV_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH0, 0)
        billet = executor.branch_nonzero(billet, backend.SCRATCH3, ".L_sweep_page_unlink")
        billet = executor.branch_zero(billet, backend.SCRATCH2, ".L_sweep_page_kept")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH0, 0)
        billet = executor.branch_not_equal(billet, backend.SCRATCH3, backend.SCRATCH1, ".L_sweep_page_kept")
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH0, 0)
        billet = executor.jump(billet, ".L_sweep_page_free")
        billet = executor.label(billet, ".L_sweep_page_unlink")
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH3, 0)
        billet = executor.label(billet, ".L_sweep_page_free")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 2)
        billet = executor.store(billet, backend.SCRATCH2, backend.STACK, 0)
        billet = executor.move(billet, backend.VALUE, backend.SCRATCH1)
        billet = executor.load_immediate(billet, backend.ERROR, 1)
        billet = executor.call(billet, "rt_store_release_pages")
        billet = executor.load(billet, backend.SCRATCH2, backend.STACK, 0)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 2)
        billet = executor.jump(billet, ".L_sweep_page_moved")
        billet = executor.label(billet, ".L_sweep_page_kept")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_PREV_LABEL, 0)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.label(billet, ".L_sweep_page_moved")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
        billet = executor.store(billet, backend.SCRATCH2, backend.SCRATCH0, 0)
        billet = executor.jump_if_zero(billet, backend.SCRATCH2, ".L_sweep_next")
        billet = executor.load(billet, backend.SCRATCH3, backend.SCRATCH2, words.bytes)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_INDEX_LABEL, 0)
        billet = executor.store(billet, backend.SCRATCH3, backend.SCRATCH0, 0)
        billet = executor.jump(billet, ".L_sweep_next")
        billet = executor.label(billet, ".L_sweep_done")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BUSY_LABEL, 0)
        billet = executor.store_zero(billet, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 3)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 4)
        billet = executor.ret(billet)
        billet = executor.label(billet, "rt_quarantine_drain")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BUSY_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_drain_begin")
        billet = executor.ret(billet)
        billet = executor.label(billet, ".L_drain_begin")
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, -words.bytes * 8)
        billet = executor.store(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.store(billet, backend.ARG2, backend.STACK, words.bytes * 6)
        billet = executor.store(billet, backend.ARG5, backend.STACK, words.bytes * 5)
        billet = executor.store(billet, backend.ARG6, backend.STACK, words.bytes * 4)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.WALK_STRIDE_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes * 3)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_FROM_LABEL, 0)
        billet = executor.store(billet, backend.STACK, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_VALUE_LABEL, 0)
        billet = executor.store_zero(billet, backend.SCRATCH0, 0)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BATCH_LABEL, 0)
        billet = executor.load_immediate(billet, backend.SCRATCH1, DRAIN_BATCH)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.label(billet, ".L_drain_round")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.branch_zero(billet, backend.SCRATCH1, ".L_drain_done")
        billet = executor.store(billet, backend.SCRATCH1, backend.STACK, words.bytes * 2)
        billet = executor.call(billet, "rt_quarantine_sweep")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.SCRATCH2, backend.STACK, words.bytes * 2)
        billet = executor.branch_less_unsigned(billet, backend.SCRATCH1, backend.SCRATCH2, ".L_drain_round")
        billet = executor.label(billet, ".L_drain_done")
        billet = executor.load_address(billet, backend.SCRATCH0, walk.SWEEP_BATCH_LABEL, 0)
        billet = executor.load_immediate(billet, backend.SCRATCH1, model.QUARANTINE_BATCH)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.SCRATCH1, backend.STACK, words.bytes * 3)
        billet = executor.load_address(billet, backend.SCRATCH0, walk.WALK_STRIDE_LABEL, 0)
        billet = executor.store(billet, backend.SCRATCH1, backend.SCRATCH0, 0)
        billet = executor.load(billet, backend.ARG6, backend.STACK, words.bytes * 4)
        billet = executor.load(billet, backend.ARG5, backend.STACK, words.bytes * 5)
        billet = executor.load(billet, backend.ARG2, backend.STACK, words.bytes * 6)
        billet = executor.load(billet, backend.RETURN, backend.STACK, words.bytes * 7)
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, words.bytes * 8)
        out executor.ret(billet)
    }
}
