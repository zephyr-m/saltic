-- emitters — мелкие кусочки кода для codegen: литералы, поля Box, сравнения,
-- строки в rodata, локальные переменные, быстрые пути.
-- Каждый навык берёт и отдаёт compiler; команды — методами billet.executor
-- (договор backend); значение — в VALUE, ERROR = CALL_NO_ERROR после
-- emit_word_result. Строки складываются в rodata один раз (string_find).
--
-- negative_literal / constant_literal / fixed_literal(node) -> yes/no — узел
--     есть константа (число, -число, answer, none; fixed — и wide-number)
-- immediate_operand / simple_operand / number_operand(billet, node) -> yes/no;
--     number_tags(billet, left, right) — тег NUMBER у VALUE и ERROR, иначе TypeMismatch
-- emit_field_get / emit_field_set(billet, name) — rt_box_get / rt_box_set; после
--     чтения ошибка (EmptyTouched, MissingField) уходит в failure навыка
-- subject_field(billet, name) -> yes: не локальная, а поле Box метода; load_subject_field /
--     store_subject_field(billet, name) — чтение и запись (значение в VALUE) через $self
-- emit_word_result(billet) — ERROR = CALL_NO_ERROR; emit_answer_from_bit — бит VALUE → yes/no
-- emit_number_less(billet, smaller, larger) / emit_word_equal(billet) — роли
-- emit_number_not_less(billet, smaller, larger) — «не меньше» для >= и <=
-- flip_answer(billet) — yes ↔ no в VALUE (после rt_fixed_less / greater)
-- pack_call(billet, stored) — rt_fixed_pack фиксированного в VALUE (проверку ошибки
--     ставит codegen); load_fraction(billet, text) — слово литерала (abi.fraction);
--     fraction_binary(billet, operator) — rt_fraction_* над VALUE и ERROR;
--     fraction_pair(billet, left, right) -> yes, если хоть один операнд дробный;
--     negate(billet, type) — унарный минус над VALUE: число, дробное, фиксированный (Q-025)
-- emit_equal_fast_path(billet) — равные слова без вызова, иначе rt_value_equal
-- jump_unless_yes(billet, label) — переход, если VALUE — no, none или 0;
--     jump_by_link(billet, sign, label) — после левого звена: ○ — переход,
--     если VALUE не yes (ответ no), ○○ — если yes (ответ yes)
-- string_find(billet, text) -> Symbol; string_label(billet, text) -> метка
-- static_group(items) -> yes: непустая, вся из constant_literal; load_static_group —
--     её адрес в VALUE, сама группа — данными в rodata (group_label -> метка)
-- emit_string_join(billet) — rt_string_add для "{…}"
-- on_error / fail_jump(billet) — на ошибку (если ERROR / всегда): у навыка со
--     слотом FAIL_LINE — через заглушку stub (строка оператора в FAIL_LINE, потом
--     текущая метка failure; одна на пару строка + метка), иначе прямо; emit_stubs(billet) — все заглушки
--     навыка, после его тела
-- load_number / load_number_into(billet, [role,] number) — число с тегом
-- load_simple(billet, node, role) / load_fixed_literal(billet, value)
-- store_local(billet, name, value) — запись в слот и вывод типа
-- store_box(billet, field_ids, type_number) — rt_alloc Box из значений на стеке

use core.str
use core.group
use core.num
use compiler.abi
use compiler.ast
use compiler.gorn.state
use compiler.gorn.constants
use compiler.gorn.backend
use compiler.machine.word
use compiler.machine.wide
use compiler.abi.fraction
use compiler.intrinsic.contract
use compiler.gorn.codegen.lookup

skill negative_literal(node) {
    @plain = ast.plain(node)
    (group.get(plain, 0) == "binary") {
        (group.get(plain, 1) == "-") {
            @left = ast.plain(group.get(plain, 2))
            @right = ast.plain(group.get(plain, 3))
            (group.get(left, 0) == "number") {
                (group.get(left, 1) == 0) { out group.get(right, 0) == "number" }
            }
        }
    }
    out no
}

skill constant_literal(node) {
    @tag = ast.tag(node)
    (tag == "number") { out yes }
    (negative_literal(node) == yes) { out yes }
    (tag == "answer") { out yes }
    (tag == "none") { out yes }
    out no
}

skill number_operand(billet, node) {
    (ast.tag(node) == "number") { out yes }
    (negative_literal(node) == yes) { out yes }
    (lookup.infer_type(billet, node) == "number") { out yes }
    @parts = ast.plain(node)
    (group.get(parts, 0) == "path") {
        @billet_current_function_slots = billet.current_function.slots
        (billet_current_function_slots.has(group.get(parts, 1)) == yes) { out no }
        @billet_constants = billet.constants
        @constant = billet_constants.find(lookup.resolve_symbol(billet, billet.constants, ast.path_text(parts)))
        (str.bytes(constant.name) == 0) { out no }
        (ast.tag(constant.node) == "number") { out yes }
        out negative_literal(constant.node)
    }
    out no
}

skill number_tags(billet, left_number, right_number) {
    (left_number == yes) {
        (right_number == yes) { out billet }
    }
    @executor = billet.executor
    @ok = billet.fresh_label("number_tags")
    pick {
        (left_number == yes) { billet = executor.and_immediate(billet, backend.SCRATCH0, backend.ERROR, abi.TAG_MASK) }
        (right_number == yes) { billet = executor.and_immediate(billet, backend.SCRATCH0, backend.VALUE, abi.TAG_MASK) }
        {
            billet = executor.or(billet, backend.SCRATCH0, backend.VALUE, backend.ERROR)
            billet = executor.and_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, abi.TAG_MASK)
        }
    }
    billet = executor.jump_if_zero(billet, backend.SCRATCH0, ok)
    billet = executor.load_immediate(billet, backend.VALUE, 0)
    billet = executor.load_immediate(billet, backend.ERROR, abi.ERROR_TYPE_MISMATCH)
    billet = fail_jump(billet)
    out executor.label(billet, ok)
}

skill stub(billet) {
    drum (billet.current_function.stubs) {
        (beat.line == billet.current_function.line) {
            (beat.target == billet.current_function.failure) { out beat.label }
        }
    }
    @made = billet.fresh_label("fail_line")
    billet.current_function.stubs = group.add(billet.current_function.stubs, state.Stub { label = made, line = billet.current_function.line, target = billet.current_function.failure })
    out made
}

skill on_error(billet) {
    @executor = billet.executor
    (str.bytes(billet.current_function.failure) == 0) { out billet }
    (billet.current_function.lined == no) { out executor.jump_if_nonzero(billet, backend.ERROR, billet.current_function.failure) }
    out executor.jump_if_nonzero(billet, backend.ERROR, stub(billet))
}

skill fail_jump(billet) {
    @executor = billet.executor
    (str.bytes(billet.current_function.failure) == 0) { out billet }
    (billet.current_function.lined == no) { out executor.jump(billet, billet.current_function.failure) }
    out executor.jump(billet, stub(billet))
}

skill emit_stubs(billet) {
    @executor = billet.executor
    (billet.current_function.lined == no) { out billet }
    @slot = billet.slot_of(state.FAIL_LINE)
    drum (billet.current_function.stubs) {
        billet = executor.label(billet, beat.label)
        billet = executor.load_immediate(billet, backend.SCRATCH0, beat.line)
        billet = executor.store(billet, backend.SCRATCH0, backend.FRAME, slot)
        billet = executor.jump(billet, beat.target)
    }
    out billet
}

skill emit_field_get(billet, name) {
    @executor = billet.executor
    @billet_fields = billet.fields
    @field = billet_fields.find(name)
    billet = executor.load_immediate(billet, backend.ERROR, field.value)
    billet = executor.load_immediate(billet, backend.ARG2, field.slot)
    billet = executor.call(billet, "rt_box_get")
    out on_error(billet)
}

skill subject_field(billet, name) {
    @billet_current_function_slots = billet.current_function.slots
    (billet_current_function_slots.has(name) == yes) { out no }
    @field = lookup.box_field_symbol(billet, billet.current_function.subject, name)
    out str.bytes(field.name) > 0
}

skill load_subject_field(billet, name) {
    @field = lookup.box_field_symbol(billet, billet.current_function.subject, name)
    (str.bytes(field.name) == 0) { out billet }
    @executor = billet.executor
    billet = executor.load(billet, backend.VALUE, backend.FRAME, billet.slot_of("$self"))
    out emit_field_get(billet, name)
}

skill store_subject_field(billet, name) {
    @executor = billet.executor
    billet = executor.move(billet, backend.ARG2, backend.VALUE)
    billet = executor.load(billet, backend.VALUE, backend.FRAME, billet.slot_of("$self"))
    out emit_field_set(billet, name)
}

skill emit_field_set(billet, name) {
    @executor = billet.executor
    @billet_fields = billet.fields
    @field = billet_fields.find(name)
    billet = executor.load_immediate(billet, backend.ERROR, field.value)
    billet = executor.load_immediate(billet, backend.ARG3, field.slot)
    billet = executor.call(billet, "rt_box_set")
    out on_error(billet)
}

skill emit_word_result(billet) {
    @executor = billet.executor
    out executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
}

skill emit_answer_from_bit(billet) {
    @executor = billet.executor
    billet = executor.shift_left(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    billet = executor.add_immediate(billet, backend.VALUE, backend.VALUE, abi.NO)
    out emit_word_result(billet)
}

skill emit_number_less(billet, smaller, larger) {
    @executor = billet.executor
    billet = executor.shift_right_signed(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    billet = executor.shift_right_signed(billet, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    billet = executor.set_less(billet, backend.VALUE, smaller, larger)
    out emit_answer_from_bit(billet)
}

skill emit_number_not_less(billet, smaller, larger) {
    @executor = billet.executor
    billet = executor.shift_right_signed(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    billet = executor.shift_right_signed(billet, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    billet = executor.set_less(billet, backend.VALUE, smaller, larger)
    billet = executor.xor_immediate(billet, backend.VALUE, backend.VALUE, 1)
    out emit_answer_from_bit(billet)
}

skill pack_call(billet, stored) {
    @executor = billet.executor
    billet = executor.load_immediate(billet, backend.FIXED_SOURCE_KIND, contract.fixed_kind(lookup.infer_type(billet, stored)))
    out executor.call(billet, "rt_fixed_pack")
}

skill load_fraction(billet, text) {
    @executor = billet.executor
    out executor.load_wide(billet, backend.VALUE, fraction.word(text))
}

skill negate(billet, type) {
    @executor = billet.executor
    billet = executor.move(billet, backend.ERROR, backend.VALUE)
    (type == "fraction") { out executor.call(load_fraction(billet, "0.0"), "rt_fraction_sub") }
    (contract.is_fixed_type(type) == yes) {
        billet = executor.load_immediate(billet, backend.VALUE, 0)
        billet = executor.load_immediate(billet, backend.FIXED_SOURCE_KIND, contract.fixed_kind(type))
        out executor.call(billet, "rt_fixed_sub")
    }
    billet = executor.load_immediate(billet, backend.VALUE, 0)
    out executor.sub_checked(billet)
}

skill fraction_pair(billet, left, right) {
    (lookup.infer_type(billet, left) == "fraction") { out yes }
    out lookup.infer_type(billet, right) == "fraction"
}

skill fraction_binary(billet, operator) {
    @executor = billet.executor
    @target = "rt_fraction_near"
    (operator == "+") { target = "rt_fraction_add" }
    (operator == "-") { target = "rt_fraction_sub" }
    (operator == "*") { target = "rt_fraction_mul" }
    (operator == "/") { target = "rt_fraction_div" }
    (operator == "<") { target = "rt_fraction_less" }
    (operator == ">") { target = "rt_fraction_greater" }
    (operator == ">=") { target = "rt_fraction_less" }
    (operator == "<=") { target = "rt_fraction_greater" }
    billet = executor.call(billet, target)
    (operator == ">=") { out flip_answer(billet) }
    (operator == "<=") { out flip_answer(billet) }
    out billet
}

skill flip_answer(billet) {
    @executor = billet.executor
    out executor.xor_immediate(billet, backend.VALUE, backend.VALUE, abi.YES - abi.NO)
}

skill emit_word_equal(billet) {
    @executor = billet.executor
    billet = executor.sub(billet, backend.VALUE, backend.VALUE, backend.ERROR)
    billet = executor.set_zero(billet, backend.VALUE, backend.VALUE)
    out emit_answer_from_bit(billet)
}

skill emit_equal_fast_path(billet) {
    @executor = billet.executor
    @slow = billet.fresh_label("equal_slow")
    @done = billet.fresh_label("equal_done")
    billet = executor.branch_not_equal(billet, backend.VALUE, backend.ERROR, slow)
    billet = executor.load_immediate(billet, backend.VALUE, abi.YES)
    billet = emit_word_result(billet)
    billet = executor.jump(billet, done)
    billet = executor.label(billet, slow)
    billet = executor.call(billet, "rt_value_equal")
    billet = executor.label(billet, done)
    out billet
}

skill jump_by_link(billet, sign, name) {
    (sign == "○") {
        out jump_unless_yes(billet, name)
    }
    @executor = billet.executor
    billet = executor.load_immediate(billet, backend.SCRATCH0, abi.YES)
    out executor.jump_if_equal(billet, backend.VALUE, backend.SCRATCH0, name)
}

skill jump_unless_yes(billet, name) {
    @executor = billet.executor
    billet = executor.load_immediate(billet, backend.SCRATCH0, abi.NO)
    billet = executor.jump_if_equal(billet, backend.VALUE, backend.SCRATCH0, name)
    billet = executor.load_immediate(billet, backend.SCRATCH0, abi.NONE)
    billet = executor.jump_if_equal(billet, backend.VALUE, backend.SCRATCH0, name)
    out executor.jump_if_zero(billet, backend.VALUE, name)
}

skill immediate_operand(billet, node) {
    @tag = ast.tag(node)
    (constant_literal(node) == yes) { out yes }
    (tag == "enum-value") { out yes }
    (tag == "path") {
        @parts = ast.plain(node)
        @count = group.count(parts)
        (count > 2) {
            (str.bytes(lookup.resolve_symbol(billet, billet.enums, ast.path_prefix(parts))) > 0) { out yes }
        }
        @billet_current_function_slots = billet.current_function.slots
        (billet_current_function_slots.has(group.get(parts, 1)) == no) {
            @constant_name = lookup.resolve_symbol(billet, billet.constants, ast.path_text(parts))
            @billet_constants = billet.constants
            @constant = billet_constants.find(constant_name)
            (str.bytes(constant.name) > 0) { out constant_literal(constant.node) }
        }
    }
    out no
}

skill string_find(billet, text) {
    @table = billet.strings
    out table.find_text(text)
}

skill string_label(billet, text) {
    @known = string_find(billet, text)
    (str.bytes(known.name) > 0) { out known.name }
    @label = billet.fresh_label("string")
    @length = str.bytes(text)
    @payload_bytes = constants.string_storage_bytes(billet.words, length)
    @executor = billet.executor
    billet = executor.align(billet, backend.RODATA, constants.DATA_ALIGNMENT)
    billet = executor.data_label(billet, backend.RODATA, label)
    billet = constants.emit_static_header(billet, backend.RODATA, abi.OBJECT_KIND_STRING, payload_bytes)
    billet = executor.data_word(billet, backend.RODATA, word.from_number(length))
    billet = executor.data_text(billet, backend.RODATA, text)
    billet = executor.align(billet, backend.RODATA, constants.DATA_ALIGNMENT)
    @table = billet.strings
    table.keep(state.Symbol {
        name = label,
        kind = "string",
        text = text
    })
    out label
}

skill static_group(items) {
    (group.count(items) == 0) { out no }
    drum (items) {
        (constant_literal(beat) == no) { out no }
    }
    out yes
}

skill literal_word(node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "answer") {
        (group.get(plain, 1) == "yes") { out word.from_number(abi.YES) }
        out word.from_number(abi.NO)
    }
    (tag == "none") { out word.from_number(abi.NONE) }
    @number = group.get(plain, 1)
    (tag == "binary") { number = -group.get(ast.plain(group.get(plain, 3)), 1) }
    out word.add_number(word.shift_left(word.from_signed(number), abi.TAG_SHIFT), abi.TAG_NUMBER)
}

skill group_label(billet, items) {
    @label = billet.fresh_label("group")
    @count = group.count(items)
    @executor = billet.executor
    @words = billet.words
    billet = executor.align(billet, backend.RODATA, constants.DATA_ALIGNMENT)
    billet = executor.data_label(billet, backend.RODATA, label)
    billet = constants.emit_static_header(billet, backend.RODATA, abi.OBJECT_KIND_GROUP, constants.group_storage_bytes(words, count))
    billet = executor.data_word(billet, backend.RODATA, word.from_number(count))
    drum (items) { billet = executor.data_word(billet, backend.RODATA, literal_word(beat)) }
    out label
}

skill load_static_group(billet, items) {
    @executor = billet.executor
    billet = executor.load_address(billet, backend.VALUE, group_label(billet, items), 0)
    out executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
}

skill emit_string_join(billet) {
    @executor = billet.executor
    billet = executor.move(billet, backend.ERROR, backend.VALUE)
    billet = executor.pop(billet, backend.VALUE)
    billet = executor.call(billet, "rt_string_add")
    out executor.push(billet, backend.VALUE)
}

skill load_wide_number(billet, text) {
    @tagged = wide.shift_left(wide.from_decimal(text), abi.TAG_SHIFT)
    @executor = billet.executor
    out executor.load_wide(billet, backend.VALUE, tagged)
}

skill load_number(billet, number) {
    out load_number_into(billet, backend.VALUE, number)
}

skill load_number_into(billet, role, number) {
    @executor = billet.executor
    (number > -257) {
        (number < 256) { out executor.load_immediate(billet, role, abi.tagged(number, abi.TAG_NUMBER)) }
    }
    @tagged = word.add_number(word.shift_left(word.from_signed(number), abi.TAG_SHIFT), abi.TAG_NUMBER)
    out executor.load_word(billet, role, tagged)
}

skill simple_operand(billet, node) {
    @parts = ast.plain(node)
    (group.get(parts, 0) == "number") { out yes }
    (group.get(parts, 0) == "path") {
        (group.count(parts) == 2) {
            @billet_current_function_slots = billet.current_function.slots
            out billet_current_function_slots.has(group.get(parts, 1))
        }
    }
    out no
}

skill load_simple(billet, node, role) {
    @parts = ast.plain(node)
    (group.get(parts, 0) == "number") { out load_number_into(billet, role, group.get(parts, 1)) }
    @executor = billet.executor
    out executor.load(billet, role, backend.FRAME, billet.slot_of(group.get(parts, 1)))
}

skill store_local(billet, name, value) {
    @executor = billet.executor
    @slot = billet.slot_of(name)
    billet = executor.store(billet, backend.VALUE, backend.FRAME, slot)
    @type = lookup.infer_type(billet, value)
    @current = billet.current_function
    @known = current.type_of(name)
    ((type == "unknown") ○ (str.bytes(known.name) == 0)) {
        current.set_type(name, type)
    }
    (type == "unknown") {
        out billet
    }
    current.set_type(name, type)
    out billet
}

skill fixed_literal(value) {
    @plain = ast.plain(value)
    @tag = group.get(plain, 0)
    (tag == "number") { out yes }
    (tag == "wide-number") { out yes }
    (tag == "binary") {
        (group.get(plain, 1) == "-") {
            @left = ast.plain(group.get(plain, 2))
            @right_tag = group.get(ast.plain(group.get(plain, 3)), 0)
            (group.get(left, 0) == "number") {
                (group.get(left, 1) == 0) {
                    (right_tag == "number") { out yes }
                    (right_tag == "wide-number") { out yes }
                }
            }
        }
    }
    out no
}

skill load_fixed_literal(billet, value) {
    @executor = billet.executor
    @plain = ast.plain(value)
    @tag = group.get(plain, 0)
    (tag == "wide-number") {
        @text = group.get(plain, 1)
        (billet.words.bytes == 8) {
            (str.starts_with(text, "-") == no) { out executor.load_wide(billet, backend.VALUE, wide.from_decimal(text)) }
        }
        out executor.load_word(billet, backend.VALUE, word.from_decimal(text))
    }
    (tag == "number") { out executor.load_immediate(billet, backend.VALUE, group.get(plain, 1)) }
    @right = ast.plain(group.get(plain, 3))
    (group.get(right, 0) == "number") { out executor.load_immediate(billet, backend.VALUE, -group.get(right, 1)) }
    @negative_text = str.concat("-", group.get(right, 1))
    out executor.load_word(billet, backend.VALUE, word.from_decimal(negative_text))
}

skill store_box(billet, field_ids, type_number) {
    @executor = billet.executor
    @words = billet.words
    @count = group.count(field_ids)
    billet = executor.load_immediate(billet, backend.VALUE, constants.box_storage_bytes(billet.words, count + 1))
    billet = executor.call(billet, "rt_alloc")
    billet = executor.load_immediate(billet, backend.SCRATCH3, abi.OBJECT_KIND_BOX)
    billet = executor.store32(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    billet = executor.load_immediate(billet, backend.SCRATCH3, count + 1)
    billet = executor.store(billet, backend.SCRATCH3, backend.VALUE, words.payload + constants.BOX_COUNT_OFFSET)
    drum (count) {
        billet = executor.load_immediate(billet, backend.SCRATCH0, group.get(field_ids, beat))
        billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload + constants.box_field_id_offset(billet.words, beat))
        billet = executor.load(billet, backend.SCRATCH0, backend.STACK, constants.stack_source_offset(billet.words, count, beat))
        billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload + constants.box_field_value_offset(billet.words, beat))
    }
    billet = executor.load_immediate(billet, backend.SCRATCH0, constants.BOX_TYPE_FIELD_ID)
    billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload + constants.box_field_id_offset(billet.words, count))
    billet = executor.load_immediate(billet, backend.SCRATCH0, abi.tagged(type_number, abi.TAG_NUMBER))
    billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload + constants.box_field_value_offset(billet.words, count))
    (count > 0) {
        billet = executor.add_immediate(billet, backend.STACK, backend.STACK, constants.stack_bytes(billet.words, count))
    }
    out executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_BOX)
}
