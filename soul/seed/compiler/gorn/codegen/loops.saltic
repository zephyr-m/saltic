-- loops — цикл drum: счётчик, источник (число или группа), beat и регион цикла.
-- Источник в VALUE перед head: группа → beat = элемент (плоская или дерево
-- через rt_group_at), число → beat = номер; отрицательное число —
-- ERROR_NEGATIVE_COUNT. Лёгкий вариант (light_*) — только счётчик, без beat.
-- Регион: весь drum — один регион (REGION_MARK = HEAP_TOP на входе, метка навыка в
-- слоте $drum_mark:N). Мусор оборотов не копится до выхода из навыка: в конце
-- оборота, когда занято больше, чем живое плюс model.DRUM_SLACK_BYTES (через регистр: 4096 не влезает в число команды RISC-V; слот
-- $drum_limit:N), регион сжимается через rt_region_exit — корень — группа из
-- значений внешних переменных, которым тело присваивает (кроме фиксированных типов:
-- их слово не отличить от указателя); живое копируется вниз, остальное уходит.
-- Работа — не больше двух копий на выделенный байт. out и ошибка из тела — через
-- трамплины, возвращающие метку навыка перед общим выходом; leave — метка конца.
-- Команды — методами billet.executor (договор backend).
--
-- Frame { number, counter, source, position, saved, beat_slot, start, end, numeric,
--     counted, beat_number, beat_ready, count_ok } — слоты и метки цикла
-- Region { mark, limit, returning, failing, outer_end, outer_failure, roots } — регион drum
-- frame(billet) -> Frame с новыми слотами и метками
-- region_open(billet, frame, body) -> Region; регион открыт, выходы тела подменены
--     (VALUE — источник — цел); зовётся до head
-- head(billet, frame) / tail(billet, frame) — начало цикла (метка start) и конец
--     (метка end, возврат beat); light_head / light_tail(billet, frame) — без beat
-- region_close(billet, frame, region) — конец оборота: сжатие по порогу, переход в
--     начало, трамплины; зовётся после тела, до tail
-- region_restore(billet, region) — REGION_MARK из слота; после tail
-- raise_if_negative(billet, frame) — выход из навыка при VALUE < 0

use core.str
use core.num
use core.group
use compiler.abi
use compiler.ast
use compiler.gorn.backend
use compiler.gorn.state
use compiler.gorn.constants
use compiler.memory.model
use compiler.intrinsic.contract

Frame = Box {
    number = "",
    counter = 0,
    source = 0,
    position = 0,
    saved = 0,
    beat_slot = 0,
    start = "",
    end = "",
    numeric = "",
    counted = "",
    beat_number = "",
    beat_ready = "",
    count_ok = ""
}

Region = Box {
    mark = 0,
    limit = 0,
    returning = "",
    failing = "",
    outer_end = "",
    outer_failure = "",
    roots = []
}

Loops = Box {
    constant_ops = constants.Constants {}

    skill frame(billet) {
        @drum_number = num.text(billet.current_function.next_drum)
        billet.current_function.next_drum = billet.current_function.next_drum + 1
        @counter = billet.slot_of("$drum:{drum_number}")
        @source = billet.slot_of("$drum_source:{drum_number}")
        @position = billet.slot_of("$drum_index:{drum_number}")
        @saved = billet.slot_of("$drum_saved:{drum_number}")
        @beat_slot = billet.slot_of(ast.DRUM_BEAT)
        @start = billet.fresh_label("drum")
        @end = billet.fresh_label("drum_end")
        @numeric = billet.fresh_label("drum_numeric")
        @counted = billet.fresh_label("drum_counted")
        @beat_number = billet.fresh_label("drum_beat_number")
        @beat_ready = billet.fresh_label("drum_beat_ready")
        @count_ok = billet.fresh_label("drum_count_ok")
        out Frame {
            number = drum_number,
            counter = counter, source = source, position = position, saved = saved, beat_slot = beat_slot,
            start = start, end = end, numeric = numeric, counted = counted,
            beat_number = beat_number, beat_ready = beat_ready, count_ok = count_ok
        }
    }

    skill light_head(billet, frame) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.and_immediate(billet, backend.SCRATCH1, backend.VALUE, abi.TAG_MASK)
        billet = executor.load_immediate(billet, backend.SCRATCH2, abi.TAG_GROUP)
        billet = executor.branch_not_equal(billet, backend.SCRATCH1, backend.SCRATCH2, frame.numeric)
        billet = executor.and_immediate(billet, backend.SCRATCH1, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.VALUE, backend.SCRATCH1, words.payload)
        billet = executor.jump(billet, frame.counted)
        billet = executor.label(billet, frame.numeric)
        billet = executor.shift_right_signed(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        billet = raise_if_negative(billet, frame)
        billet = executor.label(billet, frame.counted)
        billet = executor.store(billet, backend.VALUE, backend.FRAME, frame.counter)
        billet = executor.label(billet, frame.start)
        billet = executor.load(billet, backend.SCRATCH0, backend.FRAME, frame.counter)
        billet = executor.jump_if_zero(billet, backend.SCRATCH0, frame.end)
        billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, -1)
        billet = executor.store(billet, backend.SCRATCH0, backend.FRAME, frame.counter)
        out billet
    }

    skill head(billet, frame) {
        @executor = billet.executor
        @words = billet.words
        billet = executor.store(billet, backend.VALUE, backend.FRAME, frame.source)
        billet = executor.and_immediate(billet, backend.SCRATCH1, backend.VALUE, abi.TAG_MASK)
        billet = executor.load_immediate(billet, backend.SCRATCH2, abi.TAG_GROUP)
        billet = executor.branch_not_equal(billet, backend.SCRATCH1, backend.SCRATCH2, frame.numeric)
        billet = executor.and_immediate(billet, backend.SCRATCH1, backend.VALUE, abi.PAYLOAD_MASK)
        billet = executor.load(billet, backend.VALUE, backend.SCRATCH1, words.payload)
        billet = executor.jump(billet, frame.counted)
        billet = executor.label(billet, frame.numeric)
        billet = executor.shift_right_signed(billet, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
        billet = raise_if_negative(billet, frame)
        billet = executor.store_zero(billet, backend.FRAME, frame.source)
        billet = executor.label(billet, frame.counted)
        billet = executor.store(billet, backend.VALUE, backend.FRAME, frame.counter)
        billet = executor.store_zero(billet, backend.FRAME, frame.position)
        billet = executor.load(billet, backend.SCRATCH0, backend.FRAME, frame.beat_slot)
        billet = executor.store(billet, backend.SCRATCH0, backend.FRAME, frame.saved)
        billet = executor.label(billet, frame.start)
        billet = executor.load(billet, backend.SCRATCH0, backend.FRAME, frame.counter)
        billet = executor.jump_if_zero(billet, backend.SCRATCH0, frame.end)
        billet = executor.add_immediate(billet, backend.SCRATCH0, backend.SCRATCH0, -1)
        billet = executor.store(billet, backend.SCRATCH0, backend.FRAME, frame.counter)
        billet = executor.load(billet, backend.SCRATCH1, backend.FRAME, frame.position)
        billet = executor.load(billet, backend.SCRATCH2, backend.FRAME, frame.source)
        billet = executor.branch_zero(billet, backend.SCRATCH2, frame.beat_number)
        billet = executor.and_immediate(billet, backend.SCRATCH2, backend.SCRATCH2, abi.PAYLOAD_MASK)
        @flat = billet.fresh_label("drum_flat")
        billet = executor.load32(billet, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_KIND_OFFSET)
        billet = executor.load_immediate(billet, backend.SCRATCH4, abi.OBJECT_KIND_TREE)
        billet = executor.branch_not_equal(billet, backend.SCRATCH3, backend.SCRATCH4, flat)
        billet = executor.move(billet, backend.VALUE, backend.SCRATCH2)
        billet = executor.shift_left(billet, backend.ERROR, backend.SCRATCH1, abi.TAG_SHIFT)
        billet = executor.call(billet, "rt_group_at")
        billet = executor.move(billet, backend.SCRATCH2, backend.VALUE)
        billet = executor.load(billet, backend.SCRATCH1, backend.FRAME, frame.position)
        billet = executor.jump(billet, frame.beat_ready)
        billet = executor.label(billet, flat)
        billet = executor.shift_left(billet, backend.SCRATCH3, backend.SCRATCH1, words.shift)
        billet = executor.add(billet, backend.SCRATCH2, backend.SCRATCH2, backend.SCRATCH3)
        billet = executor.load(billet, backend.SCRATCH2, backend.SCRATCH2, words.payload + words.group_items)
        billet = executor.jump(billet, frame.beat_ready)
        billet = executor.label(billet, frame.beat_number)
        billet = executor.shift_left(billet, backend.SCRATCH2, backend.SCRATCH1, abi.TAG_SHIFT)
        billet = executor.label(billet, frame.beat_ready)
        billet = executor.store(billet, backend.SCRATCH2, backend.FRAME, frame.beat_slot)
        billet = executor.add_immediate(billet, backend.SCRATCH1, backend.SCRATCH1, 1)
        billet = executor.store(billet, backend.SCRATCH1, backend.FRAME, frame.position)
        out billet
    }

    skill tail(billet, frame) {
        @executor = billet.executor
        billet = executor.label(billet, frame.end)
        billet = executor.load(billet, backend.SCRATCH0, backend.FRAME, frame.saved)
        billet = executor.store(billet, backend.SCRATCH0, backend.FRAME, frame.beat_slot)
        out billet
    }

    skill light_tail(billet, frame) {
        @executor = billet.executor
        out executor.label(billet, frame.end)
    }

    skill raise_if_negative(billet, frame) {
        @executor = billet.executor
        billet = executor.branch_not_negative(billet, backend.VALUE, frame.count_ok)
        billet = executor.load_immediate(billet, backend.VALUE, 0)
        billet = executor.load_immediate(billet, backend.ERROR, abi.ERROR_NEGATIVE_COUNT)
        billet = executor.load_immediate(billet, backend.ARG2, constants.REGION_VALUE_SKIPPED)
        billet = executor.jump(billet, billet.current_function.end)
        billet = executor.label(billet, frame.count_ok)
        out billet
    }

    skill roots(billet, body) {
        @found = []
        drum (state.outer_assigned(body)) {
            @current = billet.current_function
            @type_item = current.type_of(beat)
            (contract.is_fixed_type(type_item.text) == no) {
                found = group.add(found, billet.slot_of(beat))
            }
        }
        out found
    }

    skill region_open(billet, frame, body) {
        @executor = billet.executor
        @region = Region {
            mark = billet.slot_of("$drum_mark:{frame.number}"),
            limit = billet.slot_of("$drum_limit:{frame.number}"),
            returning = billet.fresh_label("drum_out"),
            failing = billet.fresh_label("drum_failure"),
            outer_end = billet.current_function.end,
            outer_failure = billet.current_function.failure,
            roots = roots(billet, body)
        }
        billet = executor.store(billet, backend.REGION_MARK, backend.FRAME, region.mark)
        billet = executor.move(billet, backend.REGION_MARK, backend.HEAP_TOP)
        billet = executor.load_immediate(billet, backend.SCRATCH0, model.DRUM_SLACK_BYTES)
        billet = executor.add(billet, backend.SCRATCH0, backend.HEAP_TOP, backend.SCRATCH0)
        billet = executor.store(billet, backend.SCRATCH0, backend.FRAME, region.limit)
        billet.current_function.end = region.returning
        (str.bytes(region.outer_failure) > 0) {
            billet.current_function.failure = region.failing
        }
        out region
    }

    skill compact(billet, region) {
        @executor = billet.executor
        @words = billet.words
        @count = group.count(region.roots)
        (count == 0) {
            billet = executor.load_immediate(billet, backend.VALUE, abi.NONE)
            billet = executor.load_immediate(billet, backend.ARG2, constants.REGION_VALUE_SKIPPED)
        }
        (count > 0) {
            billet = executor.load_immediate(billet, backend.VALUE, constant_ops.group_storage_bytes(words, count))
            billet = executor.call(billet, "rt_alloc")
            billet = executor.load_immediate(billet, backend.SCRATCH3, abi.OBJECT_KIND_GROUP)
            billet = executor.store32(billet, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
            billet = executor.load_immediate(billet, backend.SCRATCH3, count)
            billet = executor.store(billet, backend.SCRATCH3, backend.VALUE, words.payload + constants.GROUP_COUNT_OFFSET)
            drum (count) {
                billet = executor.load(billet, backend.SCRATCH0, backend.FRAME, group.get(region.roots, beat))
                billet = executor.store(billet, backend.SCRATCH0, backend.VALUE, words.payload + constant_ops.group_item_offset(words, beat))
            }
            billet = executor.or_immediate(billet, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
            billet = executor.load_immediate(billet, backend.ARG2, constants.REGION_VALUE_ROOT)
        }
        billet = executor.load_immediate(billet, backend.ERROR, abi.CALL_NO_ERROR)
        billet = executor.move(billet, backend.ARG3, backend.STACK)
        billet = executor.call(billet, "rt_region_exit")
        (count > 0) {
            billet = executor.and_immediate(billet, backend.SCRATCH1, backend.VALUE, abi.PAYLOAD_MASK)
            drum (count) {
                billet = executor.load(billet, backend.SCRATCH0, backend.SCRATCH1, words.payload + constant_ops.group_item_offset(words, beat))
                billet = executor.store(billet, backend.SCRATCH0, backend.FRAME, group.get(region.roots, beat))
            }
        }
        billet = executor.sub(billet, backend.SCRATCH0, backend.HEAP_TOP, backend.REGION_MARK)
        billet = executor.add(billet, backend.SCRATCH0, backend.SCRATCH0, backend.HEAP_TOP)
        billet = executor.load_immediate(billet, backend.SCRATCH1, model.DRUM_SLACK_BYTES)
        billet = executor.add(billet, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH1)
        out executor.store(billet, backend.SCRATCH0, backend.FRAME, region.limit)
    }

    skill region_close(billet, frame, region) {
        @executor = billet.executor
        @fits = billet.fresh_label("drum_fits")
        billet.current_function.end = region.outer_end
        billet.current_function.failure = region.outer_failure
        billet = executor.load(billet, backend.SCRATCH0, backend.FRAME, region.limit)
        billet = executor.branch_less_unsigned(billet, backend.HEAP_TOP, backend.SCRATCH0, fits)
        billet = compact(billet, region)
        billet = executor.label(billet, fits)
        billet = executor.jump(billet, frame.start)
        billet = executor.label(billet, region.returning)
        billet = region_restore(billet, region)
        billet = executor.jump(billet, region.outer_end)
        (str.bytes(region.outer_failure) > 0) {
            billet = executor.label(billet, region.failing)
            billet = region_restore(billet, region)
            billet = executor.jump(billet, region.outer_failure)
        }
        out billet
    }

    skill region_restore(billet, region) {
        @executor = billet.executor
        out executor.load(billet, backend.REGION_MARK, backend.FRAME, region.mark)
    }
}
