-- labels — имена меток горна из имён языка.
--
-- Labels: safe(text) -> имя для метки (чужие знаки — «_»);
--     dispatch_label(method) -> метка рассылки метода "rt_method_<имя>"

use core.str

Labels = Box {
    skill safe(text) {
        @result = ""
        @allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        drum (str.bytes(text)) {
            @ch = str.get(text, beat)
            pick {
                (str.contains(allowed, ch) == yes) {
                    result = str.concat(result, ch)
                }
                {
                    result = "{result}_"
                }
            }
        }
        out result
    }

    skill dispatch_label(method) {
        out str.concat("rt_method_", safe(method))
    }
}
