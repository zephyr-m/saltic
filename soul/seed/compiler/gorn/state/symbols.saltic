-- symbols — таблица символов (constants, boxes, skills, …, slots, types,
-- names) — хозяин себя (решение автора 22.11.2026). Поиск с конца.
--
-- Symbols { items } — find(name) / find_text(text) — с конца, has(name),
--     add / add_named(name, kind, node, …), keep(entry), count(), at(i)

use core.str
use core.group
use compiler.gorn.state.symbol

Symbols = Box {
    items = []

    skill count() {
        out group.count(items)
    }

    skill at(index) {
        out group.get(items, index)
    }

    skill find(name) {
        @total = group.count(items)
        drum (total) {
            @item = group.get(items, total - 1 - beat)
            (item.name == name) {
                out item
            }
        }
        out symbol.Symbol {}
    }

    skill find_text(text) {
        @total = group.count(items)
        drum (total) {
            @item = group.get(items, total - 1 - beat)
            (item.text == text) {
                out item
            }
        }
        out symbol.Symbol {}
    }

    skill has(name) {
        @item = find(name)
        out (str.bytes(item.name) > 0)
    }

    skill keep(entry) {
        items = group.add(items, entry)
        out none
    }

    skill add(name, kind, node, value) {
        keep(symbol.Symbol {
            name = name,
            kind = kind,
            node = node,
            value = value
        })
        out none
    }

    skill add_named(name, kind, node, text) {
        keep(symbol.Symbol {
            name = name,
            kind = kind,
            node = node,
            text = text
        })
        out none
    }
}
