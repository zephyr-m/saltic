-- function — навык, который горн сейчас собирает: слоты и типы локальных,
-- метки хвоста, счётчики drum, rescue и always, строка текущего оператора и
-- заглушки переходов на ошибку.
--
-- Function { name, slots, end, subject, module, types, next_drum, drum_exit,
--     failure, next_rescue, next_always, line, lined, stubs } — lined — у навыка
--     есть слот FAIL_LINE (у геттеров констант нет); stubs — заглушки Stub
--     type_of(local) / set_type(local, type) — типы локальных (поле types)

use core.str
use compiler.gorn.state.symbol
use compiler.gorn.state.symbols

Function = Box {
    name = "",
    slots = symbols.Symbols {},
    end = "",
    subject = "",
    module = "",
    types = symbols.Symbols {},
    next_drum = 1,
    drum_exit = "",
    failure = "",
    next_rescue = 1,
    next_always = 1,
    line = 0,
    lined = no,
    stubs = []

    skill type_of(local) {
        out types.find(local)
    }

    skill set_type(local, type) {
        @item = types.find(local)
        (str.bytes(item.name) == 0) {
            types.keep(symbol.Symbol {
                name = local,
                kind = "type",
                text = type
            })
            out none
        }
        item.text = type
        out none
    }
}
