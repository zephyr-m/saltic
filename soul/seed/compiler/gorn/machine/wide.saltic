-- wide — 64-битное значение из двух 32-битных word: low и high. Нужно RV64:
-- константы больше 32 бит (61-битные числа, маски, li), 64-битные поля ELF.
-- Компилятор работает и на RV32I (там число 29-битное), поэтому считает побайтно.
-- Переполнение 64 бит — WideOutsideRange; отрицательные — дополнительный код.
--
-- Wide = Box { low, high } — младшее и старшее слово
--     byte_list() -> 8 байт, младший первым
--     narrow() -> word, если старшее слово — ноль; WideOutsideRange
--     is_zero() -> yes/no; sum(right) / sum_number(n) -> Wide; WideOutsideRange
--     times(scale, extra) -> Wide × scale + extra; WideOutsideRange
--     aligned_to(boundary) -> Wide вверх до кратного boundary (делитель 256); InvalidAlignment
--     negated() / shifted(shift) -> Wide (по модулю 2^64)
--     decimal() -> десятичный текст без знака
-- from_bytes(bytes) / from_word(word) / from_number(value) / from_signed(value) -> Wide
-- from_decimal(text) -> Wide со знаком; InvalidWordText, WideOutsideRange

use core.str
use core.num
use core.group
use compiler.gorn.machine.word

Wide = Box {
    low = word.Word {},
    high = word.Word {}

    skill byte_list() {
        out [low.b0, low.b1, low.b2, low.b3, high.b0, high.b1, high.b2, high.b3]
    }

    skill narrow() {
        (high.is_zero() == no) {
            out error.WideOutsideRange
        }
        out low
    }

    skill is_zero() {
        (low.is_zero() == no) {
            out no
        }
        out high.is_zero()
    }

    skill times(scale, extra) {
        @result = []
        @carry = extra
        drum (byte_list()) {
            @total = beat * scale + carry
            result = group.add(result, total % 256)
            carry = total / 256
        }
        (carry > 0) {
            out error.WideOutsideRange
        }
        out from_bytes(result)
    }

    skill sum(right) {
        @mine = byte_list()
        @theirs = right.byte_list()
        @result = []
        @carry = 0
        drum (8) {
            @total = group.get(mine, beat) + group.get(theirs, beat) + carry
            result = group.add(result, total % 256)
            carry = total / 256
        }
        (carry > 0) {
            out error.WideOutsideRange
        }
        out from_bytes(result)
    }

    skill sum_number(amount) {
        out sum(from_number(amount))
    }

    skill aligned_to(boundary) {
        ((boundary < 1) ○○ (boundary > 256) ○○ ((256 % boundary) > 0)) {
            out error.InvalidAlignment
        }
        @remainder = low.b0 % boundary
        (remainder == 0) {
            out from_bytes(byte_list())
        }
        out sum_number(boundary - remainder)
    }

    skill negated() {
        @result = []
        @carry = 1
        drum (byte_list()) {
            @total = 255 - beat + carry
            result = group.add(result, total % 256)
            carry = total / 256
        }
        out from_bytes(result)
    }

    skill shifted(shift) {
        @bytes = byte_list()
        drum (shift) {
            bytes = doubled(bytes)
        }
        out from_bytes(bytes)
    }

    skill doubled(bytes) {
        @result = []
        @carry = 0
        drum (bytes) {
            @total = beat * 2 + carry
            result = group.add(result, total % 256)
            carry = total / 256
        }
        out result
    }

    skill decimal() {
        @current = byte_list()
        @result = ""
        drum (20) {
            @quotient = []
            @rest = 0
            @active = no
            drum (8) {
                @at = 7 - beat
                @part = rest * 256 + group.get(current, at)
                quotient = group.add(quotient, part / 10)
                rest = part % 10
                ((part / 10) > 0) {
                    active = yes
                }
            }
            result = str.concat(str.get("0123456789", rest), result)
            @next = []
            drum (8) {
                next = group.add(next, group.get(quotient, 7 - beat))
            }
            current = next
            (active == no) {
                out result
            }
        }
        out result
    }
}

skill from_bytes(bytes) {
    @low = word.from_bytes(group.get(bytes, 0), group.get(bytes, 1), group.get(bytes, 2), group.get(bytes, 3))
    @high = word.from_bytes(group.get(bytes, 4), group.get(bytes, 5), group.get(bytes, 6), group.get(bytes, 7))
    out Wide {
        low = low,
        high = high
    }
}

skill from_word(value) {
    out Wide {
        low = value,
        high = word.Word {}
    }
}

skill from_number(value) {
    out from_word(word.from_number(value))
}

skill from_signed(value) {
    (value < 0) {
        @magnitude = from_number(-value)
        out magnitude.negated()
    }
    out from_number(value)
}

skill from_decimal(text) {
    @length = str.bytes(text)
    (length == 0) {
        out error.InvalidWordText
    }
    @negative = str.starts_with(text, "-")
    @first = 0
    (negative == yes) {
        (length == 1) {
            out error.InvalidWordText
        }
        first = 1
    }
    @result = Wide {}
    drum (length - first) {
        @ch = str.get(text, beat + first)
        (str.is_digit(ch) == no) {
            out error.InvalidWordText
        }
        result = result.times(10, num.digit_value(ch))
    }
    (negative == yes) {
        out result.negated()
    }
    out result
}
