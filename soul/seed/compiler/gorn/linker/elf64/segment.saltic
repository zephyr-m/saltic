-- segment — сегмент программы ELF64 (PT_LOAD): откуда в файле, куда в память,
-- сколько байт в файле и в памяти, права.
--
-- Segment { offset, address, file_bytes, memory_bytes, flags } — address — word,
--     memory_bytes — wide: data с bss и кучей может быть больше 4 ГБ

use compiler.gorn.machine.word
use compiler.gorn.machine.wide

Segment = Box {
    offset = 0,
    address = word.Word {},
    file_bytes = 0,
    memory_bytes = wide.Wide {},
    flags = 0
}
