use seed
use seed.ast
use seed.intrinsic.contract
use seed.abi.call

skill arity_message(signature, actual) {
    (actual > call.ARGUMENT_LIMIT) {
        @message = "вызов не может содержать больше "
        message = seed.str.add(message, seed.num.text(call.ARGUMENT_LIMIT))
        out seed.str.add(message, " аргументов")
    }
    (signature.found == no) { out "" }
    (actual < signature.minimum) {
        @message = seed.str.add("вызов '", signature.name)
        message = seed.str.add(message, "' ожидает ")
        message = seed.str.add(message, seed.num.text(signature.minimum))
        message = seed.str.add(message, ", получено ")
        out seed.str.add(message, seed.num.text(actual))
    }
    (actual > signature.maximum) {
        @message = seed.str.add("вызов '", signature.name)
        message = seed.str.add(message, "' допускает не больше ")
        message = seed.str.add(message, seed.num.text(signature.maximum))
        message = seed.str.add(message, ", получено ")
        out seed.str.add(message, seed.num.text(actual))
    }
    out ""
}

skill is_zero(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "number") {
        (ast.part(plain, 1) == 0) { out yes }
    }
    out no
}

skill is_integer_literal(node) {
    @plain = ast.plain(node)
    @tag = ast.tag(plain)
    (tag == "number") { out yes }
    (tag == "wide-number") { out yes }
    (tag == "binary") {
        (ast.part(plain, 1) == "-") {
            (is_zero(ast.part(plain, 2)) == yes) {
                @right_tag = ast.tag(ast.part(plain, 3))
                (right_tag == "number") { out yes }
                (right_tag == "wide-number") { out yes }
            }
        }
    }
    out no
}

skill is_fraction(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "fraction-number") { out yes }
    (ast.tag(plain) == "binary") {
        (ast.part(plain, 1) == "-") { out is_fraction(ast.part(plain, 3)) }
    }
    out no
}

skill has_wide_number(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "wide-number") { out yes }
    (ast.tag(plain) == "binary") {
        (ast.part(plain, 1) == "-") { out has_wide_number(ast.part(plain, 3)) }
    }
    out no
}

skill fixed_argument_message(node, actual_type) {
    (is_fraction(node) == yes) { out "фиксированный целый тип не принимает дробное значение" }
    (is_integer_literal(node) == yes) { out "" }
    (actual_type == "number") { out "" }
    (contract.is_fixed_type(actual_type) == yes) { out "" }
    (actual_type == "unknown") { out "" }
    out seed.str.add("фиксированный целый тип не принимает ", actual_type)
}

skill drum_message(type) {
    (type == "number") { out "" }
    (type == "unknown") { out "" }
    out seed.str.add("drum ожидает число, получено ", type)
}
