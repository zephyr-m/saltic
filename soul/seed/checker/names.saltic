use seed
use seed.ast

Name = Box {
    name = ""
    kind = ""
    type = "unknown"
    node = []
}

Scope = Box {
    names = []
    subject = ""
    module = ""
}

skill variant_key(name) {
    out seed.str.add("__enum_variant__|", name)
}

skill find(names, name) {
    drum (names) {
        (beat.name == name) { out beat }
    }
    out Name {}
}

skill has(names, name) {
    @found = find(names, name)
    out seed.str.len(found.name) > 0
}

skill put(names, name, kind, type) {
    out seed.group.add(names, Name { name = name kind = kind type = type })
}

skill put_node(names, name, kind, type, node) {
    out seed.group.add(names, Name { name = name kind = kind type = type node = node })
}

skill update(names, name, type) {
    @result = []
    drum (names) {
        @next_type = beat.type
        (beat.name == name) { next_type = type }
        result = put_node(result, beat.name, beat.kind, next_type, beat.node)
    }
    out result
}

skill resolve_name(name, module, globals) {
    (has(globals, name) == yes) { out name }
    @local = ast.qualified(module, name)
    (has(globals, local) == yes) { out local }
    @head = ast.name_head(name)
    @import = find(globals, ast.alias_key(module, head))
    (import.kind == "import") {
        @candidate = seed.str.add(import.type, ast.name_tail(name))
        (has(globals, candidate) == yes) { out candidate }
    }
    out ""
}

skill resolve_path(node, scope, globals) {
    @plain = ast.plain(node)
    @count = seed.group.count(plain)
    @head = seed.group.item(plain, 1)
    (count == 2) {
        (has(scope.names, head) == yes) { out "" }
    }
    @direct = ast.path_text(plain)
    (has(globals, direct) == yes) { out direct }
    (count == 2) {
        @local = ast.qualified(scope.module, head)
        (has(globals, local) == yes) { out local }
    }
    @import = find(globals, ast.alias_key(scope.module, head))
    (import.kind == "import") {
        @candidate = import.type
        drum (count - 2) {
            candidate = seed.str.add(candidate, seed.str.add(".", seed.group.item(plain, beat + 2)))
        }
        (has(globals, candidate) == yes) { out candidate }
    }
    out ""
}

skill call_name(callee, scope, globals) {
    @resolved = resolve_path(callee, scope, globals)
    (seed.str.len(resolved) > 0) {
        @global = find(globals, resolved)
        (global.kind == "native") { out resolved }
    }
    out ast.path_text(callee)
}
