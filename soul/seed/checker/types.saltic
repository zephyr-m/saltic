use seed.str
use seed.group
use seed.num
use seed.ast
use seed.intrinsic.contract
use seed.checker.names

skill tail(text, start) {
    out str.slice(text, start, str.len(text))
}

skill group_type(type) {
    out str.add("group:", type)
}

skill is_group_type(type) {
    out str.starts_with(type, "group:")
}

skill group_item_type(type) {
    (is_group_type(type) == yes) { out tail(type, 6) }
    out "unknown"
}

skill merge(left, right) {
    (left == "unknown") { out right }
    (right == "unknown") { out left }
    (left == right) { out left }
    (is_group_type(left) == yes) {
        (is_group_type(right) == yes) { out group_type(merge(group_item_type(left), group_item_type(right))) }
    }
    out "unknown"
}

skill compatible(left, right) {
    (left == "unknown") { out yes }
    (right == "unknown") { out yes }
    (left == right) { out yes }
    (is_group_type(left) == yes) {
        (is_group_type(right) == yes) { out compatible(group_item_type(left), group_item_type(right)) }
    }
    out no
}

skill type_text(type) {
    (type == "answer") { out "yes/no" }
    (str.starts_with(type, "box:") == yes) { out str.add("Box ", tail(type, 4)) }
    (str.starts_with(type, "enum:") == yes) { out str.add("enum ", tail(type, 5)) }
    (is_group_type(type) == yes) { out str.add("группа ", type_text(group_item_type(type))) }
    out type
}

skill integer_text(node) {
    @plain = ast.plain(node)
    @tag = group.item(plain, 0)
    (tag == "number") { out num.text(group.item(plain, 1)) }
    (tag == "wide-number") { out group.item(plain, 1) }
    (tag == "binary") {
        (group.item(plain, 1) == "-") {
            @left = ast.plain(group.item(plain, 2))
            (group.item(left, 0) == "number") {
                (group.item(left, 1) == 0) { out str.add("-", integer_text(group.item(plain, 3))) }
            }
        }
    }
    out ""
}

skill type_in_module(node, module, globals) {
    @type = type(node)
    (str.starts_with(type, "box:") == yes) {
        @name = tail(type, 4)
        @resolved = names.resolve_name(name, module, globals)
        (str.len(resolved) > 0) { out str.add("box:", resolved) }
    }
    out type
}


skill type(node) {
    @tag = ast.tag(node)
    (tag == "number") { out "number" }
    (tag == "wide-number") { out "number" }
    (tag == "fraction-number") { out "number" }
    (tag == "string") { out "string" }
    (tag == "template") { out "string" }
    (tag == "answer") { out "answer" }
    (tag == "none") { out "none" }
    (tag == "group") {
        @type = "unknown"
        @plain = ast.plain(node)
        drum (group.count(plain) - 1) {
            type = merge(type, type(group.item(plain, beat + 1)))
        }
        out group_type(type)
    }
    (tag == "box-new") { out str.add("box:", ast.part(node, 1)) }
    out "unknown"
}

skill box_field(globals, box_name, field_name) {
    @box = names.find(globals, box_name)
    @count = group.count(ast.plain(box.node))
    drum (count - 2) {
        @member = ast.part(box.node, count - 1 - beat)
        (ast.tag(member) == "field") {
            (ast.part(member, 1) == field_name) { out names.Name { name = field_name kind = "field" type = type_in_module(ast.part(member, 2), ast.name_module(box_name), globals) node = member } }
        }
    }
    out names.Name {}
}

skill path_type(node, scope, globals) {
    @parts = ast.plain(node)
    @count = group.count(parts)
    @name = group.item(parts, 1)
    @resolved = names.resolve_path(node, scope, globals)
    (str.len(resolved) > 0) {
        @resolved_name = names.find(globals, resolved)
        out resolved_name.type
    }
    (count > 2) {
        @resolved_enum = names.resolve_name(ast.path_prefix(node), scope.module, globals)
        @enum_symbol = names.find(globals, resolved_enum)
        (enum_symbol.kind == "enum") { out str.add("enum:", resolved_enum) }
    }
    (count == 2) {
        @local = names.find(scope.names, name)
        (str.len(local.name) > 0) { out local.type }
        @global = names.find(globals, name)
        (str.len(global.name) > 0) { out global.type }
        (name == "error") { out "error" }
        out "unknown"
    }
    (name == "seed") { out "module-path" }
    (name == "error") { out "error" }
    @enum_model = names.find(globals, name)
    (enum_model.kind == "enum") {
        (count == 3) { out str.add("enum:", name) }
    }
    @local_value = names.find(scope.names, name)
    @type = local_value.type
    (type == "unknown") {
        @global_value = names.find(globals, name)
        type = global_value.type
    }
    drum (count - 2) {
        pick {
            (str.starts_with(type, "box:") == yes) {
                @field = box_field(globals, tail(type, 4), group.item(parts, beat + 2))
                type = field.type
            }
            { type = "unknown" }
        }
    }
    out type
}

skill call_type(node, scope, globals) {
    @plain = ast.plain(node)
    @callee = ast.plain(group.item(plain, 1))
    (group.item(callee, 0) == "path") {
        @name = group.item(callee, 1)
        @part_count = group.count(callee)
        (part_count == 2) {
            @global = names.find(globals, name)
            (global.kind == "box") { out str.add("box:", name) }
        }
        @full = names.call_name(callee, scope, globals)
        (contract.is_fixed_type(full) == yes) { out full }
        @input_type = "unknown"
        (group.count(plain) > 2) { input_type = value_type(group.item(plain, 2), scope, globals) }
        @kind = contract.find(full)
        @result_type = contract.result(kind, input_type)
        (result_type == "group-item") { out group_item_type(input_type) }
        (result_type == "group-add") {
            @item_type = "unknown"
            (group.count(plain) > 3) { item_type = value_type(group.item(plain, 3), scope, globals) }
            out group_type(merge(group_item_type(input_type), item_type))
        }
        ((result_type == "unknown") == no) { out result_type }
    }
    out "unknown"
}

skill block_value_type(block, scope, globals) {
    @plain = ast.plain(block)
    @count = group.count(plain)
    (count == 1) { out "none" }
    @last = ast.plain(group.item(plain, count - 1))
    @tag = group.item(last, 0)
    (tag == "expr") { out value_type(group.item(last, 1), scope, globals) }
    (tag == "out") { out value_type(group.item(last, 1), scope, globals) }
    out "none"
}

skill value_type(node, scope, globals) {
    @plain = ast.plain(node)
    @tag = group.item(plain, 0)
    (tag == "number") { out "number" }
    (tag == "wide-number") { out "number" }
    (tag == "fraction-number") { out "number" }
    (tag == "string") { out "string" }
    (tag == "template") { out "string" }
    (tag == "answer") { out "answer" }
    (tag == "none") { out "none" }
    (tag == "enum-value") {
        @variant = names.find(globals, names.variant_key(group.item(plain, 1)))
        out variant.type
    }
    (tag == "path") { out path_type(node, scope, globals) }
    (tag == "box-new") {
        @box_name = names.resolve_name(group.item(plain, 1), scope.module, globals)
        out str.add("box:", box_name)
    }
    (tag == "call") { out call_type(node, scope, globals) }
    (tag == "group") {
        @type = "unknown"
        drum (group.count(plain) - 1) {
            type = merge(type, value_type(group.item(plain, beat + 1), scope, globals))
        }
        out group_type(type)
    }
    (tag == "binary") {
        @operator = group.item(plain, 1)
        (operator == "==") { out "answer" }
        (operator == ">") { out "answer" }
        (operator == "<") { out "answer" }
        @left_type = value_type(group.item(plain, 2), scope, globals)
        (contract.is_fixed_type(left_type) == yes) { out left_type }
        out "number"
    }
    (tag == "rescue") {
        @left = value_type(group.item(plain, 1), scope, globals)
        @child = names.Scope { names = scope.names subject = scope.subject module = scope.module }
        child.names = names.put(child.names, group.item(plain, 2), "variable", "error")
        out merge(left, block_value_type(group.item(plain, 3), child, globals))
    }
    out "unknown"
}
