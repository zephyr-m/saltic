-- file — файлы хоста: четыре имени (Q-019) — read / write для текста,
-- read_bytes / write_bytes для буфера core.bytes; группа чисел — через
-- bytes.from_group (там же ByteOutsideRange).
--
-- read(path) -> текст файла; write(path, text) — записать текст
-- read_bytes(path) -> буфер core.bytes; write_bytes(path, buffer) — записать буфер
-- write_buffer / write_raw_bytes — прежние имена, ими пишет компилятор; уйдут
--   после выпуска полки (шаг 2)
-- list(path) -> группа имён в папке без . и .., порядок — как у ядра; File

skill read(path) native
skill write(path, text) native
skill write_raw_bytes(path, bytes) native
skill read_bytes(path) native
skill write_buffer(path, buffer) native
skill list(path) native

skill write_bytes(path, buffer) {
    out write_buffer(path, buffer)
}
