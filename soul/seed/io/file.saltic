-- file — файлы хоста: прочитать текст, записать текст или байты.
-- write_bytes проверяет каждое значение: байт — число от 0 до 255, иначе
-- ошибка ByteOutsideRange и файл не трогается.
--
-- read(path) -> текст файла
-- write(path, text) — записать текст
-- write_bytes(path, bytes) — записать группу байтов; ByteOutsideRange
-- read_bytes(path) -> буфер core.bytes с содержимым файла
-- write_buffer(path, buffer) — записать буфер core.bytes как есть
-- write_raw_bytes(path, bytes) — запись без проверки, для байтов, проверенных
--   заранее (образ компилятора из machine.buffer)

skill read(path) native
skill write(path, text) native
skill write_raw_bytes(path, bytes) native
skill read_bytes(path) native
skill write_buffer(path, buffer) native

skill write_bytes(path, bytes) {
    drum (bytes) {
        (beat < 0) { out error.ByteOutsideRange }
        (beat > 255) { out error.ByteOutsideRange }
    }
    out write_raw_bytes(path, bytes)
}
