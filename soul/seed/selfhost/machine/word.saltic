-- word — 32-битное слово: хранится четырьмя байтами (b0 младший) — в поле Box и
-- группе на RV32I u32 не влезает в обычное число (Q-049), а считается в u32
-- (raw / of_raw). Адреса, размеры, кодировки команд. to_number только до 2^28
-- (ValueOutsideRange); переполнение — WordOutsideRange.
--
-- Word { b0, b1, b2, b3 }
-- from_bytes(b0, b1, b2, b3) / from_number(value) / from_signed(value) -> Word
-- from_decimal(text) -> Word; InvalidWordText, WordOutsideRange
-- to_number(word) -> число; is_zero(word) -> yes/no
-- add(left, right) / add_number(word, amount) -> Word; WordOutsideRange
-- negate(word) / shift_left(word, shift) -> Word
-- align(word, boundary) -> Word, boundary — делитель 256; InvalidAlignment
-- align_page(word) -> Word, вверх до 4096
-- text(word) -> десятичный текст; binary_text / byte_binary_text -> биты
-- raw(word) -> u32; of_raw(value) -> Word из u32

use core.str
use core.num
use core.u32
use core.bits32
use core.u8

BYTE = 256

Word = Box {
    b0 = 0,
    b1 = 0,
    b2 = 0,
    b3 = 0
}

skill raw(value) {
    @low = u32.from(value.b0) + u32.from(value.b1) * u32.from(BYTE)
    out low + u32.from(value.b2) * u32.from(65536) + u32.from(value.b3) * u32.from(16777216)
}

skill of_raw(value) {
    @rest = u32.from(value)
    @next = rest / u32.from(BYTE)
    @b0 = num.from(rest - next * u32.from(BYTE))
    rest = next
    next = rest / u32.from(BYTE)
    @b1 = num.from(rest - next * u32.from(BYTE))
    rest = next
    next = rest / u32.from(BYTE)
    @b2 = num.from(rest - next * u32.from(BYTE))
    out from_bytes(b0, b1, b2, num.from(next))
}

skill from_bytes(b0, b1, b2, b3) {
    out Word { b0 = b0, b1 = b1, b2 = b2, b3 = b3 }
}

skill from_number(value) {
    (value < 0) { out error.ValueOutsideRange }
    @b0 = value % 256
    value = value / 256
    @b1 = value % 256
    value = value / 256
    @b2 = value % 256
    value = value / 256
    @b3 = value % 256
    (value / 256 > 0) { out error.WordOutsideRange }
    out from_bytes(b0, b1, b2, b3)
}

skill to_number(value) {
    (value.b3 > 15) { out error.ValueOutsideRange }
    out value.b0 + value.b1 * 256 + value.b2 * 65536 + value.b3 * 16777216
}

skill is_zero(value) {
    (value.b0 > 0) { out no }
    (value.b1 > 0) { out no }
    (value.b2 > 0) { out no }
    out value.b3 == 0
}

skill add(left, right) {
    @sum = raw(left) + raw(right) rescue |err| { out error.WordOutsideRange }
    out of_raw(sum)
}

skill add_number(value, amount) {
    out add(value, from_number(amount))
}

skill align(value, boundary) {
    (boundary < 1) { out error.InvalidAlignment }
    (boundary > 256) { out error.InvalidAlignment }
    (256 % boundary > 0) { out error.InvalidAlignment }
    @remainder = value.b0 % boundary
    (remainder == 0) { out value }
    out add_number(value, boundary - remainder)
}

skill align_page(value) {
    @offset = value.b0 + value.b1 % 16 * 256
    (offset == 0) { out value }
    out add_number(value, 4096 - offset)
}

skill text(value) {
    @whole = raw(value)
    out "{whole}"
}

skill negate(value) {
    (is_zero(value) == yes) { out value }
    out of_raw(u32.from(bits32.invert(bits32.from(raw(value)))) + u32.from(1))
}

skill from_signed(value) {
    (value < 0) { out negate(add_number(from_number(-(value + 1)), 1)) }
    out from_number(value)
}

skill shift_left(value, shift) {
    out of_raw(u32.from(bits32.shift_left(bits32.from(raw(value)), u8.from(shift))))
}

skill from_decimal(text) {
    @length = str.bytes(text)
    (length == 0) { out error.InvalidWordText }
    @negative = str.starts_with(text, "-")
    @first = 0
    (negative == yes) {
        (length == 1) { out error.InvalidWordText }
        first = 1
    }
    @total = u32.from(0)
    drum (length - first) {
        @ch = str.get(text, beat + first)
        (str.is_digit(ch) == no) { out error.InvalidWordText }
        total = total * u32.from(10) + u32.from(num.digit_value(ch)) rescue |err| { out error.WordOutsideRange }
    }
    @result = of_raw(total)
    (negative == yes) {
        (result.b3 > 128) { out error.WordOutsideRange }
        (result.b3 == 128) {
            ((result.b2 == 0) == no) { out error.WordOutsideRange }
            ((result.b1 == 0) == no) { out error.WordOutsideRange }
            ((result.b0 == 0) == no) { out error.WordOutsideRange }
        }
        out negate(result)
    }
    out result
}

skill byte_binary_text(value) {
    @text = ""
    @weight = 128
    drum (8) {
        (value < weight) { text = "{text}0" }
        (value >= weight) {
            text = "{text}1"
            value = value - weight
        }
        weight = weight / 2
    }
    out text
}

skill binary_text(value) {
    @b0 = byte_binary_text(value.b0)
    @b1 = byte_binary_text(value.b1)
    @b2 = byte_binary_text(value.b2)
    @b3 = byte_binary_text(value.b3)
    out "{b0} {b1} {b2} {b3}"
}
