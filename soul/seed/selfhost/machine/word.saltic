-- word — 32-битное слово из четырёх байтов (b0 младший), потому что
-- обычное число 29-битное. Адреса, размеры, кодировки команд.
-- to_number только до 2^28 (ValueOutsideRange); переполнение — WordOutsideRange.
--
-- Word { b0, b1, b2, b3 }
-- from_bytes(b0, b1, b2, b3) / from_number(value) / from_signed(value) -> Word
-- from_decimal(text) -> Word; InvalidWordText, WordOutsideRange
-- to_number(word) -> число; is_zero(word) -> yes/no
-- add(left, right) / add_number(word, amount) -> Word; WordOutsideRange
-- negate(word) / shift_left(word, shift) -> Word
-- align(word, boundary) -> Word, boundary — делитель 256; InvalidAlignment
-- align_page(word) -> Word, вверх до 4096
-- text(word) -> десятичный текст; binary_text / byte_binary_text -> биты

use core.str
use core.num

Word = Box {
    b0 = 0,
    b1 = 0,
    b2 = 0,
    b3 = 0
}

skill from_bytes(b0, b1, b2, b3) {
    out Word { b0 = b0, b1 = b1, b2 = b2, b3 = b3 }
}

skill from_number(value) {
    (value < 0) { out error.ValueOutsideRange }
    @b0 = num.mod(value, 256)
    value = value / 256
    @b1 = num.mod(value, 256)
    value = value / 256
    @b2 = num.mod(value, 256)
    value = value / 256
    @b3 = num.mod(value, 256)
    (value / 256 > 0) { out error.WordOutsideRange }
    out from_bytes(b0, b1, b2, b3)
}

skill to_number(value) {
    (value.b3 > 15) { out error.ValueOutsideRange }
    out value.b0 + value.b1 * 256 + value.b2 * 65536 + value.b3 * 16777216
}

skill is_zero(value) {
    (value.b0 > 0) { out no }
    (value.b1 > 0) { out no }
    (value.b2 > 0) { out no }
    out value.b3 == 0
}

skill add(left, right) {
    @v0 = left.b0 + right.b0
    @v1 = left.b1 + right.b1 + v0 / 256
    @v2 = left.b2 + right.b2 + v1 / 256
    @v3 = left.b3 + right.b3 + v2 / 256
    (v3 > 255) { out error.WordOutsideRange }
    out from_bytes(num.mod(v0, 256), num.mod(v1, 256), num.mod(v2, 256), v3)
}

skill add_number(value, amount) {
    out add(value, from_number(amount))
}

skill align(value, boundary) {
    (boundary < 1) { out error.InvalidAlignment }
    (boundary > 256) { out error.InvalidAlignment }
    (num.mod(256, boundary) > 0) { out error.InvalidAlignment }
    @remainder = num.mod(value.b0, boundary)
    (remainder == 0) { out value }
    out add_number(value, boundary - remainder)
}

skill align_page(value) {
    @offset = value.b0 + num.mod(value.b1, 16) * 256
    (offset == 0) { out value }
    out add_number(value, 4096 - offset)
}

skill text(value) {
    @current = value
    @result = ""
    @active = is_zero(current) == no
    @step = 0
    drum (10) {
        (active == yes) {
            @v3 = current.b3
            @q3 = v3 / 10
            @carry = num.mod(v3, 10)
            @v2 = carry * 256 + current.b2
            @q2 = v2 / 10
            carry = num.mod(v2, 10)
            @v1 = carry * 256 + current.b1
            @q1 = v1 / 10
            carry = num.mod(v1, 10)
            @v0 = carry * 256 + current.b0
            @q0 = v0 / 10
            carry = num.mod(v0, 10)
            result = str.concat(str.get("0123456789", carry), result)
            current = from_bytes(q0, q1, q2, q3)
            active = is_zero(current) == no
        }
        step = step + 1
    }
    (str.bytes(result) == 0) { out "0" }
    out result
}

skill negate(value) {
    @v0 = 256 - value.b0
    @b0 = num.mod(v0, 256)
    @v1 = 255 - value.b1 + v0 / 256
    @b1 = num.mod(v1, 256)
    @v2 = 255 - value.b2 + v1 / 256
    @b2 = num.mod(v2, 256)
    @v3 = 255 - value.b3 + v2 / 256
    out from_bytes(b0, b1, b2, num.mod(v3, 256))
}

skill from_signed(value) {
    (value < 0) { out negate(add_number(from_number(0 - (value + 1)), 1)) }
    out from_number(value)
}

skill shift_left(value, shift) {
    @scale = num.power2(shift)
    @v0 = value.b0 * scale
    @v1 = value.b1 * scale + v0 / 256
    @v2 = value.b2 * scale + v1 / 256
    @v3 = value.b3 * scale + v2 / 256
    out from_bytes(num.mod(v0, 256), num.mod(v1, 256), num.mod(v2, 256), num.mod(v3, 256))
}

skill from_decimal(text) {
    @length = str.bytes(text)
    (length == 0) { out error.InvalidWordText }
    @negative = str.starts_with(text, "-")
    @first = 0
    (negative == yes) {
        (length == 1) { out error.InvalidWordText }
        first = 1
    }
    @result = from_bytes(0, 0, 0, 0)
    drum (length - first) {
        @ch = str.get(text, beat + first)
        (str.is_digit(ch) == no) { out error.InvalidWordText }
        @digit = num.digit(ch)
        @v0 = result.b0 * 10 + digit
        @v1 = result.b1 * 10 + v0 / 256
        @v2 = result.b2 * 10 + v1 / 256
        @v3 = result.b3 * 10 + v2 / 256
        (v3 > 255) { out error.WordOutsideRange }
        result = from_bytes(num.mod(v0, 256), num.mod(v1, 256), num.mod(v2, 256), v3)
    }
    (negative == yes) {
        (result.b3 > 128) { out error.WordOutsideRange }
        (result.b3 == 128) {
            ((result.b2 == 0) == no) { out error.WordOutsideRange }
            ((result.b1 == 0) == no) { out error.WordOutsideRange }
            ((result.b0 == 0) == no) { out error.WordOutsideRange }
        }
        out negate(result)
    }
    out result
}

skill byte_binary_text(value) {
    @text = ""
    @weight = 128
    drum (8) {
        (value < weight) { text = "{text}0" }
        (value >= weight) {
            text = "{text}1"
            value = value - weight
        }
        weight = weight / 2
    }
    out text
}

skill binary_text(value) {
    @b0 = byte_binary_text(value.b0)
    @b1 = byte_binary_text(value.b1)
    @b2 = byte_binary_text(value.b2)
    @b3 = byte_binary_text(value.b3)
    out "{b0} {b1} {b2} {b3}"
}
