use core.str
use core.group

DRUM_BEAT = "beat"

skill strip_location(value) {
    (group.count(value) == 4) {
        (group.get(value, 0) == "loc") { out group.get(value, 3) }
    }
    out value
}

skill plain(value) {
    @datum = value
    (group.count(datum) == 3) {
        (group.get(datum, 0) == "module") { datum = group.get(datum, 2) }
    }
    (group.count(datum) == 3) {
        (group.get(datum, 0) == "typed") { datum = group.get(datum, 2) }
    }
    out strip_location(datum)
}

skill module_name(value) {
    (group.count(value) == 3) {
        (group.get(value, 0) == "module") { out group.get(value, 1) }
    }
    out ""
}

skill location(value) {
    @datum = value
    (group.count(datum) == 3) {
        (group.get(datum, 0) == "module") { datum = group.get(datum, 2) }
    }
    (group.count(datum) == 3) {
        (group.get(datum, 0) == "typed") { datum = group.get(datum, 2) }
    }
    (group.count(datum) == 4) {
        (group.get(datum, 0) == "loc") { out [group.get(datum, 1), group.get(datum, 2)] }
    }
    out [0, 0]
}

skill rebuild(value, datum) {
    (group.count(value) == 3) {
        (group.get(value, 0) == "module") { out ["module", group.get(value, 1), rebuild(group.get(value, 2), datum)] }
        (group.get(value, 0) == "typed") { out ["typed", group.get(value, 1), rebuild(group.get(value, 2), datum)] }
    }
    (group.count(value) == 4) {
        (group.get(value, 0) == "loc") { out ["loc", group.get(value, 1), group.get(value, 2), datum] }
    }
    out datum
}

skill with_part(value, index, child) {
    @datum = plain(value)
    @result = []
    drum (group.count(datum)) {
        pick {
            (beat == index) { result = group.add(result, child) }
            { result = group.add(result, group.get(datum, beat)) }
        }
    }
    out rebuild(value, result)
}

skill typed(type, value) {
    (type == "unknown") { out value }
    out ["typed", type, value]
}

skill type_of(value) {
    (group.count(value) == 3) {
        (group.get(value, 0) == "typed") { out group.get(value, 1) }
    }
    out "unknown"
}

skill located(datum, line, col) {
    out ["loc", line, col, datum]
}

skill in_module(name, value) {
    out ["module", name, value]
}

skill tag(value) {
    out group.get(plain(value), 0)
}

skill part(value, index) {
    out group.get(plain(value), index)
}

skill call_callee(value) {
    out part(value, 1)
}

skill call_argument_count(value) {
    out group.count(plain(value)) - 2
}

skill call_argument(value, index) {
    out part(value, index + 2)
}

skill enum_variant_count(value) {
    out group.count(plain(value)) - 2
}

skill enum_variant(value, index) {
    out part(value, index + 2)
}

skill switch_subject(value) {
    out part(value, 1)
}

skill switch_case_count(value) {
    out group.count(plain(value)) - 2
}

skill switch_case(value, index) {
    out part(value, index + 2)
}

skill case_variant(value) {
    out part(value, 1)
}

skill case_body(value) {
    out part(value, 2)
}

skill path_text(path) {
    @datum = plain(path)
    @text = group.get(datum, 1)
    drum (group.count(datum) - 2) {
        text = "{text}."
        text = str.add(text, group.get(datum, beat + 2))
    }
    out text
}

skill path_prefix(path) {
    @datum = plain(path)
    @count = group.count(datum)
    @text = group.get(datum, 1)
    (count < 3) { out text }
    drum (count - 3) {
        text = "{text}."
        text = str.add(text, group.get(datum, beat + 2))
    }
    out text
}

skill qualified(module_name, name) {
    (str.len(module_name) == 0) { out name }
    out "{module_name}.{name}"
}

skill alias_key(module_name, alias) {
    out "{module_name}|{alias}"
}

skill name_head(name) {
    drum (str.len(name)) {
        (str.get(name, beat) == ".") { out str.slice(name, 0, beat) }
    }
    out name
}

skill name_tail(name) {
    @count = str.len(name)
    drum (count) {
        (str.get(name, beat) == ".") { out str.slice(name, beat, count) }
    }
    out ""
}

skill name_module(name) {
    @count = str.len(name)
    drum (count) {
        @index = count - 1 - beat
        (str.get(name, index) == ".") {
            (index == 0) { out "" }
            out str.slice(name, 0, index)
        }
    }
    out ""
}
