-- model — арифметика кучи без самой кучи: размеры выделений, ёмкость,
-- занятость. Байты выровнены на object.ALIGNMENT (8); отрицательное или
-- невыровненное значение считается ошибкой и даёт no / -1.
-- Константы: DEFAULT_HEAP_BYTES, ARENA_BYTES, ARENA_ALIGNMENT, ESCAPE_*,
-- REGION_EXIT_VALUE_* — их читают рантайм и компилятор.
--
-- Allocation = Box { payload_bytes, bytes, static }
-- aligned(bytes) -> answer
-- allocation_bytes(payload_bytes) -> байты с заголовком или -1
-- create(payload_bytes, static) / static(…) / managed(…) -> Allocation; valid(allocation)
-- valid_capacity(bytes) / valid_usage(capacity, used) -> answer
-- contains(capacity, offset, width) -> answer
-- remaining(capacity, used) -> байты или -1
-- can_allocate / is_exhausted(capacity, used, payload_bytes) -> answer
-- used_after(capacity, used, payload_bytes) -> новая занятость или -1

use selfhost.abi.object
use selfhost.abi.value

ADDRESS_BITS = value.WORD_BITS
ADDRESS_MAXIMUM_TEXT = "4294967295"
ADDRESS_SPACE_BYTES_TEXT = "4294967296"

DEFAULT_HEAP_BYTES = 16777216
ARENA_BYTES = 2097152
ARENA_ALIGNMENT = 256
MINIMUM_HEAP_BYTES = object.HEADER_BYTES
ALIGNMENT = object.ALIGNMENT

ESCAPE_ENTRY_BYTES = value.WORD_BYTES
ESCAPE_SLOT_FLAG = 1
ESCAPE_FLAGS_MASK = 3
ESCAPE_ENTRY_MASK = -4

REGION_EXIT_VALUE_ROOT = 0
REGION_EXIT_VALUE_SKIPPED = 1

Allocation = Box {
    payload_bytes = 0,
    bytes = 0,
    static = no
}

skill aligned(bytes) {
    (bytes < 0) { out no }
    out bytes / ALIGNMENT * ALIGNMENT == bytes
}

skill allocation_bytes(payload_bytes) {
    (payload_bytes < 0) { out -1 }
    out object.allocation_size(payload_bytes)
}

skill valid(allocation) {
    (allocation.payload_bytes < 0) { out no }
    out allocation.bytes == allocation_bytes(allocation.payload_bytes)
}

skill create(payload_bytes, static) {
    out Allocation {
        payload_bytes = payload_bytes,
        bytes = allocation_bytes(payload_bytes),
        static = static
    }
}

skill static(payload_bytes) {
    out create(payload_bytes, yes)
}

skill managed(payload_bytes) {
    out create(payload_bytes, no)
}

skill valid_capacity(bytes) {
    (bytes < MINIMUM_HEAP_BYTES) { out no }
    out aligned(bytes)
}

skill contains(capacity, offset, width) {
    (capacity < 0) { out no }
    (offset < 0) { out no }
    (width < 0) { out no }
    (offset > capacity) { out no }
    (width > capacity - offset) { out no }
    out yes
}

skill valid_usage(capacity, used) {
    (valid_capacity(capacity) == no) { out no }
    (used < 0) { out no }
    (aligned(used) == no) { out no }
    (used > capacity) { out no }
    out yes
}

skill remaining(capacity, used) {
    (valid_usage(capacity, used) == no) { out -1 }
    out capacity - used
}

skill is_exhausted(capacity, used, payload_bytes) {
    out can_allocate(capacity, used, payload_bytes) == no
}

skill can_allocate(capacity, used, payload_bytes) {
    (valid_usage(capacity, used) == no) { out no }
    @bytes = allocation_bytes(payload_bytes)
    (bytes < 0) { out no }
    (bytes > capacity - used) { out no }
    out yes
}

skill used_after(capacity, used, payload_bytes) {
    (can_allocate(capacity, used, payload_bytes) == no) { out -1 }
    out used + allocation_bytes(payload_bytes)
}

