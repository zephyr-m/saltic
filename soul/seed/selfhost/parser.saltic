-- parser — публичное лицо разбора: текст или файл с модулями -> AST.
-- Варианты *_loc оборачивают узлы местом (ast.located) для диагностик.
-- Как программа: program(путь) печатает число узлов и диагностик.
--
-- parse_string / parse_string_loc(source, path) -> syntax.Parsed { ast, diagnostics }
-- load_file / load_file_loc(path, root) -> loader.Load { ast, included, diagnostics }
-- load_modules(path, root) -> то же, что load_file
--
-- Дети: lexer, syntax, loader.

use core.group
use io
use selfhost.parser.syntax
use selfhost.parser.loader

skill parse_string(source, path) {
    out syntax.parse_string(source, path)
}

skill parse_string_loc(source, path) {
    out syntax.parse_string_loc(source, path)
}

skill load_file(path, root) {
    out loader.load_file(path, root)
}

skill load_file_loc(path, root) {
    out loader.load_file_loc(path, root)
}

skill load_modules(path, root) {
    out loader.load_modules(path, root)
}

program(path) {
    @parsed = load_file(path, ".")
    @diagnostic_count = group.count(parsed.diagnostics)

    io.show("элементов AST: ", group.count(parsed.ast))
    io.show("диагностик: ", diagnostic_count)

    (diagnostic_count > 0) {
        out error.ParseFailed
    }

    out none
}
