-- errors — все тексты ошибок компилятора в одном месте: лексер, парсер,
-- загрузчик модулей, чекер, компилятор, toolchain.
-- Каждый навык отдаёт Diagnostic без места (0|0); место добавляет
-- вызывающий через diagnostic.place. Код ошибки — имя навыка (первый аргумент
-- found); у парсера — код из EXPECTED: [код, «чего ждали»], unexpected_token(code, got).
--
-- found(code, message) -> Diagnostic; ok() -> пустая; is_ok(item) -> answer
-- duplicate_alias / duplicate_program / duplicate_global / duplicate_literal_field
-- duplicate_param / duplicate_field / duplicate_box_skill / duplicate_enum_variant
-- missing_program / unknown_name
-- enum_lacks_variant / unknown_namespace / field_on_non_box / unknown_field / maybe_none
-- fraction_not_supported / number_out_of_range / fixed_integer_out_of_range
-- store_type_mismatch / fixed_argument_type_mismatch / field_type_mismatch / fixed_remainder
-- unknown_box / name_taken_by_module / duplicate_variable / variable_shadows_global
-- variable_type_mismatch / constant_assignment / assign_to_global / variable_not_declared
-- pick_branch_not_condition / pick_default_not_last
-- leave_outside_drum / always_outer_value / duplicate_switch_case / unknown_enum_variant / enum_type_mismatch
-- unknown_statement / operator_expects_numbers / long_reference / long_call
-- template_type / address_arithmetic / bits32_operator / operator_mixes_number
-- operator_mixes_fixed / too_many_arguments / too_few_arguments / too_many_for_skill
-- fixed_fraction / fixed_wrong_value / argument_type_mismatch / fixed_escape / drum_type
-- unterminated_string / unterminated_escape / template_expects_name / lone_closing_brace
-- unexpected_symbol / comment_outside_header / unexpected_token / bad_template_name
-- call_field / trailing_comma
-- import_cycle / module_not_found / unresolved_call / missing_label / encoding_failed
-- near_calls_failed / far_calls_failed
--
-- Параметры — подставляемые в текст имена; см. тело навыка.

use core.str
use core.group
use selfhost.diagnostic

EXPECTED = [
    ["expected_open_brace", "ожидалась \{"],
    ["expected_close_brace", "ожидалась \}"],
    ["expected_close_paren", "ожидалась )"],
    ["expected_pipe", "ожидался |"],
    ["expected_skill_name", "ожидалось имя skill"],
    ["expected_expression", "ожидалось выражение"],
    ["expected_statement", "ожидалась инструкция"],
    ["expected_open_paren", "ожидалась ("],
    ["expected_separator", "ожидался разделитель"],
    ["expected_field_equals", "ожидался = после имени поля"],
    ["expected_variable_equals", "ожидался = после имени переменной"],
    ["expected_identifier", "ожидался идентификатор"],
    ["expected_closing_token", "ожидался закрывающий токен"],
    ["expected_pick_branch", "ожидался вариант pick: (условие) \{ \} или \{ \}"],
    ["expected_enum_variant", "ожидался вариант enum"],
    ["expected_arrow", "ожидался =>"],
    ["expected_equals", "ожидался ="],
    ["expected_field_or_skill", "ожидалось поле или skill"],
    ["expected_declaration", "ожидалось объявление верхнего уровня"],
    ["expected_field_name", "ожидалось имя поля"],
    ["expected_variable_name", "ожидалось имя переменной"],
    ["expected_parameter_name", "ожидалось имя параметра"],
    ["expected_rescue_name", "ожидалось имя ошибки rescue"],
    ["expected_present_name", "ожидалось имя значения: (выражение) |имя| и блок"],
    ["expected_enum_value", "ожидалось значение enum"],
    ["expected_program_paren", "ожидалась ( после program"],
    ["expected_pick_close", "ожидалась \} после pick"],
    ["expected_pick_open", "ожидалась \{ после pick"],
    ["expected_drum_paren", "ожидалась ( после drum"],
    ["expected_case_label", "ожидалась метка ветки выбора"],
    ["expected_dot", "ожидалась ."],
    ["field_trailing_comma", "запятая ставится только между полями, после последнего поля её нет"],
    ["missing_field_comma", "между полями нужна запятая"]
]

skill found(code, message) {
    out diagnostic.make(code, 0, 0, message)
}

skill ok() {
    out found("", "")
}

skill is_ok(item) {
    out str.bytes(item.code) == 0
}

skill duplicate_alias(alias) {
    out found("duplicate_alias", "повторный псевдоним модуля '{alias}'")
}

skill duplicate_program() {
    out found("duplicate_program", "повторное объявление program")
}

skill duplicate_global(name) {
    out found("duplicate_global", "повторное имя верхнего уровня '{name}'")
}

skill duplicate_literal_field(field_name, name) {
    out found("duplicate_literal_field", "повторное поле '{field_name}' в литерале Box '{name}'")
}

skill duplicate_param(item) {
    out found("duplicate_param", "повторный параметр '{item}'")
}

skill duplicate_field(field_name, box_name) {
    out found("duplicate_field", "повторное поле '{field_name}' в Box '{box_name}'")
}

skill duplicate_box_skill(skill_name, box_name) {
    out found("duplicate_box_skill", "повторный skill '{skill_name}' в Box '{box_name}'")
}

skill duplicate_enum_variant(variant) {
    out found("duplicate_enum_variant", "вариант '{variant}' уже принадлежит другому enum")
}

skill missing_program() {
    out found("missing_program", "объявление program обязательно")
}

skill unknown_name(name) {
    out found("unknown_name", "неизвестное имя '{name}'")
}

skill enum_lacks_variant(enum_name, variant) {
    out found("enum_lacks_variant", "в enum '{enum_name}' нет варианта '{variant}'")
}

skill unknown_namespace(name) {
    out found("unknown_namespace", "неизвестное пространство имён '{name}'")
}

skill maybe_none(path) {
    out found("maybe_none", "'{path}' может быть пустым (none) — сначала проверь: ({path}) |имя| и блок")
}

skill field_on_non_box(field_name, type_name) {
    out found("field_on_non_box", "нельзя обратиться к полю '{field_name}' у {type_name}")
}

skill unknown_field(box_name, field_name) {
    out found("unknown_field", "в Box '{box_name}' нет поля '{field_name}'")
}

skill fraction_not_supported() {
    out found("fraction_not_supported", "дробные числа в языке не поддерживаются")
}

skill number_out_of_range() {
    out found("number_out_of_range", "обычное число не помещается в непосредственное значение; используй фиксированный целый тип")
}

skill fixed_integer_out_of_range(text, full, range) {
    out found("fixed_integer_out_of_range", "значение {text} не помещается в {full}: допустимо {range}")
}

skill store_type_mismatch(full, expected, actual) {
    out found("store_type_mismatch", "{full} ожидает значение {expected}, получено {actual}")
}

skill fixed_argument_type_mismatch(full, expected_text, actual) {
    out found("fixed_argument_type_mismatch", "{full} ожидает {expected_text}, получено {actual}")
}

skill field_type_mismatch(value_name, field_name, name, field_type) {
    out found("field_type_mismatch", "нельзя присвоить {value_name} полю '{field_name}' Box '{name}' типа {field_type}")
}

skill unknown_box(name) {
    out found("unknown_box", "неизвестный Box '{name}'")
}

skill name_taken_by_module(name, target) {
    out found("name_taken_by_module", "имя '{name}' занято модулем '{target}': назови переменную иначе")
}

skill duplicate_variable(name) {
    out found("duplicate_variable", "переменная '{name}' уже объявлена в этой области")
}

skill variable_shadows_global(name) {
    out found("variable_shadows_global", "переменная '{name}' конфликтует с именем верхнего уровня")
}

skill variable_type_mismatch(value_name, name, old_name) {
    out found("variable_type_mismatch", "нельзя присвоить {value_name} переменной '{name}' типа {old_name}")
}

skill constant_assignment(name) {
    out found("constant_assignment", "нельзя присвоить значение константе '{name}'")
}

skill assign_to_global(name) {
    out found("assign_to_global", "нельзя присвоить значение имени верхнего уровня '{name}'")
}

skill variable_not_declared(name) {
    out found("variable_not_declared", "переменная '{name}' не объявлена")
}

skill pick_branch_not_condition() {
    out found("pick_branch_not_condition", "вариант pick должен быть условием, а не выбором по enum")
}

skill pick_default_not_last() {
    out found("pick_default_not_last", "блок без условия в pick должен быть последним")
}

skill leave_outside_drum() {
    out found("leave_outside_drum", "leave допустим только внутри drum или always")
}

skill always_outer_value(type_name, name) {
    out found("always_outer_value", "в always нельзя присвоить {type_name} внешней переменной '{name}' — память оборота убирается; объяви её внутри always или положи в поле Box")
}

skill duplicate_switch_case(variant_name) {
    out found("duplicate_switch_case", "повторная ветка enum '{variant_name}'")
}

skill unknown_enum_variant(variant_name) {
    out found("unknown_enum_variant", "неизвестный вариант enum '{variant_name}'")
}

skill enum_type_mismatch(variant_name, owner_name, subject_name) {
    out found("enum_type_mismatch", "вариант '{variant_name}' принадлежит {owner_name}, а выбирается {subject_name}")
}

skill unknown_statement(tag) {
    out found("unknown_statement", "неподдерживаемая инструкция {tag}")
}

skill operator_expects_numbers(operator, left_name, right_name) {
    out found("operator_expects_numbers", "оператор '{operator}' ожидает числа, получено {left_name} и {right_name}")
}

skill long_reference(text, module, short) {
    out found("long_reference", "длинный путь '{text}': подключи 'use {module}' и пиши '{short}'")
}

skill long_call(full, module, short) {
    out found("long_call", "длинный путь вызова '{full}': подключи 'use {module}' и пиши '{short}'")
}

skill template_type(placeholder, type) {
    out found("template_type", "в строку можно подставить только текст, число (и фиксированное), yes/no или ошибку, а '{placeholder}' — {type}")
}

skill address_arithmetic() {
    out found("address_arithmetic", "для арифметики адресов используй address.add(address, usize)")
}

skill bits32_operator(operator) {
    out found("bits32_operator", "операция '{operator}' недоступна для bits32: используй операции core.bits32")
}

skill fixed_remainder(type) {
    out found("fixed_remainder", "операция '%' — только для обычных чисел, а здесь {type}")
}

skill operator_mixes_number(operator, fixed_type) {
    out found("operator_mixes_number", "операция '{operator}' не может смешивать {fixed_type} и number")
}

skill operator_mixes_fixed(operator, left_type, right_type) {
    out found("operator_mixes_fixed", "операция '{operator}' требует одинаковые фиксированные целые типы: получены {left_type} и {right_type}")
}

skill too_many_arguments(limit) {
    out found("too_many_arguments", "вызов не может содержать больше {limit} аргументов")
}

skill too_few_arguments(name, minimum, actual) {
    out found("too_few_arguments", "вызов '{name}' ожидает {minimum}, получено {actual}")
}

skill too_many_for_skill(name, maximum, actual) {
    out found("too_many_for_skill", "вызов '{name}' допускает не больше {maximum}, получено {actual}")
}

skill fixed_fraction() {
    out found("fixed_fraction", "фиксированный целый тип не принимает дробное значение")
}

skill fixed_wrong_value(type) {
    out found("fixed_wrong_value", "фиксированный целый тип не принимает {type}")
}

skill argument_type_mismatch(name, position, actual, expected) {
    out found("argument_type_mismatch", "{name}: аргумент {position} — {actual}, ожидается {expected}")
}

skill fixed_escape(type, place) {
    out found("fixed_escape", "{type} нельзя {place}: там фиксированный тип теряется")
}

skill drum_type(type) {
    out found("drum_type", "drum ожидает число или группу, получено {type}")
}

skill unterminated_string() {
    out found("unterminated_string", "незавершённая строка")
}

skill unterminated_escape() {
    out found("unterminated_escape", "незавершённая escape-последовательность")
}

skill template_expects_name() {
    out found("template_expects_name", "в подстановке ожидалось имя: \{имя\} или \{имя.поле\}")
}

skill lone_closing_brace() {
    out found("lone_closing_brace", "одиночная \} в строке: пиши \\\}")
}

skill unexpected_symbol(ch) {
    out found("unexpected_symbol", "неожиданный символ {ch}")
}

skill comment_outside_header() {
    out found("comment_outside_header", "комментарий -- разрешён только в начале файла, до кода")
}

skill unexpected_token(code, got) {
    drum (EXPECTED) {
        (group.get(beat, 0) == code) {
            @text = group.get(beat, 1)
            out found(code, "{text}, получено: {got}")
        }
    }
    out found("unexpected_token", "{code}, получено: {got}")
}

skill call_field() {
    out found("call_field", "поле у результата вызова не берётся: положи результат в переменную — @x = f(), потом x.поле")
}

skill trailing_comma() {
    out found("trailing_comma", "запятая ставится только между элементами, после последнего её нет")
}

skill bad_template_name(part) {
    out found("bad_template_name", "неверное имя в подстановке: {part}")
}

skill import_cycle(name) {
    out found("import_cycle", "модули: циклический импорт: {name}")
}

skill module_not_found(name) {
    out found("module_not_found", "модули: модуль не найден: {name}")
}

skill unresolved_call(call, function) {
    out found("unresolved_call", "компилятор: не найден навык для вызова '{call}' в '{function}'")
}

skill missing_label(label) {
    out found("missing_label", "layout: нет метки {label}")
}

skill encoding_failed(count) {
    out found("encoding_failed", "layout: не удалось закодировать инструкций: {count}")
}

skill near_calls_failed() {
    out found("near_calls_failed", "toolchain: ближние ссылки не разрешились, собираю с дальними вызовами")
}

skill far_calls_failed() {
    out found("far_calls_failed", "toolchain: ссылки не разрешились и с дальними вызовами")
}
