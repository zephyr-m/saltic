-- checker — публичное лицо проверки дерева: имена, типы, правила языка.
-- Вся работа в детях; здесь вход для toolchain и вопрос для компилятора.
--
-- check(ast) -> top_level.Checked { tree, diagnostics }; сообщения главной
--     программы без пути
-- check_file(ast, path) -> то же, сообщения главной программы с путём файла
-- check_wide(ast, path) -> то же для цели с 61-битным числом (RV64): литералы
--     больше 29 бит — обычные числа до 2^60 - 1
-- check_for(ast, path, wide) -> check_file или check_wide по wide
-- box_has_skill(boxes, box_name, skill_name) -> answer
--
-- Дети: top_level (вход), walk (обход тел), types, names, lookup, rules,
-- signatures.

use io
use selfhost.checker.top_level
use selfhost.checker.lookup
use selfhost.checker.names

skill check(ast) {
    out top_level.check(ast, "", no)
}

skill check_file(ast, path) {
    out top_level.check(ast, path, no)
}

skill check_wide(ast, path) {
    out top_level.check(ast, path, yes)
}

skill check_for(ast, path, wide) {
    out top_level.check(ast, path, wide)
}

skill box_has_skill(boxes, box_name, skill_name) {
    @box = names.find(boxes, box_name)
    out lookup.box_node_has_skill(box.node, skill_name)
}

program() {
    io.show("библиотека чекера")
    out none
}
