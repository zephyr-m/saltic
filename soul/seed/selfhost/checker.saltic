use io
use selfhost.checker.top_level
use selfhost.checker.lookup
use selfhost.checker.names

skill check(ast) {
    out top_level.check(ast)
}

skill globals(ast) {
    @collected = top_level.collect(ast)
    out collected.globals
}

skill resolve(name, module, globals) {
    out names.resolve_name(name, module, globals)
}

skill box_has_skill(globals, box_name, skill_name) {
    out lookup.box_has_skill(globals, box_name, skill_name)
}

program() {
    io.show("библиотека чекера")
    out none
}
