-- checker — публичное лицо проверки дерева: имена, типы, правила языка.
-- Вся работа в детях; здесь вход для toolchain и вопрос для компилятора.
--
-- check(ast) -> top_level.Checked { tree, diagnostics }
-- box_has_skill(boxes, box_name, skill_name) -> answer
--
-- Дети: top_level (вход), walk (обход тел), types, names, lookup, rules,
-- signatures.

use io
use selfhost.checker.top_level
use selfhost.checker.lookup
use selfhost.checker.names

skill check(ast) {
    out top_level.check(ast)
}

skill box_has_skill(boxes, box_name, skill_name) {
    @box = names.find(boxes, box_name)
    out lookup.box_node_has_skill(box.node, skill_name)
}

program() {
    io.show("библиотека чекера")
    out none
}
