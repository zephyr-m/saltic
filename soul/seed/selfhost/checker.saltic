use io
use selfhost.checker.semantics
use selfhost.checker.names

skill check(ast) {
    out semantics.check(ast)
}

skill globals(ast) {
    @collected = semantics.collect(ast)
    out collected.globals
}

skill resolve(name, module, globals) {
    out names.resolve_name(name, module, globals)
}

skill box_has_skill(globals, box_name, skill_name) {
    out semantics.box_has_skill(globals, box_name, skill_name)
}

program() {
    io.show("библиотека чекера")
    out none
}
