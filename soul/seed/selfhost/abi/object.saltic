-- object — форма объекта в куче: заголовок 12 байт (вид, байты полезной
-- нагрузки, флаги), затем нагрузка; размер выровнен на 8.
-- Виды: KIND_STRING, KIND_GROUP, KIND_BOX, KIND_TREE; флаг — FLAG_STATIC.
--
-- aligned_size(bytes) -> байты, кратные 8
-- allocation_size(payload_bytes) -> байты с заголовком или -1
-- valid_kind(kind) -> answer
-- has_flag(flags, flag) / valid_flags(flags) -> answer

use core.num

ALIGNMENT = 8

HEADER_KIND_OFFSET = 0
HEADER_PAYLOAD_BYTES_OFFSET = 4
HEADER_FLAGS_OFFSET = 8
HEADER_BYTES = 12
PAYLOAD_OFFSET = HEADER_BYTES

KIND_STRING = 1
KIND_GROUP = 2
KIND_BOX = 3
KIND_TREE = 4

FLAGS_NONE = 0
FLAG_STATIC = 1
FLAGS_MASK = FLAG_STATIC

skill aligned_size(bytes) {
    out num.align(bytes, ALIGNMENT)
}

skill allocation_size(payload_bytes) {
    (payload_bytes < 0) { out -1 }
    out aligned_size(HEADER_BYTES + payload_bytes)
}

skill valid_kind(kind) {
    (kind == KIND_STRING) { out yes }
    (kind == KIND_GROUP) { out yes }
    (kind == KIND_BOX) { out yes }
    (kind == KIND_TREE) { out yes }
    out no
}

skill has_flag(flags, flag) {
    (flag == FLAGS_NONE) { out no }
    (valid_flags(flags) == no) { out no }
    @part = flags / flag
    out part - part / 2 * 2 == 1
}

skill valid_flags(flags) {
    (flags < FLAGS_NONE) { out no }
    (flags > FLAGS_MASK) { out no }
    out yes
}

