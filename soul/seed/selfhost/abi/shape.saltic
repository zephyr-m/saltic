-- shape — раскладка памяти от размера машинного слова: заголовок объекта,
-- слова строки, группы, дерева, Box и ячейки константы. Одна на исполнитель
-- (compiler.words): RV32I и x86-64 в окне — слово 4 байта, RV64 — 8.
-- Заголовок — три поля по 4 байта в одном порядке (вид, байты нагрузки,
-- флаги); на 8-байтном слове к ним 4 байта пустоты, чтобы нагрузка шла с
-- выровненного адреса (решение автора 06.11.2026).
--
-- Words — раскладка; умолчания — слово 4 байта (как abi и constants)
-- of(word_bytes) -> Words для слова 4 или 8 байт

Words = Box {
    bytes = 4,
    shift = 2,
    bits = 32,
    header = 12,
    payload = 12,
    string_data = 4,
    group_items = 4,
    group_item = 4,
    tree_levels = 4,
    tree_root = 8,
    tree_tail = 12,
    tree_payload = 16,
    box_fields = 4,
    box_field_value = 4,
    box_field = 8,
    constant_value = 4,
    constant_storage = 8,
    escape_entry = 4
}

skill of(word_bytes) {
    @header = 12
    @shift = 2
    (word_bytes == 8) {
        header = 16
        shift = 3
    }
    out Words {
        bytes = word_bytes,
        shift = shift,
        bits = word_bytes * 8,
        header = header,
        payload = header,
        string_data = word_bytes,
        group_items = word_bytes,
        group_item = word_bytes,
        tree_levels = word_bytes,
        tree_root = word_bytes * 2,
        tree_tail = word_bytes * 3,
        tree_payload = word_bytes * 4,
        box_fields = word_bytes,
        box_field_value = word_bytes,
        box_field = word_bytes * 2,
        constant_value = word_bytes,
        constant_storage = word_bytes * 2,
        escape_entry = word_bytes
    }
}
