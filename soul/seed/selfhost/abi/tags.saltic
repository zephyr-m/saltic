-- tags — метка типа в младших 3 битах слова: слово = id * 8 + тег.
-- Теги: NUMBER, SMALL, FRACTION, STRING, GROUP, BOX, ENUM, ERROR. SMALL — малые
-- константы, различаются значением: NO (0), YES (1), EMPTY — none (2); FRACTION —
-- дробное (урезанная плавающая, Q-014, Q-038). Готовые слова NO, YES, EMPTY.
--
-- valid(tag) -> answer
-- tagged(id, tag) -> слово или EMPTY при чужом теге
-- id(value) / payload(value) -> старшие биты; tag(value) -> младшие 3 бита

SHIFT = 3
SCALE = 8
MASK = 7
PAYLOAD_MASK = -SCALE

NUMBER = 0
SMALL = 1
FRACTION = 2
STRING = 3
GROUP = 4
BOX = 5
ENUM = 6
ERROR = 7

NO = SMALL
YES = SCALE + SMALL
EMPTY = 2 * SCALE + SMALL

skill valid(tag) {
    (tag < NUMBER) { out no }
    (tag > ERROR) { out no }
    out yes
}

skill tagged(id, tag) {
    (valid(tag) == no) { out EMPTY }
    out id * SCALE + tag
}

skill id(value) {
    out value / SCALE
}

skill tag(value) {
    out value - id(value) * SCALE
}

skill payload(value) {
    out id(value)
}
