-- call — соглашение о вызове: регистры аргументов и результата, кадр стека,
-- итог вызова.
-- Номера регистров — RV32I: аргументы a0… (10…17), не больше 8; результат a0,
-- ошибка a1; стек выровнен на 16 байт. Result — слово плюс тип и error_id;
-- error_id = NO_ERROR значит успех.
--
-- Result = Box { word, type, representation, error_id }
-- argument_register(index) -> номер регистра или -1
-- valid_argument_count(count) -> answer
-- align_stack(bytes) -> байты, кратные 16, или -1
-- frame_bytes(local_count, saved_count) -> байты кадра
-- argument_representation(type) -> value.REPRESENTATION_*
-- valid_call_type(type) -> answer
-- success(word, type) / failure(error_id) -> Result
-- failed(result) / valid_result(result) -> answer

use selfhost.abi.value
use selfhost.abi.errors

WORD_BYTES = value.WORD_BYTES
STACK_ALIGNMENT = 16
ARGUMENT_LIMIT = 8

ZERO_REGISTER = 0
RETURN_ADDRESS_REGISTER = 1
STACK_REGISTER = 2
FRAME_REGISTER = 8
ARGUMENT_REGISTER_FIRST = 10
RETURN_VALUE_REGISTER = 10
RETURN_ERROR_REGISTER = 11
FIXED_SOURCE_KIND_REGISTER = 16
FIXED_TARGET_KIND_REGISTER = 17

NO_ERROR = errors.NO_ERROR

RAW_TYPE_SOURCE = value.TYPE_SOURCE_SIGNATURE
ERROR_REPRESENTATION_RAW_ID = 1

Result = Box {
    word = 0,
    type = "unknown",
    representation = value.REPRESENTATION_UNKNOWN,
    error_id = NO_ERROR
}

skill argument_register(index) {
    (index < 0) { out -1 }
    (index >= ARGUMENT_LIMIT) { out -1 }
    out ARGUMENT_REGISTER_FIRST + index
}

skill valid_argument_count(count) {
    (count < 0) { out no }
    (count > ARGUMENT_LIMIT) { out no }
    out yes
}

skill align_stack(bytes) {
    (bytes < 0) { out -1 }
    @remainder = bytes - bytes / STACK_ALIGNMENT * STACK_ALIGNMENT
    (remainder == 0) { out bytes }
    out bytes + STACK_ALIGNMENT - remainder
}

skill frame_bytes(local_count, saved_count) {
    (local_count < 0) { out -1 }
    (saved_count < 0) { out -1 }
    out align_stack((local_count + saved_count) * WORD_BYTES)
}

skill argument_representation(type) {
    out value.representation(type)
}

skill valid_call_type(type) {
    out argument_representation(type) > value.REPRESENTATION_UNKNOWN
}

skill success(word, type) {
    out Result { word = word, type = type, representation = value.representation(type), error_id = NO_ERROR }
}

skill failure(error_id) {
    @actual = error_id
    (errors.valid_id(actual) == no) { actual = NO_ERROR }
    out Result { word = 0, type = "unknown", representation = value.REPRESENTATION_UNKNOWN, error_id = actual }
}

skill failed(result) {
    out (result.error_id == NO_ERROR) == no
}

skill valid_result(result) {
    (failed(result) == yes) { out errors.valid_id(result.error_id) }
    ((result.error_id == NO_ERROR) == no) { out no }
    (result.representation == value.REPRESENTATION_UNKNOWN) { out no }
    out result.representation == value.representation(result.type)
}
