-- value — представление значения в 32-битном слове: с тегом (number, answer,
-- none, string, group:…, box:…, enum:…, error) или сырое (фиксированные типы).
-- Откуда известен тип: у сырого — из сигнатуры, у тегированного — из тега.
-- Границы обычного числа: NUMBER_MINIMUM_TEXT…NUMBER_MAXIMUM_TEXT (29 бит).
--
-- representation(type) -> REPRESENTATION_TAGGED / RAW / UNKNOWN
-- is_raw(type) / is_tagged(type) / valid_type(type) -> answer
-- type_source(type) -> TYPE_SOURCE_SIGNATURE / TAG / UNKNOWN
-- type_tag(type) -> тег или -1
-- tag_type(tag) -> тип; для group/box/enum — "…:unknown"

use core.str
use core.num
use selfhost.abi.tags
use selfhost.abi.fixed

WORD_BITS = 32
WORD_BYTES = 4

REPRESENTATION_UNKNOWN = 0
REPRESENTATION_TAGGED = 1
REPRESENTATION_RAW = 2

TYPE_SOURCE_UNKNOWN = 0
TYPE_SOURCE_TAG = 1
TYPE_SOURCE_SIGNATURE = 2

NUMBER_MINIMUM_TEXT = "-268435456"
NUMBER_MAXIMUM_TEXT = "268435455"
NUMBER_MAXIMUM = num.MAXIMUM

skill representation(type) {
    (fixed.is_type(type) == yes) { out REPRESENTATION_RAW }
    (type == "number") { out REPRESENTATION_TAGGED }
    (type == "answer") { out REPRESENTATION_TAGGED }
    (type == "none") { out REPRESENTATION_TAGGED }
    (type == "string") { out REPRESENTATION_TAGGED }
    (str.starts_with(type, "group:") == yes) { out REPRESENTATION_TAGGED }
    (str.starts_with(type, "box:") == yes) { out REPRESENTATION_TAGGED }
    (str.starts_with(type, "enum:") == yes) { out REPRESENTATION_TAGGED }
    (type == "error") { out REPRESENTATION_TAGGED }
    out REPRESENTATION_UNKNOWN
}

skill is_raw(type) {
    out representation(type) == REPRESENTATION_RAW
}

skill is_tagged(type) {
    out representation(type) == REPRESENTATION_TAGGED
}

skill type_source(type) {
    (is_raw(type) == yes) { out TYPE_SOURCE_SIGNATURE }
    (is_tagged(type) == yes) { out TYPE_SOURCE_TAG }
    out TYPE_SOURCE_UNKNOWN
}

skill valid_type(type) {
    out representation(type) > REPRESENTATION_UNKNOWN
}

skill type_tag(type) {
    (type == "number") { out tags.NUMBER }
    (type == "answer") { out tags.ANSWER }
    (type == "none") { out tags.NONE }
    (type == "string") { out tags.STRING }
    (str.starts_with(type, "group:") == yes) { out tags.GROUP }
    (str.starts_with(type, "box:") == yes) { out tags.BOX }
    (str.starts_with(type, "enum:") == yes) { out tags.ENUM }
    (type == "error") { out tags.ERROR }
    out -1
}

skill tag_type(tag) {
    (tag == tags.NUMBER) { out "number" }
    (tag == tags.ANSWER) { out "answer" }
    (tag == tags.NONE) { out "none" }
    (tag == tags.STRING) { out "string" }
    (tag == tags.GROUP) { out "group:unknown" }
    (tag == tags.BOX) { out "box:unknown" }
    (tag == tags.ENUM) { out "enum:unknown" }
    (tag == tags.ERROR) { out "error" }
    out "unknown"
}

