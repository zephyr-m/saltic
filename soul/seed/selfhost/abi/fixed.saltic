-- fixed — фиксированные целые типы: u8, u16, u32, i32, bits32, address, usize.
-- Тип — текст, kind — число U8…USIZE; значения для проверки диапазона — текст
-- (десятичный, можно с «-»), чтобы не упираться в 29 бит обычного числа.
-- wide = yes — 64-битная цель (RV64, x86-64): usize и address — всё слово,
-- литерал до WIDE_LITERAL_MAXIMUM (2^60 - 1); на 32-битной цели — до 2^32 - 1.
--
-- is_type(type) -> answer
-- kind(type) -> U8…USIZE или UNKNOWN; type(kind) -> текст или "unknown"
-- valid_kind(kind) -> answer
-- width_bits(type) -> 8, 16, 32 или 0; is_signed(type) -> answer
-- valid_integer_text(text) -> answer
-- unsigned_greater(value, maximum) -> answer; сравнение десятичных текстов
-- in_range(type, text, wide) -> answer
-- range_text(type, wide) -> "0..255" и подобное, "" для чужого типа;
--     word_maximum(wide) -> текст предела usize / address
-- TYPES — одна строка на тип: [имя, kind, ширина, знак, предел отрицательных или "",
--     предел или "word" — word_maximum(wide)]; навыки выше читают её

use core.str
use core.num
use core.group

UNKNOWN = 0
U8 = 1
U16 = 2
U32 = 3
I32 = 4
BITS32 = 5
ADDRESS = 6
USIZE = 7
WIDE_LITERAL_MAXIMUM = "1152921504606846975"

TYPES = [
    ["u8", U8, 8, no, "", "255"],
    ["u16", U16, 16, no, "", "65535"],
    ["u32", U32, 32, no, "", "4294967295"],
    ["i32", I32, 32, yes, "2147483648", "2147483647"],
    ["bits32", BITS32, 32, no, "", "4294967295"],
    ["address", ADDRESS, 32, no, "", "word"],
    ["usize", USIZE, 32, no, "", "word"]
]
NAME = 0
KIND = 1
WIDTH = 2
SIGNED = 3
NEGATIVE_LIMIT = 4
LIMIT = 5

skill row(type) {
    drum (TYPES) {
        (group.get(beat, NAME) == type) { out beat }
    }
    out []
}

skill is_type(type) {
    out group.count(row(type)) > 0
}

skill kind(type) {
    @found = row(type)
    (group.count(found) == 0) { out UNKNOWN }
    out group.get(found, KIND)
}

skill type(kind) {
    drum (TYPES) {
        (group.get(beat, KIND) == kind) { out group.get(beat, NAME) }
    }
    out "unknown"
}

skill valid_kind(kind) {
    (kind < U8) { out no }
    (kind > USIZE) { out no }
    out yes
}

skill width_bits(type) {
    @found = row(type)
    (group.count(found) == 0) { out 0 }
    out group.get(found, WIDTH)
}

skill is_signed(type) {
    @found = row(type)
    (group.count(found) == 0) { out no }
    out group.get(found, SIGNED)
}

skill valid_integer_text(text) {
    @length = str.bytes(text)
    (length == 0) { out no }
    @first = 0
    (str.starts_with(text, "-") == yes) {
        (length == 1) { out no }
        first = 1
    }
    drum (length - first) {
        (str.is_digit(str.get(text, beat + first)) == no) { out no }
    }
    out yes
}

skill unsigned_greater(value, maximum) {
    @value_length = str.bytes(value)
    @maximum_length = str.bytes(maximum)
    (value_length > maximum_length) { out yes }
    (value_length < maximum_length) { out no }
    drum (value_length) {
        @actual = num.digit_value(str.get(value, beat))
        @limit = num.digit_value(str.get(maximum, beat))
        (actual > limit) { out yes }
        (actual < limit) { out no }
    }
    out no
}

skill limit(found, wide) {
    @text = group.get(found, LIMIT)
    (text == "word") { out word_maximum(wide) }
    out text
}

skill in_range(type, text, wide) {
    @found = row(type)
    (group.count(found) == 0) { out no }
    (valid_integer_text(text) == no) { out no }
    (str.starts_with(text, "-") == yes) {
        @negative_limit = group.get(found, NEGATIVE_LIMIT)
        (str.bytes(negative_limit) == 0) { out no }
        out unsigned_greater(str.slice(text, 1, str.bytes(text)), negative_limit) == no
    }
    out unsigned_greater(text, limit(found, wide)) == no
}

skill range_text(type, wide) {
    @found = row(type)
    (group.count(found) == 0) { out "" }
    @maximum = limit(found, wide)
    (group.get(found, SIGNED) == yes) {
        @minimum = group.get(found, NEGATIVE_LIMIT)
        out "-{minimum}..{maximum}"
    }
    out "0..{maximum}"
}

skill word_maximum(wide) {
    (wide == yes) { out WIDE_LITERAL_MAXIMUM }
    out "4294967295"
}
