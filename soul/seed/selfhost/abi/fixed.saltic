-- fixed — фиксированные целые типы: u8, u16, u32, i32, bits32, address, usize.
-- Тип — текст, kind — число U8…USIZE; значения для проверки диапазона — текст
-- (десятичный, можно с «-»), чтобы не упираться в 29 бит обычного числа.
--
-- is_type(type) -> answer
-- kind(type) -> U8…USIZE или UNKNOWN; type(kind) -> текст или "unknown"
-- valid_kind(kind) -> answer
-- width_bits(type) -> 8, 16, 32 или 0; is_signed(type) -> answer
-- valid_integer_text(text) -> answer
-- unsigned_greater(value, maximum) -> answer; сравнение десятичных текстов
-- in_range(type, text) -> answer
-- range_text(type) -> "0..255" и подобное, "" для чужого типа

use core.str
use core.num

UNKNOWN = 0
U8 = 1
U16 = 2
U32 = 3
I32 = 4
BITS32 = 5
ADDRESS = 6
USIZE = 7

skill is_type(type) {
    (type == "u8") { out yes }
    (type == "u16") { out yes }
    (type == "u32") { out yes }
    (type == "i32") { out yes }
    (type == "bits32") { out yes }
    (type == "address") { out yes }
    (type == "usize") { out yes }
    out no
}

skill kind(type) {
    (type == "u8") { out U8 }
    (type == "u16") { out U16 }
    (type == "u32") { out U32 }
    (type == "i32") { out I32 }
    (type == "bits32") { out BITS32 }
    (type == "address") { out ADDRESS }
    (type == "usize") { out USIZE }
    out UNKNOWN
}

skill type(kind) {
    (kind == U8) { out "u8" }
    (kind == U16) { out "u16" }
    (kind == U32) { out "u32" }
    (kind == I32) { out "i32" }
    (kind == BITS32) { out "bits32" }
    (kind == ADDRESS) { out "address" }
    (kind == USIZE) { out "usize" }
    out "unknown"
}

skill valid_kind(kind) {
    (kind < U8) { out no }
    (kind > USIZE) { out no }
    out yes
}

skill width_bits(type) {
    (type == "u8") { out 8 }
    (type == "u16") { out 16 }
    (is_type(type) == yes) { out 32 }
    out 0
}

skill is_signed(type) {
    out type == "i32"
}

skill valid_integer_text(text) {
    @length = str.len(text)
    (length == 0) { out no }
    @first = 0
    (str.starts_with(text, "-") == yes) {
        (length == 1) { out no }
        first = 1
    }
    drum (length - first) {
        (str.is_digit(str.get(text, beat + first)) == no) { out no }
    }
    out yes
}

skill unsigned_greater(value, maximum) {
    @value_length = str.len(value)
    @maximum_length = str.len(maximum)
    (value_length > maximum_length) { out yes }
    (value_length < maximum_length) { out no }
    drum (value_length) {
        @actual = num.digit(str.get(value, beat))
        @limit = num.digit(str.get(maximum, beat))
        (actual > limit) { out yes }
        (actual < limit) { out no }
    }
    out no
}

skill in_range(type, text) {
    (is_type(type) == no) { out no }
    (valid_integer_text(text) == no) { out no }
    @negative = str.starts_with(text, "-")
    @magnitude = text
    (negative == yes) { magnitude = str.slice(text, 1, str.len(text)) }
    (type == "u8") { (negative == yes) { out no } out unsigned_greater(magnitude, "255") == no }
    (type == "u16") { (negative == yes) { out no } out unsigned_greater(magnitude, "65535") == no }
    (type == "u32") { (negative == yes) { out no } out unsigned_greater(magnitude, "4294967295") == no }
    (type == "bits32") { (negative == yes) { out no } out unsigned_greater(magnitude, "4294967295") == no }
    (type == "address") { (negative == yes) { out no } out unsigned_greater(magnitude, "4294967295") == no }
    (type == "usize") { (negative == yes) { out no } out unsigned_greater(magnitude, "4294967295") == no }
    (type == "i32") {
        (negative == yes) { out unsigned_greater(magnitude, "2147483648") == no }
        out unsigned_greater(magnitude, "2147483647") == no
    }
    out no
}

skill range_text(type) {
    (type == "u8") { out "0..255" }
    (type == "u16") { out "0..65535" }
    (type == "i32") { out "-2147483648..2147483647" }
    (type == "u32") { out "0..4294967295" }
    (type == "bits32") { out "0..4294967295" }
    (type == "address") { out "0..4294967295" }
    (type == "usize") { out "0..4294967295" }
    out ""
}
