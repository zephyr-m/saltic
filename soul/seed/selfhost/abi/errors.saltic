use core.group
use selfhost.abi.tags

NO_ERROR = 0
MISSING_FIELD = 1
GROUP_BOUNDS = 2
DIVISION_BY_ZERO = 3
FILE = 4
STRING_BOUNDS = 5
FIXED_INTEGER_OVERFLOW = 6
CONSTANT_CYCLE = 7
MEMORY_EXHAUSTED = 8
NEGATIVE_COUNT = 9
NO_METHOD = 10
NUMBER_OVERFLOW = 11

SYSTEM_FIRST = MISSING_FIELD
SYSTEM_LAST = NUMBER_OVERFLOW
USER_FIRST = SYSTEM_LAST + 1
MAXIMUM_TEXT = "268435455"
SYSTEM_NAMES = ["", "MissingField", "GroupBounds", "DivisionByZero", "File", "StringBounds", "FixedIntegerOverflow", "ConstantCycle", "MemoryExhausted", "NegativeCount", "NoMethod", "NumberOverflow"]

skill valid_id(id) {
    (id < SYSTEM_FIRST) { out no }
    out yes
}

skill value(id) {
    (valid_id(id) == no) { out tags.EMPTY }
    out tags.tagged(id, tags.ERROR)
}

skill user_id(index) {
    (index < 0) { out NO_ERROR }
    out USER_FIRST + index
}

skill user_value(index) {
    out value(user_id(index))
}

skill is_system(id) {
    (id < SYSTEM_FIRST) { out no }
    (id > SYSTEM_LAST) { out no }
    out yes
}

skill system_id(name) {
    drum (group.count(SYSTEM_NAMES)) {
        (beat > 0) {
            (group.get(SYSTEM_NAMES, beat) == name) { out beat }
        }
    }
    out NO_ERROR
}

skill is_user(id) {
    (id < USER_FIRST) { out no }
    out yes
}
