-- errors — номера ошибок рантайма: системные 1…21 (SYSTEM_NAMES; 14 — EmptyTouched,
-- «тронуто пустое»: поле или запись у none; 15 — FixedTooBig: фиксированное не
-- влезло в обычное число при упаковке в поле Box или группу; 16 — ArenaBounds:
-- сдвиг core.arena вне арены; 17 — FractionOverflow: дробное вышло за double;
-- 18…20 — BytesBounds, ByteOutsideRange, InvalidSize у core.bytes; 21 — TypeMismatch:
-- + - * / % < > <= >= над не-числом, где чекер тип не знает, Q-026), пользовательские
-- с USER_FIRST дальше. Слово ошибки — id с тегом ERROR; 0 значит «нет ошибки».
--
-- valid_id(id) -> answer
-- value(id) -> слово с тегом ERROR или tags.EMPTY
-- user_id(index) -> id; user_value(index) -> слово
-- is_system(id) / is_user(id) -> answer
-- system_id(name) -> id по имени из SYSTEM_NAMES или NO_ERROR

use core.group
use selfhost.abi.tags
use selfhost.abi.value

NO_ERROR = 0
MISSING_FIELD = 1
GROUP_BOUNDS = 2
DIVISION_BY_ZERO = 3
FILE = 4
STRING_BOUNDS = 5
FIXED_INTEGER_OVERFLOW = 6
CONSTANT_CYCLE = 7
MEMORY_EXHAUSTED = 8
NEGATIVE_COUNT = 9
NO_METHOD = 10
NUMBER_OVERFLOW = 11
NOT_SUPPORTED = 12
PROCESS = 13
EMPTY_TOUCHED = 14
FIXED_TOO_BIG = 15
ARENA_BOUNDS = 16
FRACTION_OVERFLOW = 17
BYTES_BOUNDS = 18
BYTE_OUTSIDE_RANGE = 19
INVALID_SIZE = 20
TYPE_MISMATCH = 21

SYSTEM_FIRST = MISSING_FIELD
SYSTEM_LAST = TYPE_MISMATCH
USER_FIRST = SYSTEM_LAST + 1
MAXIMUM_TEXT = value.NUMBER_MAXIMUM_TEXT
SYSTEM_NAMES = ["", "MissingField", "GroupBounds", "DivisionByZero", "File", "StringBounds", "FixedIntegerOverflow", "ConstantCycle", "MemoryExhausted", "NegativeCount", "NoMethod", "NumberOverflow", "NotSupported", "Process", "EmptyTouched", "FixedTooBig", "ArenaBounds", "FractionOverflow", "BytesBounds", "ByteOutsideRange", "InvalidSize", "TypeMismatch"]

skill valid_id(id) {
    (id < SYSTEM_FIRST) { out no }
    out yes
}

skill value(id) {
    (valid_id(id) == no) { out tags.EMPTY }
    out tags.tagged(id, tags.ERROR)
}

skill user_id(index) {
    (index < 0) { out NO_ERROR }
    out USER_FIRST + index
}

skill user_value(index) {
    out value(user_id(index))
}

skill is_system(id) {
    (id < SYSTEM_FIRST) { out no }
    (id > SYSTEM_LAST) { out no }
    out yes
}

skill system_id(name) {
    drum (group.count(SYSTEM_NAMES)) {
        (beat > 0) {
            (group.get(SYSTEM_NAMES, beat) == name) { out beat }
        }
    }
    out NO_ERROR
}

skill is_user(id) {
    (id < USER_FIRST) { out no }
    out yes
}
