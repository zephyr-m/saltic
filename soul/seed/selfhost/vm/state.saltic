use core.str
use core.group
use core.num

PAGE_SIZE = 256
HEX = "0123456789abcdef"
PRINTABLE = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|\}~"

Mode = enum {
    PROCESS,
    MACHINE,
}

Word = Box {
    b0 = 0,
    b1 = 0,
    b2 = 0,
    b3 = 0
}

Byte = Box {
    value = 0
}

Page = Box {
    index = 0,
    present = no,
    cells = []
}

Memory = Box {
    base = Word {},
    size = 0,
    pages = []
}

File = Box {
    path = "",
    data = []
}

Name = Box {
    text = "",
    data = [],
    present = no
}

Handle = Box {
    guest_fd = 0,
    file_index = 0,
    position = 0,
    readable = no,
    writable = no,
    append = no,
    open = no
}

Options = Box {
    mode = Mode.PROCESS,
    memory_base = Word {},
    load_address = 4096,
    memory_size = 262144,
    step_limit = 100000,
    program_name = "program",
    arguments = [],
    files = []
}

Result = Box {
    exit_code = 0,
    reason = "",
    pc = "00000000",
    steps = 0,
    registers = [],
    stdout = [],
    stderr = [],
    files = [],
    trap = ""
}

Machine = Box {
    mode = Mode.PROCESS,
    memory = Memory {},
    registers = [],
    pc = 0,
    halted = no,
    halt_reason = "",
    exit_code = 0,
    steps = 0,
    trap = "",
    stdout = [],
    stderr = [],
    files = [],
    names = [],
    handles = [],
    next_fd = 3,
    mstatus = Word {},
    mtvec = Word {},
    mepc = Word {},
    mcause = Word {}
}

Instruction = Box {
    word = Word {},
    kind = 0,
    opcode = 0,
    rd = 0,
    funct3 = 0,
    rs1 = 0,
    rs2 = 0,
    funct7 = 0,
    system = 0
}

Control = Box {
    next_pc = 0,
    handled = no
}

skill word_bytes(b0, b1, b2, b3) {
    out Word { b0 = b0, b1 = b1, b2 = b2, b3 = b3 }
}

skill word_zero() {
    out Word {}
}

skill word_copy(word) {
    out word_bytes(word.b0, word.b1, word.b2, word.b3)
}

skill word_assign(target, value) {
    target.b0 = value.b0
    target.b1 = value.b1
    target.b2 = value.b2
    target.b3 = value.b3
    out none
}

skill byte_and(left, right) {
    @a = left
    @b = right
    @weight = 1
    @result = 0
    drum (8) {
        @a_bit = num.mod(a, 2)
        @b_bit = num.mod(b, 2)
        (a_bit == 1) {
            (b_bit == 1) { result = result + weight }
        }
        a = a / 2
        b = b / 2
        weight = weight * 2
    }
    out result
}

skill byte_or(left, right) {
    @a = left
    @b = right
    @weight = 1
    @result = 0
    drum (8) {
        @bits = num.mod(a, 2) + num.mod(b, 2)
        (bits > 0) { result = result + weight }
        a = a / 2
        b = b / 2
        weight = weight * 2
    }
    out result
}

skill byte_xor(left, right) {
    @a = left
    @b = right
    @weight = 1
    @result = 0
    drum (8) {
        @bits = num.mod(a, 2) + num.mod(b, 2)
        (bits == 1) { result = result + weight }
        a = a / 2
        b = b / 2
        weight = weight * 2
    }
    out result
}

skill word_not(word) {
    out word_bytes(255 - word.b0, 255 - word.b1, 255 - word.b2, 255 - word.b3)
}

skill word_add(left, right) {
    @v0 = left.b0 + right.b0
    @c0 = v0 / 256
    @v1 = left.b1 + right.b1 + c0
    @c1 = v1 / 256
    @v2 = left.b2 + right.b2 + c1
    @c2 = v2 / 256
    @v3 = left.b3 + right.b3 + c2
    out word_bytes(num.mod(v0, 256), num.mod(v1, 256), num.mod(v2, 256), num.mod(v3, 256))
}

skill word_negate(word) {
    out word_add(word_not(word), word_bytes(1, 0, 0, 0))
}

skill word_number(value) {
    @negative = no
    @current = value
    (current < 0) { negative = yes current = 0 - current }
    @b0 = num.mod(current, 256)
    current = current / 256
    @b1 = num.mod(current, 256)
    current = current / 256
    @b2 = num.mod(current, 256)
    current = current / 256
    @b3 = num.mod(current, 256)
    @word = word_bytes(b0, b1, b2, b3)
    (negative == yes) { out word_negate(word) }
    out word
}

skill word_sub(left, right) {
    out word_add(left, word_negate(right))
}

skill word_and(left, right) {
    out word_bytes(byte_and(left.b0, right.b0), byte_and(left.b1, right.b1), byte_and(left.b2, right.b2), byte_and(left.b3, right.b3))
}

skill word_or(left, right) {
    out word_bytes(byte_or(left.b0, right.b0), byte_or(left.b1, right.b1), byte_or(left.b2, right.b2), byte_or(left.b3, right.b3))
}

skill word_xor(left, right) {
    out word_bytes(byte_xor(left.b0, right.b0), byte_xor(left.b1, right.b1), byte_xor(left.b2, right.b2), byte_xor(left.b3, right.b3))
}

skill word_shift_left_one(word) {
    @c0 = word.b0 / 128
    @c1 = word.b1 / 128
    @c2 = word.b2 / 128
    out word_bytes(num.mod(word.b0 * 2, 256), num.mod(word.b1 * 2 + c0, 256), num.mod(word.b2 * 2 + c1, 256), num.mod(word.b3 * 2 + c2, 256))
}

skill word_shift_right_one(word) {
    out word_bytes(word.b0 / 2 + num.mod(word.b1, 2) * 128, word.b1 / 2 + num.mod(word.b2, 2) * 128, word.b2 / 2 + num.mod(word.b3, 2) * 128, word.b3 / 2)
}

skill word_shift_right_arithmetic_one(word) {
    @high = word.b3 / 2
    (word.b3 > 127) { high = high + 128 }
    out word_bytes(word.b0 / 2 + num.mod(word.b1, 2) * 128, word.b1 / 2 + num.mod(word.b2, 2) * 128, word.b2 / 2 + num.mod(word.b3, 2) * 128, high)
}

skill word_shift_left(word, amount) {
    @result = word_copy(word)
    drum (amount) { result = word_shift_left_one(result) }
    out result
}

skill word_shift_right(word, amount) {
    @result = word_copy(word)
    drum (amount) { result = word_shift_right_one(result) }
    out result
}

skill word_shift_right_arithmetic(word, amount) {
    @result = word_copy(word)
    drum (amount) { result = word_shift_right_arithmetic_one(result) }
    out result
}

skill word_equal(left, right) {
    (left.b0 == right.b0) {
        (left.b1 == right.b1) {
            (left.b2 == right.b2) {
                (left.b3 == right.b3) { out yes }
            }
        }
    }
    out no
}

skill word_unsigned_less(left, right) {
    (left.b3 < right.b3) { out yes }
    (left.b3 > right.b3) { out no }
    (left.b2 < right.b2) { out yes }
    (left.b2 > right.b2) { out no }
    (left.b1 < right.b1) { out yes }
    (left.b1 > right.b1) { out no }
    out left.b0 < right.b0
}

skill word_signed_less(left, right) {
    @left_negative = left.b3 > 127
    @right_negative = right.b3 > 127
    (left_negative == yes) {
        (right_negative == no) { out yes }
    }
    (left_negative == no) {
        (right_negative == yes) { out no }
    }
    out word_unsigned_less(left, right)
}

skill word_address(word) {
    (word.b3 > 15) { out -1 }
    out word.b0 + word.b1 * 256 + word.b2 * 65536 + word.b3 * 16777216
}

skill word_signed_number(word) {
    (word.b3 < 128) { out word_address(word) }
    @magnitude = word_address(word_negate(word))
    out 0 - magnitude
}

skill memory_offset(memory, address) {
    out word_address(word_sub(address, memory.base))
}

skill memory_address(memory, offset) {
    out word_add(memory.base, word_number(offset))
}

skill pc_word(machine) {
    out memory_address(machine.memory, machine.pc)
}

skill word_hex(word) {
    @text = str.get(HEX, word.b3 / 16)
    text = str.add(text, str.get(HEX, num.mod(word.b3, 16)))
    text = str.add(text, str.get(HEX, word.b2 / 16))
    text = str.add(text, str.get(HEX, num.mod(word.b2, 16)))
    text = str.add(text, str.get(HEX, word.b1 / 16))
    text = str.add(text, str.get(HEX, num.mod(word.b1, 16)))
    text = str.add(text, str.get(HEX, word.b0 / 16))
    out str.add(text, str.get(HEX, num.mod(word.b0, 16)))
}

skill number_hex(value) {
    out word_hex(word_number(value))
}

skill memory_page(memory, page_index, create) {
    drum (memory.pages) {
        (beat.index == page_index) { out beat }
    }
    (create == yes) {
        @cells = []
        drum (PAGE_SIZE) { cells = group.add(cells, Byte {}) }
        @page = Page { index = page_index, present = yes, cells = cells }
        memory.pages = group.add(memory.pages, page)
        out page
    }
    out Page {}
}

skill memory_raw_load8(memory, address) {
    @page = memory_page(memory, address / PAGE_SIZE, no)
    (page.present == no) { out 0 }
    @cell = group.get(page.cells, num.mod(address, PAGE_SIZE))
    out cell.value
}

skill memory_raw_store8(memory, address, value) {
    @page = memory_page(memory, address / PAGE_SIZE, no)
    (page.present == no) {
        (num.mod(value, 256) == 0) { out none }
        page = memory_page(memory, address / PAGE_SIZE, yes)
    }
    @cell = group.get(page.cells, num.mod(address, PAGE_SIZE))
    cell.value = num.mod(value, 256)
    out none
}

skill memory_fill_zero(memory, address, size) {
    @end = address + size
    drum (memory.pages) {
        @page = beat
        @page_address = page.index * PAGE_SIZE
        @overlaps = yes
        (page_address > end - 1) { overlaps = no }
        (page_address + PAGE_SIZE < address + 1) { overlaps = no }
        (overlaps == yes) {
            drum (PAGE_SIZE) {
                @cell_address = page_address + beat
                @inside = yes
                (cell_address < address) { inside = no }
                (cell_address > end - 1) { inside = no }
                (inside == yes) {
                    @cell = group.get(page.cells, beat)
                    cell.value = 0
                }
            }
        }
    }
    out none
}

skill trap(machine, reason, detail) {
    @pc = word_hex(pc_word(machine))
    @message = "{reason} по адресу 0x{pc}"
    (str.len(detail) > 0) { message = "{message}: {detail}" }
    machine.trap = message
    machine.halted = yes
    out none
}

skill memory_check(machine, address, size, alignment, access) {
    @valid = yes
    (address < 0) { valid = no }
    (address > machine.memory.size - size) { valid = no }
    (valid == no) {
        @first = number_hex(address)
        @last = number_hex(address + size - 1)
        trap(machine, "ошибка доступа: {access}", "обращение к памяти 0x{first}..0x{last} выходит за пределы ОЗУ")
        out no
    }
    (num.mod(address, alignment) > 0) {
        @where = number_hex(address)
        trap(machine, "ошибка доступа: {access}", "невыровненный доступ размером {alignment} байт по адресу 0x{where}")
        out no
    }
    out yes
}

skill memory_translate(machine, address, size, alignment, access) {
    @offset = memory_offset(machine.memory, address)
    @valid = yes
    (offset < 0) { valid = no }
    (offset > machine.memory.size - size) { valid = no }
    (valid == no) {
        @first = word_hex(address)
        @last = word_hex(word_add(address, word_number(size - 1)))
        trap(machine, "ошибка доступа: {access}", "обращение к памяти 0x{first}..0x{last} выходит за пределы ОЗУ")
        out -1
    }
    (num.mod(address.b0, alignment) > 0) {
        @where = word_hex(address)
        trap(machine, "ошибка доступа: {access}", "невыровненный доступ размером {alignment} байт по адресу 0x{where}")
        out -1
    }
    out offset
}

skill memory_load_word(memory, address) {
    out word_bytes(memory_raw_load8(memory, address), memory_raw_load8(memory, address + 1), memory_raw_load8(memory, address + 2), memory_raw_load8(memory, address + 3))
}

skill memory_store_word(memory, address, word, size) {
    memory_raw_store8(memory, address, word.b0)
    (size > 1) { memory_raw_store8(memory, address + 1, word.b1) }
    (size > 2) {
        memory_raw_store8(memory, address + 2, word.b2)
        memory_raw_store8(memory, address + 3, word.b3)
    }
    out none
}

skill register(machine, index) {
    (index == 0) { out word_zero() }
    out group.get(machine.registers, index)
}

skill set_register(machine, index, word) {
    (index > 0) {
        @target = group.get(machine.registers, index)
        target.b0 = word.b0
        target.b1 = word.b1
        target.b2 = word.b2
        target.b3 = word.b3
    }
    out none
}

skill ascii_code(ch) {
    (ch == "\n") { out 10 }
    (ch == "\t") { out 9 }
    drum (str.len(PRINTABLE)) {
        (str.get(PRINTABLE, beat) == ch) { out beat + 32 }
    }
    out 0
}

skill text_bytes(text) {
    @bytes = []
    drum (str.len(text)) { bytes = group.add(bytes, ascii_code(str.get(text, beat))) }
    out bytes
}

skill name_add(machine, text) {
    drum (machine.names) {
        (beat.text == text) { out beat.data }
    }
    @data = text_bytes(text)
    machine.names = group.add(machine.names, Name { text = text, data = data, present = yes })
    out data
}

skill new_machine(options) {
    @registers = []
    drum (32) { registers = group.add(registers, word_zero()) }
    @machine = Machine {
        mode = options.mode,
        memory = Memory { base = options.memory_base, size = options.memory_size, pages = [] },
        registers = registers,
        files = options.files
    }
    name_add(machine, options.program_name)
    drum (options.arguments) { name_add(machine, beat) }
    drum (options.files) { name_add(machine, beat.path) }
    out machine
}
