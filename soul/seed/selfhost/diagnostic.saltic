-- diagnostic — сообщение об ошибке с кодом и местом в исходнике.
-- Выводится toolchain как «код|строка|столбец|сообщение»; путь файла и имя
-- модуля приписываются к тексту сообщения, а не хранятся отдельно.
--
-- Diagnostic = Box { code, message, line, col }
-- make(code, line, col, message) -> Diagnostic
-- make_at(code, path, line, col, message) -> Diagnostic с «path: » в тексте
-- place(item, path, line, col) -> Diagnostic из item (ошибка без места) с местом
-- in_module(items, first, module) -> группа, где к items[first…] приписан модуль
-- has(items) -> answer

use core.str
use core.group

Diagnostic = Box {
    code = "language_error",
    message = "",
    line = 0,
    col = 0
}

skill make(code, line, col, message) {
    out Diagnostic {
        code = code,
        message = message,
        line = line,
        col = col
    }
}

skill make_at(code, path, line, col, message) {
    @text = message
    (str.len(path) > 0) { text = "{path}: {message}" }
    out make(code, line, col, text)
}

skill place(item, path, line, col) {
    out make_at(item.code, path, line, col, item.message)
}

skill in_module(items, first, module) {
    (str.len(module) == 0) { out items }
    @result = []
    drum (group.count(items)) {
        @item = group.get(items, beat)
        ((beat < first) == no) { item.message = "{module}: {item.message}" }
        result = group.add(result, item)
    }
    out result
}

skill has(items) {
    out group.count(items) > 0
}
