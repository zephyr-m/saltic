use core.str
use core.group

Diagnostic = Box {
    code = "language_error",
    message = "",
    line = 0,
    col = 0
}

skill make(code, line, col, message) {
    out Diagnostic {
        code = code,
        message = message,
        line = line,
        col = col
    }
}

skill make_at(code, path, line, col, message) {
    @text = message
    (str.len(path) > 0) { text = "{path}: {message}" }
    out make(code, line, col, text)
}

skill in_module(items, first, module) {
    (str.len(module) == 0) { out items }
    @result = []
    drum (group.count(items)) {
        @item = group.get(items, beat)
        ((beat < first) == no) { item.message = "{module}: {item.message}" }
        result = group.add(result, item)
    }
    out result
}

skill has(items) {
    out group.count(items) > 0
}
