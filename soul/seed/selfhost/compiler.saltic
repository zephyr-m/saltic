-- compiler — собирает проверенный AST в машину RV32I (state.State.machine).
-- Порядок внутри: collect_top_level → header → start → навыки → константы →
-- рантайм (обычный или common) → хранилище констант → finish_data.
-- heap_bytes — слово word (b0…b3), кратное model.ALIGNMENT и не меньше
-- model.MINIMUM_HEAP_BYTES; иначе ValueOutsideRange.
--
-- valid_heap_size(heap_bytes) -> yes/no
-- compile_state_with_options(ast, heap_bytes, common, far_calls) -> State;
--     ValueOutsideRange. common = yes — общий рантайм (emit_runtime_common),
--     far_calls — дальние вызовы в machine
-- compile_state_with_heap / compile_common_state_with_heap(ast, heap_bytes) -> State
-- compile_machine_with_heap / compile_machine_common_with_heap(ast, heap_bytes) -> machine
-- compile_machine_far_with_heap(ast, heap_bytes, common) -> machine с far_calls
--
-- Дети: state, constants, functions, codegen, backend (рантайм RV32I — в backend/rv32i/runtime).

use io
use selfhost.compiler.state
use selfhost.compiler.constants
use selfhost.compiler.backend.rv32i.runtime
use selfhost.memory.model
use core.num
use selfhost.machine.word
use selfhost.compiler.functions

skill valid_heap_size(heap_bytes) {
    (num.mod(heap_bytes.b0, model.ALIGNMENT) > 0) { out no }
    (heap_bytes.b3 > 0) { out yes }
    (heap_bytes.b2 > 0) { out yes }
    (heap_bytes.b1 > 0) { out yes }
    (heap_bytes.b0 < model.MINIMUM_HEAP_BYTES) { out no }
    out yes
}

skill compile_state_with_options(ast, heap_bytes, common, far_calls) {
    (valid_heap_size(heap_bytes) == no) { out error.ValueOutsideRange }
    @compiler = state.State { ast = ast, heap_bytes = heap_bytes }
    compiler = state.collect_top_level(compiler)
    compiler = state.header(compiler)
    compiler.machine.far_calls = far_calls
    compiler = state.start(compiler)
    compiler = functions.compile_functions(compiler)
    compiler = functions.compile_constants(compiler)
    (common == no) { compiler = runtime.append_runtime(compiler) }
    (common == yes) { compiler = runtime.append_runtime_common(compiler) }
    compiler = constants.emit_storage(compiler)
    compiler = state.finish_data(compiler)
    out compiler
}

skill compile_state_with_heap(ast, heap_bytes) {
    out compile_state_with_options(ast, heap_bytes, no, no)
}

skill compile_common_state_with_heap(ast, heap_bytes) {
    out compile_state_with_options(ast, heap_bytes, yes, no)
}

skill compile_machine_with_heap(ast, heap_bytes) {
    @compiler = compile_state_with_heap(ast, heap_bytes)
    out compiler.machine
}

skill compile_machine_common_with_heap(ast, heap_bytes) {
    @compiler = compile_common_state_with_heap(ast, heap_bytes)
    out compiler.machine
}

skill compile_machine_far_with_heap(ast, heap_bytes, common) {
    @compiler = compile_state_with_options(ast, heap_bytes, common, yes)
    out compiler.machine
}

program() {
    io.show("библиотека компилятора")
    out none
}
