-- compiler — собирает проверенный AST в машину (state.State.machine) через
-- исполнителя договора машины (backend) и платформу (platform): оба — Box
-- с методами, выбирает цель (toolchain).
-- Порядок внутри: collect_top_level → header → start → навыки → константы →
-- рантайм → платформа → хранилище констант → finish_data.
-- heap_bytes — слово word (b0…b3), кратное model.ALIGNMENT и не меньше
-- model.MINIMUM_HEAP_BYTES; иначе ValueOutsideRange.
--
-- valid_heap_size(heap_bytes) -> yes/no
-- compile_state(ast, heap_bytes, executor, platform) -> State; ValueOutsideRange
-- compile_machine(ast, heap_bytes, executor, platform) -> machine исполнителя
-- compile_machine_with_heap(ast, heap_bytes) -> machine RV32I для Linux
--     (rv32i.Executor + linux.Linux, ближние вызовы) — для тестов
--
-- Дети: state, constants, functions, codegen, backend (договор машины;
--     исполнитель и рантайм RV32I — в backend/rv32i), platform (договор платформы).

use io
use selfhost.compiler.state
use selfhost.compiler.constants
use selfhost.compiler.backend.rv32i
use selfhost.compiler.backend.rv32i.runtime
use selfhost.compiler.platform.linux
use selfhost.memory.model
use core.num
use selfhost.machine.word
use selfhost.compiler.functions

skill valid_heap_size(heap_bytes) {
    (num.mod(heap_bytes.b0, model.ALIGNMENT) > 0) { out no }
    (heap_bytes.b3 > 0) { out yes }
    (heap_bytes.b2 > 0) { out yes }
    (heap_bytes.b1 > 0) { out yes }
    (heap_bytes.b0 < model.MINIMUM_HEAP_BYTES) { out no }
    out yes
}

skill compile_state(ast, heap_bytes, executor, platform) {
    (valid_heap_size(heap_bytes) == no) { out error.ValueOutsideRange }
    @compiler = state.State { ast = ast, heap_bytes = heap_bytes, executor = executor }
    compiler = state.collect_top_level(compiler)
    compiler = state.header(compiler)
    compiler = state.start(compiler)
    compiler = functions.compile_functions(compiler)
    compiler = functions.compile_constants(compiler)
    compiler = runtime.append_runtime(compiler)
    compiler = platform.append(compiler)
    compiler = constants.emit_storage(compiler)
    compiler = state.finish_data(compiler)
    out compiler
}

skill compile_machine(ast, heap_bytes, executor, platform) {
    @compiler = compile_state(ast, heap_bytes, executor, platform)
    out compiler.machine
}

skill compile_machine_with_heap(ast, heap_bytes) {
    out compile_machine(ast, heap_bytes, rv32i.Executor {}, linux.Linux {})
}

program() {
    io.show("библиотека компилятора")
    out none
}
