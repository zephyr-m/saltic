-- syntax — рекурсивный спуск по токенам: поток лексера -> дерево ["program", …].
-- Узел — группа [тег, части…]; теги верхнего уровня: use, const, enum, box,
-- skill, native, entry; в телах: var, assign, field-assign, out, expr, if,
-- pick, drum, leave, switch; выражения: number, wide-number, fraction-number,
-- string, template, answer, none, path, call, binary, group, box-new,
-- enum-value, rescue. С locations = yes узлы обёрнуты ast.located.
-- Первая ошибка останавливает разбор. Запятая в конце списка (Box, enum,
-- группа, аргументы, параметры, ветки выбора) — ошибка trailing_comma;
-- поле у результата вызова `f().x` — ошибка call_field.
--
-- Syntax = Box { path, locations } — вход разбора: собирает самостоятельных
--     субъектов и отдаёт им работу сверху вниз:
--     Parse — Box { ast, tokens, diagnostics } — итог
--     parse(source) -> Parse — лексер, потом parse_tokens
--     parse_tokens(stream) -> Parse — Reader → Literals → Declarations
--
-- Дети: reader (Reader — глаза), literals (Literals — листья выражений и
-- звенья), declarations (Declarations — объявления), statements (Statements —
-- инструкции), expressions (Expressions — выражения), lists (Lists —
-- перечни). Последние четыре зовут друг друга по кругу (use по кругу —
-- решение автора 21.11.2026) и не держат друг друга в полях: соседа создают
-- в момент вызова на тех же look и leaves.

use core.group
use selfhost.parser.lexer
use selfhost.parser.token
use selfhost.parser.syntax.reader
use selfhost.parser.syntax.literals
use selfhost.parser.syntax.declarations

Syntax = Box {
    path = "",
    locations = no

    Parse = Box {
        ast = [],
        tokens = none,
        diagnostics = []
    }

    skill parse(source) {
        @scanner = Lexer {
            source = source,
            path = path
        }
        @scan = scanner.scan()
        (group.count(scan.diagnostics) > 0) {
            out Parse {
                ast = [],
                tokens = scan.tokens,
                diagnostics = scan.diagnostics
            }
        }
        out parse_tokens(scan.tokens)
    }

    skill parse_tokens(stream) {
        @look = Reader {
            tokens = stream,
            path = path,
            locations = locations
        }
        @leaves = Literals {
            look = look
        }
        @outline = Declarations {
            look = look,
            leaves = leaves
        }
        @tree = ["program"]
        @next = look.skip_lines(0)
        @diagnostics = []
        drum (stream.count()) {
            (look.is(next, Token.Kind.EOF) == yes) {
                leave
            }
            @item = outline.top(next)
            (item.broken() == yes) {
                diagnostics = item.diagnostics
                leave
            }
            tree = group.add(tree, item.datum())
            next = look.skip_lines(item.next)
        }
        out Parse {
            ast = tree,
            tokens = stream,
            diagnostics = diagnostics
        }
    }
}
