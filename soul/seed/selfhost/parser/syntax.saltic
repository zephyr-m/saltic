use core.str
use core.group
use selfhost.ast
use selfhost.diagnostic
use selfhost.errors
use selfhost.parser.lexer
use core.num

Cursor = Box {
    tokens = none,
    index = 0

    skill at(offset) {
        out lexer.token_buffer_at(tokens, index + offset)
    }

    skill peek() {
        @token = at(0)
        out token
    }

    skill is(kind) {
        @token = peek()
        out token.kind == kind
    }

    skill is_at(offset, kind) {
        @token = at(offset)
        out token.kind == kind
    }

    skill next() {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = index + 1
        out cursor
    }

    skill move(count) {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = index + count
        out cursor
    }
}

Parser = Box {
    tokens = none,
    path = "",
    locations = no

    skill at(index) {
        out lexer.token_buffer_at(tokens, index)
    }

    skill is(index, kind) {
        @token = at(index)
        out token.kind == kind
    }

    skill skip_lines(index) {
        @next = index
        @count = lexer.token_buffer_count(tokens)
        drum (count) {
            (next == count) { out next }
            (is(next, lexer.TokenKind.NEWLINE) == no) { out next }
            next = next + 1
        }
        out next
    }

    skill fail_with(index, problem) {
        @token = at(index)
        out Read {
            node = make_node("", []),
            next = index,
            diagnostics = [diagnostic.place(problem, path, token.line, token.col)]
        }
    }

    skill fail(index, expected) {
        @token = at(index)
        out fail_with(index, errors.unexpected_token(expected, lexer.describe(token)))
    }

    skill expect(index, kind, message) {
        @token = at(index)
        (is(index, kind) == yes) { out ok("token", [token.value], index + 1) }
        out fail(index, message)
    }

    skill field_item(start, item_message) {
        (is(start, lexer.TokenKind.IDENT) == no) { out fail(start, item_message) }
        @name_token = at(start)
        @eq = expect(start + 1, lexer.TokenKind.ASSIGN, "ожидался = после имени поля")
        (diagnostic.has(eq.diagnostics) == yes) { out eq }
        @value = expression(eq.next)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        out ok("field", ["field", name_token.value, value.node.datum], value.next)
    }

    skill sequence_item(start, item_kind, item_message) {
        (item_kind == "name") {
            (is(start, lexer.TokenKind.IDENT) == no) { out fail(start, item_message) }
            @token = at(start)
            out ok("name", token.value, start + 1)
        }
        (item_kind == "expression") {
            @value = expression(start)
            (diagnostic.has(value.diagnostics) == yes) { out value }
            out ok("expression", value.node.datum, value.next)
        }
        (item_kind == "field") { out field_item(start, item_message) }
        (item_kind == "member") {
            (is(start, lexer.TokenKind.SKILL) == yes) {
                @member_skill = subject_skill(start)
                (diagnostic.has(member_skill.diagnostics) == yes) { out member_skill }
                out ok("member", member_skill.node.datum, member_skill.next)
            }
            out field_item(start, item_message)
        }
        (item_kind == "statement") {
            @value = statement(start)
            (diagnostic.has(value.diagnostics) == yes) { out value }
            out ok("statement", value.node.datum, value.next)
        }
        out fail(start, item_message)
    }

    skill field_comma_message(comma, next_is_field) {
        (comma == next_is_field) { out "" }
        (comma == yes) { out "запятая ставится только между полями, после последнего поля её нет" }
        out "между полями нужна запятая"
    }

    skill sequence(start, end_kind, item_kind, item_message, eof_message, require_separator, allow_comma) {
        @items = []
        @next = skip_lines(start)
        @diagnostics = []
        drum (lexer.token_buffer_count(tokens)) {
            (is(next, end_kind) == yes) {
                next = next + 1
                leave
            }
            (is(next, lexer.TokenKind.EOF) == yes) {
                @failure = fail(next, eof_message)
                diagnostics = failure.diagnostics
                leave
            }
            @item = sequence_item(next, item_kind, item_message)
            (diagnostic.has(item.diagnostics) == yes) {
                diagnostics = item.diagnostics
                leave
            }
            items = group.add(items, item.node.datum)
            next = item.next
            @separated = no
            @comma = no
            (allow_comma == yes) {
                (is(next, lexer.TokenKind.COMMA) == yes) {
                    next = next + 1
                    separated = yes
                    comma = yes
                }
            }
            @before_lines = next
            next = skip_lines(next)
            (next > before_lines) { separated = yes }
            (item.node.tag == "field") {
                @comma_message = field_comma_message(comma, is(next, lexer.TokenKind.IDENT))
                (str.len(comma_message) > 0) {
                    @comma_failure = fail(next, comma_message)
                    diagnostics = comma_failure.diagnostics
                    leave
                }
            }
            (is(next, end_kind) == no) {
                (require_separator == yes) {
                    (separated == no) {
                        @separator_failure = fail(next, "ожидался разделитель")
                        diagnostics = separator_failure.diagnostics
                        leave
                    }
                }
            }
        }
        out Read { node = make_node("sequence", items), next = next, diagnostics = diagnostics }
    }

    skill names(start, end_kind, item_message) {
        @items = sequence(start, end_kind, "name", item_message, item_message, yes, yes)
        out Read { node = make_node("names", items.node.datum), next = items.next, diagnostics = items.diagnostics }
    }

    skill params(start) {
        @parsed_names = names(start, lexer.TokenKind.RPAREN, "ожидалось имя параметра")
        out Read { node = make_node("params", parsed_names.node.datum), next = parsed_names.next, diagnostics = parsed_names.diagnostics }
    }

    skill module(start) {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = start
        @token = cursor.peek()
        cursor = cursor.next()
        @module = path_at(cursor.index, no)
        (diagnostic.has(module.diagnostics) == yes) { out module }
        @parts = module.node.datum
        @datum = ["use"]
        datum = append_tail(datum, parts, 1)
        out ok("use", loc(datum, token, locations), module.next)
    }

    skill constant(start) {
        @token = at(start)
        @value = expression(start + 2)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        out ok("const", loc(["const", token.value, value.node.datum], token, locations), value.next)
    }

    skill entry(start) {
        @token = at(start)
        @open = expect(start + 1, lexer.TokenKind.LPAREN, "ожидалась ( после program")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @params = params(open.next)
        (diagnostic.has(params.diagnostics) == yes) { out params }
        @body = block(params.next)
        (diagnostic.has(body.diagnostics) == yes) { out body }
        out ok("entry", loc(["entry", params.node.datum, body.node.datum], token, locations), body.next)
    }

    skill named_skill(start) {
        @token = at(start)
        (is(start + 1, lexer.TokenKind.IDENT) == no) { out fail(start + 1, "ожидалось имя skill") }
        @name_token = at(start + 1)
        @name = name_token.value
        @open = expect(start + 2, lexer.TokenKind.LPAREN, "ожидалась (")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @params = params(open.next)
        (diagnostic.has(params.diagnostics) == yes) { out params }
        (is(params.next, lexer.TokenKind.NATIVE) == yes) {
            out ok("native", loc(["native", name, params.node.datum], token, locations), params.next + 1)
        }
        @body = block(params.next)
        (diagnostic.has(body.diagnostics) == yes) { out body }
        out ok("skill", loc(["skill", name, params.node.datum, body.node.datum], token, locations), body.next)
    }

    skill subject_skill(start) {
        @token = at(start)
        (is(start + 1, lexer.TokenKind.IDENT) == no) { out fail(start + 1, "ожидалось имя skill") }
        @name_token = at(start + 1)
        @open = expect(start + 2, lexer.TokenKind.LPAREN, "ожидалась (")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @params = params(open.next)
        (diagnostic.has(params.diagnostics) == yes) { out params }
        @body = block(params.next)
        (diagnostic.has(body.diagnostics) == yes) { out body }
        out ok("subject-skill", loc(["subject-skill", name_token.value, params.node.datum, body.node.datum], token, locations), body.next)
    }

    skill box_members(start) {
        @open = expect(start, lexer.TokenKind.LBRACE, "ожидалась \{")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @members = sequence(open.next, lexer.TokenKind.RBRACE, "member", "ожидалось поле или skill", "ожидалась \}", no, yes)
        out Read { node = make_node("box-members", members.node.datum), next = members.next, diagnostics = members.diagnostics }
    }

    skill enumeration(start) {
        @token = at(start)
        @open = expect(start + 3, lexer.TokenKind.LBRACE, "ожидалась \{")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @datum = ["enum", token.value]
        @variants = names(open.next, lexer.TokenKind.RBRACE, "ожидался вариант enum")
        (diagnostic.has(variants.diagnostics) == yes) { out variants }
        datum = append_tail(datum, variants.node.datum, 0)
        out ok("enum", loc(datum, token, locations), variants.next)
    }

    skill box(start) {
        @token = at(start)
        @members = box_members(start + 3)
        (diagnostic.has(members.diagnostics) == yes) { out members }
        @datum = ["box", token.value]
        datum = append_tail(datum, members.node.datum, 0)
        out ok("box", loc(datum, token, locations), members.next)
    }

    skill top(start) {
        @token = at(start)
        (token.kind == lexer.TokenKind.USE) { out module(start) }
        (token.kind == lexer.TokenKind.PROGRAM) { out entry(start) }
        (token.kind == lexer.TokenKind.SKILL) { out named_skill(start) }
        (token.kind == lexer.TokenKind.IDENT) {
            (is(start + 1, lexer.TokenKind.ASSIGN) == yes) {
                (is(start + 2, lexer.TokenKind.BOX) == yes) { out box(start) }
                (is(start + 2, lexer.TokenKind.ENUM) == yes) { out enumeration(start) }
                out constant(start)
            }
        }
        out fail(start, "ожидалось объявление верхнего уровня")
    }

    skill parse_tokens() {
        @tree = ["program"]
        @next = skip_lines(0)
        @diagnostics = []
        drum (lexer.token_buffer_count(tokens)) {
            (is(next, lexer.TokenKind.EOF) == yes) { leave }
            @item = top(next)
            (diagnostic.has(item.diagnostics) == yes) {
                diagnostics = item.diagnostics
                leave
            }
            tree = group.add(tree, item.node.datum)
            next = skip_lines(item.next)
        }
        out Parse { ast = tree, tokens = tokens, diagnostics = diagnostics }
    }

    skill path_at(start, with_locations) {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = start
        (cursor.is(lexer.TokenKind.IDENT) == no) { out fail(cursor.index, "ожидался идентификатор") }
        @token = cursor.peek()
        @parts = ["path", token.value]
        cursor = cursor.next()
        @count = lexer.token_buffer_count(tokens)
        drum (count) {
            ((cursor.index + 1 < count) == no) { leave }
            (cursor.is(lexer.TokenKind.DOT) == no) { leave }
            (cursor.is_at(1, lexer.TokenKind.IDENT) == no) { leave }
            @part_token = cursor.at(1)
            parts = group.add(parts, part_token.value)
            cursor = cursor.move(2)
        }
        out ok("path", loc(parts, token, with_locations), cursor.index)
    }

    skill expressions(start, end_kind) {
        @items = sequence(start, end_kind, "expression", "ожидалось выражение", "ожидался закрывающий токен", no, yes)
        out Read { node = make_node("expressions", items.node.datum), next = items.next, diagnostics = items.diagnostics }
    }

    skill number_literal(token, sign, digits, next) {
        @text = str.add(sign, digits)
        (str.contains(digits, ".") == yes) { out ok("fraction-number", loc(["fraction-number", text], token, locations), next) }
        (number_is_wide(digits) == yes) { out ok("wide-number", loc(["wide-number", text], token, locations), next) }
        @value = number_value(digits)
        (sign == "-") { value = 0 - value }
        out ok("number", loc(["number", value], token, locations), next)
    }

    skill primary(start) {
        @token = at(start)
        (token.kind == lexer.TokenKind.NUMBER) { out number_literal(token, "", token.value, start + 1) }
        (token.kind == lexer.TokenKind.MINUS) {
            @digits = at(start + 1)
            (digits.kind == lexer.TokenKind.NUMBER) {
                (digits.line == token.line) {
                    (digits.col == token.col + 1) { out number_literal(token, "-", digits.value, start + 2) }
                }
            }
        }
        (token.kind == lexer.TokenKind.STRING) { out ok("string", loc(["string", token.value], token, locations), start + 1) }
        (token.kind == lexer.TokenKind.TEMPLATE) { out template(token, start) }
        (token.kind == lexer.TokenKind.YES) { out ok("answer", loc(["answer", "yes"], token, locations), start + 1) }
        (token.kind == lexer.TokenKind.NO) { out ok("answer", loc(["answer", "no"], token, locations), start + 1) }
        (token.kind == lexer.TokenKind.NONE) { out ok("none", loc(["none"], token, locations), start + 1) }
        (token.kind == lexer.TokenKind.DOT) {
            (is(start + 1, lexer.TokenKind.IDENT) == no) { out fail(start + 1, "ожидалось значение enum") }
            @name_token = at(start + 1)
            out ok("enum-value", loc(["enum-value", name_token.value], token, locations), start + 2)
        }
        (token.kind == lexer.TokenKind.LBRACKET) { out group(start) }
        (token.kind == lexer.TokenKind.IDENT) { out path_at(start, locations) }
        (token.kind == lexer.TokenKind.LPAREN) {
            @inside = expression(start + 1)
            (diagnostic.has(inside.diagnostics) == yes) { out inside }
            @close = expect(inside.next, lexer.TokenKind.RPAREN, "ожидалась )")
            (diagnostic.has(close.diagnostics) == yes) { out close }
            out Read { node = inside.node, next = close.next, diagnostics = [] }
        }
        out fail(start, "ожидалось выражение")
    }

    skill template(token, start) {
        @datum = ["template"]
        drum (group.count(token.parts)) {
            @part = group.get(token.parts, beat)
            pick {
                (beat - beat / 2 * 2 == 0) { datum = group.add(datum, part) }
                {
                    @segments = placeholder_path(part)
                    (group.count(segments) == 0) { out fail_with(start, errors.bad_template_name(part)) }
                    datum = group.add(datum, loc(segments, token, locations))
                }
            }
        }
        out ok("template", loc(datum, token, locations), start + 1)
    }

    skill args(start) {
        @expressions = expressions(start + 1, lexer.TokenKind.RPAREN)
        out Read { node = make_node("args", expressions.node.datum), next = expressions.next, diagnostics = expressions.diagnostics }
    }

    skill fields(start) {
        @open = expect(start, lexer.TokenKind.LBRACE, "ожидалась \{")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @fields = sequence(open.next, lexer.TokenKind.RBRACE, "field", "ожидалось имя поля", "ожидалась \}", no, yes)
        out Read { node = make_node("fields", fields.node.datum), next = fields.next, diagnostics = fields.diagnostics }
    }

    skill postfix(start) {
        @base = primary(start)
        (diagnostic.has(base.diagnostics) == yes) { out base }
        @node = base.node
        @next = base.next
        @diagnostics = []
        drum (lexer.token_buffer_count(tokens)) {
            (is(next, lexer.TokenKind.LPAREN) == yes) {
                @call_token = at(next)
                @args = args(next)
                (diagnostic.has(args.diagnostics) == yes) {
                    diagnostics = args.diagnostics
                    leave
                }
                @call = ["call", node.datum]
                call = append_tail(call, args.node.datum, 0)
                node = make_node("call", loc(call, call_token, locations))
                next = args.next
            }
            (is(next, lexer.TokenKind.LPAREN) == no) {
                ((node.tag == "path") == no) { leave }
                (is(next, lexer.TokenKind.LBRACE) == no) { leave }
                @box_token = at(next)
                @fields = fields(next)
                (diagnostic.has(fields.diagnostics) == yes) {
                    diagnostics = fields.diagnostics
                    leave
                }
                @plain_name = node.datum
                (locations == yes) { plain_name = group.get(node.datum, 3) }
                @box_name = group.get(plain_name, 1)
                @name_index = 2
                drum (group.count(plain_name) - 2) {
                    box_name = str.add(box_name, str.add(".", group.get(plain_name, name_index)))
                    name_index = name_index + 1
                }
                @box = ["box-new", box_name]
                box = append_tail(box, fields.node.datum, 0)
                node = make_node("box-new", loc(box, box_token, locations))
                next = fields.next
            }
        }
        out Read { node = node, next = next, diagnostics = diagnostics }
    }

    skill precedence(kind) {
        (kind == lexer.TokenKind.EQ) { out 1 }
        (kind == lexer.TokenKind.GT) { out 1 }
        (kind == lexer.TokenKind.LT) { out 1 }
        (kind == lexer.TokenKind.PLUS) { out 2 }
        (kind == lexer.TokenKind.MINUS) { out 2 }
        (kind == lexer.TokenKind.STAR) { out 3 }
        (kind == lexer.TokenKind.SLASH) { out 3 }
        out 0
    }

    skill binary(start, minimum) {
        @first = postfix(start)
        (diagnostic.has(first.diagnostics) == yes) { out first }
        @left = first.node
        @next = first.next
        @diagnostics = []
        drum (lexer.token_buffer_count(tokens)) {
            @operator = at(next)
            @level = precedence(operator.kind)
            (level < minimum) { leave }
            (level == 0) { leave }
            @right = binary(next + 1, level + 1)
            (diagnostic.has(right.diagnostics) == yes) {
                diagnostics = right.diagnostics
                leave
            }
            left = make_node("binary", loc(["binary", operator.value, left.datum, right.node.datum], operator, locations))
            next = right.next
        }
        out Read { node = left, next = next, diagnostics = diagnostics }
    }

    skill expression(start) {
        @value = binary(start, 0)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        (is(value.next, lexer.TokenKind.RESCUE) == yes) {
            @rescue_token = at(value.next)
            @pipe = expect(value.next + 1, lexer.TokenKind.PIPE, "ожидался |")
            (diagnostic.has(pipe.diagnostics) == yes) { out pipe }
            (is(pipe.next, lexer.TokenKind.IDENT) == no) { out fail(pipe.next, "ожидалось имя ошибки rescue") }
            @error_token = at(pipe.next)
            @error_name = error_token.value
            @pipe2 = expect(pipe.next + 1, lexer.TokenKind.PIPE, "ожидался |")
            (diagnostic.has(pipe2.diagnostics) == yes) { out pipe2 }
            @body = block(pipe2.next)
            (diagnostic.has(body.diagnostics) == yes) { out body }
            out ok("rescue", loc(["rescue", value.node.datum, error_name, body.node.datum], rescue_token, locations), body.next)
        }
        out value
    }

    skill group(start) {
        @token = at(start)
        @expressions = expressions(start + 1, lexer.TokenKind.RBRACKET)
        (diagnostic.has(expressions.diagnostics) == yes) { out expressions }
        @items = ["group"]
        items = append_tail(items, expressions.node.datum, 0)
        out ok("group", loc(items, token, locations), expressions.next)
    }

    skill block(start) {
        @token = at(start)
        @open = expect(start, lexer.TokenKind.LBRACE, "ожидалась \{")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @statements = sequence(open.next, lexer.TokenKind.RBRACE, "statement", "ожидалась инструкция", "ожидалась \}", no, no)
        @items = ["block"]
        items = append_tail(items, statements.node.datum, 0)
        out Read { node = make_node("block", loc(items, token, locations)), next = statements.next, diagnostics = statements.diagnostics }
    }

    skill variable(start) {
        @token = at(start)
        (is(start + 1, lexer.TokenKind.IDENT) == no) { out fail(start + 1, "ожидалось имя переменной") }
        @name_token = at(start + 1)
        @name = name_token.value
        @eq = expect(start + 2, lexer.TokenKind.ASSIGN, "ожидался = после имени переменной")
        (diagnostic.has(eq.diagnostics) == yes) { out eq }
        @value = expression(eq.next)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        out ok("var", loc(["var", name, value.node.datum], token, locations), value.next)
    }

    skill assign(start) {
        @token = at(start)
        @value = expression(start + 2)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        out ok("assign", loc(["assign", token.value, value.node.datum], token, locations), value.next)
    }

    skill field_assign(start) {
        @token = at(start)
        @target = path_at(start, locations)
        (diagnostic.has(target.diagnostics) == yes) { out target }
        @eq = expect(target.next, lexer.TokenKind.ASSIGN, "ожидался =")
        (diagnostic.has(eq.diagnostics) == yes) { out eq }
        @value = expression(eq.next)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        out ok("field-assign", loc(["field-assign", target.node.datum, value.node.datum], token, locations), value.next)
    }

    skill out_statement(start) {
        @token = at(start)
        @value = expression(start + 1)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        out ok("out", loc(["out", value.node.datum], token, locations), value.next)
    }

    skill drum_statement(start) {
        @token = at(start)
        @open = expect(start + 1, lexer.TokenKind.LPAREN, "ожидалась ( после drum")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @count = expression(open.next)
        (diagnostic.has(count.diagnostics) == yes) { out count }
        @close = expect(count.next, lexer.TokenKind.RPAREN, "ожидалась )")
        (diagnostic.has(close.diagnostics) == yes) { out close }
        @body = block(close.next)
        (diagnostic.has(body.diagnostics) == yes) { out body }
        out ok("drum", loc(["drum", count.node.datum, body.node.datum], token, locations), body.next)
    }

    skill pick_statement(start) {
        @token = at(start)
        @open = expect(start + 1, lexer.TokenKind.LBRACE, "ожидалась \{ после pick")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @items = ["pick"]
        @next = skip_lines(open.next)
        @count = lexer.token_buffer_count(tokens)
        drum (count) {
            pick {
                (is(next, lexer.TokenKind.RBRACE) == yes) { out Read { node = make_node("pick", loc(items, token, locations)), next = next + 1, diagnostics = [] } }
                (is(next, lexer.TokenKind.LBRACE) == yes) {
                    @fallback_token = at(next)
                    @fallback = block(next)
                    (diagnostic.has(fallback.diagnostics) == yes) { out fallback }
                    items = group.add(items, loc(["otherwise", fallback.node.datum], fallback_token, locations))
                    next = skip_lines(fallback.next)
                }
                (is(next, lexer.TokenKind.LPAREN) == yes) {
                    @choice = paren_statement(next)
                    (diagnostic.has(choice.diagnostics) == yes) { out choice }
                    items = group.add(items, choice.node.datum)
                    next = skip_lines(choice.next)
                }
                { out fail(next, "ожидался вариант pick: (условие) \{ \} или \{ \}") }
            }
        }
        out fail(next, "ожидалась \} после pick")
    }

    skill paren_statement(start) {
        @token = at(start)
        @value = expression(start + 1)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        @close = expect(value.next, lexer.TokenKind.RPAREN, "ожидалась )")
        (diagnostic.has(close.diagnostics) == yes) { out close }
        @open = expect(close.next, lexer.TokenKind.LBRACE, "ожидалась \{")
        (diagnostic.has(open.diagnostics) == yes) { out open }
        @next = skip_lines(open.next)
        (is(next, lexer.TokenKind.DOT) == yes) {
            @cases = ["switch", value.node.datum]
            @diagnostics = []
            drum (lexer.token_buffer_count(tokens)) {
                (is(next, lexer.TokenKind.RBRACE) == yes) {
                    next = next + 1
                    leave
                }
                @case_token = at(next)
                @dot = expect(next, lexer.TokenKind.DOT, "ожидалась .")
                (diagnostic.has(dot.diagnostics) == yes) {
                    diagnostics = dot.diagnostics
                    leave
                }
                (is(dot.next, lexer.TokenKind.IDENT) == no) {
                    @failure = fail(dot.next, "ожидалась метка ветки выбора")
                    diagnostics = failure.diagnostics
                    leave
                }
                @tag_token = at(dot.next)
                @tag = tag_token.value
                @arrow = expect(dot.next + 1, lexer.TokenKind.ARROW, "ожидался =>")
                (diagnostic.has(arrow.diagnostics) == yes) {
                    diagnostics = arrow.diagnostics
                    leave
                }
                @body = expression(arrow.next)
                (diagnostic.has(body.diagnostics) == yes) {
                    diagnostics = body.diagnostics
                    leave
                }
                cases = group.add(cases, loc(["case", tag, body.node.datum], case_token, locations))
                next = body.next
                (is(next, lexer.TokenKind.COMMA) == yes) { next = next + 1 }
                next = skip_lines(next)
            }
            out Read { node = make_node("switch", loc(cases, token, locations)), next = next, diagnostics = diagnostics }
        }
        @statements = sequence(next, lexer.TokenKind.RBRACE, "statement", "ожидалась инструкция", "ожидалась \}", no, no)
        @items = ["block"]
        items = append_tail(items, statements.node.datum, 0)
        @located_body = loc(items, token, locations)
        out Read { node = make_node("if", loc(["if", value.node.datum, located_body], token, locations)), next = statements.next, diagnostics = statements.diagnostics }
    }

    skill statement(start) {
        @token = at(start)
        (token.kind == lexer.TokenKind.AT) { out variable(start) }
        (token.kind == lexer.TokenKind.OUT) { out out_statement(start) }
        (token.kind == lexer.TokenKind.DRUM) { out drum_statement(start) }
        (token.kind == lexer.TokenKind.LEAVE) { out ok("leave", loc(["leave"], token, locations), start + 1) }
        (token.kind == lexer.TokenKind.PICK) { out pick_statement(start) }
        (token.kind == lexer.TokenKind.LPAREN) { out paren_statement(start) }
        (token.kind == lexer.TokenKind.IDENT) {
            (is(start + 1, lexer.TokenKind.ASSIGN) == yes) { out assign(start) }
            @target = path_at(start, no)
            (is(target.next, lexer.TokenKind.ASSIGN) == yes) { out field_assign(start) }
        }
        @expression = expression(start)
        (diagnostic.has(expression.diagnostics) == yes) { out expression }
        out ok("expr", ["expr", expression.node.datum], expression.next)
    }

}

Node = Box {
    datum = [],
    tag = ""
}

Read = Box {
    node = Node {},
    next = 0,
    diagnostics = []
}

Parse = Box {
    ast = [],
    tokens = none,
    diagnostics = []
}

skill placeholder_path(name) {
    (str.len(name) == 0) { out [] }
    (str.starts_with(name, ".") == yes) { out [] }
    (str.ends_with(name, ".") == yes) { out [] }
    (str.contains(name, "..") == yes) { out [] }
    out group.concat(["path"], str.split(name, "."))
}

skill number_value(text) {
    @whole = 0
    @fraction = 0
    @scale = 1
    @after_dot = no
    drum (str.len(text)) {
        @ch = str.get(text, beat)
        (ch == ".") { after_dot = yes }
        (str.is_digit(ch) == yes) {
            pick {
                (after_dot == no) { whole = whole * 10 + num.digit(ch) }
                {
                    fraction = fraction * 10 + num.digit(ch)
                    scale = scale * 10
                }
            }
        }
    }
    out whole + fraction / scale
}

skill number_is_wide(text) {
    (str.contains(text, ".") == yes) { out no }
    @length = str.len(text)
    (length > 9) { out yes }
    (length < 9) { out no }
    @limit = "268435455"
    drum (9) {
        @actual = num.digit(str.get(text, beat))
        @maximum = num.digit(str.get(limit, beat))
        (actual > maximum) { out yes }
        (actual < maximum) { out no }
    }
    out no
}

skill lex(source, path) {
    out lexer.lex(source, path)
}

skill loc(datum, token, locations) {
    (locations == yes) { out ast.located(datum, token.line, token.col) }
    out datum
}

skill make_node(tag, datum) {
    out Node { datum = datum, tag = tag }
}

skill ok(tag, datum, next) {
    out Read { node = make_node(tag, datum), next = next, diagnostics = [] }
}

skill append_tail(head, tail, start) {
    @count = group.count(tail)
    (start > count) { out head }
    out group.concat(head, group.slice(tail, start, count))
}

skill parse_tokens_mode(tokens, path, locations) {
    @parser = Parser()
    parser.tokens = tokens
    parser.path = path
    parser.locations = locations
    out parser.parse_tokens()
}

skill parse_tokens(tokens, path) {
    out parse_tokens_mode(tokens, path, no)
}

skill parse_tokens_loc(tokens, path) {
    out parse_tokens_mode(tokens, path, yes)
}

skill parse_string(source, path) {
    @scan = lex(source, path)
    (diagnostic.has(scan.diagnostics) == yes) { out Parse { ast = [], tokens = scan.tokens, diagnostics = scan.diagnostics } }
    out parse_tokens(scan.tokens, path)
}

skill parse_string_loc(source, path) {
    @scan = lex(source, path)
    (diagnostic.has(scan.diagnostics) == yes) { out Parse { ast = [], tokens = scan.tokens, diagnostics = scan.diagnostics } }
    out parse_tokens_loc(scan.tokens, path)
}

