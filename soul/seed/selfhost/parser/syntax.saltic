-- syntax — рекурсивный спуск по токенам: поток лексера -> дерево ["program", …].
-- Узел — группа [тег, части…]; теги верхнего уровня: use, const, enum, box,
-- skill, native, entry; в телах: var, assign, field-assign, out, expr, if,
-- pick, drum, leave, switch; выражения: number, wide-number, fraction-number,
-- string, template, answer, none, path, call, binary, group, box-new,
-- enum-value, rescue. С locations = yes узлы обёрнуты ast.located.
-- Первая ошибка останавливает разбор. Запятая в конце списка (Box, enum,
-- группа, аргументы, параметры, ветки выбора) — ошибка trailing_comma;
-- поле у результата вызова `f().x` — ошибка call_field.
--
-- Parser = Box { tokens, path, locations } — только данные; parse(parser) -> Parse
-- Parse = Box { ast, tokens, diagnostics }
-- parse_string / parse_string_loc(source, path) -> Parse
-- parse_tokens / parse_tokens_loc(tokens, path) / parse_tokens_mode(tokens, path, locations) -> Parse
-- lex(source, path) -> lexer.Scan; append_tail(head, tail, start) -> head + tail[start…]
--
-- Дети: cursor (шаги по токенам), literals (листья выражений), grammar
-- (блоки, инструкции и выражения), declarations (верхний уровень).

use core.group
use selfhost.diagnostic
use selfhost.parser.lexer
use selfhost.parser.syntax.cursor
use selfhost.parser.syntax.declarations

Parser = Box {
    tokens = none,
    path = "",
    locations = no
}

Parse = Box {
    ast = [],
    tokens = none,
    diagnostics = []
}

skill parse(parser) {
    @tree = ["program"]
    @next = cursor.skip_lines(parser, 0)
    @diagnostics = []
    drum (lexer.token_buffer_count(parser.tokens)) {
        (cursor.is(parser, next, lexer.TokenKind.EOF) == yes) { leave }
        @item = declarations.top(parser, next)
        (diagnostic.has(item.diagnostics) == yes) {
            diagnostics = item.diagnostics
            leave
        }
        tree = group.add(tree, item.node.datum)
        next = cursor.skip_lines(parser, item.next)
    }
    out Parse { ast = tree, tokens = parser.tokens, diagnostics = diagnostics }
}

skill lex(source, path) {
    out lexer.lex(source, path)
}

skill append_tail(head, tail, start) {
    out cursor.append_tail(head, tail, start)
}

skill parse_tokens_mode(tokens, path, locations) {
    @parser = Parser()
    parser.tokens = tokens
    parser.path = path
    parser.locations = locations
    out parse(parser)
}

skill parse_tokens(tokens, path) {
    out parse_tokens_mode(tokens, path, no)
}

skill parse_tokens_loc(tokens, path) {
    out parse_tokens_mode(tokens, path, yes)
}

skill parse_string(source, path) {
    @scan = lex(source, path)
    (diagnostic.has(scan.diagnostics) == yes) { out Parse { ast = [], tokens = scan.tokens, diagnostics = scan.diagnostics } }
    out parse_tokens(scan.tokens, path)
}

skill parse_string_loc(source, path) {
    @scan = lex(source, path)
    (diagnostic.has(scan.diagnostics) == yes) { out Parse { ast = [], tokens = scan.tokens, diagnostics = scan.diagnostics } }
    out parse_tokens_loc(scan.tokens, path)
}
