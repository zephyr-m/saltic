-- nest — вложенные Box при загрузке (решение автора 19.11.2026: объект виден
-- разом, со всеми частями): часть объекта — Engine внутри Car — поднимается
-- наверх под полным именем Car.Engine, сколько бы ни было уровней; у хозяина
-- остаются поля и навыки. Дальше чекер и компилятор видят обычные Box.
--
-- Nest — Box { items }: lift(item, prefix) -> items — кладёт сам узел (у Box —
--     без вложенных), следом каждый вложенный под именем «prefix.Имя»

use core.str
use core.group
use selfhost.ast

Nest = Box {
    items = []

    skill lift(item, prefix) {
        ((ast.tag(item) == "box") == no) {
            items = group.add(items, item)
            out items
        }
        @plain = ast.plain(item)
        @name = group.get(plain, 1)
        @full = name
        (str.bytes(prefix) > 0) { full = "{prefix}.{name}" }
        @own = ["box", full]
        @inner = []
        drum (group.count(plain) - 2) {
            @member = group.get(plain, beat + 2)
            pick {
                (ast.tag(member) == "box") { inner = group.add(inner, member) }
                { own = group.add(own, member) }
            }
        }
        items = group.add(items, ast.rebuild(item, own))
        drum (inner) { lift(beat, full) }
        out items
    }
}
