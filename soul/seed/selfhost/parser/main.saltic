-- parser — публичное лицо разбора, вход папки parser/ (use selfhost.parser):
-- текст или файл с модулями -> AST. С locations = yes узлы обёрнуты местом
-- (ast.located) для диагностик. Как программа: program(путь) печатает число
-- узлов и диагностик.
--
-- Parser = Box { root, locations } — корень проекта для use, ставить ли место:
--     parse_text(source, path) -> Syntax.Parse { ast, tokens, diagnostics }
--     gather(path) -> Loader.Load { ast, included, diagnostics } — файл и все его use
--
-- Дети: lexer, token, syntax (reader, literals, declarations, statements,
-- expressions, lists), loader, nest.

use core.group
use io
use selfhost.parser.syntax
use selfhost.parser.loader

Parser = Box {
    root = ".",
    locations = no

    skill parse_text(source, path) {
        @reading = Syntax {
            path = path,
            locations = locations
        }
        out reading.parse(source)
    }

    skill gather(path) {
        @collector = Loader {
            root = root,
            locations = locations
        }
        out collector.gather(path)
    }
}

program(path) {
    @reading = Parser {}
    @parsed = reading.gather(path)
    @diagnostic_count = group.count(parsed.diagnostics)

    @shown_1 = group.count(parsed.ast)
    io.show("элементов AST: {shown_1}")
    io.show("диагностик: {diagnostic_count}")

    (diagnostic_count > 0) {
        out error.ParseFailed
    }

    out none
}
