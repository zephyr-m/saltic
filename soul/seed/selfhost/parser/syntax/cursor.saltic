-- cursor — шаги разбора по токенам: чтение, проверка, ошибки, узлы, путь.
-- parser — данные syntax.Parser { tokens, path, locations }; index — номер
-- токена. Каждый шаг отдаёт Read: узел, номер следующего токена и
-- диагностики (непустые — разбор остановлен).
--
-- Cursor = Box { tokens, index } — внутренний курсор path_at
-- Node = Box { datum, tag }; Read = Box { node, next, diagnostics }
-- at(parser, index) -> токен; is(parser, index, kind) -> answer
-- skip_lines(parser, index) -> номер первого токена после переводов строки
-- fail_with(parser, index, problem) / fail(parser, index, code) -> Read с ошибкой; code — из errors.EXPECTED
-- expect(parser, index, kind, message) -> Read "token" или ошибка
-- path_at(parser, start, with_locations) -> Read "path" (a.b.c)
-- loc(datum, word, locations) / make_node(tag, datum) / ok(tag, datum, next)
-- append_tail(head, tail, start) -> head + tail[start…]
-- field_follows(parser, at) -> yes, если с at начинается поле, а не вложенный Box или enum
-- field_comma_message(comma, next_is_field) -> "" или код ошибки запятой после поля

use core.group
use selfhost.ast
use selfhost.diagnostic
use selfhost.errors
use selfhost.parser.lexer
use selfhost.parser.token

Cursor = Box {
    tokens = Lexer.TokenBuffer {},
    index = 0

    skill at(offset) {
        out tokens.at(index + offset)
    }

    skill peek() {
        @word = at(0)
        out word
    }

    skill is(kind) {
        @word = peek()
        out word.kind == kind
    }

    skill is_at(offset, kind) {
        @word = at(offset)
        out word.kind == kind
    }

    skill next() {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = index + 1
        out cursor
    }

    skill advance(count) {
        @cursor = Cursor()
        cursor.tokens = tokens
        cursor.index = index + count
        out cursor
    }
}

Node = Box {
    datum = [],
    tag = ""
}

Read = Box {
    node = Node {},
    next = 0,
    diagnostics = []
}

skill at(parser, index) {
    @stream = parser.tokens
    out stream.at(index)
}

skill is(parser, index, kind) {
    @word = at(parser, index)
    out word.kind == kind
}

skill skip_lines(parser, index) {
    @next = index
    @stream = parser.tokens
    @count = stream.count()
    drum (count) {
        (next == count) { out next }
        (is(parser, next, Token.Kind.NEWLINE) == no) { out next }
        next = next + 1
    }
    out next
}

skill fail_with(parser, index, problem) {
    @word = at(parser, index)
    out Read {
        node = make_node("", []),
        next = index,
        diagnostics = [diagnostic.place(problem, parser.path, word.line, word.col)]
    }
}

skill fail(parser, index, expected) {
    @word = at(parser, index)
    out fail_with(parser, index, errors.unexpected_token(expected, word.describe()))
}

skill expect(parser, index, kind, message) {
    @word = at(parser, index)
    (is(parser, index, kind) == yes) { out ok("token", [word.value], index + 1) }
    out fail(parser, index, message)
}

skill path_at(parser, start, with_locations) {
    @cursor = Cursor()
    cursor.tokens = parser.tokens
    cursor.index = start
    (cursor.is(Token.Kind.IDENT) == no) { out fail(parser, cursor.index, "expected_identifier") }
    @word = cursor.peek()
    @parts = ["path", word.value]
    cursor = cursor.next()
    @stream = parser.tokens
    @count = stream.count()
    drum (count) {
        (cursor.index + 1 >= count) { leave }
        (cursor.is(Token.Kind.DOT) == no) { leave }
        (cursor.is_at(1, Token.Kind.IDENT) == no) { leave }
        @part_token = cursor.at(1)
        parts = group.add(parts, part_token.value)
        cursor = cursor.advance(2)
    }
    out ok("path", loc(parts, word, with_locations), cursor.index)
}

skill loc(datum, word, locations) {
    (locations == yes) { out ast.located(datum, word.line, word.col) }
    out datum
}

skill make_node(tag, datum) {
    out Node { datum = datum, tag = tag }
}

skill ok(tag, datum, next) {
    out Read { node = make_node(tag, datum), next = next, diagnostics = [] }
}

skill append_tail(head, tail, start) {
    @count = group.count(tail)
    (start > count) { out head }
    out group.concat(head, group.slice(tail, start, count))
}

skill field_follows(parser, at) {
    (is(parser, at, Token.Kind.IDENT) == no) {
        out no
    }
    (is(parser, at + 1, Token.Kind.ASSIGN) == no) {
        out yes
    }
    (is(parser, at + 2, Token.Kind.ENUM) == yes) {
        out no
    }
    out is(parser, at + 2, Token.Kind.BOX) == no
}

skill field_comma_message(comma, next_is_field) {
    (comma == next_is_field) {
        out ""
    }
    (comma == yes) {
        out "field_trailing_comma"
    }
    out "missing_field_comma"
}
