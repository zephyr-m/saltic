-- grammar — рекурсивное ядро разбора: блок, инструкции и составные выражения.
-- Выражения и инструкции в одном модуле: rescue содержит блок, блок —
-- инструкции, инструкции — выражения, а циклический use запрещён (import_cycle).
-- Списки (поля, аргументы, группа, параметры, тело Box) идут через sequence;
-- запятая в конце — trailing_comma, поле у результата вызова — call_field.
--
-- block(parser, start) -> Read "block"; statement(parser, start) -> Read узла тела
-- expression(parser, start) -> Read выражения (binary, call, box-new, rescue…)
-- sequence(parser, start, end_kind, item_kind, item_message, eof_message,
--     require_separator, allow_comma) -> Read "sequence"; item_kind — name,
--     expression, field, member, statement
-- names(parser, start, end_kind, item_message) / params(parser, start) -> Read списка имён
-- subject_skill(parser, start) -> Read "subject-skill" (skill внутри Box)

use core.str
use core.group
use selfhost.diagnostic
use selfhost.errors
use selfhost.parser.lexer
use selfhost.parser.syntax.cursor
use selfhost.parser.syntax.literals

skill field_item(parser, start, item_message) {
    (cursor.is(parser, start, lexer.TokenKind.IDENT) == no) { out cursor.fail(parser, start, item_message) }
    @name_token = cursor.at(parser, start)
    @eq = cursor.expect(parser, start + 1, lexer.TokenKind.ASSIGN, "ожидался = после имени поля")
    (diagnostic.has(eq.diagnostics) == yes) { out eq }
    @value = expression(parser, eq.next)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    out cursor.ok("field", ["field", name_token.value, value.node.datum], value.next)
}

skill sequence_item(parser, start, item_kind, item_message) {
    (item_kind == "name") {
        (cursor.is(parser, start, lexer.TokenKind.IDENT) == no) { out cursor.fail(parser, start, item_message) }
        @token = cursor.at(parser, start)
        out cursor.ok("name", token.value, start + 1)
    }
    (item_kind == "expression") {
        @value = expression(parser, start)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        out cursor.ok("expression", value.node.datum, value.next)
    }
    (item_kind == "field") { out field_item(parser, start, item_message) }
    (item_kind == "member") {
        (cursor.is(parser, start, lexer.TokenKind.SKILL) == yes) {
            @member_skill = subject_skill(parser, start)
            (diagnostic.has(member_skill.diagnostics) == yes) { out member_skill }
            out cursor.ok("member", member_skill.node.datum, member_skill.next)
        }
        out field_item(parser, start, item_message)
    }
    (item_kind == "statement") {
        @value = statement(parser, start)
        (diagnostic.has(value.diagnostics) == yes) { out value }
        out cursor.ok("statement", value.node.datum, value.next)
    }
    out cursor.fail(parser, start, item_message)
}

skill field_comma_message(comma, next_is_field) {
    (comma == next_is_field) { out "" }
    (comma == yes) { out "запятая ставится только между полями, после последнего поля её нет" }
    out "между полями нужна запятая"
}

skill sequence(parser, start, end_kind, item_kind, item_message, eof_message, require_separator, allow_comma) {
    @items = []
    @next = cursor.skip_lines(parser, start)
    @diagnostics = []
    drum (lexer.token_buffer_count(parser.tokens)) {
        (cursor.is(parser, next, end_kind) == yes) {
            next = next + 1
            leave
        }
        (cursor.is(parser, next, lexer.TokenKind.EOF) == yes) {
            @failure = cursor.fail(parser, next, eof_message)
            diagnostics = failure.diagnostics
            leave
        }
        @item = sequence_item(parser, next, item_kind, item_message)
        (diagnostic.has(item.diagnostics) == yes) {
            diagnostics = item.diagnostics
            leave
        }
        items = group.add(items, item.node.datum)
        next = item.next
        @separated = no
        @comma = no
        (allow_comma == yes) {
            (cursor.is(parser, next, lexer.TokenKind.COMMA) == yes) {
                next = next + 1
                separated = yes
                comma = yes
            }
        }
        @before_lines = next
        next = cursor.skip_lines(parser, next)
        (next > before_lines) { separated = yes }
        (item.node.tag == "field") {
            @comma_message = field_comma_message(comma, cursor.is(parser, next, lexer.TokenKind.IDENT))
            (str.bytes(comma_message) > 0) {
                @comma_failure = cursor.fail(parser, next, comma_message)
                diagnostics = comma_failure.diagnostics
                leave
            }
        }
        (comma == yes) {
            (cursor.is(parser, next, end_kind) == yes) {
                @trailing_failure = cursor.fail_with(parser, next, errors.trailing_comma())
                diagnostics = trailing_failure.diagnostics
                leave
            }
        }
        (cursor.is(parser, next, end_kind) == no) {
            (require_separator == yes) {
                (separated == no) {
                    @separator_failure = cursor.fail(parser, next, "ожидался разделитель")
                    diagnostics = separator_failure.diagnostics
                    leave
                }
            }
        }
    }
    out cursor.Read { node = cursor.make_node("sequence", items), next = next, diagnostics = diagnostics }
}

skill names(parser, start, end_kind, item_message) {
    @items = sequence(parser, start, end_kind, "name", item_message, item_message, yes, yes)
    out cursor.Read { node = cursor.make_node("names", items.node.datum), next = items.next, diagnostics = items.diagnostics }
}

skill params(parser, start) {
    @parsed_names = names(parser, start, lexer.TokenKind.RPAREN, "ожидалось имя параметра")
    out cursor.Read { node = cursor.make_node("params", parsed_names.node.datum), next = parsed_names.next, diagnostics = parsed_names.diagnostics }
}

skill subject_skill(parser, start) {
    @token = cursor.at(parser, start)
    (cursor.is(parser, start + 1, lexer.TokenKind.IDENT) == no) { out cursor.fail(parser, start + 1, "ожидалось имя skill") }
    @name_token = cursor.at(parser, start + 1)
    @open = cursor.expect(parser, start + 2, lexer.TokenKind.LPAREN, "ожидалась (")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @parsed_params = params(parser, open.next)
    (diagnostic.has(parsed_params.diagnostics) == yes) { out parsed_params }
    @body = block(parser, parsed_params.next)
    (diagnostic.has(body.diagnostics) == yes) { out body }
    out cursor.ok("subject-skill", cursor.loc(["subject-skill", name_token.value, parsed_params.node.datum, body.node.datum], token, parser.locations), body.next)
}

skill expression_list(parser, start, end_kind) {
    @items = sequence(parser, start, end_kind, "expression", "ожидалось выражение", "ожидался закрывающий токен", no, yes)
    out cursor.Read { node = cursor.make_node("expressions", items.node.datum), next = items.next, diagnostics = items.diagnostics }
}

skill primary(parser, start) {
    @token = cursor.at(parser, start)
    (token.kind == lexer.TokenKind.NUMBER) { out literals.number_literal(parser, token, "", token.value, start + 1) }
    (token.kind == lexer.TokenKind.MINUS) {
        @digits = cursor.at(parser, start + 1)
        (digits.kind == lexer.TokenKind.NUMBER) {
            (digits.line == token.line) {
                (digits.col == token.col + 1) { out literals.number_literal(parser, token, "-", digits.value, start + 2) }
            }
        }
    }
    (token.kind == lexer.TokenKind.STRING) { out cursor.ok("string", cursor.loc(["string", token.value], token, parser.locations), start + 1) }
    (token.kind == lexer.TokenKind.TEMPLATE) { out literals.template(parser, token, start) }
    (token.kind == lexer.TokenKind.YES) { out cursor.ok("answer", cursor.loc(["answer", "yes"], token, parser.locations), start + 1) }
    (token.kind == lexer.TokenKind.NO) { out cursor.ok("answer", cursor.loc(["answer", "no"], token, parser.locations), start + 1) }
    (token.kind == lexer.TokenKind.NONE) { out cursor.ok("none", cursor.loc(["none"], token, parser.locations), start + 1) }
    (token.kind == lexer.TokenKind.DOT) {
        (cursor.is(parser, start + 1, lexer.TokenKind.IDENT) == no) { out cursor.fail(parser, start + 1, "ожидалось значение enum") }
        @name_token = cursor.at(parser, start + 1)
        out cursor.ok("enum-value", cursor.loc(["enum-value", name_token.value], token, parser.locations), start + 2)
    }
    (token.kind == lexer.TokenKind.LBRACKET) { out group_literal(parser, start) }
    (token.kind == lexer.TokenKind.IDENT) { out cursor.path_at(parser, start, parser.locations) }
    (token.kind == lexer.TokenKind.LPAREN) {
        @inside = expression(parser, start + 1)
        (diagnostic.has(inside.diagnostics) == yes) { out inside }
        @close = cursor.expect(parser, inside.next, lexer.TokenKind.RPAREN, "ожидалась )")
        (diagnostic.has(close.diagnostics) == yes) { out close }
        out cursor.Read { node = inside.node, next = close.next, diagnostics = [] }
    }
    out cursor.fail(parser, start, "ожидалось выражение")
}

skill args(parser, start) {
    @list = expression_list(parser, start + 1, lexer.TokenKind.RPAREN)
    out cursor.Read { node = cursor.make_node("args", list.node.datum), next = list.next, diagnostics = list.diagnostics }
}

skill fields(parser, start) {
    @open = cursor.expect(parser, start, lexer.TokenKind.LBRACE, "ожидалась \{")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @list = sequence(parser, open.next, lexer.TokenKind.RBRACE, "field", "ожидалось имя поля", "ожидалась \}", no, yes)
    out cursor.Read { node = cursor.make_node("fields", list.node.datum), next = list.next, diagnostics = list.diagnostics }
}

skill postfix(parser, start) {
    @base = primary(parser, start)
    (diagnostic.has(base.diagnostics) == yes) { out base }
    @node = base.node
    @next = base.next
    @diagnostics = []
    drum (lexer.token_buffer_count(parser.tokens)) {
        (cursor.is(parser, next, lexer.TokenKind.LPAREN) == yes) {
            @call_token = cursor.at(parser, next)
            @arguments = args(parser, next)
            (diagnostic.has(arguments.diagnostics) == yes) {
                diagnostics = arguments.diagnostics
                leave
            }
            @call = ["call", node.datum]
            call = cursor.append_tail(call, arguments.node.datum, 0)
            node = cursor.make_node("call", cursor.loc(call, call_token, parser.locations))
            next = arguments.next
        }
        (cursor.is(parser, next, lexer.TokenKind.LPAREN) == no) {
            (node.tag == "call") {
                (cursor.is(parser, next, lexer.TokenKind.DOT) == yes) {
                    @close_token = cursor.at(parser, next - 1)
                    @dot_token = cursor.at(parser, next)
                    (dot_token.line == close_token.line) {
                        (dot_token.col == close_token.col + 1) {
                            @field_failure = cursor.fail_with(parser, next, errors.call_field())
                            diagnostics = field_failure.diagnostics
                            leave
                        }
                    }
                }
            }
            ((node.tag == "path") == no) { leave }
            (cursor.is(parser, next, lexer.TokenKind.LBRACE) == no) { leave }
            @box_token = cursor.at(parser, next)
            @box_fields = fields(parser, next)
            (diagnostic.has(box_fields.diagnostics) == yes) {
                diagnostics = box_fields.diagnostics
                leave
            }
            @plain_name = node.datum
            (parser.locations == yes) { plain_name = group.get(node.datum, 3) }
            @box_name = group.get(plain_name, 1)
            @name_index = 2
            drum (group.count(plain_name) - 2) {
                box_name = str.concat(box_name, str.concat(".", group.get(plain_name, name_index)))
                name_index = name_index + 1
            }
            @box = ["box-new", box_name]
            box = cursor.append_tail(box, box_fields.node.datum, 0)
            node = cursor.make_node("box-new", cursor.loc(box, box_token, parser.locations))
            next = box_fields.next
        }
    }
    out cursor.Read { node = node, next = next, diagnostics = diagnostics }
}

skill binary(parser, start, minimum) {
    @first = postfix(parser, start)
    (diagnostic.has(first.diagnostics) == yes) { out first }
    @left = first.node
    @next = first.next
    @diagnostics = []
    drum (lexer.token_buffer_count(parser.tokens)) {
        @operator = cursor.at(parser, next)
        @level = literals.precedence(operator.kind)
        (level < minimum) { leave }
        (level == 0) { leave }
        @right = binary(parser, next + 1, level + 1)
        (diagnostic.has(right.diagnostics) == yes) {
            diagnostics = right.diagnostics
            leave
        }
        left = cursor.make_node("binary", cursor.loc(["binary", operator.value, left.datum, right.node.datum], operator, parser.locations))
        next = right.next
    }
    out cursor.Read { node = left, next = next, diagnostics = diagnostics }
}

skill expression(parser, start) {
    @value = binary(parser, start, 0)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    (cursor.is(parser, value.next, lexer.TokenKind.RESCUE) == yes) {
        @rescue_token = cursor.at(parser, value.next)
        @pipe = cursor.expect(parser, value.next + 1, lexer.TokenKind.PIPE, "ожидался |")
        (diagnostic.has(pipe.diagnostics) == yes) { out pipe }
        (cursor.is(parser, pipe.next, lexer.TokenKind.IDENT) == no) { out cursor.fail(parser, pipe.next, "ожидалось имя ошибки rescue") }
        @error_token = cursor.at(parser, pipe.next)
        @error_name = error_token.value
        @pipe2 = cursor.expect(parser, pipe.next + 1, lexer.TokenKind.PIPE, "ожидался |")
        (diagnostic.has(pipe2.diagnostics) == yes) { out pipe2 }
        @body = block(parser, pipe2.next)
        (diagnostic.has(body.diagnostics) == yes) { out body }
        out cursor.ok("rescue", cursor.loc(["rescue", value.node.datum, error_name, body.node.datum], rescue_token, parser.locations), body.next)
    }
    out value
}

skill group_literal(parser, start) {
    @token = cursor.at(parser, start)
    @list = expression_list(parser, start + 1, lexer.TokenKind.RBRACKET)
    (diagnostic.has(list.diagnostics) == yes) { out list }
    @items = ["group"]
    items = cursor.append_tail(items, list.node.datum, 0)
    out cursor.ok("group", cursor.loc(items, token, parser.locations), list.next)
}

skill block(parser, start) {
    @token = cursor.at(parser, start)
    @open = cursor.expect(parser, start, lexer.TokenKind.LBRACE, "ожидалась \{")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @lines = sequence(parser, open.next, lexer.TokenKind.RBRACE, "statement", "ожидалась инструкция", "ожидалась \}", no, no)
    @items = ["block"]
    items = cursor.append_tail(items, lines.node.datum, 0)
    out cursor.Read { node = cursor.make_node("block", cursor.loc(items, token, parser.locations)), next = lines.next, diagnostics = lines.diagnostics }
}

skill variable(parser, start) {
    @token = cursor.at(parser, start)
    (cursor.is(parser, start + 1, lexer.TokenKind.IDENT) == no) { out cursor.fail(parser, start + 1, "ожидалось имя переменной") }
    @name_token = cursor.at(parser, start + 1)
    @name = name_token.value
    @eq = cursor.expect(parser, start + 2, lexer.TokenKind.ASSIGN, "ожидался = после имени переменной")
    (diagnostic.has(eq.diagnostics) == yes) { out eq }
    @value = expression(parser, eq.next)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    out cursor.ok("var", cursor.loc(["var", name, value.node.datum], token, parser.locations), value.next)
}

skill assign(parser, start) {
    @token = cursor.at(parser, start)
    @value = expression(parser, start + 2)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    out cursor.ok("assign", cursor.loc(["assign", token.value, value.node.datum], token, parser.locations), value.next)
}

skill field_assign(parser, start) {
    @token = cursor.at(parser, start)
    @target = cursor.path_at(parser, start, parser.locations)
    (diagnostic.has(target.diagnostics) == yes) { out target }
    @eq = cursor.expect(parser, target.next, lexer.TokenKind.ASSIGN, "ожидался =")
    (diagnostic.has(eq.diagnostics) == yes) { out eq }
    @value = expression(parser, eq.next)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    out cursor.ok("field-assign", cursor.loc(["field-assign", target.node.datum, value.node.datum], token, parser.locations), value.next)
}

skill out_statement(parser, start) {
    @token = cursor.at(parser, start)
    @value = expression(parser, start + 1)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    out cursor.ok("out", cursor.loc(["out", value.node.datum], token, parser.locations), value.next)
}

skill always_statement(parser, start) {
    @token = cursor.at(parser, start)
    @body = block(parser, start + 1)
    (diagnostic.has(body.diagnostics) == yes) { out body }
    out cursor.ok("always", cursor.loc(["always", body.node.datum], token, parser.locations), body.next)
}

skill drum_statement(parser, start) {
    @token = cursor.at(parser, start)
    @open = cursor.expect(parser, start + 1, lexer.TokenKind.LPAREN, "ожидалась ( после drum")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @count = expression(parser, open.next)
    (diagnostic.has(count.diagnostics) == yes) { out count }
    @close = cursor.expect(parser, count.next, lexer.TokenKind.RPAREN, "ожидалась )")
    (diagnostic.has(close.diagnostics) == yes) { out close }
    @body = block(parser, close.next)
    (diagnostic.has(body.diagnostics) == yes) { out body }
    out cursor.ok("drum", cursor.loc(["drum", count.node.datum, body.node.datum], token, parser.locations), body.next)
}

skill pick_statement(parser, start) {
    @token = cursor.at(parser, start)
    @open = cursor.expect(parser, start + 1, lexer.TokenKind.LBRACE, "ожидалась \{ после pick")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @items = ["pick"]
    @next = cursor.skip_lines(parser, open.next)
    @count = lexer.token_buffer_count(parser.tokens)
    drum (count) {
        pick {
            (cursor.is(parser, next, lexer.TokenKind.RBRACE) == yes) { out cursor.Read { node = cursor.make_node("pick", cursor.loc(items, token, parser.locations)), next = next + 1, diagnostics = [] } }
            (cursor.is(parser, next, lexer.TokenKind.LBRACE) == yes) {
                @fallback_token = cursor.at(parser, next)
                @fallback = block(parser, next)
                (diagnostic.has(fallback.diagnostics) == yes) { out fallback }
                items = group.add(items, cursor.loc(["otherwise", fallback.node.datum], fallback_token, parser.locations))
                next = cursor.skip_lines(parser, fallback.next)
            }
            (cursor.is(parser, next, lexer.TokenKind.LPAREN) == yes) {
                @choice = paren_statement(parser, next)
                (diagnostic.has(choice.diagnostics) == yes) { out choice }
                items = group.add(items, choice.node.datum)
                next = cursor.skip_lines(parser, choice.next)
            }
            { out cursor.fail(parser, next, "ожидался вариант pick: (условие) \{ \} или \{ \}") }
        }
    }
    out cursor.fail(parser, next, "ожидалась \} после pick")
}

skill paren_statement(parser, start) {
    @token = cursor.at(parser, start)
    @value = expression(parser, start + 1)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    @close = cursor.expect(parser, value.next, lexer.TokenKind.RPAREN, "ожидалась )")
    (diagnostic.has(close.diagnostics) == yes) { out close }
    @open = cursor.expect(parser, close.next, lexer.TokenKind.LBRACE, "ожидалась \{")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @next = cursor.skip_lines(parser, open.next)
    (cursor.is(parser, next, lexer.TokenKind.DOT) == yes) {
        @cases = ["switch", value.node.datum]
        @diagnostics = []
        drum (lexer.token_buffer_count(parser.tokens)) {
            (cursor.is(parser, next, lexer.TokenKind.RBRACE) == yes) {
                next = next + 1
                leave
            }
            @case_token = cursor.at(parser, next)
            @dot = cursor.expect(parser, next, lexer.TokenKind.DOT, "ожидалась .")
            (diagnostic.has(dot.diagnostics) == yes) {
                diagnostics = dot.diagnostics
                leave
            }
            (cursor.is(parser, dot.next, lexer.TokenKind.IDENT) == no) {
                @failure = cursor.fail(parser, dot.next, "ожидалась метка ветки выбора")
                diagnostics = failure.diagnostics
                leave
            }
            @tag_token = cursor.at(parser, dot.next)
            @tag = tag_token.value
            @arrow = cursor.expect(parser, dot.next + 1, lexer.TokenKind.ARROW, "ожидался =>")
            (diagnostic.has(arrow.diagnostics) == yes) {
                diagnostics = arrow.diagnostics
                leave
            }
            @body = expression(parser, arrow.next)
            (diagnostic.has(body.diagnostics) == yes) {
                diagnostics = body.diagnostics
                leave
            }
            cases = group.add(cases, cursor.loc(["case", tag, body.node.datum], case_token, parser.locations))
            next = body.next
            @case_comma = no
            (cursor.is(parser, next, lexer.TokenKind.COMMA) == yes) {
                next = next + 1
                case_comma = yes
            }
            next = cursor.skip_lines(parser, next)
            (case_comma == yes) {
                (cursor.is(parser, next, lexer.TokenKind.RBRACE) == yes) {
                    @trailing_failure = cursor.fail_with(parser, next, errors.trailing_comma())
                    diagnostics = trailing_failure.diagnostics
                    leave
                }
            }
        }
        out cursor.Read { node = cursor.make_node("switch", cursor.loc(cases, token, parser.locations)), next = next, diagnostics = diagnostics }
    }
    @lines = sequence(parser, next, lexer.TokenKind.RBRACE, "statement", "ожидалась инструкция", "ожидалась \}", no, no)
    @items = ["block"]
    items = cursor.append_tail(items, lines.node.datum, 0)
    @located_body = cursor.loc(items, token, parser.locations)
    out cursor.Read { node = cursor.make_node("if", cursor.loc(["if", value.node.datum, located_body], token, parser.locations)), next = lines.next, diagnostics = lines.diagnostics }
}

skill statement(parser, start) {
    @token = cursor.at(parser, start)
    (token.kind == lexer.TokenKind.AT) { out variable(parser, start) }
    (token.kind == lexer.TokenKind.OUT) { out out_statement(parser, start) }
    (token.kind == lexer.TokenKind.DRUM) { out drum_statement(parser, start) }
    (token.kind == lexer.TokenKind.ALWAYS) { out always_statement(parser, start) }
    (token.kind == lexer.TokenKind.LEAVE) { out cursor.ok("leave", cursor.loc(["leave"], token, parser.locations), start + 1) }
    (token.kind == lexer.TokenKind.PICK) { out pick_statement(parser, start) }
    (token.kind == lexer.TokenKind.LPAREN) { out paren_statement(parser, start) }
    (token.kind == lexer.TokenKind.IDENT) {
        (cursor.is(parser, start + 1, lexer.TokenKind.ASSIGN) == yes) { out assign(parser, start) }
        @target = cursor.path_at(parser, start, no)
        (cursor.is(parser, target.next, lexer.TokenKind.ASSIGN) == yes) { out field_assign(parser, start) }
    }
    @value = expression(parser, start)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    out cursor.ok("expr", ["expr", value.node.datum], value.next)
}
