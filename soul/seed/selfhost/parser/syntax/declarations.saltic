-- declarations — объявления верхнего уровня: use, const, enum, box, skill, native, program.
-- Тела, параметры и выражения разбирает grammar; узлы с местом при
-- parser.locations = yes.
--
-- top(parser, start) -> Read одного объявления; иначе ошибка
--     «ожидалось объявление верхнего уровня»

use selfhost.diagnostic
use selfhost.parser.token
use selfhost.parser.syntax.cursor
use selfhost.parser.syntax.grammar

skill module(parser, start) {
    @word = cursor.at(parser, start)
    @path = cursor.path_at(parser, start + 1, no)
    (diagnostic.has(path.diagnostics) == yes) { out path }
    @parts = path.node.datum
    @datum = ["use"]
    datum = cursor.append_tail(datum, parts, 1)
    out cursor.ok("use", cursor.loc(datum, word, parser.locations), path.next)
}

skill constant(parser, start) {
    @word = cursor.at(parser, start)
    @value = grammar.expression(parser, start + 2)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    out cursor.ok("const", cursor.loc(["const", word.value, value.node.datum], word, parser.locations), value.next)
}

skill entry(parser, start) {
    @word = cursor.at(parser, start)
    @open = cursor.expect(parser, start + 1, Token.Kind.LPAREN, "expected_program_paren")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @params = grammar.params(parser, open.next)
    (diagnostic.has(params.diagnostics) == yes) { out params }
    @body = grammar.block(parser, params.next)
    (diagnostic.has(body.diagnostics) == yes) { out body }
    out cursor.ok("entry", cursor.loc(["entry", params.node.datum, body.node.datum], word, parser.locations), body.next)
}

skill named_skill(parser, start) {
    @word = cursor.at(parser, start)
    (cursor.is(parser, start + 1, Token.Kind.IDENT) == no) { out cursor.fail(parser, start + 1, "expected_skill_name") }
    @name_token = cursor.at(parser, start + 1)
    @name = name_token.value
    @open = cursor.expect(parser, start + 2, Token.Kind.LPAREN, "expected_open_paren")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @params = grammar.params(parser, open.next)
    (diagnostic.has(params.diagnostics) == yes) { out params }
    (cursor.is(parser, params.next, Token.Kind.NATIVE) == yes) {
        out cursor.ok("native", cursor.loc(["native", name, params.node.datum], word, parser.locations), params.next + 1)
    }
    @body = grammar.block(parser, params.next)
    (diagnostic.has(body.diagnostics) == yes) { out body }
    out cursor.ok("skill", cursor.loc(["skill", name, params.node.datum, body.node.datum], word, parser.locations), body.next)
}

skill enumeration(parser, start) {
    out grammar.enum_declaration(parser, start)
}

skill box(parser, start) {
    out grammar.box_declaration(parser, start)
}

skill top(parser, start) {
    @word = cursor.at(parser, start)
    (word.kind == Token.Kind.USE) { out module(parser, start) }
    (word.kind == Token.Kind.PROGRAM) { out entry(parser, start) }
    (word.kind == Token.Kind.SKILL) { out named_skill(parser, start) }
    (word.kind == Token.Kind.IDENT) {
        (cursor.is(parser, start + 1, Token.Kind.ASSIGN) == yes) {
            (cursor.is(parser, start + 2, Token.Kind.BOX) == yes) { out box(parser, start) }
            (cursor.is(parser, start + 2, Token.Kind.ENUM) == yes) { out enumeration(parser, start) }
            out constant(parser, start)
        }
    }
    out cursor.fail(parser, start, "expected_declaration")
}
