-- declarations — объявления верхнего уровня: use, const, enum, box, skill, native, program.
-- Тела, параметры и выражения разбирает grammar; узлы с местом при
-- parser.locations = yes.
--
-- top(parser, start) -> Read одного объявления; иначе ошибка
--     «ожидалось объявление верхнего уровня»

use selfhost.diagnostic
use selfhost.parser.lexer
use selfhost.parser.syntax.cursor
use selfhost.parser.syntax.grammar

skill module(parser, start) {
    @token = cursor.at(parser, start)
    @path = cursor.path_at(parser, start + 1, no)
    (diagnostic.has(path.diagnostics) == yes) { out path }
    @parts = path.node.datum
    @datum = ["use"]
    datum = cursor.append_tail(datum, parts, 1)
    out cursor.ok("use", cursor.loc(datum, token, parser.locations), path.next)
}

skill constant(parser, start) {
    @token = cursor.at(parser, start)
    @value = grammar.expression(parser, start + 2)
    (diagnostic.has(value.diagnostics) == yes) { out value }
    out cursor.ok("const", cursor.loc(["const", token.value, value.node.datum], token, parser.locations), value.next)
}

skill entry(parser, start) {
    @token = cursor.at(parser, start)
    @open = cursor.expect(parser, start + 1, lexer.TokenKind.LPAREN, "ожидалась ( после program")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @params = grammar.params(parser, open.next)
    (diagnostic.has(params.diagnostics) == yes) { out params }
    @body = grammar.block(parser, params.next)
    (diagnostic.has(body.diagnostics) == yes) { out body }
    out cursor.ok("entry", cursor.loc(["entry", params.node.datum, body.node.datum], token, parser.locations), body.next)
}

skill named_skill(parser, start) {
    @token = cursor.at(parser, start)
    (cursor.is(parser, start + 1, lexer.TokenKind.IDENT) == no) { out cursor.fail(parser, start + 1, "ожидалось имя skill") }
    @name_token = cursor.at(parser, start + 1)
    @name = name_token.value
    @open = cursor.expect(parser, start + 2, lexer.TokenKind.LPAREN, "ожидалась (")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @params = grammar.params(parser, open.next)
    (diagnostic.has(params.diagnostics) == yes) { out params }
    (cursor.is(parser, params.next, lexer.TokenKind.NATIVE) == yes) {
        out cursor.ok("native", cursor.loc(["native", name, params.node.datum], token, parser.locations), params.next + 1)
    }
    @body = grammar.block(parser, params.next)
    (diagnostic.has(body.diagnostics) == yes) { out body }
    out cursor.ok("skill", cursor.loc(["skill", name, params.node.datum, body.node.datum], token, parser.locations), body.next)
}

skill box_members(parser, start) {
    @open = cursor.expect(parser, start, lexer.TokenKind.LBRACE, "ожидалась \{")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @members = grammar.sequence(parser, open.next, lexer.TokenKind.RBRACE, "member", "ожидалось поле или skill", "ожидалась \}", no, yes)
    out cursor.Read { node = cursor.make_node("box-members", members.node.datum), next = members.next, diagnostics = members.diagnostics }
}

skill enumeration(parser, start) {
    @token = cursor.at(parser, start)
    @open = cursor.expect(parser, start + 3, lexer.TokenKind.LBRACE, "ожидалась \{")
    (diagnostic.has(open.diagnostics) == yes) { out open }
    @datum = ["enum", token.value]
    @variants = grammar.names(parser, open.next, lexer.TokenKind.RBRACE, "ожидался вариант enum")
    (diagnostic.has(variants.diagnostics) == yes) { out variants }
    datum = cursor.append_tail(datum, variants.node.datum, 0)
    out cursor.ok("enum", cursor.loc(datum, token, parser.locations), variants.next)
}

skill box(parser, start) {
    @token = cursor.at(parser, start)
    @members = box_members(parser, start + 3)
    (diagnostic.has(members.diagnostics) == yes) { out members }
    @datum = ["box", token.value]
    datum = cursor.append_tail(datum, members.node.datum, 0)
    out cursor.ok("box", cursor.loc(datum, token, parser.locations), members.next)
}

skill top(parser, start) {
    @token = cursor.at(parser, start)
    (token.kind == lexer.TokenKind.USE) { out module(parser, start) }
    (token.kind == lexer.TokenKind.PROGRAM) { out entry(parser, start) }
    (token.kind == lexer.TokenKind.SKILL) { out named_skill(parser, start) }
    (token.kind == lexer.TokenKind.IDENT) {
        (cursor.is(parser, start + 1, lexer.TokenKind.ASSIGN) == yes) {
            (cursor.is(parser, start + 2, lexer.TokenKind.BOX) == yes) { out box(parser, start) }
            (cursor.is(parser, start + 2, lexer.TokenKind.ENUM) == yes) { out enumeration(parser, start) }
            out constant(parser, start)
        }
    }
    out cursor.fail(parser, start, "ожидалось объявление верхнего уровня")
}
