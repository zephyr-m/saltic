-- declarations — объявления: верхнего уровня (use, константа, enum, Box,
-- навык, native, program) и вложенные — Box, enum и навык субъекта внутри Box.
-- Тела, параметры и выражения разбирают соседи — Statements, Lists,
-- Expressions; узлы с местом при look.locations = yes.
--
-- Declarations = Box { look, leaves } — look — Reader, leaves — Literals; навыки:
-- top(start) -> Read одного объявления верхнего уровня; иначе ошибка
--     «ожидалось объявление верхнего уровня»
-- module / constant / entry / named_skill(start) -> Read use, константы,
--     program, навыка или native
-- box_declaration(start) -> Read "box" — Имя = Box { поля, навыки, вложенные
--     Box и enum } (вложенный — часть объекта, решение автора 19.11.2026)
-- enum_declaration(start) -> Read "enum" — Имя = enum { ВАРИАНТ, … }; внутри
--     Box — состояния субъекта для его конечного автомата
-- subject_skill(start) -> Read "subject-skill" (skill внутри Box)
-- words() / lists() / steps() -> соседи Expressions, Lists, Statements на
--     тех же look и leaves

use selfhost.diagnostic
use selfhost.parser.token
use selfhost.parser.syntax.reader
use selfhost.parser.syntax.literals
use selfhost.parser.syntax.expressions
use selfhost.parser.syntax.lists
use selfhost.parser.syntax.statements

Declarations = Box {
    look = Reader {},
    leaves = Literals {}

    skill module(start) {
        @word = look.at(start)
        @path = look.path_at(start + 1, no)
        (path.broken() == yes) {
            out path
        }
        @parts = path.datum()
        @datum = ["use"]
        datum = look.append_tail(datum, parts, 1)
        out look.ok("use", look.loc(datum, word, look.locations), path.next)
    }

    skill constant(start) {
        @word = look.at(start)
        @speaking = words()
        @value = speaking.expression(start + 2)
        (value.broken() == yes) {
            out value
        }
        out look.ok("const", look.loc(["const", word.value, value.datum()], word, look.locations), value.next)
    }

    skill entry(start) {
        @word = look.at(start)
        @open = look.expect(start + 1, Token.Kind.LPAREN, "expected_program_paren")
        (open.broken() == yes) {
            out open
        }
        @listing = lists()
        @params = listing.params(open.next)
        (params.broken() == yes) {
            out params
        }
        @stepping = steps()
        @body = stepping.block(params.next)
        (body.broken() == yes) {
            out body
        }
        out look.ok("entry", look.loc(["entry", params.datum(), body.datum()], word, look.locations), body.next)
    }

    skill named_skill(start) {
        @word = look.at(start)
        (look.is(start + 1, Token.Kind.IDENT) == no) {
            out look.fail(start + 1, "expected_skill_name")
        }
        @name_token = look.at(start + 1)
        @name = name_token.value
        @open = look.expect(start + 2, Token.Kind.LPAREN, "expected_open_paren")
        (open.broken() == yes) {
            out open
        }
        @listing = lists()
        @params = listing.params(open.next)
        (params.broken() == yes) {
            out params
        }
        (look.is(params.next, Token.Kind.NATIVE) == yes) {
            out look.ok("native", look.loc(["native", name, params.datum()], word, look.locations), params.next + 1)
        }
        @stepping = steps()
        @body = stepping.block(params.next)
        (body.broken() == yes) {
            out body
        }
        out look.ok("skill", look.loc(["skill", name, params.datum(), body.datum()], word, look.locations), body.next)
    }

    skill top(start) {
        @word = look.at(start)
        (word.kind == Token.Kind.USE) {
            out module(start)
        }
        (word.kind == Token.Kind.PROGRAM) {
            out entry(start)
        }
        (word.kind == Token.Kind.SKILL) {
            out named_skill(start)
        }
        (word.kind == Token.Kind.IDENT) {
            (look.is(start + 1, Token.Kind.ASSIGN) == yes) {
                (look.is(start + 2, Token.Kind.BOX) == yes) {
                    out box_declaration(start)
                }
                (look.is(start + 2, Token.Kind.ENUM) == yes) {
                    out enum_declaration(start)
                }
                out constant(start)
            }
        }
        out look.fail(start, "expected_declaration")
    }

    skill box_declaration(start) {
        @word = look.at(start)
        @open = look.expect(start + 3, Token.Kind.LBRACE, "expected_open_brace")
        (open.broken() == yes) {
            out open
        }
        @listing = lists()
        @members = listing.sequence(open.next, Token.Kind.RBRACE, "member", "expected_field_or_skill", "expected_close_brace", no, yes)
        (members.broken() == yes) {
            out members
        }
        @datum = look.append_tail(["box", word.value], members.datum(), 0)
        out look.ok("box", look.loc(datum, word, look.locations), members.next)
    }

    skill enum_declaration(start) {
        @word = look.at(start)
        @open = look.expect(start + 3, Token.Kind.LBRACE, "expected_open_brace")
        (open.broken() == yes) {
            out open
        }
        @listing = lists()
        @variants = listing.names(open.next, Token.Kind.RBRACE, "expected_enum_variant")
        (variants.broken() == yes) {
            out variants
        }
        @datum = look.append_tail(["enum", word.value], variants.datum(), 0)
        out look.ok("enum", look.loc(datum, word, look.locations), variants.next)
    }

    skill subject_skill(start) {
        @word = look.at(start)
        (look.is(start + 1, Token.Kind.IDENT) == no) {
            out look.fail(start + 1, "expected_skill_name")
        }
        @name_token = look.at(start + 1)
        @open = look.expect(start + 2, Token.Kind.LPAREN, "expected_open_paren")
        (open.broken() == yes) {
            out open
        }
        @listing = lists()
        @parsed_params = listing.params(open.next)
        (parsed_params.broken() == yes) {
            out parsed_params
        }
        @stepping = steps()
        @body = stepping.block(parsed_params.next)
        (body.broken() == yes) {
            out body
        }
        out look.ok("subject-skill", look.loc(["subject-skill", name_token.value, parsed_params.datum(), body.datum()], word, look.locations), body.next)
    }

    skill words() {
        out Expressions {
            look = look,
            leaves = leaves
        }
    }

    skill lists() {
        out Lists {
            look = look,
            leaves = leaves
        }
    }

    skill steps() {
        out Statements {
            look = look,
            leaves = leaves
        }
    }
}
