-- declarations — объявления верхнего уровня: use, const, enum, box, skill, native, program.
-- Тела, параметры и выражения разбирает grammar; узлы с местом при
-- look.locations = yes.
--
-- Declarations = Box { look, speech } — look — Reader, speech — Grammar; навыки:
-- top(start) -> Read одного объявления; иначе ошибка
--     «ожидалось объявление верхнего уровня»

use selfhost.diagnostic
use selfhost.parser.token
use selfhost.parser.syntax.reader
use selfhost.parser.syntax.grammar

Declarations = Box {
    look = Reader {},
    speech = Grammar {}

    skill module(start) {
        @word = look.at(start)
        @path = look.path_at(start + 1, no)
        (path.broken() == yes) { out path }
        @parts = path.datum()
        @datum = ["use"]
        datum = look.append_tail(datum, parts, 1)
        out look.ok("use", look.loc(datum, word, look.locations), path.next)
    }

    skill constant(start) {
        @word = look.at(start)
        @value = speech.expression(start + 2)
        (value.broken() == yes) { out value }
        out look.ok("const", look.loc(["const", word.value, value.datum()], word, look.locations), value.next)
    }

    skill entry(start) {
        @word = look.at(start)
        @open = look.expect(start + 1, Token.Kind.LPAREN, "expected_program_paren")
        (open.broken() == yes) { out open }
        @params = speech.params(open.next)
        (params.broken() == yes) { out params }
        @body = speech.block(params.next)
        (body.broken() == yes) { out body }
        out look.ok("entry", look.loc(["entry", params.datum(), body.datum()], word, look.locations), body.next)
    }

    skill named_skill(start) {
        @word = look.at(start)
        (look.is(start + 1, Token.Kind.IDENT) == no) { out look.fail(start + 1, "expected_skill_name") }
        @name_token = look.at(start + 1)
        @name = name_token.value
        @open = look.expect(start + 2, Token.Kind.LPAREN, "expected_open_paren")
        (open.broken() == yes) { out open }
        @params = speech.params(open.next)
        (params.broken() == yes) { out params }
        (look.is(params.next, Token.Kind.NATIVE) == yes) {
            out look.ok("native", look.loc(["native", name, params.datum()], word, look.locations), params.next + 1)
        }
        @body = speech.block(params.next)
        (body.broken() == yes) { out body }
        out look.ok("skill", look.loc(["skill", name, params.datum(), body.datum()], word, look.locations), body.next)
    }

    skill enumeration(start) {
        out speech.enum_declaration(start)
    }

    skill box(start) {
        out speech.box_declaration(start)
    }

    skill top(start) {
        @word = look.at(start)
        (word.kind == Token.Kind.USE) { out module(start) }
        (word.kind == Token.Kind.PROGRAM) { out entry(start) }
        (word.kind == Token.Kind.SKILL) { out named_skill(start) }
        (word.kind == Token.Kind.IDENT) {
            (look.is(start + 1, Token.Kind.ASSIGN) == yes) {
                (look.is(start + 2, Token.Kind.BOX) == yes) { out box(start) }
                (look.is(start + 2, Token.Kind.ENUM) == yes) { out enumeration(start) }
                out constant(start)
            }
        }
        out look.fail(start, "expected_declaration")
    }
}
