use io.file
use core.str
use core.group
use selfhost.ast
use selfhost.diagnostic
use selfhost.parser.syntax

Load = Box {
    ast = [],
    included = [],
    diagnostics = []
}

skill group_contains(items, value) {
    drum (items) {
        (beat == value) { out yes }
    }
    out no
}

skill join_path(base, relative) {
    (str.ends_with(base, "/") == yes) { out str.add(base, relative) }
    out "{base}/{relative}"
}

skill module_relative(parts) {
    @relative = ""
    drum (group.count(parts)) {
        (beat > 0) { relative = "{relative}/" }
        relative = str.add(relative, group.item(parts, beat))
    }
    out "{relative}.saltic"
}

skill module_text(parts) {
    @text = ""
    drum (group.count(parts)) {
        (beat > 0) { text = "{text}." }
        text = str.add(text, group.item(parts, beat))
    }
    out text
}

skill resolve_module(source_path, parts, root) {
    @base = root
    @first = group.item(parts, 0)
    (first == "seed") { base = join_path(root, "soul") }
    (first == "craft") { base = join_path(root, "soul") }
    (first == "canonical") { base = join_path(root, "soul") }
    (first == "core") { base = join_path(root, "soul/seed") }
    (first == "io") { base = join_path(root, "soul/seed") }
    (first == "selfhost") { base = join_path(root, "soul/seed") }
    out join_path(base, module_relative(parts))
}

skill load_error(path, message, included) {
    @text = "модули: {message}"
    out Load { ast = syntax.group1("program"), included = included, diagnostics = syntax.group1(diagnostic.make_at("module_error", path, 0, 0, text)) }
}

skill expand_file(path, root, locations, included, stack, module_name) {
    @name = path
    (str.len(module_name) > 0) { name = "{module_name} ({path})" }
    @importer = path
    (group.count(stack) > 0) { importer = group.item(stack, group.count(stack) - 1) }
    (group_contains(stack, path) == yes) { out load_error(importer, "циклический импорт: {name}", included) }
    (group_contains(included, path) == yes) { out Load { ast = syntax.group1("program"), included = included, diagnostics = [] } }
    @next_included = group.add(included, path)
    @source = file.read(path) rescue |error| {
        out load_error(importer, "модуль не найден: {name}", next_included)
    }
    @parsed = syntax.parse_string(source, path)
    (locations == yes) { parsed = syntax.parse_string_loc(source, path) }
    (syntax.has_diagnostics(parsed.diagnostics) == yes) { out Load { ast = syntax.group1("program"), included = next_included, diagnostics = parsed.diagnostics } }
    @output = syntax.group1("program")
    @next_stack = group.add(stack, path)
    @diagnostics = []
    drum (group.count(parsed.ast) - 1) {
        @item = group.item(parsed.ast, beat + 1)
        @plain = ast.plain(item)
        @include_item = yes
        (group.item(plain, 0) == "entry") {
            (group.count(stack) > 0) { include_item = no }
        }
        (include_item == yes) {
            @output_item = item
            (str.len(module_name) > 0) { output_item = ast.in_module(module_name, item) }
            output = group.add(output, output_item)
        }
        (group.item(plain, 0) == "use") {
            @parts = syntax.append_tail([], plain, 1)
            @module_path = resolve_module(path, parts, root)
            @loaded = expand_file(module_path, root, locations, next_included, next_stack, module_text(parts))
            next_included = loaded.included
            (syntax.has_diagnostics(loaded.diagnostics) == yes) {
                diagnostics = loaded.diagnostics
                leave
            }
            output = syntax.append_tail(output, loaded.ast, 1)
        }
    }
    out Load { ast = output, included = next_included, diagnostics = diagnostics }
}

skill load_file(path, root) {
    out expand_file(path, root, no, [], [], "")
}

skill load_file_loc(path, root) {
    out expand_file(path, root, yes, [], [], "")
}

skill load_modules(path, root) {
    out load_file(path, root)
}
