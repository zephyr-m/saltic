-- loader — собирает программу из файла и всех его use в одно дерево.
-- Путь модуля — от root: seed/craft/canonical -> soul/, core/io/selfhost ->
-- soul/seed/, остальное — как есть. Узлы модуля обёрнуты ast.in_module;
-- entry (program) берётся только из корневого файла; повторный use
-- пропускается, цикл — ошибка.
--
-- Load = Box { ast, included, diagnostics }
-- join_path(base, relative) -> путь
-- resolve_module(source_path, parts, root) -> путь к файлу модуля
-- load_error(path, problem, included, place) -> Load с одной ошибкой на месте place
-- expand_file(path, root, locations, included, stack, module_name, place) -> Load;
--     place = [строка, столбец] узла use, которым файл подключён ([0, 0] у корня)
-- load_file / load_file_loc(path, root) -> Load; load_modules(path, root) — то же

use io.file
use core.str
use core.group
use selfhost.ast
use selfhost.diagnostic
use selfhost.errors
use selfhost.parser.syntax

Load = Box {
    ast = [],
    included = [],
    diagnostics = []
}

skill join_path(base, relative) {
    (str.ends_with(base, "/") == yes) { out str.concat(base, relative) }
    out "{base}/{relative}"
}

skill resolve_module(source_path, parts, root) {
    @base = root
    @first = group.get(parts, 0)
    (first == "seed") { base = join_path(root, "soul") }
    (first == "craft") { base = join_path(root, "soul") }
    (first == "canonical") { base = join_path(root, "soul") }
    (first == "core") { base = join_path(root, "soul/seed") }
    (first == "io") { base = join_path(root, "soul/seed") }
    (first == "selfhost") { base = join_path(root, "soul/seed") }
    out join_path(base, str.concat(str.join(parts, "/"), ".saltic"))
}

skill load_error(path, problem, included, place) {
    out Load { ast = ["program"], included = included, diagnostics = [diagnostic.place(problem, path, group.get(place, 0), group.get(place, 1))] }
}

skill expand_file(path, root, locations, included, stack, module_name, place) {
    @name = path
    (str.bytes(module_name) > 0) { name = "{module_name} ({path})" }
    @importer = path
    (group.count(stack) > 0) { importer = group.get(stack, group.count(stack) - 1) }
    (group.contains(stack, path) == yes) { out load_error(importer, errors.import_cycle(name), included, place) }
    (group.contains(included, path) == yes) { out Load { ast = ["program"], included = included, diagnostics = [] } }
    @next_included = group.add(included, path)
    @source = file.read(path) rescue |error| {
        out load_error(importer, errors.module_not_found(name), next_included, place)
    }
    @parsed = syntax.parse_string(source, path)
    (locations == yes) { parsed = syntax.parse_string_loc(source, path) }
    (diagnostic.has(parsed.diagnostics) == yes) { out Load { ast = ["program"], included = next_included, diagnostics = parsed.diagnostics } }
    @output = ["program"]
    @next_stack = group.add(stack, path)
    @diagnostics = []
    drum (group.count(parsed.ast) - 1) {
        @item = group.get(parsed.ast, beat + 1)
        @plain = ast.plain(item)
        @include_item = yes
        (group.get(plain, 0) == "entry") {
            (group.count(stack) > 0) { include_item = no }
        }
        (include_item == yes) {
            @output_item = item
            (str.bytes(module_name) > 0) { output_item = ast.in_module(module_name, item) }
            output = group.add(output, output_item)
        }
        (group.get(plain, 0) == "use") {
            @parts = syntax.append_tail([], plain, 1)
            @module_path = resolve_module(path, parts, root)
            @loaded = expand_file(module_path, root, locations, next_included, next_stack, str.join(parts, "."), ast.location(item))
            next_included = loaded.included
            (diagnostic.has(loaded.diagnostics) == yes) {
                diagnostics = loaded.diagnostics
                leave
            }
            output = syntax.append_tail(output, loaded.ast, 1)
        }
    }
    out Load { ast = output, included = next_included, diagnostics = diagnostics }
}

skill load_file(path, root) {
    out expand_file(path, root, no, [], [], "", [0, 0])
}

skill load_file_loc(path, root) {
    out expand_file(path, root, yes, [], [], "", [0, 0])
}

skill load_modules(path, root) {
    out load_file(path, root)
}
