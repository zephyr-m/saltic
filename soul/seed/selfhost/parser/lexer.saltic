-- lexer — текст исходника -> поток токенов с местом (строка, столбец).
-- Токены лежат в TokenBuffer кусками по CHUNK = 256 (читать через at).
-- Сам: слова, числа, знаки; строки "…" и тексты #…# разбирает parser.text
-- (Text — один на проход scan; Text и Lexer знают друг друга, use по кругу).
-- Комментарий -- допустим только до первого токена кода, иначе
-- comment_outside_header; при первой ошибке сканирование останавливается.
-- Кольцо RING «○» — AND (и), два подряд «○○» — OR (или): знак, а не
-- буква, поэтому ни с каким именем не слипается.
--
-- Токен и его вид — parser.token (Token, Token.Kind).
--
-- Lexer = Box { source, path } с методом scan() -> Scan; его части:
--     TokenBuffer — Box { chunks, tail, length }: keep(item) -> новый буфер на
--         токен длиннее (не пишет в свои поля: запись хвоста в поле в 3,6 раза
--         медленнее), at(index), count()
--     Scan — Box { tokens, diagnostics }; Lexeme — Box { token, next, line, col,
--         diagnostics } — кусок разбора (слово, число, строка от Text)

use core.str
use core.group
use selfhost.diagnostic
use selfhost.errors
use selfhost.parser.token
use selfhost.parser.text

NEWLINE = "\n"
TAB = "\t"
CHUNK = 256
RING = "○"

SIGNS = ["@", "\{", "\}", "[", "]", "(", ")", ",", ".", "|", "=", ">", "<", "+", "-", "*", "/", "%"]

SIGN_KINDS = [
    Token.Kind.AT, Token.Kind.LBRACE, Token.Kind.RBRACE,
    Token.Kind.LBRACKET, Token.Kind.RBRACKET, Token.Kind.LPAREN, Token.Kind.RPAREN,
    Token.Kind.COMMA, Token.Kind.DOT, Token.Kind.PIPE, Token.Kind.ASSIGN,
    Token.Kind.GT, Token.Kind.LT, Token.Kind.PLUS, Token.Kind.MINUS, Token.Kind.STAR, Token.Kind.SLASH,
    Token.Kind.PERCENT
]

KEYWORDS = ["skill", "program", "use", "Box", "out", "enum", "drum", "rescue", "yes", "no", "none", "leave", "pick", "native", "always"]

KEYWORD_KINDS = [
    Token.Kind.SKILL, Token.Kind.PROGRAM, Token.Kind.USE, Token.Kind.BOX,
    Token.Kind.OUT, Token.Kind.ENUM, Token.Kind.DRUM, Token.Kind.RESCUE,
    Token.Kind.YES, Token.Kind.NO, Token.Kind.NONE, Token.Kind.LEAVE, Token.Kind.PICK, Token.Kind.NATIVE, Token.Kind.ALWAYS
]

Lexer = Box {
    source = "",
    path = ""

    TokenBuffer = Box {
        chunks = [],
        tail = [],
        length = 0

        skill keep(item) {
            @next_chunks = chunks
            @next_tail = group.add(tail, item)
            (group.count(next_tail) == CHUNK) {
                next_chunks = group.add(next_chunks, next_tail)
                next_tail = []
            }
            out TokenBuffer {
                chunks = next_chunks,
                tail = next_tail,
                length = length + 1
            }
        }

        skill at(index) {
            @chunk_index = index / CHUNK
            @item_index = index - chunk_index * CHUNK
            (chunk_index < group.count(chunks)) {
                out group.get(group.get(chunks, chunk_index), item_index)
            }
            out group.get(tail, item_index)
        }

        skill count() {
            out length
        }
    }

    Scan = Box {
        tokens = TokenBuffer {},
        diagnostics = []
    }

    Lexeme = Box {
        token = none,
        next = 0,
        line = 1,
        col = 1,
        diagnostics = []
    }

    skill token(kind, value, line, col) {
        out Token { kind = kind, value = value, line = line, col = col }
    }

    skill ascii_letter(ch) {
        out str.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", ch)
    }

    skill ident_start(ch) {
        (ascii_letter(ch) == yes) { out yes }
        (ch == "_") { out yes }
        @upper = str.upper(ch)
        @lower = str.lower(ch)
        (upper == lower) { out no }
        out yes
    }

    skill ident_part(ch) {
        (ident_start(ch) == yes) { out yes }
        out str.is_digit(ch)
    }

    skill word(start, line, col) {
        @index = start
        @next_col = col
        @length = str.bytes(source)
        drum (length - start) {
            @part = str.get(source, index)
            (ident_part(part) == no) {
                @value = str.slice(source, start, index)
                out Lexeme {
                    token = token(word_kind(value), value, line, col),
                    next = index,
                    line = line,
                    col = next_col
                }
            }
            index = index + 1
            next_col = next_col + 1
        }
        @value = str.slice(source, start, index)
        out Lexeme {
            token = token(word_kind(value), value, line, col),
            next = index,
            line = line,
            col = next_col
        }
    }

    skill number(start, line, col) {
        @index = start
        @next_col = col
        @length = str.bytes(source)
        @dot = no
        drum (length - start) {
            @digit = str.get(source, index)
            @take = str.is_digit(digit)
            (digit == ".") {
                (dot == no) {
                    (index + 1 < length) {
                        (str.is_digit(str.get(source, index + 1)) == yes) {
                            take = yes
                            dot = yes
                        }
                    }
                }
            }
            (take == no) {
                out Lexeme {
                    token = token(Token.Kind.NUMBER, str.slice(source, start, index), line, col),
                    next = index,
                    line = line,
                    col = next_col
                }
            }
            index = index + 1
            next_col = next_col + 1
        }
        out Lexeme {
            token = token(Token.Kind.NUMBER, str.slice(source, start, index), line, col),
            next = index,
            line = line,
            col = next_col
        }
    }

    skill table_kind(values, kinds, value, fallback) {
        drum (group.count(values)) {
            (group.get(values, beat) == value) { out group.get(kinds, beat) }
        }
        out fallback
    }

    skill pair_at(index) {
        (index + 1 < str.bytes(source)) { out str.slice(source, index, index + 2) }
        out ""
    }

    skill has_code(tokens) {
        drum (tokens.count()) {
            @item = tokens.at(beat)
            ((item.kind == Token.Kind.NEWLINE) == no) { out yes }
        }
        out no
    }

    skill word_kind(word) {
        out table_kind(KEYWORDS, KEYWORD_KINDS, word, Token.Kind.IDENT)
    }

    skill sign_kind(ch) {
        out table_kind(SIGNS, SIGN_KINDS, ch, Token.Kind.INVALID)
    }

    skill scan() {
        @texts = Text {
            source = source,
            path = path
        }
        @tokens = TokenBuffer()
        @diagnostics = []
        @index = 0
        @line = 1
        @col = 1
        @length = str.bytes(source)
        drum (length + 1) {
            (index >= length) { leave }
            @ch = str.get(source, index)
            pick {
                (ch == " ") {
                    index = index + 1
                    col = col + 1
                }
                (ch == TAB) {
                    index = index + 1
                    col = col + 1
                }
                (ch == NEWLINE) {
                    tokens = tokens.keep(token(Token.Kind.NEWLINE, NEWLINE, line, col))
                    index = index + 1
                    line = line + 1
                    col = 1
                }
                (str.starts_at(source, RING, index) == yes) {
                    @size = str.bytes(RING)
                    pick {
                        (str.starts_at(source, RING, index + size) == yes) {
                            tokens = tokens.keep(token(Token.Kind.OR, "{RING}{RING}", line, col))
                            size = size * 2
                        }
                        {
                            tokens = tokens.keep(token(Token.Kind.AND, RING, line, col))
                        }
                    }
                    index = index + size
                    col = col + size
                }
                (ident_start(ch) == yes) {
                    @lexeme = word(index, line, col)
                    tokens = tokens.keep(lexeme.token)
                    index = lexeme.next
                    line = lexeme.line
                    col = lexeme.col
                }
                (str.is_digit(ch) == yes) {
                    @lexeme = number(index, line, col)
                    tokens = tokens.keep(lexeme.token)
                    index = lexeme.next
                    line = lexeme.line
                    col = lexeme.col
                }
                (str.contains("#\"", ch) == yes) {
                    @lexeme = texts.text(index, line, col)
                    index = lexeme.next
                    line = lexeme.line
                    col = lexeme.col
                    diagnostics = lexeme.diagnostics
                    (diagnostic.has(diagnostics) == yes) { leave }
                    tokens = tokens.keep(lexeme.token)
                }
                (pair_at(index) == "--") {
                    (has_code(tokens) == yes) {
                        diagnostics = group.add(diagnostics, diagnostic.place(errors.comment_outside_header(), path, line, col))
                        leave
                    }
                    @end = texts.newline_at(index + 2)
                    col = col + (end - index)
                    index = end
                }
                (pair_at(index) == "==") {
                    tokens = tokens.keep(token(Token.Kind.EQ, "==", line, col))
                    index = index + 2
                    col = col + 2
                }
                (pair_at(index) == ">=") {
                    tokens = tokens.keep(token(Token.Kind.GE, ">=", line, col))
                    index = index + 2
                    col = col + 2
                }
                (pair_at(index) == "<=") {
                    tokens = tokens.keep(token(Token.Kind.LE, "<=", line, col))
                    index = index + 2
                    col = col + 2
                }
                (pair_at(index) == "~=") {
                    tokens = tokens.keep(token(Token.Kind.NEAR, "~=", line, col))
                    index = index + 2
                    col = col + 2
                }
                (pair_at(index) == "=>") {
                    tokens = tokens.keep(token(Token.Kind.ARROW, "=>", line, col))
                    index = index + 2
                    col = col + 2
                }
                (sign_kind(ch) == Token.Kind.INVALID) {
                    diagnostics = group.add(diagnostics, diagnostic.place(errors.unexpected_symbol(ch), path, line, col))
                    leave
                }
                {
                    tokens = tokens.keep(token(sign_kind(ch), ch, line, col))
                    index = index + 1
                    col = col + 1
                }
            }
        }
        tokens = tokens.keep(token(Token.Kind.EOF, "", line, col))
        out Scan { tokens = tokens, diagnostics = diagnostics }
    }
}
