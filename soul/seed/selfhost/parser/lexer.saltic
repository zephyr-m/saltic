-- lexer — текст исходника -> поток токенов с местом (строка, столбец).
-- Токены лежат в TokenBuffer кусками по 256 (читать через token_buffer_at).
-- Строка "{…}" становится TEMPLATE с parts = [текст, имя, текст, …].
-- "…" — строго одна строка. Текст в несколько строк — блок #: открывающий #
-- в конце строки, закрывающий # один на своей строке; его отступ снимается со
-- всех строк, перенос перед ним в текст не входит; {…} и \-escape те же.
-- Текст строки не склеивается посимвольно: run — начало нетронутого отрезка
-- исходника, он берётся одним срезом; после экранирования срез и расшифровка
-- копятся в piece и по TEXT_PIECE байт уходят в value (collected их сводит).
-- Комментарий -- допустим только до первого токена кода, иначе
-- comment_outside_header; при первой ошибке сканирование останавливается.
--
-- TokenKind = enum { INVALID, IDENT, NUMBER, STRING, NEWLINE, EOF, ключевые
--     слова, знаки, TEMPLATE, NEAR (~=) }
-- Token = Box { kind, value, parts, line, col }
-- TokenBuffer = Box { chunks, tail, length }; Scan = Box { tokens, diagnostics }
-- Lexeme = Box { token, next, line, col, diagnostics }; Placeholder = Box { name, next, found }
-- Lexer = Box { source, path } с методом scan() -> Scan
-- lex(source, path) -> Scan
-- describe(token) -> текст для сообщений парсера
-- token_buffer_add(buffer, item) / token_buffer_at(buffer, index) / token_buffer_count(buffer)

use core.str
use core.group
use selfhost.diagnostic
use selfhost.errors

TokenKind = enum {
    INVALID, IDENT, NUMBER, STRING, NEWLINE, EOF,
    SKILL, PROGRAM, USE, BOX, OUT, ENUM, DRUM, RESCUE,
    YES, NO, NONE,
    AT, LBRACE, RBRACE, LBRACKET, RBRACKET, LPAREN, RPAREN,
    COMMA, DOT, PIPE, ASSIGN, EQ, ARROW,
    GT, LT, GE, LE, PLUS, MINUS, STAR, SLASH,
    LEAVE, PICK, NATIVE, TEMPLATE, ALWAYS, PERCENT, NEAR
}

NEWLINE = "\n"
TAB = "\t"
QUOTE = "\""
ESCAPE = "\\"
ESCAPE_NEWLINE = "n"
ESCAPE_TAB = "t"
TEXT_PIECE = 4096

SIGNS = ["@", "\{", "\}", "[", "]", "(", ")", ",", ".", "|", "=", ">", "<", "+", "-", "*", "/", "%"]

SIGN_KINDS = [
    TokenKind.AT, TokenKind.LBRACE, TokenKind.RBRACE,
    TokenKind.LBRACKET, TokenKind.RBRACKET, TokenKind.LPAREN, TokenKind.RPAREN,
    TokenKind.COMMA, TokenKind.DOT, TokenKind.PIPE, TokenKind.ASSIGN,
    TokenKind.GT, TokenKind.LT, TokenKind.PLUS, TokenKind.MINUS, TokenKind.STAR, TokenKind.SLASH,
    TokenKind.PERCENT
]

KEYWORDS = ["skill", "program", "use", "Box", "out", "enum", "drum", "rescue", "yes", "no", "none", "leave", "pick", "native", "always"]

KEYWORD_KINDS = [
    TokenKind.SKILL, TokenKind.PROGRAM, TokenKind.USE, TokenKind.BOX,
    TokenKind.OUT, TokenKind.ENUM, TokenKind.DRUM, TokenKind.RESCUE,
    TokenKind.YES, TokenKind.NO, TokenKind.NONE, TokenKind.LEAVE, TokenKind.PICK, TokenKind.NATIVE, TokenKind.ALWAYS
]

Token = Box {
    kind = TokenKind.INVALID,
    value = "",
    parts = [],
    line = 1,
    col = 1
}

skill describe(token) {
    (token.kind == TokenKind.NEWLINE) { out "конец строки" }
    (token.kind == TokenKind.EOF) { out "конец файла" }
    (token.kind == TokenKind.STRING) { out "строка" }
    (token.kind == TokenKind.TEMPLATE) { out "строка" }
    out "'{token.value}'"
}

Placeholder = Box {
    name = "",
    next = 0,
    found = no
}

TokenBuffer = Box {
    chunks = [],
    tail = [],
    length = 0
}

skill token_buffer_add(buffer, item) {
    @next_chunks = buffer.chunks
    @next_tail = group.add(buffer.tail, item)
    (group.count(next_tail) == 256) {
        next_chunks = group.add(next_chunks, next_tail)
        next_tail = []
    }
    out TokenBuffer { chunks = next_chunks, tail = next_tail, length = buffer.length + 1 }
}

skill token_buffer_at(buffer, index) {
    @chunk_index = index / 256
    @item_index = index - chunk_index * 256
    (chunk_index < group.count(buffer.chunks)) {
        out group.get(group.get(buffer.chunks, chunk_index), item_index)
    }
    out group.get(buffer.tail, item_index)
}

skill token_buffer_count(buffer) {
    out buffer.length
}

Scan = Box {
    tokens = TokenBuffer {},
    diagnostics = []
}

Lexeme = Box {
    token = none,
    next = 0,
    line = 1,
    col = 1,
    diagnostics = []
}

Lexer = Box {
    source = "",
    path = ""

    skill token(kind, value, line, col) {
        out Token { kind = kind, value = value, line = line, col = col }
    }

    skill ascii_letter(ch) {
        out str.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", ch)
    }

    skill ident_start(ch) {
        (ascii_letter(ch) == yes) { out yes }
        (ch == "_") { out yes }
        @upper = str.upper(ch)
        @lower = str.lower(ch)
        (upper == lower) { out no }
        out yes
    }

    skill ident_part(ch) {
        (ident_start(ch) == yes) { out yes }
        out str.is_digit(ch)
    }

    skill word(start, line, col) {
        @index = start
        @next_col = col
        @length = str.bytes(source)
        drum (length - start) {
            @part = str.get(source, index)
            (ident_part(part) == no) {
                @value = str.slice(source, start, index)
                out Lexeme {
                    token = token(word_kind(value), value, line, col),
                    next = index,
                    line = line,
                    col = next_col
                }
            }
            index = index + 1
            next_col = next_col + 1
        }
        @value = str.slice(source, start, index)
        out Lexeme {
            token = token(word_kind(value), value, line, col),
            next = index,
            line = line,
            col = next_col
        }
    }

    skill number(start, line, col) {
        @index = start
        @next_col = col
        @length = str.bytes(source)
        @dot = no
        drum (length - start) {
            @digit = str.get(source, index)
            @take = str.is_digit(digit)
            (digit == ".") {
                (dot == no) {
                    (index + 1 < length) {
                        (str.is_digit(str.get(source, index + 1)) == yes) {
                            take = yes
                            dot = yes
                        }
                    }
                }
            }
            (take == no) {
                out Lexeme {
                    token = token(TokenKind.NUMBER, str.slice(source, start, index), line, col),
                    next = index,
                    line = line,
                    col = next_col
                }
            }
            index = index + 1
            next_col = next_col + 1
        }
        out Lexeme {
            token = token(TokenKind.NUMBER, str.slice(source, start, index), line, col),
            next = index,
            line = line,
            col = next_col
        }
    }

    skill collected(value, piece, run, stop) {
        out str.concat(str.concat(value, piece), str.slice(source, run, stop))
    }

    skill failed(line, col, diagnostics, problem) {
        out Lexeme {
            token = none,
            line = line,
            col = col,
            diagnostics = group.add(diagnostics, diagnostic.place(problem, path, line, col))
        }
    }

    skill blank_end(index) {
        @next = index
        drum (str.bytes(source) - index) {
            @ch = str.get(source, next)
            pick {
                (ch == " ") { next = next + 1 }
                (ch == TAB) { next = next + 1 }
                { out next }
            }
        }
        out next
    }

    skill newline_at(index) {
        @next = index
        drum (str.bytes(source) - index) {
            (str.get(source, next) == NEWLINE) { out next }
            next = next + 1
        }
        out next
    }

    skill line_end(index) {
        out newline_at(index) == blank_end(index)
    }

    skill indented(begin, margin) {
        (str.starts_at(source, margin, begin) == yes) { out begin + str.bytes(margin) }
        (line_end(begin) == yes) { out blank_end(begin) }
        out -1
    }

    skill closed(value, parts, line, col) {
        (group.count(parts) > 0) {
            out Token { kind = TokenKind.TEMPLATE, value = value, parts = group.add(parts, value), line = line, col = col }
        }
        out token(TokenKind.STRING, value, line, col)
    }

    skill text(start, line, col) {
        (str.get(source, start) == "#") { out block(start, line, col) }
        out literal(start + 1, str.bytes(source), "", yes, line, col, line, col + 1)
    }

    skill block(start, line, col) {
        @length = str.bytes(source)
        @open_end = blank_end(start + 1)
        (line_end(start + 1) == no) { out failed(line, col + open_end - start, [], errors.text_after_open()) }
        @begin = open_end
        @close_line = line
        drum (length - open_end) {
            (begin == length) { leave }
            begin = begin + 1
            close_line = close_line + 1
            @mark = blank_end(begin)
            (str.starts_at(source, "#", mark) == yes) {
                (line_end(mark + 1) == yes) {
                    @margin = str.slice(source, begin, mark)
                    @first = open_end
                    (begin > open_end + 1) { first = indented(open_end + 1, margin) }
                    (first < 0) { out failed(line + 1, 1, [], errors.text_left_of_close()) }
                    @lexeme = literal(first, begin - 1, margin, no, line, col, line + 1, first - open_end)
                    out Lexeme { token = lexeme.token, next = mark + 1, line = close_line, col = mark - begin + 2, diagnostics = lexeme.diagnostics }
                }
            }
            begin = newline_at(mark)
        }
        out failed(line, col, [], errors.unterminated_string())
    }

    skill literal(first, stop, margin, quoted, line, col, at_line, at_col) {
        @index = first
        @next_line = at_line
        @next_col = at_col
        @run = first
        @piece = ""
        @value = ""
        @parts = []
        @diagnostics = []
        drum (stop - first + 1) {
            (index == stop) {
                (quoted == yes) { out failed(line, col, diagnostics, errors.unterminated_string()) }
                out Lexeme { token = closed(collected(value, piece, run, index), parts, line, col) }
            }
            @ch = str.get(source, index)
            (ch == QUOTE) {
                (quoted == yes) {
                    @done = closed(collected(value, piece, run, index), parts, line, col)
                    out Lexeme { token = done, next = index + 1, line = next_line, col = next_col + 1, diagnostics = diagnostics }
                }
            }
            pick {
                (ch == ESCAPE) {
                    @escape = NEWLINE
                    (index + 1 < stop) { escape = str.get(source, index + 1) }
                    (escape == NEWLINE) { out failed(next_line, next_col, diagnostics, errors.unterminated_escape()) }
                    @decoded = escape
                    (escape == ESCAPE_NEWLINE) { decoded = NEWLINE }
                    (escape == ESCAPE_TAB) { decoded = TAB }
                    (escape == QUOTE) { decoded = QUOTE }
                    (escape == ESCAPE) { decoded = ESCAPE }
                    piece = str.concat(str.concat(piece, str.slice(source, run, index)), decoded)
                    (str.bytes(piece) > TEXT_PIECE) {
                        value = str.concat(value, piece)
                        piece = ""
                    }
                    index = index + 2
                    run = index
                    next_col = next_col + 2
                }
                (ch == NEWLINE) {
                    (quoted == yes) { out failed(line, col, diagnostics, errors.unterminated_string()) }
                    @skip = indented(index + 1, margin)
                    (skip < 0) { out failed(next_line + 1, 1, diagnostics, errors.text_left_of_close()) }
                    piece = str.concat(piece, str.slice(source, run, index + 1))
                    next_line = next_line + 1
                    next_col = skip - index
                    index = skip
                    run = index
                }
                (ch == "\{") {
                    @found = placeholder(index)
                    (found.found == no) { out failed(next_line, next_col, diagnostics, errors.template_expects_name()) }
                    parts = group.add(group.add(parts, collected(value, piece, run, index)), found.name)
                    value = ""
                    piece = ""
                    next_col = next_col + found.next - index
                    index = found.next
                    run = index
                }
                (ch == "\}") { out failed(next_line, next_col, diagnostics, errors.lone_closing_brace()) }
                {
                    index = index + 1
                    next_col = next_col + 1
                }
            }
        }
        out failed(line, col, diagnostics, errors.unterminated_string())
    }

    skill placeholder(start) {
        @index = start + 1
        drum (str.bytes(source) - index) {
            @ch = str.get(source, index)
            pick {
                (ch == "\}") {
                    (index == start + 1) { out Placeholder {} }
                    out Placeholder { name = str.slice(source, start + 1, index), next = index + 1, found = yes }
                }
                (ch == ".") { index = index + 1 }
                (ident_part(ch) == yes) { index = index + 1 }
                { out Placeholder {} }
            }
        }
        out Placeholder {}
    }

    skill table_kind(values, kinds, value, fallback) {
        drum (group.count(values)) {
            (group.get(values, beat) == value) { out group.get(kinds, beat) }
        }
        out fallback
    }

    skill pair_at(index) {
        (index + 1 < str.bytes(source)) { out str.slice(source, index, index + 2) }
        out ""
    }

    skill has_code(tokens) {
        drum (token_buffer_count(tokens)) {
            @item = token_buffer_at(tokens, beat)
            ((item.kind == TokenKind.NEWLINE) == no) { out yes }
        }
        out no
    }

    skill word_kind(word) {
        out table_kind(KEYWORDS, KEYWORD_KINDS, word, TokenKind.IDENT)
    }

    skill sign_kind(ch) {
        out table_kind(SIGNS, SIGN_KINDS, ch, TokenKind.INVALID)
    }

    skill scan() {
        @tokens = TokenBuffer()
        @diagnostics = []
        @index = 0
        @line = 1
        @col = 1
        @length = str.bytes(source)
        drum (length + 1) {
            (index >= length) { leave }
            @ch = str.get(source, index)
            pick {
                (ch == " ") {
                    index = index + 1
                    col = col + 1
                }
                (ch == TAB) {
                    index = index + 1
                    col = col + 1
                }
                (ch == NEWLINE) {
                    tokens = token_buffer_add(tokens, token(TokenKind.NEWLINE, NEWLINE, line, col))
                    index = index + 1
                    line = line + 1
                    col = 1
                }
                (ident_start(ch) == yes) {
                    @lexeme = word(index, line, col)
                    tokens = token_buffer_add(tokens, lexeme.token)
                    index = lexeme.next
                    line = lexeme.line
                    col = lexeme.col
                }
                (str.is_digit(ch) == yes) {
                    @lexeme = number(index, line, col)
                    tokens = token_buffer_add(tokens, lexeme.token)
                    index = lexeme.next
                    line = lexeme.line
                    col = lexeme.col
                }
                (str.contains("#\"", ch) == yes) {
                    @lexeme = text(index, line, col)
                    index = lexeme.next
                    line = lexeme.line
                    col = lexeme.col
                    diagnostics = lexeme.diagnostics
                    (diagnostic.has(diagnostics) == yes) { leave }
                    tokens = token_buffer_add(tokens, lexeme.token)
                }
                (pair_at(index) == "--") {
                    (has_code(tokens) == yes) {
                        diagnostics = group.add(diagnostics, diagnostic.place(errors.comment_outside_header(), path, line, col))
                        leave
                    }
                    @end = newline_at(index + 2)
                    col = col + (end - index)
                    index = end
                }
                (pair_at(index) == "==") {
                    tokens = token_buffer_add(tokens, token(TokenKind.EQ, "==", line, col))
                    index = index + 2
                    col = col + 2
                }
                (pair_at(index) == ">=") {
                    tokens = token_buffer_add(tokens, token(TokenKind.GE, ">=", line, col))
                    index = index + 2
                    col = col + 2
                }
                (pair_at(index) == "<=") {
                    tokens = token_buffer_add(tokens, token(TokenKind.LE, "<=", line, col))
                    index = index + 2
                    col = col + 2
                }
                (pair_at(index) == "~=") {
                    tokens = token_buffer_add(tokens, token(TokenKind.NEAR, "~=", line, col))
                    index = index + 2
                    col = col + 2
                }
                (pair_at(index) == "=>") {
                    tokens = token_buffer_add(tokens, token(TokenKind.ARROW, "=>", line, col))
                    index = index + 2
                    col = col + 2
                }
                (sign_kind(ch) == TokenKind.INVALID) {
                    diagnostics = group.add(diagnostics, diagnostic.place(errors.unexpected_symbol(ch), path, line, col))
                    leave
                }
                {
                    tokens = token_buffer_add(tokens, token(sign_kind(ch), ch, line, col))
                    index = index + 1
                    col = col + 1
                }
            }
        }
        tokens = token_buffer_add(tokens, token(TokenKind.EOF, "", line, col))
        out Scan { tokens = tokens, diagnostics = diagnostics }
    }
}


skill lex(source, path) {
    @lexer = Lexer()
    lexer.source = source
    lexer.path = path
    out lexer.scan()
}
