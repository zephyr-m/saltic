-- platform — договор платформы: метки rt_platform_*, которые цель даёт
-- программе поверх договора машины (backend). Платформа — Box с полями
-- arena_bytes и default_heap_bytes (сколько памяти у тела: арена и куча, если
-- сборщик её не задал) и методом
-- append(compiler) -> compiler: выпускает код всех ACTIONS после рантайма;
-- чего не умеет — append_unsupported. Соглашение как у rt_*: аргументы в
-- VALUE, ERROR, ARG2…, результат в VALUE, ERROR = CALL_NO_ERROR или id ошибки.
-- Неумение — ERROR = ERROR_NOT_SUPPORTED (ловится rescue как NotSupported);
-- никогда не ловушка и не чужое число. Вход: платформа кладёт на STACK
-- [argc, argv…] (адреса C-строк) и передаёт управление на _start.
--
-- ACTIONS — имена действий: write(fd, ptr, len) -> написано байт;
--     exit(code) — не возвращается; key() -> строка: имя клавиши или байты,
--     "" — конец ввода; file_read(path) -> строка; File;
--     file_write(path, text) -> none; File; file_write_program(path, buffer) — то же
--     с правом исполнения (linux); now() -> такты (28 бит);
--     wait() -> none; firmware(piece) -> число; call(hi, lo) -> число (16 бит);
--     process_open / pipe / input / write / wait / read / close / executable, environment,
--     file_list (linux/process); open(path, argv, folder, piped, env, input) — env —
--     группа "ИМЯ=значение", всё окружение ребёнка, input — ещё труба на ввод:
--     input_end() -> её пишущий конец, write(fd, text) -> none;
--     log_open() -> fd журнала аварий yamatakudasai.log на дозапись (linux);
--     read_line() -> строка ввода без «\n»; File — конец ввода (linux/input)
-- HEAP — rt_platform_heap(VALUE = байт, без тега) -> VALUE = адрес начала сплошного
--     куска под кучу; ERROR_MEMORY_EXHAUSTED, если не дали. Обязательна у каждой
--     платформы, зовёт её _start (Q-050); append_heap_reserve — кусок в своём bss
--     для платформ, у которых просить не у кого
-- WRITE / EXIT / … / PROCESS_* / ENVIRONMENT / FILE_LIST — метки; label(action) -> "rt_platform_<action>"
-- append_unsupported(compiler, actions) -> compiler — NotSupported для перечисленных и LATE_ACTIONS без метки
--
-- Дети: linux (вызовы ядра; rv32i и родной x86-64), uefi (вызовы прошивки).

use selfhost.abi
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.runtime.tails

ACTIONS = ["write", "exit", "key", "file_read", "file_write", "file_write_program", "now", "wait", "firmware", "call", "process_pipe", "process_wait", "process_read", "process_close", "process_executable", "environment", "file_list", "process_open", "process_input", "process_write", "log_open", "read_line"]
LATE_ACTIONS = ["file_write_program", "process_pipe", "process_wait", "process_read", "process_close", "process_executable", "environment", "file_list", "process_open", "process_input", "process_write", "log_open", "read_line"]

WRITE = "rt_platform_write"
EXIT = "rt_platform_exit"
KEY = "rt_platform_key"
FILE_READ = "rt_platform_file_read"
FILE_WRITE = "rt_platform_file_write"
FILE_WRITE_PROGRAM = "rt_platform_file_write_program"
NOW = "rt_platform_now"
WAIT = "rt_platform_wait"
FIRMWARE = "rt_platform_firmware"
CALL = "rt_platform_call"
PROCESS_OPEN = "rt_platform_process_open"
PROCESS_INPUT = "rt_platform_process_input"
PROCESS_WRITE = "rt_platform_process_write"
LOG_OPEN = "rt_platform_log_open"
PROCESS_PIPE = "rt_platform_process_pipe"
PROCESS_WAIT = "rt_platform_process_wait"
PROCESS_READ = "rt_platform_process_read"
PROCESS_CLOSE = "rt_platform_process_close"
PROCESS_EXECUTABLE = "rt_platform_process_executable"
ENVIRONMENT = "rt_platform_environment"
FILE_LIST = "rt_platform_file_list"
READ_LINE = "rt_platform_read_line"
HEAP = "rt_platform_heap"
HEAP_RESERVE = "saltic_heap_reserve"

skill label(action) {
    out "rt_platform_{action}"
}

skill emit_unsupported(compiler, action) {
    @executor = compiler.executor
    out tails.fail(compiler, label(action), abi.ERROR_NOT_SUPPORTED)
}

skill append_heap_reserve(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, HEAP)
    compiler = executor.load_address(compiler, backend.VALUE, HEAP_RESERVE, 0)
    compiler = tails.ok(compiler)
    compiler = executor.align(compiler, backend.BSS, abi.OBJECT_ALIGNMENT)
    compiler = executor.data_label(compiler, backend.BSS, HEAP_RESERVE)
    out executor.reserve(compiler, compiler.heap_bytes)
}

skill append_unsupported(compiler, actions) {
    drum (actions) { compiler = emit_unsupported(compiler, beat) }
    drum (LATE_ACTIONS) {
        @found = layout.find_label(compiler.machine, label(beat))
        (found.present == no) { compiler = emit_unsupported(compiler, beat) }
    }
    out compiler
}
