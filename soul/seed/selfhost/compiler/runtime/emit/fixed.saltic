-- fixed — рантайм фиксированных целых u8/u16/u32/i32: арифметика с
-- проверкой переполнения, сравнения, память, печать, преобразование.
-- Каждый навык берёт и отдаёт compiler, определяя метку rt_fixed_* в коде.
-- Значения — сырые 32 бита в a0/a1 без тега; тип — в a6 (abi.FIXED_*),
-- целевой тип convert — в a7. Результат проходит через rt_fixed_new, который
-- режет по ширине и даёт rt_fixed_overflow (ERROR_FIXED_INTEGER_OVERFLOW).
-- Метки .L_equal_yes/no, .L_less_yes — общие с numbers.
--
-- emit_fixed_overflow / emit_fixed_overflow_restore(compiler) — ошибка
--     (restore — с откатом кадра 16 байт)
-- emit_fixed_new(compiler) — rt_fixed_new: проверка диапазона u8/u16
-- emit_fixed_equal / emit_fixed_less / emit_fixed_greater(compiler)
-- emit_fixed_add / emit_fixed_sub / emit_fixed_mul / emit_fixed_div(compiler)
-- emit_fixed_and / emit_fixed_or / emit_fixed_xor / emit_fixed_not(compiler)
-- emit_fixed_shift_left / emit_fixed_shift_right(compiler)
-- emit_fixed_convert(compiler) — rt_fixed_convert между типами
-- emit_fixed_mem_load / _load8 / _load16 / _load32(compiler) — чтение по адресу
-- emit_fixed_mem_store / _store8 / _store16 / _store32(compiler) — запись
-- emit_fixed_show(compiler) — rt_fixed_show: десятичный текст через rt_show

use selfhost.abi
use selfhost.machine.instruction
use selfhost.machine.layout
use selfhost.compiler.state
use selfhost.machine.registers

skill emit_fixed_overflow_restore(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_overflow_restore")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_FIXED_INTEGER_OVERFLOW)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_fixed_overflow(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_overflow")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_FIXED_INTEGER_OVERFLOW)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_fixed_equal(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_equal")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A0, registers.A1, ".L_equal_yes")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_equal_no")
    out compiler
}

skill emit_fixed_less(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_less")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A6, registers.T3, ".L_fixed_less_signed")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.A0, registers.A1, ".L_less_yes")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_equal_no")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_less_signed")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.A1, ".L_less_yes")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_equal_no")
    out compiler
}

skill emit_fixed_greater(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_greater")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A2, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.A1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A1, registers.A2, registers.ZERO, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_less")
    out compiler
}

skill emit_fixed_new(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_new")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.FIXED_U8)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A6, registers.T0, ".L_fixed_check_u8")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.FIXED_U16)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A6, registers.T0, ".L_fixed_check_u16")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_check_u8")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T0, registers.A0, registers.ZERO, 8)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.ZERO, "rt_fixed_overflow")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_check_u16")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T0, registers.A0, registers.ZERO, 16)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.ZERO, "rt_fixed_overflow")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_fixed_mem_load8(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_mem_load8")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, abi.FIXED_U8)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_mem_load")
    out compiler
}

skill emit_fixed_mem_load16(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_mem_load16")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, abi.FIXED_U16)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_mem_load")
    out compiler
}

skill emit_fixed_mem_load32(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_mem_load32")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, abi.FIXED_U32)
    out compiler
}

skill emit_fixed_mem_load(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_mem_load")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.A0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.FIXED_U8)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A2, registers.T1, ".L_fixed_mem_load8")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.FIXED_U16)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A2, registers.T1, ".L_fixed_mem_load16")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.T0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mem_load8")
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.A0, registers.T0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mem_load16")
    compiler = state.emit_op(compiler, instruction.Kind.LHU, registers.A0, registers.T0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    out compiler
}

skill emit_fixed_mem_store8(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_mem_store8")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_mem_store")
    out compiler
}

skill emit_fixed_mem_store16(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_mem_store16")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, 2)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_mem_store")
    out compiler
}

skill emit_fixed_mem_store32(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_mem_store32")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, 3)
    out compiler
}

skill emit_fixed_mem_store(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_mem_store")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.A0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T3, registers.T1, ".L_fixed_mem_store8")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, 2)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T3, registers.T1, ".L_fixed_mem_store16")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T0, registers.A2, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_fixed_mem_store_done")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mem_store8")
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T0, registers.A2, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_fixed_mem_store_done")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mem_store16")
    compiler = state.emit_op(compiler, instruction.Kind.SH, registers.ZERO, registers.T0, registers.A2, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mem_store_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_fixed_show(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_show")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -64)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 60)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A6, registers.T3, ".L_fixed_text_digits")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, registers.T0, registers.ZERO, ".L_fixed_text_digits")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T0, registers.ZERO, registers.T0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_text_digits")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_text_digit")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.ZERO, registers.ZERO, 32)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A3, registers.T0, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_text_div10")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.A4, registers.A3, registers.ZERO, 31)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A3, registers.A3, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T5, registers.T5, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.T5, registers.T5, registers.A4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T4, registers.T4, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A4, registers.ZERO, registers.ZERO, 10)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T5, registers.A4, ".L_fixed_text_div10_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.T5, registers.ZERO, -10)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.T4, registers.T4, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_text_div10_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.T6, registers.ZERO, -1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T6, registers.ZERO, ".L_fixed_text_div10")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.T5, registers.ZERO, 48)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A4, registers.SP, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.A4, registers.T5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.T3, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.T4, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.ZERO, ".L_fixed_text_digit")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.T3, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T3, 56)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T2, 52)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T4, 48)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T4, registers.ZERO, 5)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T3, registers.SP, registers.ZERO, 56)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.SP, registers.ZERO, 52)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T4, registers.SP, registers.ZERO, 48)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T5, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T4, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.ZERO, ".L_fixed_text_copy")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.ZERO, registers.ZERO, 45)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.A0, registers.T6, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_text_copy")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T3, registers.ZERO, ".L_fixed_text_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.T3, registers.ZERO, -1)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T6, registers.SP, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T6, registers.T6, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A3, registers.A0, registers.T5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.A3, registers.T6, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.T5, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_fixed_text_copy")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_text_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A3, registers.A0, registers.T4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.A3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_call(compiler.machine, "rt_show")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 60)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 64)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_fixed_add(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_add")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T2, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.T2, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A6, registers.T4, ".L_fixed_add_signed")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.A0, registers.T2, "rt_fixed_overflow")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_add_signed")
    compiler = state.emit_op(compiler, instruction.Kind.XOR, registers.T4, registers.A0, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XOR, registers.T5, registers.A0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.AND, registers.T4, registers.T4, registers.T5, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.T4, registers.ZERO, "rt_fixed_overflow")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_fixed_sub(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_sub")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T2, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.A0, registers.T2, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A6, registers.T4, ".L_fixed_sub_signed")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T2, registers.T3, "rt_fixed_overflow")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_sub_signed")
    compiler = state.emit_op(compiler, instruction.Kind.XOR, registers.T4, registers.T2, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XOR, registers.T5, registers.A0, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.AND, registers.T4, registers.T4, registers.T5, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.T4, registers.ZERO, "rt_fixed_overflow")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_fixed_mul(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_mul")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T2, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A5, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A6, registers.A2, ".L_fixed_mul_unsigned")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, registers.T2, registers.ZERO, ".L_fixed_mul_left_ready")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T2, registers.ZERO, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XORI, registers.A5, registers.A5, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mul_left_ready")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, registers.T3, registers.ZERO, ".L_fixed_mul_unsigned")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T3, registers.ZERO, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XORI, registers.A5, registers.A5, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mul_unsigned")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A4, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.ZERO, registers.ZERO, 32)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mul_loop")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A2, registers.T3, registers.ZERO, 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A2, registers.ZERO, ".L_fixed_mul_shift")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A2, registers.T4, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLTU, registers.A3, registers.A2, registers.T4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T5, registers.T5, registers.A4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T5, registers.T5, registers.A3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.A2, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mul_shift")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T3, registers.T3, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.A2, registers.T2, registers.ZERO, 31)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A4, registers.A4, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.A4, registers.A4, registers.A2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.T6, registers.ZERO, -1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T6, registers.ZERO, ".L_fixed_mul_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T5, registers.ZERO, ".L_fixed_mul_overflow")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A6, registers.A2, ".L_fixed_mul_ready")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A5, registers.ZERO, ".L_fixed_mul_positive")
    compiler = state.emit_op(compiler, instruction.Kind.LUI, registers.A2, registers.ZERO, registers.ZERO, 524288)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.A2, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.A2, registers.T4, ".L_fixed_mul_overflow")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T4, registers.ZERO, registers.T4, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_fixed_mul_ready")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mul_positive")
    compiler = state.emit_op(compiler, instruction.Kind.LUI, registers.A2, registers.ZERO, registers.ZERO, 524288)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.A2, registers.ZERO, -1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.A2, registers.T4, ".L_fixed_mul_overflow")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mul_ready")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.T4, registers.ZERO, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_mul_overflow")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_overflow")
    out compiler
}

skill emit_fixed_div(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_div")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T2, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A1, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.ZERO, ".L_fixed_div_nonzero")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_division_by_zero")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_nonzero")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A4, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A6, registers.A2, ".L_fixed_div_unsigned")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, registers.T2, registers.ZERO, ".L_fixed_div_left_ready")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T2, registers.ZERO, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XORI, registers.A4, registers.A4, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_left_ready")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, registers.T3, registers.ZERO, ".L_fixed_div_unsigned")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T3, registers.ZERO, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XORI, registers.A4, registers.A4, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_unsigned")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.ZERO, registers.ZERO, 32)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_loop")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.A2, registers.T2, registers.ZERO, 31)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T5, registers.T5, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.T5, registers.T5, registers.A2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T4, registers.T4, registers.ZERO, 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T5, registers.T3, ".L_fixed_div_next")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T5, registers.T5, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.T4, registers.T4, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.T6, registers.ZERO, -1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T6, registers.ZERO, ".L_fixed_div_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A4, registers.ZERO, ".L_fixed_div_positive")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T4, registers.ZERO, registers.T4, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_fixed_div_ready")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_positive")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A6, registers.A2, ".L_fixed_div_ready")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.T4, registers.ZERO, "rt_fixed_overflow")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_ready")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.T4, registers.ZERO, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

