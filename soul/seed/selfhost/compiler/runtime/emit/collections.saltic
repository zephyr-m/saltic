use selfhost.abi
use selfhost.machine.instruction
use selfhost.machine.layout
use selfhost.compiler.state
use selfhost.machine.registers

skill emit_box_get(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_box_get")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A2, registers.T0, ".L_box_get_scan")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.A2, registers.ZERO, 3)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T1, registers.A0, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T2, registers.A1, ".L_box_get_scan")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_get_scan")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_get_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.ZERO, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A0, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.A1, ".L_box_get_found")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_box_get_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_get_found")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_box_set(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_box_set")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A3, registers.T0, ".L_box_set_scan")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.A3, registers.ZERO, 3)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T1, registers.T2, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T3, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.A1, ".L_box_set_scan")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T1, registers.A2, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_region_barrier")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_scan")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.ZERO, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A0, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.A1, ".L_box_set_found")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_box_set_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_found")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.A2, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_region_barrier")
    out compiler
}

skill emit_missing_field(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_MISSING_FIELD)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_count(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_count")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_at(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_at")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A1, registers.T0, "rt_group_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A1, registers.A1, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.A0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_bounds(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_GROUP_BOUNDS)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_add(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_add")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 8)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T1, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, 2)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.T0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T1, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T2, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_group_copy")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.T1, ".L_group_copy_done")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T2, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.T0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T5, registers.T4, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.A0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T4, registers.T5, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_group_copy")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_group_copy_done")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T1, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T4, registers.SP, registers.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T3, registers.T4, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}
