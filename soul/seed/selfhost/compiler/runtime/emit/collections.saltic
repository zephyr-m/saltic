use selfhost.abi
use selfhost.machine.instruction
use selfhost.machine.layout
use selfhost.compiler.state
use selfhost.machine.registers
use selfhost.compiler.constants

skill emit_box_get(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_box_get")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A2, registers.T0, ".L_box_get_scan")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.A2, registers.ZERO, 3)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T1, registers.A0, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T2, registers.A1, ".L_box_get_scan")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_get_scan")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_get_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.ZERO, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A0, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.A1, ".L_box_get_found")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_box_get_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_get_found")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_box_set(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_box_set")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A3, registers.T0, ".L_box_set_scan")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.A3, registers.ZERO, 3)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T1, registers.T2, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T3, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.A1, ".L_box_set_scan")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T1, registers.A2, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_region_barrier")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_scan")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.ZERO, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A0, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.A1, ".L_box_set_found")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_box_set_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_found")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.A2, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_region_barrier")
    out compiler
}

skill emit_missing_field(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_MISSING_FIELD)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_count(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_count")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_at(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_at")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_TREE)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, "rt_group_tree_at")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A1, registers.T0, "rt_group_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A1, registers.A1, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.A0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_bounds(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_GROUP_BOUNDS)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_add(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_add")
    @tree_add = state.symbol_find(compiler.skills, constants.TREE_ADD_SKILL)
    (tree_add.name == constants.TREE_ADD_SKILL) { compiler = emit_tree_switch(compiler) }
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 8)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T1, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, 2)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.T0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T1, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T2, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_group_copy")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.T1, ".L_group_copy_done")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T2, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.T0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T5, registers.T4, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.A0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T4, registers.T5, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_group_copy")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_group_copy_done")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T1, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T4, registers.SP, registers.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T3, registers.T4, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_tree_at(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_tree_at")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A1, registers.T0, "rt_group_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_TAIL_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.T1, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T3, registers.T0, registers.T2, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A1, registers.T3, ".L_tree_tail")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T4, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_LEVELS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T5, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_ROOT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T5, registers.T5, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.T4, registers.ZERO, -1)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T6, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T6, registers.T6, registers.T3, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_tree_down")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T6, registers.ZERO, ".L_tree_leaf")
    compiler = state.emit_op(compiler, instruction.Kind.SRL, registers.T3, registers.A1, registers.T6, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T3, registers.T3, registers.ZERO, 31)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T3, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.T5, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T5, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_ITEMS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T5, registers.T5, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.T6, registers.ZERO, -5)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_tree_down")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_tree_leaf")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T3, registers.A1, registers.ZERO, 31)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T3, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.T5, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_ITEMS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_tree_tail")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T3, registers.A1, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T3, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.T1, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_ITEMS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_tree_switch(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_TREE)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.T2, ".L_group_add_tree")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, constants.GROUP_FLAT_LIMIT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.T1, registers.T2, ".L_group_add_flat")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_group_add_tree")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler.machine = layout.emit_call(compiler.machine, constants.TREE_ADD_LABEL)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_group_add_flat")
    out compiler
}

skill emit_group_tree_parts(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_tree_parts")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T0, 8)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_TREE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, constants.group_storage_bytes(0))
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.ZERO, 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T1, registers.T2, ".L_tree_parts_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, constants.group_storage_bytes(3))
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, 3)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T3, 4)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_tree_parts_alloc")
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T1, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_tree_parts_done")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_LEVELS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T2, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T2, abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_ITEMS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_ROOT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T2, abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_ITEMS_OFFSET + constants.GROUP_ITEM_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_TAIL_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T2, abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_ITEMS_OFFSET + 2 * constants.GROUP_ITEM_BYTES)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_tree_parts_done")
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_tree_make(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_tree_make")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -32)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 28)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 24)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, 20)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A2, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A3, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, constants.TREE_PAYLOAD_BYTES)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_TREE)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 24)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T0, registers.T0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 20)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T0, registers.T0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_LEVELS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_ROOT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_TAIL_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_flatten(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_flatten")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_TREE)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.T2, ".L_flatten_tree")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_flatten_tree")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 8)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T1, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T1, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, 2)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T1, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_flatten_loop")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T4, registers.T1, ".L_flatten_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T4, 12)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 24)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A1, registers.T4, registers.ZERO, abi.TAG_SHIFT)
    compiler.machine = layout.emit_call(compiler.machine, "rt_group_at")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T4, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T4, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.T0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T3, registers.A0, abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_ITEMS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.T4, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_flatten_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_flatten_done")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}
