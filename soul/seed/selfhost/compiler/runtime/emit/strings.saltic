use selfhost.abi
use selfhost.machine.instruction
use selfhost.machine.layout
use selfhost.compiler.state
use selfhost.machine.registers

skill emit_string_len(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_len")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_string_byte(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_byte")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A1, registers.T1, "rt_string_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.T0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.A0, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_string_bounds(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_STRING_BOUNDS)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_string_starts_with(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_starts_with")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A1, registers.A1, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.T1, registers.T0, ".L_string_match_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_string_match_loop")
    out compiler
}

skill emit_string_ends_with(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_ends_with")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A1, registers.A1, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.T1, registers.T0, ".L_string_match_no")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.A0, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T3, registers.T0, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.A0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_string_match_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.T1, ".L_string_match_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.A1, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T3, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T4, registers.T4, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.T4, ".L_string_match_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_string_match_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_string_match_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.YES)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_string_match_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NO)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_string_contains(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_contains")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A1, registers.A1, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_contains_yes")
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.T1, registers.T0, ".L_contains_no")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T2, registers.T0, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_contains_outer")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T3, registers.T2, ".L_contains_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_contains_inner")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T4, registers.T1, ".L_contains_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T5, registers.T3, registers.T4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T5, registers.A0, registers.T5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T5, registers.T5, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T6, registers.A1, registers.T4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T6, registers.T6, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T5, registers.T6, ".L_contains_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.T4, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_contains_inner")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_contains_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.T3, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_contains_outer")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_contains_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.YES)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_contains_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NO)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_line_count(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_line_count")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.ZERO, ".L_line_empty")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_line_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.T0, ".L_line_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T4, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 10)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T4, registers.T5, ".L_line_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_line_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_line_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_line_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T4, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 3)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 10)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T4, registers.T5, ".L_line_encode")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_line_encode")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.T1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_line_empty")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_cstring(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_cstring")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_cstring_len")
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T2, registers.T0, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.ZERO, ".L_cstring_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_cstring_len")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_cstring_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T1, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T1, registers.ZERO, 5)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T2, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T1, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_cstring_copy")
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.T2, registers.T1, ".L_cstring_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.T0, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T4, registers.T3, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T3, registers.T4, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_cstring_copy")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_cstring_done")
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_string_add(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_add")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -32)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 28)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.A1, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T0, 24)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T1, 20)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T3, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T2, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T3, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.T2, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T4, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T4, registers.ZERO, 5)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T4, registers.SP, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T5, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T4, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 24)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 20)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.SP, registers.ZERO, 16)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_string_left")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T5, registers.T2, ".L_string_right_start")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.T0, registers.T5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T4, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T3, registers.T4, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.T5, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_string_left")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_string_right_start")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.SP, registers.ZERO, 12)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_string_right")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T6, registers.T2, ".L_string_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.T1, registers.T6, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T4, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T3, registers.T4, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.T5, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.T6, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_string_right")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_string_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_string_at(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_at")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A1, registers.T1, "rt_string_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.T0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T1, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 6)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.A0, registers.T1, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 5)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_string_slice(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_slice")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -32)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 28)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A2, registers.A2, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.A1, registers.A2, "rt_string_bounds")
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.A2, registers.T1, "rt_string_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T2, registers.A2, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T0, 24)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, 20)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T2, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T2, registers.ZERO, 5)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 24)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 20)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T2, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_slice_copy")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T3, registers.T2, ".L_slice_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.T1, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.T0, registers.T4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T5, registers.T4, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.A0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T4, registers.T5, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.T3, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_slice_copy")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_slice_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.A0, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T4, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_string_lower(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_lower")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_string_case")
    out compiler
}

skill emit_string_upper(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_upper")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, 1)
    out compiler
}

skill emit_string_case(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_string_case")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -32)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 28)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T0, 24)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T1, 20)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T1, registers.ZERO, 5)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 24)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 20)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T1, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_case_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T3, registers.T1, ".L_case_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.T0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T5, registers.T4, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.ZERO, ".L_case_lower")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, 97)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T5, registers.T4, ".L_case_store")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, 123)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.T5, registers.T4, ".L_case_store")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.T5, registers.ZERO, -32)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_case_store")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_case_lower")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, 65)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T5, registers.T4, ".L_case_store")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, 91)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.T5, registers.T4, ".L_case_store")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.T5, registers.ZERO, 32)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_case_store")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.A0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T4, registers.T5, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.T3, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_case_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_case_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.A0, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T4, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}
