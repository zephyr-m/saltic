-- memory — рантайм памяти: rt_alloc и регионы (выход из навыка сжимает
-- кучу, перенося наружу только живые объекты).
-- Каждый навык берёт и отдаёт compiler, определяя метку rt_* в коде.
-- Регистры: s1 — вершина кучи, s2 — низ таблицы побегов (растёт вниз),
-- s4/s5 — метка региона и побегов при входе в навык. rt_region_exit: a0/a1
-- значение и ошибка, a2 = REGION_EXIT_VALUE_SKIPPED — значение не корень.
-- Нехватка места при копировании — откат (.L_region_abort).
--
-- emit_alloc(compiler) — rt_alloc(a0 байт) -> адрес; rt_out_of_memory
-- emit_out_of_memory(compiler) — ERROR_MEMORY_EXHAUSTED или выход процесса
-- emit_region_exit(compiler) — rt_region_exit: копирование, перенос, сжатие
-- emit_region_forward / emit_region_relocate / emit_region_restore(compiler)
--     — посетители одного указателя в a7
-- emit_region_barrier(compiler) — rt_region_barrier: запись в старый объект
-- emit_region_remember_slot(compiler) — слот константы как корень
-- emit_pointer_address / emit_object_size / emit_visit / emit_escape_walk /
--     emit_block_walk / emit_copies_walk / emit_slide / emit_escape_compact
--     — части обхода
-- append_runtime(compiler) — все метки памяти

use core.str
use selfhost.abi
use selfhost.memory.model
use core.process
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.state
use selfhost.compiler.constants
use selfhost.compiler.backend.rv32i.machine.registers

WORD_BYTES = constants.WORD_BYTES
COUNT_OFFSET = abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_COUNT_OFFSET
GROUP_ITEMS_OFFSET = abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_ITEMS_OFFSET
GROUP_ITEM_BYTES = constants.GROUP_ITEM_BYTES
BOX_VALUES_OFFSET = abi.OBJECT_PAYLOAD_OFFSET + constants.BOX_FIELDS_OFFSET + constants.BOX_FIELD_VALUE_OFFSET
BOX_FIELD_BYTES = constants.BOX_FIELD_BYTES
SIZE_ROUNDING = abi.OBJECT_HEADER_BYTES + abi.OBJECT_ALIGNMENT - 1
POINTER_TAG_COUNT = abi.TAG_BOX - abi.TAG_STRING + 1
KIND_LIMIT = abi.OBJECT_KIND_TREE + 1

EXIT_FRAME_BYTES = 16
EXIT_VALUE_OFFSET = 4
EXIT_ERROR_OFFSET = 8
EXIT_RETURN_OFFSET = 12

skill emit_alloc(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T1, registers.A0, registers.ZERO, 0)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.S1, registers.S2, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_HEADER_BYTES + abi.OBJECT_ALIGNMENT - 1)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.A0, registers.T0, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.T0, registers.ZERO, 0 - abi.OBJECT_ALIGNMENT)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T2, registers.S2, registers.S1, 0)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.T0, registers.T2, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.S1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.S1, registers.S1, registers.T0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T1, abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_out_of_memory(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_out_of_memory")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.S0, registers.ZERO, ".L_out_of_memory_exit")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_MEMORY_EXHAUSTED)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, model.REGION_EXIT_VALUE_SKIPPED)
    compiler.machine = layout.emit_call(compiler.machine, "rt_region_exit")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.S0, registers.ZERO, constants.return_address_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.S4, registers.S0, registers.ZERO, constants.region_mark_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.S5, registers.S0, registers.ZERO, constants.region_escape_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.S0, registers.ZERO, constants.previous_frame_load_offset())
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.S0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.S0, registers.T0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_out_of_memory_exit")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, process.EXIT_OUT_OF_MEMORY)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_platform_exit")
    out compiler
}

skill emit_pointer_address(compiler, skip) {
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A7, registers.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T0, registers.ZERO, 0 - abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, registers.T1, registers.T1, registers.ZERO, POINTER_TAG_COUNT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.ZERO, skip)
    out state.emit_op(compiler, instruction.Kind.ANDI, registers.T2, registers.A7, registers.ZERO, abi.PAYLOAD_MASK)
}

skill emit_object_size(compiler, size, object) {
    compiler = state.emit_op(compiler, instruction.Kind.LW, size, object, registers.ZERO, abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, size, size, registers.ZERO, SIZE_ROUNDING)
    out state.emit_op(compiler, instruction.Kind.ANDI, size, size, registers.ZERO, 0 - abi.OBJECT_ALIGNMENT)
}

skill emit_visit(compiler, visitor, base, offset) {
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A7, base, registers.ZERO, offset)
    compiler.machine = layout.emit_call(compiler.machine, visitor)
    out state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, base, registers.A7, offset)
}

skill emit_escape_walk(compiler, visitor, prefix) {
    @loop = "{prefix}_escape"
    @fields = "{prefix}_escape_fields"
    @slot = "{prefix}_escape_slot"
    @next = "{prefix}_escape_next"
    @done = "{prefix}_escape_done"
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A5, registers.S2, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, loop)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A5, registers.S5, done)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A6, registers.A5, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A6, registers.ZERO, model.ESCAPE_SLOT_FLAG)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.ZERO, slot)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A6, registers.S4, next)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.A6, registers.ZERO, COUNT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A6, registers.A6, registers.ZERO, BOX_VALUES_OFFSET)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, fields)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A2, registers.ZERO, next)
    compiler = emit_visit(compiler, visitor, registers.A6, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A6, registers.A6, registers.ZERO, BOX_FIELD_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.A2, registers.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, fields)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, slot)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A6, registers.A6, registers.ZERO, model.ESCAPE_ENTRY_MASK)
    compiler = emit_visit(compiler, visitor, registers.A6, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, next)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A5, registers.A5, registers.ZERO, model.ESCAPE_ENTRY_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, loop)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, done)
    out compiler
}

skill emit_block_walk(compiler, visitor, prefix) {
    @loop = "{prefix}_block"
    @group = "{prefix}_block_group"
    @box = "{prefix}_block_box"
    @tree = "{prefix}_block_tree"
    @items = "{prefix}_block_items"
    @next = "{prefix}_block_next"
    @done = "{prefix}_block_done"
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A5, registers.A3, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, loop)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A5, registers.A4, done)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.A5, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A6, registers.A1, registers.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_GROUP)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A6, registers.T0, group)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_BOX)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A6, registers.T0, box)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_TREE)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A6, registers.T0, tree)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, next)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, tree)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A6, registers.A1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + constants.TREE_ROOT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A5, registers.ZERO, registers.ZERO, GROUP_ITEM_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, items)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, group)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.A1, registers.ZERO, COUNT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A6, registers.A1, registers.ZERO, GROUP_ITEMS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A5, registers.ZERO, registers.ZERO, GROUP_ITEM_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, items)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, box)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.A1, registers.ZERO, COUNT_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A6, registers.A1, registers.ZERO, BOX_VALUES_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A5, registers.ZERO, registers.ZERO, BOX_FIELD_BYTES)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, items)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A2, registers.ZERO, next)
    compiler = emit_visit(compiler, visitor, registers.A6, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A6, registers.A6, registers.A5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.A2, registers.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, items)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, next)
    compiler = emit_object_size(compiler, registers.T0, registers.A1)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A5, registers.A1, registers.T0, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, loop)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, done)
    out compiler
}

skill emit_region_forward(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_forward")
    compiler = emit_pointer_address(compiler, ".L_region_forward_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T2, registers.S4, ".L_region_forward_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.T2, registers.A3, ".L_region_forward_done")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T3, registers.T2, registers.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, registers.T1, registers.T3, registers.ZERO, KIND_LIMIT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_region_forward_moved")
    compiler = emit_object_size(compiler, registers.T4, registers.T2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T5, registers.A4, registers.T4, 0)
    compiler.machine = layout.emit_branch_unsigned_greater(compiler.machine, registers.T5, registers.S2, ".L_region_abort")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_forward_copy")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.T4, ".L_region_forward_copied")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T5, registers.T2, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T5, registers.T5, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A4, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T3, registers.T5, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, WORD_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_region_forward_copy")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_forward_copied")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A4, registers.T2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T2, registers.A4, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.A7, registers.A4, registers.T0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A4, registers.A4, registers.T4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_forward_moved")
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.A7, registers.T3, registers.T0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_forward_done")
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_region_relocate(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_relocate")
    compiler = emit_pointer_address(compiler, ".L_region_relocate_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T2, registers.A3, ".L_region_relocate_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.T2, registers.A4, ".L_region_relocate_done")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.A7, registers.A7, registers.T6, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_relocate_done")
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_region_restore(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_restore")
    compiler = emit_pointer_address(compiler, ".L_region_restore_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T2, registers.A3, ".L_region_restore_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.T2, registers.A4, ".L_region_restore_done")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T2, registers.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.A7, registers.T2, registers.T0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_restore_done")
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_copies_walk(compiler, prefix, undo) {
    @loop = "{prefix}_copies"
    @done = "{prefix}_copies_done"
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A5, registers.A3, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, loop)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A5, registers.A4, done)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A5, registers.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    (undo == no) {
        compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.T0, registers.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
        compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.T0, registers.ZERO, abi.OBJECT_FLAGS_MASK)
        compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A5, registers.T0, abi.OBJECT_HEADER_FLAGS_OFFSET)
    }
    (undo == yes) {
        compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A5, registers.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
        compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T0, registers.T1, abi.OBJECT_HEADER_KIND_OFFSET)
    }
    compiler = emit_object_size(compiler, registers.T0, registers.A5)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A5, registers.A5, registers.T0, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, loop)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, done)
    out compiler
}

skill emit_slide(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.A3, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.S4, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_slide")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.T0, registers.A4, ".L_region_slid")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T1, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, WORD_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, WORD_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_region_slide")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_slid")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T0, registers.A4, registers.A3, 0)
    out state.emit_op(compiler, instruction.Kind.ADD, registers.S1, registers.S4, registers.T0, 0)
}

skill emit_escape_compact(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.S5, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.S5, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_compact")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.S2, registers.T1, ".L_region_compacted")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, 0 - model.ESCAPE_ENTRY_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T3, registers.T2, registers.ZERO, model.ESCAPE_SLOT_FLAG)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.ZERO, ".L_region_compact_keep")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.T2, registers.S4, ".L_region_compact")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_compact_keep")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, 0 - model.ESCAPE_ENTRY_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T0, registers.T2, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.ZERO, ".L_region_compact")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T4, registers.T2, registers.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T4, registers.T4, registers.ZERO, model.ESCAPE_FLAGS_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.T4, registers.T4, registers.T0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T2, registers.T4, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_region_compact")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_compacted")
    out state.emit_op(compiler, instruction.Kind.ADDI, registers.S2, registers.T0, registers.ZERO, 0)
}

skill emit_region_exit(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_exit")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.S1, registers.S4, ".L_region_exit_work")
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_exit_work")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 0 - EXIT_FRAME_BYTES)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, EXIT_RETURN_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, EXIT_ERROR_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, EXIT_VALUE_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A3, registers.S1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A4, registers.S1, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A2, registers.ZERO, ".L_region_exit_roots")
    compiler = emit_visit(compiler, "rt_region_forward", registers.SP, EXIT_VALUE_OFFSET)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_exit_roots")
    compiler = emit_escape_walk(compiler, "rt_region_forward", ".L_region_forward")
    compiler = emit_block_walk(compiler, "rt_region_forward", ".L_region_scan")
    compiler = emit_copies_walk(compiler, ".L_region_settle", no)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T6, registers.A3, registers.S4, 0)
    compiler = emit_visit(compiler, "rt_region_relocate", registers.SP, EXIT_VALUE_OFFSET)
    compiler = emit_escape_walk(compiler, "rt_region_relocate", ".L_region_relocate")
    compiler = emit_block_walk(compiler, "rt_region_relocate", ".L_region_relocated")
    compiler = emit_slide(compiler)
    compiler = emit_escape_compact(compiler)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_region_exit_return")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_abort")
    compiler = emit_copies_walk(compiler, ".L_region_undo", yes)
    compiler = emit_visit(compiler, "rt_region_restore", registers.SP, EXIT_VALUE_OFFSET)
    compiler = emit_escape_walk(compiler, "rt_region_restore", ".L_region_restore")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_exit_return")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, EXIT_VALUE_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A1, registers.SP, registers.ZERO, EXIT_ERROR_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, EXIT_RETURN_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, EXIT_FRAME_BYTES)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_region_barrier(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_barrier")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A2, registers.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, 0 - abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, registers.T0, registers.T0, registers.ZERO, POINTER_TAG_COUNT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.ZERO, ".L_region_barrier_done")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.A2, registers.ZERO, abi.PAYLOAD_MASK)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.T2, registers.S4, ".L_region_barrier_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.T2, registers.T1, ".L_region_barrier_done")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.T2, registers.ZERO, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.T0, registers.ZERO, model.ESCAPE_ENTRY_MASK)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_region_barrier_record")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T1, registers.S5, ".L_region_barrier_done")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_barrier_record")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.S2, registers.ZERO, 0 - model.ESCAPE_ENTRY_BYTES)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T1, registers.S1, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.S2, registers.T1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S2, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.T0, registers.ZERO, model.ESCAPE_FLAGS_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.T0, registers.T0, registers.S2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T2, registers.T0, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_barrier_done")
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_region_remember_slot(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_region_remember_slot")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.A0, registers.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, 0 - abi.TAG_STRING)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, registers.T1, registers.T1, registers.ZERO, POINTER_TAG_COUNT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_region_remember_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.S2, registers.ZERO, 0 - model.ESCAPE_ENTRY_BYTES)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T1, registers.S1, "rt_out_of_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.S2, registers.T1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.T0, registers.T0, registers.ZERO, model.ESCAPE_SLOT_FLAG)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S2, registers.T0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_region_remember_done")
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill append_runtime(compiler) {
    compiler = emit_alloc(compiler)
    compiler = emit_out_of_memory(compiler)
    compiler = emit_region_exit(compiler)
    compiler = emit_region_forward(compiler)
    compiler = emit_region_relocate(compiler)
    compiler = emit_region_restore(compiler)
    compiler = emit_region_barrier(compiler)
    out emit_region_remember_slot(compiler)
}
