skill emit_mem_store_address32(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_mem_store_address32")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T1, registers.T1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T2, registers.T2, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.T1, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T2, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T2, registers.T2, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.T0, registers.T1, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.T0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T3, registers.A2, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T1, registers.T1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T2, registers.T2, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.T1, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T2, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T2, registers.T2, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.T3, registers.T1, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_mem_arena(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_mem_arena")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.T0, "saltic_arena", 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A0, registers.ZERO, ".L_mem_arena_low")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T0, registers.T0, registers.ZERO, 16)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_mem_arena_low")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T0, registers.T0, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T0, registers.T0, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.T0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}
