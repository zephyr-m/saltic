-- raw_memory — рантайм core.mem: чтение и запись по физическому адресу.
-- Каждый навык берёт и отдаёт compiler, определяя метку rt_mem_* в коде.
-- Адрес — группа [hi, lo] по 16 бит в a0, смещение в a1, значение в a2;
-- результат чтения — число с тегом в a0.
--
-- emit_mem_load8 / emit_mem_load16 / emit_mem_load32(compiler) — rt_mem_load*
-- emit_mem_store8 / emit_mem_store16 / emit_mem_store32(compiler) — rt_mem_store*
-- emit_mem_store_address32(compiler) — записать адрес [hi, lo] как 32 бита
-- emit_mem_arena(compiler) — rt_mem_arena(a0 half) -> hi или lo адреса saltic_arena

use selfhost.abi
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.state
use selfhost.compiler.backend.rv32i.machine.registers

skill emit_mem_load8(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_mem_load8")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T1, registers.T1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T2, registers.T2, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.T1, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T2, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T2, registers.T2, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.T0, registers.T1, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.T0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.A0, registers.T0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_mem_load16(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_mem_load16")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T1, registers.T1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.T2, registers.T2, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.T1, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T2, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T2, registers.T2, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.T0, registers.T1, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.T0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LHU, registers.A0, registers.T0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

