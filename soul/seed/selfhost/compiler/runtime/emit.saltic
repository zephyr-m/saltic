use core.str
use selfhost.abi
use selfhost.machine.instruction
use selfhost.machine.layout
use selfhost.compiler.state
use selfhost.compiler.runtime.emit.memory
use selfhost.compiler.runtime.emit.terminal
use core.process
use core.system
use selfhost.machine.registers

skill emit_add(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_add")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.A0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_sub(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_sub")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.A0, registers.A0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_mul(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_mul")
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.A1, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, registers.T1, registers.ZERO, ".L_mul_positive")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T1, registers.ZERO, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.A0, registers.ZERO, registers.A0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_mul_positive")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_mul_done")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_mul_loop")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T2, registers.T1, registers.ZERO, 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.ZERO, ".L_mul_skip")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.T0, registers.A0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_mul_skip")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T1, registers.T1, registers.ZERO, 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T1, registers.ZERO, ".L_mul_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_mul_done")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.T0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_div(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_div")
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A1, registers.ZERO, "rt_division_by_zero")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, registers.A0, registers.ZERO, ".L_div_left")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.A0, registers.ZERO, registers.A0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XORI, registers.T1, registers.T1, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_left")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, registers.A1, registers.ZERO, ".L_div_right")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.A1, registers.ZERO, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XORI, registers.T1, registers.T1, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_right")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.A0, registers.A1, ".L_div_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.A1, registers.ZERO, -1)
    compiler = state.emit_op(compiler, instruction.Kind.AND, registers.T2, registers.T2, registers.A1, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T2, registers.ZERO, ".L_div_long")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_shift")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A1, registers.T2, ".L_div_shifted")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.A1, registers.A1, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.A0, registers.A0, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_div_shift")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_shifted")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.A0, registers.ZERO, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_div_done")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_long")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.VALUE_WORD_BITS)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_loop")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T4, registers.A0, registers.ZERO, abi.VALUE_WORD_BITS - 1)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.T2, registers.T2, registers.T4, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T0, registers.T0, registers.ZERO, 1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T2, registers.A1, ".L_div_next")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T2, registers.T2, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.T0, registers.T0, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.T3, registers.ZERO, -1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.ZERO, ".L_div_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_div_encode")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T0, registers.ZERO, registers.T0, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_div_encode")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.T0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_division_by_zero(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_division_by_zero")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_DIVISION_BY_ZERO)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_equal(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_equal")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A0, registers.A1, ".L_equal_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.A1, registers.ZERO, abi.TAG_MASK)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.T1, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.T2, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A1, registers.A1, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.T1, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_equal_string")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.T0, ".L_equal_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.A1, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T3, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T4, registers.T4, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.T4, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_equal_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_equal_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.YES)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_equal_no")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NO)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_less(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_less")
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.A1, ".L_less_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NO)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_less_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.YES)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_greater(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_greater")
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A1, registers.A0, ".L_greater_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NO)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_greater_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.YES)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_box_get(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_box_get")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A2, registers.T0, ".L_box_get_scan")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.A2, registers.ZERO, 3)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T1, registers.A0, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T2, registers.A1, ".L_box_get_scan")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_get_scan")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_get_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.ZERO, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A0, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.A1, ".L_box_get_found")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_box_get_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_get_found")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_box_set(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_box_set")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A3, registers.T0, ".L_box_set_scan")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T1, registers.A3, registers.ZERO, 3)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T1, registers.T2, registers.T1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T3, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.A1, ".L_box_set_scan")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T1, registers.A2, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_region_barrier")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_scan")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.ZERO, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.A0, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.A1, ".L_box_set_found")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, 8)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_box_set_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_box_set_found")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.A2, 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_region_barrier")
    out compiler
}

skill emit_missing_field(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_missing_field")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_MISSING_FIELD)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_count(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_count")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_at(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_group_at")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.A0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGEU, registers.A1, registers.T0, "rt_group_bounds")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A1, registers.A1, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.A0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.A0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_group_bounds(compiler) {
