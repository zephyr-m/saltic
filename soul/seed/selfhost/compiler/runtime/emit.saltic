skill emit_file_write(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_file_write")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -32)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 28)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, 24)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, -100)
    compiler.machine = layout.emit_load_immediate(compiler.machine, registers.A2, 577)
    compiler.machine = layout.emit_load_immediate(compiler.machine, registers.A3, 420)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_OPENAT)
    compiler = state.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.ZERO, "rt_file_error")
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 20)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 24)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.T0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 20)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_WRITE)
    compiler = state.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 20)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_CLOSE)
    compiler = state.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

