    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A6, registers.T4, ".L_fixed_add_signed")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.A0, registers.T2, "rt_fixed_overflow")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_add_signed")
    compiler = state.emit_op(compiler, instruction.Kind.XOR, registers.T4, registers.A0, registers.T2, 0)
    compiler = state.emit_op(compiler, instruction.Kind.XOR, registers.T5, registers.A0, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.AND, registers.T4, registers.T4, registers.T5, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.T4, registers.ZERO, "rt_fixed_overflow")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

