    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLTU, registers.T5, registers.T3, ".L_fixed_div_next")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T5, registers.T5, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.T4, registers.T4, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T6, registers.T6, registers.ZERO, -1)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T6, registers.ZERO, ".L_fixed_div_loop")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A4, registers.ZERO, ".L_fixed_div_positive")
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.T4, registers.ZERO, registers.T4, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_fixed_div_ready")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_positive")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A6, registers.A2, ".L_fixed_div_ready")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.T4, registers.ZERO, "rt_fixed_overflow")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_div_ready")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A0, registers.T4, registers.ZERO, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_fixed_and(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_and")
    compiler = state.emit_op(compiler, instruction.Kind.AND, registers.A0, registers.A0, registers.A1, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_fixed_or(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_or")
    compiler = state.emit_op(compiler, instruction.Kind.OR, registers.A0, registers.A0, registers.A1, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_fixed_xor(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_xor")
    compiler = state.emit_op(compiler, instruction.Kind.XOR, registers.A0, registers.A0, registers.A1, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_fixed_not(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_not")
    compiler = state.emit_op(compiler, instruction.Kind.XORI, registers.A0, registers.A0, registers.ZERO, -1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_fixed_shift_left(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_shift_left")
    compiler = state.emit_op(compiler, instruction.Kind.SLL, registers.A0, registers.A0, registers.A1, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_fixed_shift_right(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_shift_right")
    compiler = state.emit_op(compiler, instruction.Kind.SRL, registers.A0, registers.A0, registers.A1, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_fixed_convert(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_fixed_convert")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.FIXED_I32)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A6, registers.T0, ".L_fixed_convert_to_signed")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.ZERO, "rt_fixed_overflow")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_convert_to_signed")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A7, registers.T0, ".L_fixed_convert_ready")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.ZERO, "rt_fixed_overflow")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_fixed_convert_ready")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.A6, registers.A7, registers.ZERO, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_fixed_new")
    out compiler
}

skill emit_value_text(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_value_text")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_value_text_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_NUMBER)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.T1, ".L_value_text_answer")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_number_text")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_answer")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_ANSWER)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_value_text_yes")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_unknown_text", 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_value_text_static")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_yes")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.NO)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A0, registers.T0, ".L_value_text_no")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_yes_text", 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_value_text_static")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_no")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_no_text", 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_static")
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_show(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_show")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_show_string")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_NUMBER)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_show_number")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_ANSWER)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_show_answer")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_ERROR)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_show_error")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_unknown_text", 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_number")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler.machine = layout.emit_call(compiler.machine, "rt_number_text")
    compiler.machine = layout.emit_call(compiler.machine, "rt_show")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_answer")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.NO)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A0, registers.T0, ".L_show_no")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_yes_text", 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_no")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_no_text", 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_error")
    compiler = state.emit_op(compiler, instruction.Kind.SRLI, registers.T0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.ERROR_FIXED_INTEGER_OVERFLOW)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.T1, ".L_show_error_memory")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_fixed_overflow_text", 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_error_memory")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.ERROR_MEMORY_EXHAUSTED)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.T1, ".L_show_error_unknown")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_memory_exhausted_text", 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_error_unknown")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_unknown_text", 0)
    compiler = state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_string")
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler.machine = layout.emit_call(compiler.machine, "rt_platform_write")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill append_runtime_data(compiler) {
    compiler = terminal.append_text(compiler, "rt_unknown_text", "<value>")
    compiler = terminal.append_text(compiler, "rt_fixed_overflow_text", "значение вышло за границы фиксированного целого")
    compiler = terminal.append_text(compiler, "rt_memory_exhausted_text", "память исчерпана")
    compiler = terminal.append_text(compiler, "rt_yes_text", "yes")
    compiler = terminal.append_text(compiler, "rt_no_text", "no")
    compiler.machine = layout.align_section(compiler.machine, layout.Section.RODATA, 8)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.RODATA, "rt_newline_text")
    compiler.machine = layout.append_section_byte(compiler.machine, layout.Section.RODATA, 10)
    out compiler
}

skill append_runtime_prefix(compiler) {
    compiler = emit_add(compiler)
    compiler = emit_sub(compiler)
    compiler = emit_mul(compiler)
    compiler = emit_div(compiler)
    compiler = emit_division_by_zero(compiler)
    compiler = emit_equal(compiler)
    compiler = emit_less(compiler)
    compiler = emit_greater(compiler)
    compiler = emit_box_get(compiler)
    compiler = emit_box_set(compiler)
    compiler = emit_missing_field(compiler)
    compiler = emit_group_count(compiler)
    compiler = emit_group_at(compiler)
    compiler = emit_group_bounds(compiler)
    compiler = emit_string_len(compiler)
    compiler = emit_string_byte(compiler)
    compiler = emit_string_bounds(compiler)
    compiler = emit_string_starts_with(compiler)
    compiler = emit_string_ends_with(compiler)
    compiler = emit_string_contains(compiler)
    compiler = emit_line_count(compiler)
    compiler = emit_newline(compiler)
    compiler = emit_missing_args(compiler)
    out compiler
}

skill append_runtime_suffix(compiler) {
    compiler = emit_cpu_wait(compiler)
    compiler = emit_cpu_fence(compiler)
    compiler = emit_file_write(compiler)
    compiler = emit_file_error(compiler)
    compiler = emit_fixed_overflow_restore(compiler)
    compiler = emit_fixed_overflow(compiler)
    compiler = emit_fixed_equal(compiler)
    compiler = emit_fixed_less(compiler)
    compiler = emit_fixed_greater(compiler)
    compiler = emit_fixed_new(compiler)
    compiler = emit_fixed_mem_load8(compiler)
    compiler = emit_fixed_mem_load16(compiler)
    compiler = emit_fixed_mem_load32(compiler)
    compiler = emit_fixed_mem_load(compiler)
    compiler = emit_fixed_mem_store8(compiler)
    compiler = emit_fixed_mem_store16(compiler)
    compiler = emit_fixed_mem_store32(compiler)
    compiler = emit_fixed_mem_store(compiler)
    compiler = emit_mem_load8(compiler)
    compiler = emit_mem_load16(compiler)
    compiler = emit_mem_load32(compiler)
    compiler = emit_mem_store8(compiler)
    compiler = emit_mem_store16(compiler)
    compiler = emit_mem_store32(compiler)
    compiler = emit_mem_store_address32(compiler)
    compiler = emit_fixed_show(compiler)
    compiler = emit_group_add(compiler)
    compiler = emit_cstring(compiler)
    compiler = emit_string_add(compiler)
    compiler = emit_string_at(compiler)
    compiler = emit_string_slice(compiler)
    compiler = emit_string_lower(compiler)
    compiler = emit_string_upper(compiler)
    compiler = emit_string_case(compiler)
    compiler = emit_number_text(compiler)
    compiler = emit_file_read(compiler)
    compiler = emit_file_write_bytes(compiler)
    compiler = emit_file_write_byte_group(compiler)
    compiler = emit_fixed_add(compiler)
    compiler = emit_fixed_sub(compiler)
    compiler = emit_fixed_mul(compiler)
    compiler = emit_fixed_div(compiler)
    compiler = emit_fixed_and(compiler)
    compiler = emit_fixed_or(compiler)
    compiler = emit_fixed_xor(compiler)
    compiler = emit_fixed_not(compiler)
    compiler = emit_fixed_shift_left(compiler)
    compiler = emit_fixed_shift_right(compiler)
    compiler = emit_fixed_convert(compiler)
    compiler = emit_show(compiler)
    compiler = emit_value_text(compiler)
    compiler = memory.append_runtime(compiler)
    compiler = terminal.append_runtime(compiler)
    compiler = append_runtime_data(compiler)
    out terminal.append_data(compiler)
}

skill append_runtime_common(compiler) {
    compiler = append_runtime_prefix(compiler)
    out append_runtime_suffix(compiler)
}

skill append_runtime(compiler) {
    compiler = append_runtime_prefix(compiler)
    compiler = emit_platform_write(compiler)
    compiler = emit_platform_exit(compiler)
    out append_runtime_suffix(compiler)
}
