    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 10)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T4, registers.T5, ".L_line_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_line_next")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.T2, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_line_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_line_done")
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T3, registers.A0, registers.T0, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LBU, registers.T4, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 3)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T5, registers.ZERO, registers.ZERO, 10)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T4, registers.T5, ".L_line_encode")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, 1)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_line_encode")
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.T1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = state.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
