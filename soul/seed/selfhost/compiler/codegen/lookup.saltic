-- lookup — имена, ошибки и типы для codegen: поиск по таблицам state.
-- Тип — текст: "unknown", "box:Имя" и прочие метки ast.type_of.
--
-- box_field_symbol(compiler, box_name, field_name) -> Symbol поля или пустой
-- remember_error(compiler, name) — завести id пользовательской ошибки
-- error_id(compiler, name) -> id (системный или пользовательский)
-- failure_name(node) -> имя из error.Имя или ""
-- resolve_symbol(compiler, symbols, name) -> name, если есть, иначе ""
-- call_name(compiler, callee) -> имя native или путь
-- resolve_skill(compiler, path) -> имя навыка или ""
-- intrinsic(name) -> цель intrinsic из contract или "unknown"
-- infer_type(compiler, node) -> тип из пометки чекера (ast.type_of) или по слоту
--     переменной; поле Box и выбор метода — только из пометок чекера
-- box_override(overrides, field_name) -> узел значения или []
-- call_arguments(node) -> группа аргументов вызова

use core.str
use core.group
use selfhost.abi
use selfhost.ast
use selfhost.intrinsic.contract
use selfhost.checker.types
use selfhost.compiler.state

skill box_field_symbol(compiler, box_name, field_name) {
    @box = state.symbol_find(compiler.boxes, box_name)
    @member = types.box_member(box.node, field_name)
    (group.count(member) == 0) { out state.Symbol {} }
    out state.Symbol { name = field_name, kind = "field", node = member }
}

skill remember_error(compiler, name) {
    (abi.system_error_id(name) > 0) { out compiler }
    (state.symbol_has(compiler.errors, name) == yes) { out compiler }
    @id = abi.user_error_id(group.count(compiler.errors))
    compiler.errors = state.symbol_add(compiler.errors, name, "error", [], id)
    out compiler
}

skill error_id(compiler, name) {
    @system = abi.system_error_id(name)
    (system > 0) { out system }
    @item = state.symbol_find(compiler.errors, name)
    out item.value
}

skill failure_name(node) {
    @parts = ast.plain(node)
    (group.get(parts, 0) == "path") {
        (group.count(parts) == 3) {
            (group.get(parts, 1) == "error") { out group.get(parts, 2) }
        }
    }
    out ""
}

skill resolve_symbol(compiler, symbols, name) {
    (state.symbol_has(symbols, name) == yes) { out name }
    out ""
}

skill call_name(compiler, callee) {
    @name = ast.path_text(callee)
    @resolved = resolve_symbol(compiler, compiler.natives, name)
    (str.bytes(resolved) > 0) { out resolved }
    out name
}

skill resolve_skill(compiler, path) {
    out resolve_symbol(compiler, compiler.skills, ast.path_text(path))
}

skill intrinsic(name) {
    out contract.target(contract.find(name), "unknown")
}

skill infer_type(compiler, node) {
    @known = ast.type_of(node)
    ((known == "unknown") == no) { out known }
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "path") {
        @name = group.get(plain, 1)
        @type_item = state.type_find(compiler.current_function.types, name)
        @type = type_item.text
        (group.count(plain) == 2) { out type }
        out "unknown"
    }
    out "unknown"
}

skill box_override(overrides, field_name) {
    @count = group.count(overrides)
    drum (count) {
        @field = ast.plain(group.get(overrides, count - 1 - beat))
        (group.get(field, 1) == field_name) { out group.get(field, 2) }
    }
    out []
}

skill call_arguments(node) {
    @plain = ast.plain(node)
    out group.slice(plain, 2, group.count(plain))
}
