-- failures — ошибки в коде навыка: проверка ERROR после вызова, значение
-- error.Имя, rescue с восстановлением стека.
-- Ошибка = ERROR > 0 (id), VALUE = 0. Текущая метка перехвата —
-- current_function.failure; rescue временно подменяет её на frame.caught.
-- Команды — методами compiler.executor (договор backend).
--
-- Rescue { done, caught, stack_slot, outer } — кадр rescue
-- check(compiler) — ERROR > 0 → переход на failure навыка
-- load_value(compiler, name) — VALUE = значение error.Имя (тег ERROR)
-- load_failure(compiler, name) — поднять ошибку: VALUE = 0, ERROR = id
-- raise_value(compiler) — ошибка-значение из VALUE в ERROR
-- rescue_frame(compiler) -> Rescue; enter(compiler, frame) — сохранить STACK
-- catch(compiler, frame, name) — метка caught: вернуть STACK, ошибку в слот name

use core.str
use selfhost.abi
use selfhost.compiler.state
use selfhost.compiler.codegen.lookup
use selfhost.compiler.backend

Rescue = Box {
    done = "",
    caught = "",
    stack_slot = 0,
    outer = ""
}

skill check(compiler) {
    (str.bytes(compiler.current_function.failure) == 0) { out compiler }
    @executor = compiler.executor
    out executor.jump_if_nonzero(compiler, backend.ERROR, compiler.current_function.failure)
}

skill load_value(compiler, name) {
    @executor = compiler.executor
    compiler = lookup.remember_error(compiler, name)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.error_value(lookup.error_id(compiler, name)))
    out executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
}

skill load_failure(compiler, name) {
    @executor = compiler.executor
    compiler = lookup.remember_error(compiler, name)
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    out executor.load_immediate(compiler, backend.ERROR, lookup.error_id(compiler, name))
}

skill raise_value(compiler) {
    @executor = compiler.executor
    compiler = executor.shift_right_unsigned(compiler, backend.ERROR, backend.VALUE, abi.TAG_SHIFT)
    out executor.load_immediate(compiler, backend.VALUE, 0)
}

skill rescue_frame(compiler) {
    @done = state.label(compiler, "rescue_done")
    @caught = state.label(compiler, "rescue_caught")
    @stack_slot = state.slot(compiler, "$rescue:{compiler.current_function.next_rescue}")
    out Rescue { done = done, caught = caught, stack_slot = stack_slot, outer = compiler.current_function.failure }
}

skill enter(compiler, frame) {
    @executor = compiler.executor
    compiler.current_function.next_rescue = compiler.current_function.next_rescue + 1
    compiler = executor.store(compiler, backend.STACK, backend.FRAME, frame.stack_slot)
    compiler.current_function.failure = frame.caught
    out compiler
}

skill catch(compiler, frame, name) {
    @executor = compiler.executor
    compiler.current_function.failure = frame.outer
    compiler = executor.jump_if_zero(compiler, backend.ERROR, frame.done)
    compiler = executor.label(compiler, frame.caught)
    compiler = executor.load(compiler, backend.STACK, backend.FRAME, frame.stack_slot)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_ERROR)
    compiler = executor.store(compiler, backend.VALUE, backend.FRAME, state.slot(compiler, name))
    out executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
}
