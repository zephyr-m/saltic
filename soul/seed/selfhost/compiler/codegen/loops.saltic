-- loops — цикл drum: счётчик, источник (число или группа) и beat.
-- Источник в VALUE перед head: группа → beat = элемент (плоская или дерево
-- через rt_group_at), число → beat = номер; отрицательное число —
-- ERROR_NEGATIVE_COUNT. Лёгкий вариант (light_*) — только счётчик, без beat.
-- Команды — методами compiler.executor (договор backend).
--
-- Frame { counter, source, position, saved, beat_slot, start, end, numeric,
--     counted, beat_number, beat_ready, count_ok } — слоты и метки цикла
-- frame(compiler) -> Frame с новыми слотами и метками
-- head(compiler, frame) / tail(compiler, frame) — полный цикл вокруг тела
-- light_head / light_tail(compiler, frame) — без beat
-- raise_if_negative(compiler, frame) — выход из навыка при VALUE < 0

use core.num
use selfhost.abi
use selfhost.ast
use selfhost.compiler.backend
use selfhost.compiler.state
use selfhost.compiler.constants

Frame = Box {
    counter = 0,
    source = 0,
    position = 0,
    saved = 0,
    beat_slot = 0,
    start = "",
    end = "",
    numeric = "",
    counted = "",
    beat_number = "",
    beat_ready = "",
    count_ok = ""
}

skill frame(compiler) {
    @drum_number = num.text(compiler.current_function.next_drum)
    compiler.current_function.next_drum = compiler.current_function.next_drum + 1
    @counter = state.slot(compiler, "$drum:{drum_number}")
    @source = state.slot(compiler, "$drum_source:{drum_number}")
    @position = state.slot(compiler, "$drum_index:{drum_number}")
    @saved = state.slot(compiler, "$drum_saved:{drum_number}")
    @beat_slot = state.slot(compiler, ast.DRUM_BEAT)
    @start = state.label(compiler, "drum")
    @end = state.label(compiler, "drum_end")
    @numeric = state.label(compiler, "drum_numeric")
    @counted = state.label(compiler, "drum_counted")
    @beat_number = state.label(compiler, "drum_beat_number")
    @beat_ready = state.label(compiler, "drum_beat_ready")
    @count_ok = state.label(compiler, "drum_count_ok")
    out Frame {
        counter = counter, source = source, position = position, saved = saved, beat_slot = beat_slot,
        start = start, end = end, numeric = numeric, counted = counted,
        beat_number = beat_number, beat_ready = beat_ready, count_ok = count_ok
    }
}

skill light_head(compiler, frame) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.VALUE, abi.TAG_MASK)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.TAG_GROUP)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, frame.numeric)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH1, words.payload)
    compiler = executor.jump(compiler, frame.counted)
    compiler = executor.label(compiler, frame.numeric)
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = raise_if_negative(compiler, frame)
    compiler = executor.label(compiler, frame.counted)
    compiler = executor.store(compiler, backend.VALUE, backend.FRAME, frame.counter)
    compiler = executor.label(compiler, frame.start)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, frame.counter)
    compiler = executor.jump_if_zero(compiler, backend.SCRATCH0, frame.end)
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, -1)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, frame.counter)
    out compiler
}

skill head(compiler, frame) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.store(compiler, backend.VALUE, backend.FRAME, frame.source)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.VALUE, abi.TAG_MASK)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.TAG_GROUP)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, frame.numeric)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH1, words.payload)
    compiler = executor.jump(compiler, frame.counted)
    compiler = executor.label(compiler, frame.numeric)
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = raise_if_negative(compiler, frame)
    compiler = executor.store_zero(compiler, backend.FRAME, frame.source)
    compiler = executor.label(compiler, frame.counted)
    compiler = executor.store(compiler, backend.VALUE, backend.FRAME, frame.counter)
    compiler = executor.store_zero(compiler, backend.FRAME, frame.position)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, frame.beat_slot)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, frame.saved)
    compiler = executor.label(compiler, frame.start)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, frame.counter)
    compiler = executor.jump_if_zero(compiler, backend.SCRATCH0, frame.end)
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, -1)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, frame.counter)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.FRAME, frame.position)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.FRAME, frame.source)
    compiler = executor.branch_zero(compiler, backend.SCRATCH2, frame.beat_number)
    compiler = executor.and_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, abi.PAYLOAD_MASK)
    @flat = state.label(compiler, "drum_flat")
    compiler = executor.load32(compiler, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, abi.OBJECT_KIND_TREE)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH3, backend.SCRATCH4, flat)
    compiler = executor.move(compiler, backend.VALUE, backend.SCRATCH2)
    compiler = executor.shift_left(compiler, backend.ERROR, backend.SCRATCH1, abi.TAG_SHIFT)
    compiler = executor.call(compiler, "rt_group_at")
    compiler = executor.move(compiler, backend.SCRATCH2, backend.VALUE)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.FRAME, frame.position)
    compiler = executor.jump(compiler, frame.beat_ready)
    compiler = executor.label(compiler, flat)
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH1, words.shift)
    compiler = executor.add(compiler, backend.SCRATCH2, backend.SCRATCH2, backend.SCRATCH3)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH2, words.payload + words.group_items)
    compiler = executor.jump(compiler, frame.beat_ready)
    compiler = executor.label(compiler, frame.beat_number)
    compiler = executor.shift_left(compiler, backend.SCRATCH2, backend.SCRATCH1, abi.TAG_SHIFT)
    compiler = executor.label(compiler, frame.beat_ready)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.FRAME, frame.beat_slot)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.FRAME, frame.position)
    out compiler
}

skill tail(compiler, frame) {
    @executor = compiler.executor
    compiler = executor.jump(compiler, frame.start)
    compiler = executor.label(compiler, frame.end)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, frame.saved)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, frame.beat_slot)
    out compiler
}

skill light_tail(compiler, frame) {
    @executor = compiler.executor
    compiler = executor.jump(compiler, frame.start)
    compiler = executor.label(compiler, frame.end)
    out compiler
}

skill raise_if_negative(compiler, frame) {
    @executor = compiler.executor
    compiler = executor.branch_not_negative(compiler, backend.VALUE, frame.count_ok)
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.ERROR_NEGATIVE_COUNT)
    compiler = executor.load_immediate(compiler, backend.ARG2, constants.REGION_VALUE_SKIPPED)
    compiler = executor.jump(compiler, compiler.current_function.end)
    compiler = executor.label(compiler, frame.count_ok)
    out compiler
}
