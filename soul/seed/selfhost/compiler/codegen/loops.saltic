-- loops — цикл drum: счётчик, источник (число или группа) и beat.
-- Источник в a0 перед head: группа → beat = элемент (плоская или дерево через
-- rt_group_at), число → beat = номер; отрицательное число — ERROR_NEGATIVE_COUNT.
-- Лёгкий вариант (light_*) — только счётчик, без beat.
--
-- Frame { counter, source, position, saved, beat_slot, start, end, numeric,
--     counted, beat_number, beat_ready, count_ok } — слоты и метки цикла
-- frame(compiler) -> Frame с новыми слотами и метками
-- head(compiler, frame) / tail(compiler, frame) — полный цикл вокруг тела
-- light_head / light_tail(compiler, frame) — без beat
-- raise_if_negative(compiler, frame) — выход из навыка при a0 < 0

use core.num
use selfhost.abi
use selfhost.ast
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.compiler.state
use selfhost.compiler.constants

Frame = Box {
    counter = 0,
    source = 0,
    position = 0,
    saved = 0,
    beat_slot = 0,
    start = "",
    end = "",
    numeric = "",
    counted = "",
    beat_number = "",
    beat_ready = "",
    count_ok = ""
}

skill frame(compiler) {
    @drum_number = num.text(compiler.current_function.next_drum)
    compiler.current_function.next_drum = compiler.current_function.next_drum + 1
    @counter = state.slot(compiler, "$drum:{drum_number}")
    @source = state.slot(compiler, "$drum_source:{drum_number}")
    @position = state.slot(compiler, "$drum_index:{drum_number}")
    @saved = state.slot(compiler, "$drum_saved:{drum_number}")
    @beat_slot = state.slot(compiler, ast.DRUM_BEAT)
    @start = state.label(compiler, "drum")
    @end = state.label(compiler, "drum_end")
    @numeric = state.label(compiler, "drum_numeric")
    @counted = state.label(compiler, "drum_counted")
    @beat_number = state.label(compiler, "drum_beat_number")
    @beat_ready = state.label(compiler, "drum_beat_ready")
    @count_ok = state.label(compiler, "drum_count_ok")
    out Frame {
        counter = counter, source = source, position = position, saved = saved, beat_slot = beat_slot,
        start = start, end = end, numeric = numeric, counted = counted,
        beat_number = beat_number, beat_ready = beat_ready, count_ok = count_ok
    }
}

skill light_head(compiler, frame) {
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.A0, registers.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, abi.TAG_GROUP)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T1, registers.T2, frame.numeric)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, frame.counted)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.numeric)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = raise_if_negative(compiler, frame)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.counted)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.A0, frame.counter)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.start)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.S0, registers.ZERO, frame.counter)
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, registers.ZERO, registers.T0, registers.ZERO, 8)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, frame.end)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, -1)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.T0, frame.counter)
    out compiler
}

skill head(compiler, frame) {
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.A0, frame.source)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.A0, registers.ZERO, abi.TAG_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.ZERO, registers.ZERO, abi.TAG_GROUP)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T1, registers.T2, frame.numeric)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T1, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, frame.counted)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.numeric)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = raise_if_negative(compiler, frame)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.ZERO, frame.source)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.counted)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.A0, frame.counter)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.ZERO, frame.position)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.S0, registers.ZERO, frame.beat_slot)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.T0, frame.saved)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.start)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.S0, registers.ZERO, frame.counter)
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, registers.ZERO, registers.T0, registers.ZERO, 8)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, frame.end)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, -1)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.T0, frame.counter)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.S0, registers.ZERO, frame.position)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.S0, registers.ZERO, frame.source)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T2, registers.ZERO, frame.beat_number)
    compiler = state.emit_op(compiler, instruction.Kind.ANDI, registers.T2, registers.T2, registers.ZERO, abi.PAYLOAD_MASK)
    @flat = state.label(compiler, "drum_flat")
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T3, registers.T2, registers.ZERO, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_TREE)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T3, registers.T4, flat)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T2, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A1, registers.T1, registers.ZERO, abi.TAG_SHIFT)
    compiler.machine = layout.emit_call(compiler.machine, "rt_group_at")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.A0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.S0, registers.ZERO, frame.position)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, frame.beat_ready)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, flat)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T3, registers.T1, registers.ZERO, 2)
    compiler = state.emit_op(compiler, instruction.Kind.ADD, registers.T2, registers.T2, registers.T3, 0)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T2, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + abi.VALUE_WORD_BYTES)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, frame.beat_ready)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.beat_number)
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T1, registers.ZERO, abi.TAG_SHIFT)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.beat_ready)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.T2, frame.beat_slot)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.T1, registers.ZERO, 1)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.T1, frame.position)
    out compiler
}

skill tail(compiler, frame) {
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, frame.start)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.end)
    compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.S0, registers.ZERO, frame.saved)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.T0, frame.beat_slot)
    out compiler
}

skill light_tail(compiler, frame) {
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, frame.start)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.end)
    out compiler
}

skill raise_if_negative(compiler, frame) {
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BGE, registers.A0, registers.ZERO, frame.count_ok)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_NEGATIVE_COUNT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, constants.REGION_VALUE_SKIPPED)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, compiler.current_function.end)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.count_ok)
    out compiler
}
