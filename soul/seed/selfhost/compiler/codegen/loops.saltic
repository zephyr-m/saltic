-- loops — цикл drum: счётчик, источник (число или группа), beat и регион цикла.
-- Источник в VALUE перед head: группа → beat = элемент (плоская или дерево
-- через rt_group_at), число → beat = номер; отрицательное число —
-- ERROR_NEGATIVE_COUNT. Лёгкий вариант (light_*) — только счётчик, без beat.
-- Регион: весь drum — один регион (REGION_MARK = HEAP_TOP на входе, метка навыка в
-- слоте $drum_mark:N). Мусор оборотов не копится до выхода из навыка: в конце
-- оборота, когда занято больше, чем живое плюс model.DRUM_SLACK_BYTES (через регистр: 4096 не влезает в число команды RISC-V; слот
-- $drum_limit:N), регион сжимается через rt_region_exit — корень — группа из
-- значений внешних переменных, которым тело присваивает (кроме фиксированных типов:
-- их слово не отличить от указателя); живое копируется вниз, остальное уходит.
-- Работа — не больше двух копий на выделенный байт. out и ошибка из тела — через
-- трамплины, возвращающие метку навыка перед общим выходом; leave — метка конца.
-- Команды — методами compiler.executor (договор backend).
--
-- Frame { number, counter, source, position, saved, beat_slot, start, end, numeric,
--     counted, beat_number, beat_ready, count_ok } — слоты и метки цикла
-- Region { mark, limit, returning, failing, outer_end, outer_failure, roots } — регион drum
-- frame(compiler) -> Frame с новыми слотами и метками
-- region_open(compiler, frame, body) -> Region; регион открыт, выходы тела подменены
--     (VALUE — источник — цел); зовётся до head
-- head(compiler, frame) / tail(compiler, frame) — начало цикла (метка start) и конец
--     (метка end, возврат beat); light_head / light_tail(compiler, frame) — без beat
-- region_close(compiler, frame, region) — конец оборота: сжатие по порогу, переход в
--     начало, трамплины; зовётся после тела, до tail
-- region_restore(compiler, region) — REGION_MARK из слота; после tail
-- raise_if_negative(compiler, frame) — выход из навыка при VALUE < 0

use core.str
use core.num
use core.group
use selfhost.abi
use selfhost.ast
use selfhost.compiler.backend
use selfhost.compiler.state
use selfhost.compiler.constants
use selfhost.memory.model
use selfhost.intrinsic.contract

Frame = Box {
    number = "",
    counter = 0,
    source = 0,
    position = 0,
    saved = 0,
    beat_slot = 0,
    start = "",
    end = "",
    numeric = "",
    counted = "",
    beat_number = "",
    beat_ready = "",
    count_ok = ""
}

Region = Box {
    mark = 0,
    limit = 0,
    returning = "",
    failing = "",
    outer_end = "",
    outer_failure = "",
    roots = []
}

skill frame(compiler) {
    @drum_number = num.text(compiler.current_function.next_drum)
    compiler.current_function.next_drum = compiler.current_function.next_drum + 1
    @counter = state.slot(compiler, "$drum:{drum_number}")
    @source = state.slot(compiler, "$drum_source:{drum_number}")
    @position = state.slot(compiler, "$drum_index:{drum_number}")
    @saved = state.slot(compiler, "$drum_saved:{drum_number}")
    @beat_slot = state.slot(compiler, ast.DRUM_BEAT)
    @start = state.label(compiler, "drum")
    @end = state.label(compiler, "drum_end")
    @numeric = state.label(compiler, "drum_numeric")
    @counted = state.label(compiler, "drum_counted")
    @beat_number = state.label(compiler, "drum_beat_number")
    @beat_ready = state.label(compiler, "drum_beat_ready")
    @count_ok = state.label(compiler, "drum_count_ok")
    out Frame {
        number = drum_number,
        counter = counter, source = source, position = position, saved = saved, beat_slot = beat_slot,
        start = start, end = end, numeric = numeric, counted = counted,
        beat_number = beat_number, beat_ready = beat_ready, count_ok = count_ok
    }
}

skill light_head(compiler, frame) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.VALUE, abi.TAG_MASK)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.TAG_GROUP)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, frame.numeric)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH1, words.payload)
    compiler = executor.jump(compiler, frame.counted)
    compiler = executor.label(compiler, frame.numeric)
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = raise_if_negative(compiler, frame)
    compiler = executor.label(compiler, frame.counted)
    compiler = executor.store(compiler, backend.VALUE, backend.FRAME, frame.counter)
    compiler = executor.label(compiler, frame.start)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, frame.counter)
    compiler = executor.jump_if_zero(compiler, backend.SCRATCH0, frame.end)
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, -1)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, frame.counter)
    out compiler
}

skill head(compiler, frame) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.store(compiler, backend.VALUE, backend.FRAME, frame.source)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.VALUE, abi.TAG_MASK)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.TAG_GROUP)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, frame.numeric)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH1, words.payload)
    compiler = executor.jump(compiler, frame.counted)
    compiler = executor.label(compiler, frame.numeric)
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = raise_if_negative(compiler, frame)
    compiler = executor.store_zero(compiler, backend.FRAME, frame.source)
    compiler = executor.label(compiler, frame.counted)
    compiler = executor.store(compiler, backend.VALUE, backend.FRAME, frame.counter)
    compiler = executor.store_zero(compiler, backend.FRAME, frame.position)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, frame.beat_slot)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, frame.saved)
    compiler = executor.label(compiler, frame.start)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, frame.counter)
    compiler = executor.jump_if_zero(compiler, backend.SCRATCH0, frame.end)
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, -1)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, frame.counter)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.FRAME, frame.position)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.FRAME, frame.source)
    compiler = executor.branch_zero(compiler, backend.SCRATCH2, frame.beat_number)
    compiler = executor.and_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, abi.PAYLOAD_MASK)
    @flat = state.label(compiler, "drum_flat")
    compiler = executor.load32(compiler, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, abi.OBJECT_KIND_TREE)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH3, backend.SCRATCH4, flat)
    compiler = executor.move(compiler, backend.VALUE, backend.SCRATCH2)
    compiler = executor.shift_left(compiler, backend.ERROR, backend.SCRATCH1, abi.TAG_SHIFT)
    compiler = executor.call(compiler, "rt_group_at")
    compiler = executor.move(compiler, backend.SCRATCH2, backend.VALUE)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.FRAME, frame.position)
    compiler = executor.jump(compiler, frame.beat_ready)
    compiler = executor.label(compiler, flat)
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH1, words.shift)
    compiler = executor.add(compiler, backend.SCRATCH2, backend.SCRATCH2, backend.SCRATCH3)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH2, words.payload + words.group_items)
    compiler = executor.jump(compiler, frame.beat_ready)
    compiler = executor.label(compiler, frame.beat_number)
    compiler = executor.shift_left(compiler, backend.SCRATCH2, backend.SCRATCH1, abi.TAG_SHIFT)
    compiler = executor.label(compiler, frame.beat_ready)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.FRAME, frame.beat_slot)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.FRAME, frame.position)
    out compiler
}

skill tail(compiler, frame) {
    @executor = compiler.executor
    compiler = executor.label(compiler, frame.end)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, frame.saved)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, frame.beat_slot)
    out compiler
}

skill light_tail(compiler, frame) {
    @executor = compiler.executor
    out executor.label(compiler, frame.end)
}

skill raise_if_negative(compiler, frame) {
    @executor = compiler.executor
    compiler = executor.branch_not_negative(compiler, backend.VALUE, frame.count_ok)
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.ERROR_NEGATIVE_COUNT)
    compiler = executor.load_immediate(compiler, backend.ARG2, constants.REGION_VALUE_SKIPPED)
    compiler = executor.jump(compiler, compiler.current_function.end)
    compiler = executor.label(compiler, frame.count_ok)
    out compiler
}

skill roots(compiler, body) {
    @found = []
    drum (state.outer_assigned(body)) {
        @type_item = state.type_find(compiler.current_function.types, beat)
        (contract.is_fixed_type(type_item.text) == no) { found = group.add(found, state.slot(compiler, beat)) }
    }
    out found
}

skill region_open(compiler, frame, body) {
    @executor = compiler.executor
    @region = Region {
        mark = state.slot(compiler, "$drum_mark:{frame.number}"),
        limit = state.slot(compiler, "$drum_limit:{frame.number}"),
        returning = state.label(compiler, "drum_out"),
        failing = state.label(compiler, "drum_failure"),
        outer_end = compiler.current_function.end,
        outer_failure = compiler.current_function.failure,
        roots = roots(compiler, body)
    }
    compiler = executor.store(compiler, backend.REGION_MARK, backend.FRAME, region.mark)
    compiler = executor.move(compiler, backend.REGION_MARK, backend.HEAP_TOP)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, model.DRUM_SLACK_BYTES)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.HEAP_TOP, backend.SCRATCH0)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, region.limit)
    compiler.current_function.end = region.returning
    (str.bytes(region.outer_failure) > 0) { compiler.current_function.failure = region.failing }
    out region
}

skill compact(compiler, region) {
    @executor = compiler.executor
    @words = compiler.words
    @count = group.count(region.roots)
    (count == 0) {
        compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
        compiler = executor.load_immediate(compiler, backend.ARG2, constants.REGION_VALUE_SKIPPED)
    }
    (count > 0) {
        compiler = executor.load_immediate(compiler, backend.VALUE, constants.group_storage_bytes(words, count))
        compiler = executor.call(compiler, "rt_alloc")
        compiler = executor.load_immediate(compiler, backend.SCRATCH3, abi.OBJECT_KIND_GROUP)
        compiler = executor.store32(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
        compiler = executor.load_immediate(compiler, backend.SCRATCH3, count)
        compiler = executor.store(compiler, backend.SCRATCH3, backend.VALUE, words.payload + constants.GROUP_COUNT_OFFSET)
        drum (count) {
            compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, group.get(region.roots, beat))
            compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload + constants.group_item_offset(words, beat))
        }
        compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
        compiler = executor.load_immediate(compiler, backend.ARG2, constants.REGION_VALUE_ROOT)
    }
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.move(compiler, backend.ARG3, backend.STACK)
    compiler = executor.call(compiler, "rt_region_exit")
    (count > 0) {
        compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.VALUE, abi.PAYLOAD_MASK)
        drum (count) {
            compiler = executor.load(compiler, backend.SCRATCH0, backend.SCRATCH1, words.payload + constants.group_item_offset(words, beat))
            compiler = executor.store(compiler, backend.SCRATCH0, backend.FRAME, group.get(region.roots, beat))
        }
    }
    compiler = executor.sub(compiler, backend.SCRATCH0, backend.HEAP_TOP, backend.REGION_MARK)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.HEAP_TOP)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, model.DRUM_SLACK_BYTES)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH1)
    out executor.store(compiler, backend.SCRATCH0, backend.FRAME, region.limit)
}

skill region_close(compiler, frame, region) {
    @executor = compiler.executor
    @fits = state.label(compiler, "drum_fits")
    compiler.current_function.end = region.outer_end
    compiler.current_function.failure = region.outer_failure
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, region.limit)
    compiler = executor.branch_less_unsigned(compiler, backend.HEAP_TOP, backend.SCRATCH0, fits)
    compiler = compact(compiler, region)
    compiler = executor.label(compiler, fits)
    compiler = executor.jump(compiler, frame.start)
    compiler = executor.label(compiler, region.returning)
    compiler = region_restore(compiler, region)
    compiler = executor.jump(compiler, region.outer_end)
    (str.bytes(region.outer_failure) > 0) {
        compiler = executor.label(compiler, region.failing)
        compiler = region_restore(compiler, region)
        compiler = executor.jump(compiler, region.outer_failure)
    }
    out compiler
}

skill region_restore(compiler, region) {
    @executor = compiler.executor
    out executor.load(compiler, backend.REGION_MARK, backend.FRAME, region.mark)
}
