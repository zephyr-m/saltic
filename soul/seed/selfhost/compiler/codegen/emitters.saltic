-- emitters — мелкие кусочки кода для codegen: литералы, поля Box, сравнения,
-- строки в rodata, локальные переменные, быстрые пути.
-- Каждый навык берёт и отдаёт compiler; значение — в a0, a1 = CALL_NO_ERROR
-- после emit_word_result. Строки складываются в rodata один раз (string_find).
--
-- negative_literal / constant_literal / fixed_literal(node) -> yes/no — узел
--     есть константа (число, -число, answer, none; fixed — и wide-number)
-- immediate_operand / simple_operand(compiler, node) -> yes/no
-- emit_field_get / emit_field_set(compiler, name) — rt_box_get / rt_box_set
-- emit_word_result(compiler) — a1 = CALL_NO_ERROR
-- emit_answer_from_bit(compiler) — бит в a0 → yes/no
-- emit_number_less(compiler, smaller, larger) / emit_word_equal(compiler)
-- emit_equal_fast_path(compiler) — равные слова без rt_equal
-- emit_checked_word(compiler, kind) — ADD/SUB с проверкой переполнения
-- string_find(compiler, text) -> Symbol; string_label(compiler, text) -> метка
-- emit_string_data(compiler, text) — байты строки в .data-тексте
-- emit_string_join(compiler) — rt_string_add для "{…}"
-- load_number / load_number_into(compiler, [register,] number) — число с тегом
-- load_simple(compiler, node, register) / load_fixed_literal(compiler, value)
-- store_local(compiler, name, value) — запись в слот и вывод типа
-- store_box(compiler, field_ids, type_number) — rt_alloc Box из значений на стеке

use core.str
use core.group
use core.num
use selfhost.abi
use selfhost.ast
use selfhost.compiler.state
use selfhost.compiler.constants
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.machine.word
use selfhost.compiler.codegen.lookup

skill negative_literal(node) {
    @plain = ast.plain(node)
    (group.get(plain, 0) == "binary") {
        (group.get(plain, 1) == "-") {
            @left = ast.plain(group.get(plain, 2))
            @right = ast.plain(group.get(plain, 3))
            (group.get(left, 0) == "number") {
                (group.get(left, 1) == 0) { out group.get(right, 0) == "number" }
            }
        }
    }
    out no
}

skill constant_literal(node) {
    @tag = ast.tag(node)
    (tag == "number") { out yes }
    (negative_literal(node) == yes) { out yes }
    (tag == "answer") { out yes }
    (tag == "none") { out yes }
    out no
}

skill emit_field_get(compiler, name) {
    @field = state.symbol_find(compiler.fields, name)
    compiler = state.load_immediate(compiler, "a1", registers.A1, field.value)
    compiler = state.load_immediate(compiler, "a2", registers.A2, field.slot)
    compiler.machine = layout.emit_call(compiler.machine, "rt_box_get")
    out compiler
}

skill emit_field_set(compiler, name) {
    @field = state.symbol_find(compiler.fields, name)
    compiler = state.load_immediate(compiler, "a1", registers.A1, field.value)
    compiler = state.load_immediate(compiler, "a3", registers.A3, field.slot)
    compiler.machine = layout.emit_call(compiler.machine, "rt_box_set")
    out compiler
}

skill emit_word_result(compiler) {
    out state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
}

skill emit_answer_from_bit(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A0, registers.ZERO, abi.NO)
    out emit_word_result(compiler)
}

skill emit_number_less(compiler, smaller, larger) {
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = state.emit_op(compiler, instruction.Kind.SLT, registers.A0, smaller, larger, 0)
    out emit_answer_from_bit(compiler)
}

skill emit_word_equal(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.SUB, registers.A0, registers.A0, registers.A1, 0)
    compiler = state.emit_op(compiler, instruction.Kind.SLTIU, registers.A0, registers.A0, registers.ZERO, 1)
    out emit_answer_from_bit(compiler)
}

skill emit_equal_fast_path(compiler) {
    @slow = state.label(compiler, "equal_slow")
    @done = state.label(compiler, "equal_done")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.A0, registers.A1, slow)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.YES)
    compiler = emit_word_result(compiler)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, done)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, slow)
    compiler.machine = layout.emit_call(compiler.machine, "rt_equal")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, done)
    out compiler
}

skill immediate_operand(compiler, node) {
    @tag = ast.tag(node)
    (constant_literal(node) == yes) { out yes }
    (tag == "enum-value") { out yes }
    (tag == "path") {
        @parts = ast.plain(node)
        @count = group.count(parts)
        (count > 2) {
            (str.len(lookup.resolve_symbol(compiler, compiler.enums, ast.path_prefix(parts))) > 0) { out yes }
        }
        (state.symbol_has(compiler.current_function.slots, group.get(parts, 1)) == no) {
            @constant_name = lookup.resolve_symbol(compiler, compiler.constants, ast.path_text(parts))
            @constant = state.symbol_find(compiler.constants, constant_name)
            (str.len(constant.name) > 0) { out constant_literal(constant.node) }
        }
    }
    out no
}

skill string_find(compiler, text) {
    @count = group.count(compiler.strings)
    drum (count) {
        @item = group.get(compiler.strings, count - 1 - beat)
        (item.text == text) { out item }
    }
    out state.Symbol {}
}

skill emit_string_data(compiler, text) {
    @line = "  .byte "
    @line_bytes = 0
    @length = str.len(text)
    @total = length + 1
    drum (total) {
        @value = 0
        (beat < length) { value = str.byte(text, beat) }
        (line_bytes > 0) { line = "{line}, " }
        line = str.add(line, num.text(value))
        line_bytes = line_bytes + 1

        @flush = line_bytes == constants.STRING_DATA_LINE_BYTES
        (beat + 1 == total) { flush = yes }
        (flush == yes) {
            compiler = state.emit_data(compiler, line)
            line = "  .byte "
            line_bytes = 0
        }
    }
    out compiler
}

skill string_label(compiler, text) {
    @known = string_find(compiler, text)
    (str.len(known.name) > 0) { out known.name }
    @label = state.label(compiler, "string")
    @length = str.len(text)
    @payload_bytes = constants.string_storage_bytes(length)
    compiler = state.emit_data(compiler, "{label}:")
    compiler = state.emit_data(compiler, "  .word {abi.OBJECT_KIND_STRING}")
    compiler = state.emit_data(compiler, "  .word {payload_bytes}")
    compiler = state.emit_data(compiler, "  .word {abi.OBJECT_FLAG_STATIC}")
    compiler = state.emit_data(compiler, "  .word {length}")
    compiler = emit_string_data(compiler, text)
    compiler = state.emit_data(compiler, "  .balign {constants.DATA_ALIGNMENT}")
    compiler.machine = layout.align_section(compiler.machine, layout.Section.RODATA, constants.DATA_ALIGNMENT)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.RODATA, label)
    compiler.machine = layout.append_section_word(compiler.machine, layout.Section.RODATA, layout.address_from_number(abi.OBJECT_KIND_STRING))
    compiler.machine = layout.append_section_word(compiler.machine, layout.Section.RODATA, layout.address_from_number(payload_bytes))
    compiler.machine = layout.append_section_word(compiler.machine, layout.Section.RODATA, layout.address_from_number(abi.OBJECT_FLAG_STATIC))
    compiler.machine = layout.append_section_word(compiler.machine, layout.Section.RODATA, layout.address_from_number(length))
    compiler.machine = layout.append_section_text(compiler.machine, layout.Section.RODATA, text, yes)
    compiler.machine = layout.align_section(compiler.machine, layout.Section.RODATA, constants.DATA_ALIGNMENT)
    compiler.strings = group.add(compiler.strings, state.Symbol { name = label, kind = "string", text = text })
    out label
}

skill emit_string_join(compiler) {
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.A0, registers.ZERO, 0)
    compiler = state.pop(compiler, "a0", registers.A0)
    compiler.machine = layout.emit_call(compiler.machine, "rt_string_add")
    out state.push(compiler, "a0", registers.A0)
}

skill load_number(compiler, number) {
    out load_number_into(compiler, registers.A0, number)
}

skill load_number_into(compiler, register, number) {
    (number > -257) {
        (number < 256) {
            compiler.machine = layout.emit_load_immediate(compiler.machine, register, abi.tagged(number, abi.TAG_NUMBER))
            out compiler
        }
    }
    @tagged = word.add_number(word.shift_left(word.from_signed(number), abi.TAG_SHIFT), abi.TAG_NUMBER)
    compiler.machine = layout.emit_load_word(compiler.machine, register, tagged)
    out compiler
}

skill simple_operand(compiler, node) {
    @parts = ast.plain(node)
    (group.get(parts, 0) == "number") { out yes }
    (group.get(parts, 0) == "path") {
        (group.count(parts) == 2) { out state.symbol_has(compiler.current_function.slots, group.get(parts, 1)) }
    }
    out no
}

skill load_simple(compiler, node, register) {
    @parts = ast.plain(node)
    (group.get(parts, 0) == "number") { out load_number_into(compiler, register, group.get(parts, 1)) }
    out state.emit_op(compiler, instruction.Kind.LW, register, registers.S0, registers.ZERO, state.slot(compiler, group.get(parts, 1)))
}

skill store_local(compiler, name, value) {
    @slot = state.slot(compiler, name)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.S0, registers.A0, slot)
    @type = lookup.infer_type(compiler, value)
    @known = state.type_find(compiler.current_function.types, name)
    (type == "unknown") {
        (str.len(known.name) == 0) { compiler.current_function.types = state.type_set(compiler.current_function.types, name, type) }
    }
    (type == "unknown") { out compiler }
    compiler.current_function.types = state.type_set(compiler.current_function.types, name, type)
    out compiler
}

skill fixed_literal(value) {
    @plain = ast.plain(value)
    @tag = group.get(plain, 0)
    (tag == "number") { out yes }
    (tag == "wide-number") { out yes }
    (tag == "binary") {
        (group.get(plain, 1) == "-") {
            @left = ast.plain(group.get(plain, 2))
            @right_tag = group.get(ast.plain(group.get(plain, 3)), 0)
            (group.get(left, 0) == "number") {
                (group.get(left, 1) == 0) {
                    (right_tag == "number") { out yes }
                    (right_tag == "wide-number") { out yes }
                }
            }
        }
    }
    out no
}

skill load_fixed_literal(compiler, value) {
    @plain = ast.plain(value)
    @tag = group.get(plain, 0)
    (tag == "wide-number") {
        compiler.machine = layout.emit_load_word(compiler.machine, registers.A0, word.from_decimal(group.get(plain, 1)))
        out compiler
    }
    (tag == "number") { out state.load_immediate(compiler, "a0", registers.A0, group.get(plain, 1)) }
    @right = ast.plain(group.get(plain, 3))
    (group.get(right, 0) == "number") { out state.load_immediate(compiler, "a0", registers.A0, 0 - group.get(right, 1)) }
    @wide = str.add("-", group.get(right, 1))
    compiler.machine = layout.emit_load_word(compiler.machine, registers.A0, word.from_decimal(wide))
    out compiler
}

skill store_box(compiler, field_ids, type_number) {
    @count = group.count(field_ids)
    compiler = state.load_immediate(compiler, "a0", registers.A0, constants.box_storage_bytes(count + 1))
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_BOX)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, count + 1)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_PAYLOAD_OFFSET + constants.BOX_COUNT_OFFSET)
    drum (count) {
        compiler = state.load_immediate(compiler, "t0", registers.T0, group.get(field_ids, beat))
        compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.box_field_id_offset(beat))
        compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, constants.stack_source_offset(count, beat))
        compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.box_field_value_offset(beat))
    }
    compiler = state.load_immediate(compiler, "t0", registers.T0, constants.BOX_TYPE_FIELD_ID)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.box_field_id_offset(count))
    compiler = state.load_immediate(compiler, "t0", registers.T0, abi.tagged(type_number, abi.TAG_NUMBER))
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.box_field_value_offset(count))
    (count > 0) {
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, constants.stack_bytes(count))
    }
    out state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_BOX)
}

skill emit_checked_word(compiler, kind) {
    compiler = state.emit_op(compiler, kind, registers.T0, registers.A0, registers.A1, 0)
    pick {
        (kind == instruction.Kind.ADD) { compiler = state.emit_op(compiler, instruction.Kind.SLT, registers.T1, registers.T0, registers.A0, 0) }
        { compiler = state.emit_op(compiler, instruction.Kind.SLT, registers.T1, registers.A0, registers.T0, 0) }
    }
    compiler = state.emit_op(compiler, instruction.Kind.SLTI, registers.T2, registers.A1, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.T0, registers.ZERO, 0)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.BEQ, registers.ZERO, registers.T1, registers.T2, 8)
    out state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_NUMBER_OVERFLOW)
}
