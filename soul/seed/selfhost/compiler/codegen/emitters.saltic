-- emitters — мелкие кусочки кода для codegen: литералы, поля Box, сравнения,
-- строки в rodata, локальные переменные, быстрые пути.
-- Каждый навык берёт и отдаёт compiler; команды — методами compiler.executor
-- (договор backend); значение — в VALUE, ERROR = CALL_NO_ERROR после
-- emit_word_result. Строки складываются в rodata один раз (string_find).
--
-- negative_literal / constant_literal / fixed_literal(node) -> yes/no — узел
--     есть константа (число, -число, answer, none; fixed — и wide-number)
-- immediate_operand / simple_operand(compiler, node) -> yes/no
-- emit_field_get / emit_field_set(compiler, name) — rt_box_get / rt_box_set; после
--     чтения ошибка (EmptyTouched, MissingField) уходит в failure навыка
-- emit_word_result(compiler) — ERROR = CALL_NO_ERROR
-- emit_answer_from_bit(compiler) — бит в VALUE → yes/no
-- emit_number_less(compiler, smaller, larger) / emit_word_equal(compiler) — роли
-- emit_number_not_less(compiler, smaller, larger) — «не меньше» для >= и <=
-- flip_answer(compiler) — yes ↔ no в VALUE (после rt_fixed_less / greater)
-- pack_call(compiler, stored) — rt_fixed_pack фиксированного в VALUE (проверку ошибки
--     ставит codegen); load_fraction(compiler, text) — слово литерала (abi.fraction);
--     fraction_binary(compiler, operator) — rt_fraction_* над VALUE и ERROR;
--     fraction_pair(compiler, left, right) -> yes, если хоть один операнд дробный;
--     negate(compiler, type) — унарный минус над VALUE: число, дробное, фиксированный (Q-025)
-- emit_equal_fast_path(compiler) — равные слова без вызова, иначе rt_value_equal
-- jump_unless_yes(compiler, label) — переход, если VALUE — no, none или 0
-- string_find(compiler, text) -> Symbol; string_label(compiler, text) -> метка
-- emit_string_join(compiler) — rt_string_add для "{…}"
-- load_number / load_number_into(compiler, [role,] number) — число с тегом
-- load_simple(compiler, node, role) / load_fixed_literal(compiler, value)
-- store_local(compiler, name, value) — запись в слот и вывод типа
-- store_box(compiler, field_ids, type_number) — rt_alloc Box из значений на стеке

use core.str
use core.group
use core.num
use selfhost.abi
use selfhost.ast
use selfhost.compiler.state
use selfhost.compiler.constants
use selfhost.compiler.backend
use selfhost.machine.word
use selfhost.machine.wide
use selfhost.abi.fraction
use selfhost.intrinsic.contract
use selfhost.compiler.codegen.lookup

skill negative_literal(node) {
    @plain = ast.plain(node)
    (group.get(plain, 0) == "binary") {
        (group.get(plain, 1) == "-") {
            @left = ast.plain(group.get(plain, 2))
            @right = ast.plain(group.get(plain, 3))
            (group.get(left, 0) == "number") {
                (group.get(left, 1) == 0) { out group.get(right, 0) == "number" }
            }
        }
    }
    out no
}

skill constant_literal(node) {
    @tag = ast.tag(node)
    (tag == "number") { out yes }
    (negative_literal(node) == yes) { out yes }
    (tag == "answer") { out yes }
    (tag == "none") { out yes }
    out no
}

skill emit_field_get(compiler, name) {
    @executor = compiler.executor
    @field = state.symbol_find(compiler.fields, name)
    compiler = executor.load_immediate(compiler, backend.ERROR, field.value)
    compiler = executor.load_immediate(compiler, backend.ARG2, field.slot)
    compiler = executor.call(compiler, "rt_box_get")
    (str.bytes(compiler.current_function.failure) == 0) { out compiler }
    out executor.jump_if_nonzero(compiler, backend.ERROR, compiler.current_function.failure)
}

skill emit_field_set(compiler, name) {
    @executor = compiler.executor
    @field = state.symbol_find(compiler.fields, name)
    compiler = executor.load_immediate(compiler, backend.ERROR, field.value)
    compiler = executor.load_immediate(compiler, backend.ARG3, field.slot)
    compiler = executor.call(compiler, "rt_box_set")
    (str.bytes(compiler.current_function.failure) == 0) { out compiler }
    out executor.jump_if_nonzero(compiler, backend.ERROR, compiler.current_function.failure)
}

skill emit_word_result(compiler) {
    @executor = compiler.executor
    out executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
}

skill emit_answer_from_bit(compiler) {
    @executor = compiler.executor
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.VALUE, abi.NO)
    out emit_word_result(compiler)
}

skill emit_number_less(compiler, smaller, larger) {
    @executor = compiler.executor
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.set_less(compiler, backend.VALUE, smaller, larger)
    out emit_answer_from_bit(compiler)
}

skill emit_number_not_less(compiler, smaller, larger) {
    @executor = compiler.executor
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.set_less(compiler, backend.VALUE, smaller, larger)
    compiler = executor.xor_immediate(compiler, backend.VALUE, backend.VALUE, 1)
    out emit_answer_from_bit(compiler)
}

skill pack_call(compiler, stored) {
    @executor = compiler.executor
    compiler = executor.load_immediate(compiler, backend.FIXED_SOURCE_KIND, contract.fixed_kind(lookup.infer_type(compiler, stored)))
    out executor.call(compiler, "rt_fixed_pack")
}

skill load_fraction(compiler, text) {
    @executor = compiler.executor
    out executor.load_wide(compiler, backend.VALUE, fraction.word(text))
}

skill negate(compiler, type) {
    @executor = compiler.executor
    compiler = executor.move(compiler, backend.ERROR, backend.VALUE)
    (type == "fraction") { out executor.call(load_fraction(compiler, "0.0"), "rt_fraction_sub") }
    (contract.is_fixed_type(type) == yes) {
        compiler = executor.load_immediate(compiler, backend.VALUE, 0)
        compiler = executor.load_immediate(compiler, backend.FIXED_SOURCE_KIND, contract.fixed_kind(type))
        out executor.call(compiler, "rt_fixed_sub")
    }
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    out executor.sub_checked(compiler)
}

skill fraction_pair(compiler, left, right) {
    (lookup.infer_type(compiler, left) == "fraction") { out yes }
    out lookup.infer_type(compiler, right) == "fraction"
}

skill fraction_binary(compiler, operator) {
    @executor = compiler.executor
    @target = "rt_fraction_near"
    (operator == "+") { target = "rt_fraction_add" }
    (operator == "-") { target = "rt_fraction_sub" }
    (operator == "*") { target = "rt_fraction_mul" }
    (operator == "/") { target = "rt_fraction_div" }
    (operator == "<") { target = "rt_fraction_less" }
    (operator == ">") { target = "rt_fraction_greater" }
    (operator == ">=") { target = "rt_fraction_less" }
    (operator == "<=") { target = "rt_fraction_greater" }
    compiler = executor.call(compiler, target)
    (operator == ">=") { out flip_answer(compiler) }
    (operator == "<=") { out flip_answer(compiler) }
    out compiler
}

skill flip_answer(compiler) {
    @executor = compiler.executor
    out executor.xor_immediate(compiler, backend.VALUE, backend.VALUE, abi.YES - abi.NO)
}

skill emit_word_equal(compiler) {
    @executor = compiler.executor
    compiler = executor.sub(compiler, backend.VALUE, backend.VALUE, backend.ERROR)
    compiler = executor.set_zero(compiler, backend.VALUE, backend.VALUE)
    out emit_answer_from_bit(compiler)
}

skill emit_equal_fast_path(compiler) {
    @executor = compiler.executor
    @slow = state.label(compiler, "equal_slow")
    @done = state.label(compiler, "equal_done")
    compiler = executor.branch_not_equal(compiler, backend.VALUE, backend.ERROR, slow)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.YES)
    compiler = emit_word_result(compiler)
    compiler = executor.jump(compiler, done)
    compiler = executor.label(compiler, slow)
    compiler = executor.call(compiler, "rt_value_equal")
    compiler = executor.label(compiler, done)
    out compiler
}

skill jump_unless_yes(compiler, name) {
    @executor = compiler.executor
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.NO)
    compiler = executor.jump_if_equal(compiler, backend.VALUE, backend.SCRATCH0, name)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.NONE)
    compiler = executor.jump_if_equal(compiler, backend.VALUE, backend.SCRATCH0, name)
    out executor.jump_if_zero(compiler, backend.VALUE, name)
}

skill immediate_operand(compiler, node) {
    @tag = ast.tag(node)
    (constant_literal(node) == yes) { out yes }
    (tag == "enum-value") { out yes }
    (tag == "path") {
        @parts = ast.plain(node)
        @count = group.count(parts)
        (count > 2) {
            (str.bytes(lookup.resolve_symbol(compiler, compiler.enums, ast.path_prefix(parts))) > 0) { out yes }
        }
        (state.symbol_has(compiler.current_function.slots, group.get(parts, 1)) == no) {
            @constant_name = lookup.resolve_symbol(compiler, compiler.constants, ast.path_text(parts))
            @constant = state.symbol_find(compiler.constants, constant_name)
            (str.bytes(constant.name) > 0) { out constant_literal(constant.node) }
        }
    }
    out no
}

skill string_find(compiler, text) {
    @count = group.count(compiler.strings)
    drum (count) {
        @item = group.get(compiler.strings, count - 1 - beat)
        (item.text == text) { out item }
    }
    out state.Symbol {}
}

skill string_label(compiler, text) {
    @known = string_find(compiler, text)
    (str.bytes(known.name) > 0) { out known.name }
    @label = state.label(compiler, "string")
    @length = str.bytes(text)
    @payload_bytes = constants.string_storage_bytes(compiler.words, length)
    @executor = compiler.executor
    compiler = executor.align(compiler, backend.RODATA, constants.DATA_ALIGNMENT)
    compiler = executor.data_label(compiler, backend.RODATA, label)
    compiler = constants.emit_static_header(compiler, backend.RODATA, abi.OBJECT_KIND_STRING, payload_bytes)
    compiler = executor.data_word(compiler, backend.RODATA, word.from_number(length))
    compiler = executor.data_text(compiler, backend.RODATA, text)
    compiler = executor.align(compiler, backend.RODATA, constants.DATA_ALIGNMENT)
    compiler.strings = group.add(compiler.strings, state.Symbol { name = label, kind = "string", text = text })
    out label
}

skill emit_string_join(compiler) {
    @executor = compiler.executor
    compiler = executor.move(compiler, backend.ERROR, backend.VALUE)
    compiler = executor.pop(compiler, backend.VALUE)
    compiler = executor.call(compiler, "rt_string_add")
    out executor.push(compiler, backend.VALUE)
}

skill load_wide_number(compiler, text) {
    @tagged = wide.shift_left(wide.from_decimal(text), abi.TAG_SHIFT)
    @executor = compiler.executor
    out executor.load_wide(compiler, backend.VALUE, tagged)
}

skill load_number(compiler, number) {
    out load_number_into(compiler, backend.VALUE, number)
}

skill load_number_into(compiler, role, number) {
    @executor = compiler.executor
    (number > -257) {
        (number < 256) { out executor.load_immediate(compiler, role, abi.tagged(number, abi.TAG_NUMBER)) }
    }
    @tagged = word.add_number(word.shift_left(word.from_signed(number), abi.TAG_SHIFT), abi.TAG_NUMBER)
    out executor.load_word(compiler, role, tagged)
}

skill simple_operand(compiler, node) {
    @parts = ast.plain(node)
    (group.get(parts, 0) == "number") { out yes }
    (group.get(parts, 0) == "path") {
        (group.count(parts) == 2) { out state.symbol_has(compiler.current_function.slots, group.get(parts, 1)) }
    }
    out no
}

skill load_simple(compiler, node, role) {
    @parts = ast.plain(node)
    (group.get(parts, 0) == "number") { out load_number_into(compiler, role, group.get(parts, 1)) }
    @executor = compiler.executor
    out executor.load(compiler, role, backend.FRAME, state.slot(compiler, group.get(parts, 1)))
}

skill store_local(compiler, name, value) {
    @executor = compiler.executor
    @slot = state.slot(compiler, name)
    compiler = executor.store(compiler, backend.VALUE, backend.FRAME, slot)
    @type = lookup.infer_type(compiler, value)
    @known = state.type_find(compiler.current_function.types, name)
    (type == "unknown") {
        (str.bytes(known.name) == 0) { compiler.current_function.types = state.type_set(compiler.current_function.types, name, type) }
    }
    (type == "unknown") { out compiler }
    compiler.current_function.types = state.type_set(compiler.current_function.types, name, type)
    out compiler
}

skill fixed_literal(value) {
    @plain = ast.plain(value)
    @tag = group.get(plain, 0)
    (tag == "number") { out yes }
    (tag == "wide-number") { out yes }
    (tag == "binary") {
        (group.get(plain, 1) == "-") {
            @left = ast.plain(group.get(plain, 2))
            @right_tag = group.get(ast.plain(group.get(plain, 3)), 0)
            (group.get(left, 0) == "number") {
                (group.get(left, 1) == 0) {
                    (right_tag == "number") { out yes }
                    (right_tag == "wide-number") { out yes }
                }
            }
        }
    }
    out no
}

skill load_fixed_literal(compiler, value) {
    @executor = compiler.executor
    @plain = ast.plain(value)
    @tag = group.get(plain, 0)
    (tag == "wide-number") {
        @text = group.get(plain, 1)
        (compiler.words.bytes == 8) {
            (str.starts_with(text, "-") == no) { out executor.load_wide(compiler, backend.VALUE, wide.from_decimal(text)) }
        }
        out executor.load_word(compiler, backend.VALUE, word.from_decimal(text))
    }
    (tag == "number") { out executor.load_immediate(compiler, backend.VALUE, group.get(plain, 1)) }
    @right = ast.plain(group.get(plain, 3))
    (group.get(right, 0) == "number") { out executor.load_immediate(compiler, backend.VALUE, 0 - group.get(right, 1)) }
    @negative_text = str.concat("-", group.get(right, 1))
    out executor.load_word(compiler, backend.VALUE, word.from_decimal(negative_text))
}

skill store_box(compiler, field_ids, type_number) {
    @executor = compiler.executor
    @words = compiler.words
    @count = group.count(field_ids)
    compiler = executor.load_immediate(compiler, backend.VALUE, constants.box_storage_bytes(compiler.words, count + 1))
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, abi.OBJECT_KIND_BOX)
    compiler = executor.store32(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, count + 1)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.VALUE, words.payload + constants.BOX_COUNT_OFFSET)
    drum (count) {
        compiler = executor.load_immediate(compiler, backend.SCRATCH0, group.get(field_ids, beat))
        compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload + constants.box_field_id_offset(compiler.words, beat))
        compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, constants.stack_source_offset(compiler.words, count, beat))
        compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload + constants.box_field_value_offset(compiler.words, beat))
    }
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, constants.BOX_TYPE_FIELD_ID)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload + constants.box_field_id_offset(compiler.words, count))
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.tagged(type_number, abi.TAG_NUMBER))
    compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload + constants.box_field_value_offset(compiler.words, count))
    (count > 0) {
        compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, constants.stack_bytes(compiler.words, count))
    }
    out executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_BOX)
}
