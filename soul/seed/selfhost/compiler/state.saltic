-- state — состояние компилятора: таблицы символов, текущий навык, метки,
-- сбор локальных имён, вход _start и завершение данных.
-- Таблицы (constants, boxes, skills, …) — группы Symbol, поиск с конца.
-- Слоты локальных — смещения от FRAME вниз. Команды — только через методы
-- исполнителя договора (backend) в executor; machine — его программа.
-- emit_data/emit_writable/emit_blank — пустые заглушки (текстовый вывод
-- отключён), lines/data/writable не растут.
--
-- Symbol { name, kind, node, value, text, slot } / Function { name, slots, end,
--     subject, module, types, next_drum, drum_exit, failure, next_rescue }
-- Names { names, next_drum, next_rescue } / Output { chunks }
-- State { …, executor, machine } — executor (Box исполнителя, сейчас
--     rv32i.Executor) назначает compiler при создании; machine — его программа
-- symbol_find / symbol_has / symbol_add / symbol_add_text(symbols, name, …)
-- type_find(types, name) / type_set(types, name, type)
-- output_add(output, text) / output_text(output) — накопитель текста
-- emit_data / emit_writable(compiler, line) / emit_blank(compiler) — ничего
-- safe(text) -> имя для метки; label(compiler, prefix) -> уникальная метка
-- collect_locals(params, body) -> Names; make_slots(names, first_slot) -> слоты
-- collect_expression_names / collect_statement_names / collect_block_names
-- expression_uses_beat / statement_uses_beat / block_uses_beat / items_use_beat
-- slot(compiler, name) / field(compiler, name) -> смещение / id поля
-- collect_box / collect_enum(compiler, item, module) / collect_top_level(compiler)
-- header(compiler) — программа исполнителя с входом _start, heap_size
-- start(compiler) — код _start: аргументы через rt_cstring, вызов
--     saltic_program, rt_platform_exit
-- finish_data(compiler) — выравнивание секций, saltic_arena и saltic_heap в bss
-- box_number(compiler, name) -> номер Box (с 1); dispatch_label(method) -> метка

use core.str
use core.group
use core.num
use selfhost.abi
use selfhost.ast
use selfhost.memory.model
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.machine.word

Symbol = Box {
    name = "",
    kind = "",
    node = [],
    value = 0,
    text = "",
    slot = 0
}

Function = Box {
    name = "",
    slots = [],
    end = "",
    subject = "",
    module = "",
    types = [],
    next_drum = 1,
    drum_exit = "",
    failure = "",
    next_rescue = 1
}

Names = Box {
    names = [],
    next_drum = 1,
    next_rescue = 1
}

Output = Box {
    chunks = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
}

State = Box {
    ast = [],
    lines = Output {},
    data = Output {},
    writable = Output {},
    executor = backend.unassigned(),
    machine = layout.Program {},
    heap_bytes = word.Word {},
    strings = [],
    serial = 0,
    constants = [],
    boxes = [],
    enums = [],
    variants = [],
    errors = [],
    fields = [],
    skills = [],
    natives = [],
    entry = [],
    current_function = Function {},
    next_enum_id = 1,
    next_field_id = 1,
    dispatches = []
}

skill symbol_find(symbols, name) {
    @count = group.count(symbols)
    drum (count) {
        @item = group.get(symbols, count - 1 - beat)
        (item.name == name) { out item }
    }
    out Symbol {}
}

skill symbol_has(symbols, name) {
    @item = symbol_find(symbols, name)
    out str.len(item.name) > 0
}

skill symbol_add(symbols, name, kind, node, value) {
    out group.add(symbols, Symbol { name = name, kind = kind, node = node, value = value })
}

skill symbol_add_text(symbols, name, kind, node, text) {
    out group.add(symbols, Symbol { name = name, kind = kind, node = node, text = text })
}

skill type_find(types, name) {
    out symbol_find(types, name)
}

skill type_set(types, name, type) {
    @item = symbol_find(types, name)
    (str.len(item.name) == 0) { out group.add(types, Symbol { name = name, kind = "type", text = type }) }
    item.text = type
    out types
}

skill output_add(output, text) {
    @carry = text
    @chunks = []
    @active = yes
    drum (output.chunks) {
        pick {
            (active == no) { chunks = group.add(chunks, beat) }
            (str.len(beat) == 0) {
                chunks = group.add(chunks, carry)
                active = no
            }
            {
                chunks = group.add(chunks, "")
                carry = str.add(beat, carry)
            }
        }
    }
    (active == yes) { chunks = group.add(chunks, carry) }
    out Output { chunks = chunks }
}

skill output_text(output) {
    @result = ""
    @count = group.count(output.chunks)
    drum (count) {
        @chunk = group.get(output.chunks, count - 1 - beat)
        (str.len(chunk) > 0) { result = str.add(result, chunk) }
    }
    out result
}

skill emit_data(compiler, line) {
    out compiler
}

skill emit_writable(compiler, line) {
    out compiler
}

skill emit_blank(compiler) {
    out compiler
}

skill safe(text) {
    @result = ""
    @allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    drum (str.len(text)) {
        @ch = str.get(text, beat)
        pick {
            (str.contains(allowed, ch) == yes) { result = str.add(result, ch) }
            { result = "{result}_" }
        }
    }
    out result
}

skill label(compiler, prefix) {
    @safe_prefix = safe(prefix)
    @label = ".L_{safe_prefix}_{compiler.serial}"
    compiler.serial = compiler.serial + 1
    out label
}

skill name_add(names, name) {
    (symbol_has(names.names, name) == no) { names.names = symbol_add(names.names, name, "local", [], 0) }
    out names
}

skill collect_expression_names(names, node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "binary") {
        names = collect_expression_names(names, group.get(plain, 2))
        names = collect_expression_names(names, group.get(plain, 3))
    }
    (tag == "call") {
        drum (group.count(plain) - 1) { names = collect_expression_names(names, group.get(plain, beat + 1)) }
    }
    (tag == "group") {
        drum (group.count(plain) - 1) { names = collect_expression_names(names, group.get(plain, beat + 1)) }
    }
    (tag == "box-new") {
        drum (group.count(plain) - 2) { names = collect_expression_names(names, ast.part(group.get(plain, beat + 2), 2)) }
    }
    (tag == "rescue") {
        names = name_add(names, "$rescue:{names.next_rescue}")
        names.next_rescue = names.next_rescue + 1
        names = collect_expression_names(names, group.get(plain, 1))
        names = name_add(names, group.get(plain, 2))
        names = collect_block_names(names, group.get(plain, 3))
    }
    out names
}

skill collect_statement_names(names, node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "var") {
        names = name_add(names, group.get(plain, 1))
        names = collect_expression_names(names, group.get(plain, 2))
    }
    (tag == "assign") { names = collect_expression_names(names, group.get(plain, 2)) }
    (tag == "field-assign") {
        names = collect_expression_names(names, group.get(plain, 1))
        names = collect_expression_names(names, group.get(plain, 2))
    }
    (tag == "out") { names = collect_expression_names(names, group.get(plain, 1)) }
    (tag == "expr") { names = collect_expression_names(names, group.get(plain, 1)) }
    (tag == "if") {
        names = collect_expression_names(names, group.get(plain, 1))
        names = collect_block_names(names, group.get(plain, 2))
    }
    (tag == "pick") {
        drum (group.count(plain) - 1) {
            @choice = ast.plain(group.get(plain, beat + 1))
            (group.get(choice, 0) == "if") { names = collect_statement_names(names, choice) }
            (group.get(choice, 0) == "otherwise") { names = collect_block_names(names, group.get(choice, 1)) }
        }
    }
    (tag == "switch") {
        names = collect_expression_names(names, group.get(plain, 1))
        drum (group.count(plain) - 2) { names = collect_expression_names(names, ast.part(group.get(plain, beat + 2), 2)) }
    }
    (tag == "drum") {
        @drum_number = num.text(names.next_drum)
        names.next_drum = names.next_drum + 1
        names = name_add(names, "$drum:{drum_number}")
        names = name_add(names, "$drum_source:{drum_number}")
        names = name_add(names, "$drum_index:{drum_number}")
        names = name_add(names, "$drum_saved:{drum_number}")
        names = name_add(names, ast.DRUM_BEAT)
        names = collect_expression_names(names, group.get(plain, 1))
        names = collect_block_names(names, group.get(plain, 2))
    }
    out names
}

skill collect_block_names(names, block) {
    @plain = ast.plain(block)
    drum (group.count(plain) - 1) { names = collect_statement_names(names, group.get(plain, beat + 1)) }
    out names
}

skill expression_uses_beat(node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "path") { out group.get(plain, 1) == ast.DRUM_BEAT }
    (tag == "binary") {
        (expression_uses_beat(group.get(plain, 2)) == yes) { out yes }
        out expression_uses_beat(group.get(plain, 3))
    }
    (tag == "call") { out items_use_beat(plain, 1) }
    (tag == "template") {
        drum ((group.count(plain) - 2) / 2) {
            (expression_uses_beat(group.get(plain, beat * 2 + 2)) == yes) { out yes }
        }
        out no
    }
    (tag == "group") { out items_use_beat(plain, 1) }
    (tag == "box-new") {
        drum (group.count(plain) - 2) {
            (expression_uses_beat(ast.part(group.get(plain, beat + 2), 2)) == yes) { out yes }
        }
        out no
    }
    (tag == "rescue") {
        (expression_uses_beat(group.get(plain, 1)) == yes) { out yes }
        out block_uses_beat(group.get(plain, 3))
    }
    out no
}

skill items_use_beat(plain, first) {
    drum (group.count(plain) - first) {
        (expression_uses_beat(group.get(plain, beat + first)) == yes) { out yes }
    }
    out no
}

skill statement_uses_beat(node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "var") { out expression_uses_beat(group.get(plain, 2)) }
    (tag == "assign") { out expression_uses_beat(group.get(plain, 2)) }
    (tag == "field-assign") {
        (expression_uses_beat(group.get(plain, 1)) == yes) { out yes }
        out expression_uses_beat(group.get(plain, 2))
    }
    (tag == "out") { out expression_uses_beat(group.get(plain, 1)) }
    (tag == "expr") { out expression_uses_beat(group.get(plain, 1)) }
    (tag == "if") {
        (expression_uses_beat(group.get(plain, 1)) == yes) { out yes }
        out block_uses_beat(group.get(plain, 2))
    }
    (tag == "switch") {
        (expression_uses_beat(group.get(plain, 1)) == yes) { out yes }
        drum (group.count(plain) - 2) {
            (expression_uses_beat(ast.part(group.get(plain, beat + 2), 2)) == yes) { out yes }
        }
        out no
    }
    (tag == "drum") { out expression_uses_beat(group.get(plain, 1)) }
    (tag == "pick") {
        drum (group.count(plain) - 1) {
            @choice = ast.plain(group.get(plain, beat + 1))
            (group.get(choice, 0) == "if") {
                (statement_uses_beat(choice) == yes) { out yes }
            }
            (group.get(choice, 0) == "otherwise") {
                (block_uses_beat(group.get(choice, 1)) == yes) { out yes }
            }
        }
        out no
    }
    out no
}

skill block_uses_beat(block) {
    @plain = ast.plain(block)
    drum (group.count(plain) - 1) {
        (statement_uses_beat(group.get(plain, beat + 1)) == yes) { out yes }
    }
    out no
}

skill collect_locals(params, body) {
    @names = Names {}
    drum (params) { names = name_add(names, beat) }
    out collect_block_names(names, body)
}

skill make_slots(names, first_slot) {
    @slots = []
    @slot = first_slot
    drum (names) {
        slots = symbol_add(slots, beat.name, "slot", [], slot)
        slot = slot - abi.VALUE_WORD_BYTES
    }
    out slots
}

skill slot(compiler, name) {
    @slot = symbol_find(compiler.current_function.slots, name)
    out slot.value
}

skill field(compiler, name) {
    @field = symbol_find(compiler.fields, name)
    out field.value
}

skill collect_box(compiler, item, module) {
    @name = ast.qualified(module, ast.part(item, 1))
    compiler.boxes = symbol_add_text(compiler.boxes, name, "box", item, module)
    @slot = 0
    drum (group.count(ast.plain(item)) - 2) {
        @member = ast.part(item, beat + 2)
        (ast.tag(member) == "field") {
            @field_name = ast.part(member, 1)
            (symbol_has(compiler.fields, field_name) == no) {
                compiler.fields = group.add(compiler.fields, Symbol { name = field_name, kind = "field", node = member, value = compiler.next_field_id, slot = slot })
                compiler.next_field_id = compiler.next_field_id + 1
            }
            slot = slot + 1
        }
    }
    out compiler
}

skill collect_enum(compiler, item, module) {
    @name = ast.qualified(module, ast.part(item, 1))
    compiler.enums = symbol_add_text(compiler.enums, name, "enum", item, module)
    drum (group.count(ast.plain(item)) - 2) {
        @variant = ast.part(item, beat + 2)
        @full_name = "{name}."
        full_name = str.add(full_name, variant)
        @value = abi.tagged(compiler.next_enum_id, abi.TAG_ENUM)
        compiler.variants = symbol_add(compiler.variants, full_name, "variant", item, value)
        (symbol_has(compiler.variants, variant) == no) { compiler.variants = symbol_add(compiler.variants, variant, "variant", item, value) }
        compiler.next_enum_id = compiler.next_enum_id + 1
    }
    out compiler
}

skill collect_top_level(compiler) {
    drum (group.count(compiler.ast) - 1) {
        @item = group.get(compiler.ast, beat + 1)
        @tag = ast.tag(item)
        @module = ast.module_name(item)
        (tag == "const") { compiler.constants = symbol_add_text(compiler.constants, ast.qualified(module, ast.part(item, 1)), "const", ast.part(item, 2), module) }
        (tag == "box") { compiler = collect_box(compiler, item, module) }
        (tag == "enum") { compiler = collect_enum(compiler, item, module) }
        (tag == "skill") { compiler.skills = symbol_add_text(compiler.skills, ast.qualified(module, ast.part(item, 1)), "skill", item, module) }
        (tag == "native") { compiler.natives = symbol_add_text(compiler.natives, ast.qualified(module, ast.part(item, 1)), "native", item, module) }
        (tag == "entry") { compiler.entry = item }
    }
    out compiler
}

skill header(compiler) {
    @executor = compiler.executor
    (word.is_zero(compiler.heap_bytes) == yes) {
        compiler.heap_bytes = word.from_number(model.DEFAULT_HEAP_BYTES)
    }
    compiler = executor.new_program(compiler, "_start")
    compiler = executor.heap_size(compiler, compiler.heap_bytes)
    compiler = emit_blank(compiler)
    out compiler
}

skill start(compiler) {
    @executor = compiler.executor
    @params = ast.part(compiler.entry, 1)
    @param_count = group.count(params)
    compiler = executor.label(compiler, "_start")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, 0)
    compiler = executor.load_address(compiler, backend.HEAP_TOP, "saltic_heap", 0)
    compiler = executor.load_word(compiler, backend.ESCAPE_BOTTOM, compiler.heap_bytes)
    compiler = executor.add(compiler, backend.ESCAPE_BOTTOM, backend.HEAP_TOP, backend.ESCAPE_BOTTOM)
    compiler = executor.load_immediate(compiler, backend.FRAME, 0)
    compiler = executor.move(compiler, backend.REGION_MARK, backend.HEAP_TOP)
    compiler = executor.move(compiler, backend.ESCAPE_MARK, backend.ESCAPE_BOTTOM)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, param_count + 1)
    compiler = executor.branch_greater_equal(compiler, backend.VALUE, backend.SCRATCH0, ".L_start_args_ready")
    compiler = executor.jump_far(compiler, "rt_missing_args")
    compiler = executor.label(compiler, ".L_start_args_ready")
    drum (param_count) {
        compiler = executor.load(compiler, backend.VALUE, backend.STACK, (2 * beat + 2) * abi.VALUE_WORD_BYTES)
        compiler = executor.call(compiler, "rt_cstring")
        compiler = executor.push(compiler, backend.VALUE)
    }
    drum (param_count) {
        compiler = executor.load(compiler, backend.argument(beat), backend.STACK, (param_count - beat - 1) * abi.VALUE_WORD_BYTES)
    }
    (param_count > 0) {
        compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, param_count * abi.VALUE_WORD_BYTES)
    }
    compiler = executor.call(compiler, "saltic_program")
    compiler = executor.set_nonzero(compiler, backend.VALUE, backend.ERROR)
    compiler = executor.call(compiler, "rt_platform_exit")
    compiler = emit_blank(compiler)
    out compiler
}

skill finish_data(compiler) {
    @executor = compiler.executor
    (word.is_zero(compiler.heap_bytes) == yes) {
        compiler.heap_bytes = word.from_number(model.DEFAULT_HEAP_BYTES)
    }
    compiler = executor.heap_size(compiler, compiler.heap_bytes)
    compiler.lines = output_add(compiler.lines, output_text(compiler.writable))
    compiler.lines = output_add(compiler.lines, output_text(compiler.data))
    compiler = executor.align(compiler, backend.DATA, abi.OBJECT_ALIGNMENT)
    compiler = executor.align(compiler, backend.RODATA, abi.OBJECT_ALIGNMENT)
    compiler = executor.align(compiler, backend.BSS, model.ARENA_ALIGNMENT)
    compiler = executor.data_label(compiler, backend.BSS, "saltic_arena")
    compiler = executor.reserve(compiler, word.from_number(model.ARENA_BYTES))
    compiler = executor.align(compiler, backend.BSS, abi.OBJECT_ALIGNMENT)
    compiler = executor.data_label(compiler, backend.BSS, "saltic_heap")
    compiler = executor.reserve(compiler, compiler.heap_bytes)
    out compiler
}

skill box_number(compiler, name) {
    drum (group.count(compiler.boxes)) {
        @box = group.get(compiler.boxes, beat)
        (box.name == name) { out beat + 1 }
    }
    out 0
}

skill dispatch_label(method) {
    out str.add("rt_method_", safe(method))
}
