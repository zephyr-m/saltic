-- state — состояние компилятора: таблицы символов, текущий навык, метки,
-- сбор локальных имён, вход _start и завершение данных.
-- Таблицы (constants, boxes, skills, …) — группы Symbol, поиск с конца.
-- Слоты локальных — смещения от FRAME вниз. Команды — только через методы
-- исполнителя договора (backend) в executor; machine — его программа.
--
-- Symbol { name, kind, node, value, text, slot } / Function { name, slots, end,
--     subject, module, types, next_drum, drum_exit, failure, next_rescue, next_always }
-- Names { names, next_drum, next_rescue, next_always }
-- State { …, executor, machine, words } — words — раскладка памяти под слово
--     исполнителя (abi.shape, по умолчанию 4 байта); executor (Box исполнителя, сейчас
--     rv32i.Executor) назначает compiler при создании; machine — его программа
-- symbol_find / symbol_has / symbol_add / symbol_add_text(symbols, name, …)
-- type_find(types, name) / type_set(types, name, type)
-- safe(text) -> имя для метки; label(compiler, prefix) -> уникальная метка
-- collect_locals(params, body) -> Names; make_slots(words, names, first_slot) -> слоты
-- collect_names(names, node) -> Names: имена и служебные ячейки (drum, always, rescue)
--     по всему поддереву; обход — ast.children
-- outer_assigned(block) -> имена снаружи блока, которым блок присваивает
-- uses_beat(node) / block_uses_beat(block) -> yes/no: есть ли beat (во вложенный drum не
--     заходит — там свой beat); assigned_names(found, node) — кому присваивают
-- slot(compiler, name) / field(compiler, name) -> смещение / id поля
-- collect_box / collect_enum(compiler, item, module) / collect_top_level(compiler)
-- header(compiler) — программа исполнителя с входом _start, heap_size
-- start(compiler) — код _start: стек входа — в rt_environment_capture (envp),
--     аргументы через rt_cstring, вызов saltic_program, rt_platform_exit
-- finish_data(compiler) — выравнивание секций, saltic_arena и saltic_heap в bss
-- box_number(compiler, name) -> номер Box (с 1); dispatch_label(method) -> метка

use core.str
use core.group
use core.num
use selfhost.abi
use selfhost.abi.shape
use selfhost.ast
use selfhost.memory.model
use selfhost.compiler.backend
use selfhost.machine.word
use selfhost.machine.wide

Symbol = Box {
    name = "",
    kind = "",
    node = [],
    value = 0,
    text = "",
    slot = 0
}

Function = Box {
    name = "",
    slots = [],
    end = "",
    subject = "",
    module = "",
    types = [],
    next_drum = 1,
    drum_exit = "",
    failure = "",
    next_rescue = 1,
    next_always = 1
}

Names = Box {
    names = [],
    next_drum = 1,
    next_rescue = 1,
    next_always = 1
}

State = Box {
    ast = [],
    executor = backend.unassigned(),
    machine = backend.unassigned(),
    words = shape.Words {},
    heap_bytes = wide.Wide {},
    strings = [],
    serial = 0,
    constants = [],
    boxes = [],
    enums = [],
    variants = [],
    errors = [],
    fields = [],
    skills = [],
    natives = [],
    entry = [],
    current_function = Function {},
    next_enum_id = 1,
    next_field_id = 1,
    dispatches = []
}

skill symbol_find(symbols, name) {
    @count = group.count(symbols)
    drum (count) {
        @item = group.get(symbols, count - 1 - beat)
        (item.name == name) { out item }
    }
    out Symbol {}
}

skill symbol_has(symbols, name) {
    @item = symbol_find(symbols, name)
    out str.bytes(item.name) > 0
}

skill symbol_add(symbols, name, kind, node, value) {
    out group.add(symbols, Symbol { name = name, kind = kind, node = node, value = value })
}

skill symbol_add_text(symbols, name, kind, node, text) {
    out group.add(symbols, Symbol { name = name, kind = kind, node = node, text = text })
}

skill type_find(types, name) {
    out symbol_find(types, name)
}

skill type_set(types, name, type) {
    @item = symbol_find(types, name)
    (str.bytes(item.name) == 0) { out group.add(types, Symbol { name = name, kind = "type", text = type }) }
    item.text = type
    out types
}

skill safe(text) {
    @result = ""
    @allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    drum (str.bytes(text)) {
        @ch = str.get(text, beat)
        pick {
            (str.contains(allowed, ch) == yes) { result = str.concat(result, ch) }
            { result = "{result}_" }
        }
    }
    out result
}

skill label(compiler, prefix) {
    @safe_prefix = safe(prefix)
    @label = ".L_{safe_prefix}_{compiler.serial}"
    compiler.serial = compiler.serial + 1
    out label
}

skill name_add(names, name) {
    (symbol_has(names.names, name) == no) { names.names = symbol_add(names.names, name, "local", [], 0) }
    out names
}

skill collect_names(names, node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "rescue") {
        names = name_add(names, "$rescue:{names.next_rescue}")
        names.next_rescue = names.next_rescue + 1
        names = collect_names(names, group.get(plain, 1))
        names = name_add(names, group.get(plain, 2))
        out collect_names(names, group.get(plain, 3))
    }
    (tag == "var") { names = name_add(names, group.get(plain, 1)) }
    (tag == "always") {
        @always_number = num.text(names.next_always)
        names.next_always = names.next_always + 1
        names = name_add(names, "$always_mark:{always_number}")
        names = name_add(names, "$always_escape:{always_number}")
    }
    (tag == "drum") {
        @drum_number = num.text(names.next_drum)
        names.next_drum = names.next_drum + 1
        names = name_add(names, "$drum:{drum_number}")
        names = name_add(names, "$drum_source:{drum_number}")
        names = name_add(names, "$drum_index:{drum_number}")
        names = name_add(names, "$drum_saved:{drum_number}")
        names = name_add(names, ast.DRUM_BEAT)
    }
    drum (ast.children(node)) { names = collect_names(names, beat) }
    out names
}

skill assigned_names(found, node) {
    @plain = ast.plain(node)
    (group.get(plain, 0) == "assign") { found = name_add(found, group.get(plain, 1)) }
    drum (ast.children(node)) { found = assigned_names(found, beat) }
    out found
}

skill outer_assigned(block) {
    @declared = collect_names(Names {}, block)
    @assigned = assigned_names(Names {}, block)
    @outer = []
    drum (assigned.names) {
        (symbol_has(declared.names, beat.name) == no) { outer = group.add(outer, beat.name) }
    }
    out outer
}

skill uses_beat(node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "path") { out group.get(plain, 1) == ast.DRUM_BEAT }
    (tag == "drum") { out uses_beat(group.get(plain, 1)) }
    drum (ast.children(node)) {
        (uses_beat(beat) == yes) { out yes }
    }
    out no
}

skill block_uses_beat(block) {
    out uses_beat(block)
}

skill collect_locals(params, body) {
    @names = Names {}
    drum (params) { names = name_add(names, beat) }
    out collect_names(names, body)
}

skill make_slots(words, names, first_slot) {
    @slots = []
    @slot = first_slot
    drum (names) {
        slots = symbol_add(slots, beat.name, "slot", [], slot)
        slot = slot - words.bytes
    }
    out slots
}

skill slot(compiler, name) {
    @slot = symbol_find(compiler.current_function.slots, name)
    out slot.value
}

skill field(compiler, name) {
    @field = symbol_find(compiler.fields, name)
    out field.value
}

skill collect_box(compiler, item, module) {
    @name = ast.qualified(module, ast.part(item, 1))
    compiler.boxes = symbol_add_text(compiler.boxes, name, "box", item, module)
    @slot = 0
    drum (group.count(ast.plain(item)) - 2) {
        @member = ast.part(item, beat + 2)
        (ast.tag(member) == "field") {
            @field_name = ast.part(member, 1)
            (symbol_has(compiler.fields, field_name) == no) {
                compiler.fields = group.add(compiler.fields, Symbol { name = field_name, kind = "field", node = member, value = compiler.next_field_id, slot = slot })
                compiler.next_field_id = compiler.next_field_id + 1
            }
            slot = slot + 1
        }
    }
    out compiler
}

skill collect_enum(compiler, item, module) {
    @name = ast.qualified(module, ast.part(item, 1))
    compiler.enums = symbol_add_text(compiler.enums, name, "enum", item, module)
    drum (group.count(ast.plain(item)) - 2) {
        @variant = ast.part(item, beat + 2)
        @full_name = "{name}."
        full_name = str.concat(full_name, variant)
        @value = abi.tagged(compiler.next_enum_id, abi.TAG_ENUM)
        compiler.variants = symbol_add(compiler.variants, full_name, "variant", item, value)
        (symbol_has(compiler.variants, variant) == no) { compiler.variants = symbol_add(compiler.variants, variant, "variant", item, value) }
        compiler.next_enum_id = compiler.next_enum_id + 1
    }
    out compiler
}

skill collect_top_level(compiler) {
    drum (group.count(compiler.ast) - 1) {
        @item = group.get(compiler.ast, beat + 1)
        @tag = ast.tag(item)
        @module = ast.module_name(item)
        (tag == "const") { compiler.constants = symbol_add_text(compiler.constants, ast.qualified(module, ast.part(item, 1)), "const", ast.part(item, 2), module) }
        (tag == "box") { compiler = collect_box(compiler, item, module) }
        (tag == "enum") { compiler = collect_enum(compiler, item, module) }
        (tag == "skill") { compiler.skills = symbol_add_text(compiler.skills, ast.qualified(module, ast.part(item, 1)), "skill", item, module) }
        (tag == "native") { compiler.natives = symbol_add_text(compiler.natives, ast.qualified(module, ast.part(item, 1)), "native", item, module) }
        (tag == "entry") { compiler.entry = item }
    }
    out compiler
}

skill header(compiler) {
    @executor = compiler.executor
    (wide.is_zero(compiler.heap_bytes) == yes) { compiler.heap_bytes = wide.from_number(model.DEFAULT_HEAP_BYTES) }
    compiler = executor.new_program(compiler, "_start")
    out executor.heap_size(compiler, compiler.heap_bytes)
}

skill start(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    @params = ast.part(compiler.entry, 1)
    @param_count = group.count(params)
    compiler = executor.label(compiler, "_start")
    compiler = executor.move(compiler, backend.VALUE, backend.STACK)
    compiler = executor.call(compiler, "rt_environment_capture")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, 0)
    compiler = executor.load_address(compiler, backend.HEAP_TOP, "saltic_heap", 0)
    pick {
        (words.bytes == 8) { compiler = executor.load_wide(compiler, backend.ESCAPE_BOTTOM, compiler.heap_bytes) }
        { compiler = executor.load_word(compiler, backend.ESCAPE_BOTTOM, wide.to_word(compiler.heap_bytes)) }
    }
    compiler = executor.add(compiler, backend.ESCAPE_BOTTOM, backend.HEAP_TOP, backend.ESCAPE_BOTTOM)
    compiler = executor.load_immediate(compiler, backend.FRAME, 0)
    compiler = executor.move(compiler, backend.REGION_MARK, backend.HEAP_TOP)
    compiler = executor.move(compiler, backend.ESCAPE_MARK, backend.ESCAPE_BOTTOM)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, param_count + 1)
    compiler = executor.branch_greater_equal(compiler, backend.VALUE, backend.SCRATCH0, ".L_start_args_ready")
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.tagged(param_count, abi.TAG_NUMBER))
    compiler = executor.call(compiler, "rt_missing_args")
    compiler = executor.label(compiler, ".L_start_args_ready")
    drum (param_count) {
        compiler = executor.load(compiler, backend.VALUE, backend.STACK, (2 * beat + 2) * words.bytes)
        compiler = executor.call(compiler, "rt_cstring")
        compiler = executor.push(compiler, backend.VALUE)
    }
    drum (param_count) {
        compiler = executor.load(compiler, backend.argument(beat), backend.STACK, (param_count - beat - 1) * words.bytes)
    }
    (param_count > 0) {
        compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, param_count * words.bytes)
    }
    compiler = executor.call(compiler, "saltic_program")
    compiler = executor.branch_zero(compiler, backend.ERROR, ".L_start_done")
    compiler = executor.move(compiler, backend.VALUE, backend.ERROR)
    compiler = executor.call(compiler, "rt_start_failure")
    compiler = executor.label(compiler, ".L_start_done")
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    out executor.call(compiler, "rt_platform_exit")
}

skill finish_data(compiler) {
    @executor = compiler.executor
    (wide.is_zero(compiler.heap_bytes) == yes) { compiler.heap_bytes = wide.from_number(model.DEFAULT_HEAP_BYTES) }
    compiler = executor.heap_size(compiler, compiler.heap_bytes)
    compiler = executor.align(compiler, backend.DATA, abi.OBJECT_ALIGNMENT)
    compiler = executor.align(compiler, backend.RODATA, abi.OBJECT_ALIGNMENT)
    compiler = executor.align(compiler, backend.BSS, model.ARENA_ALIGNMENT)
    compiler = executor.data_label(compiler, backend.BSS, "saltic_arena")
    compiler = executor.reserve(compiler, wide.from_number(model.ARENA_BYTES))
    compiler = executor.align(compiler, backend.BSS, abi.OBJECT_ALIGNMENT)
    compiler = executor.data_label(compiler, backend.BSS, "saltic_heap")
    compiler = executor.reserve(compiler, compiler.heap_bytes)
    out compiler
}

skill box_number(compiler, name) {
    drum (group.count(compiler.boxes)) {
        @box = group.get(compiler.boxes, beat)
        (box.name == name) { out beat + 1 }
    }
    out 0
}

skill dispatch_label(method) {
    out str.concat("rt_method_", safe(method))
}
