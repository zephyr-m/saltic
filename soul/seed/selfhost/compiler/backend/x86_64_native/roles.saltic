-- roles — роль договора машины (backend) → регистр x86-64 или ячейка памяти.
-- Четырнадцать ролей живут в регистрах (карта REGISTER_OF_ROLE, порядок —
-- номера ролей backend), STACK — rsp, RETURN регистра не имеет (адрес
-- возврата на родном стеке), остальные (ARG4…ARG7, ESCAPE_BOTTOM) — слова
-- первой страницы кода [r14 + SLOTS + size·роль] (SLOTS = адрес загрузки; страницу
-- резервирует Executor.new_program, образ делает её записываемой; там же —
-- слова прошивки uefi). size — ширина слова: 4 в окне гостя (значение роли —
-- 32 бита, старшая половина регистра ноль, [r14 + регистр + смещение] —
-- готовый адрес гостя), 8 без окна (r14 = 0, адреса настоящие, роли 64-битные).
-- Код пишется в compiler.machine.code (buffer) командами encoder; временный
-- регистр для ролей в памяти берётся из TEMPS и сохраняется push/pop.
--
-- MEMORY — отметка «роль в памяти»; register(role) -> регистр или MEMORY
-- in_memory(role) -> yes/no; slot(role, size) -> адрес ячейки; SLOTS_BYTES — страница
-- temp(a, b, c) -> регистр из TEMPS, не равный a, b, c
-- load_form / store_form(size) -> encoder.LOAD(64) / STORE(64)
-- from_memory(op, size) / to_memory(op, size) -> форма encoder.memory: op r, [m] / op [m], r
-- cmp_memory_byte(size) — форма cmp [m], imm8 (байт дописывает вызывающий)
-- emit(compiler, code) -> compiler с новым кодом
-- move_into(code, size, register, role) — регистр = роль (mov или load из ячейки)
-- operate_from(code, size, op, register, role) — регистр = регистр op роль
-- store_into(code, size, role, register) — роль = регистр (mov или store в ячейку)
-- fetch_base(code, role) / slot_address — части адресации

use core.group
use selfhost.compiler.backend
use selfhost.compiler.backend.x86_64_native.encoder

MEMORY = -2
SLOTS = 65536
SLOTS_BYTES = 4096

REGISTER_OF_ROLE = [
    encoder.EAX, encoder.EDX, encoder.R8D, encoder.R9D,
    MEMORY, MEMORY, MEMORY, MEMORY,
    encoder.ECX, encoder.EBX, encoder.ESI, encoder.EDI, encoder.R10D,
    encoder.EBP, encoder.RSP, encoder.NONE,
    encoder.R15D, MEMORY, encoder.R12D, encoder.R13D,
    encoder.R11D
]

TEMPS = [encoder.EAX, encoder.ECX, encoder.EDX, encoder.EBX, encoder.ESI]


skill register(role) {
    out group.get(REGISTER_OF_ROLE, role)
}

skill in_memory(role) {
    (register(role) == MEMORY) { out yes }
    out no
}

skill slot(role, size) {
    out SLOTS + role * size
}

skill wide(size) {
    (size == 8) { out 1 }
    out 0
}

skill load_form(size) {
    (size == 8) { out encoder.LOAD64 }
    out encoder.LOAD
}

skill store_form(size) {
    (size == 8) { out encoder.STORE64 }
    out encoder.STORE
}

skill cmp_memory_byte(size) {
    out [0, wide(size), 0, 7, 131]
}

skill temp(a, b, c) {
    drum (TEMPS) {
        @taken = no
        (beat == a) { taken = yes }
        (beat == b) { taken = yes }
        (beat == c) { taken = yes }
        (taken == no) { out beat }
    }
    out encoder.EAX
}

skill from_memory(op, size) {
    out [0, wide(size), 0, encoder.NONE, op * 8 + 3]
}

skill to_memory(op, size) {
    out [0, wide(size), 0, encoder.NONE, op * 8 + 1]
}

skill emit(compiler, code) {
    compiler.machine.code = code
    out compiler
}

skill move_into(code, size, target, role) {
    (in_memory(role) == yes) { out encoder.memory(code, load_form(size), target, encoder.R14, encoder.NONE, slot(role, size)) }
    @source = register(role)
    (source == target) { out code }
    out encoder.operate(code, size, encoder.MOVE, target, source)
}

skill operate_from(code, size, op, target, role) {
    (in_memory(role) == yes) { out encoder.memory(code, from_memory(op, size), target, encoder.R14, encoder.NONE, slot(role, size)) }
    out encoder.operate(code, size, op, target, register(role))
}

skill store_into(code, size, role, source) {
    (in_memory(role) == yes) { out encoder.memory(code, store_form(size), source, encoder.R14, encoder.NONE, slot(role, size)) }
    @target = register(role)
    (target == source) { out code }
    out encoder.operate(code, size, encoder.MOVE, target, source)
}
