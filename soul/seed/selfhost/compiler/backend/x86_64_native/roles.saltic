-- roles — роль договора машины (backend) → регистр x86-64 или ячейка памяти.
-- Четырнадцать ролей живут в регистрах (карта REGISTER_OF_ROLE, порядок —
-- номера ролей backend), STACK — rsp, RETURN регистра не имеет (адрес
-- возврата на родном стеке), остальные (ARG4…ARG7, ESCAPE_BOTTOM) — слова
-- низкой памяти гостя [r14 + SLOTS + 4·роль]. Значение роли — 32 бита,
-- старшая половина регистра всегда ноль, поэтому [r14 + регистр + смещение]
-- — готовый адрес гостя.
-- Код пишется в compiler.machine.code (buffer) командами encoder; временный
-- регистр для ролей в памяти берётся из TEMPS и сохраняется push/pop.
--
-- MEMORY — отметка «роль в памяти»; register(role) -> регистр или MEMORY
-- in_memory(role) -> yes/no; slot(role) -> адрес ячейки в низкой памяти
-- temp(a, b, c) -> регистр из TEMPS, не равный a, b, c
-- from_memory(op) / to_memory(op) -> форма encoder.memory: op r, [m] / op [m], r
-- CMP_MEMORY_BYTE — форма cmp dword [m], imm8 (байт дописывает вызывающий)
-- emit(compiler, code) -> compiler с новым кодом
-- move_into(code, register, role) — регистр = роль (mov или load из ячейки)
-- operate_from(code, op, register, role) — регистр = регистр op роль
-- store_into(code, role, register) — роль = регистр (mov или store в ячейку)
-- fetch_base(code, role) / slot_address — части адресации

use core.group
use selfhost.compiler.backend
use selfhost.compiler.backend.x86_64_native.encoder

MEMORY = -2
SLOTS = 256

REGISTER_OF_ROLE = [
    encoder.EAX, encoder.EDX, encoder.R8D, encoder.R9D,
    MEMORY, MEMORY, MEMORY, MEMORY,
    encoder.ECX, encoder.EBX, encoder.ESI, encoder.EDI, encoder.R10D,
    encoder.EBP, encoder.RSP, encoder.NONE,
    encoder.R15D, MEMORY, encoder.R12D, encoder.R13D,
    encoder.R11D
]

TEMPS = [encoder.EAX, encoder.ECX, encoder.EDX, encoder.EBX, encoder.ESI]

CMP_MEMORY_BYTE = [0, 0, 0, 7, 131]

skill register(role) {
    out group.get(REGISTER_OF_ROLE, role)
}

skill in_memory(role) {
    (register(role) == MEMORY) { out yes }
    out no
}

skill slot(role) {
    out SLOTS + role * 4
}

skill temp(a, b, c) {
    drum (TEMPS) {
        @taken = no
        (beat == a) { taken = yes }
        (beat == b) { taken = yes }
        (beat == c) { taken = yes }
        (taken == no) { out beat }
    }
    out encoder.EAX
}

skill from_memory(op) {
    out [0, 0, 0, encoder.NONE, op * 8 + 3]
}

skill to_memory(op) {
    out [0, 0, 0, encoder.NONE, op * 8 + 1]
}

skill emit(compiler, code) {
    compiler.machine.code = code
    out compiler
}

skill move_into(code, target, role) {
    (in_memory(role) == yes) { out encoder.memory(code, encoder.LOAD, target, encoder.R14, encoder.NONE, slot(role)) }
    @source = register(role)
    (source == target) { out code }
    out encoder.operate(code, 4, encoder.MOVE, target, source)
}

skill operate_from(code, op, target, role) {
    (in_memory(role) == yes) { out encoder.memory(code, from_memory(op), target, encoder.R14, encoder.NONE, slot(role)) }
    out encoder.operate(code, 4, op, target, register(role))
}

skill store_into(code, role, source) {
    (in_memory(role) == yes) { out encoder.memory(code, encoder.STORE, source, encoder.R14, encoder.NONE, slot(role)) }
    @target = register(role)
    (target == source) { out code }
    out encoder.operate(code, 4, encoder.MOVE, target, source)
}
