-- access — память и стек договора на x86-64: load / store слов, байтов и
-- полуслов, store нуля, push / pop. Адрес гостя — [r14 + база + смещение];
-- база STACK — [rsp + смещение] без r14. Роли в памяти (roles.MEMORY) идут
-- через временный регистр с push/pop; пока временный лежит на стеке, смещения
-- от STACK увеличены на 8. load в STACK — mov esp, [m]; add rsp, r14, на
-- прошивке (firmware) в обёртке cli … sti.
--
-- load(compiler, form, to, base, offset, firmware) — form: encoder.LOAD /
--     LOAD_ZERO_BYTE / LOAD_ZERO_HALF
-- store(compiler, form, from, base, offset) — encoder.STORE / STORE_BYTE / STORE_HALF
-- store_zero(compiler, size, base, offset) — size 4 или 1
-- push(compiler, from) / pop(compiler, to) — ячейка 4 байта на стеке гостя

use selfhost.compiler.backend
use selfhost.compiler.backend.x86_64_native.encoder
use selfhost.compiler.backend.x86_64_native.roles

CELL_BYTES = 4
TEMP_BYTES = 8

skill load(compiler, form, to, base, offset, firmware) {
    @code = compiler.machine.code
    @target = roles.register(to)
    (base == backend.STACK) {
        (target == roles.MEMORY) {
            @x = roles.temp(encoder.NONE, encoder.NONE, encoder.NONE)
            code = encoder.register64(code, encoder.PUSH, x)
            code = encoder.memory(code, form, x, encoder.RSP, encoder.NONE, offset + TEMP_BYTES)
            code = roles.store_into(code, to, x)
            out roles.emit(compiler, encoder.register64(code, encoder.POP, x))
        }
        out roles.emit(compiler, encoder.memory(code, form, target, encoder.RSP, encoder.NONE, offset))
    }
    @bases = roles.register(base)
    (bases == roles.MEMORY) {
        @x = roles.temp(target, encoder.NONE, encoder.NONE)
        code = encoder.register64(code, encoder.PUSH, x)
        code = roles.move_into(code, x, base)
        pick {
            (target == roles.MEMORY) {
                code = encoder.memory(code, form, x, encoder.R14, x, offset)
                code = roles.store_into(code, to, x)
            }
            { code = encoder.memory(code, form, target, encoder.R14, x, offset) }
        }
        out roles.emit(compiler, encoder.register64(code, encoder.POP, x))
    }
    (to == backend.STACK) {
        (firmware == yes) { code = encoder.single(code, encoder.CLI) }
        code = encoder.memory(code, form, encoder.RSP, encoder.R14, bases, offset)
        code = encoder.operate(code, 8, encoder.ADD, encoder.RSP, encoder.R14)
        (firmware == yes) { code = encoder.single(code, encoder.STI) }
        out roles.emit(compiler, code)
    }
    (target == roles.MEMORY) {
        @x = roles.temp(bases, encoder.NONE, encoder.NONE)
        code = encoder.register64(code, encoder.PUSH, x)
        code = encoder.memory(code, form, x, encoder.R14, bases, offset)
        code = roles.store_into(code, to, x)
        out roles.emit(compiler, encoder.register64(code, encoder.POP, x))
    }
    out roles.emit(compiler, encoder.memory(code, form, target, encoder.R14, bases, offset))
}

skill store(compiler, form, from, base, offset) {
    @code = compiler.machine.code
    @source = roles.register(from)
    @bases = roles.register(base)
    (from == backend.STACK) {
        @x = roles.temp(bases, encoder.NONE, encoder.NONE)
        code = encoder.register64(code, encoder.PUSH, x)
        code = encoder.memory(code, encoder.ADDRESS64, x, encoder.RSP, encoder.NONE, TEMP_BYTES)
        code = encoder.operate(code, 8, encoder.SUB, x, encoder.R14)
        pick {
            (base == backend.STACK) { code = encoder.memory(code, form, x, encoder.RSP, encoder.NONE, offset + TEMP_BYTES) }
            (bases == roles.MEMORY) {
                @y = roles.temp(x, encoder.NONE, encoder.NONE)
                code = encoder.register64(code, encoder.PUSH, y)
                code = roles.move_into(code, y, base)
                code = encoder.memory(code, form, x, encoder.R14, y, offset)
                code = encoder.register64(code, encoder.POP, y)
            }
            { code = encoder.memory(code, form, x, encoder.R14, bases, offset) }
        }
        out roles.emit(compiler, encoder.register64(code, encoder.POP, x))
    }
    (base == backend.STACK) {
        (source == roles.MEMORY) {
            @x = roles.temp(encoder.NONE, encoder.NONE, encoder.NONE)
            code = encoder.register64(code, encoder.PUSH, x)
            code = roles.move_into(code, x, from)
            code = encoder.memory(code, form, x, encoder.RSP, encoder.NONE, offset + TEMP_BYTES)
            out roles.emit(compiler, encoder.register64(code, encoder.POP, x))
        }
        out roles.emit(compiler, encoder.memory(code, form, source, encoder.RSP, encoder.NONE, offset))
    }
    (bases == roles.MEMORY) {
        @x = roles.temp(source, encoder.NONE, encoder.NONE)
        code = encoder.register64(code, encoder.PUSH, x)
        code = roles.move_into(code, x, base)
        pick {
            (source == roles.MEMORY) {
                @y = roles.temp(x, encoder.NONE, encoder.NONE)
                code = encoder.register64(code, encoder.PUSH, y)
                code = roles.move_into(code, y, from)
                code = encoder.memory(code, form, y, encoder.R14, x, offset)
                code = encoder.register64(code, encoder.POP, y)
            }
            { code = encoder.memory(code, form, source, encoder.R14, x, offset) }
        }
        out roles.emit(compiler, encoder.register64(code, encoder.POP, x))
    }
    (source == roles.MEMORY) {
        @x = roles.temp(bases, encoder.NONE, encoder.NONE)
        code = encoder.register64(code, encoder.PUSH, x)
        code = roles.move_into(code, x, from)
        code = encoder.memory(code, form, x, encoder.R14, bases, offset)
        out roles.emit(compiler, encoder.register64(code, encoder.POP, x))
    }
    out roles.emit(compiler, encoder.memory(code, form, source, encoder.R14, bases, offset))
}

skill store_zero(compiler, size, base, offset) {
    @code = compiler.machine.code
    (base == backend.STACK) { out roles.emit(compiler, encoder.store_immediate(code, size, encoder.RSP, encoder.NONE, offset, 0)) }
    @bases = roles.register(base)
    (bases == roles.MEMORY) {
        @x = roles.temp(encoder.NONE, encoder.NONE, encoder.NONE)
        code = encoder.register64(code, encoder.PUSH, x)
        code = roles.move_into(code, x, base)
        code = encoder.store_immediate(code, size, encoder.R14, x, offset, 0)
        out roles.emit(compiler, encoder.register64(code, encoder.POP, x))
    }
    out roles.emit(compiler, encoder.store_immediate(code, size, encoder.R14, bases, offset, 0))
}

skill push(compiler, from) {
    @code = compiler.machine.code
    @source = roles.register(from)
    (source == roles.MEMORY) {
        @x = roles.temp(encoder.NONE, encoder.NONE, encoder.NONE)
        code = encoder.register64(code, encoder.PUSH, x)
        code = roles.move_into(code, x, from)
        code = encoder.memory(code, encoder.STORE, x, encoder.RSP, encoder.NONE, TEMP_BYTES - CELL_BYTES)
        code = encoder.register64(code, encoder.POP, x)
        out roles.emit(compiler, encoder.operate_immediate(code, 8, encoder.SUB, encoder.RSP, CELL_BYTES))
    }
    code = encoder.operate_immediate(code, 8, encoder.SUB, encoder.RSP, CELL_BYTES)
    out roles.emit(compiler, encoder.memory(code, encoder.STORE, source, encoder.RSP, encoder.NONE, 0))
}

skill pop(compiler, to) {
    @code = compiler.machine.code
    @target = roles.register(to)
    (target == roles.MEMORY) {
        @x = roles.temp(encoder.NONE, encoder.NONE, encoder.NONE)
        code = encoder.register64(code, encoder.PUSH, x)
        code = encoder.memory(code, encoder.LOAD, x, encoder.RSP, encoder.NONE, TEMP_BYTES)
        code = roles.store_into(code, to, x)
        code = encoder.register64(code, encoder.POP, x)
        out roles.emit(compiler, encoder.operate_immediate(code, 8, encoder.ADD, encoder.RSP, CELL_BYTES))
    }
    code = encoder.memory(code, encoder.LOAD, target, encoder.RSP, encoder.NONE, 0)
    out roles.emit(compiler, encoder.operate_immediate(code, 8, encoder.ADD, encoder.RSP, CELL_BYTES))
}
