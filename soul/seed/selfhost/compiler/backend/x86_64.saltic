use selfhost.compiler.backend.x86_64.translator
use selfhost.compiler.backend.x86_64.image
use selfhost.compiler.backend.x86_64.pe

skill translate(machine) {
    out translator.translate(machine)
}

skill write_uefi(path, machine) {
    @firmware = translator.translate_uefi(machine) rescue |failure| { out error.UnresolvedPatch }
    out pe.write(path, firmware)
}

skill write(path, machine) {
    @translated = translator.translate(machine) rescue |failure| { out error.UnresolvedPatch }
    out image.write(path, translated)
}
