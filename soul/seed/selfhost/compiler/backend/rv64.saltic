-- rv64 — исполнитель договора машины для RV64 (канон RVA23). Всё, что на
-- RV64 кодируется так же, как на RV32I — арифметика, сравнения, переходы,
-- вызовы, auipc + addi, lui + addi, ecall, — отдаёт исполнителю RV32I (поле
-- narrow_executor, один на сборку) на той же раскладке (rv32i.machine.layout).
-- Сам делает 64-битное: слово 8 байт (ld / sd, push / pop, data_word),
-- 32-битные поля (lwu / sw / data32), сдвиги до 63 — по форме (machine.forms);
-- общие с RV32I (addi, lui, lbu…) — через rv32i.assembler. Широкое смещение
-- (не влезает в 12 бит) — через t6, как у RV32I. 32-битная константа — lui +
-- addiw (не addi: иначе значение чуть ниже 2^31 после lui расширится знаком).
-- Раскладка памяти — abi.shape на 8 байт (WORDS). Вызов ядра — номер RV32 из
-- core.system, кроме часов: clock_gettime64 (403) на RV64 — clock_gettime 113.
--
-- Executor { far_calls, narrow_executor } — методы договора backend.saltic;
--     внутренние: narrow() -> narrow_executor (rv32i, один на сборку; far_calls
--     берёт программа), emit(compiler, encoded) — слово команды в код,
--     wide_offset(compiler, base, offset) — t6 = base + offset
-- Сверх договора RV32I: multiply / multiply_high / multiply_high_unsigned / divide / remainder /
--     divide_unsigned / remainder_unsigned(to, left, right) — M; load_wide(to,
--     wide) — константа из rodata (auipc + addi + ld); WORDS — abi.shape.of(8)

use core.group
use core.system
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.compiler.backend.rv64.machine.forms
use selfhost.compiler.backend.rv32i.assembler
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.abi.shape
use selfhost.machine.word
use selfhost.machine.wide
use selfhost.compiler.state

WORDS = shape.of(8)
WORD_BYTES = 8
WIDE_OFFSET_REGISTER = registers.T6

Executor = Box {
    far_calls = no,
    narrow_executor = rv32i.Executor {}

    skill narrow() {
        out narrow_executor
    }

    skill register(role) {
        out group.get(rv32i.REGISTER_OF_ROLE, role)
    }

    skill emit(compiler, encoded) {
        compiler.machine = layout.emit_word(compiler.machine, encoded)
        out compiler
    }

    skill wide_offset(compiler, base, offset) {
        compiler.machine = layout.emit_load_immediate(compiler.machine, WIDE_OFFSET_REGISTER, offset)
        out assembler.emit_op(compiler, instruction.Kind.ADD, WIDE_OFFSET_REGISTER, WIDE_OFFSET_REGISTER, base, 0)
    }

    skill new_program(compiler, entry) {
        @narrowed = narrow()
        compiler = narrowed.new_program(compiler, entry)
        compiler.machine.far_calls = far_calls
        compiler.words = WORDS
        out compiler
    }

    skill heap_size(compiler, bytes) {
        @base = narrow()
        out base.heap_size(compiler, bytes)
    }

    skill label(compiler, name) {
        @base = narrow()
        out base.label(compiler, name)
    }

    skill data_label(compiler, where, name) {
        @base = narrow()
        out base.data_label(compiler, where, name)
    }

    skill align(compiler, where, boundary) {
        @base = narrow()
        out base.align(compiler, where, boundary)
    }

    skill data32(compiler, where, value) {
        @base = narrow()
        out base.data_word(compiler, where, value)
    }

    skill data_word(compiler, where, value) {
        @base = narrow()
        compiler = base.data_word(compiler, where, value)
        @fill = 0
        (value.b3 > 127) { fill = 255 }
        drum (4) { compiler = base.data_byte(compiler, where, fill) }
        out compiler
    }

    skill data_byte(compiler, where, value) {
        @base = narrow()
        out base.data_byte(compiler, where, value)
    }

    skill data_text(compiler, where, text) {
        @base = narrow()
        out base.data_text(compiler, where, text)
    }

    skill reserve(compiler, bytes) {
        @base = narrow()
        out base.reserve(compiler, bytes)
    }

    skill load_immediate(compiler, to, value) {
        (assembler.fits_immediate(value) == yes) {
            out assembler.emit_op(compiler, instruction.Kind.ADDI, register(to), registers.ZERO, registers.ZERO, value)
        }
        out load_word(compiler, to, word.from_signed(value))
    }

    skill load_word(compiler, to, value) {
        compiler = assembler.emit_op(compiler, instruction.Kind.LUI, register(to), registers.ZERO, registers.ZERO, layout.address_upper(value))
        out emit(compiler, forms.addiw(register(to), register(to), layout.address_low(value)))
    }

    skill load_address(compiler, to, name, addend) {
        @base = narrow()
        out base.load_address(compiler, to, name, addend)
    }

    skill move(compiler, to, from) {
        @base = narrow()
        out base.move(compiler, to, from)
    }

    skill negate(compiler, to, from) {
        @base = narrow()
        out base.negate(compiler, to, from)
    }

    skill add_immediate(compiler, to, from, value) {
        @base = narrow()
        out base.add_immediate(compiler, to, from, value)
    }

    skill add(compiler, to, left, right) {
        @base = narrow()
        out base.add(compiler, to, left, right)
    }

    skill sub(compiler, to, left, right) {
        @base = narrow()
        out base.sub(compiler, to, left, right)
    }

    skill and(compiler, to, left, right) {
        @base = narrow()
        out base.and(compiler, to, left, right)
    }

    skill or(compiler, to, left, right) {
        @base = narrow()
        out base.or(compiler, to, left, right)
    }

    skill xor(compiler, to, left, right) {
        @base = narrow()
        out base.xor(compiler, to, left, right)
    }

    skill and_immediate(compiler, to, from, value) {
        @base = narrow()
        out base.and_immediate(compiler, to, from, value)
    }

    skill or_immediate(compiler, to, from, value) {
        @base = narrow()
        out base.or_immediate(compiler, to, from, value)
    }

    skill xor_immediate(compiler, to, from, value) {
        @base = narrow()
        out base.xor_immediate(compiler, to, from, value)
    }

    skill shift_left(compiler, to, from, count) {
        out emit(compiler, forms.slli(register(to), register(from), count))
    }

    skill shift_right_signed(compiler, to, from, count) {
        out emit(compiler, forms.srai(register(to), register(from), count))
    }

    skill shift_right_unsigned(compiler, to, from, count) {
        out emit(compiler, forms.srli(register(to), register(from), count))
    }

    skill shift_left_by(compiler, to, from, count) {
        @base = narrow()
        out base.shift_left_by(compiler, to, from, count)
    }

    skill shift_right_unsigned_by(compiler, to, from, count) {
        @base = narrow()
        out base.shift_right_unsigned_by(compiler, to, from, count)
    }

    skill set_less(compiler, to, left, right) {
        @base = narrow()
        out base.set_less(compiler, to, left, right)
    }

    skill set_less_unsigned(compiler, to, left, right) {
        @base = narrow()
        out base.set_less_unsigned(compiler, to, left, right)
    }

    skill set_less_unsigned_immediate(compiler, to, from, value) {
        @base = narrow()
        out base.set_less_unsigned_immediate(compiler, to, from, value)
    }

    skill set_zero(compiler, to, from) {
        @base = narrow()
        out base.set_zero(compiler, to, from)
    }

    skill set_nonzero(compiler, to, from) {
        @base = narrow()
        out base.set_nonzero(compiler, to, from)
    }

    skill add_checked(compiler) {
        @base = narrow()
        out base.add_checked(compiler)
    }

    skill sub_checked(compiler) {
        @base = narrow()
        out base.sub_checked(compiler)
    }

    skill load(compiler, to, base, offset) {
        (assembler.fits_immediate(offset) == no) {
            compiler = wide_offset(compiler, register(base), offset)
            out emit(compiler, forms.ld(register(to), WIDE_OFFSET_REGISTER, 0))
        }
        out emit(compiler, forms.ld(register(to), register(base), offset))
    }

    skill load32(compiler, to, base, offset) {
        (assembler.fits_immediate(offset) == no) {
            compiler = wide_offset(compiler, register(base), offset)
            out emit(compiler, forms.lwu(register(to), WIDE_OFFSET_REGISTER, 0))
        }
        out emit(compiler, forms.lwu(register(to), register(base), offset))
    }

    skill store32(compiler, from, base, offset) {
        out assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, register(base), register(from), offset)
    }

    skill load_byte(compiler, to, base, offset) {
        out assembler.emit_op(compiler, instruction.Kind.LBU, register(to), register(base), registers.ZERO, offset)
    }

    skill load_half(compiler, to, base, offset) {
        out assembler.emit_op(compiler, instruction.Kind.LHU, register(to), register(base), registers.ZERO, offset)
    }

    skill store(compiler, from, base, offset) {
        (assembler.fits_immediate(offset) == no) {
            compiler = wide_offset(compiler, register(base), offset)
            out emit(compiler, forms.sd(register(from), WIDE_OFFSET_REGISTER, 0))
        }
        out emit(compiler, forms.sd(register(from), register(base), offset))
    }

    skill store_byte(compiler, from, base, offset) {
        out assembler.emit_op(compiler, instruction.Kind.SB, registers.ZERO, register(base), register(from), offset)
    }

    skill store_half(compiler, from, base, offset) {
        out assembler.emit_op(compiler, instruction.Kind.SH, registers.ZERO, register(base), register(from), offset)
    }

    skill store_zero(compiler, base, offset) {
        (assembler.fits_immediate(offset) == no) {
            compiler = wide_offset(compiler, register(base), offset)
            out emit(compiler, forms.sd(registers.ZERO, WIDE_OFFSET_REGISTER, 0))
        }
        out emit(compiler, forms.sd(registers.ZERO, register(base), offset))
    }

    skill store_byte_zero(compiler, base, offset) {
        out assembler.emit_op(compiler, instruction.Kind.SB, registers.ZERO, register(base), registers.ZERO, offset)
    }

    skill push(compiler, from) {
        compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 0 - WORD_BYTES)
        out emit(compiler, forms.sd(register(from), registers.SP, 0))
    }

    skill pop(compiler, to) {
        compiler = emit(compiler, forms.ld(register(to), registers.SP, 0))
        out assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, WORD_BYTES)
    }

    skill branch_equal(compiler, left, right, name) {
        @base = narrow()
        out base.branch_equal(compiler, left, right, name)
    }

    skill branch_not_equal(compiler, left, right, name) {
        @base = narrow()
        out base.branch_not_equal(compiler, left, right, name)
    }

    skill branch_less(compiler, left, right, name) {
        @base = narrow()
        out base.branch_less(compiler, left, right, name)
    }

    skill branch_greater_equal(compiler, left, right, name) {
        @base = narrow()
        out base.branch_greater_equal(compiler, left, right, name)
    }

    skill branch_less_unsigned(compiler, left, right, name) {
        @base = narrow()
        out base.branch_less_unsigned(compiler, left, right, name)
    }

    skill branch_greater_equal_unsigned(compiler, left, right, name) {
        @base = narrow()
        out base.branch_greater_equal_unsigned(compiler, left, right, name)
    }

    skill branch_zero(compiler, from, name) {
        @base = narrow()
        out base.branch_zero(compiler, from, name)
    }

    skill branch_nonzero(compiler, from, name) {
        @base = narrow()
        out base.branch_nonzero(compiler, from, name)
    }

    skill branch_negative(compiler, from, name) {
        @base = narrow()
        out base.branch_negative(compiler, from, name)
    }

    skill branch_not_negative(compiler, from, name) {
        @base = narrow()
        out base.branch_not_negative(compiler, from, name)
    }

    skill branch_not_positive(compiler, from, name) {
        @base = narrow()
        out base.branch_not_positive(compiler, from, name)
    }

    skill jump(compiler, name) {
        @base = narrow()
        out base.jump(compiler, name)
    }

    skill jump_if_equal(compiler, left, right, name) {
        @base = narrow()
        out base.jump_if_equal(compiler, left, right, name)
    }

    skill jump_if_not_equal(compiler, left, right, name) {
        @base = narrow()
        out base.jump_if_not_equal(compiler, left, right, name)
    }

    skill jump_if_zero(compiler, from, name) {
        @base = narrow()
        out base.jump_if_zero(compiler, from, name)
    }

    skill jump_if_nonzero(compiler, from, name) {
        @base = narrow()
        out base.jump_if_nonzero(compiler, from, name)
    }

    skill jump_far(compiler, name) {
        @base = narrow()
        out base.jump_far(compiler, name)
    }

    skill call(compiler, name) {
        @base = narrow()
        out base.call(compiler, name)
    }

    skill ret(compiler) {
        @base = narrow()
        out base.ret(compiler)
    }

    skill syscall(compiler, number) {
        @base = narrow()
        (number == system.SYSCALL_CLOCK_GETTIME) { out base.syscall(compiler, system.SYSCALL_CLOCK_GETTIME_RV64) }
        out base.syscall(compiler, number)
    }

    skill wait(compiler) {
        @base = narrow()
        out base.wait(compiler)
    }

    skill fence(compiler) {
        @base = narrow()
        out base.fence(compiler)
    }

    skill multiply(compiler, to, left, right) {
        out emit(compiler, forms.mul(register(to), register(left), register(right)))
    }

    skill multiply_high(compiler, to, left, right) {
        out emit(compiler, forms.mulh(register(to), register(left), register(right)))
    }

    skill multiply_high_unsigned(compiler, to, left, right) {
        out emit(compiler, forms.mulhu(register(to), register(left), register(right)))
    }

    skill divide(compiler, to, left, right) {
        out emit(compiler, forms.div(register(to), register(left), register(right)))
    }

    skill remainder(compiler, to, left, right) {
        out emit(compiler, forms.rem(register(to), register(left), register(right)))
    }

    skill divide_unsigned(compiler, to, left, right) {
        out emit(compiler, forms.divu(register(to), register(left), register(right)))
    }

    skill remainder_unsigned(compiler, to, left, right) {
        out emit(compiler, forms.remu(register(to), register(left), register(right)))
    }

    skill fraction(compiler, op, to, left, right) {
        compiler = emit(compiler, forms.fmv_d_x(0, register(left)))
        compiler = emit(compiler, forms.fmv_d_x(1, register(right)))
        (op == backend.FRACTION_LESS) { out emit(compiler, forms.flt(register(to), 0, 1)) }
        (op == backend.FRACTION_LESS_EQUAL) { out emit(compiler, forms.fle(register(to), 0, 1)) }
        compiler = emit(compiler, forms.fop(op, 0, 0, 1))
        out emit(compiler, forms.fmv_x_d(register(to), 0))
    }

    skill fraction_from(compiler, to, from) {
        compiler = emit(compiler, forms.fcvt_d_l(0, register(from)))
        out emit(compiler, forms.fmv_x_d(register(to), 0))
    }

    skill fraction_to(compiler, to, from, mode) {
        compiler = emit(compiler, forms.fmv_d_x(0, register(from)))
        out emit(compiler, forms.fcvt_l_d(register(to), 0, mode))
    }

    skill load_wide(compiler, to, value) {
        @base = narrow()
        @name = state.label(compiler, "wide")
        compiler = base.align(compiler, backend.RODATA, 8)
        compiler = base.data_label(compiler, backend.RODATA, name)
        compiler = base.data_word(compiler, backend.RODATA, value.low)
        compiler = base.data_word(compiler, backend.RODATA, value.high)
        compiler = base.load_address(compiler, to, name, 0)
        out load(compiler, to, to, 0)
    }
}
