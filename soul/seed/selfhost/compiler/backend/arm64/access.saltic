-- access — память и стек договора на AArch64: ldr / str слов (8 байт), 32-битных
-- полей, байтов и полуслов, store нуля (xzr), push / pop. Смещение, которое не
-- ложится в команду (масштабное 12 бит или 9 бит со знаком), — в roles.TEMP и
-- адрес [база, TEMP]. Стек договора — x28 (roles.STACK_REGISTER), слово на нём
-- 8 байт: push — str [x28, #-8]!, pop — ldr [x28], #8.
--
-- transfer(compiler, size, load, register, base, offset) — size encoder.X / W / H / B,
--     register — номер регистра (xzr — store нуля), base — роль
-- push(compiler, from) / pop(compiler, to) — роли

use selfhost.compiler.backend.arm64.encoder
use selfhost.compiler.backend.arm64.roles
use selfhost.compiler.backend.arm64.ops

WORD_BYTES = 8

skill transfer(compiler, size, load, register, base, offset) {
    @rn = roles.register(base)
    (encoder.memory_fits(size, offset) == yes) { out ops.emit(compiler, encoder.memory(size, load, register, rn, offset)) }
    compiler = ops.number(compiler, roles.TEMP, offset)
    out ops.emit(compiler, encoder.memory_register(size, load, register, rn, roles.TEMP))
}

skill push(compiler, from) {
    out ops.emit(compiler, encoder.push(roles.register(from), roles.STACK_REGISTER, WORD_BYTES))
}

skill pop(compiler, to) {
    out ops.emit(compiler, encoder.pop(roles.register(to), roles.STACK_REGISTER, WORD_BYTES))
}
