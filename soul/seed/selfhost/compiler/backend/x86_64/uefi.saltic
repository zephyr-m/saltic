use selfhost.compiler.backend.x86_64.encoder
use selfhost.machine.word
use selfhost.machine.buffer

SYSCALL_STUB = [
    65, 139, 71, 68, 61, 247, 1, 0, 0, 117, 102, 73, 137, 228, 65, 139,
    95, 40, 76, 1, 243, 72, 131, 228, 240, 72, 131, 236, 96, 72, 139, 67,
