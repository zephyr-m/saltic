-- layout — программа RV32I в сборке: секции code/rodata/data/bss, метки,
-- отложенные правки (patch) и их разрешение в адреса.
-- Program — значение, каждый навык отдаёт его обновлённым; после любого
-- изменения resolved = no, перед записью нужен resolve. Переходы и адреса
-- пишутся заглушками и доводятся в resolve по меткам. Метки — хеш-корзины.
-- Раскладка: rodata выровнена на 8, data на 4096, bss на 8 после data.
-- far_calls = yes — call через auipc+jalr вместо jal.
--
-- Section = enum { CODE, RODATA, DATA, BSS }; PatchKind = enum { BRANCH, JUMP, … }
-- Label { name, section, offset, present, next, bucket_next } / LabelBucket
-- Patch { kind, instruction_kind, section, offset, base, label, addend, rd, rs1, rs2 }
-- Layout { code_offset, rodata_offset, data_offset, bss_offset, file_size, memory_size (wide) }
-- Program { load_address, low_memory_size, entry, code, rodata, data, bss_size (wide),
--     heap_size (wide: куча последняя в bss, может быть больше 4 ГБ), labels_*, … }
-- host(entry) / qemu_virt(entry) -> Program (адрес 65536 с низкой памятью / 0x80000000)
-- word_address(b0, b1, b2, b3) / address_from_number(n) / address_add(word, n) -> Word;
--     InvalidAddress, AddressOverflow
-- address_upper / address_low(word) -> части для lui/addi; relative_high / relative_low(n)
-- align(value, boundary) / floor_div(value, divisor) -> число; InvalidAlignment
-- section_buffer / section_length(program, section); assign_section(program, section, buffer)
-- align_buffer(buffer, boundary) -> buffer
-- emit(program, kind, rd, rs1, rs2, immediate) — команда; ошибки кодирования копятся
-- emit_word(program, word) / emit_patch(program, Patch, placeholder)
-- note_patch(program, Patch) — правка без байтов, offset задаёт вызывающий
--     (REL32 — 4 байта rel32 от конца поля, ABS32 — адрес гостя метки + addend;
--     оба нейтральны к архитектуре, их пишет исполнитель x86-64)
-- emit_branch(program, kind, rs1, rs2, label); InvalidBranchInstruction
-- emit_branch_unsigned_greater(program, rs1, rs2, label) — bltu с переставленными
-- emit_jump(program, rd, label) / emit_call(program, label)
-- emit_load_immediate(program, rd, n) / emit_load_word(program, rd, word)
-- emit_relative_address / emit_absolute_address(program, rd, label, addend)
-- append_label_address(program, section, label, addend) — слово-адрес в секцию
-- define_label(program, section, name); DuplicateLabel; find_label(program, name) -> Label
-- label_hash / label_bucket / index_label — внутренности поиска меток
-- reserve_bss(program, wide) / align_section(program, section, boundary)
-- append_section_byte / append_section_word / append_section_text(program, section, …)
-- set_section_word(program, section, offset, word)
-- layout(program) -> Layout; section_offset(layout, section)
-- label_offset(program, layout, name) / label_address(program, layout, name, addend);
--     UnknownLabel
-- resolve_patch(program, layout, patch); PatchOutsideRange, UnknownPatch
-- resolve(program) -> Program; InstructionEncoding, UnresolvedPatch

use core.str
use core.group
use io
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.codec
use core.num
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.machine.word
use selfhost.machine.wide
use selfhost.compiler.backend.rv32i.machine.buffer
use selfhost.errors

Section = enum {
    CODE,
    RODATA,
    DATA,
    BSS
}

PatchKind = enum {
    BRANCH,
    JUMP,
    RELATIVE_HIGH,
    RELATIVE_LOW,
    ABSOLUTE_HIGH,
    ABSOLUTE_LOW,
    ADDRESS_WORD,
    REL32,
    ABS32
}

LABEL_BUCKETS = 512

Label = Box {
    name = "",
    section = Section.CODE,
    offset = 0,
    present = no,
    next = none,
    bucket_next = none
}

LabelBucket = Box {
    first = none
}

Patch = Box {
    kind = PatchKind.BRANCH,
    instruction_kind = instruction.Kind.BEQ,
    section = Section.CODE,
    offset = 0,
    base = 0,
    label = "",
    addend = 0,
    rd = 0,
    rs1 = 0,
    rs2 = 0,
    next = none
}

Layout = Box {
    code_offset = 0,
    rodata_offset = 0,
    data_offset = 0,
    bss_offset = 0,
    file_size = 0,
    memory_size = wide.Wide {}
}

Program = Box {
    load_address = word.Word {},
    low_memory_size = 0,
    entry = "",
    code = buffer.Buffer {},
    rodata = buffer.Buffer {},
    data = buffer.Buffer {},
    bss_size = wide.Wide {},
    heap_size = wide.Wide {},
    labels_first = none,
    labels_last = none,
    label_buckets = [],
    label_count = 0,
    patches_first = none,
    patches_last = none,
    patch_count = 0,
    resolved = no,
    far_calls = no,
    encoding_errors = 0
}

skill word_address(b0, b1, b2, b3) {
    (codec.valid_unsigned(b0, codec.BYTE_LIMIT) == no) { out error.InvalidAddress }
    (codec.valid_unsigned(b1, codec.BYTE_LIMIT) == no) { out error.InvalidAddress }
    (codec.valid_unsigned(b2, codec.BYTE_LIMIT) == no) { out error.InvalidAddress }
    (codec.valid_unsigned(b3, codec.BYTE_LIMIT) == no) { out error.InvalidAddress }
    out word.from_bytes(b0, b1, b2, b3)
}

skill address_from_number(value) {
    out word.from_number(value)
}

skill address_add(value, amount) {
    (amount < 0) { out error.InvalidAddress }
    @v0 = value.b0 + amount % 256
    amount = amount / 256
    @v1 = value.b1 + amount % 256 + v0 / 256
    amount = amount / 256
    @v2 = value.b2 + amount % 256 + v1 / 256
    amount = amount / 256
    @v3 = value.b3 + amount % 256 + v2 / 256
    (v3 > 255) { out error.AddressOverflow }
    out word.from_bytes(v0 % 256, v1 % 256, v2 % 256, v3)
}

skill address_upper(value) {
    @upper = value.b1 / 16 + value.b2 * 16 + value.b3 * 4096
    @low = value.b0 + value.b1 % 16 * 256
    (low > 2047) { upper = (upper + 1) % 1048576 }
    out upper
}

skill address_low(value) {
    @low = value.b0 + value.b1 % 16 * 256
    (low > 2047) { low = low - 4096 }
    out low
}

skill align(value, boundary) {
    (boundary < 1) { out error.InvalidAlignment }
    out num.align(value, boundary)
}

skill floor_div(value, divisor) {
    @quotient = value / divisor
    @remainder = value - quotient * divisor
    (value < 0) {
        ((remainder == 0) == no) { quotient = quotient - 1 }
    }
    out quotient
}

skill relative_high(value) {
    out floor_div(value + 2048, 4096)
}

skill relative_low(value) {
    @high = relative_high(value)
    out value - high * 4096
}

skill host(entry) {
    out Program {
        load_address = address_from_number(65536),
        low_memory_size = 65536,
        entry = entry
    }
}

skill qemu_virt(entry) {
    out Program {
        load_address = word_address(0, 0, 0, 128),
        entry = entry
    }
}

skill section_buffer(value, section) {
    (section == Section.CODE) { out value.code }
    (section == Section.RODATA) { out value.rodata }
    (section == Section.DATA) { out value.data }
    out error.SectionHasNoFileData
}

skill section_length(value, section) {
    (section == Section.CODE) { out value.code.length }
    (section == Section.RODATA) { out value.rodata.length }
    (section == Section.DATA) { out value.data.length }
    out wide.to_word(value.bss_size)
}

skill assign_section(value, section, target) {
    (section == Section.CODE) { value.code = target }
    (section == Section.RODATA) { value.rodata = target }
    (section == Section.DATA) { value.data = target }
    value.resolved = no
    out value
}

skill align_buffer(target, boundary) {
    @target_length = align(target.length, boundary)
    out buffer.append_zeroes(target, target_length - target.length)
}

skill emit_word(value, encoded) {
    value.code = buffer.append_word(value.code, encoded)
    value.resolved = no
    out value
}

skill emit(value, kind, rd, rs1, rs2, immediate) {
    @encoded = codec.encode_kind(kind, rd, rs1, rs2, immediate) rescue |failure| {
        value.encoding_errors = value.encoding_errors + 1
        word.from_bytes(0, 0, 0, 0)
    }
    out emit_word(value, encoded)
}

skill note_patch(value, patch) {
    (value.patch_count == 0) { value.patches_first = patch }
    (value.patch_count > 0) { value.patches_last.next = patch }
    value.patches_last = patch
    value.patch_count = value.patch_count + 1
    value.resolved = no
    out value
}

skill emit_patch(value, patch, placeholder) {
    patch.offset = value.code.length
    value = note_patch(value, patch)
    out emit_word(value, placeholder)
}

skill label_hash(name) {
    @hash = 0
    drum (str.bytes(name)) { hash = hash + str.byte(name, beat) * (beat + 1) }
    out hash % LABEL_BUCKETS
}

skill label_bucket(value, name) {
    (group.count(value.label_buckets) == 0) {
        @buckets = []
        drum (LABEL_BUCKETS) { buckets = group.add(buckets, LabelBucket {}) }
        value.label_buckets = buckets
    }
    out group.get(value.label_buckets, label_hash(name))
}

skill index_label(bucket, label) {
    label.bucket_next = bucket.first
    bucket.first = label
    out bucket
}

skill find_label(value, name) {
    (value.label_count == 0) { out Label {} }
    @bucket = label_bucket(value, name)
    @label = bucket.first
    drum (value.label_count) {
        (label == none) { out Label {} }
        (label.name == name) { out label }
        label = label.bucket_next
    }
    out Label {}
}

skill define_label(value, section, name) {
    @old = find_label(value, name)
    (old.present == yes) { out error.DuplicateLabel }
    @label = Label {
        name = name,
        section = section,
        offset = section_length(value, section),
        present = yes
    }
    (value.label_count == 0) { value.labels_first = label }
    (value.label_count > 0) { value.labels_last.next = label }
    value.labels_last = label
    value.label_count = value.label_count + 1
    index_label(label_bucket(value, name), label)
    value.resolved = no
    out value
}

skill reserve_bss(value, count) {
    value.bss_size = wide.add(value.bss_size, count)
    value.resolved = no
    out value
}

skill append_section_byte(value, section, byte) {
    @target = section_buffer(value, section)
    target = buffer.append_byte(target, byte)
    out assign_section(value, section, target)
}

skill append_section_word(value, section, data) {
    @target = section_buffer(value, section)
    target = buffer.append_word(target, data)
    out assign_section(value, section, target)
}

skill append_section_text(value, section, text, terminated) {
    @target = section_buffer(value, section)
    target = buffer.append_text(target, text)
    (terminated == yes) { target = buffer.append_byte(target, 0) }
    out assign_section(value, section, target)
}

skill align_section(value, section, boundary) {
    (section == Section.BSS) {
        value.bss_size = wide.align(value.bss_size, boundary)
        value.resolved = no
        out value
    }
    @target = section_buffer(value, section)
    target = align_buffer(target, boundary)
    out assign_section(value, section, target)
}

skill emit_branch(value, kind, rs1, rs2, label) {
    @item = instruction.find_kind(kind)
    ((item.form == instruction.Form.B) == no) { out error.InvalidBranchInstruction }
    @placeholder = codec.encode(item, registers.ZERO, rs1, rs2, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.BRANCH,
        instruction_kind = kind,
        label = label,
        rs1 = rs1,
        rs2 = rs2
    }, placeholder)
}

skill emit_jump(value, rd, label) {
    @placeholder = codec.encode_kind(instruction.Kind.JAL, rd, registers.ZERO, registers.ZERO, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.JUMP,
        instruction_kind = instruction.Kind.JAL,
        label = label,
        rd = rd
    }, placeholder)
}

skill emit_load_immediate(value, rd, immediate) {
    (immediate > -2049) {
        (immediate < 2048) {
            @encoded = codec.encode_kind(instruction.Kind.ADDI, rd, registers.ZERO, registers.ZERO, immediate)
            out emit_word(value, encoded)
        }
    }
    out emit_load_word(value, rd, word.from_signed(immediate))
}

skill emit_load_word(value, rd, immediate) {
    @lui = codec.encode_kind(instruction.Kind.LUI, rd, registers.ZERO, registers.ZERO, address_upper(immediate))
    value = emit_word(value, lui)
    @addi = codec.encode_kind(instruction.Kind.ADDI, rd, rd, registers.ZERO, address_low(immediate))
    out emit_word(value, addi)
}

skill emit_branch_unsigned_greater(value, rs1, rs2, label) {
    @item = instruction.find_kind(instruction.Kind.BLTU)
    @placeholder = codec.encode(item, registers.ZERO, rs2, rs1, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.BRANCH,
        instruction_kind = instruction.Kind.BLTU,
        label = label,
        rs1 = rs2,
        rs2 = rs1
    }, placeholder)
}

skill emit_relative_address(value, rd, label, addend) {
    @base = value.code.length
    @high = codec.encode_kind(instruction.Kind.AUIPC, rd, registers.ZERO, registers.ZERO, 0)
    value = emit_patch(value, Patch {
        kind = PatchKind.RELATIVE_HIGH,
        instruction_kind = instruction.Kind.AUIPC,
        base = base,
        label = label,
        addend = addend,
        rd = rd
    }, high)
    @low = codec.encode_kind(instruction.Kind.ADDI, rd, rd, registers.ZERO, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.RELATIVE_LOW,
        instruction_kind = instruction.Kind.ADDI,
        base = base,
        label = label,
        addend = addend,
        rd = rd,
        rs1 = rd
    }, low)
}

skill emit_call(value, label) {
    (value.far_calls == no) { out emit_jump(value, registers.RA, label) }
    @base = value.code.length
    @high = codec.encode_kind(instruction.Kind.AUIPC, registers.RA, registers.ZERO, registers.ZERO, 0)
    value = emit_patch(value, Patch {
        kind = PatchKind.RELATIVE_HIGH,
        instruction_kind = instruction.Kind.AUIPC,
        base = base,
        label = label,
        rd = registers.RA
    }, high)
    @low = codec.encode_kind(instruction.Kind.JALR, registers.RA, registers.RA, registers.ZERO, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.RELATIVE_LOW,
        instruction_kind = instruction.Kind.JALR,
        base = base,
        label = label,
        rd = registers.RA,
        rs1 = registers.RA
    }, low)
}

skill emit_absolute_address(value, rd, label, addend) {
    @high = codec.encode_kind(instruction.Kind.LUI, rd, registers.ZERO, registers.ZERO, 0)
    value = emit_patch(value, Patch {
        kind = PatchKind.ABSOLUTE_HIGH,
        instruction_kind = instruction.Kind.LUI,
        label = label,
        addend = addend,
        rd = rd
    }, high)
    @low = codec.encode_kind(instruction.Kind.ADDI, rd, rd, registers.ZERO, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.ABSOLUTE_LOW,
        instruction_kind = instruction.Kind.ADDI,
        label = label,
        addend = addend,
        rd = rd,
        rs1 = rd
    }, low)
}

skill append_label_address(value, section, label, addend) {
    @target = section_buffer(value, section)
    @offset = target.length
    target = buffer.append_word(target, word.from_bytes(0, 0, 0, 0))
    value = assign_section(value, section, target)
    @patch = Patch {
        kind = PatchKind.ADDRESS_WORD,
        section = section,
        offset = offset,
        label = label,
        addend = addend
    }
    (value.patch_count == 0) { value.patches_first = patch }
    (value.patch_count > 0) { value.patches_last.next = patch }
    value.patches_last = patch
    value.patch_count = value.patch_count + 1
    value.resolved = no
    out value
}

skill layout(value) {
    @rodata_offset = align(value.code.length, 8)
    @data_offset = align(rodata_offset + value.rodata.length, 4096)
    @bss_offset = align(data_offset + value.data.length, 8)
    out Layout {
        code_offset = 0,
        rodata_offset = rodata_offset,
        data_offset = data_offset,
        bss_offset = bss_offset,
        file_size = bss_offset,
        memory_size = wide.add_number(value.bss_size, bss_offset)
    }
}

skill section_offset(current_layout, section) {
    (section == Section.CODE) { out current_layout.code_offset }
    (section == Section.RODATA) { out current_layout.rodata_offset }
    (section == Section.DATA) { out current_layout.data_offset }
    out current_layout.bss_offset
}

skill label_offset(value, current_layout, name) {
    @label = find_label(value, name)
    (label.present == no) { out error.UnknownLabel }
    (label.section == Section.BSS) {
        out word.to_number(word.add_number(label.offset, current_layout.bss_offset))
    }
    out section_offset(current_layout, label.section) + label.offset
}

skill label_address(value, current_layout, name, addend) {
    @label = find_label(value, name)
    (label.present == no) { out error.UnknownLabel }
    (label.section == Section.BSS) {
        @offset = word.add_number(label.offset, current_layout.bss_offset + addend)
        out word.add(value.load_address, offset)
    }
    @offset = label_offset(value, current_layout, name) + addend
    (offset < 0) { out error.InvalidAddress }
    out address_add(value.load_address, offset)
}

skill set_section_word(value, section, offset, data) {
    @target = section_buffer(value, section)
    target = buffer.set_word(target, offset, data)
    out assign_section(value, section, target)
}

skill resolve_patch(value, current_layout, patch) {
    @label_base = label_offset(value, current_layout, patch.label) rescue |failure| {
        (str.bytes(patch.label) > 0) {
            @problem = errors.missing_label(patch.label)
            io.show(problem.message)
        }
        out error.UnknownLabel
    }
    @target_offset = label_base + patch.addend
    (patch.kind == PatchKind.BRANCH) {
        @distance = target_offset - patch.offset
        @encoded = codec.encode_kind(patch.instruction_kind, registers.ZERO, patch.rs1, patch.rs2, distance) rescue |failure| { out error.PatchOutsideRange }
        out set_section_word(value, Section.CODE, patch.offset, encoded)
    }
    (patch.kind == PatchKind.JUMP) {
        @distance = target_offset - patch.offset
        @encoded = codec.encode_kind(patch.instruction_kind, patch.rd, registers.ZERO, registers.ZERO, distance) rescue |failure| { out error.PatchOutsideRange }
        out set_section_word(value, Section.CODE, patch.offset, encoded)
    }
    (patch.kind == PatchKind.RELATIVE_HIGH) {
        @distance = target_offset - patch.base
        @upper = codec.signed_value(relative_high(distance), codec.IMMEDIATE20_LIMIT)
        @encoded = codec.encode_kind(patch.instruction_kind, patch.rd, registers.ZERO, registers.ZERO, upper)
        out set_section_word(value, Section.CODE, patch.offset, encoded)
    }
    (patch.kind == PatchKind.RELATIVE_LOW) {
        @distance = target_offset - patch.base
        @low = relative_low(distance)
        @encoded = codec.encode_kind(patch.instruction_kind, patch.rd, patch.rs1, registers.ZERO, low)
        out set_section_word(value, Section.CODE, patch.offset, encoded)
    }
    (patch.kind == PatchKind.ABSOLUTE_HIGH) {
        @target = label_address(value, current_layout, patch.label, patch.addend)
        @encoded = codec.encode_kind(patch.instruction_kind, patch.rd, registers.ZERO, registers.ZERO, address_upper(target))
        out set_section_word(value, Section.CODE, patch.offset, encoded)
    }
    (patch.kind == PatchKind.ABSOLUTE_LOW) {
        @target = label_address(value, current_layout, patch.label, patch.addend)
        @encoded = codec.encode_kind(patch.instruction_kind, patch.rd, patch.rs1, registers.ZERO, address_low(target))
        out set_section_word(value, Section.CODE, patch.offset, encoded)
    }
    (patch.kind == PatchKind.ADDRESS_WORD) {
        @target = label_address(value, current_layout, patch.label, patch.addend)
        out set_section_word(value, patch.section, patch.offset, target)
    }
    (patch.kind == PatchKind.REL32) {
        @distance = target_offset - patch.offset - 4
        out set_section_word(value, Section.CODE, patch.offset, word.from_signed(distance))
    }
    (patch.kind == PatchKind.ABS32) {
        @target = label_address(value, current_layout, patch.label, patch.addend)
        out set_section_word(value, Section.CODE, patch.offset, target)
    }
    out error.UnknownPatch
}

skill resolve(value) {
    (value.encoding_errors > 0) {
        @problem = errors.encoding_failed(value.encoding_errors)
        io.show(problem.message)
        out error.InstructionEncoding
    }
    @current_layout = layout(value)
    @patch = value.patches_first
    drum (value.patch_count) {
        value = resolve_patch(value, current_layout, patch) rescue |failure| { out error.UnresolvedPatch }
        patch = patch.next
    }
    value.resolved = yes
    out value
}
