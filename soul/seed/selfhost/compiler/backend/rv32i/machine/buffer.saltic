-- buffer — растущий буфер байтов машинного кода: куски core.bytes по
-- CHUNK_SIZE байтов в группе chunks, последний кусок заполняется. Байт
-- занимает ровно байт. Буфер меняется на месте, как Box; навыки отдают его же.
--
-- Buffer — Box: chunks, used (байтов в последнем куске), length
-- empty() -> пустой буфер
-- append_byte, append_u16, append_word, append_text, append_zeroes,
--   append_buffer — дописать в конец; ByteOutsideRange, ValueOutsideRange
-- byte_at(target, offset) -> байт; set_byte, set_word — переписать на месте
-- chunk_count(target) -> число кусков
-- chunks(target, chunk_size) -> группа групп чисел по chunk_size байтов
-- whole(target) -> буфер core.bytes ровно на length байтов (для записи в файл)

use core.str
use core.group
use core.num
use core.bytes
use selfhost.compiler.backend.rv32i.machine.codec

CHUNK_SIZE = 4096

Buffer = Box {
    chunks = [],
    used = 0,
    length = 0
}

skill empty() {
    out Buffer {}
}

skill chunk_count(target) {
    out group.count(target.chunks)
}

skill chunk_of(target, offset) {
    (offset < 0) { out error.BufferOutsideRange }
    (offset >= target.length) { out error.BufferOutsideRange }
    out group.get(target.chunks, offset / CHUNK_SIZE)
}

skill append_byte(target, value) {
    (codec.valid_unsigned(value, codec.BYTE_LIMIT) == no) { out error.ByteOutsideRange }
    @count = group.count(target.chunks)
    (count == 0) {
        target.chunks = group.add(target.chunks, bytes.make(CHUNK_SIZE))
        target.used = 0
        count = 1
    }
    (target.used == CHUNK_SIZE) {
        target.chunks = group.add(target.chunks, bytes.make(CHUNK_SIZE))
        target.used = 0
        count = count + 1
    }
    bytes.store(group.get(target.chunks, count - 1), target.used, value)
    target.used = target.used + 1
    target.length = target.length + 1
    out target
}

skill append_text(target, text) {
    drum (str.bytes(text)) { target = append_byte(target, str.byte(text, beat)) }
    out target
}

skill append_word(target, value) {
    target = append_byte(target, value.b0)
    target = append_byte(target, value.b1)
    target = append_byte(target, value.b2)
    target = append_byte(target, value.b3)
    out target
}

skill byte_at(target, offset) {
    @chunk = chunk_of(target, offset)
    out bytes.load(chunk, num.mod(offset, CHUNK_SIZE))
}

skill set_byte(target, offset, value) {
    (codec.valid_unsigned(value, codec.BYTE_LIMIT) == no) { out error.ByteOutsideRange }
    @chunk = chunk_of(target, offset)
    bytes.store(chunk, num.mod(offset, CHUNK_SIZE), value)
    out target
}

skill set_word(target, offset, value) {
    target = set_byte(target, offset, value.b0)
    target = set_byte(target, offset + 1, value.b1)
    target = set_byte(target, offset + 2, value.b2)
    target = set_byte(target, offset + 3, value.b3)
    out target
}

skill append_zeroes(target, count) {
    drum (count) { target = append_byte(target, 0) }
    out target
}

skill append_buffer(target, source) {
    drum (source.length) { target = append_byte(target, byte_at(source, beat)) }
    out target
}

skill whole(target) {
    @result = bytes.make(target.length)
    @offset = 0
    drum (target.chunks) {
        @size = CHUNK_SIZE
        (target.length - offset < size) { size = target.length - offset }
        @chunk = beat
        drum (size) { bytes.store(result, offset + beat, bytes.load(chunk, beat)) }
        offset = offset + size
    }
    out result
}

skill chunks(target, chunk_size) {
    (chunk_size < 1) { out error.InvalidChunkSize }
    (chunk_size > CHUNK_SIZE) { out error.InvalidChunkSize }
    @result = []
    @chunk = []
    drum (target.length) {
        chunk = group.add(chunk, byte_at(target, beat))
        (group.count(chunk) == chunk_size) {
            result = group.add(result, chunk)
            chunk = []
        }
    }
    (group.count(chunk) > 0) { result = group.add(result, chunk) }
    out result
}

skill append_u16(target, value) {
    (codec.valid_unsigned(value, codec.U16_LIMIT) == no) { out error.ValueOutsideRange }
    target = append_byte(target, num.mod(value, 256))
    out append_byte(target, value / 256)
}
