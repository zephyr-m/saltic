-- decoder — разбирает 32-битное слово RV32I на поля и вид команды.
-- Непосредственные значения — знаковые числа; immediate_u — Word с нулями
-- в младших 12 битах.
--
-- Decoded { word, kind, opcode, rd, funct3, rs1, rs2, funct7, system }
-- decode(word) -> Decoded; kind = UNKNOWN_INSTRUCTION, если не найдено
-- immediate_i / immediate_s / immediate_b / immediate_j(decoded) -> число
-- immediate_u(decoded) -> Word

use selfhost.compiler.backend.rv32i.machine.profile
use selfhost.machine.word

Decoded = Box {
    word = word.Word {},
    kind = 0,
    opcode = 0,
    rd = 0,
    funct3 = 0,
    rs1 = 0,
    rs2 = 0,
    funct7 = 0,
    system = 0
}

skill decode(encoded) {
    @opcode = encoded.b0 % 128
    @rd = encoded.b0 / 128 + encoded.b1 % 16 * 2
    @funct3 = encoded.b1 / 16 % 8
    @rs1 = encoded.b1 / 128 + encoded.b2 % 16 * 2
    @rs2 = encoded.b2 / 16 + encoded.b3 % 2 * 16
    @funct7 = encoded.b3 / 2
    @system_code = encoded.b2 / 16 + encoded.b3 * 16
    @definition = profile.decode(opcode, funct3, funct7, system_code)
    out Decoded {
        word = encoded, kind = definition.kind, opcode = opcode, rd = rd,
        funct3 = funct3, rs1 = rs1, rs2 = rs2, funct7 = funct7, system = system_code
    }
}

skill immediate_i(decoded) {
    @value = decoded.word.b2 / 16 + decoded.word.b3 * 16
    (value > 2047) { value = value - 4096 }
    out value
}

skill immediate_s(decoded) {
    @low = decoded.rd
    @value = low + decoded.funct7 * 32
    (value > 2047) { value = value - 4096 }
    out value
}

skill immediate_b(decoded) {
    @bit12 = decoded.word.b3 / 128
    @bit11 = decoded.word.b0 / 128
    @bits10_5 = decoded.word.b3 / 2 % 64
    @bits4_1 = decoded.word.b1 % 16
    @value = bit12 * 4096 + bit11 * 2048 + bits10_5 * 32 + bits4_1 * 2
    (value > 4095) { value = value - 8192 }
    out value
}

skill immediate_j(decoded) {
    @bit20 = decoded.word.b3 / 128
    @bit11 = decoded.word.b2 / 16 % 2
    @bits19_12 = decoded.word.b1 / 16 + decoded.word.b2 % 16 * 16
    @bits10_1 = decoded.word.b2 / 32 + decoded.word.b3 % 128 * 8
    @value = bit20 * 1048576 + bits19_12 * 4096 + bit11 * 2048 + bits10_1 * 2
    (value > 1048575) { value = value - 2097152 }
    out value
}

skill immediate_u(decoded) {
    out word.from_bytes(0, decoded.word.b1 / 16 * 16, decoded.word.b2, decoded.word.b3)
}
