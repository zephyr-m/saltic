-- codec — кодирует команду RV32I в 32-битное слово (word.Word) по форме
-- R/I/S/B/U/J; все поля проверяются. Поля считаются обычной арифметикой:
-- деление на константу даёт старшие биты, вычитание — младшие. Пределы —
-- числа, не ширины: *_LIMIT — 2^ширины у беззнаковых (BYTE_LIMIT 256,
-- U16_LIMIT, OPCODE_LIMIT, FUNCT3/FUNCT7_LIMIT, SHIFT_LIMIT, IMMEDIATE20_LIMIT)
-- и 2^(ширины-1) у знаковых (IMMEDIATE12/13/21_LIMIT); *_MODULUS — 2^ширины.
-- Ошибки: InvalidOpcode, InvalidRegister, InvalidFunction, InvalidImmediate,
-- InvalidShift, UnknownInstruction, UnknownInstructionForm.
--
-- signed_value(value, modulus) -> value без знака (value + modulus, если < 0)
-- valid_unsigned / valid_signed / valid_even_signed(value, limit) -> yes/no
-- encode_r / encode_i / encode_i_unsigned / encode_s / encode_b / encode_u /
--     encode_j(opcode, …) -> Word
-- is_shift(kind) -> yes/no; encode(definition, rd, rs1, rs2, immediate) -> Word
--     по форме из Definition; encode_kind(kind, rd, rs1, rs2, immediate) -> Word

use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.machine.word

BYTE_LIMIT = 256
U16_LIMIT = 65536
OPCODE_LIMIT = 128
FUNCT3_LIMIT = 8
FUNCT7_LIMIT = 128
IMMEDIATE12_LIMIT = 2048
IMMEDIATE12_MODULUS = 4096
IMMEDIATE13_LIMIT = 4096
IMMEDIATE13_MODULUS = 8192
IMMEDIATE20_LIMIT = 1048576
IMMEDIATE21_LIMIT = 1048576
IMMEDIATE21_MODULUS = 2097152
SHIFT_LIMIT = 32

skill signed_value(value, modulus) {
    (value < 0) { out value + modulus }
    out value
}

skill valid_unsigned(value, limit) {
    (value < 0) { out no }
    (value >= limit) { out no }
    out yes
}

skill valid_signed(value, limit) {
    (value < 0 - limit) { out no }
    (value >= limit) { out no }
    out yes
}

skill valid_even_signed(value, limit) {
    (valid_signed(value, limit) == no) { out no }
    out value / 2 * 2 == value
}

skill encode_r(opcode, rd, funct3, rs1, rs2, funct7) {
    (valid_unsigned(opcode, OPCODE_LIMIT) == no) { out error.InvalidOpcode }
    (registers.valid(rd) == no) { out error.InvalidRegister }
    (valid_unsigned(funct3, FUNCT3_LIMIT) == no) { out error.InvalidFunction }
    (registers.valid(rs1) == no) { out error.InvalidRegister }
    (registers.valid(rs2) == no) { out error.InvalidRegister }
    (valid_unsigned(funct7, FUNCT7_LIMIT) == no) { out error.InvalidFunction }
    @rd_high = rd / 2
    @rs1_high = rs1 / 2
    @rs2_high = rs2 / 16
    out word.from_bytes(
        opcode + (rd - rd_high * 2) * 128,
        rd_high + funct3 * 16 + (rs1 - rs1_high * 2) * 128,
        rs1_high + (rs2 - rs2_high * 16) * 16,
        rs2_high + funct7 * 2
    )
}

skill encode_i_unsigned(opcode, rd, funct3, rs1, immediate) {
    (valid_unsigned(opcode, OPCODE_LIMIT) == no) { out error.InvalidOpcode }
    (registers.valid(rd) == no) { out error.InvalidRegister }
    (valid_unsigned(funct3, FUNCT3_LIMIT) == no) { out error.InvalidFunction }
    (registers.valid(rs1) == no) { out error.InvalidRegister }
    (valid_unsigned(immediate, IMMEDIATE12_MODULUS) == no) { out error.InvalidImmediate }
    @rd_high = rd / 2
    @rs1_high = rs1 / 2
    @immediate_high = immediate / 16
    out word.from_bytes(
        opcode + (rd - rd_high * 2) * 128,
        rd_high + funct3 * 16 + (rs1 - rs1_high * 2) * 128,
        rs1_high + (immediate - immediate_high * 16) * 16,
        immediate_high
    )
}

skill encode_i(opcode, rd, funct3, rs1, immediate) {
    (valid_unsigned(opcode, OPCODE_LIMIT) == no) { out error.InvalidOpcode }
    (registers.valid(rd) == no) { out error.InvalidRegister }
    (valid_unsigned(funct3, FUNCT3_LIMIT) == no) { out error.InvalidFunction }
    (registers.valid(rs1) == no) { out error.InvalidRegister }
    (valid_signed(immediate, IMMEDIATE12_LIMIT) == no) { out error.InvalidImmediate }
    out encode_i_unsigned(opcode, rd, funct3, rs1, signed_value(immediate, IMMEDIATE12_MODULUS))
}

skill encode_s(opcode, funct3, rs1, rs2, immediate) {
    (valid_unsigned(opcode, OPCODE_LIMIT) == no) { out error.InvalidOpcode }
    (valid_unsigned(funct3, FUNCT3_LIMIT) == no) { out error.InvalidFunction }
    (registers.valid(rs1) == no) { out error.InvalidRegister }
    (registers.valid(rs2) == no) { out error.InvalidRegister }
    (valid_signed(immediate, IMMEDIATE12_LIMIT) == no) { out error.InvalidImmediate }
    @value = signed_value(immediate, IMMEDIATE12_MODULUS)
    @value_high = value / 32
    @value_low = value - value_high * 32
    @value_low_high = value_low / 2
    @rs1_high = rs1 / 2
    @rs2_high = rs2 / 16
    out word.from_bytes(
        opcode + (value_low - value_low_high * 2) * 128,
        value_low_high + funct3 * 16 + (rs1 - rs1_high * 2) * 128,
        rs1_high + (rs2 - rs2_high * 16) * 16,
        rs2_high + value_high * 2
    )
}

skill encode_b(opcode, funct3, rs1, rs2, immediate) {
    (valid_unsigned(opcode, OPCODE_LIMIT) == no) { out error.InvalidOpcode }
    (valid_unsigned(funct3, FUNCT3_LIMIT) == no) { out error.InvalidFunction }
    (registers.valid(rs1) == no) { out error.InvalidRegister }
    (registers.valid(rs2) == no) { out error.InvalidRegister }
    (valid_even_signed(immediate, IMMEDIATE13_LIMIT) == no) { out error.InvalidImmediate }
    @value = signed_value(immediate, IMMEDIATE13_MODULUS)
    @bit12 = value / 4096
    @bits11_0 = value - bit12 * 4096
    @bit11 = bits11_0 / 2048
    @bits10_0 = bits11_0 - bit11 * 2048
    @bits10_5 = bits10_0 / 32
    @bits4_0 = bits10_0 - bits10_5 * 32
    @bits4_1 = bits4_0 / 2
    @rs1_high = rs1 / 2
    @rs2_high = rs2 / 16
    out word.from_bytes(
        opcode + bit11 * 128,
        bits4_1 + funct3 * 16 + (rs1 - rs1_high * 2) * 128,
        rs1_high + (rs2 - rs2_high * 16) * 16,
        rs2_high + bits10_5 * 2 + bit12 * 128
    )
}

skill encode_u(opcode, rd, immediate) {
    (valid_unsigned(opcode, OPCODE_LIMIT) == no) { out error.InvalidOpcode }
    (registers.valid(rd) == no) { out error.InvalidRegister }
    (valid_unsigned(immediate, IMMEDIATE20_LIMIT) == no) { out error.InvalidImmediate }
    @rd_high = rd / 2
    @bits19_12 = immediate / 4096
    @bits11_0 = immediate - bits19_12 * 4096
    @bits11_4 = bits11_0 / 16
    out word.from_bytes(
        opcode + (rd - rd_high * 2) * 128,
        rd_high + (bits11_0 - bits11_4 * 16) * 16,
        bits11_4,
        bits19_12
    )
}

skill encode_j(opcode, rd, immediate) {
    (valid_unsigned(opcode, OPCODE_LIMIT) == no) { out error.InvalidOpcode }
    (registers.valid(rd) == no) { out error.InvalidRegister }
    (valid_even_signed(immediate, IMMEDIATE21_LIMIT) == no) { out error.InvalidImmediate }
    @value = signed_value(immediate, IMMEDIATE21_MODULUS)
    @bit20 = value / 1048576
    @bits19_0 = value - bit20 * 1048576
    @bits19_12 = bits19_0 / 4096
    @bits11_0 = bits19_0 - bits19_12 * 4096
    @bit11 = bits11_0 / 2048
    @bits10_0 = bits11_0 - bit11 * 2048
    @bits10_4 = bits10_0 / 16
    @bits3_0 = bits10_0 - bits10_4 * 16
    @bits3_1 = bits3_0 / 2
    @bits19_16 = bits19_12 / 16
    @rd_high = rd / 2
    out word.from_bytes(
        opcode + (rd - rd_high * 2) * 128,
        rd_high + (bits19_12 - bits19_16 * 16) * 16,
        bits19_16 + bit11 * 16 + bits3_1 * 32,
        bits10_4 + bit20 * 128
    )
}

skill is_shift(kind) {
    (kind == instruction.Kind.SLLI) { out yes }
    (kind == instruction.Kind.SRLI) { out yes }
    (kind == instruction.Kind.SRAI) { out yes }
    out no
}

skill encode(item, rd, rs1, rs2, immediate) {
    (item.kind == instruction.Kind.UNKNOWN_INSTRUCTION) { out error.UnknownInstruction }
    (item.form == instruction.Form.R) { out encode_r(item.opcode, rd, item.funct3, rs1, rs2, item.funct7) }
    (item.form == instruction.Form.S) { out encode_s(item.opcode, item.funct3, rs1, rs2, immediate) }
    (item.form == instruction.Form.B) { out encode_b(item.opcode, item.funct3, rs1, rs2, immediate) }
    (item.form == instruction.Form.U) { out encode_u(item.opcode, rd, immediate) }
    (item.form == instruction.Form.J) { out encode_j(item.opcode, rd, immediate) }
    (item.form == instruction.Form.I) {
        ((item.system == instruction.ANY) == no) {
            out encode_i_unsigned(item.opcode, registers.ZERO, item.funct3, registers.ZERO, item.system)
        }
        (is_shift(item.kind) == yes) {
            (valid_unsigned(immediate, SHIFT_LIMIT) == no) { out error.InvalidShift }
            out encode_i_unsigned(item.opcode, rd, item.funct3, rs1, item.funct7 * 32 + immediate)
        }
        (item.kind == instruction.Kind.CSRRW) { out encode_i_unsigned(item.opcode, rd, item.funct3, rs1, immediate) }
        (item.kind == instruction.Kind.CSRRS) { out encode_i_unsigned(item.opcode, rd, item.funct3, rs1, immediate) }
        (item.kind == instruction.Kind.FENCE) { out encode_i_unsigned(item.opcode, registers.ZERO, item.funct3, registers.ZERO, immediate) }
        out encode_i(item.opcode, rd, item.funct3, rs1, immediate)
    }
    out error.UnknownInstructionForm
}

skill encode_kind(kind, rd, rs1, rs2, immediate) {
    @item = instruction.find_kind(kind)
    out encode(item, rd, rs1, rs2, immediate)
}
