-- runtime — собирает рантайм rt_* из детей в фиксированном порядке и
-- добавляет его к машине после кода программы. Платформенного кода здесь
-- нет: метки rt_platform_* выпускает платформа (compiler/platform) следом.
-- Порядок вызовов задаёт раскладку меток и не меняется без нужды; провалов
-- меток между вызовами нет (они внутри навыков детей).
-- Команды — методами compiler.executor (договор backend).
--
-- append_runtime(compiler) — весь рантайм
-- append_runtime_data(compiler) — тексты сообщений в rodata
--
-- Дети: numbers, collections, strings, fixed, raw_memory, memory, terminal, host, crash.

use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.runtime.memory
use selfhost.compiler.backend.rv32i.runtime.terminal
use selfhost.compiler.backend.rv32i.runtime.numbers
use selfhost.compiler.backend.rv32i.runtime.collections
use selfhost.compiler.backend.rv32i.runtime.strings
use selfhost.compiler.backend.rv32i.runtime.fixed
use selfhost.compiler.backend.rv32i.runtime.raw_memory
use selfhost.compiler.backend.rv32i.runtime.host
use selfhost.compiler.backend.rv32i.runtime.crash

skill append_runtime_data(compiler) {
    @executor = compiler.executor
    compiler = terminal.append_text(compiler, "rt_unknown_text", "<value>")
    compiler = terminal.append_text(compiler, "rt_fixed_overflow_text", "значение вышло за границы фиксированного целого")
    compiler = terminal.append_text(compiler, "rt_memory_exhausted_text", "память исчерпана")
    compiler = terminal.append_text(compiler, "rt_yes_text", "yes")
    compiler = terminal.append_text(compiler, "rt_no_text", "no")
    compiler = terminal.append_text(compiler, "rt_need_text", "нужно ")
    compiler = terminal.append_text(compiler, "rt_arguments_text", " аргументов")
    compiler = terminal.append_text(compiler, "rt_failure_text", "ошибка: ")
    compiler = crash.append_data(compiler)
    compiler = executor.align(compiler, backend.RODATA, 8)
    compiler = executor.data_label(compiler, backend.RODATA, "rt_newline_text")
    compiler = executor.data_byte(compiler, backend.RODATA, 10)
    out compiler
}

skill append_runtime(compiler) {
    compiler = numbers.emit_mul(compiler)
    compiler = numbers.emit_div(compiler)
    compiler = numbers.emit_mod(compiler)
    compiler = numbers.emit_division_by_zero(compiler)
    compiler = numbers.emit_number_overflow(compiler)
    compiler = numbers.emit_equal(compiler)
    compiler = numbers.emit_value_equal(compiler)
    compiler = collections.emit_box_get(compiler)
    compiler = collections.emit_box_set(compiler)
    compiler = collections.emit_missing_field(compiler)
    compiler = collections.emit_empty_touched(compiler)
    compiler = collections.emit_group_count(compiler)
    compiler = collections.emit_group_at(compiler)
    compiler = collections.emit_group_bounds(compiler)
    compiler = collections.emit_group_tree_at(compiler)
    compiler = collections.emit_group_tree_parts(compiler)
    compiler = collections.emit_group_tree_make(compiler)
    compiler = collections.emit_group_flatten(compiler)
    compiler = strings.emit_string_len(compiler)
    compiler = strings.emit_string_byte(compiler)
    compiler = strings.emit_string_bounds(compiler)
    compiler = strings.emit_string_starts_with(compiler)
    compiler = strings.emit_string_ends_with(compiler)
    compiler = strings.emit_string_contains(compiler)
    compiler = strings.emit_line_count(compiler)
    compiler = host.emit_newline(compiler)
    compiler = host.emit_missing_args(compiler)
    compiler = host.emit_start_failure(compiler)
    compiler = crash.emit_trail_push(compiler)
    compiler = crash.emit_trail_clear(compiler)
    compiler = crash.emit_trail_print(compiler)
    compiler = crash.emit_clock(compiler)
    compiler = crash.emit_report(compiler)
    compiler = crash.append_bss(compiler)
    compiler = host.emit_cpu_wait(compiler)
    compiler = host.emit_cpu_firmware(compiler)
    compiler = host.emit_cpu_fence(compiler)
    compiler = host.emit_environment_capture(compiler)
    compiler = fixed.emit_fixed_overflow(compiler)
    compiler = fixed.emit_fixed_equal(compiler)
    compiler = fixed.emit_fixed_less(compiler)
    compiler = fixed.emit_fixed_greater(compiler)
    compiler = fixed.emit_fixed_new(compiler)
    (compiler.words.bytes == 8) { compiler = fixed.emit_fixed_wrap(compiler) }
    compiler = fixed.emit_fixed_mem_load8(compiler)
    compiler = fixed.emit_fixed_mem_load16(compiler)
    compiler = fixed.emit_fixed_mem_load(compiler)
    compiler = fixed.emit_fixed_mem_store8(compiler)
    compiler = fixed.emit_fixed_mem_store16(compiler)
    compiler = fixed.emit_fixed_mem_store(compiler)
    compiler = raw_memory.emit_mem_load8(compiler)
    compiler = raw_memory.emit_mem_load16(compiler)
    compiler = raw_memory.emit_mem_load32(compiler)
    compiler = raw_memory.emit_mem_store8(compiler)
    compiler = raw_memory.emit_mem_store16(compiler)
    compiler = raw_memory.emit_mem_store32(compiler)
    compiler = raw_memory.emit_mem_store_address32(compiler)
    compiler = fixed.emit_fixed_text(compiler)
    compiler = collections.emit_group_add(compiler)
    compiler = strings.emit_cstring(compiler)
    compiler = strings.emit_string_add(compiler)
    compiler = strings.emit_string_at(compiler)
    compiler = strings.emit_string_from_byte(compiler)
    compiler = strings.emit_string_slice(compiler)
    compiler = strings.emit_string_lower(compiler)
    compiler = strings.emit_string_case(compiler)
    compiler = numbers.emit_number_text(compiler)
    compiler = host.emit_file_write_bytes(compiler)
    compiler = host.emit_file_bytes_text(compiler)
    compiler = fixed.emit_fixed_add(compiler)
    compiler = fixed.emit_fixed_sub(compiler)
    compiler = fixed.emit_fixed_mul(compiler)
    compiler = fixed.emit_fixed_div(compiler)
    compiler = fixed.emit_fixed_and(compiler)
    compiler = fixed.emit_fixed_or(compiler)
    compiler = fixed.emit_fixed_xor(compiler)
    compiler = fixed.emit_fixed_not(compiler)
    compiler = fixed.emit_fixed_shift_left(compiler)
    compiler = fixed.emit_fixed_shift_right(compiler)
    compiler = fixed.emit_fixed_convert(compiler)
    compiler = fixed.emit_fixed_to_number(compiler)
    compiler = host.emit_show(compiler)
    compiler = host.emit_value_text(compiler)
    compiler = memory.append_runtime(compiler)
    compiler = terminal.append_runtime(compiler)
    compiler = append_runtime_data(compiler)
    compiler = host.emit_error_text(compiler)
    compiler = raw_memory.emit_mem_arena(compiler)
    compiler = raw_memory.emit_mem_heap(compiler)
    compiler = host.emit_cpu_call(compiler)
    compiler = strings.emit_bytes_make(compiler)
    compiler = strings.emit_bytes_store(compiler)
    out terminal.append_data(compiler)
}
