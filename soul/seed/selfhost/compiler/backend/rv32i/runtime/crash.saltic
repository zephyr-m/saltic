-- crash — страховочная сетка рантайма: путь непойманной ошибки и журнал
-- yamatakudasai.log. Навык, через который прошла ошибка, кладёт «навык · файл» в
-- TRAIL и строку оператора в TRAIL_LINES (до TRAIL_SIZE, внутренний — первым);
-- rescue путь очищает. Печать звена — «навык · файл:строка» (строка 0 — без неё). В конце
-- программы rt_start_failure зовёт rt_crash_report: «путь: a ← b ← program» на
-- экран (путь из одного навыка — сама программа — не печатается), затем — если
-- платформа открыла журнал на дозапись (Linux; у прочих
-- log_open — NotSupported) — туда же «ЧЧ:ММ:СС UTC  ошибка: Имя» и путь.
-- Вывод rt_show / rt_newline идёт в OUT_FD (0 — экран, fd 1).
--
-- out_fd(compiler, label) — VALUE = fd вывода (метка label — своя у каждого места)
-- emit_trail_push(compiler) — rt_trail_push(VALUE место-строка, ARG2 строка числом),
--     ERROR не трогает
-- emit_trail_clear(compiler) — rt_trail_clear
-- emit_trail_print / emit_report / emit_clock(compiler) — rt_trail_print,
--     rt_crash_report(VALUE ошибка), rt_crash_clock — «ЧЧ:ММ:СС UTC  »
-- append_data(compiler) — подписи; append_bss(compiler) — TRAIL, счётчик, OUT_FD
-- Сбой памяти (compiler.signals — x86-64 Linux, вход x86_signal_entry платформы):
-- emit_runtime_begin(compiler) — метка RUNTIME_BEGIN: начало кода рантайма
--     (граница последнего навыка); emit_signals(compiler) — rt_install_signals
--     (SIGSEGV и SIGBUS — на вход платформы, rt_sigaction), rt_crash_signal
--     (VALUE — адрес сбоя, ERROR — адрес команды, ARG2 — вершина стека в момент
--     сбоя, FRAME — кадр навыка: «сбой памяти: адрес …» и «путь: …», выход
--     SIGNAL_EXIT) и rt_where (ERROR — адрес → VALUE «навык · файл» по
--     compiler.placed: последний навык, начало которого не выше адреса; ERROR =
--     WHERE_SKILL, WHERE_RUNTIME или WHERE_NOWHERE; цепочка сравнений —
--     исполняется только при сбое). Путь: место сбоя; если это рантайм — первый
--     адрес возврата в навык на стеке от вершины до FRAME (кто позвал рантайм);
--     дальше по кадрам x86: [FRAME] — адрес возврата, предыдущий кадр — в слоте
--     previous_frame (не дальше SIGNAL_DEPTH звеньев)

use core.group
use selfhost.abi
use selfhost.compiler.backend
use selfhost.machine.wide
use selfhost.compiler.platform
use selfhost.compiler.constants
use selfhost.compiler.backend.rv32i.runtime.tails
use selfhost.compiler.backend.rv32i.runtime.terminal

TRAIL = "saltic_trail"
TRAIL_COUNT = "saltic_trail_count"
TRAIL_LINES = "saltic_trail_lines"
TRAIL_SIZE = 16
OUT_FD = "saltic_out_fd"
STDOUT = 1
MILLISECONDS = 1000
HOUR = 3600
MINUTE = 60
RUNTIME_BEGIN = "rt_runtime_begin"
SIGNAL_ENTRY = "x86_signal_entry"
SIGNAL_FAULT = "saltic_signal_fault"
SIGNAL_AT = "saltic_signal_at"
SIGNAL_SP = "saltic_signal_sp"
SIGNAL_FRAME = "saltic_signal_frame"
SIGNAL_DEPTH = 16
WHERE_SKILL = 0
WHERE_RUNTIME = 2
WHERE_NOWHERE = 1
SIGNALS = [11, 7]
SIGACTION = 134
SIGNAL_FLAGS = 67108868
SIGNAL_EXIT = 139

skill out_fd(compiler, label) {
    @executor = compiler.executor
    compiler = executor.load_address(compiler, backend.VALUE, OUT_FD, 0)
    compiler = executor.load(compiler, backend.VALUE, backend.VALUE, 0)
    compiler = executor.branch_nonzero(compiler, backend.VALUE, label)
    compiler = executor.load_immediate(compiler, backend.VALUE, STDOUT)
    out executor.label(compiler, label)
}

skill emit_trail_push(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_trail_push")
    compiler = executor.load_address(compiler, backend.SCRATCH0, TRAIL_COUNT, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, TRAIL_SIZE)
    compiler = executor.branch_greater_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_trail_full")
    compiler = executor.shift_left(compiler, backend.SCRATCH2, backend.SCRATCH1, words.shift)
    compiler = executor.load_address(compiler, backend.SCRATCH3, TRAIL, 0)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH3, backend.SCRATCH2)
    compiler = executor.store(compiler, backend.VALUE, backend.SCRATCH3, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH3, TRAIL_LINES, 0)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH3, backend.SCRATCH2)
    compiler = executor.store(compiler, backend.ARG2, backend.SCRATCH3, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.label(compiler, ".L_trail_full")
    out executor.ret(compiler)
}

skill emit_trail_clear(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_trail_clear")
    compiler = executor.load_address(compiler, backend.SCRATCH0, TRAIL_COUNT, 0)
    compiler = executor.store_zero(compiler, backend.SCRATCH0, 0)
    out executor.ret(compiler)
}

skill show_text(compiler, label) {
    @executor = compiler.executor
    compiler = executor.load_address(compiler, backend.VALUE, label, 0)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    out executor.call(compiler, "rt_show")
}

skill emit_trail_print(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_trail_print")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.load_address(compiler, backend.SCRATCH0, TRAIL_COUNT, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 2)
    compiler = executor.branch_less(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_trail_print_done")
    compiler = show_text(compiler, "rt_path_text")
    compiler = executor.store_zero(compiler, backend.STACK, 0)
    compiler = executor.label(compiler, ".L_trail_print_next")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH1, TRAIL_COUNT, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH1, 0)
    compiler = executor.branch_greater_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_trail_print_end")
    compiler = executor.branch_zero(compiler, backend.SCRATCH0, ".L_trail_print_name")
    compiler = show_text(compiler, "rt_arrow_text")
    compiler = executor.label(compiler, ".L_trail_print_name")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, 0)
    compiler = executor.shift_left(compiler, backend.SCRATCH0, backend.SCRATCH0, words.shift)
    compiler = executor.load_address(compiler, backend.SCRATCH1, TRAIL, 0)
    compiler = executor.add(compiler, backend.SCRATCH1, backend.SCRATCH1, backend.SCRATCH0)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH1, 0)
    compiler = executor.call(compiler, "rt_show")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, 0)
    compiler = executor.shift_left(compiler, backend.SCRATCH0, backend.SCRATCH0, words.shift)
    compiler = executor.load_address(compiler, backend.SCRATCH1, TRAIL_LINES, 0)
    compiler = executor.add(compiler, backend.SCRATCH1, backend.SCRATCH1, backend.SCRATCH0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH1, 0)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_trail_print_no_line")
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes)
    compiler = show_text(compiler, "rt_colon_text")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.call(compiler, "rt_show")
    compiler = executor.label(compiler, ".L_trail_print_no_line")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, 1)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, 0)
    compiler = executor.jump(compiler, ".L_trail_print_next")
    compiler = executor.label(compiler, ".L_trail_print_end")
    compiler = executor.call(compiler, "rt_newline")
    compiler = executor.label(compiler, ".L_trail_print_done")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    out tails.ok(compiler)
}

skill tagged(compiler, register, number) {
    @executor = compiler.executor
    out executor.load_immediate(compiler, register, number * abi.TAG_SCALE)
}

skill two_digits(compiler, slot, label) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * slot)
    compiler = tagged(compiler, backend.SCRATCH1, 10)
    compiler = executor.branch_greater_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, label)
    compiler = show_text(compiler, "rt_zero_text")
    compiler = executor.label(compiler, label)
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * slot)
    out executor.call(compiler, "rt_show")
}

skill emit_clock(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_crash_clock")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.call(compiler, platform.NOW)
    compiler = tagged(compiler, backend.ERROR, MILLISECONDS)
    compiler = executor.call(compiler, "rt_div")
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, 0)
    compiler = tagged(compiler, backend.ERROR, HOUR)
    compiler = executor.call(compiler, "rt_div")
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes)
    compiler = two_digits(compiler, 1, ".L_clock_hours")
    compiler = show_text(compiler, "rt_colon_text")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, 0)
    compiler = tagged(compiler, backend.ERROR, MINUTE)
    compiler = executor.call(compiler, "rt_div")
    compiler = tagged(compiler, backend.ERROR, MINUTE)
    compiler = executor.call(compiler, "rt_mod")
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes)
    compiler = two_digits(compiler, 1, ".L_clock_minutes")
    compiler = show_text(compiler, "rt_colon_text")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, 0)
    compiler = tagged(compiler, backend.ERROR, MINUTE)
    compiler = executor.call(compiler, "rt_mod")
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes)
    compiler = two_digits(compiler, 1, ".L_clock_seconds")
    compiler = show_text(compiler, "rt_utc_text")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    out tails.ok(compiler)
}

skill emit_report(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_crash_report")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, 0)
    compiler = executor.call(compiler, "rt_trail_print")
    compiler = executor.call(compiler, platform.LOG_OPEN)
    compiler = executor.branch_nonzero(compiler, backend.ERROR, ".L_crash_done")
    compiler = executor.load_address(compiler, backend.SCRATCH0, OUT_FD, 0)
    compiler = executor.store(compiler, backend.VALUE, backend.SCRATCH0, 0)
    compiler = executor.call(compiler, "rt_crash_clock")
    compiler = show_text(compiler, "rt_failure_text")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, 0)
    compiler = executor.call(compiler, "rt_show")
    compiler = executor.call(compiler, "rt_newline")
    compiler = executor.call(compiler, "rt_trail_print")
    compiler = executor.load_address(compiler, backend.SCRATCH0, OUT_FD, 0)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH0, 0)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.call(compiler, platform.PROCESS_CLOSE)
    compiler = executor.load_address(compiler, backend.SCRATCH0, OUT_FD, 0)
    compiler = executor.store_zero(compiler, backend.SCRATCH0, 0)
    compiler = executor.label(compiler, ".L_crash_done")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    out tails.ok(compiler)
}

skill emit_runtime_begin(compiler) {
    (compiler.signals == no) { out compiler }
    @executor = compiler.executor
    out executor.label(compiler, RUNTIME_BEGIN)
}

skill emit_install(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_install_signals")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -48)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 40)
    compiler = executor.load_address(compiler, backend.SCRATCH0, SIGNAL_ENTRY, 0)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, 0)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, 16)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, SIGNAL_FLAGS)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, 8)
    compiler = executor.store_zero(compiler, backend.STACK, 24)
    drum (SIGNALS) {
        compiler = executor.load_immediate(compiler, backend.VALUE, beat)
        compiler = executor.move(compiler, backend.ERROR, backend.STACK)
        compiler = executor.load_immediate(compiler, backend.ARG2, 0)
        compiler = executor.load_immediate(compiler, backend.ARG3, 8)
        compiler = executor.syscall(compiler, SIGACTION)
    }
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, 40)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 48)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill slot_load(compiler, register, label) {
    @executor = compiler.executor
    compiler = executor.load_address(compiler, backend.SCRATCH0, label, 0)
    out executor.load(compiler, register, backend.SCRATCH0, 0)
}

skill slot_store(compiler, register, label) {
    @executor = compiler.executor
    compiler = executor.load_address(compiler, backend.SCRATCH0, label, 0)
    out executor.store(compiler, register, backend.SCRATCH0, 0)
}

skill emit_crash_signal(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_crash_signal")
    compiler = slot_store(compiler, backend.VALUE, SIGNAL_FAULT)
    compiler = slot_store(compiler, backend.ERROR, SIGNAL_AT)
    compiler = slot_store(compiler, backend.ARG2, SIGNAL_SP)
    compiler = slot_store(compiler, backend.FRAME, SIGNAL_FRAME)
    compiler = show_text(compiler, "rt_signal_text")
    compiler = slot_load(compiler, backend.VALUE, SIGNAL_FAULT)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.call(compiler, "rt_show")
    compiler = executor.call(compiler, "rt_newline")
    compiler = show_text(compiler, "rt_path_text")
    compiler = slot_load(compiler, backend.ERROR, SIGNAL_AT)
    compiler = executor.call(compiler, "rt_where")
    compiler = slot_store(compiler, backend.ERROR, SIGNAL_FAULT)
    compiler = executor.call(compiler, "rt_show")
    compiler = slot_load(compiler, backend.ERROR, SIGNAL_FAULT)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, WHERE_RUNTIME)
    compiler = executor.branch_not_equal(compiler, backend.ERROR, backend.SCRATCH1, ".L_signal_frames")
    compiler = executor.label(compiler, ".L_signal_scan")
    compiler = slot_load(compiler, backend.SCRATCH1, SIGNAL_SP)
    compiler = slot_load(compiler, backend.SCRATCH2, SIGNAL_FRAME)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_signal_frames")
    compiler = executor.load(compiler, backend.ERROR, backend.SCRATCH1, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 8)
    compiler = slot_store(compiler, backend.SCRATCH1, SIGNAL_SP)
    compiler = executor.call(compiler, "rt_where")
    compiler = executor.branch_nonzero(compiler, backend.ERROR, ".L_signal_scan")
    compiler = slot_store(compiler, backend.VALUE, SIGNAL_AT)
    compiler = show_text(compiler, "rt_arrow_text")
    compiler = slot_load(compiler, backend.VALUE, SIGNAL_AT)
    compiler = executor.call(compiler, "rt_show")
    compiler = executor.label(compiler, ".L_signal_frames")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, SIGNAL_DEPTH)
    compiler = slot_store(compiler, backend.SCRATCH1, SIGNAL_SP)
    compiler = executor.label(compiler, ".L_signal_frame")
    compiler = slot_load(compiler, backend.SCRATCH1, SIGNAL_SP)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_signal_done")
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, -1)
    compiler = slot_store(compiler, backend.SCRATCH1, SIGNAL_SP)
    compiler = slot_load(compiler, backend.SCRATCH1, SIGNAL_FRAME)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_signal_done")
    compiler = executor.load(compiler, backend.ERROR, backend.SCRATCH1, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH1, constants.previous_frame_load_offset(compiler.words))
    compiler = slot_store(compiler, backend.SCRATCH1, SIGNAL_FRAME)
    compiler = executor.call(compiler, "rt_where")
    compiler = executor.branch_nonzero(compiler, backend.ERROR, ".L_signal_done")
    compiler = slot_store(compiler, backend.VALUE, SIGNAL_AT)
    compiler = show_text(compiler, "rt_arrow_text")
    compiler = slot_load(compiler, backend.VALUE, SIGNAL_AT)
    compiler = executor.call(compiler, "rt_show")
    compiler = executor.jump(compiler, ".L_signal_frame")
    compiler = executor.label(compiler, ".L_signal_done")
    compiler = executor.call(compiler, "rt_newline")
    compiler = executor.load_immediate(compiler, backend.VALUE, SIGNAL_EXIT)
    out executor.jump(compiler, platform.EXIT)
}

skill emit_where(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_where")
    compiler = executor.load_address(compiler, backend.ARG3, "rt_signal_nowhere_text", 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, WHERE_NOWHERE)
    @spots = group.add(compiler.placed, [RUNTIME_BEGIN, "rt_signal_runtime_text"])
    @index = 0
    drum (spots) {
        @next = ".L_where_next_{index}"
        compiler = executor.load_address(compiler, backend.SCRATCH0, group.get(beat, 0), 0)
        compiler = executor.branch_greater_equal_unsigned(compiler, backend.ERROR, backend.SCRATCH0, next)
        compiler = executor.jump(compiler, ".L_where_found")
        compiler = executor.label(compiler, next)
        compiler = executor.load_address(compiler, backend.ARG3, group.get(beat, 1), 0)
        @kind = WHERE_SKILL
        (group.get(beat, 0) == RUNTIME_BEGIN) { kind = WHERE_RUNTIME }
        compiler = executor.load_immediate(compiler, backend.SCRATCH1, kind)
        index = index + 1
    }
    compiler = executor.label(compiler, ".L_where_found")
    compiler = executor.move(compiler, backend.ERROR, backend.SCRATCH1)
    compiler = executor.move(compiler, backend.VALUE, backend.ARG3)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    out executor.ret(compiler)
}

skill emit_signals(compiler) {
    (compiler.signals == no) { out compiler }
    compiler = emit_install(compiler)
    compiler = emit_crash_signal(compiler)
    out emit_where(compiler)
}

skill append_data(compiler) {
    compiler = terminal.append_text(compiler, "rt_path_text", "  путь: ")
    compiler = terminal.append_text(compiler, "rt_arrow_text", " ← ")
    compiler = terminal.append_text(compiler, "rt_zero_text", "0")
    compiler = terminal.append_text(compiler, "rt_colon_text", ":")
    compiler = terminal.append_text(compiler, "rt_utc_text", " UTC  ")
    (compiler.signals == no) { out compiler }
    compiler = terminal.append_text(compiler, "rt_signal_text", "сбой памяти: адрес ")
    compiler = terminal.append_text(compiler, "rt_signal_where_text", "  в навыке: ")
    compiler = terminal.append_text(compiler, "rt_signal_nowhere_text", "вне навыков Saltic (вход, прошивка или ядро)")
    out terminal.append_text(compiler, "rt_signal_runtime_text", "рантайм Saltic")
}

skill append_bss(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.align(compiler, backend.BSS, words.bytes)
    compiler = executor.data_label(compiler, backend.BSS, TRAIL)
    compiler = executor.reserve(compiler, wide.from_number(words.bytes * TRAIL_SIZE))
    compiler = executor.data_label(compiler, backend.BSS, TRAIL_LINES)
    compiler = executor.reserve(compiler, wide.from_number(words.bytes * TRAIL_SIZE))
    compiler = executor.data_label(compiler, backend.BSS, TRAIL_COUNT)
    compiler = executor.reserve(compiler, wide.from_number(words.bytes))
    compiler = executor.data_label(compiler, backend.BSS, OUT_FD)
    compiler = executor.reserve(compiler, wide.from_number(words.bytes))
    (compiler.signals == no) { out compiler }
    compiler = executor.data_label(compiler, backend.BSS, SIGNAL_FAULT)
    compiler = executor.reserve(compiler, wide.from_number(words.bytes))
    compiler = executor.data_label(compiler, backend.BSS, SIGNAL_AT)
    compiler = executor.reserve(compiler, wide.from_number(words.bytes))
    compiler = executor.data_label(compiler, backend.BSS, SIGNAL_SP)
    compiler = executor.reserve(compiler, wide.from_number(words.bytes))
    compiler = executor.data_label(compiler, backend.BSS, SIGNAL_FRAME)
    out executor.reserve(compiler, wide.from_number(words.bytes))
}
