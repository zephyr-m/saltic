-- numbers — рантайм чисел: арифметика, сравнения, число в текст.
-- Каждый навык берёт и отдаёт compiler, определяя метку rt_* в коде.
-- Команды — методами compiler.executor (договор backend), регистры — его роли.
-- Аргументы — помеченные значения в VALUE/ERROR, результат в VALUE, ERROR = CALL_NO_ERROR.
-- mul/div — сдвигами и сложением, переполнение — rt_number_overflow.
--
-- emit_mul / emit_div / emit_mod(compiler) — rt_mul / rt_div / rt_mod (остаток со
--     знаком делимого, как у деления к нулю); overflow, division_by_zero;
--     на 8-байтном слове — emit_mul_wide / emit_div_wide на mul, mulh, div
--     (переполнение — по 61 биту числа); текст числа — divu / remu
-- emit_number_overflow / emit_division_by_zero(compiler) — метки ошибок
-- emit_equal(compiler) — rt_equal: слова, строки побайтно -> yes/no
-- emit_value_equal(compiler) — rt_value_equal: то, что зовёт `==`; группы
--     вглубь (число элементов, затем каждый элемент им же), остальное —
--     rt_equal; Box и bytes — по памяти. Нужны rt_group_count и rt_group_at
-- EQUAL_YES / EQUAL_NO — метки ответов rt_equal, в них прыгает и fixed
--     (rt_fixed_equal / rt_fixed_less / rt_fixed_greater)
-- GROUP_* — кадр rt_value_equal на стеке в словах; GROUP_STEP — единица в числе с
--     тегом (1 << abi.TAG_SHIFT), шаг индекса
-- emit_number_text(compiler) — rt_number_text -> строка (rt_alloc)
-- emit_bits(compiler) — биты обычного числа (Q-024): rt_num_and / or / xor(VALUE, ERROR),
--     rt_num_shift_left / shift_right(VALUE, ERROR сдвиг), rt_num_bit(VALUE, ERROR n) -> yes/no;
--     сдвиг 0…ширина числа − 1, иначе и при переполнении влево — NumberOverflow

use selfhost.abi
use selfhost.abi.value
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.runtime.tails

EQUAL_YES = ".L_equal_yes"
EQUAL_NO = ".L_equal_no"
GROUP_FRAME_WORDS = 8
GROUP_RETURN = 0
GROUP_LEFT = 1
GROUP_RIGHT = 2
GROUP_COUNT = 3
GROUP_INDEX = 4
GROUP_ITEM = 5
GROUP_STEP = 8

skill emit_mul_wide(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_mul")
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.multiply(compiler, backend.SCRATCH0, backend.VALUE, backend.ERROR)
    compiler = executor.multiply_high(compiler, backend.SCRATCH1, backend.VALUE, backend.ERROR)
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH2, backend.SCRATCH0, compiler.words.bits - 1)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, "rt_number_overflow")
    compiler = executor.move(compiler, backend.VALUE, backend.SCRATCH0)
    out tails.ok(compiler)
}

skill emit_div_wide(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_div")
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.branch_zero(compiler, backend.ERROR, "rt_division_by_zero")
    compiler = executor.divide(compiler, backend.SCRATCH0, backend.VALUE, backend.ERROR)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.SCRATCH0, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH1, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH1, backend.SCRATCH0, "rt_number_overflow")
    out tails.ok(compiler)
}

skill emit_mod(compiler) {
    (compiler.words.bytes == 8) { out emit_mod_wide(compiler) }
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_mod")
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.branch_zero(compiler, backend.ERROR, "rt_division_by_zero")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, 0)
    compiler = executor.branch_not_negative(compiler, backend.VALUE, ".L_mod_left")
    compiler = executor.negate(compiler, backend.VALUE, backend.VALUE)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, 1)
    compiler = executor.label(compiler, ".L_mod_left")
    compiler = executor.branch_not_negative(compiler, backend.ERROR, ".L_mod_right")
    compiler = executor.negate(compiler, backend.ERROR, backend.ERROR)
    compiler = executor.label(compiler, ".L_mod_right")
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, abi.VALUE_WORD_BITS)
    compiler = executor.label(compiler, ".L_mod_loop")
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH4, backend.VALUE, abi.VALUE_WORD_BITS - 1)
    compiler = executor.shift_left(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.or(compiler, backend.SCRATCH2, backend.SCRATCH2, backend.SCRATCH4)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, 1)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH2, backend.ERROR, ".L_mod_next")
    compiler = executor.sub(compiler, backend.SCRATCH2, backend.SCRATCH2, backend.ERROR)
    compiler = executor.label(compiler, ".L_mod_next")
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, -1)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH3, ".L_mod_loop")
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_mod_positive")
    compiler = executor.negate(compiler, backend.SCRATCH2, backend.SCRATCH2)
    compiler = executor.label(compiler, ".L_mod_positive")
    compiler = executor.shift_left(compiler, backend.VALUE, backend.SCRATCH2, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_mod_wide(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_mod")
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.branch_zero(compiler, backend.ERROR, "rt_division_by_zero")
    compiler = executor.remainder(compiler, backend.SCRATCH0, backend.VALUE, backend.ERROR)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.SCRATCH0, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_mul(compiler) {
    (compiler.words.bytes == 8) { out emit_mul_wide(compiler) }
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_mul")
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH1, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.xor(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH1)
    compiler = executor.branch_not_negative(compiler, backend.VALUE, ".L_mul_left")
    compiler = executor.negate(compiler, backend.VALUE, backend.VALUE)
    compiler = executor.label(compiler, ".L_mul_left")
    compiler = executor.branch_not_negative(compiler, backend.SCRATCH1, ".L_mul_right")
    compiler = executor.negate(compiler, backend.SCRATCH1, backend.SCRATCH1)
    compiler = executor.label(compiler, ".L_mul_right")
    compiler = executor.load_immediate(compiler, backend.ERROR, value.NUMBER_MAXIMUM)
    compiler = executor.add_immediate(compiler, backend.ERROR, backend.ERROR, 1)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, 0)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_mul_done")
    compiler = executor.label(compiler, ".L_mul_loop")
    compiler = executor.and_immediate(compiler, backend.SCRATCH2, backend.SCRATCH1, 1)
    compiler = executor.branch_zero(compiler, backend.SCRATCH2, ".L_mul_skip")
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.VALUE)
    compiler = executor.branch_less_unsigned(compiler, backend.ERROR, backend.SCRATCH0, "rt_number_overflow")
    compiler = executor.label(compiler, ".L_mul_skip")
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_mul_done")
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, 1)
    compiler = executor.branch_less_unsigned(compiler, backend.ERROR, backend.VALUE, "rt_number_overflow")
    compiler = executor.jump(compiler, ".L_mul_loop")
    compiler = executor.label(compiler, ".L_mul_done")
    compiler = executor.branch_not_negative(compiler, backend.SCRATCH3, ".L_mul_positive")
    compiler = executor.negate(compiler, backend.SCRATCH0, backend.SCRATCH0)
    compiler = executor.jump(compiler, ".L_mul_encode")
    compiler = executor.label(compiler, ".L_mul_positive")
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.ERROR, "rt_number_overflow")
    compiler = executor.label(compiler, ".L_mul_encode")
    compiler = executor.shift_left(compiler, backend.VALUE, backend.SCRATCH0, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_div(compiler) {
    (compiler.words.bytes == 8) { out emit_div_wide(compiler) }
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_div")
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.branch_zero(compiler, backend.ERROR, "rt_division_by_zero")
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, 0)
    compiler = executor.branch_not_negative(compiler, backend.VALUE, ".L_div_left")
    compiler = executor.negate(compiler, backend.VALUE, backend.VALUE)
    compiler = executor.xor_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.label(compiler, ".L_div_left")
    compiler = executor.branch_not_negative(compiler, backend.ERROR, ".L_div_right")
    compiler = executor.negate(compiler, backend.ERROR, backend.ERROR)
    compiler = executor.xor_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.label(compiler, ".L_div_right")
    compiler = executor.branch_less_unsigned(compiler, backend.VALUE, backend.ERROR, ".L_div_done")
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.ERROR, -1)
    compiler = executor.and(compiler, backend.SCRATCH2, backend.SCRATCH2, backend.ERROR)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH2, ".L_div_long")
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 1)
    compiler = executor.label(compiler, ".L_div_shift")
    compiler = executor.branch_equal(compiler, backend.ERROR, backend.SCRATCH2, ".L_div_shifted")
    compiler = executor.shift_right_unsigned(compiler, backend.ERROR, backend.ERROR, 1)
    compiler = executor.shift_right_unsigned(compiler, backend.VALUE, backend.VALUE, 1)
    compiler = executor.jump(compiler, ".L_div_shift")
    compiler = executor.label(compiler, ".L_div_shifted")
    compiler = executor.move(compiler, backend.SCRATCH0, backend.VALUE)
    compiler = executor.jump(compiler, ".L_div_done")
    compiler = executor.label(compiler, ".L_div_long")
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, abi.VALUE_WORD_BITS)
    compiler = executor.label(compiler, ".L_div_loop")
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH4, backend.VALUE, abi.VALUE_WORD_BITS - 1)
    compiler = executor.shift_left(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.or(compiler, backend.SCRATCH2, backend.SCRATCH2, backend.SCRATCH4)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, 1)
    compiler = executor.shift_left(compiler, backend.SCRATCH0, backend.SCRATCH0, 1)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH2, backend.ERROR, ".L_div_next")
    compiler = executor.sub(compiler, backend.SCRATCH2, backend.SCRATCH2, backend.ERROR)
    compiler = executor.or_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, 1)
    compiler = executor.label(compiler, ".L_div_next")
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, -1)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH3, ".L_div_loop")
    compiler = executor.label(compiler, ".L_div_done")
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_div_positive")
    compiler = executor.negate(compiler, backend.SCRATCH0, backend.SCRATCH0)
    compiler = executor.jump(compiler, ".L_div_encode")
    compiler = executor.label(compiler, ".L_div_positive")
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, value.NUMBER_MAXIMUM)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH2, backend.SCRATCH0, "rt_number_overflow")
    compiler = executor.label(compiler, ".L_div_encode")
    compiler = executor.shift_left(compiler, backend.VALUE, backend.SCRATCH0, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_number_overflow(compiler) {
    @executor = compiler.executor
    out tails.fail(compiler, "rt_number_overflow", abi.ERROR_NUMBER_OVERFLOW)
}

skill emit_division_by_zero(compiler) {
    @executor = compiler.executor
    out tails.fail(compiler, "rt_division_by_zero", abi.ERROR_DIVISION_BY_ZERO)
}

skill emit_equal(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_equal")
    compiler = executor.branch_equal(compiler, backend.VALUE, backend.ERROR, EQUAL_YES)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.TAG_MASK)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.ERROR, abi.TAG_MASK)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, EQUAL_NO)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.TAG_STRING)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH0, backend.SCRATCH2, EQUAL_NO)
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.and_immediate(compiler, backend.ERROR, backend.ERROR, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.ERROR, words.payload)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, EQUAL_NO)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 0)
    compiler = executor.label(compiler, ".L_equal_string")
    compiler = executor.branch_equal(compiler, backend.SCRATCH2, backend.SCRATCH0, EQUAL_YES)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH2)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.ERROR, backend.SCRATCH2)
    compiler = executor.load_byte(compiler, backend.SCRATCH3, backend.SCRATCH3, words.payload + words.string_data)
    compiler = executor.load_byte(compiler, backend.SCRATCH4, backend.SCRATCH4, words.payload + words.string_data)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH3, backend.SCRATCH4, EQUAL_NO)
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.jump(compiler, ".L_equal_string")
    compiler = executor.label(compiler, EQUAL_YES)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.YES)
    compiler = tails.ok(compiler)
    compiler = executor.label(compiler, EQUAL_NO)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NO)
    out tails.ok(compiler)
}

skill emit_value_equal(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_value_equal")
    compiler = executor.jump_if_equal(compiler, backend.VALUE, backend.ERROR, EQUAL_YES)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.TAG_MASK)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.ERROR, abi.TAG_MASK)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.TAG_GROUP)
    compiler = executor.jump_if_not_equal(compiler, backend.SCRATCH0, backend.SCRATCH2, "rt_equal")
    compiler = executor.jump_if_not_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, EQUAL_NO)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * GROUP_FRAME_WORDS)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * GROUP_RETURN)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * GROUP_LEFT)
    compiler = executor.store(compiler, backend.ERROR, backend.STACK, words.bytes * GROUP_RIGHT)
    compiler = executor.call(compiler, "rt_group_count")
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * GROUP_COUNT)
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * GROUP_RIGHT)
    compiler = executor.call(compiler, "rt_group_count")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * GROUP_COUNT)
    compiler = executor.branch_not_equal(compiler, backend.VALUE, backend.SCRATCH0, ".L_value_equal_no")
    compiler = executor.store_zero(compiler, backend.STACK, words.bytes * GROUP_INDEX)
    compiler = executor.label(compiler, ".L_value_equal_next")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * GROUP_INDEX)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes * GROUP_COUNT)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_value_equal_yes")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * GROUP_LEFT)
    compiler = executor.move(compiler, backend.ERROR, backend.SCRATCH0)
    compiler = executor.call(compiler, "rt_group_at")
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * GROUP_ITEM)
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * GROUP_RIGHT)
    compiler = executor.load(compiler, backend.ERROR, backend.STACK, words.bytes * GROUP_INDEX)
    compiler = executor.call(compiler, "rt_group_at")
    compiler = executor.move(compiler, backend.ERROR, backend.VALUE)
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * GROUP_ITEM)
    compiler = executor.call(compiler, "rt_value_equal")
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.YES)
    compiler = executor.branch_not_equal(compiler, backend.VALUE, backend.SCRATCH0, ".L_value_equal_no")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * GROUP_INDEX)
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, GROUP_STEP)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, words.bytes * GROUP_INDEX)
    compiler = executor.jump(compiler, ".L_value_equal_next")
    compiler = executor.label(compiler, ".L_value_equal_yes")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * GROUP_RETURN)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * GROUP_FRAME_WORDS)
    compiler = executor.jump(compiler, EQUAL_YES)
    compiler = executor.label(compiler, ".L_value_equal_no")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * GROUP_RETURN)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * GROUP_FRAME_WORDS)
    out executor.jump(compiler, EQUAL_NO)
}

skill emit_number_text(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_number_text")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 12)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 11)
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH0, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, 0)
    compiler = executor.branch_not_negative(compiler, backend.SCRATCH0, ".L_number_abs")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, 1)
    compiler = executor.negate(compiler, backend.SCRATCH0, backend.SCRATCH0)
    compiler = executor.label(compiler, ".L_number_abs")
    compiler = executor.move(compiler, backend.SCRATCH2, backend.STACK)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, 0)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH0, ".L_number_digits")
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 48)
    compiler = executor.store_byte(compiler, backend.SCRATCH4, backend.SCRATCH2, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, 1)
    compiler = executor.jump(compiler, ".L_number_ready")
    compiler = executor.label(compiler, ".L_number_digits")
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 10)
    compiler = executor.label(compiler, ".L_number_digit_loop")
    pick {
        (words.bytes == 8) {
            compiler = executor.divide_unsigned(compiler, backend.SCRATCH5, backend.SCRATCH0, backend.SCRATCH4)
            compiler = executor.remainder_unsigned(compiler, backend.ARG2, backend.SCRATCH0, backend.SCRATCH4)
        }
        {
            compiler = executor.load_immediate(compiler, backend.SCRATCH5, 0)
            compiler = executor.move(compiler, backend.ARG2, backend.SCRATCH0)
            compiler = executor.label(compiler, ".L_number_div10")
            compiler = executor.branch_less_unsigned(compiler, backend.ARG2, backend.SCRATCH4, ".L_number_remainder")
            compiler = executor.add_immediate(compiler, backend.ARG2, backend.ARG2, -10)
            compiler = executor.add_immediate(compiler, backend.SCRATCH5, backend.SCRATCH5, 1)
            compiler = executor.jump(compiler, ".L_number_div10")
        }
    }
    compiler = executor.label(compiler, ".L_number_remainder")
    compiler = executor.add_immediate(compiler, backend.ARG2, backend.ARG2, 48)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.SCRATCH2, backend.SCRATCH3)
    compiler = executor.store_byte(compiler, backend.ARG2, backend.SCRATCH4, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, 1)
    compiler = executor.move(compiler, backend.SCRATCH0, backend.SCRATCH5)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH0, ".L_number_digits")
    compiler = executor.label(compiler, ".L_number_ready")
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_number_alloc")
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, 1)
    compiler = executor.label(compiler, ".L_number_alloc")
    compiler = executor.store(compiler, backend.SCRATCH3, backend.STACK, words.bytes * 10)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 9)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.STACK, words.bytes * 8)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.SCRATCH3, words.string_data + 1)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load(compiler, backend.SCRATCH3, backend.STACK, words.bytes * 10)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 9)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.STACK, words.bytes * 8)
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, abi.OBJECT_KIND_STRING)
    compiler = executor.store32(compiler, backend.SCRATCH4, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.VALUE, words.payload)
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 0)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_number_copy")
    compiler = executor.load_immediate(compiler, backend.SCRATCH5, 45)
    compiler = executor.store_byte(compiler, backend.SCRATCH5, backend.VALUE, words.payload + words.string_data)
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 1)
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, -1)
    compiler = executor.label(compiler, ".L_number_copy")
    compiler = executor.branch_zero(compiler, backend.SCRATCH3, ".L_number_done")
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, -1)
    compiler = executor.add(compiler, backend.SCRATCH5, backend.SCRATCH2, backend.SCRATCH3)
    compiler = executor.load_byte(compiler, backend.ARG2, backend.SCRATCH5, 0)
    compiler = executor.add(compiler, backend.SCRATCH5, backend.VALUE, backend.SCRATCH4)
    compiler = executor.store_byte(compiler, backend.ARG2, backend.SCRATCH5, words.payload + words.string_data)
    compiler = executor.add_immediate(compiler, backend.SCRATCH4, backend.SCRATCH4, 1)
    compiler = executor.jump(compiler, ".L_number_copy")
    compiler = executor.label(compiler, ".L_number_done")
    compiler = executor.add(compiler, backend.SCRATCH5, backend.VALUE, backend.SCRATCH4)
    compiler = executor.store_byte_zero(compiler, backend.SCRATCH5, words.payload + words.string_data)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 11)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 12)
    out tails.ok(compiler)
}

skill emit_arithmetic_right(compiler, to, from, count, name) {
    @executor = compiler.executor
    compiler = executor.branch_not_negative(compiler, from, ".L_{name}_plus")
    compiler = executor.xor_immediate(compiler, to, from, -1)
    compiler = executor.shift_right_unsigned_by(compiler, to, to, count)
    compiler = executor.xor_immediate(compiler, to, to, -1)
    compiler = executor.jump(compiler, ".L_{name}_done")
    compiler = executor.label(compiler, ".L_{name}_plus")
    compiler = executor.shift_right_unsigned_by(compiler, to, from, count)
    out executor.label(compiler, ".L_{name}_done")
}

skill emit_shift_count(compiler, name) {
    @executor = compiler.executor
    compiler = executor.label(compiler, name)
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH3, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.branch_not_negative(compiler, backend.SCRATCH3, ".L_{name}_low")
    compiler = executor.jump(compiler, "rt_number_overflow")
    compiler = executor.label(compiler, ".L_{name}_low")
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, compiler.words.bits - abi.TAG_SHIFT)
    compiler = executor.branch_less(compiler, backend.SCRATCH3, backend.SCRATCH4, ".L_{name}_fits")
    compiler = executor.jump(compiler, "rt_number_overflow")
    out executor.label(compiler, ".L_{name}_fits")
}

skill emit_bits(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_num_and")
    compiler = tails.ok(executor.and(compiler, backend.VALUE, backend.VALUE, backend.ERROR))
    compiler = executor.label(compiler, "rt_num_or")
    compiler = tails.ok(executor.or(compiler, backend.VALUE, backend.VALUE, backend.ERROR))
    compiler = executor.label(compiler, "rt_num_xor")
    compiler = tails.ok(executor.xor(compiler, backend.VALUE, backend.VALUE, backend.ERROR))
    compiler = emit_shift_count(compiler, "rt_num_shift_left")
    compiler = executor.shift_left_by(compiler, backend.SCRATCH5, backend.VALUE, backend.SCRATCH3)
    compiler = emit_arithmetic_right(compiler, backend.SCRATCH4, backend.SCRATCH5, backend.SCRATCH3, "num_shift_back")
    compiler = executor.jump_if_not_equal(compiler, backend.SCRATCH4, backend.VALUE, "rt_number_overflow")
    compiler = executor.move(compiler, backend.VALUE, backend.SCRATCH5)
    compiler = tails.ok(compiler)
    compiler = emit_shift_count(compiler, "rt_num_shift_right")
    compiler = emit_arithmetic_right(compiler, backend.VALUE, backend.VALUE, backend.SCRATCH3, "num_shift_right")
    compiler = tails.ok(executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK))
    compiler = emit_shift_count(compiler, "rt_num_bit")
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, abi.TAG_SHIFT)
    compiler = emit_arithmetic_right(compiler, backend.VALUE, backend.VALUE, backend.SCRATCH3, "num_bit")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, 1)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    out tails.ok(executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.NO))
}
