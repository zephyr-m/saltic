-- raw_memory — рантайм core.mem: чтение и запись по физическому адресу.
-- Каждый навык берёт и отдаёт compiler, определяя метку rt_mem_* в коде.
-- Команды — методами compiler.executor (договор backend), регистры — его роли.
-- Адрес — группа [hi, lo] по 16 бит в VALUE, смещение в ERROR, значение в ARG2;
-- результат чтения — число с тегом в VALUE.
--
-- emit_mem_load8 / emit_mem_load16 / emit_mem_load32(compiler) — rt_mem_load*
-- emit_mem_store8 / emit_mem_store16 / emit_mem_store32(compiler) — rt_mem_store*
-- emit_mem_store_address32(compiler) — записать адрес [hi, lo] как 32 бита
-- emit_mem_arena(compiler) — rt_mem_arena(VALUE half) -> hi или lo адреса saltic_arena
-- emit_halves(compiler, group, base) — base = адрес группы [hi, lo] из group;
--     SCRATCH1 = hi << 16, SCRATCH2 = lo (16 бит); склеивает (or) вызывающий

use selfhost.abi
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.runtime.tails

skill emit_halves(compiler, group, base) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.and_immediate(compiler, base, group, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH1, base, words.payload + words.group_items)
    compiler = executor.load(compiler, backend.SCRATCH2, base, words.payload + words.group_items + words.group_item)
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH1, backend.SCRATCH1, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH2, backend.SCRATCH2, abi.TAG_SHIFT)
    compiler = executor.shift_left(compiler, backend.SCRATCH1, backend.SCRATCH1, 16)
    compiler = executor.shift_left(compiler, backend.SCRATCH2, backend.SCRATCH2, words.bits - 16)
    out executor.shift_right_unsigned(compiler, backend.SCRATCH2, backend.SCRATCH2, words.bits - 16)
}

skill emit_mem_load8(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_load8")
    compiler = emit_halves(compiler, backend.VALUE, backend.SCRATCH0)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.or(compiler, backend.SCRATCH0, backend.SCRATCH1, backend.SCRATCH2)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = executor.load_byte(compiler, backend.VALUE, backend.SCRATCH0, 0)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_mem_load16(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_load16")
    compiler = emit_halves(compiler, backend.VALUE, backend.SCRATCH0)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.or(compiler, backend.SCRATCH0, backend.SCRATCH1, backend.SCRATCH2)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = executor.load_half(compiler, backend.VALUE, backend.SCRATCH0, 0)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_mem_load32(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_load32")
    compiler = emit_halves(compiler, backend.VALUE, backend.SCRATCH0)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.or(compiler, backend.SCRATCH0, backend.SCRATCH1, backend.SCRATCH2)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = executor.load32(compiler, backend.VALUE, backend.SCRATCH0, 0)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_mem_store8(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_store8")
    compiler = emit_halves(compiler, backend.VALUE, backend.SCRATCH0)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ARG2, backend.ARG2, abi.TAG_SHIFT)
    compiler = executor.or(compiler, backend.SCRATCH0, backend.SCRATCH1, backend.SCRATCH2)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = executor.store_byte(compiler, backend.ARG2, backend.SCRATCH0, 0)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    out tails.ok(compiler)
}

skill emit_mem_store16(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_store16")
    compiler = emit_halves(compiler, backend.VALUE, backend.SCRATCH0)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ARG2, backend.ARG2, abi.TAG_SHIFT)
    compiler = executor.or(compiler, backend.SCRATCH0, backend.SCRATCH1, backend.SCRATCH2)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = executor.store_half(compiler, backend.ARG2, backend.SCRATCH0, 0)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    out tails.ok(compiler)
}

skill emit_mem_store32(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_store32")
    compiler = emit_halves(compiler, backend.VALUE, backend.SCRATCH0)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ARG2, backend.ARG2, abi.TAG_SHIFT)
    compiler = executor.or(compiler, backend.SCRATCH0, backend.SCRATCH1, backend.SCRATCH2)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = executor.store32(compiler, backend.ARG2, backend.SCRATCH0, 0)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    out tails.ok(compiler)
}

skill emit_mem_store_address32(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_store_address32")
    compiler = emit_halves(compiler, backend.VALUE, backend.SCRATCH0)
    compiler = executor.or(compiler, backend.SCRATCH0, backend.SCRATCH1, backend.SCRATCH2)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = emit_halves(compiler, backend.ARG2, backend.SCRATCH3)
    compiler = executor.or(compiler, backend.SCRATCH3, backend.SCRATCH1, backend.SCRATCH2)
    compiler = executor.store32(compiler, backend.SCRATCH3, backend.SCRATCH0, 0)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    out tails.ok(compiler)
}

skill emit_mem_arena(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_arena")
    compiler = executor.load_address(compiler, backend.SCRATCH0, "saltic_arena", 0)
    compiler = executor.branch_zero(compiler, backend.VALUE, ".L_mem_arena_low")
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH0, backend.SCRATCH0, 16)
    compiler = executor.label(compiler, ".L_mem_arena_low")
    compiler = executor.shift_left(compiler, backend.SCRATCH0, backend.SCRATCH0, words.bits - 16)
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH0, backend.SCRATCH0, words.bits - 16)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.SCRATCH0, abi.TAG_SHIFT)
    out tails.ok(compiler)
}
