-- raw_memory — рантайм core.mem без чтения и записи: адрес своей арены и
-- занятость кучи (чтение и запись по address — rt_fixed_mem_* в fixed; по
-- парам [hi, lo] больше нет, Q-040). Каждый навык берёт и отдаёт compiler,
-- определяя метку rt_mem_* в коде; команды — методами compiler.executor.
--
-- emit_mem_arena(compiler) — rt_mem_arena(VALUE half) -> hi или lo адреса saltic_arena
-- emit_mem_heap(compiler) — rt_mem_heap(VALUE piece) -> байт кучи: 0 — занято
--     (HEAP_TOP − saltic_heap), 1 — список побегов (конец кучи − ESCAPE_BOTTOM),
--     иначе — квота (heap_bytes сборки)

use selfhost.abi
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.runtime.tails
use selfhost.machine.wide

skill emit_mem_arena(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_arena")
    compiler = executor.load_address(compiler, backend.SCRATCH0, "saltic_arena", 0)
    compiler = executor.branch_zero(compiler, backend.VALUE, ".L_mem_arena_low")
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH0, backend.SCRATCH0, 16)
    compiler = executor.label(compiler, ".L_mem_arena_low")
    compiler = executor.shift_left(compiler, backend.SCRATCH0, backend.SCRATCH0, words.bits - 16)
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH0, backend.SCRATCH0, words.bits - 16)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.SCRATCH0, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_mem_heap(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_mem_heap")
    compiler = executor.load_address(compiler, backend.SCRATCH0, "saltic_heap", 0)
    pick {
        (words.bytes == 8) { compiler = executor.load_wide(compiler, backend.SCRATCH1, compiler.heap_bytes) }
        { compiler = executor.load_word(compiler, backend.SCRATCH1, wide.to_word(compiler.heap_bytes)) }
    }
    compiler = executor.branch_zero(compiler, backend.VALUE, ".L_mem_heap_used")
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.tagged(1, abi.TAG_NUMBER))
    compiler = executor.branch_not_equal(compiler, backend.VALUE, backend.SCRATCH2, ".L_mem_heap_quota")
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH1)
    compiler = executor.sub(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ESCAPE_BOTTOM)
    compiler = executor.jump(compiler, ".L_mem_heap_done")
    compiler = executor.label(compiler, ".L_mem_heap_used")
    compiler = executor.sub(compiler, backend.SCRATCH0, backend.HEAP_TOP, backend.SCRATCH0)
    compiler = executor.jump(compiler, ".L_mem_heap_done")
    compiler = executor.label(compiler, ".L_mem_heap_quota")
    compiler = executor.move(compiler, backend.SCRATCH0, backend.SCRATCH1)
    compiler = executor.label(compiler, ".L_mem_heap_done")
    compiler = executor.shift_left(compiler, backend.VALUE, backend.SCRATCH0, abi.TAG_SHIFT)
    out tails.ok(compiler)
}
