-- walk — общее у рантайма памяти: метки слов bss и начала кучи, разбор
-- слова (тег, адрес; указатель региона / хранилища), размер объекта и обход
-- слов-указателей одного объекта посетителем. Все части памяти (store, move,
-- cycles, quarantine и сам memory) берут отсюда — так между ними нет циклов модулей.
-- Команды — методами compiler.executor (договор backend).
--
-- *_LABEL — имена слов bss (резервирует memory.append_runtime) и saltic_heap_start
-- POINTER_TAG_COUNT / KIND_LIMIT — теги указателей и предел видов объектов
-- emit_pointer_address(compiler, skip) — ARG7: не указатель — на skip; иначе
--     SCRATCH0 = тег, SCRATCH2 = адрес
-- emit_region_pointer / emit_store_pointer(compiler, skip) — то же, но на skip и
--     когда адрес не в регионе [heap_start, STORE_BOTTOM) / не в хранилище
-- emit_object_size(compiler, size, object) — байты объекта с заголовком, кратно 8
-- emit_visit(compiler, visitor, base, offset) — слово по адресу через посетителя
-- emit_object_walk(compiler, visitor, prefix) — слова-указатели объекта в ERROR:
--     группа — элементы, Box — значения полей, дерево — корень и хвост, строка —
--     ничего; ARG2 — осталось, ARG6 — адрес слова, шаг — слово rt_walk_stride
--     (регистры посетитель вправе портить все, кроме ARG2…ARG6)
-- emit_object_front(compiler, visitor, prefix, cap) — то же, но не больше cap первых
--     слов (0 — все); emit_object_walk — это emit_object_front с cap 0
-- reserve_word(compiler, label) — слово bss с меткой

use selfhost.abi
use selfhost.compiler.backend
use selfhost.machine.wide

POINTER_TAG_COUNT = abi.TAG_BOX - abi.TAG_STRING + 1
KIND_LIMIT = abi.OBJECT_KIND_TREE + 1

HEAP_START_LABEL = "saltic_heap_start"
STACK_BASE_LABEL = "rt_stack_base"
DELTA_LABEL = "rt_region_delta"
ABORT_LABEL = "rt_region_abort_flag"
STORE_FLOOR_LABEL = "rt_store_floor"
STORE_TOP_LABEL = "rt_store_top"
STORE_BITMAP_LABEL = "rt_store_bitmap"
STORE_PARTIAL_LABEL = "rt_store_partial"
STORE_CLASSES_LABEL = "rt_store_classes"
WALK_STRIDE_LABEL = "rt_walk_stride"
QUARANTINE_PAGE_LABEL = "rt_quarantine_page"
QUARANTINE_COUNT_LABEL = "rt_quarantine_count"
SWEEP_FROM_LABEL = "rt_sweep_from"
SWEEP_VALUE_LABEL = "rt_sweep_value"
SWEEP_BUDGET_LABEL = "rt_sweep_budget"
SWEEP_LEFT_LABEL = "rt_sweep_left"
SWEEP_PAGE_LABEL = "rt_sweep_page"
SWEEP_PREV_LABEL = "rt_sweep_prev"
SWEEP_INDEX_LABEL = "rt_sweep_index"
SWEEP_ENTRY_LABEL = "rt_sweep_entry"
SWEEP_BUSY_LABEL = "rt_sweep_busy"
SWEEP_BATCH_LABEL = "rt_sweep_batch"
CYCLE_BOX_LABEL = "rt_cycle_box"
MOVE_ERROR_LABEL = "rt_move_error"
MOVE_BYTES_LABEL = "rt_move_bytes"
MOVE_FLAG_LABEL = "rt_move_flag"
REACH_BOX_LABEL = "rt_reach_box"
REACH_FOUND_LABEL = "rt_reach_found"
REACH_OVER_LABEL = "rt_reach_over"
REACH_END_LABEL = "rt_reach_end"
REACH_DELTA_LABEL = "rt_reach_delta"
REACH_LIMIT_LABEL = "rt_reach_limit"
BSS_WORDS = [DELTA_LABEL, ABORT_LABEL, STACK_BASE_LABEL, STORE_FLOOR_LABEL, STORE_TOP_LABEL, STORE_BITMAP_LABEL, WALK_STRIDE_LABEL, QUARANTINE_PAGE_LABEL, QUARANTINE_COUNT_LABEL, SWEEP_FROM_LABEL, SWEEP_VALUE_LABEL, SWEEP_BUDGET_LABEL, SWEEP_LEFT_LABEL, SWEEP_PAGE_LABEL, SWEEP_PREV_LABEL, SWEEP_INDEX_LABEL, SWEEP_ENTRY_LABEL, SWEEP_BUSY_LABEL, SWEEP_BATCH_LABEL, CYCLE_BOX_LABEL, MOVE_ERROR_LABEL, MOVE_BYTES_LABEL, MOVE_FLAG_LABEL, REACH_BOX_LABEL, REACH_FOUND_LABEL, REACH_OVER_LABEL, REACH_END_LABEL, REACH_DELTA_LABEL, REACH_LIMIT_LABEL]

skill emit_pointer_address(compiler, skip) {
    @executor = compiler.executor
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.ARG7, abi.TAG_MASK)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH0, -abi.TAG_STRING)
    compiler = executor.set_less_unsigned_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, POINTER_TAG_COUNT)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, skip)
    out executor.and_immediate(compiler, backend.SCRATCH2, backend.ARG7, abi.PAYLOAD_MASK)
}

skill emit_region_pointer(compiler, skip) {
    @executor = compiler.executor
    compiler = emit_pointer_address(compiler, skip)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH2, backend.STORE_BOTTOM, skip)
    compiler = executor.load_address(compiler, backend.SCRATCH1, HEAP_START_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH1, 0)
    out executor.branch_less_unsigned(compiler, backend.SCRATCH2, backend.SCRATCH1, skip)
}

skill emit_store_pointer(compiler, skip) {
    @executor = compiler.executor
    compiler = emit_pointer_address(compiler, skip)
    out executor.branch_less_unsigned(compiler, backend.SCRATCH2, backend.STORE_BOTTOM, skip)
}

skill emit_object_size(compiler, size, object) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.load32(compiler, size, object, abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET)
    compiler = executor.add_immediate(compiler, size, size, words.header + abi.OBJECT_ALIGNMENT - 1)
    out executor.and_immediate(compiler, size, size, -abi.OBJECT_ALIGNMENT)
}

skill emit_visit(compiler, visitor, base, offset) {
    @executor = compiler.executor
    compiler = executor.load(compiler, backend.ARG7, base, offset)
    compiler = executor.call(compiler, visitor)
    out executor.store(compiler, backend.ARG7, base, offset)
}

skill emit_object_walk(compiler, visitor, prefix) {
    out emit_object_front(compiler, visitor, prefix, 0)
}

skill emit_object_front(compiler, visitor, prefix, cap) {
    @executor = compiler.executor
    @words = compiler.words
    @group = "{prefix}_group"
    @box = "{prefix}_box"
    @tree = "{prefix}_tree"
    @items = "{prefix}_items"
    @done = "{prefix}_done"
    compiler = executor.load32(compiler, backend.ARG6, backend.ERROR, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.OBJECT_KIND_GROUP)
    compiler = executor.branch_equal(compiler, backend.ARG6, backend.SCRATCH0, group)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.OBJECT_KIND_BOX)
    compiler = executor.branch_equal(compiler, backend.ARG6, backend.SCRATCH0, box)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.OBJECT_KIND_TREE)
    compiler = executor.branch_equal(compiler, backend.ARG6, backend.SCRATCH0, tree)
    compiler = executor.jump(compiler, done)
    compiler = executor.label(compiler, tree)
    compiler = executor.load_immediate(compiler, backend.ARG2, 2)
    compiler = executor.add_immediate(compiler, backend.ARG6, backend.ERROR, words.payload + words.tree_root)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, words.group_item)
    compiler = executor.jump(compiler, items)
    compiler = executor.label(compiler, group)
    compiler = executor.load(compiler, backend.ARG2, backend.ERROR, words.payload)
    compiler = executor.add_immediate(compiler, backend.ARG6, backend.ERROR, words.payload + words.group_items)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, words.group_item)
    compiler = executor.jump(compiler, items)
    compiler = executor.label(compiler, box)
    compiler = executor.load(compiler, backend.ARG2, backend.ERROR, words.payload)
    compiler = executor.add_immediate(compiler, backend.ARG6, backend.ERROR, words.payload + words.box_fields + words.box_field_value)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, words.box_field)
    compiler = executor.label(compiler, items)
    (cap > 0) {
        compiler = executor.load_immediate(compiler, backend.SCRATCH1, cap)
        compiler = executor.branch_less_unsigned(compiler, backend.ARG2, backend.SCRATCH1, "{prefix}_under")
        compiler = executor.move(compiler, backend.ARG2, backend.SCRATCH1)
        compiler = executor.label(compiler, "{prefix}_under")
    }
    compiler = executor.load_address(compiler, backend.SCRATCH1, WALK_STRIDE_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.SCRATCH1, 0)
    compiler = executor.label(compiler, "{prefix}_item")
    compiler = executor.branch_zero(compiler, backend.ARG2, done)
    compiler = emit_visit(compiler, visitor, backend.ARG6, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH1, WALK_STRIDE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.SCRATCH1, 0)
    compiler = executor.add(compiler, backend.ARG6, backend.ARG6, backend.SCRATCH0)
    compiler = executor.add_immediate(compiler, backend.ARG2, backend.ARG2, -1)
    compiler = executor.jump(compiler, "{prefix}_item")
    compiler = executor.label(compiler, done)
    out compiler
}

skill reserve_word(compiler, label) {
    @executor = compiler.executor
    compiler = executor.data_label(compiler, backend.BSS, label)
    out executor.reserve(compiler, wide.from_number(compiler.words.bytes))
}
