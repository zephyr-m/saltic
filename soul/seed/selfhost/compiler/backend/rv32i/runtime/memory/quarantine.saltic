-- quarantine — карантин хранилища: объекты без рёбер хранилище → хранилище
-- (счётчик 0), которые ещё могут держать слоты стека или объекты живой кучи.
-- Страницы [следующая, занято, записи (адрес, подсказка)…] с низа хранилища.
-- Разбор при каждом выходе региона (rt_region_exit → rt_quarantine_sweep): не
-- больше rt_sweep_batch (QUARANTINE_BATCH) записей за раз, по кругу от курсора
-- (rt_sweep_page / rt_sweep_index), не больше одного круга; записи, добавленные
-- каскадом во время разбора, входят в тот же круг. rt_quarantine_drain —
-- разбор до конца (круги, пока записи убывают; стек — от текущего STACK), зовёт
-- rt_store_pages при отказе: единственный путь без границы времени — восстановление
-- после нехватки. rt_sweep_busy — страж повторного входа. Запись: счётчик стал больше нуля —
-- снята; держатель есть (значение out, слово стека [ARG3 выхода, rt_stack_base)
-- или живой кучи [heap_start, HEAP_TOP); куча больше QUARANTINE_HEAP_SCAN_WORDS слов —
-- объект считается удержанным без сканирования) — остаётся, с подсказкой «где нашли» для
-- следующего раза; иначе объект освобождается: у детей счётчик −1, ноль — в
-- карантин (место обеспечивается заранее, нет места — объект ждёт).
-- Команды — методами compiler.executor (договор backend).
--
-- emit_quarantine(compiler) — rt_quarantine_ensure(VALUE мест) / rt_quarantine_add(VALUE
--     адрес) и остальные метки: rt_quarantine_held(VALUE адрес, ERROR запись) -> 1/0,
--     rt_store_release(VALUE адрес) — освободить с каскадом, rt_quarantine_sweep
-- emit_store_visit_drop(compiler) — посетитель освобождения (счётчик −1 у детей)
-- quarantine_entries / quarantine_capacity(words) — раскладка страницы

use selfhost.abi
use selfhost.memory.model
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.runtime.tails
use selfhost.compiler.backend.rv32i.runtime.memory.walk

DRAIN_BATCH = 268435455

skill quarantine_entries(words) {
    out words.bytes * 2
}

skill quarantine_capacity(words) {
    out (model.STORE_PAGE_BYTES - quarantine_entries(words)) / (words.bytes * 2)
}

skill emit_store_visit_drop(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_store_visit_drop")
    compiler = walk.emit_store_pointer(compiler, ".L_visit_drop_done")
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, -model.STORE_RC_UNIT)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH3, model.STORE_RC_SHIFT)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_visit_drop_done")
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH3, model.STORE_QUARANTINED)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_visit_drop_done")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.ARG7, backend.STACK, words.bytes * 2)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes)
    compiler = executor.move(compiler, backend.VALUE, backend.SCRATCH2)
    compiler = executor.call(compiler, "rt_quarantine_add")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.load(compiler, backend.ARG7, backend.STACK, words.bytes * 2)
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.label(compiler, ".L_visit_drop_done")
    out executor.ret(compiler)
}

skill emit_quarantine(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    @entries = quarantine_entries(words)
    @capacity = quarantine_capacity(words)
    compiler = executor.label(compiler, "rt_quarantine_ensure")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_quarantine_grow")
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
    compiler = executor.add(compiler, backend.SCRATCH2, backend.SCRATCH2, backend.VALUE)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, capacity)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH3, backend.SCRATCH2, ".L_quarantine_grow")
    compiler = tails.ok(compiler)
    compiler = executor.label(compiler, ".L_quarantine_grow")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.load_immediate(compiler, backend.VALUE, 1)
    compiler = executor.call(compiler, "rt_store_pages")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.branch_nonzero(compiler, backend.ERROR, ".L_quarantine_refused")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.VALUE, 0)
    compiler = executor.store_zero(compiler, backend.VALUE, words.bytes)
    compiler = executor.store(compiler, backend.VALUE, backend.SCRATCH0, 0)
    compiler = tails.ok(compiler)
    compiler = executor.label(compiler, ".L_quarantine_refused")
    compiler = executor.ret(compiler)

    compiler = executor.label(compiler, "rt_quarantine_add")
    compiler = executor.load(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH3, model.STORE_QUARANTINED)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_quarantine_added")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * 2)
    compiler = executor.load_immediate(compiler, backend.VALUE, 1)
    compiler = executor.call(compiler, "rt_quarantine_ensure")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * 2)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.branch_nonzero(compiler, backend.ERROR, ".L_quarantine_add_refused")
    compiler = executor.load(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.or_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, model.STORE_QUARANTINED)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH2, words.shift + 1)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH1, backend.SCRATCH3)
    compiler = executor.store(compiler, backend.VALUE, backend.SCRATCH3, entries)
    compiler = executor.store_zero(compiler, backend.SCRATCH3, entries + words.bytes)
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BUSY_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_quarantine_added")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_LEFT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.label(compiler, ".L_quarantine_added")
    compiler = tails.ok(compiler)
    compiler = executor.label(compiler, ".L_quarantine_add_refused")
    compiler = executor.ret(compiler)

    compiler = emit_quarantine_held(compiler)
    compiler = emit_store_release(compiler)
    out emit_quarantine_sweep(compiler)
}

skill emit_quarantine_held(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_quarantine_held")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_VALUE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.SCRATCH0, 0)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, abi.PAYLOAD_MASK)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.VALUE, ".L_held_yes_plain")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_FROM_LABEL, 0)
    compiler = executor.load(compiler, backend.ARG6, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.STACK_BASE_LABEL, 0)
    compiler = executor.load(compiler, backend.ARG7, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.HEAP_START_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH4, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.ERROR, words.bytes)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_held_scan_stack")
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH1, backend.ARG6, ".L_held_hint_heap")
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH1, backend.ARG7, ".L_held_hint_heap")
    compiler = executor.jump(compiler, ".L_held_hint_check")
    compiler = executor.label(compiler, ".L_held_hint_heap")
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH4, ".L_held_scan_stack")
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH1, backend.HEAP_TOP, ".L_held_scan_stack")
    compiler = executor.label(compiler, ".L_held_hint_check")
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, 0)
    compiler = executor.and_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, abi.PAYLOAD_MASK)
    compiler = executor.branch_equal(compiler, backend.SCRATCH2, backend.VALUE, ".L_held_yes_plain")
    compiler = executor.label(compiler, ".L_held_scan_stack")
    compiler = executor.sub(compiler, backend.SCRATCH2, backend.HEAP_TOP, backend.SCRATCH4)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, model.QUARANTINE_HEAP_SCAN_WORDS * words.bytes)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH3, backend.SCRATCH2, ".L_held_yes_plain")
    compiler = executor.move(compiler, backend.SCRATCH1, backend.ARG6)
    compiler = executor.label(compiler, ".L_held_stack")
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH1, backend.ARG7, ".L_held_scan_heap")
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, 0)
    compiler = executor.and_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, abi.PAYLOAD_MASK)
    compiler = executor.branch_equal(compiler, backend.SCRATCH2, backend.VALUE, ".L_held_yes")
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, words.bytes)
    compiler = executor.jump(compiler, ".L_held_stack")
    compiler = executor.label(compiler, ".L_held_scan_heap")
    compiler = executor.move(compiler, backend.SCRATCH1, backend.SCRATCH4)
    compiler = executor.label(compiler, ".L_held_heap")
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH1, backend.HEAP_TOP, ".L_held_no")
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, 0)
    compiler = executor.and_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, abi.PAYLOAD_MASK)
    compiler = executor.branch_equal(compiler, backend.SCRATCH2, backend.VALUE, ".L_held_yes")
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, words.bytes)
    compiler = executor.jump(compiler, ".L_held_heap")
    compiler = executor.label(compiler, ".L_held_yes")
    compiler = executor.store(compiler, backend.SCRATCH1, backend.ERROR, words.bytes)
    compiler = executor.label(compiler, ".L_held_yes_plain")
    compiler = executor.load_immediate(compiler, backend.VALUE, 1)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_held_no")
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    out executor.ret(compiler)
}

skill emit_store_release(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_store_release")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * 2)
    compiler = executor.load32(compiler, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.OBJECT_KIND_STRING)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 0)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_release_counted")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.OBJECT_KIND_TREE)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 2)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_release_counted")
    compiler = executor.load(compiler, backend.SCRATCH2, backend.VALUE, words.payload)
    compiler = executor.label(compiler, ".L_release_counted")
    compiler = executor.move(compiler, backend.VALUE, backend.SCRATCH2)
    compiler = executor.call(compiler, "rt_quarantine_ensure")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * 2)
    compiler = executor.branch_nonzero(compiler, backend.ERROR, ".L_release_return")
    compiler = executor.move(compiler, backend.ERROR, backend.VALUE)
    compiler = walk.emit_object_walk(compiler, "rt_store_visit_drop", ".L_release")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * 2)
    compiler = executor.call(compiler, "rt_store_free")
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.label(compiler, ".L_release_return")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    out executor.ret(compiler)
}

skill emit_quarantine_sweep(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    @entries = quarantine_entries(words)
    compiler = executor.label(compiler, "rt_quarantine_sweep")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_sweep_start")
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_sweep_start")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BUSY_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH0, 0)
    compiler = executor.branch_zero(compiler, backend.SCRATCH2, ".L_sweep_begin")
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_sweep_begin")
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 1)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH0, 0)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_LEFT_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BATCH_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BUDGET_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_sweep_next")
    compiler = executor.label(compiler, ".L_sweep_top")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_PREV_LABEL, 0)
    compiler = executor.store_zero(compiler, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_INDEX_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH0, 0)
    compiler = executor.label(compiler, ".L_sweep_next")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BUDGET_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.jump_if_zero(compiler, backend.SCRATCH1, ".L_sweep_done")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_LEFT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.jump_if_zero(compiler, backend.SCRATCH1, ".L_sweep_done")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.jump_if_zero(compiler, backend.SCRATCH1, ".L_sweep_top")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_INDEX_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH1, words.bytes)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH3, backend.SCRATCH2, ".L_sweep_page_end")
    compiler = executor.branch_zero(compiler, backend.SCRATCH2, ".L_sweep_page_end")
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, -1)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH0, 0)
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH2, words.shift + 1)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH1, backend.SCRATCH3)
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, entries)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_ENTRY_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_LEFT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, -1)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BUDGET_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, -1)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH3, 0)
    compiler = executor.load(compiler, backend.SCRATCH4, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH4, model.STORE_RC_SHIFT)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_sweep_referenced")
    compiler = executor.move(compiler, backend.ERROR, backend.SCRATCH3)
    compiler = executor.call(compiler, "rt_quarantine_held")
    compiler = executor.jump_if_nonzero(compiler, backend.VALUE, ".L_sweep_next")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_ENTRY_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH3, 0)
    compiler = executor.call(compiler, "rt_store_release")
    compiler = executor.jump_if_nonzero(compiler, backend.ERROR, ".L_sweep_next")
    compiler = executor.jump(compiler, ".L_sweep_remove")
    compiler = executor.label(compiler, ".L_sweep_referenced")
    compiler = executor.and_immediate(compiler, backend.SCRATCH4, backend.SCRATCH4, -model.STORE_QUARANTINED - 1)
    compiler = executor.store(compiler, backend.SCRATCH4, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.label(compiler, ".L_sweep_remove")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_ENTRY_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, -1)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH1, words.bytes)
    compiler = executor.shift_left(compiler, backend.SCRATCH4, backend.SCRATCH2, words.shift + 1)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.SCRATCH1, backend.SCRATCH4)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.SCRATCH4, entries)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.SCRATCH3, 0)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.SCRATCH4, entries + words.bytes)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.SCRATCH3, words.bytes)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, -1)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.jump(compiler, ".L_sweep_next")
    compiler = executor.label(compiler, ".L_sweep_page_end")
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, 0)
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH1, words.bytes)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH3, ".L_sweep_page_kept")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_PREV_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH0, 0)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH3, ".L_sweep_page_unlink")
    compiler = executor.branch_zero(compiler, backend.SCRATCH2, ".L_sweep_page_kept")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_PAGE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH0, 0)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH3, backend.SCRATCH1, ".L_sweep_page_kept")
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH0, 0)
    compiler = executor.jump(compiler, ".L_sweep_page_free")
    compiler = executor.label(compiler, ".L_sweep_page_unlink")
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH3, 0)
    compiler = executor.label(compiler, ".L_sweep_page_free")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 2)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.STACK, 0)
    compiler = executor.move(compiler, backend.VALUE, backend.SCRATCH1)
    compiler = executor.load_immediate(compiler, backend.ERROR, 1)
    compiler = executor.call(compiler, "rt_store_release_pages")
    compiler = executor.load(compiler, backend.SCRATCH2, backend.STACK, 0)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 2)
    compiler = executor.jump(compiler, ".L_sweep_page_moved")
    compiler = executor.label(compiler, ".L_sweep_page_kept")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_PREV_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.label(compiler, ".L_sweep_page_moved")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_PAGE_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH0, 0)
    compiler = executor.jump_if_zero(compiler, backend.SCRATCH2, ".L_sweep_next")
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH2, words.bytes)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_INDEX_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.SCRATCH0, 0)
    compiler = executor.jump(compiler, ".L_sweep_next")
    compiler = executor.label(compiler, ".L_sweep_done")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BUSY_LABEL, 0)
    compiler = executor.store_zero(compiler, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, "rt_quarantine_drain")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BUSY_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_drain_begin")
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_drain_begin")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * 8)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.store(compiler, backend.ARG2, backend.STACK, words.bytes * 6)
    compiler = executor.store(compiler, backend.ARG5, backend.STACK, words.bytes * 5)
    compiler = executor.store(compiler, backend.ARG6, backend.STACK, words.bytes * 4)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.WALK_STRIDE_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 3)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_FROM_LABEL, 0)
    compiler = executor.store(compiler, backend.STACK, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_VALUE_LABEL, 0)
    compiler = executor.store_zero(compiler, backend.SCRATCH0, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BATCH_LABEL, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, DRAIN_BATCH)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.label(compiler, ".L_drain_round")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_drain_done")
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 2)
    compiler = executor.call(compiler, "rt_quarantine_sweep")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.STACK, words.bytes * 2)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_drain_round")
    compiler = executor.label(compiler, ".L_drain_done")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_BATCH_LABEL, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, model.QUARANTINE_BATCH)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 3)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.WALK_STRIDE_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load(compiler, backend.ARG6, backend.STACK, words.bytes * 4)
    compiler = executor.load(compiler, backend.ARG5, backend.STACK, words.bytes * 5)
    compiler = executor.load(compiler, backend.ARG2, backend.STACK, words.bytes * 6)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 8)
    out executor.ret(compiler)
}
