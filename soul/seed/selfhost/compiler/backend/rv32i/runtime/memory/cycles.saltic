-- cycles — проверка цикла ссылок при записи в хранилище: rt_cycle_reach(VALUE
-- адрес нового объекта хранилища, ERROR адрес Box, ARG2 старое слово поля) —
-- достижим ли Box из нового. Обход в ширину по хранилищу очередью пар (объект,
-- слово-тень) над HEAP_TOP с пометкой STORE_MARK (снимается в конце); строки и
-- группы без Box (STORE_BOX_FREE) не обходятся — цикл проходит только через Box.
-- Старое значение поля не ведёт к Box (иначе кольцо было бы ещё до записи), поэтому
-- всё, что было достижимо из старого, обходить не нужно: сначала помечаются само
-- старое значение и первые CYCLE_FRONT его детей (старый фронт — он же не даёт
-- обходить старый хвост и корень дерева группы, когда group.add переставляет их),
-- потом новое значение идёт в ногу со старым: тень объекта — старое значение или
-- слово той же позиции в тени родителя того же вида; ребёнок, равный слову тени, —
-- старый, в очередь не идёт (у дерева групп новыми оказываются только путь до хвоста
-- и сам элемент, у плоской группы — добавленные). Не больше CYCLE_BUDGET объектов
-- (пар в очереди, старый фронт в счёте): нашли Box — ERROR_CYCLE_FORBIDDEN, не
-- уложились — ERROR_CYCLE_CHECK_EXHAUSTED. Зовёт rt_box_set, только когда у Box есть
-- рёбра из хранилища (иначе цикл невозможен: указатель на сам Box внутри
-- перевозимого ловит rt_store_move). Слова bss: rt_reach_delta — тень минус объект,
-- rt_reach_limit — конец тени (0 — тени нет).
-- Команды — методами compiler.executor (договор backend).
--
-- emit_store_visit_reach(compiler) — посетитель обхода
-- emit_cycle_reach(compiler) — rt_cycle_reach

use selfhost.abi
use selfhost.memory.model
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.runtime.tails
use selfhost.compiler.backend.rv32i.runtime.memory.walk

REACH_OLD = 0
REACH_RETURN = 3
REACH_FRAME_WORDS = 4

skill emit_store_visit_reach(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_store_visit_reach")
    compiler = walk.emit_store_pointer(compiler, ".L_visit_reach_done")
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.REACH_BOX_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH1, 0)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_visit_reach_other")
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.REACH_FOUND_LABEL, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, 1)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.SCRATCH1, 0)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_visit_reach_other")
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH3, model.STORE_MARK + model.STORE_BOX_FREE)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_visit_reach_done")
    compiler = executor.load32(compiler, backend.SCRATCH1, backend.SCRATCH2, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, abi.OBJECT_KIND_STRING)
    compiler = executor.branch_equal(compiler, backend.SCRATCH1, backend.SCRATCH4, ".L_visit_reach_done")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.REACH_DELTA_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.SCRATCH0, 0)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.ARG6, backend.SCRATCH0)
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.REACH_LIMIT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH1, 0)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_visit_reach_bare")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.SCRATCH0, 0)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.ARG7, ".L_visit_reach_done")
    compiler = executor.jump(compiler, ".L_visit_reach_push")
    compiler = executor.label(compiler, ".L_visit_reach_bare")
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, 0)
    compiler = executor.label(compiler, ".L_visit_reach_push")
    compiler = executor.load_address(compiler, backend.SCRATCH4, walk.REACH_END_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH4, 0)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH1, backend.ARG4, ".L_visit_reach_room")
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.REACH_OVER_LABEL, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, 1)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.SCRATCH1, 0)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_visit_reach_room")
    compiler = executor.or_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, model.STORE_MARK)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH1, 0)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.SCRATCH1, words.bytes)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, words.bytes * 2)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH4, 0)
    compiler = executor.label(compiler, ".L_visit_reach_done")
    out executor.ret(compiler)
}

skill emit_reach_shadow(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.load(compiler, backend.ARG7, backend.ARG5, words.bytes)
    compiler = walk.emit_store_pointer(compiler, ".L_reach_bare")
    compiler = executor.load32(compiler, backend.SCRATCH0, backend.SCRATCH2, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load32(compiler, backend.SCRATCH1, backend.ERROR, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_reach_bare")
    compiler = executor.sub(compiler, backend.SCRATCH1, backend.SCRATCH2, backend.ERROR)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.REACH_DELTA_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load32(compiler, backend.SCRATCH1, backend.SCRATCH2, abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET)
    compiler = executor.add(compiler, backend.SCRATCH1, backend.SCRATCH1, backend.SCRATCH2)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, words.header)
    compiler = executor.jump(compiler, ".L_reach_shadow")
    compiler = executor.label(compiler, ".L_reach_bare")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, 0)
    compiler = executor.label(compiler, ".L_reach_shadow")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.REACH_LIMIT_LABEL, 0)
    out executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
}

skill emit_cycle_reach(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    @w = words.bytes
    compiler = executor.label(compiler, "rt_cycle_reach")
    compiler = executor.jump_if_equal(compiler, backend.VALUE, backend.ERROR, ".L_reach_cycle")
    compiler = executor.load(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH3, model.STORE_BOX_FREE)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_reach_ok")
    compiler = executor.load32(compiler, backend.SCRATCH1, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, abi.OBJECT_KIND_STRING)
    compiler = executor.branch_equal(compiler, backend.SCRATCH1, backend.SCRATCH4, ".L_reach_ok")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -w * REACH_FRAME_WORDS)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, w * REACH_RETURN)
    compiler = executor.store(compiler, backend.ARG2, backend.STACK, w * REACH_OLD)
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.REACH_BOX_LABEL, 0)
    compiler = executor.store(compiler, backend.ERROR, backend.SCRATCH1, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.REACH_FOUND_LABEL, 0)
    compiler = executor.store_zero(compiler, backend.SCRATCH1, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.REACH_OVER_LABEL, 0)
    compiler = executor.store_zero(compiler, backend.SCRATCH1, 0)
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.REACH_LIMIT_LABEL, 0)
    compiler = executor.store_zero(compiler, backend.SCRATCH1, 0)
    compiler = executor.move(compiler, backend.ARG3, backend.HEAP_TOP)
    compiler = executor.add_immediate(compiler, backend.ARG4, backend.HEAP_TOP, model.CYCLE_BUDGET * w * 2)
    compiler = executor.set_less_unsigned(compiler, backend.SCRATCH1, backend.STORE_BOTTOM, backend.ARG4)
    compiler = executor.jump_if_nonzero(compiler, backend.SCRATCH1, ".L_reach_no_room")
    compiler = executor.load_address(compiler, backend.SCRATCH2, walk.REACH_END_LABEL, 0)
    compiler = executor.store(compiler, backend.ARG3, backend.SCRATCH2, 0)
    compiler = walk.emit_visit(compiler, "rt_store_visit_reach", backend.STACK, w * REACH_OLD)
    compiler = executor.load_address(compiler, backend.SCRATCH2, walk.REACH_END_LABEL, 0)
    compiler = executor.load(compiler, backend.ARG5, backend.SCRATCH2, 0)
    compiler = executor.branch_equal(compiler, backend.ARG5, backend.ARG3, ".L_reach_fronted")
    compiler = executor.load(compiler, backend.ERROR, backend.ARG3, 0)
    compiler = walk.emit_object_front(compiler, "rt_store_visit_reach", ".L_reach_front", model.CYCLE_FRONT)
    compiler = executor.load_address(compiler, backend.SCRATCH2, walk.REACH_END_LABEL, 0)
    compiler = executor.load(compiler, backend.ARG5, backend.SCRATCH2, 0)
    compiler = executor.label(compiler, ".L_reach_fronted")
    compiler = executor.load(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH3, model.STORE_MARK)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_reach_scanned")
    compiler = executor.or_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, model.STORE_MARK)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.store(compiler, backend.VALUE, backend.ARG5, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, w * REACH_OLD)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.ARG5, w)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.ARG5, w * 2)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH2, 0)
    compiler = executor.label(compiler, ".L_reach_scan")
    compiler = executor.load_address(compiler, backend.SCRATCH2, walk.REACH_END_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH2, 0)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ARG5, backend.SCRATCH2, ".L_reach_scanned")
    compiler = executor.load(compiler, backend.ERROR, backend.ARG5, 0)
    compiler = emit_reach_shadow(compiler)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -w * 2)
    compiler = executor.store(compiler, backend.ARG5, backend.STACK, 0)
    compiler = walk.emit_object_walk(compiler, "rt_store_visit_reach", ".L_reach_walk")
    compiler = executor.load(compiler, backend.ARG5, backend.STACK, 0)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, w * 2)
    compiler = executor.load_address(compiler, backend.SCRATCH2, walk.REACH_FOUND_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH2, 0)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH2, ".L_reach_scanned")
    compiler = executor.add_immediate(compiler, backend.ARG5, backend.ARG5, w * 2)
    compiler = executor.jump(compiler, ".L_reach_scan")
    compiler = executor.label(compiler, ".L_reach_scanned")
    compiler = executor.move(compiler, backend.ARG5, backend.ARG3)
    compiler = executor.load_address(compiler, backend.SCRATCH2, walk.REACH_END_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH2, 0)
    compiler = executor.label(compiler, ".L_reach_unmark")
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ARG5, backend.SCRATCH2, ".L_reach_unmarked")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.ARG5, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, -model.STORE_MARK - 1)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.add_immediate(compiler, backend.ARG5, backend.ARG5, w * 2)
    compiler = executor.jump(compiler, ".L_reach_unmark")
    compiler = executor.label(compiler, ".L_reach_unmarked")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, w * REACH_RETURN)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, w * REACH_FRAME_WORDS)
    compiler = executor.load_address(compiler, backend.SCRATCH2, walk.REACH_FOUND_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH2, 0)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH2, ".L_reach_cycle")
    compiler = executor.load_address(compiler, backend.SCRATCH2, walk.REACH_OVER_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH2, 0)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH2, ".L_reach_over")
    compiler = executor.label(compiler, ".L_reach_ok")
    compiler = tails.ok(compiler)
    compiler = executor.label(compiler, ".L_reach_no_room")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, w * REACH_RETURN)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, w * REACH_FRAME_WORDS)
    compiler = tails.fail(compiler, ".L_reach_over", abi.ERROR_CYCLE_CHECK_EXHAUSTED)
    out tails.fail(compiler, ".L_reach_cycle", abi.ERROR_CYCLE_FORBIDDEN)
}
