-- tails — общие хвосты навыков рантайма и платформ: успешный возврат и
-- заглушка системной ошибки. Команды — методами compiler.executor.
--
-- ok(compiler) — ERROR = CALL_NO_ERROR и возврат (VALUE не трогает)
-- fail(compiler, label, error_id) — метка label: VALUE = 0, ERROR = error_id, возврат

use selfhost.abi
use selfhost.compiler.backend

skill ok(compiler) {
    @executor = compiler.executor
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill fail(compiler, label, error_id) {
    @executor = compiler.executor
    compiler = executor.label(compiler, label)
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    compiler = executor.load_immediate(compiler, backend.ERROR, error_id)
    out executor.ret(compiler)
}
