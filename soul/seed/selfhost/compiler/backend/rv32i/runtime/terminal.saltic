-- terminal — рантайм терминала: io.key через платформу (rt_platform_key —
-- имя клавиши или байты) и io.clear (ESC-последовательность в rt_platform_write).
-- Каждый навык берёт и отдаёт compiler.
-- Команды — методами compiler.executor (договор backend), регистры — его роли.
--
-- emit_key(compiler) — rt_io_key -> rt_platform_key; emit_clear(compiler) — rt_io_clear
-- append_text(compiler, label, text) — статическая строка-объект в rodata
-- append_data(compiler) — rt_clear_sequence
-- append_runtime(compiler) — rt_io_key + rt_io_clear

use core.str
use core.group
use selfhost.abi
use selfhost.compiler.backend
use selfhost.compiler.constants
use selfhost.machine.word
use selfhost.compiler.platform

STDOUT = 1

CLEAR_SEQUENCE = [27, 91, 50, 74, 27, 91, 72]

skill emit_key(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_io_key")
    out executor.jump(compiler, platform.KEY)
}

skill emit_clear(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_io_clear")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.load_immediate(compiler, backend.VALUE, STDOUT)
    compiler = executor.load_address(compiler, backend.ERROR, "rt_clear_sequence", 0)
    compiler = executor.load_immediate(compiler, backend.ARG2, group.count(CLEAR_SEQUENCE))
    compiler = executor.call(compiler, platform.WRITE)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}
skill append_text(compiler, label, text) {
    @executor = compiler.executor
    compiler = executor.align(compiler, backend.RODATA, 8)
    compiler = executor.data_label(compiler, backend.RODATA, label)
    compiler = constants.emit_static_header(compiler, backend.RODATA, abi.OBJECT_KIND_STRING, constants.string_storage_bytes(compiler.words, str.bytes(text)))
    compiler = executor.data_word(compiler, backend.RODATA, word.from_number(str.bytes(text)))
    compiler = executor.data_text(compiler, backend.RODATA, text)
    out compiler
}

skill append_data(compiler) {
    @executor = compiler.executor
    compiler = executor.data_label(compiler, backend.RODATA, "rt_clear_sequence")
    drum (CLEAR_SEQUENCE) {
        compiler = executor.data_byte(compiler, backend.RODATA, beat)
    }
    out compiler
}
skill append_runtime(compiler) {
    compiler = emit_key(compiler)
    out emit_clear(compiler)
}
