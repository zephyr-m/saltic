-- host — рантайм хоста: вывод, выход, файлы, текст значений и ошибок,
-- вызовы процессора и прошивки (ecall с номерами из core.system).
-- Каждый навык берёт и отдаёт compiler, определяя метку rt_* в коде.
-- rt_platform_write/exit — только для Linux; на qemu-virt и UEFI их даёт
-- платформа, поэтому runtime.append_runtime_common их не включает.
--
-- emit_platform_write / emit_platform_exit(compiler) — write / exit Linux
-- emit_newline(compiler) — rt_newline; emit_missing_args(compiler) — выход
-- emit_show(compiler) — rt_show: строка, число, yes/no, ошибка
-- emit_value_text(compiler) — rt_value_text -> строка для "{…}"
-- emit_error_text(compiler) — rt_error_text: имя ошибки по id (системные и
--     пользовательские); emit_error_case / error_text_label — части
-- emit_file_read / emit_file_write(compiler) — rt_file_read / rt_file_write
--     (строка, до 1 МБ чтения); emit_file_error — ERROR_FILE
-- emit_file_write_bytes / emit_file_write_byte_group(compiler) — группа
--     байтов или кусков core.bytes в файл
-- emit_cpu_wait / emit_cpu_fence(compiler) — wfi / fence
-- emit_cpu_firmware / emit_cpu_call(compiler) — ecall в прошивку

use selfhost.abi
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.assembler
use core.process
use core.system
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.compiler.backend.rv32i.runtime.terminal
use core.group

skill emit_newline(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_newline")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 1)
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A1, "rt_newline_text", 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, 1)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler.machine = layout.emit_call(compiler.machine, "rt_platform_write")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_missing_args(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_missing_args")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, process.EXIT_MISSING_ARGUMENTS)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_platform_exit")
    out compiler
}

skill emit_platform_write(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_platform_write")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_WRITE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_platform_exit(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_platform_exit")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_EXIT)
    out assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
}

skill emit_cpu_firmware(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_cpu_firmware")
    compiler = assembler.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_FIRMWARE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_cpu_wait(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_cpu_wait")
    compiler = assembler.emit_op(compiler, instruction.Kind.WFI, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_cpu_fence(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_cpu_fence")
    compiler = assembler.emit_op(compiler, instruction.Kind.FENCE, registers.ZERO, registers.ZERO, registers.ZERO, 51)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_file_write(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_file_write")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -32)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 28)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, -100)
    compiler.machine = layout.emit_load_immediate(compiler.machine, registers.A2, 577)
    compiler.machine = layout.emit_load_immediate(compiler.machine, registers.A3, 420)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_OPENAT)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.ZERO, "rt_file_error")
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.T0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_WRITE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_CLOSE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_file_error(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_file_error")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.ERROR_FILE)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_file_read(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_file_read")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -32)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 28)
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, -100)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A3, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_OPENAT)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.ZERO, "rt_file_error")
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 24)
    compiler.machine = layout.emit_load_immediate(compiler.machine, registers.A0, 1048581)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_STRING)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A1, registers.SP, registers.ZERO, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.A1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler.machine = layout.emit_load_immediate(compiler.machine, registers.A2, 1048576)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_READ)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.ZERO, "rt_file_error")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.T0, registers.A0, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADD, registers.T1, registers.T0, registers.A0, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_CLOSE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_file_write_bytes(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_file_write_bytes")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -32)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 28)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A1, registers.ZERO, 0)
    compiler.machine = layout.emit_call(compiler.machine, "rt_group_flatten")
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, -100)
    compiler.machine = layout.emit_load_immediate(compiler.machine, registers.A2, 577)
    compiler.machine = layout.emit_load_immediate(compiler.machine, registers.A3, 420)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_OPENAT)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.ZERO, "rt_file_error")
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.T0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T0, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T1, 12)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T1, registers.ZERO, ".L_file_write_bytes_close")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T3, registers.T2, registers.ZERO, abi.TAG_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T4, registers.ZERO, registers.ZERO, abi.TAG_BOX)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T3, registers.T4, ".L_file_write_bytes_chunks")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A1, registers.SP, registers.ZERO, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.SP, registers.ZERO, 12)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A3, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_call(compiler.machine, "rt_file_write_byte_group")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.ZERO, "rt_file_error")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_file_write_bytes_close")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_file_write_bytes_chunks")
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.ZERO, 8)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_file_write_bytes_chunk_loop")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 8)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 12)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_file_write_bytes_close")
    compiler = assembler.emit_op(compiler, instruction.Kind.SLLI, registers.T2, registers.T0, registers.ZERO, 2)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T3, registers.SP, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADD, registers.T2, registers.T3, registers.T2, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T3, registers.T2, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T3, registers.T3, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A1, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.T3, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SRAI, registers.A2, registers.A2, registers.ZERO, abi.TAG_SHIFT)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A3, registers.ZERO, registers.ZERO, 1)
    compiler.machine = layout.emit_call(compiler.machine, "rt_file_write_byte_group")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BLT, registers.A0, registers.ZERO, "rt_file_error")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 8)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.T0, registers.ZERO, 1)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.T0, 8)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_file_write_bytes_chunk_loop")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_file_write_bytes_close")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_CLOSE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_file_write_byte_group(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_file_write_byte_group")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -32)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 28)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A1, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A2, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A3, 12)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A1, registers.ZERO, 0)
    compiler.machine = layout.emit_call(compiler.machine, "rt_group_flatten")
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.A0, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.SP, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A3, registers.SP, registers.ZERO, 12)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A2, registers.ZERO, ".L_file_write_byte_group_empty")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.A2, registers.ZERO, 5)
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_STRING)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T1, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.A0, 8)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, 20)
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.T0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T1, registers.SP, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T2, registers.SP, registers.ZERO, 8)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_file_write_byte_group_copy")
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T3, registers.T1, ".L_file_write_byte_group_ready")
    compiler = assembler.emit_op(compiler, instruction.Kind.SLLI, registers.T4, registers.T3, registers.ZERO, 2)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADD, registers.T4, registers.T0, registers.T4, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T5, registers.T4, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T6, registers.SP, registers.ZERO, 12)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T6, registers.ZERO, ".L_file_write_byte_group_value")
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T5, registers.T5, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.T5, registers.T5, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_file_write_byte_group_value")
    compiler = assembler.emit_op(compiler, instruction.Kind.SRAI, registers.T5, registers.T5, registers.ZERO, abi.TAG_SHIFT)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADD, registers.T6, registers.T2, registers.T3, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T6, registers.T5, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.T3, registers.ZERO, 1)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_file_write_byte_group_copy")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_file_write_byte_group_ready")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADD, registers.T0, registers.T2, registers.T1, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.SB, registers.ZERO, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.SP, registers.ZERO, 24)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A1, registers.SP, registers.ZERO, 8)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.A1, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.SP, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_WRITE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_file_write_byte_group_return")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_file_write_byte_group_empty")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_file_write_byte_group_return")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 28)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 32)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_value_text(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_value_text")
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.TAG_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_value_text_done")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_NUMBER)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.T1, ".L_value_text_answer")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_number_text")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_answer")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_ERROR)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.T1, ".L_value_text_tag")
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, "rt_error_text")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_tag")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_ANSWER)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_value_text_yes")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_unknown_text", 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_value_text_static")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_yes")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.NO)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A0, registers.T0, ".L_value_text_no")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_yes_text", 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_value_text_static")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_no")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_no_text", 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_static")
    compiler = assembler.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_value_text_done")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_show(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_show")
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.TAG_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_show_string")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_NUMBER)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_show_number")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_ANSWER)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_show_answer")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, abi.TAG_ERROR)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.T0, registers.T1, ".L_show_error")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_unknown_text", 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_number")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler.machine = layout.emit_call(compiler.machine, "rt_number_text")
    compiler.machine = layout.emit_call(compiler.machine, "rt_show")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_answer")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.NO)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BEQ, registers.A0, registers.T0, ".L_show_no")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_yes_text", 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_no")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_no_text", 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_show_string")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_error")
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler.machine = layout.emit_call(compiler.machine, "rt_error_text")
    compiler.machine = layout.emit_call(compiler.machine, "rt_show")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    compiler = assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_show_string")
    compiler = assembler.emit_op(compiler, instruction.Kind.ANDI, registers.T0, registers.A0, registers.ZERO, abi.PAYLOAD_MASK)
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.A2, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.T0, registers.ZERO, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 1)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, -16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.SP, registers.RA, 12)
    compiler.machine = layout.emit_call(compiler.machine, "rt_platform_write")
    compiler = assembler.emit_op(compiler, instruction.Kind.LW, registers.RA, registers.SP, registers.ZERO, 12)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, abi.NONE)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill error_text_label(id) {
    (id == abi.ERROR_FIXED_INTEGER_OVERFLOW) { out "rt_fixed_overflow_text" }
    (id == abi.ERROR_MEMORY_EXHAUSTED) { out "rt_memory_exhausted_text" }
    out "rt_error_name_{id}"
}

skill emit_error_case(compiler, id, name) {
    @label = error_text_label(id)
    (label == "rt_error_name_{id}") { compiler = terminal.append_text(compiler, label, name) }
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.T1, registers.ZERO, registers.ZERO, id)
    compiler.machine = layout.emit_branch(compiler.machine, instruction.Kind.BNE, registers.T0, registers.T1, ".L_error_text_after_{id}")
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, label, 0)
    compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, ".L_error_text_done")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_error_text_after_{id}")
    out compiler
}

skill emit_error_text(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_error_text")
    compiler = assembler.emit_op(compiler, instruction.Kind.SRLI, registers.T0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    drum (group.count(abi.SYSTEM_ERROR_NAMES)) {
        (beat > 0) { compiler = emit_error_case(compiler, beat, group.get(abi.SYSTEM_ERROR_NAMES, beat)) }
    }
    drum (compiler.errors) { compiler = emit_error_case(compiler, beat.value, beat.name) }
    compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, "rt_unknown_text", 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, ".L_error_text_done")
    compiler = assembler.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}

skill emit_cpu_call(compiler) {
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_cpu_call")
    compiler = assembler.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = assembler.emit_op(compiler, instruction.Kind.SRAI, registers.A1, registers.A1, registers.ZERO, abi.TAG_SHIFT)
    compiler = assembler.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.OR, registers.A0, registers.A0, registers.A1, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A7, registers.ZERO, registers.ZERO, system.SYSCALL_FIRMWARE_CALL)
    compiler = assembler.emit_op(compiler, instruction.Kind.ECALL, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    compiler = assembler.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SRLI, registers.A0, registers.A0, registers.ZERO, 16)
    compiler = assembler.emit_op(compiler, instruction.Kind.SLLI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
    compiler = assembler.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
    out assembler.emit_op(compiler, instruction.Kind.JALR, registers.ZERO, registers.RA, registers.ZERO, 0)
}
