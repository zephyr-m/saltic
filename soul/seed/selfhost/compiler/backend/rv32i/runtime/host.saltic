-- host — рантайм хоста: вывод, выход и ошибки входа, файлы, текст значений
-- и ошибок, команды процессора и прошивки. Всё платформенное идёт через
-- метки договора платформы (compiler/platform): rt_platform_write / exit /
-- file_read / file_write / wait / firmware / call.
-- Каждый навык берёт и отдаёт compiler, определяя метку rt_* в коде.
-- Команды — методами compiler.executor (договор backend), регистры — его роли.
--
-- emit_newline(compiler) — rt_newline
-- emit_missing_args(compiler) — rt_missing_args(VALUE n): «нужно n аргументов», выход 64
-- emit_start_failure(compiler) — rt_start_failure(VALUE id): «ошибка: Имя», выход 1
-- emit_show_text(compiler, label) — печать статической строки rodata через rt_show
-- emit_show(compiler) — rt_show: строка, число, yes/no, ошибка
-- emit_value_text(compiler) — rt_value_text -> строка для "{…}"
-- emit_error_text(compiler) — rt_error_text: имя ошибки по id (системные и
--     пользовательские); emit_error_case / error_text_label — части
-- emit_file_write_bytes(compiler) — rt_file_write_bytes(path, группа чисел 0–255)
--     через rt_platform_file_write; emit_file_bytes_text — rt_file_bytes_text(группа,
--     count, cells) -> строка из байтов (cells = 1 — элементы-ячейки Box)
-- emit_cpu_wait / emit_cpu_fence(compiler) — rt_platform_wait / fence
-- emit_cpu_firmware / emit_cpu_call(compiler) — через rt_platform_firmware / call

use selfhost.abi
use core.process
use selfhost.compiler.backend.rv32i.runtime.terminal
use core.group

EXIT_FAILURE = 1
use selfhost.compiler.backend
use selfhost.compiler.platform

skill emit_newline(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_newline")
    compiler = executor.load_immediate(compiler, backend.VALUE, 1)
    compiler = executor.load_address(compiler, backend.ERROR, "rt_newline_text", 0)
    compiler = executor.load_immediate(compiler, backend.ARG2, 1)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.call(compiler, "rt_platform_write")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 16)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_missing_args(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_missing_args")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, 8)
    compiler = emit_show_text(compiler, "rt_need_text")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, 8)
    compiler = executor.call(compiler, "rt_show")
    compiler = emit_show_text(compiler, "rt_arguments_text")
    compiler = executor.call(compiler, "rt_newline")
    compiler = executor.load_immediate(compiler, backend.VALUE, process.EXIT_MISSING_ARGUMENTS)
    out executor.jump(compiler, platform.EXIT)
}

skill emit_start_failure(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_start_failure")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_ERROR)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, 8)
    compiler = emit_show_text(compiler, "rt_failure_text")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, 8)
    compiler = executor.call(compiler, "rt_show")
    compiler = executor.call(compiler, "rt_newline")
    compiler = executor.load_immediate(compiler, backend.VALUE, EXIT_FAILURE)
    out executor.jump(compiler, platform.EXIT)
}

skill emit_show_text(compiler, label) {
    @executor = compiler.executor
    compiler = executor.load_address(compiler, backend.VALUE, label, 0)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    out executor.call(compiler, "rt_show")
}
skill emit_cpu_firmware(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_cpu_firmware")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.call(compiler, platform.FIRMWARE)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 16)
    compiler = executor.branch_nonzero(compiler, backend.ERROR, ".L_cpu_firmware_done")
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.label(compiler, ".L_cpu_firmware_done")
    out executor.ret(compiler)
}
skill emit_cpu_wait(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_cpu_wait")
    out executor.jump(compiler, platform.WAIT)
}
skill emit_cpu_fence(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_cpu_fence")
    compiler = executor.fence(compiler)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_file_write_bytes(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_file_write_bytes")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, 8)
    compiler = executor.move(compiler, backend.VALUE, backend.ERROR)
    compiler = executor.call(compiler, "rt_group_flatten")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.ERROR, backend.SCRATCH0, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = executor.load_immediate(compiler, backend.ARG2, 0)
    compiler = executor.call(compiler, "rt_file_bytes_text")
    compiler = executor.move(compiler, backend.ERROR, backend.VALUE)
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, 8)
    compiler = executor.call(compiler, platform.FILE_WRITE)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 16)
    out executor.ret(compiler)
}
skill emit_file_bytes_text(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_file_bytes_text")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -32)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 28)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, 24)
    compiler = executor.store(compiler, backend.ERROR, backend.STACK, 20)
    compiler = executor.store(compiler, backend.ARG2, backend.STACK, 16)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.ERROR, 5)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.OBJECT_KIND_STRING)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, 20)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.VALUE, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, 8)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, 24)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.STACK, 8)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, 0)
    compiler = executor.label(compiler, ".L_file_bytes_text_copy")
    compiler = executor.branch_equal(compiler, backend.SCRATCH3, backend.SCRATCH1, ".L_file_bytes_text_ready")
    compiler = executor.shift_left(compiler, backend.SCRATCH4, backend.SCRATCH3, 2)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.SCRATCH0, backend.SCRATCH4)
    compiler = executor.load(compiler, backend.SCRATCH5, backend.SCRATCH4, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = executor.load(compiler, backend.ARG2, backend.STACK, 16)
    compiler = executor.branch_zero(compiler, backend.ARG2, ".L_file_bytes_text_value")
    compiler = executor.and_immediate(compiler, backend.SCRATCH5, backend.SCRATCH5, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH5, backend.SCRATCH5, abi.OBJECT_PAYLOAD_OFFSET + 8)
    compiler = executor.label(compiler, ".L_file_bytes_text_value")
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH5, backend.SCRATCH5, abi.TAG_SHIFT)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.SCRATCH2, backend.SCRATCH3)
    compiler = executor.store_byte(compiler, backend.SCRATCH5, backend.SCRATCH4, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, 1)
    compiler = executor.jump(compiler, ".L_file_bytes_text_copy")
    compiler = executor.label(compiler, ".L_file_bytes_text_ready")
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH2, backend.SCRATCH1)
    compiler = executor.store_byte_zero(compiler, backend.SCRATCH0, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.SCRATCH2, abi.TAG_STRING)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, 28)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 32)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}
skill emit_value_text(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_value_text")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.TAG_MASK)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.TAG_STRING)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_value_text_done")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.TAG_NUMBER)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_value_text_answer")
    compiler = executor.jump(compiler, "rt_number_text")
    compiler = executor.label(compiler, ".L_value_text_answer")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.TAG_ERROR)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_value_text_tag")
    compiler = executor.jump(compiler, "rt_error_text")
    compiler = executor.label(compiler, ".L_value_text_tag")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.TAG_ANSWER)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_value_text_yes")
    compiler = executor.load_address(compiler, backend.VALUE, "rt_unknown_text", 0)
    compiler = executor.jump(compiler, ".L_value_text_static")
    compiler = executor.label(compiler, ".L_value_text_yes")
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.NO)
    compiler = executor.branch_equal(compiler, backend.VALUE, backend.SCRATCH0, ".L_value_text_no")
    compiler = executor.load_address(compiler, backend.VALUE, "rt_yes_text", 0)
    compiler = executor.jump(compiler, ".L_value_text_static")
    compiler = executor.label(compiler, ".L_value_text_no")
    compiler = executor.load_address(compiler, backend.VALUE, "rt_no_text", 0)
    compiler = executor.label(compiler, ".L_value_text_static")
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.label(compiler, ".L_value_text_done")
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_show(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_show")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.TAG_MASK)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.TAG_STRING)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_show_string")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.TAG_NUMBER)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_show_number")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.TAG_ANSWER)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_show_answer")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.TAG_ERROR)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_show_error")
    compiler = executor.load_address(compiler, backend.VALUE, "rt_unknown_text", 0)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.jump(compiler, ".L_show_string")
    compiler = executor.label(compiler, ".L_show_number")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.call(compiler, "rt_number_text")
    compiler = executor.call(compiler, "rt_show")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 16)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_show_answer")
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.NO)
    compiler = executor.branch_equal(compiler, backend.VALUE, backend.SCRATCH0, ".L_show_no")
    compiler = executor.load_address(compiler, backend.VALUE, "rt_yes_text", 0)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.jump(compiler, ".L_show_string")
    compiler = executor.label(compiler, ".L_show_no")
    compiler = executor.load_address(compiler, backend.VALUE, "rt_no_text", 0)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.jump(compiler, ".L_show_string")
    compiler = executor.label(compiler, ".L_show_error")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.call(compiler, "rt_error_text")
    compiler = executor.call(compiler, "rt_show")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 16)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_show_string")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.ARG2, backend.SCRATCH0, abi.OBJECT_PAYLOAD_OFFSET)
    compiler = executor.add_immediate(compiler, backend.ERROR, backend.SCRATCH0, abi.OBJECT_PAYLOAD_OFFSET + 4)
    compiler = executor.load_immediate(compiler, backend.VALUE, 1)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.call(compiler, "rt_platform_write")
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 16)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill error_text_label(id) {
    (id == abi.ERROR_FIXED_INTEGER_OVERFLOW) { out "rt_fixed_overflow_text" }
    (id == abi.ERROR_MEMORY_EXHAUSTED) { out "rt_memory_exhausted_text" }
    out "rt_error_name_{id}"
}

skill emit_error_case(compiler, id, name) {
    @executor = compiler.executor
    @label = error_text_label(id)
    (label == "rt_error_name_{id}") { compiler = terminal.append_text(compiler, label, name) }
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, id)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_error_text_after_{id}")
    compiler = executor.load_address(compiler, backend.VALUE, label, 0)
    compiler = executor.jump(compiler, ".L_error_text_done")
    compiler = executor.label(compiler, ".L_error_text_after_{id}")
    out compiler
}

skill emit_error_text(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_error_text")
    compiler = executor.shift_right_unsigned(compiler, backend.SCRATCH0, backend.VALUE, abi.TAG_SHIFT)
    drum (group.count(abi.SYSTEM_ERROR_NAMES)) {
        (beat > 0) { compiler = emit_error_case(compiler, beat, group.get(abi.SYSTEM_ERROR_NAMES, beat)) }
    }
    drum (compiler.errors) { compiler = emit_error_case(compiler, beat.value, beat.name) }
    compiler = executor.load_address(compiler, backend.VALUE, "rt_unknown_text", 0)
    compiler = executor.label(compiler, ".L_error_text_done")
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_cpu_call(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_cpu_call")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -16)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.call(compiler, platform.CALL)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, 12)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 16)
    compiler = executor.branch_nonzero(compiler, backend.ERROR, ".L_cpu_call_done")
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, 16)
    compiler = executor.shift_right_unsigned(compiler, backend.VALUE, backend.VALUE, 16)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.label(compiler, ".L_cpu_call_done")
    out executor.ret(compiler)
}
