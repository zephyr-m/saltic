-- memory — рантайм памяти: rt_alloc и регионы (выход из навыка сжимает кучу,
-- перенося наружу только живые объекты), а дети — хранилище долгого: store
-- (страницы, классы, прогоны), move (переезд значения в хранилище), cycles
-- (проверка цикла при записи), quarantine (освобождение без рёбер при выходе
-- региона); общие обходы и метки — walk. Модель и биты слова учёта — memory.model.
-- Регистры — роли договора backend: HEAP_TOP — вершина кучи, STORE_BOTTOM — низ
-- хранилища (растёт вниз), REGION_MARK — метка региона, STACK_LIMIT — граница стека.
-- Куча: [saltic_heap_start, HEAP_TOP) — регионы, [STORE_BOTTOM, конец квоты) —
-- страницы хранилища; между ними — свободно (и рабочие массивы переноса над HEAP_TOP).
-- Команды — методами compiler.executor (договор backend).
--
-- emit_alloc(compiler) — rt_alloc(VALUE байт) -> адрес в регионе; rt_out_of_memory
-- emit_out_of_memory(compiler) — ERROR_MEMORY_EXHAUSTED вызывающему текущего навыка
--     или выход процесса; emit_stack_exhausted — rt_stack_exhausted: ERROR_STACK_EXHAUSTED
-- emit_region_exit(compiler) — rt_region_exit(VALUE, ERROR, ARG2 = REGION_EXIT_VALUE_SKIPPED
--     — значение не корень, ARG3 — откуда сканировать стек при разборе карантина):
--     копирование, перенос, сжатие, потом rt_quarantine_sweep (и когда регион пуст)
-- emit_region_forward / emit_region_relocate / emit_region_restore(compiler)
--     — посетители одного указателя в ARG7; объект, переехавший в хранилище
--     (FORWARDED), копировальщик не копирует — подставляет адрес переезда
-- Сдвиг переноса — слово walk.DELTA_LABEL в bss; нехватка места при копировании —
--     флаг walk.ABORT_LABEL, rt_region_exit откатывает (.L_region_abort)
-- emit_block_walk / emit_copies_walk / emit_slide — части выхода региона
-- append_runtime(compiler) — все метки памяти, таблица классов и слова bss

use core.group
use selfhost.abi
use selfhost.memory.model
use core.system
use selfhost.compiler.constants
use selfhost.compiler.backend
use selfhost.machine.word
use selfhost.machine.wide
use selfhost.compiler.backend.rv32i.runtime.tails
use selfhost.compiler.backend.rv32i.runtime.memory.walk
use selfhost.compiler.backend.rv32i.runtime.memory.store
use selfhost.compiler.backend.rv32i.runtime.memory.move
use selfhost.compiler.backend.rv32i.runtime.memory.cycles
use selfhost.compiler.backend.rv32i.runtime.memory.quarantine

EXIT_FRAME_WORDS = 4
EXIT_VALUE_WORD = 1
EXIT_ERROR_WORD = 2
EXIT_RETURN_WORD = 3

skill emit_alloc(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_alloc")
    compiler = executor.move(compiler, backend.SCRATCH1, backend.VALUE)
    compiler = executor.branch_less_unsigned(compiler, backend.STORE_BOTTOM, backend.HEAP_TOP, "rt_out_of_memory")
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.VALUE, compiler.words.header + abi.OBJECT_ALIGNMENT - 1)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH0, backend.VALUE, "rt_out_of_memory")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, -abi.OBJECT_ALIGNMENT)
    compiler = executor.sub(compiler, backend.SCRATCH2, backend.STORE_BOTTOM, backend.HEAP_TOP)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH2, backend.SCRATCH0, "rt_out_of_memory")
    compiler = executor.move(compiler, backend.VALUE, backend.HEAP_TOP)
    compiler = executor.add(compiler, backend.HEAP_TOP, backend.HEAP_TOP, backend.SCRATCH0)
    compiler = executor.store32(compiler, backend.SCRATCH1, backend.VALUE, abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET)
    compiler = executor.store_zero(compiler, backend.VALUE, abi.OBJECT_HEADER_FLAGS_OFFSET)
    out tails.ok(compiler)
}

skill emit_out_of_memory(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_out_of_memory")
    compiler = executor.branch_zero(compiler, backend.FRAME, ".L_out_of_memory_exit")
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.ERROR_MEMORY_EXHAUSTED)
    compiler = executor.load_immediate(compiler, backend.ARG2, model.REGION_EXIT_VALUE_SKIPPED)
    compiler = executor.move(compiler, backend.ARG3, backend.FRAME)
    compiler = executor.call(compiler, "rt_region_exit")
    compiler = executor.load(compiler, backend.RETURN, backend.FRAME, constants.return_address_load_offset(compiler.words))
    compiler = executor.load(compiler, backend.REGION_MARK, backend.FRAME, constants.region_mark_load_offset(compiler.words))
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, constants.previous_frame_load_offset(compiler.words))
    compiler = executor.move(compiler, backend.STACK, backend.FRAME)
    compiler = executor.move(compiler, backend.FRAME, backend.SCRATCH0)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_out_of_memory_exit")
    compiler = executor.load_immediate(compiler, backend.VALUE, system.EXIT_OUT_OF_MEMORY)
    compiler = executor.jump(compiler, "rt_platform_exit")
    out compiler
}

skill emit_stack_exhausted(compiler) {
    out tails.fail(compiler, "rt_stack_exhausted", abi.ERROR_STACK_EXHAUSTED)
}

skill emit_block_walk(compiler, visitor, prefix) {
    @executor = compiler.executor
    @loop = "{prefix}_block"
    @done = "{prefix}_block_done"
    compiler = executor.move(compiler, backend.ARG5, backend.ARG3)
    compiler = executor.label(compiler, loop)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ARG5, backend.ARG4, done)
    compiler = executor.move(compiler, backend.ERROR, backend.ARG5)
    compiler = walk.emit_object_walk(compiler, visitor, "{prefix}_walk")
    compiler = walk.emit_object_size(compiler, backend.SCRATCH0, backend.ERROR)
    compiler = executor.add(compiler, backend.ARG5, backend.ERROR, backend.SCRATCH0)
    compiler = executor.jump(compiler, loop)
    compiler = executor.label(compiler, done)
    out compiler
}

skill emit_region_forward(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_region_forward")
    compiler = walk.emit_pointer_address(compiler, ".L_region_forward_done")
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH2, backend.REGION_MARK, ".L_region_forward_done")
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH2, backend.ARG3, ".L_region_forward_done")
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH3, model.FORWARDED)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH1, ".L_region_forward_stored")
    compiler = executor.load32(compiler, backend.SCRATCH3, backend.SCRATCH2, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.set_less_unsigned_immediate(compiler, backend.SCRATCH1, backend.SCRATCH3, walk.KIND_LIMIT)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_region_forward_moved")
    compiler = walk.emit_object_size(compiler, backend.SCRATCH4, backend.SCRATCH2)
    compiler = executor.add(compiler, backend.SCRATCH5, backend.ARG4, backend.SCRATCH4)
    compiler = executor.branch_less_unsigned(compiler, backend.STORE_BOTTOM, backend.SCRATCH5, ".L_region_forward_full")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, 0)
    compiler = executor.label(compiler, ".L_region_forward_copy")
    compiler = executor.branch_equal(compiler, backend.SCRATCH1, backend.SCRATCH4, ".L_region_forward_copied")
    compiler = executor.add(compiler, backend.SCRATCH5, backend.SCRATCH2, backend.SCRATCH1)
    compiler = executor.load(compiler, backend.SCRATCH5, backend.SCRATCH5, 0)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.ARG4, backend.SCRATCH1)
    compiler = executor.store(compiler, backend.SCRATCH5, backend.SCRATCH3, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, words.bytes)
    compiler = executor.jump(compiler, ".L_region_forward_copy")
    compiler = executor.label(compiler, ".L_region_forward_copied")
    compiler = executor.store32(compiler, backend.SCRATCH2, backend.ARG4, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.store32(compiler, backend.ARG4, backend.SCRATCH2, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.or(compiler, backend.ARG7, backend.ARG4, backend.SCRATCH0)
    compiler = executor.add(compiler, backend.ARG4, backend.ARG4, backend.SCRATCH4)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_region_forward_stored")
    compiler = executor.and_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, abi.PAYLOAD_MASK)
    compiler = executor.label(compiler, ".L_region_forward_moved")
    compiler = executor.or(compiler, backend.ARG7, backend.SCRATCH3, backend.SCRATCH0)
    compiler = executor.label(compiler, ".L_region_forward_done")
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_region_forward_full")
    compiler = executor.load_address(compiler, backend.SCRATCH3, walk.ABORT_LABEL, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH5, 1)
    compiler = executor.store(compiler, backend.SCRATCH5, backend.SCRATCH3, 0)
    out executor.ret(compiler)
}

skill emit_region_relocate(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_region_relocate")
    compiler = walk.emit_pointer_address(compiler, ".L_region_relocate_done")
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH2, backend.ARG3, ".L_region_relocate_done")
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH2, backend.ARG4, ".L_region_relocate_done")
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.DELTA_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH1, 0)
    compiler = executor.sub(compiler, backend.ARG7, backend.ARG7, backend.SCRATCH1)
    compiler = executor.label(compiler, ".L_region_relocate_done")
    out executor.ret(compiler)
}

skill emit_region_restore(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_region_restore")
    compiler = walk.emit_pointer_address(compiler, ".L_region_restore_done")
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH2, backend.ARG3, ".L_region_restore_done")
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH2, backend.ARG4, ".L_region_restore_done")
    compiler = executor.load32(compiler, backend.SCRATCH2, backend.SCRATCH2, abi.OBJECT_HEADER_FLAGS_OFFSET)
    compiler = executor.or(compiler, backend.ARG7, backend.SCRATCH2, backend.SCRATCH0)
    compiler = executor.label(compiler, ".L_region_restore_done")
    out executor.ret(compiler)
}

skill emit_copies_walk(compiler, prefix, undo) {
    @executor = compiler.executor
    @loop = "{prefix}_copies"
    @done = "{prefix}_copies_done"
    compiler = executor.move(compiler, backend.ARG5, backend.ARG3)
    compiler = executor.label(compiler, loop)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ARG5, backend.ARG4, done)
    (undo == no) {
        compiler = executor.store_zero(compiler, backend.ARG5, abi.OBJECT_HEADER_FLAGS_OFFSET)
    }
    (undo == yes) {
        compiler = executor.load32(compiler, backend.SCRATCH0, backend.ARG5, abi.OBJECT_HEADER_FLAGS_OFFSET)
        compiler = executor.load32(compiler, backend.SCRATCH1, backend.ARG5, abi.OBJECT_HEADER_KIND_OFFSET)
        compiler = executor.store32(compiler, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_KIND_OFFSET)
    }
    compiler = walk.emit_object_size(compiler, backend.SCRATCH0, backend.ARG5)
    compiler = executor.add(compiler, backend.ARG5, backend.ARG5, backend.SCRATCH0)
    compiler = executor.jump(compiler, loop)
    compiler = executor.label(compiler, done)
    out compiler
}

skill emit_slide(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.move(compiler, backend.SCRATCH0, backend.ARG3)
    compiler = executor.move(compiler, backend.SCRATCH1, backend.REGION_MARK)
    compiler = executor.label(compiler, ".L_region_slide")
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH0, backend.ARG4, ".L_region_slid")
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH0, 0)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.SCRATCH1, 0)
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, words.bytes)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, words.bytes)
    compiler = executor.jump(compiler, ".L_region_slide")
    compiler = executor.label(compiler, ".L_region_slid")
    compiler = executor.sub(compiler, backend.SCRATCH0, backend.ARG4, backend.ARG3)
    out executor.add(compiler, backend.HEAP_TOP, backend.REGION_MARK, backend.SCRATCH0)
}

skill emit_region_exit(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_region_exit")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_FROM_LABEL, 0)
    compiler = executor.store(compiler, backend.ARG3, backend.SCRATCH0, 0)
    compiler = executor.branch_not_equal(compiler, backend.HEAP_TOP, backend.REGION_MARK, ".L_region_exit_work")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.QUARANTINE_COUNT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.SCRATCH0, 0)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH0, ".L_region_exit_work")
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_region_exit_work")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, -words.bytes * EXIT_FRAME_WORDS)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * EXIT_RETURN_WORD)
    compiler = executor.store(compiler, backend.ERROR, backend.STACK, words.bytes * EXIT_ERROR_WORD)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * EXIT_VALUE_WORD)
    compiler = executor.branch_equal(compiler, backend.HEAP_TOP, backend.REGION_MARK, ".L_region_exit_sweep")
    compiler = executor.move(compiler, backend.ARG3, backend.HEAP_TOP)
    compiler = executor.move(compiler, backend.ARG4, backend.HEAP_TOP)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.ABORT_LABEL, 0)
    compiler = executor.store_zero(compiler, backend.SCRATCH0, 0)
    compiler = executor.branch_nonzero(compiler, backend.ARG2, ".L_region_exit_roots")
    compiler = walk.emit_visit(compiler, "rt_region_forward", backend.STACK, words.bytes * EXIT_VALUE_WORD)
    compiler = executor.label(compiler, ".L_region_exit_roots")
    compiler = emit_block_walk(compiler, "rt_region_forward", ".L_region_scan")
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.ABORT_LABEL, 0)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.SCRATCH0, 0)
    compiler = executor.branch_nonzero(compiler, backend.SCRATCH0, ".L_region_abort")
    compiler = emit_copies_walk(compiler, ".L_region_settle", no)
    compiler = executor.sub(compiler, backend.SCRATCH0, backend.ARG3, backend.REGION_MARK)
    compiler = executor.load_address(compiler, backend.SCRATCH1, walk.DELTA_LABEL, 0)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.SCRATCH1, 0)
    compiler = walk.emit_visit(compiler, "rt_region_relocate", backend.STACK, words.bytes * EXIT_VALUE_WORD)
    compiler = emit_block_walk(compiler, "rt_region_relocate", ".L_region_relocated")
    compiler = emit_slide(compiler)
    compiler = executor.jump(compiler, ".L_region_exit_sweep")
    compiler = executor.label(compiler, ".L_region_abort")
    compiler = emit_copies_walk(compiler, ".L_region_undo", yes)
    compiler = walk.emit_visit(compiler, "rt_region_restore", backend.STACK, words.bytes * EXIT_VALUE_WORD)
    compiler = executor.label(compiler, ".L_region_exit_sweep")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * EXIT_VALUE_WORD)
    compiler = executor.load_address(compiler, backend.SCRATCH0, walk.SWEEP_VALUE_LABEL, 0)
    compiler = executor.store(compiler, backend.VALUE, backend.SCRATCH0, 0)
    compiler = executor.call(compiler, "rt_quarantine_sweep")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * EXIT_VALUE_WORD)
    compiler = executor.load(compiler, backend.ERROR, backend.STACK, words.bytes * EXIT_ERROR_WORD)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * EXIT_RETURN_WORD)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * EXIT_FRAME_WORDS)
    out executor.ret(compiler)
}

skill append_runtime(compiler) {
    compiler = emit_alloc(compiler)
    compiler = emit_out_of_memory(compiler)
    compiler = emit_stack_exhausted(compiler)
    compiler = emit_region_exit(compiler)
    compiler = emit_region_forward(compiler)
    compiler = emit_region_relocate(compiler)
    compiler = emit_region_restore(compiler)
    compiler = store.emit_store_init(compiler)
    compiler = store.emit_store_pages(compiler)
    compiler = store.emit_store_release_pages(compiler)
    compiler = store.emit_store_run(compiler)
    compiler = store.emit_store_cell(compiler)
    compiler = store.emit_store_free(compiler)
    compiler = move.emit_store_copy(compiler)
    compiler = move.emit_store_visit_copy(compiler)
    compiler = move.emit_store_visit_count(compiler)
    compiler = move.emit_store_visit_peel(compiler)
    compiler = move.emit_store_visit_rc(compiler)
    compiler = move.emit_store_visit_boxfree(compiler)
    compiler = move.emit_store_move(compiler)
    compiler = move.emit_store_keep(compiler)
    compiler = cycles.emit_store_visit_reach(compiler)
    compiler = cycles.emit_cycle_reach(compiler)
    compiler = quarantine.emit_store_visit_drop(compiler)
    compiler = quarantine.emit_quarantine(compiler)
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.align(compiler, backend.RODATA, words.bytes)
    compiler = executor.data_label(compiler, backend.RODATA, walk.STORE_CLASSES_LABEL)
    drum (model.STORE_CLASSES) { compiler = executor.data_word(compiler, backend.RODATA, word.from_number(beat)) }
    compiler = executor.align(compiler, backend.BSS, words.bytes)
    drum (walk.BSS_WORDS) { compiler = walk.reserve_word(compiler, beat) }
    compiler = executor.data_label(compiler, backend.BSS, walk.STORE_PARTIAL_LABEL)
    out executor.reserve(compiler, wide.from_number(words.bytes * group.count(model.STORE_CLASSES)))
}
