-- strings — рантайм строк и core.bytes: длина, байт, поиск, склейка, срез,
-- регистр, строка из C-строки аргументов.
-- Каждый навык берёт и отдаёт compiler, определяя метку rt_* в коде.
-- Команды — методами compiler.executor (договор backend), регистры — его роли.
-- Строка — объект STRING: длина, затем байты и нулевой байт. Новые строки —
-- через rt_alloc. Выход за границы — rt_string_bounds (ERROR_STRING_BOUNDS);
-- проверка границ идёт до кадра: ret должен быть из той же точки стека, что и call.
-- starts_with прыгает в цикл .L_string_match_loop внутри ends_with;
-- rt_string_upper проваливается в rt_string_case внутри одного навыка.
--
-- emit_string_len / emit_string_byte(compiler) — rt_string_len / rt_string_byte
-- emit_string_bounds(compiler) — метка ошибки
-- emit_string_starts_with / emit_string_ends_with / emit_string_contains(compiler)
-- emit_line_count(compiler) — rt_line_count: число строк по переводам
-- emit_cstring(compiler) — rt_cstring: из нуль-терминированной C-строки
-- emit_string_add / emit_string_at / emit_string_slice(compiler)
-- emit_string_from_byte(compiler) — rt_string_from_byte: число 0…255 → строка из
--     одного байта, иначе StringBounds; хвост — .L_string_one_byte в rt_string_at
-- emit_string_lower / emit_string_case(compiler) — ASCII; case даёт и rt_string_upper
-- emit_bytes_make(compiler) — rt_bytes_make(n) -> нулевая строка; NegativeCount
-- emit_bytes_store(compiler) — rt_bytes_store(bytes, index, value)

use selfhost.abi
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.runtime.tails

skill emit_string_len(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_len")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.VALUE, backend.VALUE, words.payload)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_string_byte(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_byte")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ERROR, backend.SCRATCH1, "rt_string_bounds")
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = executor.load_byte(compiler, backend.VALUE, backend.SCRATCH0, words.payload + words.string_data)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    out tails.ok(compiler)
}

skill emit_string_bounds(compiler) {
    @executor = compiler.executor
    out tails.fail(compiler, "rt_string_bounds", abi.ERROR_STRING_BOUNDS)
}

skill emit_string_starts_with(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_starts_with")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.and_immediate(compiler, backend.ERROR, backend.ERROR, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.ERROR, words.payload)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_string_match_no")
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 0)
    compiler = executor.jump(compiler, ".L_string_match_loop")
    out compiler
}

skill emit_string_ends_with(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_ends_with")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.and_immediate(compiler, backend.ERROR, backend.ERROR, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.ERROR, words.payload)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_string_match_no")
    compiler = executor.move(compiler, backend.VALUE, backend.VALUE)
    compiler = executor.sub(compiler, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH1)
    compiler = executor.add(compiler, backend.VALUE, backend.VALUE, backend.SCRATCH3)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 0)
    compiler = executor.label(compiler, ".L_string_match_loop")
    compiler = executor.branch_equal(compiler, backend.SCRATCH2, backend.SCRATCH1, ".L_string_match_yes")
    compiler = executor.add(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH2)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.ERROR, backend.SCRATCH2)
    compiler = executor.load_byte(compiler, backend.SCRATCH3, backend.SCRATCH3, words.payload + words.string_data)
    compiler = executor.load_byte(compiler, backend.SCRATCH4, backend.SCRATCH4, words.payload + words.string_data)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH3, backend.SCRATCH4, ".L_string_match_no")
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.jump(compiler, ".L_string_match_loop")
    compiler = executor.label(compiler, ".L_string_match_yes")
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.YES)
    compiler = tails.ok(compiler)
    compiler = executor.label(compiler, ".L_string_match_no")
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NO)
    out tails.ok(compiler)
}

skill emit_string_contains(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_contains")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.and_immediate(compiler, backend.ERROR, backend.ERROR, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.ERROR, words.payload)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_contains_yes")
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH0, backend.SCRATCH1, ".L_contains_no")
    compiler = executor.sub(compiler, backend.SCRATCH2, backend.SCRATCH0, backend.SCRATCH1)
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, 0)
    compiler = executor.label(compiler, ".L_contains_outer")
    compiler = executor.branch_equal(compiler, backend.SCRATCH3, backend.SCRATCH2, ".L_contains_no")
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 0)
    compiler = executor.label(compiler, ".L_contains_inner")
    compiler = executor.branch_equal(compiler, backend.SCRATCH4, backend.SCRATCH1, ".L_contains_yes")
    compiler = executor.add(compiler, backend.SCRATCH5, backend.SCRATCH3, backend.SCRATCH4)
    compiler = executor.add(compiler, backend.SCRATCH5, backend.VALUE, backend.SCRATCH5)
    compiler = executor.load_byte(compiler, backend.SCRATCH5, backend.SCRATCH5, words.payload + words.string_data)
    compiler = executor.add(compiler, backend.ARG2, backend.ERROR, backend.SCRATCH4)
    compiler = executor.load_byte(compiler, backend.ARG2, backend.ARG2, words.payload + words.string_data)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH5, backend.ARG2, ".L_contains_next")
    compiler = executor.add_immediate(compiler, backend.SCRATCH4, backend.SCRATCH4, 1)
    compiler = executor.jump(compiler, ".L_contains_inner")
    compiler = executor.label(compiler, ".L_contains_next")
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, 1)
    compiler = executor.jump(compiler, ".L_contains_outer")
    compiler = executor.label(compiler, ".L_contains_yes")
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.YES)
    compiler = tails.ok(compiler)
    compiler = executor.label(compiler, ".L_contains_no")
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NO)
    out tails.ok(compiler)
}

skill emit_line_count(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_line_count")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.branch_zero(compiler, backend.SCRATCH0, ".L_line_empty")
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 0)
    compiler = executor.label(compiler, ".L_line_loop")
    compiler = executor.branch_equal(compiler, backend.SCRATCH2, backend.SCRATCH0, ".L_line_done")
    compiler = executor.add(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH2)
    compiler = executor.load_byte(compiler, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
    compiler = executor.load_immediate(compiler, backend.SCRATCH5, 10)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH4, backend.SCRATCH5, ".L_line_next")
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.label(compiler, ".L_line_next")
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.jump(compiler, ".L_line_loop")
    compiler = executor.label(compiler, ".L_line_done")
    compiler = executor.add(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH0)
    compiler = executor.load_byte(compiler, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data - 1)
    compiler = executor.load_immediate(compiler, backend.SCRATCH5, 10)
    compiler = executor.branch_equal(compiler, backend.SCRATCH4, backend.SCRATCH5, ".L_line_encode")
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.label(compiler, ".L_line_encode")
    compiler = executor.shift_left(compiler, backend.VALUE, backend.SCRATCH1, abi.TAG_SHIFT)
    compiler = tails.ok(compiler)
    compiler = executor.label(compiler, ".L_line_empty")
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    out tails.ok(compiler)
}

skill emit_cstring(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_cstring")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * 2)
    compiler = executor.move(compiler, backend.SCRATCH0, backend.VALUE)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, 0)
    compiler = executor.label(compiler, ".L_cstring_len")
    compiler = executor.load_byte(compiler, backend.SCRATCH2, backend.SCRATCH0, 0)
    compiler = executor.branch_zero(compiler, backend.SCRATCH2, ".L_cstring_alloc")
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, 1)
    compiler = executor.add_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, 1)
    compiler = executor.jump(compiler, ".L_cstring_len")
    compiler = executor.label(compiler, ".L_cstring_alloc")
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.SCRATCH1, words.string_data + 1)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.OBJECT_KIND_STRING)
    compiler = executor.store32(compiler, backend.SCRATCH2, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.VALUE, words.payload)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 2)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 0)
    compiler = executor.label(compiler, ".L_cstring_copy")
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_cstring_done")
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH2)
    compiler = executor.load_byte(compiler, backend.SCRATCH4, backend.SCRATCH3, 0)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH2)
    compiler = executor.store_byte(compiler, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.jump(compiler, ".L_cstring_copy")
    compiler = executor.label(compiler, ".L_cstring_done")
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    out tails.ok(compiler)
}

skill emit_string_add(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_add")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 8)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.ERROR, abi.PAYLOAD_MASK)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 6)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 5)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH0, words.payload)
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH1, words.payload)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.STACK, words.bytes * 4)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.STACK, words.bytes * 3)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.SCRATCH2, backend.SCRATCH3)
    compiler = executor.store(compiler, backend.SCRATCH4, backend.STACK, words.bytes * 2)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.SCRATCH4, words.string_data + 1)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load(compiler, backend.SCRATCH4, backend.STACK, words.bytes * 2)
    compiler = executor.load_immediate(compiler, backend.SCRATCH5, abi.OBJECT_KIND_STRING)
    compiler = executor.store32(compiler, backend.SCRATCH5, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.store(compiler, backend.SCRATCH4, backend.VALUE, words.payload)
    compiler = executor.load_immediate(compiler, backend.SCRATCH5, 0)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 6)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 5)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.STACK, words.bytes * 4)
    compiler = executor.label(compiler, ".L_string_left")
    compiler = executor.branch_equal(compiler, backend.SCRATCH5, backend.SCRATCH2, ".L_string_right_start")
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH5)
    compiler = executor.load_byte(compiler, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH5)
    compiler = executor.store_byte(compiler, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
    compiler = executor.add_immediate(compiler, backend.SCRATCH5, backend.SCRATCH5, 1)
    compiler = executor.jump(compiler, ".L_string_left")
    compiler = executor.label(compiler, ".L_string_right_start")
    compiler = executor.load_immediate(compiler, backend.ARG2, 0)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.STACK, words.bytes * 3)
    compiler = executor.label(compiler, ".L_string_right")
    compiler = executor.branch_equal(compiler, backend.ARG2, backend.SCRATCH2, ".L_string_done")
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH1, backend.ARG2)
    compiler = executor.load_byte(compiler, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH5)
    compiler = executor.store_byte(compiler, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.string_data)
    compiler = executor.add_immediate(compiler, backend.SCRATCH5, backend.SCRATCH5, 1)
    compiler = executor.add_immediate(compiler, backend.ARG2, backend.ARG2, 1)
    compiler = executor.jump(compiler, ".L_string_right")
    compiler = executor.label(compiler, ".L_string_done")
    compiler = executor.add(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH5)
    compiler = executor.store_byte_zero(compiler, backend.SCRATCH3, words.payload + words.string_data)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 8)
    out tails.ok(compiler)
}

skill emit_string_at(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_at")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ERROR, backend.SCRATCH1, "rt_string_bounds")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = executor.load_byte(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload + words.string_data)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 2)
    compiler = executor.label(compiler, ".L_string_one_byte")
    compiler = executor.load_immediate(compiler, backend.VALUE, words.string_data + 2)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.OBJECT_KIND_STRING)
    compiler = executor.store32(compiler, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, 1)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 2)
    compiler = executor.store_byte(compiler, backend.SCRATCH1, backend.VALUE, words.payload + words.string_data)
    compiler = executor.store_byte_zero(compiler, backend.VALUE, words.payload + words.string_data + 1)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    out tails.ok(compiler)
}

skill emit_string_from_byte(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_from_byte")
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH1, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, 256)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH1, backend.SCRATCH0, "rt_string_bounds")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 2)
    out executor.jump(compiler, ".L_string_one_byte")
}

skill emit_string_slice(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_slice")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ARG2, backend.ARG2, abi.TAG_SHIFT)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload)
    compiler = executor.branch_less_unsigned(compiler, backend.ARG2, backend.ERROR, "rt_string_bounds")
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH1, backend.ARG2, "rt_string_bounds")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 8)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.sub(compiler, backend.SCRATCH2, backend.ARG2, backend.ERROR)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 6)
    compiler = executor.store(compiler, backend.ERROR, backend.STACK, words.bytes * 5)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.STACK, words.bytes * 4)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.SCRATCH2, words.string_data + 1)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 6)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 5)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.STACK, words.bytes * 4)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, abi.OBJECT_KIND_STRING)
    compiler = executor.store32(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.VALUE, words.payload)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, 0)
    compiler = executor.label(compiler, ".L_slice_copy")
    compiler = executor.branch_equal(compiler, backend.SCRATCH3, backend.SCRATCH2, ".L_slice_done")
    compiler = executor.add(compiler, backend.SCRATCH4, backend.SCRATCH1, backend.SCRATCH3)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.SCRATCH0, backend.SCRATCH4)
    compiler = executor.load_byte(compiler, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.string_data)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
    compiler = executor.store_byte(compiler, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.string_data)
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, 1)
    compiler = executor.jump(compiler, ".L_slice_copy")
    compiler = executor.label(compiler, ".L_slice_done")
    compiler = executor.add(compiler, backend.SCRATCH4, backend.VALUE, backend.SCRATCH2)
    compiler = executor.store_byte_zero(compiler, backend.SCRATCH4, words.payload + words.string_data)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 8)
    out tails.ok(compiler)
}

skill emit_string_lower(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_string_lower")
    compiler = executor.load_immediate(compiler, backend.ERROR, 0)
    compiler = executor.jump(compiler, "rt_string_case")
    out compiler
}

skill emit_string_case(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_string_upper")
    compiler = executor.load_immediate(compiler, backend.ERROR, 1)
    compiler = executor.label(compiler, "rt_string_case")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 8)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 6)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 5)
    compiler = executor.store(compiler, backend.ERROR, backend.STACK, words.bytes * 4)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.SCRATCH1, words.string_data + 1)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 6)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 5)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.STACK, words.bytes * 4)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, abi.OBJECT_KIND_STRING)
    compiler = executor.store32(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.VALUE, words.payload)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, 0)
    compiler = executor.label(compiler, ".L_case_loop")
    compiler = executor.branch_equal(compiler, backend.SCRATCH3, backend.SCRATCH1, ".L_case_done")
    compiler = executor.add(compiler, backend.SCRATCH4, backend.SCRATCH0, backend.SCRATCH3)
    compiler = executor.load_byte(compiler, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.string_data)
    compiler = executor.branch_zero(compiler, backend.SCRATCH2, ".L_case_lower")
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 97)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH5, backend.SCRATCH4, ".L_case_store")
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 123)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH5, backend.SCRATCH4, ".L_case_store")
    compiler = executor.add_immediate(compiler, backend.SCRATCH5, backend.SCRATCH5, -32)
    compiler = executor.jump(compiler, ".L_case_store")
    compiler = executor.label(compiler, ".L_case_lower")
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 65)
    compiler = executor.branch_less_unsigned(compiler, backend.SCRATCH5, backend.SCRATCH4, ".L_case_store")
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 91)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.SCRATCH5, backend.SCRATCH4, ".L_case_store")
    compiler = executor.add_immediate(compiler, backend.SCRATCH5, backend.SCRATCH5, 32)
    compiler = executor.label(compiler, ".L_case_store")
    compiler = executor.add(compiler, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
    compiler = executor.store_byte(compiler, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.string_data)
    compiler = executor.add_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, 1)
    compiler = executor.jump(compiler, ".L_case_loop")
    compiler = executor.label(compiler, ".L_case_done")
    compiler = executor.add(compiler, backend.SCRATCH4, backend.VALUE, backend.SCRATCH1)
    compiler = executor.store_byte_zero(compiler, backend.SCRATCH4, words.payload + words.string_data)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 8)
    out tails.ok(compiler)
}

skill emit_bytes_make(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_bytes_make")
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH0, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.branch_negative(compiler, backend.SCRATCH0, ".L_bytes_make_negative")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 2)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.SCRATCH0, words.string_data + 1)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.OBJECT_KIND_STRING)
    compiler = executor.store32(compiler, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes * 2)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.VALUE, words.payload)
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.VALUE, words.payload + words.string_data)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH2, backend.SCRATCH1)
    compiler = executor.label(compiler, ".L_bytes_make_clear")
    compiler = executor.store_byte_zero(compiler, backend.SCRATCH2, 0)
    compiler = executor.branch_equal(compiler, backend.SCRATCH2, backend.SCRATCH3, ".L_bytes_make_ready")
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.jump(compiler, ".L_bytes_make_clear")
    compiler = executor.label(compiler, ".L_bytes_make_ready")
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = tails.ok(compiler)
    out tails.fail(compiler, ".L_bytes_make_negative", abi.ERROR_NEGATIVE_COUNT)
}

skill emit_bytes_store(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_bytes_store")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ERROR, backend.SCRATCH1, ".L_bytes_store_bounds")
    compiler = executor.shift_right_signed(compiler, backend.ARG2, backend.ARG2, abi.TAG_SHIFT)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.ERROR)
    compiler = executor.store_byte(compiler, backend.ARG2, backend.SCRATCH0, words.payload + words.string_data)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    compiler = tails.ok(compiler)
    compiler = executor.label(compiler, ".L_bytes_store_bounds")
    compiler = executor.jump(compiler, "rt_string_bounds")
    out compiler
}
