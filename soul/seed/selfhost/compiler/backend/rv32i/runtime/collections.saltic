-- collections — рантайм Box и групп: rt_box_get/set, rt_group_*.
-- Каждый навык берёт и отдаёт compiler, определяя метку rt_* в коде.
-- Команды — методами compiler.executor (договор backend), регистры — его роли.
-- Box: поля парами (id, значение), быстрый путь по слоту, иначе перебор.
-- Группа: плоская до GROUP_FLAT_LIMIT, дальше дерево (tree_add из
-- core.group, если он есть в программе; rt_group_tree_at — спуск по уровням).
--
-- emit_box_get(compiler) — rt_box_get(VALUE box, ERROR id, ARG2 slot) -> VALUE
-- emit_box_set(compiler) — rt_box_set(VALUE box, ERROR id, ARG2 value, ARG3 slot)
--     -> none; уходит в rt_region_barrier, адрес Box — в memory.BARRIER_OBJECT
-- emit_missing_field(compiler) — rt_missing_field: ERROR_MISSING_FIELD
-- emit_group_count(compiler) — rt_group_count(VALUE) -> число
-- emit_group_at(compiler) — rt_group_at(VALUE, ERROR index) -> элемент; bounds
-- emit_group_bounds(compiler) — rt_group_bounds: ERROR_GROUP_BOUNDS
-- emit_group_add(compiler) — rt_group_add(VALUE, ERROR item) -> новая группа
-- emit_tree_switch(compiler) — переход в tree_add для больших групп
-- emit_group_tree_at / emit_group_tree_parts / emit_group_tree_make(compiler)
-- emit_group_flatten(compiler) — rt_group_flatten: дерево → плоская

use selfhost.abi
use selfhost.compiler.state
use selfhost.compiler.constants
use selfhost.compiler.backend
use selfhost.compiler.backend.rv32i.runtime.memory

skill emit_box_get(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_box_get")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ARG2, backend.SCRATCH0, ".L_box_get_scan")
    compiler = executor.shift_left(compiler, backend.SCRATCH1, backend.ARG2, words.shift + 1)
    compiler = executor.add(compiler, backend.SCRATCH1, backend.VALUE, backend.SCRATCH1)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, words.payload + words.bytes)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH2, backend.ERROR, ".L_box_get_scan")
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH1, words.payload + words.bytes * 2)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_box_get_scan")
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.VALUE, words.payload + words.bytes)
    compiler = executor.label(compiler, ".L_box_get_loop")
    compiler = executor.branch_zero(compiler, backend.SCRATCH0, "rt_missing_field")
    compiler = executor.load(compiler, backend.SCRATCH1, backend.VALUE, 0)
    compiler = executor.branch_equal(compiler, backend.SCRATCH1, backend.ERROR, ".L_box_get_found")
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.VALUE, words.box_field)
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, -1)
    compiler = executor.jump(compiler, ".L_box_get_loop")
    compiler = executor.label(compiler, ".L_box_get_found")
    compiler = executor.load(compiler, backend.VALUE, backend.VALUE, words.box_field_value)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_box_set(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_box_set")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.move(compiler, memory.BARRIER_OBJECT, backend.VALUE)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ARG3, backend.SCRATCH0, ".L_box_set_scan")
    compiler = executor.shift_left(compiler, backend.SCRATCH1, backend.ARG3, words.shift + 1)
    compiler = executor.add(compiler, backend.SCRATCH1, memory.BARRIER_OBJECT, backend.SCRATCH1)
    compiler = executor.load(compiler, backend.SCRATCH3, backend.SCRATCH1, words.payload + words.bytes)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH3, backend.ERROR, ".L_box_set_scan")
    compiler = executor.store(compiler, backend.ARG2, backend.SCRATCH1, words.payload + words.bytes * 2)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.jump(compiler, "rt_region_barrier")
    compiler = executor.label(compiler, ".L_box_set_scan")
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.VALUE, words.payload + words.bytes)
    compiler = executor.label(compiler, ".L_box_set_loop")
    compiler = executor.branch_zero(compiler, backend.SCRATCH0, "rt_missing_field")
    compiler = executor.load(compiler, backend.SCRATCH1, backend.VALUE, 0)
    compiler = executor.branch_equal(compiler, backend.SCRATCH1, backend.ERROR, ".L_box_set_found")
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.VALUE, words.box_field)
    compiler = executor.add_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, -1)
    compiler = executor.jump(compiler, ".L_box_set_loop")
    compiler = executor.label(compiler, ".L_box_set_found")
    compiler = executor.store(compiler, backend.ARG2, backend.VALUE, words.box_field_value)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.jump(compiler, "rt_region_barrier")
    out compiler
}

skill emit_missing_field(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_missing_field")
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.ERROR_MISSING_FIELD)
    out executor.ret(compiler)
}

skill emit_group_count(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_group_count")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.VALUE, backend.VALUE, words.payload)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_group_at(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_group_at")
    compiler = executor.and_immediate(compiler, backend.VALUE, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.load32(compiler, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.OBJECT_KIND_TREE)
    compiler = executor.branch_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, "rt_group_tree_at")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ERROR, backend.SCRATCH0, "rt_group_bounds")
    compiler = executor.shift_left(compiler, backend.ERROR, backend.ERROR, words.shift)
    compiler = executor.add(compiler, backend.VALUE, backend.VALUE, backend.ERROR)
    compiler = executor.load(compiler, backend.VALUE, backend.VALUE, words.payload + words.bytes)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_group_bounds(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_group_bounds")
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.ERROR_GROUP_BOUNDS)
    out executor.ret(compiler)
}

skill emit_group_add(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_group_add")
    @tree_add = state.symbol_find(compiler.skills, constants.TREE_ADD_SKILL)
    (tree_add.name == constants.TREE_ADD_SKILL) { compiler = emit_tree_switch(compiler) }
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * 2)
    compiler = executor.store(compiler, backend.ERROR, backend.STACK, words.bytes)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.SCRATCH1, 2)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, words.shift)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 2)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.SCRATCH0, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload)
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH1, 1)
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, abi.OBJECT_KIND_GROUP)
    compiler = executor.store32(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.VALUE, words.payload)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, 0)
    compiler = executor.label(compiler, ".L_group_copy")
    compiler = executor.branch_equal(compiler, backend.SCRATCH2, backend.SCRATCH1, ".L_group_copy_done")
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH2, words.shift)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.SCRATCH0, backend.SCRATCH3)
    compiler = executor.load(compiler, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.bytes)
    compiler = executor.add(compiler, backend.SCRATCH4, backend.VALUE, backend.SCRATCH3)
    compiler = executor.store(compiler, backend.SCRATCH5, backend.SCRATCH4, words.payload + words.bytes)
    compiler = executor.add_immediate(compiler, backend.SCRATCH2, backend.SCRATCH2, 1)
    compiler = executor.jump(compiler, ".L_group_copy")
    compiler = executor.label(compiler, ".L_group_copy_done")
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH1, words.shift)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.VALUE, backend.SCRATCH3)
    compiler = executor.load(compiler, backend.SCRATCH4, backend.STACK, words.bytes)
    compiler = executor.store(compiler, backend.SCRATCH4, backend.SCRATCH3, words.payload + words.bytes)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_group_tree_at(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_group_tree_at")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ERROR, backend.SCRATCH0, "rt_group_bounds")
    compiler = executor.load(compiler, backend.SCRATCH1, backend.VALUE, words.payload + words.tree_tail)
    compiler = executor.and_immediate(compiler, backend.SCRATCH1, backend.SCRATCH1, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH1, words.payload)
    compiler = executor.sub(compiler, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH2)
    compiler = executor.branch_greater_equal_unsigned(compiler, backend.ERROR, backend.SCRATCH3, ".L_tree_tail")
    compiler = executor.load(compiler, backend.SCRATCH4, backend.VALUE, words.payload + words.tree_levels)
    compiler = executor.load(compiler, backend.SCRATCH5, backend.VALUE, words.payload + words.tree_root)
    compiler = executor.and_immediate(compiler, backend.SCRATCH5, backend.SCRATCH5, abi.PAYLOAD_MASK)
    compiler = executor.add_immediate(compiler, backend.ARG2, backend.SCRATCH4, -1)
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.ARG2, 2)
    compiler = executor.add(compiler, backend.ARG2, backend.ARG2, backend.SCRATCH3)
    compiler = executor.label(compiler, ".L_tree_down")
    compiler = executor.branch_zero(compiler, backend.ARG2, ".L_tree_leaf")
    compiler = executor.shift_right_unsigned_by(compiler, backend.SCRATCH3, backend.ERROR, backend.ARG2)
    compiler = executor.and_immediate(compiler, backend.SCRATCH3, backend.SCRATCH3, 31)
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH3, words.shift)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH5, backend.SCRATCH3)
    compiler = executor.load(compiler, backend.SCRATCH5, backend.SCRATCH3, words.payload + words.group_items)
    compiler = executor.and_immediate(compiler, backend.SCRATCH5, backend.SCRATCH5, abi.PAYLOAD_MASK)
    compiler = executor.add_immediate(compiler, backend.ARG2, backend.ARG2, -5)
    compiler = executor.jump(compiler, ".L_tree_down")
    compiler = executor.label(compiler, ".L_tree_leaf")
    compiler = executor.and_immediate(compiler, backend.SCRATCH3, backend.ERROR, 31)
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH3, words.shift)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH5, backend.SCRATCH3)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH3, words.payload + words.group_items)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_tree_tail")
    compiler = executor.sub(compiler, backend.SCRATCH3, backend.ERROR, backend.SCRATCH3)
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH3, words.shift)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH1, backend.SCRATCH3)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH3, words.payload + words.group_items)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_tree_switch(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load32(compiler, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.OBJECT_KIND_TREE)
    compiler = executor.branch_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_group_add_tree")
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, constants.GROUP_FLAT_LIMIT)
    compiler = executor.branch_less(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_group_add_flat")
    compiler = executor.label(compiler, ".L_group_add_tree")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.call(compiler, constants.TREE_ADD_LABEL)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_group_add_flat")
    out compiler
}

skill emit_group_tree_parts(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_group_tree_parts")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 2)
    compiler = executor.load32(compiler, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.OBJECT_KIND_TREE)
    compiler = executor.load_immediate(compiler, backend.VALUE, constants.group_storage_bytes(compiler.words, 0))
    compiler = executor.store_zero(compiler, backend.STACK, words.bytes)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_tree_parts_alloc")
    compiler = executor.load_immediate(compiler, backend.VALUE, constants.group_storage_bytes(compiler.words, 3))
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, 3)
    compiler = executor.store(compiler, backend.SCRATCH3, backend.STACK, words.bytes)
    compiler = executor.label(compiler, ".L_tree_parts_alloc")
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, abi.OBJECT_KIND_GROUP)
    compiler = executor.store32(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.VALUE, words.payload)
    compiler = executor.branch_zero(compiler, backend.SCRATCH1, ".L_tree_parts_done")
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 2)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH0, words.payload + words.tree_levels)
    compiler = executor.shift_left(compiler, backend.SCRATCH2, backend.SCRATCH2, abi.TAG_SHIFT)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.VALUE, words.payload + words.group_items)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH0, words.payload + words.tree_root)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.VALUE, words.payload + words.group_items + words.group_item)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH0, words.payload + words.tree_tail)
    compiler = executor.store(compiler, backend.SCRATCH2, backend.VALUE, words.payload + words.group_items + 2 * words.group_item)
    compiler = executor.label(compiler, ".L_tree_parts_done")
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_group_tree_make(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_group_tree_make")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 8)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * 6)
    compiler = executor.store(compiler, backend.ERROR, backend.STACK, words.bytes * 5)
    compiler = executor.store(compiler, backend.ARG2, backend.STACK, words.bytes * 4)
    compiler = executor.store(compiler, backend.ARG3, backend.STACK, words.bytes * 3)
    compiler = executor.load_immediate(compiler, backend.VALUE, words.tree_payload)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load_immediate(compiler, backend.SCRATCH0, abi.OBJECT_KIND_TREE)
    compiler = executor.store32(compiler, backend.SCRATCH0, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 6)
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH0, backend.SCRATCH0, abi.TAG_SHIFT)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 5)
    compiler = executor.shift_right_signed(compiler, backend.SCRATCH0, backend.SCRATCH0, abi.TAG_SHIFT)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload + words.tree_levels)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 4)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload + words.tree_root)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.SCRATCH0, backend.VALUE, words.payload + words.tree_tail)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 7)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 8)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_group_flatten(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_group_flatten")
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load32(compiler, backend.SCRATCH1, backend.SCRATCH0, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, abi.OBJECT_KIND_TREE)
    compiler = executor.branch_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, ".L_flatten_tree")
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_flatten_tree")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 4)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, words.bytes * 2)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.STACK, words.bytes)
    compiler = executor.add_immediate(compiler, backend.VALUE, backend.SCRATCH1, 1)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, words.shift)
    compiler = executor.call(compiler, "rt_alloc")
    compiler = executor.load_immediate(compiler, backend.SCRATCH3, abi.OBJECT_KIND_GROUP)
    compiler = executor.store32(compiler, backend.SCRATCH3, backend.VALUE, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.VALUE, words.payload)
    compiler = executor.store(compiler, backend.VALUE, backend.STACK, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH4, 0)
    compiler = executor.label(compiler, ".L_flatten_loop")
    compiler = executor.load(compiler, backend.SCRATCH1, backend.STACK, words.bytes)
    compiler = executor.branch_equal(compiler, backend.SCRATCH4, backend.SCRATCH1, ".L_flatten_done")
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - words.bytes * 4)
    compiler = executor.store(compiler, backend.SCRATCH4, backend.STACK, words.bytes * 3)
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, words.bytes * 6)
    compiler = executor.shift_left(compiler, backend.ERROR, backend.SCRATCH4, abi.TAG_SHIFT)
    compiler = executor.call(compiler, "rt_group_at")
    compiler = executor.load(compiler, backend.SCRATCH4, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.load(compiler, backend.SCRATCH0, backend.STACK, 0)
    compiler = executor.shift_left(compiler, backend.SCRATCH3, backend.SCRATCH4, words.shift)
    compiler = executor.add(compiler, backend.SCRATCH3, backend.SCRATCH0, backend.SCRATCH3)
    compiler = executor.store(compiler, backend.VALUE, backend.SCRATCH3, words.payload + words.group_items)
    compiler = executor.add_immediate(compiler, backend.SCRATCH4, backend.SCRATCH4, 1)
    compiler = executor.jump(compiler, ".L_flatten_loop")
    compiler = executor.label(compiler, ".L_flatten_done")
    compiler = executor.load(compiler, backend.VALUE, backend.STACK, 0)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_GROUP)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}
