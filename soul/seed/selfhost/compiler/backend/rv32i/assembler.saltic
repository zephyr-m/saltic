-- assembler — команды RV32I по номерам регистров: для рантайма на ассемблере
-- (runtime/*) и для исполнителя договора (../rv32i.saltic).
-- emit_op разворачивает смещение, не влезающее в 12 бит, через T6
-- (WIDE_OFFSET_REGISTER) — только для ADDI и load/store; T6 занят, в рантайме
-- он не хранит значений поперёк таких команд.
--
-- fits_immediate(value) / wide_offset_kind(kind) -> yes/no
-- emit_op(compiler, kind, rd, rs1, rs2, immediate) — команда в compiler.machine
-- load_immediate(compiler, rd, value) — число любой ширины (addi или lui+addi)

use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.registers

WIDE_OFFSET_REGISTER = registers.T6

skill fits_immediate(value) {
    (value < -2048) { out no }
    (value > 2047) { out no }
    out yes
}

skill wide_offset_kind(kind) {
    (kind == instruction.Kind.ADDI) { out yes }
    (kind == instruction.Kind.LW) { out yes }
    (kind == instruction.Kind.LB) { out yes }
    (kind == instruction.Kind.LBU) { out yes }
    (kind == instruction.Kind.LH) { out yes }
    (kind == instruction.Kind.LHU) { out yes }
    (kind == instruction.Kind.SW) { out yes }
    (kind == instruction.Kind.SB) { out yes }
    (kind == instruction.Kind.SH) { out yes }
    out no
}

skill emit_op(compiler, kind, rd, rs1, rs2, immediate) {
    (fits_immediate(immediate) == no) {
        (wide_offset_kind(kind) == yes) {
            compiler.machine = layout.emit_load_immediate(compiler.machine, WIDE_OFFSET_REGISTER, immediate)
            compiler.machine = layout.emit(compiler.machine, instruction.Kind.ADD, WIDE_OFFSET_REGISTER, WIDE_OFFSET_REGISTER, rs1, 0)
            compiler.machine = layout.emit(compiler.machine, kind, rd, WIDE_OFFSET_REGISTER, rs2, 0)
            out compiler
        }
    }
    compiler.machine = layout.emit(compiler.machine, kind, rd, rs1, rs2, immediate)
    out compiler
}

skill load_immediate(compiler, rd, value) {
    compiler.machine = layout.emit_load_immediate(compiler.machine, rd, value)
    out compiler
}
