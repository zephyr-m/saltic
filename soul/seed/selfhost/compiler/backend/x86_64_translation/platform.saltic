-- platform — готовые байты x86-64 для Linux: заглушка ecall (системные
-- вызовы через регистровый файл r15) и вход программы (argv в строки гостя).
-- Байты в SYSCALL_STUB/ENTRY_* — заранее собранный машинный код, не менять
-- по частям.
--
-- append_syscall_stub(code) -> code с обработчиком ecall
-- append_entry_stub(code, register_file_displacement, arguments, strings) -> code
--     с входом: arguments/strings — адреса (word) областей гостя,
--     в конце — jmp с нулевым смещением для fixup на точку входа

use selfhost.compiler.backend.x86_64_translation.encoder
use selfhost.machine.word
use selfhost.compiler.backend.rv32i.machine.buffer

SYSCALL_STUB = [
    65, 139, 71, 68,
    131, 248, 29, 117, 27, 184, 16, 0, 0, 0, 73, 99, 127, 40, 65, 139,
    119, 44, 65, 139, 87, 48, 76, 1, 242, 15, 5, 65, 137, 71, 40, 195,
    131, 248, 56, 117, 7, 184, 1, 1, 0, 0, 235, 55,
    131, 248, 57, 117, 7, 184, 3, 0, 0, 0, 235, 43, 131, 248, 63, 117,
    4, 49, 192, 235, 34, 131, 248, 64, 117, 7, 184, 1, 0, 0, 0, 235,
    22, 131, 248, 93, 117, 7, 184, 60, 0, 0, 0, 235, 10, 184, 218, 255,
    255, 255, 65, 137, 71, 40, 195, 73, 99, 127, 40, 65, 139, 119, 44, 76,
    1, 246, 65, 139, 87, 48, 69, 139, 87, 52, 69, 139, 71, 56, 69, 139,
    79, 60, 15, 5, 65, 137, 71, 40, 195,
]

ENTRY_ARGUMENTS = [73, 190, 0, 0, 0, 0, 1, 0, 0, 0, 72, 137, 227, 139, 11, 191]
ENTRY_STRINGS = [65, 137, 12, 62, 186]
ENTRY_COPY = [
    49, 246, 57, 206, 115, 34, 76, 139, 68, 243, 8, 68, 141, 76, 183, 4,
    67, 137, 20, 14, 65, 138, 0, 65, 136, 4, 22, 73, 255, 192, 255, 194,
    132, 192, 117, 240, 255, 198, 235, 218, 65, 137, 127, 8,
]
skill append_syscall_stub(code) {
    out encoder.bytes(code, SYSCALL_STUB)
}

skill append_entry_stub(code, register_file_displacement, arguments, strings) {
    code = encoder.load_register_file_address(code, register_file_displacement)
    code = encoder.bytes(code, ENTRY_ARGUMENTS)
    code = buffer.append_word(code, arguments)
    code = encoder.bytes(code, ENTRY_STRINGS)
    code = buffer.append_word(code, strings)
    code = encoder.bytes(code, ENTRY_COPY)
    code = encoder.reload_registers(code)
    code = buffer.append_byte(code, encoder.JUMP_OPCODE)
    out buffer.append_word(code, word.from_bytes(0, 0, 0, 0))
}
