-- encoder — байты команд x86-64 для перевода RV32I; code — buffer.Buffer,
-- каждый навык отдаёт его дополненным.
-- Регистры гостя живут в регистровом файле по r15 (index * 4); горячие —
-- в регистрах хоста по таблице HOST_OF_REGISTER. Операнды — EAX/ECX/EDX.
-- Константы ADD…CMP, SHIFT_*, EQUAL…GREATER_OR_EQUAL — коды операций и
-- условий для operate/shift/set_condition/jump_condition.
--
-- bytes(code, items) — добавить список байтов
-- signed_word(value) -> word; immediate32(code, value) — знаковое 32-битное
-- host_register(index) -> регистр хоста или -1; low_bits / file_prefix(register)
-- move_register(code, target, source) — mov между регистрами хоста
-- load_register / store_register(code, …) — регистр гостя ↔ хост (файл или регистр)
-- load_file_register / store_file_register(code, …) — всегда через файл
-- spill_registers / reload_registers(code) — все горячие в файл и обратно
-- move_immediate(code, target, value) / move_word(code, target, word)
-- operate(code, op, target, source) / operate_immediate(code, op, target, value)
-- shift_by_count(code, op, target) / shift_immediate(code, op, target, amount)
-- set_condition(code, condition) — EAX = 0/1 по флагам
-- jump(code) / jump_condition(code, condition) / call(code) — rel32 = 0 под fixup
-- load_table_entry(code, displacement) — EAX = запись таблицы переходов
-- load_register_file_address(code, displacement) — lea r15, [rip + d]
-- load_memory(code, width, signed) / store_memory(code, width) — память гостя
-- jump_to_eax(code) / breakpoint(code) / undefined(code)

use core.group
use selfhost.compiler.backend.rv32i.machine.profile
use selfhost.machine.word
use selfhost.compiler.backend.rv32i.machine.buffer

EAX = 0
ECX = 1
EDX = 2

ADD = 0
OR = 1
AND = 4
SUB = 5
XOR = 6
CMP = 7

SHIFT_LEFT = 4
SHIFT_RIGHT = 5
SHIFT_ARITHMETIC = 7

EQUAL = 4
NOT_EQUAL = 5
BELOW = 2
ABOVE_OR_EQUAL = 3
LESS = 12
GREATER_OR_EQUAL = 13

REGISTER_FILE_PREFIX = 65
LOAD_OPCODE = 139
JUMP_OPCODE = 233
STORE_OPCODE = 137
DISPLACEMENT8_R15 = 71
TABLE_PREFIX = 73
TABLE_MODRM = 132
TABLE_SIB = 71
RIP_PREFIX = 76
LEA_OPCODE = 141
RIP_MODRM_R15 = 61
OPERAND16_PREFIX = 102
GUEST_PREFIX = 65
GUEST_MODRM_EAX = 4
GUEST_MODRM_ECX = 12
GUEST_SIB = 6
TWO_BYTE_OPCODE = 15
REX = 64
REX_REGISTER = 4
REX_BASE = 1

HOST_OF_REGISTER = [
    -1, 8, 3, -1, -1, 7, 10, 12, 2, -1, 5, 6, 9, -1, -1, -1,
    -1, -1, -1, -1, 11, -1, -1, -1, -1, -1, -1, -1, 13, -1, -1, -1,
]

skill bytes(code, items) {
    drum (items) { code = buffer.append_byte(code, beat) }
    out code
}

skill signed_word(value) {
    (value < 0) { out word.negate(word.from_number(0 - value)) }
    out word.from_number(value)
}

skill immediate32(code, value) {
    out buffer.append_word(code, signed_word(value))
}

skill host_register(index) {
    out group.get(HOST_OF_REGISTER, index)
}

skill low_bits(register) {
    (register > 7) { out register - 8 }
    out register
}

skill file_prefix(register) {
    (register > 7) { out REGISTER_FILE_PREFIX + REX_REGISTER }
    out REGISTER_FILE_PREFIX
}

skill move_register(code, target, source) {
    @prefix = REX
    (source > 7) { prefix = prefix + REX_REGISTER }
    (target > 7) { prefix = prefix + REX_BASE }
    (prefix > REX) { code = buffer.append_byte(code, prefix) }
    out bytes(code, [STORE_OPCODE, 192 + low_bits(source) * 8 + low_bits(target)])
}

skill load_file_register(code, target, index) {
    out bytes(code, [file_prefix(target), LOAD_OPCODE, DISPLACEMENT8_R15 + low_bits(target) * 8, index * 4])
}

skill store_file_register(code, index, source) {
    out bytes(code, [file_prefix(source), STORE_OPCODE, DISPLACEMENT8_R15 + low_bits(source) * 8, index * 4])
}

skill load_register(code, target, index) {
    @host = host_register(index)
    (host > -1) { out move_register(code, target, host) }
    out load_file_register(code, target, index)
}

skill store_register(code, index, source) {
    @host = host_register(index)
    (host > -1) { out move_register(code, host, source) }
    out store_file_register(code, index, source)
}

skill spill_registers(code) {
    drum (profile.REGISTER_COUNT) {
        @host = host_register(beat)
        (host > -1) { code = store_file_register(code, beat, host) }
    }
    out code
}

skill reload_registers(code) {
    drum (profile.REGISTER_COUNT) {
        @host = host_register(beat)
        (host > -1) { code = load_file_register(code, host, beat) }
    }
    out code
}

skill move_immediate(code, target, value) {
    code = buffer.append_byte(code, 184 + target)
    out immediate32(code, value)
}

skill move_word(code, target, data) {
    code = buffer.append_byte(code, 184 + target)
    out buffer.append_word(code, data)
}

skill operate(code, operation, target, source) {
    @opcode = operation * 8 + 1
    (operation == CMP) { opcode = 57 }
    out bytes(code, [opcode, 192 + source * 8 + target])
}

skill operate_immediate(code, operation, target, value) {
    code = bytes(code, [129, 192 + operation * 8 + target])
    out immediate32(code, value)
}

skill shift_by_count(code, operation, target) {
    out bytes(code, [211, 192 + operation * 8 + target])
}

skill shift_immediate(code, operation, target, amount) {
    out bytes(code, [193, 192 + operation * 8 + target, amount])
}

skill set_condition(code, condition) {
    out bytes(code, [TWO_BYTE_OPCODE, 144 + condition, 192, TWO_BYTE_OPCODE, 182, 192])
}

skill jump(code) {
    out bytes(code, [233, 0, 0, 0, 0])
}

skill jump_condition(code, condition) {
    out bytes(code, [TWO_BYTE_OPCODE, 128 + condition, 0, 0, 0, 0])
}

skill call(code) {
    out bytes(code, [232, 0, 0, 0, 0])
}

skill load_table_entry(code, displacement) {
    code = bytes(code, [TABLE_PREFIX, LOAD_OPCODE, TABLE_MODRM, TABLE_SIB])
    out immediate32(code, displacement)
}

skill load_register_file_address(code, displacement) {
    code = bytes(code, [RIP_PREFIX, LEA_OPCODE, RIP_MODRM_R15])
    out immediate32(code, displacement)
}

skill load_memory(code, width, signed) {
    (width == 4) { out bytes(code, [GUEST_PREFIX, LOAD_OPCODE, GUEST_MODRM_EAX, GUEST_SIB]) }
    @opcode = 182
    (width == 2) { opcode = 183 }
    (signed == yes) { opcode = opcode + 8 }
    out bytes(code, [GUEST_PREFIX, TWO_BYTE_OPCODE, opcode, GUEST_MODRM_EAX, GUEST_SIB])
}

skill store_memory(code, width) {
    (width == 4) { out bytes(code, [GUEST_PREFIX, STORE_OPCODE, GUEST_MODRM_ECX, GUEST_SIB]) }
    (width == 2) { out bytes(code, [OPERAND16_PREFIX, GUEST_PREFIX, STORE_OPCODE, GUEST_MODRM_ECX, GUEST_SIB]) }
    out bytes(code, [GUEST_PREFIX, 136, GUEST_MODRM_ECX, GUEST_SIB])
}

skill jump_to_eax(code) {
    out bytes(code, [255, 224])
}

skill breakpoint(code) {
    out buffer.append_byte(code, 204)
}

skill undefined(code) {
    out bytes(code, [TWO_BYTE_OPCODE, 11])
}
