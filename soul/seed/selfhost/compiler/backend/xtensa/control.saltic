-- control — переходы и CALL0. К метке идём через J: дальности IRAM хватает.
-- Если операнд в слоте DRAM, перед прыжком регистры a14 и a15 возвращаются.

use selfhost.compiler.backend.xtensa.asm
use selfhost.compiler.backend.xtensa.encode
use selfhost.compiler.backend.xtensa.roles
use selfhost.compiler.backend.xtensa.access

skill over(prog, word, name) {
    prog = asm.emit3(prog, word)
    out asm.jump_to(prog, name)
}

skill taken(prog, name) {
    prog = access.unspill(prog)
    prog = asm.jump_to(prog, name)
    out access.unspill(prog)
}

skill pair(prog, left, right, kind, name) {
    @rs = roles.reg(left)
    @rt = roles.reg(right)
    (rs >= 0) {
        (rt >= 0) {
            (kind == 0) { out over(prog, encode.bne(rs, rt, 6), name) }
            (kind == 1) { out over(prog, encode.beq(rs, rt, 6), name) }
            (kind == 2) { out over(prog, encode.bge(rs, rt, 6), name) }
            (kind == 3) { out over(prog, encode.blt(rs, rt, 6), name) }
            (kind == 4) { out over(prog, encode.bgeu(rs, rt, 6), name) }
            out over(prog, encode.bltu(rs, rt, 6), name)
        }
    }
    prog = access.spill(prog)
    prog = access.fetch(prog, left, 14)
    prog = access.fetch(prog, right, 15)
    (kind == 0) { prog = asm.emit3(prog, encode.bne(14, 15, 15)) }
    (kind == 1) { prog = asm.emit3(prog, encode.beq(14, 15, 15)) }
    (kind == 2) { prog = asm.emit3(prog, encode.bge(14, 15, 15)) }
    (kind == 3) { prog = asm.emit3(prog, encode.blt(14, 15, 15)) }
    (kind == 4) { prog = asm.emit3(prog, encode.bgeu(14, 15, 15)) }
    (kind == 5) { prog = asm.emit3(prog, encode.bltu(14, 15, 15)) }
    out taken(prog, name)
}

skill one(prog, src, kind, name) {
    @rs = roles.reg(src)
    (rs >= 0) {
        (kind == 0) { out over(prog, encode.bnez(rs, 6), name) }
        (kind == 1) { out over(prog, encode.beqz(rs, 6), name) }
        (kind == 2) { out over(prog, encode.bgez(rs, 6), name) }
        out over(prog, encode.bltz(rs, 6), name)
    }
    prog = access.spill(prog)
    prog = access.fetch(prog, src, 14)
    (kind == 0) { prog = asm.emit3(prog, encode.bnez(14, 15)) }
    (kind == 1) { prog = asm.emit3(prog, encode.beqz(14, 15)) }
    (kind == 2) { prog = asm.emit3(prog, encode.bgez(14, 15)) }
    (kind == 3) { prog = asm.emit3(prog, encode.bltz(14, 15)) }
    out taken(prog, name)
}

skill not_positive(prog, src, name) {
    @rs = roles.reg(src)
    (rs >= 0) {
        prog = asm.emit3(prog, encode.bltz(rs, 9))
        prog = asm.emit3(prog, encode.beqz(rs, 6))
        prog = asm.emit3(prog, encode.jump(6))
        out asm.jump_to(prog, name)
    }
    prog = access.spill(prog)
    prog = access.fetch(prog, src, 14)
    prog = asm.emit3(prog, encode.bltz(14, 18))
    prog = asm.emit3(prog, encode.beqz(14, 15))
    prog = access.unspill(prog)
    prog = asm.emit3(prog, encode.jump(15))
    prog = access.unspill(prog)
    out asm.jump_to(prog, name)
}
