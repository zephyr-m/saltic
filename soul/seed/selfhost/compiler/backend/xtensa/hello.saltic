-- hello — «S» и перевод строки в UART0 ESP32-D0WD (LX6), CALL0, без окон.
-- ПЗУ оставляет ядро на кварце 26 МГц. Делитель UART считаем от него на 115200.
-- UART пишем регистрами: функции ПЗУ собраны под окна.
-- Сторожа TIMG0 и RTC гасим, иначе ПЗУ перезагрузит плату секунд через девять.
-- Код в IRAM 0x40080400, вход — сразу после пула литералов.
-- Образ кладётся на флеш по 0x1000. Это стирает второй загрузчик MicroPython.

use core.group
use selfhost.compiler.backend.xtensa.encode
use formats.esp.image

POOL = 40

skill pack(b0, b1, b2, b3) {
    out b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

skill load_addr() {
    out pack(0, 4, 8, 64)
}

skill u32bytes(code, value) {
    @next = group.add(code, value % 256)
    next = group.add(next, value / 256 % 256)
    next = group.add(next, value / 65536 % 256)
    out group.add(next, value / 16777216 % 256)
}

skill put(code, pc, word) {
    @next = group.add(code, word % 256)
    next = group.add(next, word / 256 % 256)
    next = group.add(next, word / 65536 % 256)
    out [next, pc + 3]
}

skill lit(code, pc, reg, slot) {
    out put(code, pc, encode.l32r_at(reg, pc, load_addr() + slot * 4))
}

skill code() {
    @pool = []
    pool = u32bytes(pool, pack(0, 0, 244, 63))
    pool = u32bytes(pool, pack(28, 0, 244, 63))
    pool = u32bytes(pool, pack(20, 0, 244, 63))
    pool = u32bytes(pool, pack(225, 0, 176, 0))
    pool = u32bytes(pool, pack(0, 128, 252, 63))
    pool = u32bytes(pool, pack(100, 240, 245, 63))
    pool = u32bytes(pool, pack(72, 240, 245, 63))
    pool = u32bytes(pool, pack(164, 128, 244, 63))
    pool = u32bytes(pool, pack(140, 128, 244, 63))
    pool = u32bytes(pool, pack(161, 58, 216, 80))
    @pc = load_addr() + POOL
    @step = lit(pool, pc, 1, 4)
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 3, 5)
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 2, 9)
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.s32i(2, 3, 0))
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 3, 6)
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.movi(2, 0))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.s32i(2, 3, 0))
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 3, 7)
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 2, 9)
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.s32i(2, 3, 0))
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 3, 8)
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.movi(2, 0))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.s32i(2, 3, 0))
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 3, 2)
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 2, 3)
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.s32i(2, 3, 0))
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 3, 0)
    pc = group.get(step, 1)
    step = lit(group.get(step, 0), pc, 4, 1)
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.movi(2, 83))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.movi(6, 128))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.l32i(5, 4, 0))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.srli(5, 5, 8))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.srli(5, 5, 8))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.and(5, 5, 6))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.beqz(5, 6))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.jump(0 - 15))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.s32i(2, 3, 0))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.movi(2, 10))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.l32i(5, 4, 0))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.srli(5, 5, 8))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.srli(5, 5, 8))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.and(5, 5, 6))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.beqz(5, 6))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.jump(0 - 15))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.s32i(2, 3, 0))
    pc = group.get(step, 1)
    step = put(group.get(step, 0), pc, encode.jump(0))
    @bytes = group.get(step, 0)
    drum ((4 - group.count(bytes) % 4) % 4) { bytes = group.add(bytes, 0) }
    out bytes
}

skill image_bytes() {
    @body = code()
    out image.ram(load_addr() + POOL, load_addr(), body)
}

program() {
    out none
}
