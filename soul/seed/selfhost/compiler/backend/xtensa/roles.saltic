-- roles — роль договора на регистр CALL0 или на слот в DRAM.
-- a0 возврат, a1 стек, a2 значение, a3 ошибка, a4–a5 аргументы,
-- a6–a11 царапины, a12 кадр, a13 куча, a14 метка региона, a15 метка побега.
-- ARG4…ARG7 и низ побега — пять слотов по адресу slots().

use selfhost.compiler.backend

skill pack(b0, b1, b2, b3) {
    out b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

skill slots() {
    out pack(0, 240, 253, 63)
}

skill reg(role) {
    (role == backend.VALUE) { out 2 }
    (role == backend.ERROR) { out 3 }
    (role == backend.ARG2) { out 4 }
    (role == backend.ARG3) { out 5 }
    (role == backend.SCRATCH0) { out 6 }
    (role == backend.SCRATCH1) { out 7 }
    (role == backend.SCRATCH2) { out 8 }
    (role == backend.SCRATCH3) { out 9 }
    (role == backend.SCRATCH4) { out 10 }
    (role == backend.SCRATCH5) { out 11 }
    (role == backend.FRAME) { out 12 }
    (role == backend.HEAP_TOP) { out 13 }
    (role == backend.REGION_MARK) { out 14 }
    (role == backend.ESCAPE_MARK) { out 15 }
    (role == backend.STACK) { out 1 }
    (role == backend.RETURN) { out 0 }
    out 0 - 1
}

skill slot(role) {
    (role == backend.ARG4) { out 0 }
    (role == backend.ARG5) { out 1 }
    (role == backend.ARG6) { out 2 }
    (role == backend.ARG7) { out 3 }
    (role == backend.ESCAPE_BOTTOM) { out 4 }
    out 0 - 1
}

skill addr(role) {
    out slots() + slot(role) * 4
}
