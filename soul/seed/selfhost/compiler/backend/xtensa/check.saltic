-- check — первый срез Xtensa: nop/ret/J и заголовок образа ESP32.
-- Пишет /tmp/saltic-esp32-hello.bin — «S» и перевод строки в UART0.
-- Адрес IRAM в файле обязан быть 00 04 08 40. Иначе образ врёт.

use io
use io.file
use core.bytes
use core.group
use selfhost.compiler.backend.xtensa.encode
use selfhost.compiler.backend.xtensa.hello

skill same3(word, a, b, c) {
    @raw = encode.bytes3(word)
    (group.get(raw, 0) == a) {
        (group.get(raw, 1) == b) {
            (group.get(raw, 2) == c) { out yes }
        }
    }
    out no
}

skill is_byte(raw, index, expect) {
    (bytes.get(raw, index) == expect) { out yes }
    out no
}

skill u32_at(raw, index) {
    out bytes.get(raw, index) + bytes.get(raw, index + 1) * 256 + bytes.get(raw, index + 2) * 65536 + bytes.get(raw, index + 3) * 16777216
}

program() {
    (same3(encode.nop(), 240, 32, 0) == no) {
        io.show("nop")
        out error.Xtensa
    }
    (same3(encode.ret(), 128, 0, 0) == no) {
        io.show("ret")
        out error.Xtensa
    }
    (same3(encode.ret_n(), 13, 240, 0) == no) {
        io.show("ret.n")
        out error.Xtensa
    }
    (same3(encode.jump(0), 6, 255, 255) == no) {
        io.show("j")
        out error.Xtensa
    }
    @image = hello.image_bytes()
    (is_byte(image, 0, 233) == no) {
        io.show("magic")
        out error.Xtensa
    }
    (is_byte(image, 4, 40) == no) {
        io.show("entry")
        out error.Xtensa
    }
    (is_byte(image, 5, 4) == no) {
        io.show("entry")
        out error.Xtensa
    }
    (is_byte(image, 6, 8) == no) {
        io.show("entry")
        out error.Xtensa
    }
    (is_byte(image, 7, 64) == no) {
        io.show("entry")
        out error.Xtensa
    }
    (is_byte(image, 8, 238) == no) {
        io.show("wp")
        out error.Xtensa
    }
    (is_byte(image, 23, 0) == no) {
        io.show("sha")
        out error.Xtensa
    }
    (is_byte(image, 24, 0) == no) {
        io.show("load")
        out error.Xtensa
    }
    (is_byte(image, 25, 4) == no) {
        io.show("load")
        out error.Xtensa
    }
    (is_byte(image, 26, 8) == no) {
        io.show("load")
        out error.Xtensa
    }
    (is_byte(image, 27, 64) == no) {
        io.show("load")
        out error.Xtensa
    }
    (is_byte(image, 32, 0) == no) {
        io.show("fifo")
        out error.Xtensa
    }
    (is_byte(image, 34, 244) == no) {
        io.show("fifo")
        out error.Xtensa
    }
    (is_byte(image, 35, 63) == no) {
        io.show("fifo")
        out error.Xtensa
    }
    @tail = 32 + u32_at(image, 28) - 3
    (is_byte(image, tail, 6) == no) {
        io.show("halt")
        out error.Xtensa
    }
    (is_byte(image, tail + 1, 255) == no) {
        io.show("halt")
        out error.Xtensa
    }
    (is_byte(image, tail + 2, 255) == no) {
        io.show("halt")
        out error.Xtensa
    }
    file.write_bytes("/tmp/saltic-esp32-hello.bin", image)
    @size = bytes.count(image)
    io.show("образ {size}")
    out none
}
