-- forms — команды RV64 по форме: поля opcode / funct3 / funct7 и операнды
-- кладутся в слово напрямую, без таблицы RVA23. Только то, чего нет в RV32I
-- и что нужно исполнителю rv64: ld / lwu / sd, addiw, сдвиги с 6-битной
-- величиной, умножение и деление (M). Формы и проверки полей — у
-- rv32i.machine.codec (encode_i / encode_s / encode_r / encode_i_unsigned).
-- Команды, общие с RV32I, исполнитель кодирует через rv32i.assembler.
-- Эталон правильности — таблица RVA23 (codec): tests/rva23 сверяет оба пути.
--
-- ld / lwu(rd, rs1, offset) -> Word; InvalidImmediate, InvalidRegister
-- sd(rs2, rs1, offset) -> Word; InvalidImmediate, InvalidRegister
-- addiw(rd, rs1, immediate) -> Word; InvalidImmediate, InvalidRegister
-- slli / srli / srai(rd, rs1, shamt) -> Word, shamt 0…63; InvalidShift
-- mul / mulh / mulhu / div / divu / rem / remu(rd, rs1, rs2) -> Word
-- Дробные (D, rm — 0 к ближайшему чётному, 1 к нулю): fop(kind, rd, rs1, rs2) — fadd.d /
--     fsub.d / fmul.d / fdiv.d по FP_FUNCT7[kind]; flt / fle(rd, rs1, rs2); fmv_d_x /
--     fmv_x_d(rd, rs1); fcvt_d_l(rd, rs1); fcvt_l_d(rd, rs1, rm)

use core.group
use selfhost.compiler.backend.rv32i.machine.codec

OPCODE_LOAD = 3
OPCODE_STORE = 35
OPCODE_OP_IMM = 19
OPCODE_OP_IMM_32 = 27
OPCODE_OP = 51
FUNCT3_DOUBLE = 3
FUNCT3_WORD_UNSIGNED = 6
FUNCT3_SHIFT_LEFT = 1
FUNCT3_SHIFT_RIGHT = 5
FUNCT6_ARITHMETIC = 16
FUNCT7_M = 1
SHIFT_LIMIT = 64
OPCODE_FP = 83
FP_FUNCT7 = [1, 5, 9, 13]
FUNCT7_COMPARE = 81
FUNCT7_MOVE_TO_FP = 121
FUNCT7_MOVE_FROM_FP = 113
FUNCT7_FROM_LONG = 105
FUNCT7_TO_LONG = 97
CONVERT_LONG = 2

skill fop(kind, rd, rs1, rs2) {
    out codec.encode_r(OPCODE_FP, rd, 0, rs1, rs2, group.get(FP_FUNCT7, kind))
}

skill flt(rd, rs1, rs2) {
    out codec.encode_r(OPCODE_FP, rd, 1, rs1, rs2, FUNCT7_COMPARE)
}

skill fle(rd, rs1, rs2) {
    out codec.encode_r(OPCODE_FP, rd, 0, rs1, rs2, FUNCT7_COMPARE)
}

skill fmv_d_x(rd, rs1) {
    out codec.encode_r(OPCODE_FP, rd, 0, rs1, 0, FUNCT7_MOVE_TO_FP)
}

skill fmv_x_d(rd, rs1) {
    out codec.encode_r(OPCODE_FP, rd, 0, rs1, 0, FUNCT7_MOVE_FROM_FP)
}

skill fcvt_d_l(rd, rs1) {
    out codec.encode_r(OPCODE_FP, rd, 0, rs1, CONVERT_LONG, FUNCT7_FROM_LONG)
}

skill fcvt_l_d(rd, rs1, rm) {
    out codec.encode_r(OPCODE_FP, rd, rm, rs1, CONVERT_LONG, FUNCT7_TO_LONG)
}

skill ld(rd, rs1, offset) {
    out codec.encode_i(OPCODE_LOAD, rd, FUNCT3_DOUBLE, rs1, offset)
}

skill lwu(rd, rs1, offset) {
    out codec.encode_i(OPCODE_LOAD, rd, FUNCT3_WORD_UNSIGNED, rs1, offset)
}

skill sd(rs2, rs1, offset) {
    out codec.encode_s(OPCODE_STORE, FUNCT3_DOUBLE, rs1, rs2, offset)
}

skill addiw(rd, rs1, immediate) {
    out codec.encode_i(OPCODE_OP_IMM_32, rd, 0, rs1, immediate)
}

skill shift(rd, rs1, funct3, funct6, shamt) {
    (codec.valid_unsigned(shamt, SHIFT_LIMIT) == no) { out error.InvalidShift }
    out codec.encode_i_unsigned(OPCODE_OP_IMM, rd, funct3, rs1, funct6 * 64 + shamt)
}

skill slli(rd, rs1, shamt) {
    out shift(rd, rs1, FUNCT3_SHIFT_LEFT, 0, shamt)
}

skill srli(rd, rs1, shamt) {
    out shift(rd, rs1, FUNCT3_SHIFT_RIGHT, 0, shamt)
}

skill srai(rd, rs1, shamt) {
    out shift(rd, rs1, FUNCT3_SHIFT_RIGHT, FUNCT6_ARITHMETIC, shamt)
}

skill mul(rd, rs1, rs2) {
    out codec.encode_r(OPCODE_OP, rd, 0, rs1, rs2, FUNCT7_M)
}

skill mulh(rd, rs1, rs2) {
    out codec.encode_r(OPCODE_OP, rd, 1, rs1, rs2, FUNCT7_M)
}

skill mulhu(rd, rs1, rs2) {
    out codec.encode_r(OPCODE_OP, rd, 3, rs1, rs2, FUNCT7_M)
}

skill div(rd, rs1, rs2) {
    out codec.encode_r(OPCODE_OP, rd, 4, rs1, rs2, FUNCT7_M)
}

skill divu(rd, rs1, rs2) {
    out codec.encode_r(OPCODE_OP, rd, 5, rs1, rs2, FUNCT7_M)
}

skill rem(rd, rs1, rs2) {
    out codec.encode_r(OPCODE_OP, rd, 6, rs1, rs2, FUNCT7_M)
}

skill remu(rd, rs1, rs2) {
    out codec.encode_r(OPCODE_OP, rd, 7, rs1, rs2, FUNCT7_M)
}
