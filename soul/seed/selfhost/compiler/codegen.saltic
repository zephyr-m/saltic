-- codegen — переводит тело навыка из AST в команды RV32I.
-- Каждый навык берёт и отдаёт compiler; результат выражения — в a0, значение
-- с меткой типа (abi). Промежуточное — через стек (state.push/pop).
-- Арифметика и тяжёлое — вызовы рантайма rt_*, здесь не разворачиваются.
--
-- compile_block(compiler, block, keep) — тело; keep = yes: значение
--     последнего оператора остаётся в a0. Вход из functions.
-- compile_statement(compiler, node, keep) — один оператор; out кладёт
--     значение в a0 и прыгает в конец навыка
-- compile_expression(compiler, node) — любое выражение в a0; вход из
--     functions для констант
-- compile_path(compiler, node) — имя, поле, константа, error.Имя
-- compile_binary(compiler, operator, left, right) — операция через rt_add…
-- compile_call(compiler, node) — вызов навыка, метода или intrinsic
-- compile_arguments(compiler, args) — аргументы в регистры a0…
-- compile_show(compiler, args) — io.show: rt_show на каждый, a0 = none
-- compile_group(compiler, items) — новая группа
-- compile_box(compiler, name, overrides) — новый Box, поля по умолчанию
--     считаются в модуле самого Box
-- compile_template(compiler, plain) — строка "{…}" склейкой через rt_value_text
-- compile_rescue(compiler, node) — выражение rescue с перехватом ошибки
--
-- Внутри: emitters, loops (drum), failures (ошибки), lookup (имена, типы).

use core.str
use core.group
use core.num
use selfhost.abi
use selfhost.ast
use selfhost.intrinsic.contract
use selfhost.compiler.state
use selfhost.compiler.constants
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.machine.word
use selfhost.checker
use selfhost.errors
use selfhost.compiler.codegen.lookup
use selfhost.compiler.codegen.emitters
use selfhost.compiler.codegen.loops
use selfhost.compiler.codegen.failures

skill compile_path(compiler, node) {
    @parts = ast.plain(node)
    @count = group.count(parts)
    @name = group.get(parts, 1)
    @path_name = ast.path_text(parts)
    @constant_name = ""
    @constant = state.Symbol {}
    (name == "error") {
        (count == 3) { out failures.load_value(compiler, group.get(parts, 2)) }
    }
    (count > 2) {
        @enum_name = lookup.resolve_symbol(compiler, compiler.enums, ast.path_prefix(parts))
        (str.len(enum_name) > 0) {
            @full_name = "{enum_name}."
            full_name = str.add(full_name, group.get(parts, count - 1))
            @variant = state.symbol_find(compiler.variants, full_name)
            out state.load_immediate(compiler, "a0", registers.A0, variant.value)
        }
    }
    (state.symbol_has(compiler.current_function.slots, name) == yes) {
        @slot = state.slot(compiler, name)
        compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.S0, registers.ZERO, slot)
    }
    (state.symbol_has(compiler.current_function.slots, name) == no) {
        constant_name = lookup.resolve_symbol(compiler, compiler.constants, path_name)
        constant = state.symbol_find(compiler.constants, constant_name)
        (str.len(constant.name) > 0) {
            (emitters.constant_literal(constant.node) == yes) {
                compiler = compile_expression(compiler, constant.node)
                compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.ZERO, registers.ZERO, abi.CALL_NO_ERROR)
            }
            (emitters.constant_literal(constant.node) == no) {
                @getter = constants.getter_label(constant.name)
                compiler.machine = layout.emit_call(compiler.machine, getter)
                compiler = failures.check(compiler)
            }
        }
        (str.len(constant.name) == 0) {
            @subject_field = lookup.box_field_symbol(compiler, compiler.current_function.subject, name)
            (str.len(subject_field.name) > 0) {
                @self_slot = state.slot(compiler, "$self")
                compiler = state.emit_op(compiler, instruction.Kind.LW, registers.A0, registers.S0, registers.ZERO, self_slot)
                compiler = emitters.emit_field_get(compiler, name)
            }
        }
    }
    (str.len(constant.name) > 0) { out compiler }
    drum (count - 2) {
        compiler = emitters.emit_field_get(compiler, group.get(parts, beat + 2))
    }
    out compiler
}

skill compile_binary(compiler, operator, left, right) {
    compiler = compile_expression(compiler, left)
    pick {
        (emitters.simple_operand(compiler, right) == yes) { compiler = emitters.load_simple(compiler, right, registers.A1) }
        {
            compiler = state.push(compiler, "a0", registers.A0)
            compiler = compile_expression(compiler, right)
            compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A1, registers.A0, registers.ZERO, 0)
            compiler = state.pop(compiler, "a0", registers.A0)
        }
    }
    @target = ""
    @fixed_type = lookup.infer_type(compiler, left)
    @fixed = contract.is_fixed_type(fixed_type)
    (operator == "+") { target = "rt_add" }
    (operator == "-") { target = "rt_sub" }
    (operator == "*") { target = "rt_mul" }
    (operator == "/") { target = "rt_div" }
    (operator == "==") { target = "rt_equal" }
    (operator == ">") { target = "rt_greater" }
    (operator == "<") { target = "rt_less" }
    (fixed == yes) {
        (operator == "+") { target = "rt_fixed_add" }
        (operator == "-") { target = "rt_fixed_sub" }
        (operator == "*") { target = "rt_fixed_mul" }
        (operator == "/") { target = "rt_fixed_div" }
        (operator == "==") { target = "rt_fixed_equal" }
        (operator == ">") { target = "rt_fixed_greater" }
        (operator == "<") { target = "rt_fixed_less" }
        compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(fixed_type))
    }
    (fixed == no) {
        (operator == "+") { out failures.check(emitters.emit_checked_word(compiler, instruction.Kind.ADD)) }
        (operator == "-") { out failures.check(emitters.emit_checked_word(compiler, instruction.Kind.SUB)) }
        (operator == "<") { out emitters.emit_number_less(compiler, registers.A0, registers.A1) }
        (operator == ">") { out emitters.emit_number_less(compiler, registers.A1, registers.A0) }
        (operator == "==") {
            (emitters.immediate_operand(compiler, left) == yes) { out emitters.emit_word_equal(compiler) }
            (emitters.immediate_operand(compiler, right) == yes) { out emitters.emit_word_equal(compiler) }
            out emitters.emit_equal_fast_path(compiler)
        }
    }
    compiler.machine = layout.emit_call(compiler.machine, target)
    out failures.check(compiler)
}

skill compile_rescue(compiler, node) {
    @plain = ast.plain(node)
    @frame = failures.rescue_frame(compiler)
    compiler = failures.enter(compiler, frame)
    compiler = compile_expression(compiler, group.get(plain, 1))
    compiler = failures.catch(compiler, frame, group.get(plain, 2))
    compiler = compile_block(compiler, group.get(plain, 3), yes)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, frame.done)
    out compiler
}

skill compile_arguments(compiler, args) {
    @count = group.count(args)
    drum (args) {
        compiler = compile_expression(compiler, beat)
        compiler = state.push(compiler, "a0", registers.A0)
    }
    drum (count) {
        compiler = state.emit_op(compiler, instruction.Kind.LW, abi.argument_register(beat), registers.SP, registers.ZERO, constants.stack_source_offset(count, beat))
    }
    (count > 0) {
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, constants.stack_bytes(count))
    }
    out compiler
}

skill compile_show(compiler, args) {
    drum (args) {
        compiler = compile_expression(compiler, beat)
        @type = lookup.infer_type(compiler, beat)
        pick {
            (contract.is_fixed_type(type) == yes) {
                compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(type))
                compiler.machine = layout.emit_call(compiler.machine, "rt_fixed_show")
            }
            { compiler.machine = layout.emit_call(compiler.machine, "rt_show") }
        }
    }
    compiler.machine = layout.emit_call(compiler.machine, "rt_newline")
    out state.load_immediate(compiler, "a0", registers.A0, abi.NONE)
}

skill compile_group(compiler, items) {
    @count = group.count(items)
    drum (items) {
        compiler = compile_expression(compiler, beat)
        compiler = state.push(compiler, "a0", registers.A0)
    }
    compiler = state.load_immediate(compiler, "a0", registers.A0, constants.group_storage_bytes(count))
    compiler.machine = layout.emit_call(compiler.machine, "rt_alloc")
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, abi.OBJECT_KIND_GROUP)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_HEADER_KIND_OFFSET)
    compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T3, registers.ZERO, registers.ZERO, count)
    compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T3, abi.OBJECT_PAYLOAD_OFFSET + constants.GROUP_COUNT_OFFSET)
    drum (count) {
        compiler = state.emit_op(compiler, instruction.Kind.LW, registers.T0, registers.SP, registers.ZERO, constants.stack_source_offset(count, beat))
        compiler = state.emit_op(compiler, instruction.Kind.SW, registers.ZERO, registers.A0, registers.T0, abi.OBJECT_PAYLOAD_OFFSET + constants.group_item_offset(beat))
    }
    (count > 0) {
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.SP, registers.SP, registers.ZERO, constants.stack_bytes(count))
    }
    out state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_GROUP)
}

skill compile_box(compiler, name, overrides) {
    @model = state.symbol_find(compiler.boxes, name)
    @fields = []
    @member_count = group.count(ast.plain(model.node))
    drum (member_count - 2) {
        @member = ast.part(model.node, beat + 2)
        (ast.tag(member) == "field") { fields = group.add(fields, member) }
    }
    @count = group.count(fields)
    drum (fields) {
        @value = lookup.box_override(overrides, ast.part(beat, 1))
        @default_value = no
        (group.count(value) == 0) { value = ast.part(beat, 2) default_value = yes }
        @caller_module = compiler.current_function.module
        (default_value == yes) { compiler.current_function.module = model.text }
        compiler = compile_expression(compiler, value)
        compiler.current_function.module = caller_module
        compiler = state.push(compiler, "a0", registers.A0)
    }
    @field_ids = []
    drum (fields) { field_ids = group.add(field_ids, state.field(compiler, ast.part(beat, 1))) }
    out emitters.store_box(compiler, field_ids, state.box_number(compiler, name))
}

skill compile_call(compiler, node) {
    @plain = ast.plain(node)
    @callee = ast.plain(group.get(plain, 1))
    @args = lookup.call_arguments(node)
    @name = lookup.call_name(compiler, callee)
    @seed_kind = contract.find(name)
    (contract.is_show(seed_kind) == yes) { out compile_show(compiler, args) }
    (contract.is_fixed_type(name) == yes) {
        @argument = group.get(args, 0)
        pick {
            (emitters.fixed_literal(argument) == yes) { compiler = emitters.load_fixed_literal(compiler, argument) }
            {
                compiler = compile_expression(compiler, argument)
                @source_type = lookup.infer_type(compiler, argument)
                (contract.is_fixed_type(source_type) == no) {
                    compiler = state.emit_op(compiler, instruction.Kind.SRAI, registers.A0, registers.A0, registers.ZERO, abi.TAG_SHIFT)
                }
            }
        }
        compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(name))
        compiler.machine = layout.emit_call(compiler.machine, "rt_fixed_new")
        out compiler
    }
    @conversion = contract.conversion(seed_kind)
    (str.len(conversion) > 0) {
        compiler = compile_arguments(compiler, args)
        @source_type = lookup.infer_type(compiler, group.get(args, 0))
        compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(source_type))
        compiler = state.load_immediate(compiler, "a7", abi.CALL_FIXED_TARGET_KIND_REGISTER, contract.fixed_kind(conversion))
        compiler.machine = layout.emit_call(compiler.machine, "rt_fixed_convert")
        out compiler
    }
    @fixed_target = ""
    (contract.is_fixed_call(seed_kind) == yes) { fixed_target = contract.target(seed_kind, "unknown") }
    (str.len(fixed_target) > 0) {
        compiler = compile_arguments(compiler, args)
        @fixed_type = lookup.infer_type(compiler, group.get(args, 0))
        compiler = state.load_immediate(compiler, "a6", abi.CALL_FIXED_SOURCE_KIND_REGISTER, contract.fixed_kind(fixed_type))
        compiler.machine = layout.emit_call(compiler.machine, fixed_target)
        compiler = failures.check(compiler)
        out compiler
    }
    @memory_target = ""
    (group.count(args) > 0) {
        @input_type = lookup.infer_type(compiler, group.get(args, 0))
        (contract.is_memory(seed_kind) == yes) { memory_target = contract.target(seed_kind, input_type) }
    }
    (str.len(memory_target) > 0) {
        compiler = compile_arguments(compiler, args)
        compiler.machine = layout.emit_call(compiler.machine, memory_target)
        compiler = failures.check(compiler)
        out compiler
    }
    @resolved_box = lookup.resolve_symbol(compiler, compiler.boxes, name)
    (str.len(resolved_box) > 0) { out compile_box(compiler, resolved_box, []) }
    (group.count(callee) == 2) {
        @short_name = group.get(callee, 1)
        (str.len(compiler.current_function.subject) > 0) {
            (checker.box_has_skill(compiler.boxes, compiler.current_function.subject, short_name) == yes) {
                @with_self = group.concat([["path", "$self"]], args)
                compiler = compile_arguments(compiler, with_self)
                @target = "{compiler.current_function.subject}."
                target = str.add(target, short_name)
                @method_target = str.add("saltic_", state.safe(target))
                compiler.machine = layout.emit_call(compiler.machine, method_target)
                out failures.check(compiler)
            }
        }
    }
    (group.count(callee) == 3) {
        @receiver = ["path", group.get(callee, 1)]
        @receiver_type = lookup.infer_type(compiler, receiver)
        (str.starts_with(receiver_type, "box:") == yes) {
            @box_name = str.slice(receiver_type, 4, str.len(receiver_type))
            @method = group.get(callee, 2)
            (checker.box_has_skill(compiler.boxes, box_name, method) == yes) {
                @with_receiver = group.concat([receiver], args)
                compiler = compile_arguments(compiler, with_receiver)
                @target = "{box_name}."
                target = str.add(target, method)
                @method_target = str.add("saltic_", state.safe(target))
                compiler.machine = layout.emit_call(compiler.machine, method_target)
                out failures.check(compiler)
            }
        }
    }
    @target = lookup.intrinsic(name)
    (str.len(target) == 0) {
        @resolved_skill = lookup.resolve_skill(compiler, callee)
        (str.len(resolved_skill) > 0) { target = str.add("saltic_", state.safe(resolved_skill)) }
    }
    (str.len(target) == 0) {
        (group.count(callee) == 3) {
            (state.symbol_has(compiler.current_function.slots, group.get(callee, 1)) == yes) {
                compiler = compile_arguments(compiler, group.concat([["path", group.get(callee, 1)]], args))
                (group.contains(compiler.dispatches, group.get(callee, 2)) == no) { compiler.dispatches = group.add(compiler.dispatches, group.get(callee, 2)) }
                compiler.machine = layout.emit_call(compiler.machine, state.dispatch_label(group.get(callee, 2)))
                out failures.check(compiler)
            }
        }
        @call_text = ast.path_text(callee)
        @problem = errors.unresolved_call(call_text, compiler.current_function.name)
        io.show(problem.message)
    }
    compiler = compile_arguments(compiler, args)
    compiler.machine = layout.emit_call(compiler.machine, target)
    out failures.check(compiler)
}

skill compile_template(compiler, plain) {
    compiler = compile_expression(compiler, ["string", group.get(plain, 1)])
    compiler = state.push(compiler, "a0", registers.A0)
    drum ((group.count(plain) - 2) / 2) {
        compiler = compile_expression(compiler, group.get(plain, beat * 2 + 2))
        compiler.machine = layout.emit_call(compiler.machine, "rt_value_text")
        compiler = emitters.emit_string_join(compiler)
        @text = group.get(plain, beat * 2 + 3)
        (str.len(text) > 0) {
            compiler = compile_expression(compiler, ["string", text])
            compiler = emitters.emit_string_join(compiler)
        }
    }
    out state.pop(compiler, "a0", registers.A0)
}

skill compile_expression(compiler, node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "number") { out emitters.load_number(compiler, group.get(plain, 1)) }
    (tag == "template") { out compile_template(compiler, plain) }
    (tag == "string") {
        @label = emitters.string_label(compiler, group.get(plain, 1))
        compiler.machine = layout.emit_relative_address(compiler.machine, registers.A0, label, 0)
        out state.emit_op(compiler, instruction.Kind.ORI, registers.A0, registers.A0, registers.ZERO, abi.TAG_STRING)
    }
    (tag == "answer") {
        (group.get(plain, 1) == "yes") { out state.load_immediate(compiler, "a0", registers.A0, abi.YES) }
        out state.load_immediate(compiler, "a0", registers.A0, abi.NO)
    }
    (tag == "none") { out state.load_immediate(compiler, "a0", registers.A0, abi.NONE) }
    (tag == "path") { out compile_path(compiler, node) }
    (tag == "binary") {
        (emitters.negative_literal(node) == yes) {
            @magnitude = ast.plain(group.get(plain, 3))
            out emitters.load_number(compiler, 0 - group.get(magnitude, 1))
        }
        out compile_binary(compiler, group.get(plain, 1), group.get(plain, 2), group.get(plain, 3))
    }
    (tag == "call") { out compile_call(compiler, node) }
    (tag == "group") { out compile_group(compiler, group.slice(plain, 1, group.count(plain))) }
    (tag == "box-new") {
        @box_name = lookup.resolve_symbol(compiler, compiler.boxes, group.get(plain, 1))
        out compile_box(compiler, box_name, group.slice(plain, 2, group.count(plain)))
    }
    (tag == "rescue") { out compile_rescue(compiler, node) }
    (tag == "enum-value") {
        @variant = state.symbol_find(compiler.variants, group.get(plain, 1))
        out state.load_immediate(compiler, "a0", registers.A0, variant.value)
    }
    out compiler
}

skill compile_block(compiler, block, keep) {
    @plain = ast.plain(block)
    @count = group.count(plain)
    drum (count - 1) {
        @last = no
        (keep == yes) {
            (beat + 2 == count) { last = yes }
        }
        compiler = compile_statement(compiler, group.get(plain, beat + 1), last)
    }
    (keep == yes) {
        (count == 1) { compiler = state.load_immediate(compiler, "a0", registers.A0, abi.NONE) }
    }
    out compiler
}

skill compile_statement(compiler, node, keep) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "var") {
        compiler = compile_expression(compiler, group.get(plain, 2))
        out emitters.store_local(compiler, group.get(plain, 1), group.get(plain, 2))
    }
    (tag == "assign") {
        compiler = compile_expression(compiler, group.get(plain, 2))
        out emitters.store_local(compiler, group.get(plain, 1), group.get(plain, 2))
    }
    (tag == "field-assign") {
        @target = ast.plain(group.get(plain, 1))
        @part_count = group.count(target)
        @base = group.slice(target, 0, part_count - 1)
        compiler = compile_expression(compiler, base)
        compiler = state.push(compiler, "a0", registers.A0)
        compiler = compile_expression(compiler, group.get(plain, 2))
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.A0, registers.ZERO, 0)
        compiler = state.pop(compiler, "a0", registers.A0)
        out emitters.emit_field_set(compiler, group.get(target, part_count - 1))
    }
    (tag == "out") {
        @failure = lookup.failure_name(group.get(plain, 1))
        pick {
            (str.len(failure) > 0) { compiler = failures.load_failure(compiler, failure) }
            (lookup.infer_type(compiler, group.get(plain, 1)) == "error") { compiler = failures.raise_value(compile_expression(compiler, group.get(plain, 1))) }
            { compiler = compile_expression(compiler, group.get(plain, 1)) }
        }
        @value_root = constants.REGION_VALUE_ROOT
        (abi.is_raw_value(lookup.infer_type(compiler, group.get(plain, 1))) == yes) { value_root = constants.REGION_VALUE_SKIPPED }
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.A2, registers.ZERO, registers.ZERO, value_root)
        compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, compiler.current_function.end)
        out compiler
    }
    (tag == "expr") { out compile_expression(compiler, group.get(plain, 1)) }
    (tag == "pick") {
        @end = state.label(compiler, "pick_end")
        drum (group.count(plain) - 1) {
            @choice = ast.plain(group.get(plain, beat + 1))
            (group.get(choice, 0) == "if") {
                @next = state.label(compiler, "pick_next")
                compiler = compile_expression(compiler, group.get(choice, 1))
                compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.NO)
                compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, registers.ZERO, registers.A0, registers.T0, 8)
                compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, next)
                compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.NONE)
                compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, registers.ZERO, registers.A0, registers.T0, 8)
                compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, next)
                compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, registers.ZERO, registers.A0, registers.ZERO, 8)
                compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, next)
                compiler = compile_block(compiler, group.get(choice, 2), keep)
                compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, end)
                compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, next)
            }
            (group.get(choice, 0) == "otherwise") {
                compiler = compile_block(compiler, group.get(choice, 1), keep)
            }
        }
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, end)
        out compiler
    }
    (tag == "leave") {
        compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, compiler.current_function.drum_exit)
        out compiler
    }
    (tag == "if") {
        @end = state.label(compiler, "if_end")
        compiler = compile_expression(compiler, group.get(plain, 1))
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.NO)
        compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, registers.ZERO, registers.A0, registers.T0, 8)
        compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, end)
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T0, registers.ZERO, registers.ZERO, abi.NONE)
        compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, registers.ZERO, registers.A0, registers.T0, 8)
        compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, end)
        compiler.machine = layout.emit(compiler.machine, instruction.Kind.BNE, registers.ZERO, registers.A0, registers.ZERO, 8)
        compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, end)
        compiler = compile_block(compiler, group.get(plain, 2), keep)
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, end)
        out compiler
    }
    (tag == "switch") {
        @end = state.label(compiler, "switch_end")
        compiler = compile_expression(compiler, group.get(plain, 1))
        compiler = state.emit_op(compiler, instruction.Kind.ADDI, registers.T2, registers.A0, registers.ZERO, 0)
        drum (group.count(plain) - 2) {
            @case_node = ast.plain(group.get(plain, beat + 2))
            @next = state.label(compiler, "case_next")
            @variant = state.symbol_find(compiler.variants, group.get(case_node, 1))
            compiler = state.load_immediate(compiler, "t0", registers.T0, variant.value)
            compiler.machine = layout.emit(compiler.machine, instruction.Kind.BEQ, registers.ZERO, registers.T2, registers.T0, 8)
            compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, next)
            compiler = compile_expression(compiler, group.get(case_node, 2))
            compiler.machine = layout.emit_jump(compiler.machine, registers.ZERO, end)
            compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, next)
        }
        compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, end)
        out compiler
    }
    (tag == "drum") {
        @frame = loops.frame(compiler)
        @uses_beat = state.block_uses_beat(group.get(plain, 2))
        compiler = compile_expression(compiler, group.get(plain, 1))
        (uses_beat == no) {
            compiler = loops.light_head(compiler, frame)
            @light_exit = compiler.current_function.drum_exit
            compiler.current_function.drum_exit = frame.end
            compiler = compile_block(compiler, group.get(plain, 2), no)
            compiler.current_function.drum_exit = light_exit
            out loops.light_tail(compiler, frame)
        }
        compiler = loops.head(compiler, frame)
        @outer_exit = compiler.current_function.drum_exit
        compiler.current_function.drum_exit = frame.end
        compiler = compile_block(compiler, group.get(plain, 2), no)
        compiler.current_function.drum_exit = outer_exit
        out loops.tail(compiler, frame)
    }
    out compiler
}
