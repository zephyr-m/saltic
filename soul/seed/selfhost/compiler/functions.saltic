-- functions — пролог/эпилог навыков, ленивые константы и диспетчеры методов.
-- Навык: метка saltic_<имя>, кадр по constants, аргументы из ARG0… в слоты,
-- выход через <имя>_return с rt_region_exit; ошибка — <имя>_failure (кладёт имя
-- навыка в путь ошибки — rt_trail_push).
-- Константа: геттер saltic_constant_get_<имя> считает один раз, цикл —
-- ERROR_CONSTANT_CYCLE. Метод Box: диспетчер по номеру типа в последнем поле.
-- Команды — методами compiler.executor (договор backend).
--
-- compile_function(compiler, name, params, body, subject, module) — один навык
--     или метод (subject — имя Box, $self первым параметром)
-- compile_constant(compiler, constant) — геттер константы
-- compile_constants(compiler) — все константы
-- compile_functions(compiler) — все навыки, методы, program и диспетчеры
-- compile_dispatch(compiler, method) — выбор метода по Box; ERROR_NO_METHOD

use core.str
use core.group
use selfhost.abi
use selfhost.ast
use selfhost.compiler.state
use selfhost.compiler.constants
use selfhost.compiler.backend
use selfhost.compiler.codegen
use selfhost.compiler.codegen.emitters
use selfhost.checker
use selfhost.compiler.backend.rv32i.runtime.tails

skill compile_function(compiler, name, params, body, subject, module) {
    @executor = compiler.executor
    @locals = state.collect_locals(params, body)
    @local_count = group.count(locals.names)
    @frame = constants.frame_bytes(compiler.words, local_count)
    @slots = state.make_slots(compiler.words, locals.names, constants.local_offset(compiler.words, 0))
    @end = state.label(compiler, "{name}_return")
    @failure = state.label(compiler, "{name}_failure")
    @types = []
    drum (params) { types = state.type_set(types, beat, "unknown") }
    (str.bytes(subject) > 0) { types = state.type_set(types, "$self", "box:{subject}") }
    compiler.current_function = state.Function { name = name, slots = slots, end = end, failure = failure, subject = subject, module = module, types = types }
    @function_label = str.concat("saltic_", state.safe(name))
    compiler = executor.label(compiler, function_label)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - frame)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, constants.return_address_save_offset(compiler.words, frame))
    compiler = executor.store(compiler, backend.FRAME, backend.STACK, constants.previous_frame_save_offset(compiler.words, frame))
    compiler = executor.store(compiler, backend.REGION_MARK, backend.STACK, constants.region_mark_save_offset(compiler.words, frame))
    compiler = executor.store(compiler, backend.ESCAPE_MARK, backend.STACK, constants.region_escape_save_offset(compiler.words, frame))
    compiler = executor.add_immediate(compiler, backend.FRAME, backend.STACK, frame)
    compiler = executor.move(compiler, backend.REGION_MARK, backend.HEAP_TOP)
    compiler = executor.move(compiler, backend.ESCAPE_MARK, backend.ESCAPE_BOTTOM)
    drum (group.count(params)) {
        @slot = state.slot(compiler, group.get(params, beat))
        compiler = executor.store(compiler, backend.argument(beat), backend.FRAME, slot)
    }
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = codegen.compile_block(compiler, body, no)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.jump(compiler, end)
    compiler = executor.label(compiler, failure)
    compiler = executor.load_address(compiler, backend.VALUE, emitters.string_label(compiler, name), 0)
    compiler = executor.or_immediate(compiler, backend.VALUE, backend.VALUE, abi.TAG_STRING)
    compiler = executor.call(compiler, "rt_trail_push")
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    compiler = executor.load_immediate(compiler, backend.ARG2, constants.REGION_VALUE_SKIPPED)
    compiler = executor.label(compiler, end)
    @region_done = "{end}_region"
    compiler = executor.branch_equal(compiler, backend.HEAP_TOP, backend.REGION_MARK, region_done)
    compiler = executor.call(compiler, "rt_region_exit")
    compiler = executor.label(compiler, region_done)
    compiler = executor.load(compiler, backend.RETURN, backend.FRAME, constants.return_address_load_offset(compiler.words))
    compiler = executor.load(compiler, backend.REGION_MARK, backend.FRAME, constants.region_mark_load_offset(compiler.words))
    compiler = executor.load(compiler, backend.ESCAPE_MARK, backend.FRAME, constants.region_escape_load_offset(compiler.words))
    compiler = executor.load(compiler, backend.SCRATCH0, backend.FRAME, constants.previous_frame_load_offset(compiler.words))
    compiler = executor.move(compiler, backend.STACK, backend.FRAME)
    compiler = executor.move(compiler, backend.FRAME, backend.SCRATCH0)
    compiler = executor.ret(compiler)
    compiler.current_function = state.Function {}
    out compiler
}

skill compile_constant(compiler, constant) {
    @executor = compiler.executor
    @ready = state.label(compiler, "constant_ready")
    @cycle = state.label(compiler, "constant_cycle")
    @failure = state.label(compiler, "constant_failure")
    @finish = state.label(compiler, "constant_finish")
    @before = compiler.current_function
    compiler.current_function = state.Function { name = constant.name, module = constant.text }

    @getter = constants.getter_label(constant.name)
    compiler = executor.label(compiler, getter)
    @frame = constants.constant_frame_bytes(compiler.words)
    @return_address_offset = constants.constant_return_address_offset(compiler.words)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, 0 - frame)
    compiler = executor.store(compiler, backend.RETURN, backend.STACK, return_address_offset)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.load_address(compiler, backend.SCRATCH0, constants.state_label(constant.name), 0)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, constants.STATE_READY)
    compiler = executor.jump_if_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, ready)
    compiler = executor.load_immediate(compiler, backend.SCRATCH2, constants.STATE_INITIALIZING)
    compiler = executor.jump_if_equal(compiler, backend.SCRATCH1, backend.SCRATCH2, cycle)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, constants.STATE_INITIALIZING)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)

    compiler = codegen.compile_expression(compiler, constant.node)
    compiler = executor.jump_if_nonzero(compiler, backend.ERROR, failure)
    compiler = executor.load_address(compiler, backend.SCRATCH0, constants.value_label(constant.name), 0)
    compiler = executor.store(compiler, backend.VALUE, backend.SCRATCH0, 0)
    compiler = executor.call(compiler, "rt_region_remember_slot")
    compiler = executor.load_address(compiler, backend.SCRATCH0, constants.state_label(constant.name), 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, constants.STATE_READY)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)
    compiler = executor.jump(compiler, finish)

    compiler = executor.label(compiler, ready)
    compiler = executor.load_address(compiler, backend.SCRATCH0, constants.value_label(constant.name), 0)
    compiler = executor.load(compiler, backend.VALUE, backend.SCRATCH0, 0)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.jump(compiler, finish)

    compiler = executor.label(compiler, cycle)
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.ERROR_CONSTANT_CYCLE)

    compiler = executor.label(compiler, failure)
    compiler = executor.load_address(compiler, backend.SCRATCH0, constants.state_label(constant.name), 0)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, constants.STATE_EMPTY)
    compiler = executor.store(compiler, backend.SCRATCH1, backend.SCRATCH0, 0)

    compiler = executor.label(compiler, finish)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, return_address_offset)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, frame)
    compiler = executor.ret(compiler)
    compiler.current_function = before
    out compiler
}

skill compile_constants(compiler) {
    drum (compiler.constants) { compiler = compile_constant(compiler, beat) }
    out compiler
}

skill compile_functions(compiler) {
    drum (compiler.skills) {
        compiler = compile_function(compiler, beat.name, ast.part(beat.node, 2), ast.part(beat.node, 3), "", beat.text)
    }
    drum (compiler.boxes) {
        @box = beat
        drum (group.count(ast.plain(box.node)) - 2) {
            @member = ast.part(box.node, beat + 2)
            (ast.tag(member) == "subject-skill") {
                @name = "{box.name}."
                name = str.concat(name, ast.part(member, 1))
                @params = group.concat(["$self"], ast.part(member, 2))
                compiler = compile_function(compiler, name, params, ast.part(member, 3), box.name, ast.module_name(box.node))
            }
        }
    }
    compiler = compile_function(compiler, "program", ast.part(compiler.entry, 1), ast.part(compiler.entry, 2), "", "")
    drum (compiler.dispatches) { compiler = compile_dispatch(compiler, beat) }
    out compiler
}

skill compile_dispatch(compiler, method) {
    @executor = compiler.executor
    @words = compiler.words
    @label = state.dispatch_label(method)
    @missing = "{label}_missing"
    compiler = executor.label(compiler, label)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.TAG_MASK)
    compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.TAG_BOX)
    compiler = executor.branch_not_equal(compiler, backend.SCRATCH0, backend.SCRATCH1, missing)
    compiler = executor.and_immediate(compiler, backend.SCRATCH0, backend.VALUE, abi.PAYLOAD_MASK)
    compiler = executor.load(compiler, backend.SCRATCH1, backend.SCRATCH0, words.payload + constants.BOX_COUNT_OFFSET)
    compiler = executor.shift_left(compiler, backend.SCRATCH1, backend.SCRATCH1, words.shift + 1)
    compiler = executor.add(compiler, backend.SCRATCH0, backend.SCRATCH0, backend.SCRATCH1)
    compiler = executor.load(compiler, backend.SCRATCH2, backend.SCRATCH0, words.payload + words.box_fields + words.box_field_value - words.box_field)
    drum (group.count(compiler.boxes)) {
        @box = group.get(compiler.boxes, beat)
        (checker.box_has_skill(compiler.boxes, box.name, method) == yes) {
            @next = "{label}_{beat}"
            compiler = executor.load_immediate(compiler, backend.SCRATCH1, abi.tagged(beat + 1, abi.TAG_NUMBER))
            compiler = executor.branch_not_equal(compiler, backend.SCRATCH2, backend.SCRATCH1, next)
            compiler = executor.jump(compiler, str.concat("saltic_", state.safe(str.concat("{box.name}.", method))))
            compiler = executor.label(compiler, next)
        }
    }
    out tails.fail(compiler, missing, abi.ERROR_NO_METHOD)
}
