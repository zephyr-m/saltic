-- intrinsic — таблица встроенных операций core.* и io.*: какие бывают, сколько
-- берут аргументов, что отдают и какой навык рантайма rt_* их исполняет.
-- Одна операция — одна строка TABLE: [имя, вид, число аргументов, результат,
-- типы аргументов, метка rt_*]. Имя — полный путь ("core.group.get"), вид —
-- вариант Kind; число -1 — переменное (io.show: 1…ARGUMENT_LIMIT). Типы —
-- тексты чекера; последний тип в списке — и для всех следующих аргументов,
-- пустой список — "unknown". Особые результаты: "group-item", "group-add",
-- "memory-load" (считаются по входному типу в contract). Метка "" — у памяти
-- и io.show (их ведут дети и кодоген).
--
-- Kind = enum { UNKNOWN, GROUP_*, MEM_*, CPU_*, FILE_*, STR_*, NUM_TEXT, IO_*, PROCESS_*, ENVIRONMENT, TIME_NOW,
--     U8_FROM…USIZE_FROM, BITS32_FROM, ADDRESS_FROM, NUM_FROM, BITS32_*,
--     ADDRESS_ADD, BYTES_* }
-- find(name) -> Kind или Kind.UNKNOWN
-- exact_argument_count(kind) -> число или -1
-- minimum_arguments / maximum_arguments(kind) -> число (у всех — точное)
-- result(kind) -> тип результата или "unknown"
-- argument_type(kind, index) -> ожидаемый тип аргумента или "unknown"
-- target(kind) -> имя rt_* или ""
-- Внутри: row(kind) -> строка TABLE или []
--
-- Дети: contract (общий вход для чекера и компилятора), fixed, memory.

use core.group

Kind = enum {
    UNKNOWN,
    GROUP_COUNT, GROUP_GET, GROUP_ADD,
    MEM_LOAD8, MEM_LOAD16, MEM_LOAD32,
    MEM_STORE8, MEM_STORE16, MEM_STORE32, MEM_STORE_ADDRESS32,
    CPU_WAIT, CPU_FENCE,
    FILE_READ, FILE_WRITE, FILE_WRITE_BYTES,
    STR_LINE_COUNT, STR_ADD, STR_LEN, STR_GET, STR_BYTE, STR_FROM_BYTE, STR_SLICE,
    STR_CONTAINS, STR_STARTS_WITH, STR_ENDS_WITH, STR_LOWER, STR_UPPER,
    NUM_TEXT, IO_SHOW,
    U8_FROM, U16_FROM, U32_FROM, I32_FROM, USIZE_FROM, BITS32_FROM, ADDRESS_FROM, NUM_FROM,
    BITS32_AND, BITS32_OR, BITS32_XOR, BITS32_NOT,
    BITS32_SHIFT_LEFT, BITS32_SHIFT_RIGHT,
    ADDRESS_ADD,
    IO_KEY, IO_CLEAR, IO_READ_LINE,
    CPU_FIRMWARE, MEM_ARENA, MEM_HEAP, CPU_CALL,
    GROUP_TREE_PARTS, GROUP_TREE_MAKE,
    BYTES_MAKE, BYTES_COUNT, BYTES_LOAD, BYTES_STORE,
    BYTES_COPY, FILE_WRITE_BUFFER, FILE_READ_BYTES,
    PROCESS_PIPE, PROCESS_WAIT, PROCESS_READ, PROCESS_CLOSE,
    PROCESS_EXECUTABLE, ENVIRONMENT, FILE_LIST, TIME_NOW,
    PROCESS_OPEN, PROCESS_INPUT, PROCESS_WRITE,
    SOCKET_OPEN, SOCKET_CONNECT, SOCKET_WRITE, SOCKET_READ, SOCKET_CLOSE,
    SOCKET_MEMORY, SOCKET_RESIZE, SOCKET_SEND, SOCKET_PLACE
}

TABLE = [
    ["core.group.count", Kind.GROUP_COUNT, 1, "number", ["group:unknown"], "rt_group_count"],
    ["core.group.get", Kind.GROUP_GET, 2, "group-item", ["group:unknown", "number"], "rt_group_at"],
    ["core.group.add", Kind.GROUP_ADD, 2, "group-add", ["group:unknown", "unknown"], "rt_group_add"],
    ["core.group.tree_parts", Kind.GROUP_TREE_PARTS, 1, "group:unknown", ["group:unknown"], "rt_group_tree_parts"],
    ["core.group.tree_make", Kind.GROUP_TREE_MAKE, 4, "group:unknown", ["number", "number", "group:unknown"], "rt_group_tree_make"],
    ["core.bytes.make", Kind.BYTES_MAKE, 1, "bytes", ["number"], "rt_bytes_make"],
    ["core.bytes.count", Kind.BYTES_COUNT, 1, "number", ["bytes"], "rt_string_len"],
    ["core.bytes.load", Kind.BYTES_LOAD, 2, "number", ["bytes", "number"], "rt_string_byte"],
    ["core.bytes.store", Kind.BYTES_STORE, 3, "none", ["bytes", "number"], "rt_bytes_store"],
    ["core.bytes.copy", Kind.BYTES_COPY, 3, "bytes", ["bytes", "number"], "rt_string_slice"],
    ["io.file.write_buffer", Kind.FILE_WRITE_BUFFER, 2, "none", ["string", "bytes"], "rt_platform_file_write"],
    ["io.file.read_bytes", Kind.FILE_READ_BYTES, 1, "bytes", ["string"], "rt_platform_file_read"],
    ["io.file.list", Kind.FILE_LIST, 1, "group:string", ["string"], "rt_platform_file_list"],
    ["core.process.open", Kind.PROCESS_OPEN, 6, "number", ["string", "unknown", "string", "answer", "unknown", "answer"], "rt_platform_process_open"],
    ["core.process.pipe_end", Kind.PROCESS_PIPE, 0, "number", [], "rt_platform_process_pipe"],
    ["core.process.input_end", Kind.PROCESS_INPUT, 0, "number", [], "rt_platform_process_input"],
    ["core.process.write_input", Kind.PROCESS_WRITE, 2, "none", ["number", "string"], "rt_platform_process_write"],
    ["core.socket.open", Kind.SOCKET_OPEN, 3, "number", ["number"], "rt_platform_socket_open"],
    ["core.socket.connect", Kind.SOCKET_CONNECT, 2, "number", ["number", "bytes"], "rt_platform_socket_connect"],
    ["core.socket.write", Kind.SOCKET_WRITE, 3, "number", ["number", "bytes", "number"], "rt_platform_socket_write"],
    ["core.socket.read", Kind.SOCKET_READ, 2, "number", ["number", "bytes"], "rt_platform_socket_read"],
    ["core.socket.close", Kind.SOCKET_CLOSE, 1, "number", ["number"], "rt_platform_socket_close"],
    ["core.socket.memory", Kind.SOCKET_MEMORY, 1, "number", ["string"], "rt_platform_socket_memory"],
    ["core.socket.resize", Kind.SOCKET_RESIZE, 2, "number", ["number"], "rt_platform_socket_resize"],
    ["core.socket.send", Kind.SOCKET_SEND, 4, "number", ["number", "bytes", "number"], "rt_platform_socket_send"],
    ["core.socket.place", Kind.SOCKET_PLACE, 3, "number", ["number", "bytes", "number"], "rt_platform_socket_place"],
    ["core.process.wait", Kind.PROCESS_WAIT, 1, "number", ["number"], "rt_platform_process_wait"],
    ["core.process.read_output", Kind.PROCESS_READ, 1, "string", ["number"], "rt_platform_process_read"],
    ["core.process.close_output", Kind.PROCESS_CLOSE, 1, "none", ["number"], "rt_platform_process_close"],
    ["core.process.executable", Kind.PROCESS_EXECUTABLE, 1, "answer", ["string"], "rt_platform_process_executable"],
    ["core.process.environment", Kind.ENVIRONMENT, 0, "group:string", [], "rt_platform_environment"],
    ["core.time.now", Kind.TIME_NOW, 0, "number", [], "rt_platform_now"],
    ["core.mem.load8", Kind.MEM_LOAD8, 2, "memory-load", [], ""],
    ["core.mem.load16", Kind.MEM_LOAD16, 2, "memory-load", [], ""],
    ["core.mem.load32", Kind.MEM_LOAD32, 2, "memory-load", [], ""],
    ["core.mem.store8", Kind.MEM_STORE8, 3, "none", [], ""],
    ["core.mem.store16", Kind.MEM_STORE16, 3, "none", [], ""],
    ["core.mem.store32", Kind.MEM_STORE32, 3, "none", [], ""],
    ["core.mem.store_address32", Kind.MEM_STORE_ADDRESS32, 3, "none", [], ""],
    ["core.mem.arena", Kind.MEM_ARENA, 1, "number", ["number"], "rt_mem_arena"],
    ["core.mem.heap", Kind.MEM_HEAP, 1, "number", ["number"], "rt_mem_heap"],
    ["core.cpu.wait", Kind.CPU_WAIT, 0, "none", [], "rt_cpu_wait"],
    ["core.cpu.fence", Kind.CPU_FENCE, 0, "none", [], "rt_cpu_fence"],
    ["core.cpu.firmware", Kind.CPU_FIRMWARE, 1, "number", ["number"], "rt_cpu_firmware"],
    ["core.cpu.call", Kind.CPU_CALL, 2, "number", ["number"], "rt_cpu_call"],
    ["io.file.read", Kind.FILE_READ, 1, "string", ["string"], "rt_platform_file_read"],
    ["io.file.write", Kind.FILE_WRITE, 2, "none", ["string"], "rt_platform_file_write"],
    ["io.file.write_raw_bytes", Kind.FILE_WRITE_BYTES, 2, "none", ["string", "unknown"], "rt_file_write_bytes"],
    ["core.str.line_count", Kind.STR_LINE_COUNT, 1, "number", ["string"], "rt_line_count"],
    ["core.str.concat", Kind.STR_ADD, 2, "string", ["string"], "rt_string_add"],
    ["core.str.bytes", Kind.STR_LEN, 1, "number", ["string"], "rt_string_len"],
    ["core.str.get", Kind.STR_GET, 2, "string", ["string", "number"], "rt_string_at"],
    ["core.str.byte", Kind.STR_BYTE, 2, "number", ["string", "number"], "rt_string_byte"],
    ["core.str.from_byte", Kind.STR_FROM_BYTE, 1, "string", ["number"], "rt_string_from_byte"],
    ["core.str.slice", Kind.STR_SLICE, 3, "string", ["string", "number"], "rt_string_slice"],
    ["core.str.contains", Kind.STR_CONTAINS, 2, "answer", ["string"], "rt_string_contains"],
    ["core.str.starts_with", Kind.STR_STARTS_WITH, 2, "answer", ["string"], "rt_string_starts_with"],
    ["core.str.ends_with", Kind.STR_ENDS_WITH, 2, "answer", ["string"], "rt_string_ends_with"],
    ["core.str.lower", Kind.STR_LOWER, 1, "string", ["string"], "rt_string_lower"],
    ["core.str.upper", Kind.STR_UPPER, 1, "string", ["string"], "rt_string_upper"],
    ["core.num.text", Kind.NUM_TEXT, 1, "string", ["number"], "rt_number_text"],
    ["io.show", Kind.IO_SHOW, 1, "none", ["string"], ""],
    ["io.read_line", Kind.IO_READ_LINE, 0, "string", [], "rt_platform_read_line"],
    ["io.key", Kind.IO_KEY, 0, "string", [], "rt_io_key"],
    ["io.clear", Kind.IO_CLEAR, 0, "none", [], "rt_io_clear"],
    ["core.u8.from", Kind.U8_FROM, 1, "u8", [], ""],
    ["core.u16.from", Kind.U16_FROM, 1, "u16", [], ""],
    ["core.u32.from", Kind.U32_FROM, 1, "u32", [], ""],
    ["core.i32.from", Kind.I32_FROM, 1, "i32", [], ""],
    ["core.usize.from", Kind.USIZE_FROM, 1, "usize", [], ""],
    ["core.bits32.from", Kind.BITS32_FROM, 1, "bits32", [], ""],
    ["core.address.from", Kind.ADDRESS_FROM, 1, "address", [], ""],
    ["core.num.from", Kind.NUM_FROM, 1, "number", [], ""],
    ["core.bits32.and", Kind.BITS32_AND, 2, "bits32", [], ""],
    ["core.bits32.or", Kind.BITS32_OR, 2, "bits32", [], ""],
    ["core.bits32.xor", Kind.BITS32_XOR, 2, "bits32", [], ""],
    ["core.bits32.not", Kind.BITS32_NOT, 1, "bits32", [], ""],
    ["core.bits32.shift_left", Kind.BITS32_SHIFT_LEFT, 2, "bits32", [], ""],
    ["core.bits32.shift_right", Kind.BITS32_SHIFT_RIGHT, 2, "bits32", [], ""],
    ["core.address.add", Kind.ADDRESS_ADD, 2, "address", [], ""]
]

NAME = 0
KIND = 1
COUNT = 2
RESULT = 3
ARGUMENTS = 4
TARGET = 5

skill row(kind) {
    drum (TABLE) {
        (group.get(beat, KIND) == kind) { out beat }
    }
    out []
}

skill find(name) {
    drum (TABLE) {
        (group.get(beat, NAME) == name) { out group.get(beat, KIND) }
    }
    out Kind.UNKNOWN
}

skill exact_argument_count(kind) {
    @found = row(kind)
    (group.count(found) == 0) { out -1 }
    out group.get(found, COUNT)
}

skill minimum_arguments(kind) {
    out exact_argument_count(kind)
}

skill maximum_arguments(kind) {
    out exact_argument_count(kind)
}

skill result(kind) {
    @found = row(kind)
    (group.count(found) == 0) { out "unknown" }
    out group.get(found, RESULT)
}

skill argument_type(kind, index) {
    @found = row(kind)
    (group.count(found) == 0) { out "unknown" }
    @types = group.get(found, ARGUMENTS)
    @count = group.count(types)
    (count == 0) { out "unknown" }
    (index < count) { out group.get(types, index) }
    out group.get(types, count - 1)
}

skill target(kind) {
    @found = row(kind)
    (group.count(found) == 0) { out "" }
    out group.get(found, TARGET)
}
