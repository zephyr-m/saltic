-- loops — обход циклов: drum (beat и метка для leave), always (метка
-- внешних имён), leave вне цикла — ошибка.

use core.str
use core.group
use selfhost.ast
use selfhost.errors
use selfhost.intrinsic.contract
use selfhost.checker.names
use selfhost.checker.names.paths
use selfhost.checker.notes
use selfhost.checker.rules.cycles
use selfhost.checker.rules
use selfhost.checker.rules.numbers
use selfhost.checker.types
use selfhost.checker.types.shapes
use selfhost.checker.types.signatures
use selfhost.checker.walk

DRUM_MARKER = "$drum"

Loops = Box {
    register = Names {},
    routes = Paths {},
    journal = Notes {},
    forms = Shapes {},
    typing = Types {},
    signing = Signatures {},
    arithmetic = Numbers {},
    law = Rules {},
    knots = Cycles {}

    skill walk_node(tag, node, plain, scope, globals, diagnostics) {
        (tag == "leave") {
            out walk_leave(node, plain, scope, globals, diagnostics)
        }
        (tag == "always") {
            out walk_always(node, plain, scope, globals, diagnostics)
        }
        (tag == "drum") {
            out walk_drum(node, plain, scope, globals, diagnostics)
        }
        out none
    }

    skill walk_leave(node, plain, scope, globals, diagnostics) {
        (register.has_name(scope.names, DRUM_MARKER) == no) {
            out journal.walked(node, journal.add_diagnostic(diagnostics, journal.placed(node, errors.leave_outside_drum())))
        }
        out journal.walked(node, diagnostics)
    }

    skill walk_always(node, plain, scope, globals, diagnostics) {
        @walker = walking()
        @always_scope = Names.Scope {
            names = scope.names,
            subject = scope.subject,
            module = scope.module
        }
        always_scope.names = register.put_name(always_scope.names, DRUM_MARKER, "variable", "unknown")
        always_scope.names = register.put_name(always_scope.names, rules.ALWAYS_MARKER, "variable", "unknown")
        @always_walked = walker.check_block(group.get(plain, 1), always_scope, globals, diagnostics)
        out journal.walked(ast.with_part(node, 1, always_walked.node), always_walked.diagnostics)
    }

    skill walk_drum(node, plain, scope, globals, diagnostics) {
        @walker = walking()
        @count_node = group.get(plain, 1)
        @count_walked = walker.check_expression(count_node, scope, globals, diagnostics)
        diagnostics = count_walked.diagnostics
        @count_type = typing.value_type(count_node, scope, globals)
        @drum_problem = law.drum_count(count_type)
        (errors.is_ok(drum_problem) == no) { diagnostics = journal.add_diagnostic(diagnostics, journal.placed(count_node, drum_problem)) }
        @drum_scope = Names.Scope {
            names = scope.names,
            subject = scope.subject,
            module = scope.module
        }
        drum_scope.names = register.put_name(drum_scope.names, ast.DRUM_BEAT, "variable", "unknown")
        drum_scope.names = register.put_name(drum_scope.names, DRUM_MARKER, "variable", "unknown")
        @body_walked = walker.check_block(group.get(plain, 2), drum_scope, globals, diagnostics)
        out journal.walked(ast.with_part(ast.with_part(node, 1, count_walked.node), 2, body_walked.node), body_walked.diagnostics)
    }

    skill walking() {
        out Walk {
            register = register,
            routes = routes,
            journal = journal,
            forms = forms,
            typing = typing,
            signing = signing,
            arithmetic = arithmetic,
            law = law,
            knots = knots
        }
    }
}
