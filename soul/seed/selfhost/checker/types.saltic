-- types — вывод типа выражения для чекера.
-- Тип — текст: "number", "string", "answer", "none", "error", "group:<тип>",
-- "box:<полное имя>", "enum:<полное имя>", фиксированные "u8"…, иначе
-- "unknown". unknown совместим со всем; merge сливает типы веток.
--
-- tail(text, start) -> хвост текста
-- group_type(type) -> "group:тип"; is_group_type(type); group_item_type(type)
-- box_type(name) -> "box:имя"; is_box_type(type); box_name(type) -> имя или "";
--     is_enum_type(type); enum_name(type) -> имя или "" — единственное место префиксов
-- merge(left, right) -> общий тип или "unknown"
-- compatible(left, right) -> answer
-- type_text(type) -> текст для сообщений («Box Имя», «группа число»)
-- integer_text(node) -> десятичный текст целого литерала (с «-») или ""
-- type(node) -> тип литерала без области; type_in_module(node, module, globals) — с полным
--     именем Box; resolve_type(type, module, globals) — то же для готового типа, и в группах
-- box_field(globals, box_name, field_name) -> names.Name поля или пустой;
--     box_member(box_node, field_name) -> узел поля или [] — общий с кодогеном обход
-- path_type(node, scope, globals) -> тип пути (переменная, поле, enum, глобал)
-- call_type(node, scope, globals) -> тип результата вызова (Box, intrinsic по contract)
-- block_value_type(block, scope, globals) -> тип последнего выражения блока
-- value_type(node, scope, globals) -> тип любого выражения

use core.str
use core.group
use core.num
use selfhost.ast
use selfhost.intrinsic.contract
use selfhost.checker.names

skill tail(text, start) {
    out str.slice(text, start, str.bytes(text))
}

skill group_type(type) {
    out "group:{type}"
}

skill is_group_type(type) {
    out str.starts_with(type, "group:")
}

skill group_item_type(type) {
    (is_group_type(type) == yes) { out tail(type, 6) }
    out "unknown"
}

skill box_type(name) {
    out "box:{name}"
}

skill is_box_type(type) {
    out str.starts_with(type, "box:")
}

skill box_name(type) {
    (is_box_type(type) == yes) { out tail(type, 4) }
    out ""
}

skill is_enum_type(type) {
    out str.starts_with(type, "enum:")
}

skill enum_name(type) {
    (is_enum_type(type) == yes) { out tail(type, 5) }
    out ""
}

skill merge(left, right) {
    (left == "unknown") { out right }
    (right == "unknown") { out left }
    (left == right) { out left }
    (is_group_type(left) == yes) {
        (is_group_type(right) == yes) { out group_type(merge(group_item_type(left), group_item_type(right))) }
    }
    out "unknown"
}

skill compatible(left, right) {
    (left == "unknown") { out yes }
    (right == "unknown") { out yes }
    (left == right) { out yes }
    (is_group_type(left) == yes) {
        (is_group_type(right) == yes) { out compatible(group_item_type(left), group_item_type(right)) }
    }
    out no
}

skill type_text(type) {
    (type == "answer") { out "yes/no" }
    (is_box_type(type) == yes) { out str.concat("Box ", box_name(type)) }
    (is_enum_type(type) == yes) { out str.concat("enum ", enum_name(type)) }
    (is_group_type(type) == yes) { out str.concat("группа ", type_text(group_item_type(type))) }
    out type
}

skill integer_text(node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "number") { out num.text(group.get(plain, 1)) }
    (tag == "wide-number") { out group.get(plain, 1) }
    (tag == "binary") {
        (group.get(plain, 1) == "-") {
            @left = ast.plain(group.get(plain, 2))
            (group.get(left, 0) == "number") {
                (group.get(left, 1) == 0) {
                    @right = ast.tag(ast.plain(group.get(plain, 3)))
                    (right == "number") { out str.concat("-", integer_text(group.get(plain, 3))) }
                    (right == "wide-number") { out str.concat("-", integer_text(group.get(plain, 3))) }
                }
            }
        }
    }
    out ""
}

skill type_in_module(node, module, globals) {
    out resolve_type(type(node), module, globals)
}

skill resolve_type(type, module, globals) {
    (is_group_type(type) == yes) { out group_type(resolve_type(group_item_type(type), module, globals)) }
    (is_box_type(type) == yes) {
        @name = box_name(type)
        @resolved = names.resolve_name(name, module, globals)
        (str.bytes(resolved) > 0) { out box_type(resolved) }
    }
    out type
}


skill type(node) {
    @tag = ast.tag(node)
    (tag == "number") { out "number" }
    (tag == "wide-number") { out "number" }
    (tag == "fraction-number") { out "number" }
    (tag == "string") { out "string" }
    (tag == "template") { out "string" }
    (tag == "answer") { out "answer" }
    (tag == "none") { out "none" }
    (tag == "group") {
        @type = "unknown"
        @plain = ast.plain(node)
        drum (group.count(plain) - 1) {
            type = merge(type, type(group.get(plain, beat + 1)))
        }
        out group_type(type)
    }
    (tag == "box-new") { out box_type(ast.part(node, 1)) }
    out "unknown"
}

skill box_member(box_node, field_name) {
    @count = group.count(ast.plain(box_node))
    (count < 2) { out [] }
    drum (count - 2) {
        @member = ast.part(box_node, count - 1 - beat)
        (ast.tag(member) == "field") {
            (ast.part(member, 1) == field_name) { out member }
        }
    }
    out []
}

skill box_field(globals, box_name, field_name) {
    @box = names.table_find(globals, box_name)
    @member = box_member(box.node, field_name)
    (group.count(member) == 0) { out names.Name {} }
    out names.Name { name = field_name, kind = "field", type = type_in_module(ast.part(member, 2), ast.name_module(box_name), globals), node = member }
}

skill path_type(node, scope, globals) {
    @parts = ast.plain(node)
    @count = group.count(parts)
    @name = group.get(parts, 1)
    @resolved = names.resolve_path(node, scope, globals)
    (str.bytes(resolved) > 0) {
        @resolved_name = names.table_find(globals, resolved)
        out resolved_name.type
    }
    (count > 2) {
        @resolved_enum = names.resolve_name(ast.path_prefix(node), scope.module, globals)
        @enum_symbol = names.table_find(globals, resolved_enum)
        (enum_symbol.kind == "enum") { out "enum:{resolved_enum}" }
    }
    (count == 2) {
        @local = names.find(scope.names, name)
        (str.bytes(local.name) > 0) { out local.type }
        @global = names.find_visible(globals, scope.module, name)
        (str.bytes(global.name) > 0) { out global.type }
        (name == "error") { out "error" }
        out "unknown"
    }
    (name == "error") { out "error" }
    @enum_model = names.find_visible(globals, scope.module, name)
    (enum_model.kind == "enum") {
        (count == 3) { out "enum:{name}" }
    }
    @local_value = names.find(scope.names, name)
    @type = local_value.type
    (type == "unknown") {
        @global_value = names.find_visible(globals, scope.module, name)
        type = global_value.type
    }
    drum (count - 2) {
        pick {
            (is_box_type(type) == yes) {
                @field = box_field(globals, box_name(type), group.get(parts, beat + 2))
                type = field.type
            }
            { type = "unknown" }
        }
    }
    out type
}

skill call_type(node, scope, globals) {
    @plain = ast.plain(node)
    @callee = ast.plain(group.get(plain, 1))
    (group.get(callee, 0) == "path") {
        @name = group.get(callee, 1)
        @part_count = group.count(callee)
        (part_count == 2) {
            @box_name = names.resolve_name(name, scope.module, globals)
            @global = names.table_find(globals, box_name)
            (global.kind == "box") { out "box:{box_name}" }
        }
        @full = names.call_name(callee, scope, globals)
        @input_type = "unknown"
        (group.count(plain) > 2) { input_type = value_type(group.get(plain, 2), scope, globals) }
        @kind = contract.find(full)
        @result_type = contract.result(kind, input_type)
        (result_type == "group-item") { out group_item_type(input_type) }
        (result_type == "group-add") {
            @item_type = "unknown"
            (group.count(plain) > 3) { item_type = value_type(group.get(plain, 3), scope, globals) }
            out group_type(merge(group_item_type(input_type), item_type))
        }
        ((result_type == "unknown") == no) { out result_type }
    }
    out "unknown"
}

skill block_value_type(block, scope, globals) {
    @plain = ast.plain(block)
    @count = group.count(plain)
    (count == 1) { out "none" }
    @last = ast.plain(group.get(plain, count - 1))
    @tag = group.get(last, 0)
    (tag == "expr") { out value_type(group.get(last, 1), scope, globals) }
    (tag == "out") { out "unknown" }
    (tag == "leave") { out "unknown" }
    out "none"
}

skill value_type(node, scope, globals) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "number") { out "number" }
    (tag == "wide-number") { out "number" }
    (tag == "fraction-number") { out "number" }
    (tag == "string") { out "string" }
    (tag == "template") { out "string" }
    (tag == "answer") { out "answer" }
    (tag == "none") { out "none" }
    (tag == "enum-value") {
        @variant = names.table_find(globals, names.variant_key(group.get(plain, 1)))
        out variant.type
    }
    (tag == "path") { out path_type(node, scope, globals) }
    (tag == "box-new") {
        @box_name = names.resolve_name(group.get(plain, 1), scope.module, globals)
        out "box:{box_name}"
    }
    (tag == "call") { out call_type(node, scope, globals) }
    (tag == "group") {
        @type = "unknown"
        drum (group.count(plain) - 1) {
            type = merge(type, value_type(group.get(plain, beat + 1), scope, globals))
        }
        out group_type(type)
    }
    (tag == "binary") {
        @operator = group.get(plain, 1)
        (operator == "==") { out "answer" }
        (operator == ">") { out "answer" }
        (operator == "<") { out "answer" }
        (operator == ">=") { out "answer" }
        (operator == "<=") { out "answer" }
        @left_type = value_type(group.get(plain, 2), scope, globals)
        (contract.is_fixed_type(left_type) == yes) { out left_type }
        out "number"
    }
    (tag == "rescue") {
        @left = value_type(group.get(plain, 1), scope, globals)
        @child = names.Scope { names = scope.names, subject = scope.subject, module = scope.module }
        child.names = names.put(child.names, group.get(plain, 2), "variable", "error")
        out merge(left, block_value_type(group.get(plain, 3), child, globals))
    }
    out "unknown"
}
