-- walk — обход тел навыков: проверяет выражения и операторы, разрешает
-- пути до полных имён и помечает узлы типами (ast.typed).
-- Каждый навык берёт узел, область (names.Scope), таблицу глобалов и
-- накопленные диагностики и отдаёт lookup.Walked { node, diagnostics }.
-- Область копируется на входе в блок: имена из ветки наружу не выходят;
-- внутри drum в области лежат beat и метка $drum (для leave); always кладёт
-- ещё метку $always: имена до неё — внешние, им в always нельзя присвоить
-- строку, группу или Box (память оборота убирается).
--
-- check_expression(node, scope, globals, diagnostics) -> Walked
-- check_statement(node, scope, globals, diagnostics) -> Walked
-- check_block(block, scope, globals, diagnostics) -> Walked
-- check_params(owner, params, globals, subject, module, body, diagnostics) -> Walked;
--     owner — узел объявления (место ошибок параметров), subject — полное
--     имя Box для метода, его поля попадают в область

use core.str
use core.group
use selfhost.ast
use selfhost.errors
use selfhost.intrinsic.contract
use selfhost.checker.names
use selfhost.checker.types
use selfhost.checker.signatures
use selfhost.checker.rules
use selfhost.checker.lookup

DRUM_MARKER = "$drum"


skill check_expression(node, scope, globals, diagnostics) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "fraction-number") {
        out lookup.walked(node, lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.fraction_not_supported())))
    }
    (tag == "wide-number") {
        out lookup.walked(node, lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.number_out_of_range())))
    }
    (tag == "template") {
        @current = node
        drum ((group.count(plain) - 2) / 2) {
            @placeholder = group.get(plain, beat * 2 + 2)
            @inner = check_expression(placeholder, scope, globals, diagnostics)
            diagnostics = inner.diagnostics
            current = ast.with_part(current, beat * 2 + 2, inner.node)
            @type = types.value_type(placeholder, scope, globals)
            @allowed = no
            (type == "string") { allowed = yes }
            (type == "number") { allowed = yes }
            (type == "answer") { allowed = yes }
            (type == "error") { allowed = yes }
            (type == "unknown") { allowed = yes }
            (allowed == no) {
                diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(placeholder, errors.template_type(ast.path_text(placeholder), types.type_text(type))))
            }
        }
        out lookup.walked(current, diagnostics)
    }
    (tag == "enum-value") {
        @variant = names.table_find(globals, names.variant_key(group.get(plain, 1)))
        (str.bytes(variant.name) == 0) {
            out lookup.walked(node, lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.unknown_enum_variant(group.get(plain, 1)))))
        }
        out lookup.walked(node, diagnostics)
    }
    (tag == "path") { out lookup.check_path(node, scope, globals, diagnostics) }
    (tag == "binary") {
        @left_node = group.get(plain, 2)
        @right_node = group.get(plain, 3)
        @left_walked = check_expression(left_node, scope, globals, diagnostics)
        @right_walked = check_expression(right_node, scope, globals, left_walked.diagnostics)
        diagnostics = right_walked.diagnostics
        @left_type = types.value_type(left_node, scope, globals)
        @current = ast.with_part(ast.with_part(node, 2, ast.typed(left_type, left_walked.node)), 3, right_walked.node)
        @operator = group.get(plain, 1)
        @numeric = no
        (operator == "+") { numeric = yes }
        (operator == "-") { numeric = yes }
        (operator == "*") { numeric = yes }
        (operator == "/") { numeric = yes }
        (operator == ">") { numeric = yes }
        (operator == "<") { numeric = yes }
        (operator == ">=") { numeric = yes }
        (operator == "<=") { numeric = yes }
        (numeric == yes) {
            @right_type = types.value_type(right_node, scope, globals)
            @known_types = yes
            (left_type == "unknown") { known_types = no }
            (right_type == "unknown") { known_types = no }
            (known_types == yes) {
                @both_numbers = no
                (left_type == "number") {
                    (right_type == "number") { both_numbers = yes }
                }
                @fixed = no
                (contract.is_fixed_type(left_type) == yes) { fixed = yes }
                (contract.is_fixed_type(right_type) == yes) { fixed = yes }
                (fixed == yes) {
                    both_numbers = yes
                    @problem = errors.ok()
                    (left_type == "address") { problem = errors.address_arithmetic() }
                    (right_type == "address") { problem = errors.address_arithmetic() }
                    (left_type == "bits32") { problem = errors.bits32_operator(operator) }
                    (right_type == "bits32") { problem = errors.bits32_operator(operator) }
                    (errors.is_ok(problem) == yes) {
                        (left_type == "number") { problem = errors.operator_mixes_number(operator, right_type) }
                        (right_type == "number") { problem = errors.operator_mixes_number(operator, left_type) }
                        (errors.is_ok(problem) == yes) {
                            ((left_type == right_type) == no) { problem = errors.operator_mixes_fixed(operator, left_type, right_type) }
                        }
                    }
                    (errors.is_ok(problem) == no) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, problem)) }
                }
                (both_numbers == no) {
                    @left_name = types.type_text(left_type)
                    @right_name = types.type_text(right_type)
                    diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.operator_expects_numbers(operator, left_name, right_name)))
                }
            }
        }
        out lookup.walked(current, diagnostics)
    }
    (tag == "call") {
        @callee = ast.plain(ast.call_callee(node))
        (group.get(callee, 0) == "path") {
            @part_count = group.count(callee)
            (part_count > 3) {
                (names.has(scope.names, group.get(callee, 1)) == no) {
                    out lookup.walked(node, lookup.add_diagnostic(diagnostics, lookup.placed(node, lookup.long_call(callee))))
                }
            }
        }
        @full = names.call_name(callee, scope, globals)
        @made = contract.conversion(contract.find(full))
        @fixed_call = str.bytes(made) > 0
        @skip_callee = no
        (group.get(callee, 0) == "path") {
            @callee_count = group.count(callee)
            (callee_count == 2) {
                (str.bytes(scope.subject) > 0) {
                    (lookup.box_has_skill(globals, scope.subject, group.get(callee, 1)) == yes) { skip_callee = yes }
                }
            }
            (callee_count == 3) {
                @receiver_path = ["path", group.get(callee, 1)]
                @receiver_type = types.path_type(receiver_path, scope, globals)
                (str.starts_with(receiver_type, "box:") == yes) {
                    (lookup.box_has_skill(globals, types.tail(receiver_type, 4), group.get(callee, 2)) == yes) { skip_callee = yes }
                }
            }
        }
        @current = node
        (skip_callee == no) {
            @callee_walked = check_expression(ast.call_callee(node), scope, globals, diagnostics)
            diagnostics = callee_walked.diagnostics
            current = ast.with_part(current, 1, callee_walked.node)
            (group.count(callee) == 2) {
                @skill_name = names.resolve_name(group.get(callee, 1), scope.module, globals)
                (str.bytes(skill_name) > 0) { current = ast.with_part(current, 1, ast.rebuild(ast.call_callee(node), names.path_from_text(skill_name))) }
            }
        }
        @argument_count = ast.call_argument_count(node)
        drum (argument_count) {
            @argument = ast.call_argument(node, beat)
            @skip_argument = no
            (fixed_call == yes) {
                (beat == 0) {
                    (rules.is_integer_literal(argument) == yes) { skip_argument = yes }
                    (rules.is_fraction(argument) == yes) { skip_argument = yes }
                }
            }
            (skip_argument == no) {
                @argument_walked = check_expression(argument, scope, globals, diagnostics)
                diagnostics = argument_walked.diagnostics
                @argument_node = argument_walked.node
                @mark_type = contract.is_known(full)
                (fixed_call == yes) { mark_type = yes }
                (mark_type == yes) { argument_node = ast.typed(types.value_type(argument, scope, globals), argument_node) }
                current = ast.with_part(current, beat + 2, argument_node)
            }
        }
        (fixed_call == no) {
            @callee_global = names.table_find(globals, full)
            @keeps_fixed = callee_global.kind == "native"
            (str.starts_with(full, "core.group.") == yes) { keeps_fixed = no }
            (keeps_fixed == no) {
                drum (argument_count) {
                    diagnostics = lookup.check_fixed_escape(node, ast.call_argument(node, beat), "передать в '{full}'", scope, globals, diagnostics)
                }
            }
        }
        @receiver_type = "unknown"
        (group.count(callee) == 3) {
            @receiver_path = ["path", group.get(callee, 1)]
            receiver_type = types.path_type(receiver_path, scope, globals)
        }
        @signature = signatures.resolve(callee, scope, globals, receiver_type)
        @arity = rules.arity(signature, argument_count)
        (errors.is_ok(arity) == no) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, arity)) }
        (fixed_call == yes) {
            (argument_count > 0) {
                @fixed_argument = ast.call_argument(node, 0)
                @text = types.integer_text(fixed_argument)
                (str.bytes(text) > 0) {
                    (contract.fixed_in_range(made, text) == no) {
                        @range = contract.fixed_range_text(made)
                        diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.fixed_integer_out_of_range(text, made, range)))
                    }
                }
                @actual_type = types.value_type(fixed_argument, scope, globals)
                @fixed_problem = rules.fixed_argument(fixed_argument, actual_type)
                (errors.is_ok(fixed_problem) == no) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, fixed_problem)) }
            }
        }
        @seed_kind = contract.find(full)
        drum (argument_count) {
            @expected_argument = contract.argument_type(seed_kind, beat)
            ((expected_argument == "unknown") == no) {
                @actual_argument = types.value_type(ast.call_argument(node, beat), scope, globals)
                @argument_problem = rules.argument(full, beat, expected_argument, actual_argument)
                (errors.is_ok(argument_problem) == no) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, argument_problem)) }
            }
        }
        @address_type = "unknown"
        (group.count(plain) > 2) { address_type = types.value_type(group.get(plain, 2), scope, globals) }
        @expected = contract.store_type(seed_kind, address_type)
        (str.bytes(expected) > 0) {
            (address_type == "address") {
                (group.count(plain) > 4) {
                @actual = types.value_type(group.get(plain, 4), scope, globals)
                (actual == expected) { expected = "" }
                (str.bytes(expected) > 0) {
                    diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.store_type_mismatch(full, expected, actual)))
                }
                }
            }
        }
        @checked_argument = contract.checked_argument(seed_kind)
        (checked_argument >= 0) {
            @expected_type = contract.checked_type(seed_kind)
            @argument_index = checked_argument + 2
            (argument_index < group.count(plain)) {
                @actual = types.value_type(group.get(plain, argument_index), scope, globals)
                (actual == expected_type) { expected_type = "" }
                (str.bytes(expected_type) > 0) {
                    @expected_text = expected_type
                    (expected_type == "u8") { expected_text = "сдвиг {expected_type}" }
                    diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.fixed_argument_type_mismatch(full, expected_text, actual)))
                }
            }
        }
        out lookup.walked(current, diagnostics)
    }
    (tag == "group") {
        @current = node
        drum (group.count(plain) - 1) {
            diagnostics = lookup.check_fixed_escape(node, group.get(plain, beat + 1), "положить в группу", scope, globals, diagnostics)
            @item_walked = check_expression(group.get(plain, beat + 1), scope, globals, diagnostics)
            diagnostics = item_walked.diagnostics
            current = ast.with_part(current, beat + 1, item_walked.node)
        }
        out lookup.walked(current, diagnostics)
    }
    (tag == "box-new") {
        @name = group.get(plain, 1)
        @long_box = names.long_reference(names.path_from_text(name), scope, globals)
        (errors.is_ok(long_box) == no) { out lookup.walked(node, lookup.add_diagnostic(diagnostics, lookup.placed(node, long_box))) }
        @resolved_box = names.resolve_name(name, scope.module, globals)
        @model = names.table_find(globals, resolved_box)
        (model.kind == "box") {
            @current = ast.with_part(node, 1, resolved_box)
            @seen = []
            drum (group.count(plain) - 2) {
                @override = group.get(plain, beat + 2)
                @field_name = ast.part(override, 1)
                @value = ast.part(override, 2)
                @value_walked = check_expression(value, scope, globals, diagnostics)
                diagnostics = value_walked.diagnostics
                current = ast.with_part(current, beat + 2, ast.with_part(override, 2, value_walked.node))
                (names.has(seen, field_name) == yes) {
                    diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.duplicate_literal_field(field_name, name)))
                }
                seen = names.put(seen, field_name, "field", "unknown")
                @field = types.box_field(globals, resolved_box, field_name)
                pick {
                    (str.bytes(field.name) == 0) {
                        diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.unknown_field(name, field_name)))
                    }
                    {
                        @value_type = types.value_type(value, scope, globals)
                        (types.compatible(field.type, value_type) == no) {
                            @value_name = types.type_text(value_type)
                            @field_type = types.type_text(field.type)
                            diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.field_type_mismatch(value_name, field_name, name, field_type)))
                        }
                    }
                }
            }
            out lookup.walked(current, diagnostics)
        }
        diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.unknown_box(name)))
        out lookup.walked(node, diagnostics)
    }
    (tag == "rescue") {
        @value_walked = check_expression(group.get(plain, 1), scope, globals, diagnostics)
        diagnostics = value_walked.diagnostics
        @child = names.Scope { names = scope.names, subject = scope.subject, module = scope.module }
        diagnostics = lookup.check_module_name(node, group.get(plain, 2), scope.module, globals, diagnostics)
        child.names = names.put(child.names, group.get(plain, 2), "variable", "error")
        @block_walked = check_block(group.get(plain, 3), child, globals, diagnostics)
        out lookup.walked(ast.with_part(ast.with_part(node, 1, value_walked.node), 3, block_walked.node), block_walked.diagnostics)
    }
    out lookup.walked(node, diagnostics)
}

skill check_statement(node, scope, globals, diagnostics) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "var") {
        @name = group.get(plain, 1)
        @value = group.get(plain, 2)
        @value_walked = check_expression(value, scope, globals, diagnostics)
        diagnostics = value_walked.diagnostics
        @value_type = types.value_type(value, scope, globals)
        @current = ast.with_part(node, 2, ast.typed(value_type, value_walked.node))
        (names.has(scope.names, name) == yes) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.duplicate_variable(name))) }
        (names.has(scope.names, name) == no) {
            (names.visible(globals, scope.module, name) == yes) {
                diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.variable_shadows_global(name)))
            }
            (names.visible(globals, scope.module, name) == no) {
                diagnostics = lookup.check_module_name(node, name, scope.module, globals, diagnostics)
                scope.names = names.put(scope.names, name, "variable", value_type)
            }
        }
        out lookup.walked(current, diagnostics)
    }
    (tag == "assign") {
        @name = group.get(plain, 1)
        @value = group.get(plain, 2)
        @value_walked = check_expression(value, scope, globals, diagnostics)
        diagnostics = value_walked.diagnostics
        @value_type = types.value_type(value, scope, globals)
        @current = ast.with_part(node, 2, ast.typed(value_type, value_walked.node))
        (names.has(scope.names, name) == yes) {
            @old = names.find(scope.names, name)
            (types.compatible(old.type, value_type) == yes) { scope.names = names.update(scope.names, name, types.merge(old.type, value_type)) }
            (types.compatible(old.type, value_type) == no) {
                @value_name = types.type_text(value_type)
                @old_name = types.type_text(old.type)
                diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.variable_type_mismatch(value_name, name, old_name)))
            }
            @always_problem = rules.always_assign(scope.names, name, value_type)
            (errors.is_ok(always_problem) == no) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, always_problem)) }
        }
        (names.has(scope.names, name) == no) {
            @global = names.find_visible(globals, scope.module, name)
            @is_constant = no
            (global.kind == "const") { is_constant = yes }
            (global.kind == "const") { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.constant_assignment(name))) }
            (str.bytes(global.name) > 0) {
                (is_constant == no) {
                    diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.assign_to_global(name)))
                }
            }
            (str.bytes(global.name) == 0) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.variable_not_declared(name))) }
        }
        out lookup.walked(current, diagnostics)
    }
    (tag == "field-assign") {
        @target = ast.plain(group.get(plain, 1))
        @part_count = group.count(target)
        @base_parts = ["path"]
        drum (part_count - 2) {
            base_parts = group.add(base_parts, group.get(target, beat + 1))
        }
        diagnostics = lookup.issues(lookup.check_path(ast.rebuild(group.get(plain, 1), base_parts), scope, globals, diagnostics))
        @value = group.get(plain, 2)
        @value_walked = check_expression(value, scope, globals, diagnostics)
        diagnostics = value_walked.diagnostics
        @current = ast.with_part(node, 2, value_walked.node)
        @base_type = types.path_type(base_parts, scope, globals)
        (str.starts_with(base_type, "box:") == yes) {
            @box_name = types.tail(base_type, 4)
            @field_name = group.get(target, part_count - 1)
            @field = types.box_field(globals, box_name, field_name)
            (str.bytes(field.name) == 0) {
                diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.unknown_field(box_name, field_name)))
            }
            (str.bytes(field.name) > 0) {
                @value_type = types.value_type(value, scope, globals)
                (types.compatible(field.type, value_type) == no) {
                    @value_name = types.type_text(value_type)
                    diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.field_assign_type_mismatch(value_name, field_name, box_name)))
                }
            }
        }
        out lookup.walked(current, diagnostics)
    }
    (tag == "out") {
        diagnostics = lookup.check_fixed_escape(node, group.get(plain, 1), "вернуть из навыка", scope, globals, diagnostics)
        @value_walked = check_expression(group.get(plain, 1), scope, globals, diagnostics)
        @out_type = types.value_type(group.get(plain, 1), scope, globals)
        out lookup.walked(ast.with_part(node, 1, ast.typed(out_type, value_walked.node)), value_walked.diagnostics)
    }
    (tag == "pick") {
        @count = group.count(plain)
        @current = node
        drum (count - 1) {
            @choice = group.get(plain, beat + 1)
            @choice_plain = ast.plain(choice)
            @choice_tag = group.get(choice_plain, 0)
            @child = names.Scope { names = scope.names, subject = scope.subject, module = scope.module }
            (choice_tag == "if") {
                @condition_walked = check_expression(group.get(choice_plain, 1), scope, globals, diagnostics)
                @branch_walked = check_block(group.get(choice_plain, 2), child, globals, condition_walked.diagnostics)
                diagnostics = branch_walked.diagnostics
                current = ast.with_part(current, beat + 1, ast.with_part(ast.with_part(choice, 1, condition_walked.node), 2, branch_walked.node))
            }
            (choice_tag == "switch") { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(choice, errors.pick_branch_not_condition())) }
            (choice_tag == "otherwise") {
                (beat + 2 < count) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(choice, errors.pick_default_not_last())) }
                @otherwise_walked = check_block(group.get(choice_plain, 1), child, globals, diagnostics)
                diagnostics = otherwise_walked.diagnostics
                current = ast.with_part(current, beat + 1, ast.with_part(choice, 1, otherwise_walked.node))
            }
        }
        out lookup.walked(current, diagnostics)
    }
    (tag == "leave") {
        (names.has(scope.names, DRUM_MARKER) == no) { out lookup.walked(node, lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.leave_outside_drum()))) }
        out lookup.walked(node, diagnostics)
    }
    (tag == "expr") {
        @value_walked = check_expression(group.get(plain, 1), scope, globals, diagnostics)
        out lookup.walked(ast.with_part(node, 1, value_walked.node), value_walked.diagnostics)
    }
    (tag == "if") {
        @condition_walked = check_expression(group.get(plain, 1), scope, globals, diagnostics)
        @branch_walked = check_block(group.get(plain, 2), names.Scope { names = scope.names, subject = scope.subject, module = scope.module }, globals, condition_walked.diagnostics)
        out lookup.walked(ast.with_part(ast.with_part(node, 1, condition_walked.node), 2, branch_walked.node), branch_walked.diagnostics)
    }
    (tag == "always") {
        @always_scope = names.Scope { names = scope.names, subject = scope.subject, module = scope.module }
        always_scope.names = names.put(always_scope.names, DRUM_MARKER, "variable", "unknown")
        always_scope.names = names.put(always_scope.names, rules.ALWAYS_MARKER, "variable", "unknown")
        @always_walked = check_block(group.get(plain, 1), always_scope, globals, diagnostics)
        out lookup.walked(ast.with_part(node, 1, always_walked.node), always_walked.diagnostics)
    }
    (tag == "drum") {
        @count_node = group.get(plain, 1)
        @count_walked = check_expression(count_node, scope, globals, diagnostics)
        diagnostics = count_walked.diagnostics
        @count_type = types.value_type(count_node, scope, globals)
        @drum_problem = rules.drum_count(count_type)
        (errors.is_ok(drum_problem) == no) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(count_node, drum_problem)) }
        @drum_scope = names.Scope { names = scope.names, subject = scope.subject, module = scope.module }
        drum_scope.names = names.put(drum_scope.names, ast.DRUM_BEAT, "variable", "unknown")
        drum_scope.names = names.put(drum_scope.names, DRUM_MARKER, "variable", "unknown")
        @body_walked = check_block(group.get(plain, 2), drum_scope, globals, diagnostics)
        out lookup.walked(ast.with_part(ast.with_part(node, 1, count_walked.node), 2, body_walked.node), body_walked.diagnostics)
    }
    (tag == "switch") {
        @subject_node = ast.switch_subject(node)
        @subject_walked = check_expression(subject_node, scope, globals, diagnostics)
        diagnostics = subject_walked.diagnostics
        @current = ast.with_part(node, 1, subject_walked.node)
        @subject_type = types.value_type(subject_node, scope, globals)
        @seen = []
        drum (ast.switch_case_count(node)) {
            @case_node = ast.switch_case(node, beat)
            @variant_name = ast.case_variant(case_node)
            pick {
                (names.has(seen, variant_name) == yes) {
                    diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(case_node, errors.duplicate_switch_case(variant_name)))
                }
                { seen = names.put(seen, variant_name, "case", "unknown") }
            }
            @variant = names.table_find(globals, names.variant_key(variant_name))
            pick {
                (str.bytes(variant.name) == 0) {
                    diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(case_node, errors.unknown_enum_variant(variant_name)))
                }
                (str.starts_with(subject_type, "enum:") == yes) {
                    ((variant.type == subject_type) == no) {
                        @owner_name = types.type_text(variant.type)
                        @subject_name = types.type_text(subject_type)
                        diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(case_node, errors.enum_type_mismatch(variant_name, owner_name, subject_name)))
                    }
                }
            }
            @body_walked = check_expression(ast.case_body(case_node), scope, globals, diagnostics)
            diagnostics = body_walked.diagnostics
            current = ast.with_part(current, beat + 2, ast.with_part(case_node, 2, body_walked.node))
        }
        out lookup.walked(current, diagnostics)
    }
    out lookup.walked(node, lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.unknown_statement(tag))))
}

skill check_block(block, scope, globals, diagnostics) {
    @plain = ast.plain(block)
    @current = block
    drum (group.count(plain) - 1) {
        @statement_walked = check_statement(group.get(plain, beat + 1), scope, globals, diagnostics)
        diagnostics = statement_walked.diagnostics
        current = ast.with_part(current, beat + 1, statement_walked.node)
    }
    out lookup.walked(current, diagnostics)
}

skill check_params(owner, params, globals, subject, module, body, diagnostics) {
    @scope = names.Scope { subject = subject, module = module }
    (str.bytes(subject) > 0) {
        @model = names.table_find(globals, subject)
        drum (group.count(ast.plain(model.node)) - 2) {
            @member = ast.part(model.node, beat + 2)
            (ast.tag(member) == "field") { scope.names = names.put(scope.names, ast.part(member, 1), "field", types.type_in_module(ast.part(member, 2), module, globals)) }
        }
    }
    drum (params) {
        pick {
            (names.has(scope.names, beat) == yes) { diagnostics = lookup.add_diagnostic(diagnostics, lookup.placed(owner, errors.duplicate_param(beat))) }
            {
                diagnostics = lookup.check_module_name(owner, beat, module, globals, diagnostics)
                scope.names = names.put(scope.names, beat, "parameter", "unknown")
            }
        }
    }
    out check_block(body, scope, globals, diagnostics)
}
