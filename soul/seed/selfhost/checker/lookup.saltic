-- lookup — проверка путей (имя, поле, enum, seed) и мелкие помощники чекера.
-- Walked — итог обхода узла: новый узел плюс накопленные диагностики.
-- placed ставит место узла в готовую ошибку из errors.
--
-- Walked = Box { diagnostics, node }
-- walked(node, diagnostics) -> Walked; issues(result) -> diagnostics
-- placed(node, found) -> found с line/col узла
-- add_diagnostic(diagnostics, item) -> группа
-- long_call(callee) -> ошибка long_path для вызова
-- box_has_skill(globals, box_name, skill_name) / box_node_has_skill(node, skill_name) -> answer
-- Case = Box { full, diagnostics }; case_variant(case_node, subject_type, variant, globals,
--     diagnostics) -> Case: full — полное имя варианта «enum.ВАРИАНТ» для кодогена (по типу значения, иначе по
--     единственному enum с таким вариантом — Q-015), или ошибки
-- enum_has(globals, enum_name, variant) -> answer
-- check_path(node, scope, globals, diagnostics) -> Walked с разрешённым путём;
--     поле, которое может быть пустым (тип none), дальше по пути — maybe_none
-- check_module_name(node, name, module, globals, diagnostics) -> diagnostics
-- check_fixed_escape(node, value, place, scope, globals, diagnostics) -> diagnostics
-- check_fraction_text(node, globals, diagnostics) -> diagnostics — показ дробного
--     в "{…}" зовёт core.fraction.text: модуль должен быть подключён

use core.str
use core.group
use selfhost.ast
use selfhost.errors
use selfhost.checker.names
use selfhost.checker.types
use selfhost.checker.rules

Walked = Box {
    diagnostics = [],
    node = []
}

skill walked(node, diagnostics) {
    out Walked { diagnostics = diagnostics, node = node }
}

skill issues(result) {
    out result.diagnostics
}

skill long_call(callee) {
    @count = group.count(callee)
    @full = ast.path_text(callee)
    @module = group.get(callee, 1)
    drum (count - 3) { module = str.concat(module, str.concat(".", group.get(callee, beat + 2))) }
    @short = str.concat(group.get(callee, count - 2), str.concat(".", group.get(callee, count - 1)))
    out errors.long_call(full, module, short)
}

skill placed(node, found) {
    @place = ast.location(node)
    found.line = group.get(place, 0)
    found.col = group.get(place, 1)
    out found
}

skill add_diagnostic(diagnostics, item) {
    out group.add(diagnostics, item)
}

skill box_has_skill(globals, box_name, skill_name) {
    @box = names.table_find(globals, box_name)
    out box_node_has_skill(box.node, skill_name)
}

skill box_node_has_skill(node, skill_name) {
    drum (group.count(ast.plain(node)) - 2) {
        @member = ast.part(node, beat + 2)
        (ast.tag(member) == "subject-skill") {
            (ast.part(member, 1) == skill_name) { out yes }
        }
    }
    out no
}

Case = Box {
    full = "",
    diagnostics = []
}

skill case_of(full, diagnostics) {
    out Case { full = full, diagnostics = diagnostics }
}

skill case_variant(case_node, subject_type, variant, globals, diagnostics) {
    @short = names.table_find(globals, names.variant_key(variant))
    (str.bytes(short.name) == 0) { out case_of(variant, add_diagnostic(diagnostics, placed(case_node, errors.unknown_enum_variant(variant)))) }
    (types.is_enum_type(subject_type) == yes) {
        @owner = types.enum_name(subject_type)
        (enum_has(globals, owner, variant) == yes) { out case_of("{owner}.{variant}", diagnostics) }
        @other = types.type_text(short.type)
        (short.type == names.AMBIGUOUS) { other = "другому enum" }
        out case_of(variant, add_diagnostic(diagnostics, placed(case_node, errors.enum_type_mismatch(variant, other, types.type_text(subject_type)))))
    }
    (short.type == names.AMBIGUOUS) { out case_of(variant, add_diagnostic(diagnostics, placed(case_node, errors.ambiguous_enum_case(variant)))) }
    @owner = types.enum_name(short.type)
    out case_of("{owner}.{variant}", diagnostics)
}

skill enum_has(globals, enum_name, variant) {
    @model = names.table_find(globals, enum_name)
    drum (ast.enum_variant_count(model.node)) {
        (ast.enum_variant(model.node, beat) == variant) { out yes }
    }
    out no
}

skill check_path(node, scope, globals, diagnostics) {
    @parts = ast.plain(node)
    @name = group.get(parts, 1)
    @count = group.count(parts)
    @long = names.long_reference(node, scope, globals)
    (errors.is_ok(long) == no) { out walked(node, add_diagnostic(diagnostics, placed(node, long))) }
    @resolved = names.resolve_path(node, scope, globals)
    (str.bytes(resolved) > 0) { out walked(ast.rebuild(node, names.path_from_text(resolved)), diagnostics) }
    (count == 2) {
        @known = names.has(scope.names, name)
        (known == no) { known = names.visible(globals, scope.module, name) }
        (name == "error") { known = yes }
        (known == no) { out walked(node, add_diagnostic(diagnostics, placed(node, errors.unknown_name(name)))) }
        out walked(node, diagnostics)
    }
    (name == "error") { out walked(node, diagnostics) }
    @enum_name = names.resolve_name(ast.path_prefix(node), scope.module, globals)
    @enum_model = names.table_find(globals, enum_name)
    (enum_model.kind == "enum") {
        @variant = group.get(parts, count - 1)
        (enum_has(globals, enum_name, variant) == no) { out walked(node, add_diagnostic(diagnostics, placed(node, errors.enum_lacks_variant(enum_name, variant)))) }
        @full_variant = names.path_from_text(enum_name)
        out walked(ast.rebuild(node, group.add(full_variant, variant)), diagnostics)
    }
    @import = names.table_find(globals, ast.alias_key(scope.module, name))
    (import.kind == "import") {
        (names.has(scope.names, name) == no) {
            @full = ast.path_text(node)
            out walked(node, add_diagnostic(diagnostics, placed(node, errors.unknown_name(full))))
        }
    }
    @global = names.find_visible(globals, scope.module, name)
    @base = names.find(scope.names, name)
    (str.bytes(base.name) == 0) { base = global }
    (str.bytes(base.name) == 0) { out walked(node, add_diagnostic(diagnostics, placed(node, errors.unknown_namespace(name)))) }
    @type = base.type
    drum (count - 2) {
        @field_name = group.get(parts, beat + 2)
        (type == "unknown") { leave }
        (type == "none") {
            diagnostics = add_diagnostic(diagnostics, placed(node, errors.maybe_none(str.join(group.slice(parts, 1, beat + 2), "."))))
            leave
        }
        (types.is_box_type(type) == no) {
            @type_name = types.type_text(type)
            diagnostics = add_diagnostic(diagnostics, placed(node, errors.field_on_non_box(field_name, type_name)))
            leave
        }
        @box_name = types.box_name(type)
        @field = types.box_field(globals, box_name, field_name)
        (str.bytes(field.name) == 0) {
            diagnostics = add_diagnostic(diagnostics, placed(node, errors.unknown_field(box_name, field_name)))
            leave
        }
        type = field.type
    }
    out walked(node, diagnostics)
}

skill check_module_name(node, name, module, globals, diagnostics) {
    @target = names.module_alias(globals, module, name)
    (str.bytes(target) == 0) { out diagnostics }
    out add_diagnostic(diagnostics, placed(node, errors.name_taken_by_module(name, target)))
}

skill check_fraction_text(node, globals, diagnostics) {
    (names.table_has(globals, "core.fraction.text") == yes) { out diagnostics }
    out add_diagnostic(diagnostics, placed(node, errors.fraction_text_module()))
}

skill check_fixed_escape(node, value, place, scope, globals, diagnostics) {
    @problem = rules.fixed_escape(types.value_type(value, scope, globals), place)
    (errors.is_ok(problem) == yes) { out diagnostics }
    out add_diagnostic(diagnostics, placed(node, problem))
}
