use core.str
use selfhost.ast
use selfhost.intrinsic.contract
use selfhost.checker.types
use selfhost.errors
use selfhost.abi.call

skill arity(signature, actual) {
    (actual > call.ARGUMENT_LIMIT) { out errors.too_many_arguments(call.ARGUMENT_LIMIT) }
    (signature.found == no) { out errors.ok() }
    (actual < signature.minimum) { out errors.too_few_arguments(signature.name, signature.minimum, actual) }
    (actual > signature.maximum) { out errors.too_many_for_skill(signature.name, signature.maximum, actual) }
    out errors.ok()
}

skill argument(name, index, expected, actual) {
    (types.compatible(expected, actual) == yes) { out errors.ok() }
    @expected_text = types.type_text(expected)
    (expected == "group:unknown") { expected_text = "группа" }
    @actual_text = types.type_text(actual)
    @position = index + 1
    out errors.argument_type_mismatch(name, position, actual_text, expected_text)
}

skill is_zero(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "number") {
        (ast.part(plain, 1) == 0) { out yes }
    }
    out no
}

skill is_integer_literal(node) {
    @plain = ast.plain(node)
    @tag = ast.tag(plain)
    (tag == "number") { out yes }
    (tag == "wide-number") { out yes }
    (tag == "binary") {
        (ast.part(plain, 1) == "-") {
            (is_zero(ast.part(plain, 2)) == yes) {
                @right_tag = ast.tag(ast.part(plain, 3))
                (right_tag == "number") { out yes }
                (right_tag == "wide-number") { out yes }
            }
        }
    }
    out no
}

skill is_fraction(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "fraction-number") { out yes }
    (ast.tag(plain) == "binary") {
        (ast.part(plain, 1) == "-") { out is_fraction(ast.part(plain, 3)) }
    }
    out no
}

skill fixed_argument(node, actual_type) {
    (is_fraction(node) == yes) { out errors.fixed_fraction() }
    (is_integer_literal(node) == yes) { out errors.ok() }
    (actual_type == "number") { out errors.ok() }
    (contract.is_fixed_type(actual_type) == yes) { out errors.ok() }
    (actual_type == "unknown") { out errors.ok() }
    out errors.fixed_wrong_value(actual_type)
}

skill fixed_escape(type, place) {
    (contract.is_fixed_type(type) == no) { out errors.ok() }
    out errors.fixed_escape(type, place)
}

skill drum_count(type) {
    (type == "number") { out errors.ok() }
    (type == "unknown") { out errors.ok() }
    (str.starts_with(type, "group:") == yes) { out errors.ok() }
    out errors.drum_type(type)
}
