-- rules — правила чекера о вызовах, фиксированных типах и drum.
-- Каждое правило отдаёт готовую ошибку из errors или errors.ok().
--
-- arity(signature, actual) — число аргументов против Signature и предела 8
-- argument(name, index, expected, actual) — совместимость типа аргумента; где
--     ждут фиксированный, неизвестный тип — ошибка (Q-037)
-- is_integer_literal / is_fraction(node) -> answer; целое — то, что даёт types.integer_text
-- fixed_argument(node, actual_type) — что можно передать в u8.from(…) и подобные
-- fixed_escape(type, place) — фиксированный тип не покидает навык
-- negatable(type) -> yes у числа, дробного, фиксированного и неизвестного (унарный минус, Q-025)
-- plain_numbers(left, right) -> yes — оба числа или есть дробное (его правила — ниже)
-- fraction_partner(operator, left, right) — дробное только с дробным (Q-041): смешение,
--     == и % — ошибки; ~= — только для двух дробных
-- fixed_partner(operator, left, right) — фиксированный рядом с неизвестным
--     типом — ошибка (Q-037); == — только с тем же типом (литерал рядом с
--     фиксированным тип не берёт — Q-002)
-- drum_count(type) — drum принимает число или группу
-- fits_wide(text) -> yes/no — десятичное число не больше 2^60 - 1 (WIDE_MAXIMUM_TEXT)
-- always_assign(scope_names, name, type) — в always внешней переменной (объявлена
--     до метки ALWAYS_MARKER) нельзя присвоить строку, группу или Box
-- check_cycles(body, diagnostics) -> diagnostics — циклы ссылок, видимые в теле
--     (решение автора 14.11.2026: циклы запрещены, остальное ловит рантайм):
--     запись x.f = y — ошибка cycle_reference (с местом узла), если x достижим из y
--     по связям «из → в», собранным по инструкциям в порядке текста: литерал Box
--     или группы с именем внутри, @x = y (оба направления), @x = y.f и (y.f) |x|
--     (x достижим из y), прежние записи полей; присваивание имени снимает его
--     связи. Reach { links, diagnostics } — состояние прохода; reaches / unlink /
--     expression_names / cycle_bind / cycle_node — части

use core.str
use selfhost.ast
use selfhost.intrinsic.contract
use selfhost.checker.types
use selfhost.errors
use core.group
use selfhost.abi.call

ALWAYS_MARKER = "$always"
WIDE_MARK = "__wide_numbers__"
WIDE_MAXIMUM_TEXT = "1152921504606846975"

skill arity(signature, actual) {
    (actual > call.ARGUMENT_LIMIT) { out errors.too_many_arguments(call.ARGUMENT_LIMIT) }
    (signature.found == no) { out errors.ok() }
    (actual < signature.minimum) { out errors.too_few_arguments(signature.name, signature.minimum, actual) }
    (actual > signature.maximum) { out errors.too_many_for_skill(signature.name, signature.maximum, actual) }
    out errors.ok()
}

skill argument(name, index, expected, actual) {
    @unknown_fixed = no
    (actual == "unknown") { unknown_fixed = contract.is_fixed_type(expected) }
    (unknown_fixed == no) { (types.compatible(expected, actual) == yes) { out errors.ok() } }
    @expected_text = types.type_text(expected)
    (expected == "group:unknown") { expected_text = "группа" }
    @actual_text = types.type_text(actual)
    @position = index + 1
    out errors.argument_type_mismatch(name, position, actual_text, expected_text)
}

skill is_integer_literal(node) {
    out str.bytes(types.integer_text(node)) > 0
}

skill is_fraction(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "fraction-number") { out yes }
    (ast.tag(plain) == "binary") {
        (ast.part(plain, 1) == "-") { out is_fraction(ast.part(plain, 3)) }
    }
    out no
}

skill fixed_argument(node, actual_type) {
    (is_fraction(node) == yes) { out errors.fixed_fraction() }
    (is_integer_literal(node) == yes) { out errors.ok() }
    (actual_type == "number") { out errors.ok() }
    (contract.is_fixed_type(actual_type) == yes) { out errors.ok() }
    (actual_type == "unknown") { out errors.ok() }
    out errors.fixed_wrong_value(actual_type)
}

skill fixed_partner(operator, left, right) {
    @fixed = contract.is_fixed_type(left)
    (contract.is_fixed_type(right) == yes) { fixed = yes }
    (fixed == no) { out errors.ok() }
    (left == "unknown") { out errors.fixed_unknown_partner(operator, right) }
    (right == "unknown") { out errors.fixed_unknown_partner(operator, left) }
    ((operator == "==") == no) { out errors.ok() }
    (left == right) { out errors.ok() }
    (left == "number") { out errors.operator_mixes_number("==", right) }
    (right == "number") { out errors.operator_mixes_number("==", left) }
    out errors.operator_mixes_fixed("==", left, right)
}

skill negatable(type) {
    (type == "number") { out yes }
    (type == "unknown") { out yes }
    (type == "fraction") { out yes }
    out contract.is_fixed_type(type)
}

skill plain_numbers(left, right) {
    (left == "fraction") { out yes }
    (right == "fraction") { out yes }
    (left == "number") { out right == "number" }
    out no
}

skill fraction_partner(operator, left, right) {
    @both = no
    (left == "fraction") { both = right == "fraction" }
    (operator == "~=") {
        (both == yes) { out errors.ok() }
        out errors.near_expects_fractions(types.type_text(left), types.type_text(right))
    }
    @any = left == "fraction"
    (right == "fraction") { any = yes }
    (any == no) { out errors.ok() }
    (both == yes) {
        (operator == "==") { out errors.fraction_equality() }
        (operator == "%") { out errors.fraction_remainder() }
        out errors.ok()
    }
    @other = left
    (left == "fraction") { other = right }
    (other == "unknown") { out errors.ok() }
    out errors.fraction_mixes(operator, types.type_text(other))
}

skill fixed_escape(type, place) {
    (contract.is_fixed_type(type) == no) { out errors.ok() }
    out errors.fixed_escape(type, place)
}

skill drum_count(type) {
    (type == "number") { out errors.ok() }
    (type == "unknown") { out errors.ok() }
    (types.is_group_type(type) == yes) { out errors.ok() }
    out errors.drum_type(type)
}

skill always_assign(scope_names, name, type) {
    @declared = -1
    @marker = -1
    drum (group.count(scope_names)) {
        @item = group.get(scope_names, beat)
        (item.name == ALWAYS_MARKER) { marker = beat }
        (item.name == name) {
            (declared < 0) { declared = beat }
        }
    }
    (marker < 0) { out errors.ok() }
    (declared > marker) { out errors.ok() }
    @memory = types.is_box_type(type)
    (type == "string") { memory = yes }
    (str.starts_with(type, "group") == yes) { memory = yes }
    (memory == no) { out errors.ok() }
    out errors.always_outer_value(types.type_text(type), name)
}

skill fits_wide(text) {
    @length = str.bytes(text)
    @limit = str.bytes(WIDE_MAXIMUM_TEXT)
    (length < limit) { out yes }
    (length > limit) { out no }
    drum (length) {
        @actual = str.get(text, beat)
        @maximum = str.get(WIDE_MAXIMUM_TEXT, beat)
        ((actual == maximum) == no) { out str.byte(actual, 0) < str.byte(maximum, 0) }
    }
    out yes
}

Reach = Box {
    links = [],
    diagnostics = []
}

skill reaches(links, from, to, seen) {
    (from == to) { out yes }
    (group.contains(seen, from) == yes) { out no }
    seen = group.add(seen, from)
    drum (links) {
        (group.get(beat, 0) == from) {
            (reaches(links, group.get(beat, 1), to, seen) == yes) { out yes }
        }
    }
    out no
}

skill unlink(links, name) {
    @kept = []
    drum (links) {
        @touches = group.get(beat, 0) == name
        (group.get(beat, 1) == name) { touches = yes }
        (touches == no) { kept = group.add(kept, beat) }
    }
    out kept
}

skill expression_names(node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "path") {
        (group.count(plain) == 2) { out [group.get(plain, 1)] }
        out []
    }
    (tag == "call") { out [] }
    @found = []
    (tag == "box-new") {
        drum (ast.children(node)) { found = group.concat(found, expression_names(beat)) }
        out found
    }
    (tag == "group") {
        drum (ast.children(node)) { found = group.concat(found, expression_names(beat)) }
        out found
    }
    out found
}

skill cycle_bind(reach, name, value) {
    reach.links = unlink(reach.links, name)
    @plain = ast.plain(value)
    (group.get(plain, 0) == "path") {
        (group.count(plain) == 2) {
            @other = group.get(plain, 1)
            reach.links = group.add(reach.links, [name, other])
            reach.links = group.add(reach.links, [other, name])
            out reach
        }
        (group.count(plain) > 2) {
            reach.links = group.add(reach.links, [group.get(plain, 1), name])
            out reach
        }
    }
    drum (expression_names(value)) { reach.links = group.add(reach.links, [name, beat]) }
    out reach
}

skill cycle_node(reach, node) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "var") { out cycle_bind(reach, group.get(plain, 1), group.get(plain, 2)) }
    (tag == "assign") { out cycle_bind(reach, group.get(plain, 1), group.get(plain, 2)) }
    (tag == "present") {
        reach = cycle_bind(reach, group.get(plain, 2), group.get(plain, 1))
        out cycle_node(reach, group.get(plain, 3))
    }
    (tag == "field-assign") {
        @target = ast.plain(group.get(plain, 1))
        @owner = group.get(target, 1)
        @field = group.get(target, group.count(target) - 1)
        drum (expression_names(group.get(plain, 2))) {
            (reaches(reach.links, beat, owner, []) == yes) {
                @place = ast.location(node)
                @found = errors.cycle_reference(owner, field, beat)
                found.line = group.get(place, 0)
                found.col = group.get(place, 1)
                reach.diagnostics = group.add(reach.diagnostics, found)
            }
            reach.links = group.add(reach.links, [owner, beat])
        }
        out reach
    }
    drum (ast.children(node)) { reach = cycle_node(reach, beat) }
    out reach
}

skill check_cycles(body, diagnostics) {
    @reach = cycle_node(Reach {}, body)
    drum (reach.diagnostics) { diagnostics = group.add(diagnostics, beat) }
    out diagnostics
}
