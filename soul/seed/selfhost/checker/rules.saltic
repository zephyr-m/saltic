-- rules — правила чекера о вызовах, фиксированных типах и drum.
-- Каждое правило отдаёт готовую ошибку из errors или errors.ok().
--
-- arity(signature, actual) — число аргументов против Signature и предела 8
-- argument(name, index, expected, actual) — совместимость типа аргумента
-- is_integer_literal / is_fraction(node) -> answer; целое — то, что даёт types.integer_text
-- fixed_argument(node, actual_type) — что можно передать в u8.from(…) и подобные
-- fixed_escape(type, place) — фиксированный тип не покидает навык
-- fixed_partner(operator, left, right) — фиксированный рядом с неизвестным
--     типом — ошибка (Q-037); == — только с тем же типом (литерал рядом с
--     фиксированным тип не берёт — Q-002)
-- drum_count(type) — drum принимает число или группу
-- fits_wide(text) -> yes/no — десятичное число не больше 2^60 - 1 (WIDE_MAXIMUM_TEXT)
-- always_assign(scope_names, name, type) — в always внешней переменной (объявлена
--     до метки ALWAYS_MARKER) нельзя присвоить строку, группу или Box

use core.str
use selfhost.ast
use selfhost.intrinsic.contract
use selfhost.checker.types
use selfhost.errors
use core.group
use selfhost.abi.call

ALWAYS_MARKER = "$always"
WIDE_MARK = "__wide_numbers__"
WIDE_MAXIMUM_TEXT = "1152921504606846975"

skill arity(signature, actual) {
    (actual > call.ARGUMENT_LIMIT) { out errors.too_many_arguments(call.ARGUMENT_LIMIT) }
    (signature.found == no) { out errors.ok() }
    (actual < signature.minimum) { out errors.too_few_arguments(signature.name, signature.minimum, actual) }
    (actual > signature.maximum) { out errors.too_many_for_skill(signature.name, signature.maximum, actual) }
    out errors.ok()
}

skill argument(name, index, expected, actual) {
    (types.compatible(expected, actual) == yes) { out errors.ok() }
    @expected_text = types.type_text(expected)
    (expected == "group:unknown") { expected_text = "группа" }
    @actual_text = types.type_text(actual)
    @position = index + 1
    out errors.argument_type_mismatch(name, position, actual_text, expected_text)
}

skill is_integer_literal(node) {
    out str.bytes(types.integer_text(node)) > 0
}

skill is_fraction(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "fraction-number") { out yes }
    (ast.tag(plain) == "binary") {
        (ast.part(plain, 1) == "-") { out is_fraction(ast.part(plain, 3)) }
    }
    out no
}

skill fixed_argument(node, actual_type) {
    (is_fraction(node) == yes) { out errors.fixed_fraction() }
    (is_integer_literal(node) == yes) { out errors.ok() }
    (actual_type == "number") { out errors.ok() }
    (contract.is_fixed_type(actual_type) == yes) { out errors.ok() }
    (actual_type == "unknown") { out errors.ok() }
    out errors.fixed_wrong_value(actual_type)
}

skill fixed_partner(operator, left, right) {
    @fixed = contract.is_fixed_type(left)
    (contract.is_fixed_type(right) == yes) { fixed = yes }
    (fixed == no) { out errors.ok() }
    (left == "unknown") { out errors.fixed_unknown_partner(operator, right) }
    (right == "unknown") { out errors.fixed_unknown_partner(operator, left) }
    ((operator == "==") == no) { out errors.ok() }
    (left == right) { out errors.ok() }
    (left == "number") { out errors.operator_mixes_number("==", right) }
    (right == "number") { out errors.operator_mixes_number("==", left) }
    out errors.operator_mixes_fixed("==", left, right)
}

skill fixed_escape(type, place) {
    (contract.is_fixed_type(type) == no) { out errors.ok() }
    out errors.fixed_escape(type, place)
}

skill drum_count(type) {
    (type == "number") { out errors.ok() }
    (type == "unknown") { out errors.ok() }
    (types.is_group_type(type) == yes) { out errors.ok() }
    out errors.drum_type(type)
}

skill always_assign(scope_names, name, type) {
    @declared = 0 - 1
    @marker = 0 - 1
    drum (group.count(scope_names)) {
        @item = group.get(scope_names, beat)
        (item.name == ALWAYS_MARKER) { marker = beat }
        (item.name == name) {
            (declared < 0) { declared = beat }
        }
    }
    (marker < 0) { out errors.ok() }
    (declared > marker) { out errors.ok() }
    @memory = types.is_box_type(type)
    (type == "string") { memory = yes }
    (str.starts_with(type, "group") == yes) { memory = yes }
    (memory == no) { out errors.ok() }
    out errors.always_outer_value(types.type_text(type), name)
}

skill fits_wide(text) {
    @length = str.bytes(text)
    @limit = str.bytes(WIDE_MAXIMUM_TEXT)
    (length < limit) { out yes }
    (length > limit) { out no }
    drum (length) {
        @actual = str.get(text, beat)
        @maximum = str.get(WIDE_MAXIMUM_TEXT, beat)
        ((actual == maximum) == no) { out str.byte(actual, 0) < str.byte(maximum, 0) }
    }
    out yes
}

