use core.str
use core.num
use selfhost.ast
use selfhost.intrinsic.contract
use selfhost.checker.types
use selfhost.abi.call

skill arity_message(signature, actual) {
    (actual > call.ARGUMENT_LIMIT) { out "вызов не может содержать больше {call.ARGUMENT_LIMIT} аргументов" }
    (signature.found == no) { out "" }
    (actual < signature.minimum) { out "вызов '{signature.name}' ожидает {signature.minimum}, получено {actual}" }
    (actual > signature.maximum) { out "вызов '{signature.name}' допускает не больше {signature.maximum}, получено {actual}" }
    out ""
}

skill argument_message(name, index, expected, actual) {
    (types.compatible(expected, actual) == yes) { out "" }
    @expected_text = types.type_text(expected)
    (expected == "group:unknown") { expected_text = "группа" }
    @actual_text = types.type_text(actual)
    @position = index + 1
    out "{name}: аргумент {position} — {actual_text}, ожидается {expected_text}"
}

skill is_zero(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "number") {
        (ast.part(plain, 1) == 0) { out yes }
    }
    out no
}

skill is_integer_literal(node) {
    @plain = ast.plain(node)
    @tag = ast.tag(plain)
    (tag == "number") { out yes }
    (tag == "wide-number") { out yes }
    (tag == "binary") {
        (ast.part(plain, 1) == "-") {
            (is_zero(ast.part(plain, 2)) == yes) {
                @right_tag = ast.tag(ast.part(plain, 3))
                (right_tag == "number") { out yes }
                (right_tag == "wide-number") { out yes }
            }
        }
    }
    out no
}

skill is_fraction(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "fraction-number") { out yes }
    (ast.tag(plain) == "binary") {
        (ast.part(plain, 1) == "-") { out is_fraction(ast.part(plain, 3)) }
    }
    out no
}

skill has_wide_number(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "wide-number") { out yes }
    (ast.tag(plain) == "binary") {
        (ast.part(plain, 1) == "-") { out has_wide_number(ast.part(plain, 3)) }
    }
    out no
}

skill fixed_argument_message(node, actual_type) {
    (is_fraction(node) == yes) { out "фиксированный целый тип не принимает дробное значение" }
    (is_integer_literal(node) == yes) { out "" }
    (actual_type == "number") { out "" }
    (contract.is_fixed_type(actual_type) == yes) { out "" }
    (actual_type == "unknown") { out "" }
    out "фиксированный целый тип не принимает {actual_type}"
}

skill fixed_escape_message(type, place) {
    (contract.is_fixed_type(type) == no) { out "" }
    out "{type} нельзя {place}: там фиксированный тип теряется"
}

skill drum_message(type) {
    (type == "number") { out "" }
    (type == "unknown") { out "" }
    (str.starts_with(type, "group:") == yes) { out "" }
    out "drum ожидает число или группу, получено {type}"
}
