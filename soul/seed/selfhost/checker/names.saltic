-- names — таблицы имён чекера и разрешение путей по ним.
-- Два вида: плоский список Name (локальные имена области) и таблица из
-- 64 корзин по хэшу (глобальные). Глобальное имя — полное «модуль.имя»;
-- импорт хранится под ключом ast.alias_key, его type — путь модуля.
-- Поиск отдаёт Name {} с пустым name, если не найдено.
--
-- Name = Box { name, kind, type, node }; Scope = Box { names, subject, module }
-- variant_key(name) -> ключ варианта enum в таблице; param_key(name, index) / result_key(name)
--     -> ключи выведенного фиксированного типа параметра и результата навыка
-- find / has(names, name); put(names, name, kind, type) / put_node(…, node); update(names, name, type)
-- bind(names, name, kind, type) — как put, но имя, что уже есть, получает новый тип
--     (rescue |имя| и (значение) |имя| перекрывают внешнее имя)
-- table_find / table_has(table, name); table_put(table, name, kind, type) / table_put_node(…, node)
-- bucket_of(name) -> номер корзины
-- visible(globals, module, name) / find_visible(…) — видно ли имя из модуля
-- module_alias(globals, module, name) -> путь модуля за псевдонимом или ""
-- resolve_name(name, module, globals) / resolve_path(node, scope, globals) -> полное имя или ""
-- call_name(callee, scope, globals) -> имя для поиска навыка
-- path_from_text(text) -> узел ["path", …]
-- long_reference(node, scope, globals) -> ошибка long_path или errors.ok()

use core.str
use core.group
use selfhost.ast
use selfhost.errors

NAME_BUCKETS = 64
NAME_HASH_LIMIT = 65521

Name = Box {
    name = "",
    kind = "",
    type = "unknown",
    node = []
}

Scope = Box {
    names = [],
    subject = "",
    module = ""
}

skill variant_key(name) {
    out "__enum_variant__|{name}"
}

skill param_key(name, index) {
    out "__param__|{name}|{index}"
}

skill result_key(name) {
    out "__result__|{name}"
}

skill find(names, name) {
    drum (names) {
        (beat.name == name) { out beat }
    }
    out Name {}
}

skill has(names, name) {
    @found = find(names, name)
    out str.bytes(found.name) > 0
}

skill bucket_of(name) {
    @size = str.bytes(name)
    @from = 0
    (size > 8) { from = size - 8 }
    @code = size
    drum (size - from) { code = (code * 31 + str.byte(name, from + beat)) % NAME_HASH_LIMIT }
    out code % NAME_BUCKETS
}

skill table_find(table, name) {
    (group.count(table) == 0) { out Name {} }
    out find(group.get(table, bucket_of(name)), name)
}

skill table_has(table, name) {
    @found = table_find(table, name)
    out str.bytes(found.name) > 0
}

skill table_put_node(table, name, kind, type, node) {
    @buckets = table
    (group.count(buckets) == 0) {
        drum (NAME_BUCKETS) { buckets = group.add(buckets, []) }
    }
    @index = bucket_of(name)
    @bucket = put_node(group.get(buckets, index), name, kind, type, node)
    out group.tree_replaced(buckets, index, bucket)
}

skill table_put(table, name, kind, type) {
    out table_put_node(table, name, kind, type, [])
}

skill visible(globals, module, name) {
    (str.contains(name, ".") == no) {
        (str.bytes(module) > 0) { out no }
    }
    out table_has(globals, name)
}

skill find_visible(globals, module, name) {
    (visible(globals, module, name) == no) { out Name {} }
    out table_find(globals, name)
}

skill module_alias(globals, module, name) {
    @import = table_find(globals, ast.alias_key(module, name))
    (import.kind == "import") { out import.type }
    out ""
}

skill put(names, name, kind, type) {
    out group.add(names, Name { name = name, kind = kind, type = type })
}

skill put_node(names, name, kind, type, node) {
    out group.add(names, Name { name = name, kind = kind, type = type, node = node })
}

skill update(names, name, type) {
    @result = []
    drum (names) {
        @next_type = beat.type
        (beat.name == name) { next_type = type }
        result = put_node(result, beat.name, beat.kind, next_type, beat.node)
    }
    out result
}

skill bind(names, name, kind, type) {
    (has(names, name) == yes) { out update(names, name, type) }
    out put(names, name, kind, type)
}

skill resolve_name(name, module, globals) {
    (visible(globals, module, name) == yes) { out name }
    @local = ast.qualified(module, name)
    (table_has(globals, local) == yes) { out local }
    @head = ast.name_head(name)
    @import = table_find(globals, ast.alias_key(module, head))
    (import.kind == "import") {
        @candidate = str.concat(import.type, ast.name_tail(name))
        (table_has(globals, candidate) == yes) { out candidate }
    }
    out ""
}

skill resolve_path(node, scope, globals) {
    @plain = ast.plain(node)
    @count = group.count(plain)
    @head = group.get(plain, 1)
    (count == 2) {
        (has(scope.names, head) == yes) { out "" }
    }
    @direct = ast.path_text(plain)
    (visible(globals, scope.module, direct) == yes) { out direct }
    (count == 2) {
        @local = ast.qualified(scope.module, head)
        (table_has(globals, local) == yes) { out local }
    }
    @import = table_find(globals, ast.alias_key(scope.module, head))
    (import.kind == "import") {
        @candidate = import.type
        drum (count - 2) {
            candidate = str.concat(candidate, str.concat(".", group.get(plain, beat + 2)))
        }
        (table_has(globals, candidate) == yes) { out candidate }
    }
    out ""
}

skill call_name(callee, scope, globals) {
    @resolved = resolve_path(callee, scope, globals)
    (str.bytes(resolved) > 0) {
        @global = table_find(globals, resolved)
        (global.kind == "native") { out resolved }
    }
    out ast.path_text(callee)
}

skill path_from_text(text) {
    out group.concat(["path"], str.split(text, "."))
}

skill long_reference(node, scope, globals) {
    @plain = ast.plain(node)
    @count = group.count(plain)
    (count < 4) { out errors.ok() }
    @head = group.get(plain, 1)
    (has(scope.names, head) == yes) { out errors.ok() }
    (table_has(globals, ast.qualified(scope.module, head)) == yes) { out errors.ok() }
    @text = ast.path_text(plain)
    @full = text
    @import = table_find(globals, ast.alias_key(scope.module, head))
    (import.kind == "import") { full = str.concat(import.type, str.concat(".", str.join(group.slice(plain, 2, count - 1 + 1), "."))) }
    @segments = path_from_text(full)
    @size = group.count(segments)
    drum (size - 2) {
        @length = size - 1 - beat
        (table_has(globals, str.join(group.slice(segments, 1, length + 1), ".")) == yes) {
            @module = str.join(group.slice(segments, 1, length - 1 + 1), ".")
            @short = str.join(group.slice(segments, length - 1, size - 1 + 1), ".")
            (short == text) { out errors.ok() }
            out errors.long_reference(text, module, short)
        }
    }
    out errors.ok()
}
