-- signatures — что принимает и отдаёт вызываемое: сколько аргументов (навык,
-- метод Box, intrinsic, фиксированный тип) и какие фиксированные типы у
-- параметров и результата навыка. Signature.found = no — «не найдено, арность
-- не проверяем». Тип выводится сам (решение автора 03.11.2026, Q-001, Q-042):
-- параметр фиксированный, только если все вызовы передают один фиксированный
-- тип, иначе обычный (MIXED), и фиксированное в вызове упаковывается в число
-- (пометка PACK у аргумента); результат — тип out. Лежит в globals под
-- names.param_key / result_key. Поле Box и группа — числом (Q-035); методы — без вывода.
--
-- Signature = Box { found, name, minimum, maximum }
-- exact(name, count) / range(name, minimum, maximum) -> Signature
-- from_skill(name, node) -> Signature по параметрам узла skill
-- intrinsic(name) -> Signature из contract или не найдено
-- subject(globals, box_name, skill_name) -> Signature метода Box
-- resolve(callee, scope, globals, receiver_type) -> Signature вызова
-- Observed = Box { globals, calls, strict, changed }; observe(tree, globals, strict)
--     -> Observed — типы из проверенного дерева (пометки аргументов и out); вызовы
--     сводятся за проход (summary), потом в globals (merged); strict = yes —
--     аргумент неизвестного типа делает параметр обычным; changed — что-то сменилось
-- argument_mark(node, index, full, fixed_call, scope, globals) -> пометка аргумента:
--     тип, "pack:тип" (кодоген упакует) или "" — без пометки
-- owner_name(owner, subject, module) -> полное имя навыка или "" (program, метод)
-- param_type(globals, owner, params, name) -> тип параметра или "unknown"
-- OUT_MARKER — имя в области: тип результата навыка
-- check_call(node, full, scope, globals, diagnostics) -> diagnostics — в метод Box
--     и прочее не-навык фиксированный не уходит
-- check_out(node, value, scope, globals, diagnostics) -> diagnostics
-- check_ending(owner, full, body, globals, diagnostics) -> diagnostics — навык с
--     фиксированным результатом кончается out

use core.str
use core.group
use selfhost.ast
use selfhost.intrinsic.contract
use selfhost.checker.names
use selfhost.checker.types
use selfhost.checker.lookup
use selfhost.errors

Signature = Box {
    found = no,
    name = "",
    minimum = 0,
    maximum = 0
}

skill exact(name, count) {
    out Signature { found = yes, name = name, minimum = count, maximum = count }
}

skill range(name, minimum, maximum) {
    out Signature { found = yes, name = name, minimum = minimum, maximum = maximum }
}

skill from_skill(name, node) {
    out exact(name, group.count(ast.part(node, 2)))
}

skill intrinsic(name) {
    @kind = contract.find(name)
    @minimum = contract.minimum_arguments(kind)
    (minimum < 0) { out Signature {} }
    out range(name, minimum, contract.maximum_arguments(kind))
}

skill subject(globals, box_name, skill_name) {
    @box = names.table_find(globals, box_name)
    drum (group.count(ast.plain(box.node)) - 2) {
        @member = ast.part(box.node, beat + 2)
        (ast.tag(member) == "subject-skill") {
            (ast.part(member, 1) == skill_name) {
                out from_skill("{box_name}.{skill_name}", member)
            }
        }
    }
    out Signature {}
}

skill resolve(callee, scope, globals, receiver_type) {
    @plain = ast.plain(callee)
    @count = group.count(plain)
    @name = names.call_name(plain, scope, globals)

    @builtin = intrinsic(name)
    (builtin.found == yes) { out builtin }

    (count == 2) {
        @short_name = group.get(plain, 1)
        (str.bytes(scope.subject) > 0) {
            @method = subject(globals, scope.subject, short_name)
            (method.found == yes) { out method }
        }
    }

    (count == 3) {
        (types.is_box_type(receiver_type) == yes) {
            @box_name = types.box_name(receiver_type)
            @method = subject(globals, box_name, group.get(plain, 2))
            (method.found == yes) { out method }
        }
    }

    @resolved = names.resolve_path(callee, scope, globals)
    @global = names.table_find(globals, resolved)
    (global.kind == "skill") { out from_skill(resolved, global.node) }

    out Signature {}
}

OUT_MARKER = "$out"
PACK = "pack:"
MIXED = "$mixed"
OTHER = "$other"

Observed = Box {
    globals = [],
    calls = [],
    strict = no,
    changed = no
}

skill owner_name(owner, subject, module) {
    (str.bytes(subject) > 0) { out "" }
    (ast.tag(owner) == "skill") { out ast.qualified(module, ast.part(owner, 1)) }
    out ""
}

skill param_type(globals, owner, params, name) {
    drum (group.count(params)) {
        (group.get(params, beat) == name) {
            @found = names.table_find(globals, names.param_key(owner, beat))
            (contract.is_fixed_type(found.type) == yes) { out found.type }
        }
    }
    out "unknown"
}

skill argument_mark(node, index, full, fixed_call, scope, globals) {
    @type = types.value_type(ast.call_argument(node, index), scope, globals)
    @fixed = contract.is_fixed_type(type)
    @callee = names.table_find(globals, names.resolve_path(ast.call_callee(node), scope, globals))
    (callee.kind == "skill") {
        @param = names.table_find(globals, names.param_key(callee.name, index))
        (fixed == yes) { ((param.type == type) == no) { out str.concat(PACK, type) } }
        (type == "unknown") { out "" }
        out type
    }
    (fixed_call == yes) { out type }
    (contract.is_known(full) == yes) { out type }
    (fixed == yes) { out type }
    out ""
}

skill noted(seen, key, type, node) {
    (contract.is_fixed_type(type) == no) { out seen }
    (names.table_has(seen.globals, key) == yes) { out seen }
    seen.globals = names.table_put_node(seen.globals, key, "inferred", type, node)
    seen.changed = yes
    out seen
}

skill summary(old, type) {
    (str.bytes(old) == 0) { out type }
    (old == type) { out type }
    out MIXED
}

skill passed(seen, key, argument) {
    @type = ast.type_of(argument)
    (str.starts_with(type, PACK) == yes) { type = str.slice(type, str.bytes(PACK), str.bytes(type)) }
    (type == "unknown") {
        (seen.strict == no) { out seen }
        type = OTHER
    }
    (contract.is_fixed_type(type) == no) { type = OTHER }
    @old = names.table_find(seen.calls, key)
    (str.bytes(old.name) > 0) {
        seen.calls = names.table_update(seen.calls, key, summary(old.type, type))
        out seen
    }
    seen.calls = names.table_put(seen.calls, key, "call", type)
    out seen
}

skill merged(seen, key, type) {
    @found = names.table_find(seen.globals, key)
    @old = found.type
    @next = old
    pick {
        (type == OTHER) { (contract.is_fixed_type(old) == yes) { next = MIXED } }
        (type == MIXED) { next = MIXED }
        (str.bytes(found.name) == 0) { next = type }
        ((old == type) == no) { next = MIXED }
    }
    (next == old) { out seen }
    seen.changed = yes
    (str.bytes(found.name) > 0) {
        seen.globals = names.table_update(seen.globals, key, next)
        out seen
    }
    seen.globals = names.table_put(seen.globals, key, "inferred", next)
    seen.changed = yes
    out seen
}

skill observe_node(seen, node, owner, module) {
    @plain = ast.plain(node)
    @tag = group.get(plain, 0)
    (tag == "out") {
        (str.bytes(owner) > 0) { seen = noted(seen, names.result_key(owner), ast.type_of(group.get(plain, 1)), node) }
    }
    (tag == "call") {
        @callee = names.resolve_path(group.get(plain, 1), names.Scope { module = module }, seen.globals)
        @global = names.table_find(seen.globals, callee)
        (global.kind == "skill") {
            drum (ast.call_argument_count(node)) { seen = passed(seen, names.param_key(callee, beat), ast.call_argument(node, beat)) }
        }
    }
    drum (ast.children(node)) { seen = observe_node(seen, beat, owner, module) }
    out seen
}

skill observe(tree, globals, strict) {
    @seen = Observed { globals = globals, strict = strict }
    drum (group.count(tree) - 1) {
        @item = group.get(tree, beat + 1)
        @module = ast.module_name(item)
        @tag = ast.tag(item)
        (tag == "skill") { seen = observe_node(seen, ast.part(item, 3), owner_name(item, "", module), module) }
        (tag == "entry") { seen = observe_node(seen, ast.part(item, 2), "", module) }
        (tag == "box") {
            drum (group.count(ast.plain(item)) - 2) {
                @member = ast.part(item, beat + 2)
                (ast.tag(member) == "subject-skill") { seen = observe_node(seen, ast.part(member, 3), "", module) }
            }
        }
    }
    drum (seen.calls) {
        drum (beat) { seen = merged(seen, beat.name, beat.type) }
    }
    out seen
}

skill check_call(node, full, scope, globals, diagnostics) {
    @callee = names.table_find(globals, names.resolve_path(ast.call_callee(node), scope, globals))
    (callee.kind == "skill") { out diagnostics }
    (callee.kind == "native") { out diagnostics }
    drum (ast.call_argument_count(node)) {
        diagnostics = lookup.check_fixed_escape(node, ast.call_argument(node, beat), "передать в '{full}'", scope, globals, diagnostics)
    }
    out diagnostics
}

skill check_out(node, value, scope, globals, diagnostics) {
    @expected = names.find(scope.names, OUT_MARKER)
    (str.bytes(expected.name) == 0) { out lookup.check_fixed_escape(node, value, "вернуть из навыка", scope, globals, diagnostics) }
    (contract.is_fixed_type(expected.type) == no) { out diagnostics }
    @actual = types.value_type(value, scope, globals)
    (actual == expected.type) { out diagnostics }
    (actual == "error") { out diagnostics }
    out lookup.add_diagnostic(diagnostics, lookup.placed(node, errors.result_type_mismatch(expected.type, types.type_text(actual))))
}

skill check_ending(owner, full, body, globals, diagnostics) {
    @result = names.table_find(globals, names.result_key(full))
    (contract.is_fixed_type(result.type) == no) { out diagnostics }
    @plain = ast.plain(body)
    @count = group.count(plain)
    (count > 1) {
        (ast.tag(group.get(plain, count - 1)) == "out") { out diagnostics }
    }
    out lookup.add_diagnostic(diagnostics, lookup.placed(owner, errors.result_falls_through(full, result.type)))
}
