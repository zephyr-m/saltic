-- toolchain — компилятор Saltic как программа: исходник -> проверка -> машина
-- RV32I -> образ для цели.
-- Запуск: program(исходник, выход, куча_текстом, цель); цели rv32i (ELF),
-- x86_64 и x86_64-uefi (родной x86-64: ELF64 Linux, PE32+ UEFI; с 04.11.2026);
-- x86_64-native и x86_64-uefi-native — те же цели по старому имени; rv64
-- (ELF64 RISC-V). Перевод RV32I в x86-64 — в .archive/x86_64_translation.
-- Модули ищутся от текущей папки.
-- Если ближние вызовы не уложились — собирает заново с дальними.
-- Исходник грузится с местами (parser.load_file_loc): дерево с обёртками
-- ast.located идёт в чекер и кодоген как есть, кодоген читает узлы через
-- ast.plain. Ход печатается строками «toolchain: …», ошибки —
-- «код|строка|столбец|текст».
--
-- build(source_path, output_path, heap_text, target) -> none;
--     ParseFailed, CheckFailed, ValueOutsideRange, UnknownTarget, WriteFailed
-- build_machine(ast, heap_size, far_calls) -> машина RV32I: исполнитель
--     rv32i.Executor и платформа linux.Linux
-- write_x86(ast, heap_size, output_path, firmware) -> none — родной x86-64:
--     слово 8 байт, числа 61-битные; ELF64 Linux без окна или PE32+ UEFI в
--     окне; WriteFailed
-- show(problem) / toolchain_show_diagnostics(diagnostics) — печать

use core.str
use core.group
use io
use selfhost.parser
use selfhost.checker
use selfhost.compiler
use selfhost.compiler.backend.rv32i
use selfhost.compiler.platform.linux
use selfhost.compiler.platform.uefi
use selfhost.compiler.backend.rv32i.machine.image
use selfhost.compiler.backend.x86_64_native
use selfhost.compiler.backend.rv64
use selfhost.compiler.backend.rv64.machine.elf64
use selfhost.machine.word
use selfhost.errors

skill show(problem) {
    io.show(problem.message)
    out none
}

skill toolchain_show_diagnostics(diagnostics) {
    drum (diagnostics) { io.show(beat.code, "|", beat.line, "|", beat.col, "|", beat.message) }
    out none
}

skill build_machine(ast, heap_size, far_calls) {
    out compiler.compile_machine(ast, heap_size, rv32i.Executor { far_calls = far_calls }, linux.Linux {})
}

skill write_x86(ast, heap_size, output_path, firmware) {
    @executor = x86_64_native.Executor { firmware = firmware, wide = yes }
    io.show("toolchain: пишу родной x86-64 ", output_path)
    (firmware == yes) {
        @firmware_machine = compiler.compile_machine(ast, heap_size, executor, uefi.Uefi {})
        x86_64_native.write_uefi(output_path, firmware_machine) rescue |failure| {
            io.show("toolchain: образ UEFI не собрался: ", failure)
            out error.WriteFailed
        }
        out none
    }
    @machine = compiler.compile_machine(ast, heap_size, executor, linux.Linux {})
    x86_64_native.write_wide(output_path, machine) rescue |failure| {
        io.show("toolchain: образ x86-64 не собрался: ", failure)
        out error.WriteFailed
    }
    out none
}

skill write_rv64(ast, heap_size, output_path) {
    @machine = compiler.compile_machine(ast, heap_size, rv64.Executor {}, linux.Linux {})
    io.show("toolchain: пишу RV64 ", output_path)
    elf64.write(output_path, machine) rescue |failure| {
        show(errors.near_calls_failed())
        @far = compiler.compile_machine(ast, heap_size, rv64.Executor { far_calls = yes }, linux.Linux {})
        elf64.write(output_path, far) rescue |again| {
            show(errors.far_calls_failed())
            out error.WriteFailed
        }
        out none
    }
    out none
}

skill build(source_path, output_path, heap_text, target) {
    io.show("toolchain: читаю ", source_path)
    @loaded = parser.load_file_loc(source_path, ".")
    (group.count(loaded.diagnostics) > 0) {
        toolchain_show_diagnostics(loaded.diagnostics)
        out error.ParseFailed
    }

    io.show("toolchain: проверяю")
    @wide = no
    (target == "rv64") { wide = yes }
    (target == "x86_64") { wide = yes }
    (target == "x86_64-native") { wide = yes }
    (target == "x86_64-uefi") { wide = yes }
    (target == "x86_64-uefi-native") { wide = yes }
    @checked = checker.check_for(loaded.ast, source_path, wide)
    (group.count(checked.diagnostics) > 0) {
        toolchain_show_diagnostics(checked.diagnostics)
        out error.CheckFailed
    }

    (str.starts_with(heap_text, "-") == yes) { out error.ValueOutsideRange }
    @heap_size = word.from_decimal(heap_text)
    io.show("toolchain: собираю")
    (target == "x86_64") { out write_x86(checked.tree, heap_size, output_path, no) }
    (target == "x86_64-uefi") { out write_x86(checked.tree, heap_size, output_path, yes) }
    (target == "x86_64-native") { out write_x86(checked.tree, heap_size, output_path, no) }
    (target == "x86_64-uefi-native") { out write_x86(checked.tree, heap_size, output_path, yes) }
    (target == "rv64") { out write_rv64(checked.tree, heap_size, output_path) }
    ((target == "rv32i") == no) { out error.UnknownTarget }
    @machine = build_machine(checked.tree, heap_size, no)
    io.show("toolchain: пишу ", output_path)
    image.write(output_path, machine) rescue |failure| {
        show(errors.near_calls_failed())
        @far = build_machine(checked.tree, heap_size, yes)
        image.write(output_path, far) rescue |again| {
            show(errors.far_calls_failed())
            out error.WriteFailed
        }
        out none
    }
    out none
}

program(source_path, output_path, heap_text, target) {
    out build(source_path, output_path, heap_text, target)
}
