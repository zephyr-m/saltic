use core.str
use core.group
use io
use selfhost.parser
use selfhost.checker
use selfhost.compiler
use selfhost.machine.image
use selfhost.compiler.backend.x86_64
use selfhost.machine.word
use selfhost.errors

skill show(problem) {
    io.show(problem.message)
    out none
}

skill toolchain_show_diagnostics(diagnostics) {
    drum (diagnostics) { io.show(beat.code, "|", beat.line, "|", beat.col, "|", beat.message) }
    out none
}

skill write_native(ast, heap_size, output_path, firmware) {
    @machine = compiler.compile_machine_with_heap(ast, heap_size)
    io.show("toolchain: перевожу в x86-64 ", output_path)
    pick {
        (firmware == yes) {
            x86_64.write_uefi(output_path, machine) rescue |failure| {
                show(errors.near_calls_failed())
                @far = compiler.compile_machine_far_with_heap(ast, heap_size, no)
                x86_64.write_uefi(output_path, far) rescue |again| {
                    show(errors.far_calls_failed())
                    out error.WriteFailed
                }
                out none
            }
        }
        {
            x86_64.write(output_path, machine) rescue |failure| {
                show(errors.near_calls_failed())
                @far = compiler.compile_machine_far_with_heap(ast, heap_size, no)
                x86_64.write(output_path, far) rescue |again| {
                    show(errors.far_calls_failed())
                    out error.WriteFailed
                }
                out none
            }
        }
    }
    out none
}

program(source_path, output_path, heap_text, target) {
    io.show("toolchain: читаю ", source_path)
    @loaded = parser.load_modules(source_path, ".")
    (group.count(loaded.diagnostics) > 0) {
        toolchain_show_diagnostics(loaded.diagnostics)
        out error.ParseFailed
    }

    io.show("toolchain: проверяю")
    @checked = checker.check(loaded.ast)
    (group.count(checked.diagnostics) > 0) {
        toolchain_show_diagnostics(checked.diagnostics)
        out error.CheckFailed
    }

    (str.starts_with(heap_text, "-") == yes) { out error.ValueOutsideRange }
    @heap_size = word.from_decimal(heap_text)
    io.show("toolchain: собираю")
    (target == "x86_64") { out write_native(loaded.ast, heap_size, output_path, no) }
    (target == "x86_64-uefi") { out write_native(loaded.ast, heap_size, output_path, yes) }
    ((target == "rv32i") == no) { out error.UnknownTarget }
    @machine = compiler.compile_machine_with_heap(loaded.ast, heap_size)
    io.show("toolchain: пишу ", output_path)
    image.write(output_path, machine) rescue |failure| {
        show(errors.near_calls_failed())
        @far = compiler.compile_machine_far_with_heap(loaded.ast, heap_size, no)
        image.write(output_path, far) rescue |again| {
            show(errors.far_calls_failed())
            out error.WriteFailed
        }
        out none
    }
    out none
}
