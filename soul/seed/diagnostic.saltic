use seed

Diagnostic = Box {
    code = "language_error"
    message = ""
    line = 0
    col = 0
}

skill make(code, line, col, message) {
    out Diagnostic {
        code = code
        message = message
        line = line
        col = col
    }
}

skill make_at(code, path, line, col, message) {
    @text = message
    (seed.str.len(path) > 0) { text = seed.str.add(seed.str.add(path, ": "), message) }
    out make(code, line, col, text)
}

skill has(items) {
    out seed.group.count(items) > 0
}
