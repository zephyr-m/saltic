set shell := ["bash", "-uc"]

default:
    @just --list

# 1. Язык: parser, loader, checker и единый вывод типов
stage-1-language:
    bash tests/stages/01-language.sh

# 2. ABI: реальные вызовы, возвраты и object layout
stage-2-abi:
    bash tests/stages/02-abi.sh

# 3. Машина: 44 команды, immediate и patches
stage-3-machine:
    bash tests/stages/03-machine.sh

# 4. Образ: собственный ELF для двух платформ
stage-4-image:
    bash tests/stages/04-image.sh

# 5. Память: точные корни и mark-and-sweep
stage-5-memory:
    bash tests/stages/05-memory.sh

# 6. Host: один ELF в собственной VM и QEMU user
stage-6-host:
    bash tests/stages/06-host.sh

# 7. Virt: один ELF в собственной VM и QEMU system
stage-7-virt:
    bash tests/stages/07-virt.sh

# 8. Замыкание: прямой ELF fixed point без GNU
stage-8-closure:
    bash tests/stages/08-closure.sh

# Все восемь ворот по порядку
seal:
    bash tests/seal.sh
