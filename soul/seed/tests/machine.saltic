use seed
use craft.testing
use seed.machine.instruction
use seed.machine.profile
use seed.machine.codec
use seed.machine.layout
use seed.compiler.backend.rv32i
use seed.vm
use seed.vm.state
use seed.tests.machine.golden
use seed.tests.machine.immediate
use seed.tests.machine.patches
use seed.tests.machine.elf
use seed.tests.machine.scale
use seed.tests.machine.translation
use seed.tests.machine.qemu

skill machine_profile(suite) {
    @names = [
        "lui", "auipc", "jal", "jalr",
        "beq", "bne", "blt", "bge", "bltu", "bgeu",
        "lb", "lh", "lw", "lbu", "lhu",
        "sb", "sh", "sw",
        "addi", "slti", "sltiu", "xori", "ori", "andi", "slli", "srli", "srai",
        "add", "sub", "sll", "slt", "sltu", "xor", "srl", "sra", "or", "and",
        "fence", "ecall", "ebreak",
        "csrrw", "csrrs", "mret", "wfi",
    ]
    @known = yes
    @machine_count = 0
    @index = 0
    drum (profile.INSTRUCTION_COUNT) {
        @name = seed.group.item(names, index)
        (profile.supports(name) == no) { known = no }
        @item = instruction.at(index)
        (profile.is_machine(item.kind) == yes) { machine_count = machine_count + 1 }
        index = index + 1
    }
    @add = instruction.find("add")
    @csrrw = instruction.find("csrrw")
    @mret = instruction.find("mret")
    @wfi = instruction.find("wfi")
    @ecall = instruction.find("ecall")
    @outside = instruction.at(44)
    suite = testing.test_yes(suite, "профиль: внутренне согласован", profile.valid())
    suite = testing.test_yes(suite, "профиль: таблица не имеет дыр и пересечений", instruction.valid_table())
    suite = testing.test_equal(suite, "профиль: слово содержит 32 бита", profile.WORD_BITS, 32)
    suite = testing.test_equal(suite, "профиль: регистров ровно 32", profile.REGISTER_COUNT, 32)
    suite = testing.test_equal(suite, "профиль: команда занимает 4 байта", profile.INSTRUCTION_BYTES, 4)
    suite = testing.test_equal(suite, "профиль: базовых команд ровно 40", profile.BASE_INSTRUCTION_COUNT, 40)
    suite = testing.test_equal(suite, "профиль: добавочных машинных команд ровно 4", profile.MACHINE_INSTRUCTION_COUNT, 4)
    suite = testing.test_equal(suite, "профиль: полный профиль содержит 44 команды", instruction.count(), 44)
    suite = testing.test_equal(suite, "профиль: независимый список содержит 44 команды", seed.group.count(names), 44)
    suite = testing.test_yes(suite, "профиль: все 44 имени найдены", known)
    suite = testing.test_equal(suite, "профиль: четыре машинные команды отделены", machine_count, 4)
    suite = testing.test_no(suite, "профиль: сжатых команд нет", profile.HAS_COMPRESSED_INSTRUCTIONS)
    suite = testing.test_equal(suite, "профиль: код операции add закреплён", add.opcode, 51)
    suite = testing.test_equal(suite, "профиль: вид CSR-записи закреплён", csrrw.funct3, 1)
    suite = testing.test_equal(suite, "профиль: возврат из ловушки закреплён", mret.system, 770)
    suite = testing.test_equal(suite, "профиль: ожидание процессора закреплено", wfi.system, 261)
    suite = testing.test_yes(suite, "профиль: возврат распознаётся однозначно", instruction.matches(mret, 115, 0, 24, 770))
    suite = testing.test_no(suite, "профиль: системный вызов не становится возвратом", instruction.matches(ecall, 115, 0, 0, 770))
    suite = testing.test_equal(suite, "профиль: выход за таблицу даёт неизвестную команду", outside.kind, instruction.Kind.UNKNOWN_INSTRUCTION)
    out suite
}

skill lowering(suite) {
    @target = rv32i.host("_start")
    target = rv32i.load_immediate(target, codec.T0, 5)
    target = rv32i.load_immediate(target, codec.T0, 2048)
    target = rv32i.label(target, layout.Section.CODE, "target")
    target = rv32i.branch_unsigned_greater(target, codec.T1, codec.T2, "target")
    target = rv32i.resolve(target)

    suite = testing.test_equal(suite, "lowering: li малого значения", codec.byte_at(target.code, 0), 147)
    suite = testing.test_equal(suite, "lowering: li малого значения bs1", codec.byte_at(target.code, 1), 2)
    suite = testing.test_equal(suite, "lowering: li малого значения bs2", codec.byte_at(target.code, 2), 80)
    suite = testing.test_equal(suite, "lowering: li малого значения bs3", codec.byte_at(target.code, 3), 0)
    suite = testing.test_equal(suite, "lowering: li большого значения — lui", codec.byte_at(target.code, 4), 183)
    suite = testing.test_equal(suite, "lowering: li большого значения — addi b0", codec.byte_at(target.code, 8), 147)
    suite = testing.test_yes(suite, "lowering: li эмитит четыре байта на два слова", target.code.length == 16)
    suite = testing.test_yes(suite, "lowering: bgtu эмитирует bltu с перестановкой", target.patch_count == 1)
    out suite
}

skill encoding(suite) {
    @encoded = codec.buffer()
    @valid = yes
    @index = 0
    drum (instruction.count()) {
        @item = instruction.at(index)
        @word = codec.encode(item, 1, 2, 3, 4) rescue |failure| {
            valid = no
            codec.word(0, 0, 0, 0)
        }
        encoded = codec.append_word(encoded, word)
        index = index + 1
    }
    @addi = codec.encode_kind(instruction.Kind.ADDI, 1, 2, 0, 3)
    suite = testing.test_yes(suite, "кодировщик: все 44 команды кодируются", valid)
    suite = testing.test_equal(suite, "кодировщик: каждая команда занимает четыре байта", encoded.length, 176)
    suite = testing.test_equal(suite, "кодировщик: первый байт addi закреплён", addi.b0, 147)
    suite = testing.test_equal(suite, "кодировщик: второй байт addi закреплён", addi.b1, 0)
    suite = testing.test_equal(suite, "кодировщик: третий байт addi закреплён", addi.b2, 49)
    suite = testing.test_equal(suite, "кодировщик: четвёртый байт addi закреплён", addi.b3, 0)
    suite = testing.test_equal(
        suite,
        "кодировщик: машинное слово видно только нулями и единицами",
        codec.word_bits(addi),
        "10010011 00000000 00110001 00000000"
    )
    out suite
}

skill executable(suite) {
    @target = rv32i.host("_start")
    target = rv32i.label(target, layout.Section.CODE, "_start")
    target = rv32i.branch(target, instruction.Kind.BEQ, codec.ZERO, codec.ZERO, "done")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, codec.A0, codec.ZERO, codec.ZERO, 9))
    target = rv32i.label(target, layout.Section.CODE, "done")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.EBREAK, codec.ZERO, codec.ZERO, codec.ZERO, 0))
    target = rv32i.resolve(target)

    @current_layout = layout.layout(target)
    @done_offset = layout.label_offset(target, current_layout, "done")
    @branch_byte = codec.byte_at(target.code, 1)
    @output = rv32i.executable(target)
    @chunks = codec.chunks(output, state.PAGE_SIZE)
    @options = state.Options {
        load_address = 4096
        memory_size = 262144
        step_limit = 16
        program_name = "seed-machine-contract"
        arguments = []
        files = []
    }
    @result = vm.run(chunks, options)

    suite = testing.test_equal(suite, "программа: метка получила точное смещение", done_offset, 8)
    suite = testing.test_equal(suite, "программа: ссылка на метку исправлена", branch_byte, 4)
    suite = testing.test_yes(suite, "образ: исполняемый файл создан", output.length > 4096)
    suite = testing.test_equal(suite, "образ: наша VM загрузила собственный файл", result.trap, "")
    suite = testing.test_equal(suite, "образ: переход пропустил лишнюю команду", result.steps, 2)
    suite = testing.test_equal(suite, "образ: программа остановилась штатно", result.reason, "break")
    out suite
}

skill codegen_execute(target, limit) {
    @output = rv32i.executable(target)
    @options = state.Options {
        load_address = 4096
        memory_size = 262144
        step_limit = limit
        program_name = "machine-codegen"
        arguments = []
        files = []
    }
    out vm.run(codec.chunks(output, state.PAGE_SIZE), options)
}

skill codegen_behavior(suite) {
    @string_result = codegen_execute(translation.behavior_string_program(), 32)
    suite = testing.test_equal(suite, "поведение string: нет trap", string_result.trap, "")
    suite = testing.test_equal(suite, "поведение string: остановка", string_result.reason, "break")
    suite = testing.test_equal(suite, "поведение string: длина saltic", seed.group.at(string_result.registers, codec.A0), "00000030")

    @arithmetic_result = codegen_execute(translation.behavior_arithmetic_program(), 32)
    suite = testing.test_equal(suite, "поведение арифметики: нет trap", arithmetic_result.trap, "")
    suite = testing.test_equal(suite, "поведение арифметики: остановка", arithmetic_result.reason, "break")
    suite = testing.test_equal(suite, "поведение арифметики: 2 + 3", seed.group.at(arithmetic_result.registers, codec.A0), "00000028")

    @if_result = codegen_execute(translation.behavior_if_program(), 32)
    suite = testing.test_equal(suite, "поведение if: нет trap", if_result.trap, "")
    suite = testing.test_equal(suite, "поведение if: остановка", if_result.reason, "break")
    suite = testing.test_equal(suite, "поведение if: ветка выполнена", seed.group.at(if_result.registers, codec.A0), "00000038")

    @group_result = codegen_execute(translation.behavior_group_program(), 96)
    suite = testing.test_equal(suite, "поведение group: нет trap", group_result.trap, "")
    suite = testing.test_equal(suite, "поведение group: остановка", group_result.reason, "break")
    suite = testing.test_equal(suite, "поведение group: два элемента", seed.group.at(group_result.registers, codec.A0), "00000010")

    @box_result = codegen_execute(translation.behavior_box_program(), 192)
    suite = testing.test_equal(suite, "поведение box: нет trap", box_result.trap, "")
    suite = testing.test_equal(suite, "поведение box: остановка", box_result.reason, "break")
    suite = testing.test_equal(suite, "поведение box: запись и чтение поля", seed.group.at(box_result.registers, codec.A0), "00000038")

    @number_text_result = codegen_execute(translation.behavior_number_text_program(), 256)
    suite = testing.test_equal(suite, "поведение number text: нет trap", number_text_result.trap, "")
    suite = testing.test_equal(suite, "поведение number text: остановка", number_text_result.reason, "break")
    suite = testing.test_equal(suite, "поведение number text: длина -42", seed.group.at(number_text_result.registers, codec.S4), "00000018")
    suite = testing.test_equal(suite, "поведение number text: знак -42", seed.group.at(number_text_result.registers, codec.S5), "00000168")
    suite = testing.test_equal(suite, "поведение number text: первая цифра -42", seed.group.at(number_text_result.registers, codec.S6), "000001a0")
    suite = testing.test_equal(suite, "поведение number text: вторая цифра -42", seed.group.at(number_text_result.registers, codec.A0), "00000190")

    out suite
}

program(output_path) {
    @suite = testing.test_new()
    suite = lowering(suite)
    suite = translation.run(suite)
    suite = codegen_behavior(suite)
    suite = machine_profile(suite)
    suite = encoding(suite)
    suite = executable(suite)
    suite = golden.run(suite)
    suite = immediate.run(suite)
    suite = patches.run(suite)
    suite = elf.run(suite)
    suite = scale.run(suite)
    suite = qemu.run(suite, output_path)
    out testing.test_finish(suite)
}
