-- fixed-errors test — намеренно неверное обращение с фиксированными типами:
-- выход за границы, смешение типов, address в арифметике, u8 в группе,
-- в аргументе и в поле Box. Собираться не должен: ожидаемые ошибки чекера —
-- expected/fixed-errors.txt, гоняет tests/run.sh (fixed-types).
--
-- invalid_fixed_types() / take(x) / make() / Box Reading — материал для чекера
-- program() — вызывает invalid_fixed_types

use core.mem
use core.bits32

skill invalid_fixed_types() {
    @u8_too_large = u8(256)
    @u8_negative = u8(0 - 1)
    @u8_negative_literal = u8(-1)
    @u16_too_large = u16(65536)
    @u32_too_large = u32(4294967296)
    @i32_too_small = i32(0 - 2147483649)
    @i32_too_small_literal = i32(-2147483649)
    @i32_too_large = i32(2147483648)

    @byte = u8(1)
    byte = u16(1)

    @mixed_unsigned = u8(1) + u16(1)
    @mixed_signed = i32(1) + u32(1)
    @number_mixed = u32(1) + 1
    @bits_arithmetic = bits32(1) + bits32(1)

    @memory = address(u32(4096))
    @bad_address_add = memory + usize(1)
    mem.store8(memory, usize(0), u16(1))
    mem.store16(memory, usize(0), u32(1))
    mem.store32(memory, usize(0), i32(1))

    @bad_mask = bits32.and(bits32(1), u32(1))
    @bad_shift = bits32.shift_left(bits32(1), u16(1))

    @bad_group = [u8(1)]
    take(u32(1))

    out none
}

skill take(x) {
    out none
}

skill make() {
    out u32(1)
}

Reading = Box {
    total = u32(0)
}

program() {
    invalid_fixed_types()
    out none
}
