-- fixed-errors test — намеренно неверное обращение с фиксированными типами:
-- выход за границы, смешение типов, address в арифметике, параметр то u32,
-- то число, результат то u32, то none, u32 рядом с неизвестным типом. В
-- группе и поле Box фиксированное — обычное число (Q-035), не ошибка. Собираться не должен: ожидаемые ошибки чекера —
-- expected/fixed-errors.txt, гоняет tests/run.sh (fixed-types).
--
-- invalid_fixed_types() / take(x) / make(flag) / Box Reading — материал для чекера
-- program() — вызывает invalid_fixed_types

use core.mem
use core.bits32
use core.u8
use core.u16
use core.u32
use core.i32
use core.address
use core.usize
use core.group

skill invalid_fixed_types() {
    @u8_too_large = u8.from(256)
    @u8_negative = u8.from(0 - 1)
    @u8_negative_literal = u8.from(-1)
    @u16_too_large = u16.from(65536)
    @u32_too_large = u32.from(4294967296)
    @usize_too_large = usize.from(4294967296)
    @i32_too_small = i32.from(0 - 2147483649)
    @i32_too_small_literal = i32.from(-2147483649)
    @i32_too_large = i32.from(2147483648)

    @byte = u8.from(1)
    byte = u16.from(1)

    @mixed_unsigned = u8.from(1) + u16.from(1)
    @mixed_signed = i32.from(1) + u32.from(1)
    @number_mixed = u32.from(1) + 1
    @bits_arithmetic = bits32.from(1) + bits32.from(1)

    @memory = address.from(u32.from(4096))
    @bad_address_add = memory + usize.from(1)
    mem.store8(memory, usize.from(0), u16.from(1))
    mem.store16(memory, usize.from(0), u32.from(1))
    mem.store32(memory, usize.from(0), i32.from(1))

    @bad_mask = bits32.and(bits32.from(1), u32.from(1))
    @bad_shift = bits32.shift_left(bits32.from(1), u16.from(1))

    @bad_group = [u8.from(1)]
    @unknown_partner = u32.from(1) + group.get(bad_group, 0)
    take(u32.from(1))
    take(1)

    out none
}

skill take(x) {
    out none
}

skill make(flag) {
    (flag == yes) { out u32.from(1) }
    out none
}

Reading = Box {
    total = u32.from(0)
}

program() {
    invalid_fixed_types()
    out none
}
