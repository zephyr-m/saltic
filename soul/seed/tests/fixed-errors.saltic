use seed

skill invalid_fixed_types() {
    @u8_too_large = u8(256)
    @u8_negative = u8(0 - 1)
    @u16_too_large = u16(65536)
    @u32_too_large = u32(4294967296)
    @i32_too_small = i32(0 - 2147483649)
    @i32_too_large = i32(2147483648)

    @byte = u8(1)
    byte = u16(1)

    @mixed_unsigned = u8(1) + u16(1)
    @mixed_signed = i32(1) + u32(1)
    @number_mixed = u32(1) + 1
    @bits_arithmetic = bits32(1) + bits32(1)

    @memory = address(u32(4096))
    @bad_address_add = memory + usize(1)
    seed.mem.store8(memory, usize(0), u16(1))
    seed.mem.store16(memory, usize(0), u32(1))
    seed.mem.store32(memory, usize(0), i32(1))

    @bad_mask = seed.bits32.and(bits32(1), u32(1))
    @bad_shift = seed.bits32.shift_left(bits32(1), u16(1))

    out none
}

program() {
    invalid_fixed_types()
    out none
}
