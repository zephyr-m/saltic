use seed
use seed.ast
use craft.testing
use seed.intrinsic
use seed.intrinsic.contract
use seed.parser
use seed.checker
use seed.memory.model
use seed.compiler.constants

StableConstant = [1]
CycleLeft = CycleRight
CycleRight = CycleLeft

FieldFirst = Box {
    shared = "первый"
    count = 1
}

FieldSecond = Box {
    other = 0
    extra = 0
    shared = "второй"
}

skill read_shared(item) {
    out item.shared
}

skill write_shared(item, value) {
    item.shared = value
    out item
}

skill read_missing(item) {
    out item.absent rescue |err| { "нет поля" }
}

skill first_above(values, limit) {
    @found = 0 - 1
    drum (values) {
        (beat > limit) {
            found = beat
            leave
        }
    }
    out found
}

skill beat_trace() {
    @trace = ""
    drum ([["a", "b"], ["c"]]) {
        @row = beat
        drum (row) {
            trace = seed.str.add(trace, beat)
            (beat == "a") { leave }
        }
        trace = seed.str.add(trace, seed.num.text(seed.group.count(beat)))
    }
    out trace
}

skill sign_of(x) {
    pick {
        (x < 0) { out "минус" }
        (x == 0) { out "ноль" }
        { out "плюс" }
    }
    out "недостижимо"
}

skill size_of(x) {
    @label = "?"
    pick {
        (x < 10) { label = "маленькое" }
        (x < 100) { label = "среднее" }
    }
    out label
}

skill pick_choice(suite) {
    suite = testing.test_equal(suite, "pick: первый вариант", sign_of(0 - 5), "минус")
    suite = testing.test_equal(suite, "pick: второй вариант", sign_of(0), "ноль")
    suite = testing.test_equal(suite, "pick: вариант по умолчанию", sign_of(7), "плюс")
    suite = testing.test_equal(suite, "pick: только первое совпадение", size_of(5), "маленькое")
    suite = testing.test_equal(suite, "pick: без совпадений ничего не делает", size_of(500), "?")
    @first_big = 0
    drum ([3, 15, 120, 400]) {
        pick {
            (beat > 100) {
                first_big = beat
                leave
            }
        }
    }
    suite = testing.test_equal(suite, "pick: leave изнутри выходит из drum", first_big, 120)
    out suite
}

skill drum_beat(suite) {
    @total = 0
    drum ([10, 20, 30]) { total = total + beat }
    suite = testing.test_equal(suite, "drum: beat — элемент группы", total, 60)
    @steps = 0
    drum (4) { steps = steps + beat }
    suite = testing.test_equal(suite, "drum: beat — номер шага", steps, 6)
    @empty = 0
    drum ([]) { empty = empty + 1 }
    suite = testing.test_equal(suite, "drum: пустая группа", empty, 0)
    suite = testing.test_equal(suite, "drum: leave выходит из цикла", first_above([3, 8, 12, 20], 7), 8)
    suite = testing.test_equal(suite, "drum: leave без совпадения", first_above([1, 2], 7), 0 - 1)
    suite = testing.test_equal(suite, "drum: вложенный leave и восстановление beat", beat_trace(), "a2c1")
    out suite
}

skill parse_errors(source) {
    @parsed = parser.parse_string_loc(source, "negative.case")
    out seed.group.count(parsed.diagnostics)
}

skill negative_literals(suite) {
    suite = testing.test_equal(suite, "минус: литерал равен 0 - N", -5, 0 - 5)
    suite = testing.test_equal(suite, "минус: вычитание отрицательного", 3 - -2, 5)
    suite = testing.test_equal(suite, "минус: умножение на отрицательный", 2 * -3, 0 - 6)
    suite = testing.test_equal(suite, "минус: слитный бинарный минус", 7 -2, 5)
    suite = testing.test_equal(suite, "минус: в группе", seed.group.item([1, -2], 1), 0 - 2)
    suite = testing.test_equal(suite, "минус: аргумент навыка", divide(-9, -4), 2)
    suite = testing.test_equal(suite, "минус: граница обычного числа", -268435455 + 268435455, 0)
    suite = testing.test_equal(suite, "минус: литерал разбирается", parse_errors("program() {\n    @x = -5\n    out none\n}\n"), 0)
    suite = testing.test_equal(suite, "минус: отдельный от цифры — ошибка", parse_errors("program() {\n    @x = - 5\n    out none\n}\n"), 1)
    suite = testing.test_equal(suite, "минус: перед именем — ошибка", parse_errors("program() {\n    @y = 1\n    @x = -y\n    out none\n}\n"), 1)
    out suite
}

skill divide(left, right) {
    out left / right
}

skill division(suite) {
    suite = testing.test_equal(suite, "деление: степень двойки", divide(100000, 256), 390)
    suite = testing.test_equal(suite, "деление: на единицу", divide(268435455, 1), 268435455)
    suite = testing.test_equal(suite, "деление: общее", divide(1000000, 3), 333333)
    suite = testing.test_equal(suite, "деление: большое на большое", divide(268435455, 268435455), 1)
    suite = testing.test_equal(suite, "деление: меньшее на большее", divide(5, 7), 0)
    suite = testing.test_equal(suite, "деление: отрицательное делимое", divide(0 - 7, 2), 0 - 3)
    suite = testing.test_equal(suite, "деление: отрицательный делитель", divide(7, 0 - 2), 0 - 3)
    suite = testing.test_equal(suite, "деление: оба отрицательные", divide(0 - 9, 0 - 4), 2)
    suite = testing.test_equal(suite, "деление: отрицательное на степень двойки", divide(0 - 1000, 8), 0 - 125)
    suite = testing.test_equal(suite, "деление: остаток", 1000003 - divide(1000003, 1000) * 1000, 3)
    @failed = divide(1, 0) rescue |err| { "ошибка" }
    suite = testing.test_equal(suite, "деление: на ноль", failed, "ошибка")
    out suite
}

skill field_positions(suite) {
    @first = FieldFirst {}
    @second = FieldSecond {}
    suite = testing.test_equal(suite, "поле: обычная позиция", read_shared(first), "первый")
    suite = testing.test_equal(suite, "поле: другая позиция", read_shared(second), "второй")
    suite = testing.test_equal(suite, "поле: запись в обычную позицию", read_shared(write_shared(first, "раз")), "раз")
    suite = testing.test_equal(suite, "поле: запись в другую позицию", read_shared(write_shared(second, "два")), "два")
    suite = testing.test_equal(suite, "поле: соседи не задеты", second.extra, 0)
    suite = testing.test_equal(suite, "поле: отсутствующее поле", read_missing(first), "нет поля")
    out suite
}

skill catalog(suite) {
    @names = [
        "seed.group.count", "seed.group.at", "seed.group.item", "seed.group.add", "seed.group.append",
        "seed.mem.load8", "seed.mem.load16", "seed.mem.load32",
        "seed.mem.store8", "seed.mem.store16", "seed.mem.store32", "seed.mem.store_address32",
        "seed.cpu.wait", "seed.cpu.fence", "seed.file.read", "seed.file.write", "seed.file.write_bytes",
        "seed.str.line_count", "seed.str.add", "seed.str.join", "seed.str.len",
        "seed.str.at", "seed.str.byte", "seed.str.slice", "seed.str.contains",
        "seed.str.starts_with", "seed.str.ends_with", "seed.str.lower", "seed.str.upper",
        "seed.num.text", "seed.io.show",
        "seed.u8.from", "seed.u16.from", "seed.u32.from", "seed.i32.from", "seed.usize.from",
        "seed.bits32.and", "seed.bits32.or", "seed.bits32.xor", "seed.bits32.not",
        "seed.bits32.shift_left", "seed.bits32.shift_right", "seed.address.add",
    ]
    @known = yes
    @typed = yes
    @runnable = yes
    @index = 0
    @count = seed.group.count(names)
    drum (count) {
        (index < count) {
            @name = seed.group.item(names, index)
            @kind = contract.find(name)
            (kind == intrinsic.Kind.UNKNOWN) { known = no }
            (contract.result(kind, "number") == "unknown") { typed = no }
            @target = contract.target(kind, "number")
            @special = contract.conversion(kind)
            (contract.is_show(kind) == yes) { special = "show" }
            (seed.str.len(target) == 0) {
                (seed.str.len(special) == 0) { runnable = no }
            }
            index = index + 1
        }
    }
    suite = testing.test_equal(suite, "seed: количество операций", count, 43)
    suite = testing.test_yes(suite, "seed: все операции известны", known)
    suite = testing.test_yes(suite, "seed: все результаты определены", typed)
    suite = testing.test_yes(suite, "seed: все операции исполнимы", runnable)
    out suite
}

skill phantom_operations(suite) {
    @names = [
        "seed.str.eq", "seed.str.is_empty", "seed.str.trim", "seed.str.split",
        "seed.num.parse", "seed.num.abs", "seed.num.min", "seed.num.max", "seed.num.round",
    ]
    @absent = yes
    @index = 0
    @count = seed.group.count(names)
    drum (count) {
        (index < count) {
            (contract.is_known(seed.group.item(names, index)) == yes) { absent = no }
            index = index + 1
        }
    }
    suite = testing.test_yes(suite, "seed: фантомные операции отсутствуют", absent)
    out suite
}

skill memory_types(suite) {
    suite = testing.test_equal(suite, "seed: load8 из address", contract.result(contract.find("seed.mem.load8"), "address"), "u8")
    suite = testing.test_equal(suite, "seed: load16 из address", contract.result(contract.find("seed.mem.load16"), "address"), "u16")
    suite = testing.test_equal(suite, "seed: load32 из address", contract.result(contract.find("seed.mem.load32"), "address"), "u32")
    suite = testing.test_equal(suite, "seed: load8 из number", contract.result(contract.find("seed.mem.load8"), "number"), "number")
    suite = testing.test_equal(suite, "seed: store8 в address", contract.store_type(contract.find("seed.mem.store8"), "address"), "u8")
    suite = testing.test_equal(suite, "seed: store16 в address", contract.store_type(contract.find("seed.mem.store16"), "address"), "u16")
    suite = testing.test_equal(suite, "seed: store32 в address", contract.store_type(contract.find("seed.mem.store32"), "address"), "u32")
    out suite
}

skill memory_model(suite) {
    @static_value = model.static(1)
    @managed_value = model.managed(1)
    suite = testing.test_equal(suite, "память: адрес содержит 32 бита", model.ADDRESS_BITS, 32)
    suite = testing.test_equal(suite, "память: размер адресного пространства конечен", model.ADDRESS_SPACE_BYTES_TEXT, "4294967296")
    suite = testing.test_yes(suite, "память: стандартная куча допустима", model.valid_capacity(model.DEFAULT_HEAP_BYTES))
    suite = testing.test_no(suite, "память: невыровненная куча запрещена", model.valid_capacity(model.DEFAULT_HEAP_BYTES + 1))
    suite = testing.test_yes(suite, "память: статическое значение корректно", model.valid(static_value))
    suite = testing.test_yes(suite, "память: статическое значение вечно", static_value.static)
    suite = testing.test_equal(suite, "память: размер payload сохранён", static_value.payload_bytes, 1)
    suite = testing.test_equal(suite, "память: полный размер выровнен", static_value.bytes, 16)
    suite = testing.test_yes(suite, "память: обычное значение корректно", model.valid(managed_value))
    suite = testing.test_no(suite, "память: обычное значение не вечно", managed_value.static)
    suite = testing.test_no(suite, "память: отрицательный payload запрещён", model.valid(model.managed(0 - 1)))
    suite = testing.test_yes(suite, "память: последний байт входит в область", model.contains(32, 31, 1))
    suite = testing.test_no(suite, "память: выход за область запрещён", model.contains(32, 31, 2))
    suite = testing.test_yes(suite, "память: размещение в остатке разрешено", model.can_allocate(32, 8, 1))
    suite = testing.test_no(suite, "память: размещение сверх остатка запрещено", model.can_allocate(32, 16, 9))
    suite = testing.test_equal(suite, "память: занятое место вычисляется точно", model.used_after(32, 0, 1), 16)
    suite = testing.test_equal(suite, "память: остаток вычисляется точно", model.remaining(32, 16), 16)
    suite = testing.test_yes(suite, "память: исчерпание распознаётся", model.is_exhausted(32, 16, 9))
    suite = testing.test_no(suite, "память: непустой остаток не исчерпан", model.is_exhausted(32, 8, 1))
    suite = testing.test_yes(suite, "const: составное значение вычисляется один раз", StableConstant == StableConstant)
    out suite
}

skill compiler_memory_layout(suite) {
    suite = testing.test_equal(suite, "компилятор: слово берётся из ABI", constants.WORD_BYTES, 4)
    suite = testing.test_equal(suite, "компилятор: выравнивание стека берётся из ABI", constants.STACK_ALIGNMENT, 16)
    suite = testing.test_equal(suite, "компилятор: размер кучи берётся из модели", constants.HEAP_BYTES, model.DEFAULT_HEAP_BYTES)
    suite = testing.test_equal(suite, "компилятор: два слова стека занимают 8 байт", constants.stack_bytes(2), 8)
    suite = testing.test_equal(suite, "компилятор: обратное смещение аргумента однозначно", constants.stack_source_offset(3, 0), 8)
    suite = testing.test_equal(suite, "компилятор: первый локал имеет одно смещение", constants.local_offset(0), 0 - 20)
    suite = testing.test_equal(suite, "компилятор: кадр выровнен", constants.frame_bytes(3), 32)
    suite = testing.test_equal(suite, "компилятор: метка региона в кадре", constants.region_mark_load_offset(), 0 - 12)
    suite = testing.test_equal(suite, "компилятор: начало побегов в кадре", constants.region_escape_load_offset(), 0 - 16)
    suite = testing.test_equal(suite, "компилятор: строковая раскладка конечна", constants.string_storage_bytes(1), 6)
    suite = testing.test_equal(suite, "компилятор: групповая раскладка конечна", constants.group_storage_bytes(2), 12)
    suite = testing.test_equal(suite, "компилятор: раскладка объекта конечна", constants.box_storage_bytes(2), 20)
    suite = testing.test_equal(suite, "компилятор: смещение значения поля однозначно", constants.box_field_value_offset(1), 16)
    suite = testing.test_yes(suite, "const: пустое состояние начинает вычисление", constants.can_begin(constants.STATE_EMPTY))
    suite = testing.test_yes(suite, "const: повторный вход распознаётся как цикл", constants.is_cycle(constants.STATE_INITIALIZING))
    suite = testing.test_yes(suite, "const: готовое состояние распознаётся", constants.is_ready(constants.STATE_READY))
    suite = testing.test_equal(suite, "const: имя хранилища безопасно", constants.value_label("demo.value"), "saltic_constant_value_demo_value")
    @cycle_caught = CycleLeft rescue |err| {
        yes
    }
    suite = testing.test_yes(suite, "const: цикл завершается явной ошибкой", cycle_caught)
    out suite
}

skill ast_contract(suite) {
    @path = ast.in_module("demo", ast.located(["path", "tool", "run"], 12, 34))
    @place = ast.location(path)
    suite = testing.test_equal(suite, "AST: имя модуля", ast.module_name(path), "demo")
    suite = testing.test_equal(suite, "AST: строка", seed.group.item(place, 0), 12)
    suite = testing.test_equal(suite, "AST: колонка", seed.group.item(place, 1), 34)
    suite = testing.test_equal(suite, "AST: тег узла", ast.tag(path), "path")
    suite = testing.test_equal(suite, "AST: часть узла", ast.part(path, 2), "run")
    suite = testing.test_equal(suite, "AST: полный путь", ast.path_text(path), "tool.run")
    suite = testing.test_equal(suite, "AST: префикс пути", ast.path_prefix(path), "tool")
    suite = testing.test_equal(suite, "AST: полное имя", ast.qualified("demo", "Skill"), "demo.Skill")
    suite = testing.test_equal(suite, "AST: ключ псевдонима", ast.alias_key("demo", "tool"), "demo|tool")
    suite = testing.test_equal(suite, "AST: голова имени", ast.name_head("tool.run"), "tool")
    suite = testing.test_equal(suite, "AST: хвост имени", ast.name_tail("tool.run"), ".run")
    suite = testing.test_equal(suite, "AST: модуль имени", ast.name_module("demo.tool.run"), "demo.tool")
    out suite
}

skill loader_modes(suite) {
    @loaded_file = parser.load_file("tests/fixtures/modules/main.saltic", ".")
    @loaded_modules = parser.load_modules("tests/fixtures/modules/main.saltic", ".")
    suite = testing.test_equal(suite, "загрузчик: load_file без ошибок", seed.group.count(loaded_file.diagnostics), 0)
    suite = testing.test_equal(suite, "загрузчик: load_modules без ошибок", seed.group.count(loaded_modules.diagnostics), 0)
    suite = testing.test_equal(suite, "загрузчик: одинаковый AST", seed.group.count(loaded_file.ast), seed.group.count(loaded_modules.ast))
    suite = testing.test_equal(suite, "загрузчик: только реальные файлы", seed.group.count(loaded_file.included), 2)
    out suite
}

skill checker_contract(suite) {
    @phantom_source = "use seed\nprogram() {\n    seed.str.trim(\"text\")\n    out none\n}\n"
    @phantom_ast = parser.parse_string_loc(phantom_source, "phantom.case")
    @phantom_checked = checker.check(phantom_ast.ast)
    suite = testing.test_equal(suite, "чекер: одна фантомная операция", seed.group.count(phantom_checked.diagnostics), 1)
    @phantom = seed.group.item(phantom_checked.diagnostics, 0)
    suite = testing.test_equal(suite, "чекер: код фантомной операции", phantom.code, "unknown_seed_operation")

    @memory_source = "use seed\nprogram() {\n    @memory = address(u32(4096))\n    @byte = seed.mem.load8(memory, usize(0))\n    byte = u16(1)\n    out none\n}\n"
    @memory_ast = parser.parse_string_loc(memory_source, "memory.case")
    @memory_checked = checker.check(memory_ast.ast)
    suite = testing.test_equal(suite, "чекер: одна ошибка типа памяти", seed.group.count(memory_checked.diagnostics), 1)
    @memory_error = seed.group.item(memory_checked.diagnostics, 0)
    suite = testing.test_equal(suite, "чекер: тип load8 согласован", memory_error.code, "type_mismatch")
    out suite
}

program() {
    @suite = testing.test_new()
    suite = catalog(suite)
    suite = phantom_operations(suite)
    suite = memory_types(suite)
    suite = memory_model(suite)
    suite = compiler_memory_layout(suite)
    suite = ast_contract(suite)
    suite = loader_modes(suite)
    suite = checker_contract(suite)
    suite = field_positions(suite)
    suite = division(suite)
    suite = negative_literals(suite)
    suite = drum_beat(suite)
    suite = pick_choice(suite)
    out testing.test_finish(suite)
}
