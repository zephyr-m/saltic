-- contract test — единый контракт ядра: каталог intrinsic, фантомные операции,
-- типы памяти и модель памяти, раскладка памяти компилятора, AST, режимы
-- загрузчика, чекер, позиции полей Box, деление, имена ошибок, методы
-- параметров, переполнение чисел, отрицательные литералы, "{шаблоны}",
-- drum/beat, pick, навыки core (bytes, graphics, crypto).
-- Набор на craft.testing; гоняет tests/run.sh (test_seed_contract).
--
-- catalog / phantom_operations / memory_types / memory_model /
--     compiler_memory_layout / ast_contract / loader_modes / checker_contract /
--     field_positions / division / error_names / parameter_methods /
--     number_overflow / negative_literals / templates / drum_beat /
--     pick_choice / core_skills(suite) -> suite
-- остальные навыки и Box (Walker, Sleeper, Pebble, FieldFirst…) — материал проверок
-- program() -> итог testing.test_finish

use core.str
use core.group
use core.num
use core.bytes
use core.graphics
use core.crypto
use selfhost.ast
use craft.testing
use selfhost.intrinsic
use selfhost.intrinsic.contract
use selfhost.parser
use selfhost.checker
use selfhost.memory.model
use selfhost.compiler.constants

StableConstant = [1]
CycleLeft = CycleRight
CycleRight = CycleLeft

TemplateSpot = Box {
    x = 5
}

FieldFirst = Box {
    shared = "первый",
    count = 1
}

FieldSecond = Box {
    other = 0,
    extra = 0,
    shared = "второй"
}


Walker = Box {
    steps = 2
    skill tired() { out steps > 5 }
}

Sleeper = Box {
    hours = 4
    skill tired() { out hours < 6 }
}

Pebble = Box {
    weight = 1
}

skill ask_tired(thing) {
    out thing.tired()
}

skill overflow_add(a, b) {
    @r = a + b rescue |err| { err }
    out r
}

skill overflow_sub(a, b) {
    @r = a - b rescue |err| { err }
    out r
}

skill overflow_mul(a, b) {
    @r = a * b rescue |err| { err }
    out r
}

skill overflow_div(a, b) {
    @r = a / b rescue |err| { err }
    out r
}

skill number_overflow(suite) {
    @max = 268435455
    @min = 0 - max - 1
    suite = testing.test_yes(suite, "переполнение: max + 1", overflow_add(max, 1) == error.NumberOverflow)
    suite = testing.test_equal(suite, "переполнение: max + 0 в пределах", overflow_add(max, 0), max)
    suite = testing.test_yes(suite, "переполнение: min - 1", overflow_sub(min, 1) == error.NumberOverflow)
    suite = testing.test_yes(suite, "переполнение: 0 - min", overflow_sub(0, min) == error.NumberOverflow)
    suite = testing.test_equal(suite, "переполнение: min + max в пределах", overflow_add(min, max), -1)
    suite = testing.test_yes(suite, "переполнение: max * 2", overflow_mul(max, 2) == error.NumberOverflow)
    suite = testing.test_yes(suite, "переполнение: 100000 * 100000", overflow_mul(100000, 100000) == error.NumberOverflow)
    suite = testing.test_yes(suite, "переполнение: 16384 * 16384", overflow_mul(16384, 16384) == error.NumberOverflow)
    suite = testing.test_equal(suite, "переполнение: 16384 * -16384 ровно min", overflow_mul(16384, -16384), min)
    suite = testing.test_yes(suite, "переполнение: min * -1", overflow_mul(min, -1) == error.NumberOverflow)
    suite = testing.test_equal(suite, "переполнение: min * 1 в пределах", overflow_mul(min, 1), min)
    suite = testing.test_equal(suite, "переполнение: -7 * 6", overflow_mul(-7, 6), -42)
    suite = testing.test_yes(suite, "переполнение: min / -1", overflow_div(min, -1) == error.NumberOverflow)
    suite = testing.test_equal(suite, "переполнение: min / 1 в пределах", overflow_div(min, 1), min)
    out suite
}

skill parameter_methods(suite) {
    suite = testing.test_equal(suite, "метод у параметра: первый Box", ask_tired(Walker {}), no)
    suite = testing.test_yes(suite, "метод у параметра: второй Box", ask_tired(Sleeper {}))
    suite = testing.test_yes(suite, "метод у параметра: поле меняет ответ", ask_tired(Walker { steps = 9 }))
    @mixed = [Walker { steps = 7 }, Sleeper { hours = 8 }]
    suite = testing.test_yes(suite, "метод у параметра: элемент группы", ask_tired(group.get(mixed, 0)))
    suite = testing.test_equal(suite, "метод у параметра: другой элемент", ask_tired(group.get(mixed, 1)), no)
    @plain = ask_tired(Pebble {}) rescue |err| { err }
    suite = testing.test_yes(suite, "метод у параметра: у Box нет метода", plain == error.NoMethod)
    @number = ask_tired(3) rescue |err| { err }
    suite = testing.test_yes(suite, "метод у параметра: у числа нет метода", number == error.NoMethod)
    @walker = Walker { steps = 3 }
    suite = testing.test_equal(suite, "Box: скрытый тип не мешает полям", walker.steps, 3)
    out suite
}

skill read_shared(item) {
    out item.shared
}

skill write_shared(item, value) {
    item.shared = value
    out item
}

skill read_missing(item) {
    out item.absent rescue |err| { "нет поля" }
}

skill first_above(values, limit) {
    @found = -1
    drum (values) {
        (beat > limit) {
            found = beat
            leave
        }
    }
    out found
}

skill beat_trace() {
    @trace = ""
    drum ([["a", "b"], ["c"]]) {
        @row = beat
        drum (row) {
            trace = str.concat(trace, beat)
            (beat == "a") { leave }
        }
        trace = str.concat(trace, num.text(group.count(beat)))
    }
    out trace
}

skill sign_of(x) {
    pick {
        (x < 0) { out "минус" }
        (x == 0) { out "ноль" }
        { out "плюс" }
    }
    out "недостижимо"
}

skill size_of(x) {
    @label = "?"
    pick {
        (x < 10) { label = "маленькое" }
        (x < 100) { label = "среднее" }
    }
    out label
}

skill pick_choice(suite) {
    suite = testing.test_equal(suite, "pick: первый вариант", sign_of(-5), "минус")
    suite = testing.test_equal(suite, "pick: второй вариант", sign_of(0), "ноль")
    suite = testing.test_equal(suite, "pick: вариант по умолчанию", sign_of(7), "плюс")
    suite = testing.test_equal(suite, "pick: только первое совпадение", size_of(5), "маленькое")
    suite = testing.test_equal(suite, "pick: без совпадений ничего не делает", size_of(500), "?")
    @first_big = 0
    drum ([3, 15, 120, 400]) {
        pick {
            (beat > 100) {
                first_big = beat
                leave
            }
        }
    }
    suite = testing.test_equal(suite, "pick: leave изнутри выходит из drum", first_big, 120)
    out suite
}

skill drum_beat(suite) {
    @total = 0
    drum ([10, 20, 30]) { total = total + beat }
    suite = testing.test_equal(suite, "drum: beat — элемент группы", total, 60)
    @steps = 0
    drum (4) { steps = steps + beat }
    suite = testing.test_equal(suite, "drum: beat — номер шага", steps, 6)
    @empty = 0
    drum ([]) { empty = empty + 1 }
    suite = testing.test_equal(suite, "drum: пустая группа", empty, 0)
    suite = testing.test_equal(suite, "drum: leave выходит из цикла", first_above([3, 8, 12, 20], 7), 8)
    suite = testing.test_equal(suite, "drum: leave без совпадения", first_above([1, 2], 7), -1)
    suite = testing.test_equal(suite, "drum: вложенный leave и восстановление beat", beat_trace(), "a2c1")
    out suite
}

skill parse_errors(source) {
    @parsed = parser.parse_string_loc(source, "negative.case")
    out group.count(parsed.diagnostics)
}

skill negative_literals(suite) {
    suite = testing.test_equal(suite, "минус: литерал равен 0 - N", -5, 0 - 5)
    suite = testing.test_equal(suite, "минус: вычитание отрицательного", 3 - -2, 5)
    suite = testing.test_equal(suite, "минус: умножение на отрицательный", 2 * -3, -6)
    suite = testing.test_equal(suite, "минус: слитный бинарный минус", 7 -2, 5)
    suite = testing.test_equal(suite, "минус: в группе", group.get([1, -2], 1), -2)
    suite = testing.test_equal(suite, "минус: аргумент навыка", divide(-9, -4), 2)
    suite = testing.test_equal(suite, "минус: граница обычного числа", -268435455 + 268435455, 0)
    suite = testing.test_equal(suite, "минус: литерал разбирается", parse_errors("program() \{\n    @x = -5\n    out none\n\}\n"), 0)
    suite = testing.test_equal(suite, "минус: отдельный от цифры — ошибка", parse_errors("program() \{\n    @x = - 5\n    out none\n\}\n"), 1)
    suite = testing.test_equal(suite, "минус: перед именем — ошибка", parse_errors("program() \{\n    @y = 1\n    @x = -y\n    out none\n\}\n"), 1)
    out suite
}

skill check_codes(source) {
    @parsed = parser.parse_string_loc(source, "template.case")
    @checked = checker.check(parsed.ast)
    @codes = ""
    drum (group.count(checked.diagnostics)) {
        @item = group.get(checked.diagnostics, beat)
        codes = str.concat(codes, item.code)
    }
    out codes
}

skill templates(suite) {
    @name = "мир"
    @count = 42
    @minus = -7
    @flag = yes
    @spot = TemplateSpot {}
    suite = testing.test_equal(suite, "подстановка: текст", "привет, {name}!", "привет, мир!")
    suite = testing.test_equal(suite, "подстановка: число", "{count} шт", "42 шт")
    suite = testing.test_equal(suite, "подстановка: отрицательное", "{minus}", "-7")
    suite = testing.test_equal(suite, "подстановка: yes", "флаг {flag}", "флаг yes")
    suite = testing.test_equal(suite, "подстановка: поле Box", "x={spot.x}", "x=5")
    suite = testing.test_equal(suite, "подстановка: несколько", "{name}{count}{name}", "мир42мир")
    @line = ""
    drum ([1, 2, 3]) { line = "{line}[{beat}]" }
    suite = testing.test_equal(suite, "подстановка: beat", line, "[1][2][3]")
    suite = testing.test_equal(suite, "подстановка: экранированные скобки", "\{name\}", "\{name\}")
    suite = testing.test_equal(suite, "подстановка: пустая — ошибка", parse_errors("program() \{\n    @x = \"\{\}\"\n    out none\n\}\n"), 1)
    suite = testing.test_equal(suite, "подстановка: выражение — ошибка", parse_errors("program() \{\n    @x = \"\{1 + 2\}\"\n    out none\n\}\n"), 1)
    suite = testing.test_equal(suite, "подстановка: одиночная скобка — ошибка", parse_errors("program() \{\n    @x = \"a \} b\"\n    out none\n\}\n"), 1)
    suite = testing.test_equal(suite, "подстановка: группа — ошибка типа", check_codes("program() \{\n    @items = [1]\n    @x = \"\{items\}\"\n    out none\n\}\n"), "template_type")
    suite = testing.test_equal(suite, "подстановка: неизвестное имя — ошибка", check_codes("program() \{\n    @x = \"\{missing\}\"\n    out none\n\}\n"), "unknown_name")
    out suite
}

skill count_down(count) {
    @steps = 0
    drum (count) { steps = steps + 1 }
    out steps
}

skill lookup_item(name) {
    (name == "lost") { out error.Missing }
    (name == "torn") { out error.Broken }
    out name
}

skill lookup_twice(name) {
    @first = lookup_item(name)
    out "{first}!"
}

skill lookup_relay(name) {
    @first = lookup_item(name) rescue |err| { out err }
    out first
}

skill lookup_nested(name) {
    out str.len(lookup_twice(name))
}

skill error_names(suite) {
    @missing = lookup_item("lost") rescue |err| { err }
    @broken = lookup_item("torn") rescue |err| { err }
    @negative = count_down(0 - 1) rescue |err| { err }
    suite = testing.test_yes(suite, "ошибка: равна своему имени", missing == error.Missing)
    suite = testing.test_equal(suite, "ошибка: разные ошибки различаются", missing == broken, no)
    suite = testing.test_equal(suite, "ошибка: не равна чужому имени", broken == error.Missing, no)
    suite = testing.test_yes(suite, "ошибка: значение error.X", error.Broken == broken)
    suite = testing.test_equal(suite, "ошибка: текст по имени", "{missing}", "Missing")
    suite = testing.test_equal(suite, "ошибка: системная по имени", "{negative}", "NegativeCount")
    suite = testing.test_yes(suite, "ошибка: системная равна своему имени", negative == error.NegativeCount)
    @lifted = lookup_twice("lost") rescue |err| { err }
    suite = testing.test_yes(suite, "ошибка: поднимается через присваивание", lifted == error.Missing)
    @relayed = lookup_relay("torn") rescue |err| { err }
    suite = testing.test_yes(suite, "ошибка: out err перебрасывает", relayed == error.Broken)
    @nested = lookup_nested("lost") rescue |err| { err }
    suite = testing.test_yes(suite, "ошибка: поднимается из аргумента", nested == error.Missing)
    suite = testing.test_equal(suite, "ошибка: без сбоя результат обычный", lookup_twice("ok"), "ok!")
    suite = testing.test_equal(suite, "ошибка: переброс без сбоя", lookup_relay("ok"), "ok")
    out suite
}

skill divide(left, right) {
    out left / right
}

skill division(suite) {
    suite = testing.test_equal(suite, "деление: степень двойки", divide(100000, 256), 390)
    suite = testing.test_equal(suite, "деление: на единицу", divide(268435455, 1), 268435455)
    suite = testing.test_equal(suite, "деление: общее", divide(1000000, 3), 333333)
    suite = testing.test_equal(suite, "деление: большое на большое", divide(268435455, 268435455), 1)
    suite = testing.test_equal(suite, "деление: меньшее на большее", divide(5, 7), 0)
    suite = testing.test_equal(suite, "деление: отрицательное делимое", divide(-7, 2), -3)
    suite = testing.test_equal(suite, "деление: отрицательный делитель", divide(7, -2), -3)
    suite = testing.test_equal(suite, "деление: оба отрицательные", divide(-9, -4), 2)
    suite = testing.test_equal(suite, "деление: отрицательное на степень двойки", divide(-1000, 8), -125)
    suite = testing.test_equal(suite, "деление: остаток", 1000003 - divide(1000003, 1000) * 1000, 3)
    @failed = divide(1, 0) rescue |err| { "ошибка" }
    suite = testing.test_equal(suite, "деление: на ноль", failed, "ошибка")
    @negative = count_down(0 - 2) rescue |err| { "ошибка" }
    suite = testing.test_equal(suite, "drum: отрицательный счёт — ошибка", negative, "ошибка")
    suite = testing.test_equal(suite, "drum: нулевой счёт — ни одного шага", count_down(0), 0)
    suite = testing.test_equal(suite, "drum: обычный счёт", count_down(3), 3)
    out suite
}

skill field_positions(suite) {
    @first = FieldFirst {}
    @second = FieldSecond {}
    suite = testing.test_equal(suite, "поле: обычная позиция", read_shared(first), "первый")
    suite = testing.test_equal(suite, "поле: другая позиция", read_shared(second), "второй")
    suite = testing.test_equal(suite, "поле: запись в обычную позицию", read_shared(write_shared(first, "раз")), "раз")
    suite = testing.test_equal(suite, "поле: запись в другую позицию", read_shared(write_shared(second, "два")), "два")
    suite = testing.test_equal(suite, "поле: соседи не задеты", second.extra, 0)
    suite = testing.test_equal(suite, "поле: отсутствующее поле", read_missing(first), "нет поля")
    out suite
}

skill catalog(suite) {
    @names = [
        "core.group.count", "core.group.get", "core.group.add",
        "core.mem.load8", "core.mem.load16", "core.mem.load32",
        "core.mem.store8", "core.mem.store16", "core.mem.store32", "core.mem.store_address32",
        "core.cpu.wait", "core.cpu.fence",
        "core.str.line_count", "core.str.concat", "core.str.len",
        "core.str.get", "core.str.byte", "core.str.slice", "core.str.contains",
        "core.str.starts_with", "core.str.ends_with", "core.str.lower", "core.str.upper",
        "core.num.text", "io.show", "io.key", "io.clear",
        "io.file.read", "io.file.write", "io.file.write_raw_bytes",
        "core.u8.from", "core.u16.from", "core.u32.from", "core.i32.from", "core.usize.from",
        "core.bits32.and", "core.bits32.or", "core.bits32.xor", "core.bits32.not",
        "core.bits32.shift_left", "core.bits32.shift_right", "core.address.add",
        "core.bytes.make", "core.bytes.count", "core.bytes.load", "core.bytes.store",
        "core.bytes.copy", "io.file.write_buffer", "io.file.read_bytes"
    ]
    @known = yes
    @typed = yes
    @runnable = yes
    @index = 0
    @count = group.count(names)
    drum (count) {
        (index < count) {
            @name = group.get(names, index)
            @kind = contract.find(name)
            (kind == intrinsic.Kind.UNKNOWN) { known = no }
            (contract.result(kind, "number") == "unknown") { typed = no }
            @target = contract.target(kind, "number")
            @special = contract.conversion(kind)
            (contract.is_show(kind) == yes) { special = "show" }
            (str.len(target) == 0) {
                (str.len(special) == 0) { runnable = no }
            }
            index = index + 1
        }
    }
    suite = testing.test_equal(suite, "seed: количество операций", count, 49)
    suite = testing.test_yes(suite, "seed: все операции известны", known)
    suite = testing.test_yes(suite, "seed: все результаты определены", typed)
    suite = testing.test_yes(suite, "seed: все операции исполнимы", runnable)
    out suite
}

skill phantom_operations(suite) {
    @names = [
        "core.str.eq", "core.str.is_empty", "core.str.trim", "core.str.split",
        "core.num.parse", "core.num.abs", "core.num.min", "core.num.max", "core.num.round",
        "core.group.at", "core.group.item", "core.group.append", "core.str.at", "core.str.join"
    ]
    @absent = yes
    @index = 0
    @count = group.count(names)
    drum (count) {
        (index < count) {
            (contract.is_known(group.get(names, index)) == yes) { absent = no }
            index = index + 1
        }
    }
    suite = testing.test_yes(suite, "seed: фантомные операции отсутствуют", absent)
    out suite
}

skill memory_types(suite) {
    suite = testing.test_equal(suite, "seed: load8 из address", contract.result(contract.find("core.mem.load8"), "address"), "u8")
    suite = testing.test_equal(suite, "seed: load16 из address", contract.result(contract.find("core.mem.load16"), "address"), "u16")
    suite = testing.test_equal(suite, "seed: load32 из address", contract.result(contract.find("core.mem.load32"), "address"), "u32")
    suite = testing.test_equal(suite, "seed: load8 из number", contract.result(contract.find("core.mem.load8"), "number"), "number")
    suite = testing.test_equal(suite, "seed: store8 в address", contract.store_type(contract.find("core.mem.store8"), "address"), "u8")
    suite = testing.test_equal(suite, "seed: store16 в address", contract.store_type(contract.find("core.mem.store16"), "address"), "u16")
    suite = testing.test_equal(suite, "seed: store32 в address", contract.store_type(contract.find("core.mem.store32"), "address"), "u32")
    out suite
}

skill memory_model(suite) {
    @static_value = model.static(1)
    @managed_value = model.managed(1)
    suite = testing.test_equal(suite, "память: адрес содержит 32 бита", model.ADDRESS_BITS, 32)
    suite = testing.test_equal(suite, "память: размер адресного пространства конечен", model.ADDRESS_SPACE_BYTES_TEXT, "4294967296")
    suite = testing.test_yes(suite, "память: стандартная куча допустима", model.valid_capacity(model.DEFAULT_HEAP_BYTES))
    suite = testing.test_no(suite, "память: невыровненная куча запрещена", model.valid_capacity(model.DEFAULT_HEAP_BYTES + 1))
    suite = testing.test_yes(suite, "память: статическое значение корректно", model.valid(static_value))
    suite = testing.test_yes(suite, "память: статическое значение вечно", static_value.static)
    suite = testing.test_equal(suite, "память: размер payload сохранён", static_value.payload_bytes, 1)
    suite = testing.test_equal(suite, "память: полный размер выровнен", static_value.bytes, 16)
    suite = testing.test_yes(suite, "память: обычное значение корректно", model.valid(managed_value))
    suite = testing.test_no(suite, "память: обычное значение не вечно", managed_value.static)
    suite = testing.test_no(suite, "память: отрицательный payload запрещён", model.valid(model.managed(-1)))
    suite = testing.test_yes(suite, "память: последний байт входит в область", model.contains(32, 31, 1))
    suite = testing.test_no(suite, "память: выход за область запрещён", model.contains(32, 31, 2))
    suite = testing.test_yes(suite, "память: размещение в остатке разрешено", model.can_allocate(32, 8, 1))
    suite = testing.test_no(suite, "память: размещение сверх остатка запрещено", model.can_allocate(32, 16, 9))
    suite = testing.test_equal(suite, "память: занятое место вычисляется точно", model.used_after(32, 0, 1), 16)
    suite = testing.test_equal(suite, "память: остаток вычисляется точно", model.remaining(32, 16), 16)
    suite = testing.test_yes(suite, "память: исчерпание распознаётся", model.is_exhausted(32, 16, 9))
    suite = testing.test_no(suite, "память: непустой остаток не исчерпан", model.is_exhausted(32, 8, 1))
    suite = testing.test_yes(suite, "const: составное значение вычисляется один раз", StableConstant == StableConstant)
    out suite
}

skill compiler_memory_layout(suite) {
    suite = testing.test_equal(suite, "компилятор: слово берётся из ABI", constants.WORD_BYTES, 4)
    suite = testing.test_equal(suite, "компилятор: выравнивание стека берётся из ABI", constants.STACK_ALIGNMENT, 16)
    suite = testing.test_equal(suite, "компилятор: размер кучи берётся из модели", constants.HEAP_BYTES, model.DEFAULT_HEAP_BYTES)
    suite = testing.test_equal(suite, "компилятор: два слова стека занимают 8 байт", constants.stack_bytes(2), 8)
    suite = testing.test_equal(suite, "компилятор: обратное смещение аргумента однозначно", constants.stack_source_offset(3, 0), 8)
    suite = testing.test_equal(suite, "компилятор: первый локал имеет одно смещение", constants.local_offset(0), -20)
    suite = testing.test_equal(suite, "компилятор: кадр выровнен", constants.frame_bytes(3), 32)
    suite = testing.test_equal(suite, "компилятор: метка региона в кадре", constants.region_mark_load_offset(), -12)
    suite = testing.test_equal(suite, "компилятор: начало побегов в кадре", constants.region_escape_load_offset(), -16)
    suite = testing.test_equal(suite, "компилятор: строковая раскладка конечна", constants.string_storage_bytes(1), 6)
    suite = testing.test_equal(suite, "компилятор: групповая раскладка конечна", constants.group_storage_bytes(2), 12)
    suite = testing.test_equal(suite, "компилятор: раскладка объекта конечна", constants.box_storage_bytes(2), 20)
    suite = testing.test_equal(suite, "компилятор: смещение значения поля однозначно", constants.box_field_value_offset(1), 16)
    suite = testing.test_yes(suite, "const: пустое состояние начинает вычисление", constants.can_begin(constants.STATE_EMPTY))
    suite = testing.test_yes(suite, "const: повторный вход распознаётся как цикл", constants.is_cycle(constants.STATE_INITIALIZING))
    suite = testing.test_yes(suite, "const: готовое состояние распознаётся", constants.is_ready(constants.STATE_READY))
    suite = testing.test_equal(suite, "const: имя хранилища безопасно", constants.value_label("demo.value"), "saltic_constant_value_demo_value")
    @cycle_caught = CycleLeft rescue |err| {
        yes
    }
    suite = testing.test_yes(suite, "const: цикл завершается явной ошибкой", cycle_caught)
    out suite
}

skill ast_contract(suite) {
    @path = ast.in_module("demo", ast.located(["path", "tool", "run"], 12, 34))
    @place = ast.location(path)
    suite = testing.test_equal(suite, "AST: имя модуля", ast.module_name(path), "demo")
    suite = testing.test_equal(suite, "AST: строка", group.get(place, 0), 12)
    suite = testing.test_equal(suite, "AST: колонка", group.get(place, 1), 34)
    suite = testing.test_equal(suite, "AST: тег узла", ast.tag(path), "path")
    suite = testing.test_equal(suite, "AST: часть узла", ast.part(path, 2), "run")
    suite = testing.test_equal(suite, "AST: полный путь", ast.path_text(path), "tool.run")
    suite = testing.test_equal(suite, "AST: префикс пути", ast.path_prefix(path), "tool")
    suite = testing.test_equal(suite, "AST: полное имя", ast.qualified("demo", "Skill"), "demo.Skill")
    suite = testing.test_equal(suite, "AST: ключ псевдонима", ast.alias_key("demo", "tool"), "demo|tool")
    suite = testing.test_equal(suite, "AST: голова имени", ast.name_head("tool.run"), "tool")
    suite = testing.test_equal(suite, "AST: хвост имени", ast.name_tail("tool.run"), ".run")
    suite = testing.test_equal(suite, "AST: модуль имени", ast.name_module("demo.tool.run"), "demo.tool")
    out suite
}

skill loader_modes(suite) {
    @loaded_file = parser.load_file("tests/fixtures/modules/main.saltic", ".")
    @loaded_modules = parser.load_modules("tests/fixtures/modules/main.saltic", ".")
    suite = testing.test_equal(suite, "загрузчик: load_file без ошибок", group.count(loaded_file.diagnostics), 0)
    suite = testing.test_equal(suite, "загрузчик: load_modules без ошибок", group.count(loaded_modules.diagnostics), 0)
    suite = testing.test_equal(suite, "загрузчик: одинаковый AST", group.count(loaded_file.ast), group.count(loaded_modules.ast))
    suite = testing.test_equal(suite, "загрузчик: только реальные файлы", group.count(loaded_file.included), 6)
    out suite
}

skill checker_contract(suite) {
    @phantom_source = "use core.str\nprogram() \{\n    str.trim(\"text\")\n    out none\n\}\n"
    @phantom_ast = parser.parse_string_loc(phantom_source, "phantom.case")
    @phantom_checked = checker.check(phantom_ast.ast)
    suite = testing.test_equal(suite, "чекер: одна фантомная операция", group.count(phantom_checked.diagnostics), 1)
    @phantom = group.get(phantom_checked.diagnostics, 0)
    suite = testing.test_equal(suite, "чекер: код фантомной операции", phantom.code, "unknown_name")

    @memory_loaded = parser.load_modules("tests/fixtures/memory-type.saltic", ".")
    @memory_checked = checker.check(memory_loaded.ast)
    suite = testing.test_equal(suite, "чекер: одна ошибка типа памяти", group.count(memory_checked.diagnostics), 1)
    @memory_error = group.get(memory_checked.diagnostics, 0)
    suite = testing.test_equal(suite, "чекер: тип load8 согласован", memory_error.code, "type_mismatch")
    out suite
}

skill core_skills(suite) {
    suite = testing.test_equal(suite, "bytes: u16 little-endian", bytes.read_u16("xAB", 1), 16961)
    suite = testing.test_equal(suite, "graphics: rgb", graphics.rgb(250, 244, 232), 16446696)
    suite = testing.test_yes(suite, "crypto: равные строки", crypto.equal("secret", "secret"))
    suite = testing.test_no(suite, "crypto: другая буква", crypto.equal("secret", "secreT"))
    suite = testing.test_no(suite, "crypto: другая длина", crypto.equal("secret", "secre"))
    suite = testing.test_yes(suite, "group: contains находит элемент", group.contains(["a", "b"], "b"))
    suite = testing.test_no(suite, "group: contains не находит чужой", group.contains(["a", "b"], "c"))
    suite = testing.test_equal(suite, "num: hex_digit", num.hex_digit(11), "b")
    suite = testing.test_equal(suite, "num: hex_value", num.hex_value("F"), 15)
    suite = testing.test_equal(suite, "num: hex_value не цифра", num.hex_value("g"), -1)
    suite = testing.test_equal(suite, "str: join склеивает через разделитель", str.join(["core", "str", "add"], "."), "core.str.add")
    suite = testing.test_equal(suite, "str: join пустой группы", str.join([], "."), "")
    suite = testing.test_equal(suite, "group: slice", str.join(group.slice(["a", "b", "c", "d"], 1, 3), ""), "bc")
    suite = testing.test_equal(suite, "group: concat", str.join(group.concat(["a"], ["b", "c"]), ""), "abc")
    out suite
}

program() {
    @suite = testing.test_new()
    suite = catalog(suite)
    suite = phantom_operations(suite)
    suite = memory_types(suite)
    suite = memory_model(suite)
    suite = compiler_memory_layout(suite)
    suite = ast_contract(suite)
    suite = loader_modes(suite)
    suite = checker_contract(suite)
    suite = field_positions(suite)
    suite = division(suite)
    suite = error_names(suite)
    suite = parameter_methods(suite)
    suite = number_overflow(suite)
    suite = negative_literals(suite)
    suite = templates(suite)
    suite = drum_beat(suite)
    suite = pick_choice(suite)
    suite = core_skills(suite)
    out testing.test_finish(suite)
}
