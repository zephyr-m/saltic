-- contract — единый контракт ядра, вход папки contract/ (решение автора
-- 21.11.2026: тест-файл — тоже субъекты по темам, а не ужатый ком).
-- Каждый ребёнок — субъект с prove(suite) -> suite: assembly (intrinsic,
-- AST, архитектор, чекер), memory (типы, модель, раскладка, константы),
-- boxes (позиции полей, метод у параметра), counting (переполнение, минус,
-- деление), mistakes (ошибки-значения), flow (pick, drum, подстановка),
-- basics (навыки core); sample — пробный разбор для counting и flow.
-- Набор на craft.testing; гоняет tests/run.sh (test_seed_contract).
--
-- program() -> итог testing.test_finish

use craft.testing
use seed.tests.contract.assembly
use seed.tests.contract.memory
use seed.tests.contract.boxes
use seed.tests.contract.counting
use seed.tests.contract.mistakes
use seed.tests.contract.flow
use seed.tests.contract.basics

program() {
    @suite = testing.test_new()
    @themes = [
        Assembly {},
        Memory {},
        Boxes {},
        Counting {},
        Mistakes {},
        Flow {},
        Basics {}
    ]
    drum (themes) {
        suite = beat.prove(suite)
    }
    out testing.test_finish(suite)
}
