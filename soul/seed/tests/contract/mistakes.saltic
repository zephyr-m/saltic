-- mistakes — контракт ошибок-значений: error.Имя равна себе и не равна чужой,
-- текст по имени, системная NegativeCount, подъём через присваивание и
-- аргумент, переброс out err, обычный результат без сбоя.
--
-- Mistakes = Box { steps } — ход программы (Flow) для системной ошибки:
--     prove(suite) -> suite — все проверки ошибок
--     lookup(name) -> имя или error.Missing / error.Broken; twice(name) —
--         подъём через присваивание; relay(name) — out err; nested(name) —
--         подъём из аргумента

use core.str
use craft.testing
use seed.tests.contract.flow

Mistakes = Box {
    steps = Flow {}

    skill lookup(name) {
        (name == "lost") {
            out error.Missing
        }
        (name == "torn") {
            out error.Broken
        }
        out name
    }

    skill twice(name) {
        @first = lookup(name)
        out "{first}!"
    }

    skill relay(name) {
        @first = lookup(name) rescue |err| {
            out err
        }
        out first
    }

    skill nested(name) {
        out str.bytes(twice(name))
    }

    skill prove(suite) {
        @missing = lookup("lost") rescue |err| { err }
        @broken = lookup("torn") rescue |err| { err }
        @negative = steps.count_down(-1) rescue |err| { err }
        suite = testing.test_yes(suite, "ошибка: равна своему имени", (missing == error.Missing))
        suite = testing.test_equal(suite, "ошибка: разные ошибки различаются", (missing == broken), no)
        suite = testing.test_equal(suite, "ошибка: не равна чужому имени", (broken == error.Missing), no)
        suite = testing.test_yes(suite, "ошибка: значение error.X", (error.Broken == broken))
        suite = testing.test_equal(suite, "ошибка: текст по имени", "{missing}", "Missing")
        suite = testing.test_equal(suite, "ошибка: системная по имени", "{negative}", "NegativeCount")
        suite = testing.test_yes(suite, "ошибка: системная равна своему имени", (negative == error.NegativeCount))
        @lifted = twice("lost") rescue |err| { err }
        suite = testing.test_yes(suite, "ошибка: поднимается через присваивание", (lifted == error.Missing))
        @relayed = relay("torn") rescue |err| { err }
        suite = testing.test_yes(suite, "ошибка: out err перебрасывает", (relayed == error.Broken))
        @inner = nested("lost") rescue |err| { err }
        suite = testing.test_yes(suite, "ошибка: поднимается из аргумента", (inner == error.Missing))
        suite = testing.test_equal(suite, "ошибка: без сбоя результат обычный", twice("ok"), "ok!")
        suite = testing.test_equal(suite, "ошибка: переброс без сбоя", relay("ok"), "ok")
        out suite
    }
}
