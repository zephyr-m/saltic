use seed
use craft.testing
use seed.abi

skill value_tags(suite) {
    suite = testing.test_equal(suite, "ABI: сдвиг тега", abi.TAG_SHIFT, 3)
    suite = testing.test_equal(suite, "ABI: масштаб значения", abi.TAG_SCALE, 8)
    suite = testing.test_equal(suite, "ABI: маска тега", abi.TAG_MASK, 7)
    suite = testing.test_equal(suite, "ABI: тег числа", abi.TAG_NUMBER, 0)
    suite = testing.test_equal(suite, "ABI: тег ответа", abi.TAG_ANSWER, 1)
    suite = testing.test_equal(suite, "ABI: тег пустоты", abi.TAG_NONE, 2)
    suite = testing.test_equal(suite, "ABI: тег строки", abi.TAG_STRING, 3)
    suite = testing.test_equal(suite, "ABI: тег группы", abi.TAG_GROUP, 4)
    suite = testing.test_equal(suite, "ABI: тег объекта", abi.TAG_BOX, 5)
    suite = testing.test_equal(suite, "ABI: тег перечисления", abi.TAG_ENUM, 6)
    suite = testing.test_equal(suite, "ABI: тег ошибки", abi.TAG_ERROR, 7)
    suite = testing.test_equal(suite, "ABI: значение нет", abi.NO, 1)
    suite = testing.test_equal(suite, "ABI: значение да", abi.YES, 9)
    suite = testing.test_equal(suite, "ABI: значение пустоты", abi.NONE, 2)
    suite = testing.test_equal(suite, "ABI: упаковка", abi.tagged(42, abi.TAG_ENUM), 342)
    suite = testing.test_equal(suite, "ABI: распаковка номера", abi.id(342), 42)
    suite = testing.test_equal(suite, "ABI: распаковка тега", abi.tag(342), abi.TAG_ENUM)
    suite = testing.test_equal(suite, "ABI: payload совпадает с номером", abi.payload(342), 42)
    suite = testing.test_equal(suite, "ABI: отрицательный payload сохраняется", abi.payload(abi.tagged(0 - 1, abi.TAG_NUMBER)), 0 - 1)
    suite = testing.test_yes(suite, "ABI: последний тег допустим", abi.valid_tag(abi.TAG_ERROR))
    suite = testing.test_no(suite, "ABI: тег за диапазоном запрещён", abi.valid_tag(8))
    suite = testing.test_equal(suite, "ABI: неверный тег даёт пустоту", abi.tagged(1, 8), abi.NONE)
    out suite
}

skill error_space(suite) {
    suite = testing.test_equal(suite, "ABI: первая системная ошибка", abi.SYSTEM_ERROR_FIRST, 1)
    suite = testing.test_equal(suite, "ABI: последняя системная ошибка", abi.SYSTEM_ERROR_LAST, 7)
    suite = testing.test_equal(suite, "ABI: первая пользовательская ошибка", abi.USER_ERROR_FIRST, 8)
    suite = testing.test_equal(suite, "ABI: переполнение сохраняет значение", abi.error_value(abi.ERROR_FIXED_INTEGER_OVERFLOW), 55)
    suite = testing.test_equal(suite, "ABI: первая пользовательская ошибка упакована", abi.user_error_value(0), 71)
    suite = testing.test_yes(suite, "ABI: системный диапазон распознаётся", abi.is_system_error(abi.ERROR_FIXED_INTEGER_OVERFLOW))
    suite = testing.test_no(suite, "ABI: пользовательская ошибка не системная", abi.is_system_error(abi.USER_ERROR_FIRST))
    suite = testing.test_yes(suite, "ABI: пользовательский диапазон распознаётся", abi.is_user_error(abi.USER_ERROR_FIRST))
    suite = testing.test_no(suite, "ABI: системная ошибка не пользовательская", abi.is_user_error(abi.SYSTEM_ERROR_LAST))
    suite = testing.test_equal(suite, "ABI: отсутствие ошибки равно нулю", abi.ERROR_NONE, 0)
    suite = testing.test_equal(suite, "ABI: цикл константы закреплён", abi.ERROR_CONSTANT_CYCLE, 7)
    suite = testing.test_equal(suite, "ABI: максимум ошибки зафиксирован текстом", abi.ERROR_MAXIMUM_TEXT, "268435455")
    suite = testing.test_no(suite, "ABI: нулевая ошибка не является ошибкой", abi.valid_error_id(abi.ERROR_NONE))
    suite = testing.test_equal(suite, "ABI: отрицательный индекс пользователя запрещён", abi.user_error_id(0 - 1), abi.ERROR_NONE)
    suite = testing.test_equal(suite, "ABI: неверная ошибка не упаковывается", abi.error_value(abi.ERROR_NONE), abi.NONE)
    out suite
}

skill fixed_types(suite) {
    suite = testing.test_equal(suite, "ABI: вид u8", abi.fixed_type_kind("u8"), 1)
    suite = testing.test_equal(suite, "ABI: вид u16", abi.fixed_type_kind("u16"), 2)
    suite = testing.test_equal(suite, "ABI: вид u32", abi.fixed_type_kind("u32"), 3)
    suite = testing.test_equal(suite, "ABI: вид i32", abi.fixed_type_kind("i32"), 4)
    suite = testing.test_equal(suite, "ABI: вид bits32", abi.fixed_type_kind("bits32"), 5)
    suite = testing.test_equal(suite, "ABI: вид address", abi.fixed_type_kind("address"), 6)
    suite = testing.test_equal(suite, "ABI: вид usize", abi.fixed_type_kind("usize"), 7)
    suite = testing.test_equal(suite, "ABI: неизвестный fixed не становится usize", abi.fixed_type_kind("string"), abi.FIXED_UNKNOWN)
    suite = testing.test_equal(suite, "ABI: вид fixed возвращает имя", abi.fixed_kind_type(abi.FIXED_ADDRESS), "address")
    suite = testing.test_yes(suite, "ABI: известный вид fixed допустим", abi.valid_fixed_kind(abi.FIXED_U16))
    suite = testing.test_no(suite, "ABI: нулевой вид fixed запрещён", abi.valid_fixed_kind(abi.FIXED_UNKNOWN))
    suite = testing.test_equal(suite, "ABI: ширина u8 равна восьми битам", abi.fixed_type_width_bits("u8"), 8)
    suite = testing.test_equal(suite, "ABI: ширина address равна слову", abi.fixed_type_width_bits("address"), 32)
    suite = testing.test_yes(suite, "ABI: i32 является знаковым", abi.fixed_type_is_signed("i32"))
    suite = testing.test_no(suite, "ABI: u32 является беззнаковым", abi.fixed_type_is_signed("u32"))
    suite = testing.test_yes(suite, "ABI: фиксированный тип известен", abi.is_fixed_type("address"))
    suite = testing.test_no(suite, "ABI: посторонний тип неизвестен", abi.is_fixed_type("string"))
    suite = testing.test_yes(suite, "ABI: u8 принимает 255", abi.fixed_type_in_range("u8", "255"))
    suite = testing.test_no(suite, "ABI: u8 отвергает 256", abi.fixed_type_in_range("u8", "256"))
    suite = testing.test_yes(suite, "ABI: i32 принимает минимум", abi.fixed_type_in_range("i32", "-2147483648"))
    suite = testing.test_no(suite, "ABI: i32 отвергает переполнение", abi.fixed_type_in_range("i32", "-2147483649"))
    suite = testing.test_yes(suite, "ABI: address принимает максимум", abi.fixed_type_in_range("address", "4294967295"))
    suite = testing.test_no(suite, "ABI: address отвергает переполнение", abi.fixed_type_in_range("address", "4294967296"))
    suite = testing.test_no(suite, "ABI: fixed отвергает пустой текст", abi.fixed_type_in_range("u8", ""))
    suite = testing.test_no(suite, "ABI: fixed отвергает посторонний символ", abi.fixed_type_in_range("u8", "2x"))
    suite = testing.test_equal(suite, "ABI: неизвестный fixed не имеет диапазона", abi.fixed_type_range_text("string"), "")
    out suite
}

skill value_contract(suite) {
    suite = testing.test_equal(suite, "ABI: машинное слово содержит 32 бита", abi.VALUE_WORD_BITS, 32)
    suite = testing.test_equal(suite, "ABI: машинное слово содержит 4 байта", abi.VALUE_WORD_BYTES, 4)
    suite = testing.test_equal(suite, "ABI: фиксированное значение хранится сырым", abi.representation("u32"), abi.VALUE_REPRESENTATION_RAW)
    suite = testing.test_equal(suite, "ABI: строка хранится с тегом", abi.representation("string"), abi.VALUE_REPRESENTATION_TAGGED)
    suite = testing.test_equal(suite, "ABI: неизвестное представление явно неизвестно", abi.representation("mystery"), abi.VALUE_REPRESENTATION_UNKNOWN)
    suite = testing.test_equal(suite, "ABI: raw-тип берётся из сигнатуры", abi.type_source("u32"), abi.VALUE_TYPE_SOURCE_SIGNATURE)
    suite = testing.test_equal(suite, "ABI: tagged-тип берётся из тега", abi.type_source("string"), abi.VALUE_TYPE_SOURCE_TAG)
    suite = testing.test_equal(suite, "ABI: неизвестный тип не имеет источника", abi.type_source("mystery"), abi.VALUE_TYPE_SOURCE_UNKNOWN)
    suite = testing.test_yes(suite, "ABI: raw-тип является допустимым значением", abi.valid_value_type("u32"))
    suite = testing.test_no(suite, "ABI: посторонний тип не является значением", abi.valid_value_type("mystery"))
    suite = testing.test_equal(suite, "ABI: тип строки определяет тег", abi.tag_for_type("string"), abi.TAG_STRING)
    suite = testing.test_equal(suite, "ABI: тег перечисления определяет тип", abi.type_for_tag(abi.TAG_ENUM), "enum:unknown")
    suite = testing.test_equal(suite, "ABI: минимум обычного числа зафиксирован", abi.NUMBER_MINIMUM_TEXT, "-268435456")
    suite = testing.test_equal(suite, "ABI: максимум обычного числа зафиксирован", abi.NUMBER_MAXIMUM_TEXT, "268435455")
    out suite
}

skill call_contract(suite) {
    suite = testing.test_equal(suite, "ABI: доступно восемь аргументов", abi.CALL_ARGUMENT_LIMIT, 8)
    suite = testing.test_equal(suite, "ABI: первый аргумент получает регистр 10", abi.argument_register(0), 10)
    suite = testing.test_equal(suite, "ABI: восьмой аргумент получает регистр 17", abi.argument_register(7), 17)
    suite = testing.test_equal(suite, "ABI: девятого регистра аргумента нет", abi.argument_register(8), 0 - 1)
    suite = testing.test_equal(suite, "ABI: отрицательного регистра аргумента нет", abi.argument_register(0 - 1), 0 - 1)
    suite = testing.test_yes(suite, "ABI: восемь аргументов допустимы", abi.valid_argument_count(8))
    suite = testing.test_no(suite, "ABI: девять аргументов запрещены", abi.valid_argument_count(9))
    suite = testing.test_equal(suite, "ABI: кадр выравнивается до 16 байт", abi.frame_bytes(1, 1), 16)
    suite = testing.test_equal(suite, "ABI: отрицательный кадр запрещён", abi.frame_bytes(0 - 1, 1), 0 - 1)
    suite = testing.test_equal(suite, "ABI: значение возвращается отдельно", abi.CALL_RETURN_VALUE_REGISTER, 10)
    suite = testing.test_equal(suite, "ABI: ошибка возвращается отдельно", abi.CALL_RETURN_ERROR_REGISTER, 11)
    suite = testing.test_equal(suite, "ABI: успешный вызов возвращает нулевую ошибку", abi.CALL_NO_ERROR, 0)
    suite = testing.test_equal(suite, "ABI: тип raw-вызова задаёт сигнатура", abi.CALL_RAW_TYPE_SOURCE, abi.VALUE_TYPE_SOURCE_SIGNATURE)
    suite = testing.test_equal(suite, "ABI: ошибка вызова является сырым id", abi.CALL_ERROR_REPRESENTATION_RAW_ID, 1)
    suite = testing.test_equal(suite, "ABI: аргумент u32 передаётся сырым", abi.argument_value_representation("u32"), abi.VALUE_REPRESENTATION_RAW)
    suite = testing.test_equal(suite, "ABI: аргумент string передаётся tagged", abi.argument_value_representation("string"), abi.VALUE_REPRESENTATION_TAGGED)
    @success = abi.success_result(42, "u32")
    suite = testing.test_no(suite, "ABI: успешный результат не является ошибкой", abi.result_failed(success))
    suite = testing.test_yes(suite, "ABI: успешный raw-результат согласован", abi.valid_call_result(success))
    @failure = abi.failure_result(abi.ERROR_FILE)
    suite = testing.test_yes(suite, "ABI: ошибочный результат распознаётся", abi.result_failed(failure))
    suite = testing.test_yes(suite, "ABI: отдельная ошибка вызова согласована", abi.valid_call_result(failure))
    suite = testing.test_no(suite, "ABI: неизвестный тип вызова запрещён", abi.valid_call_type("mystery"))
    out suite
}

skill object_contract(suite) {
    suite = testing.test_equal(suite, "ABI: объект выровнен по 8 байтам", abi.OBJECT_ALIGNMENT, 8)
    suite = testing.test_equal(suite, "ABI: заголовок объекта занимает 12 байт", abi.OBJECT_HEADER_BYTES, 12)
    suite = testing.test_equal(suite, "ABI: kind лежит в начале заголовка", abi.OBJECT_HEADER_KIND_OFFSET, 0)
    suite = testing.test_equal(suite, "ABI: размер payload лежит после kind", abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET, 4)
    suite = testing.test_equal(suite, "ABI: flags лежат после размера", abi.OBJECT_HEADER_FLAGS_OFFSET, 8)
    suite = testing.test_equal(suite, "ABI: payload начинается после заголовка", abi.OBJECT_PAYLOAD_OFFSET, 12)
    suite = testing.test_equal(suite, "ABI: пустой объект занимает заголовок", abi.allocation_size(0), 16)
    suite = testing.test_equal(suite, "ABI: полезная нагрузка выравнивается", abi.allocation_size(1), 16)
    suite = testing.test_equal(suite, "ABI: отрицательный payload запрещён", abi.allocation_size(0 - 1), 0 - 1)
    suite = testing.test_yes(suite, "ABI: строка является известным объектом", abi.valid_object_kind(abi.OBJECT_KIND_STRING))
    suite = testing.test_yes(suite, "ABI: группа является известным объектом", abi.valid_object_kind(abi.OBJECT_KIND_GROUP))
    suite = testing.test_yes(suite, "ABI: Box является известным объектом", abi.valid_object_kind(abi.OBJECT_KIND_BOX))
    suite = testing.test_no(suite, "ABI: неизвестный вид объекта запрещён", abi.valid_object_kind(99))
    suite = testing.test_yes(suite, "ABI: статический объект распознаётся", abi.has_object_flag(abi.OBJECT_FLAG_STATIC, abi.OBJECT_FLAG_STATIC))
    suite = testing.test_yes(suite, "ABI: единственный флаг допустим", abi.valid_object_flags(abi.OBJECT_FLAGS_MASK))
    suite = testing.test_no(suite, "ABI: посторонний flag запрещён", abi.valid_object_flags(4))
    suite = testing.test_no(suite, "ABI: нулевой искомый flag безопасно отвергается", abi.has_object_flag(abi.OBJECT_FLAGS_NONE, abi.OBJECT_FLAGS_NONE))
    out suite
}

skill assembly_contract(suite) {
    @source = abi.assembly()
    suite = testing.test_yes(suite, "ABI: runtime получает маску тега", seed.str.contains(source, ".set SALTIC_ABI_TAG_MASK, 7"))
    suite = testing.test_yes(suite, "ABI: runtime получает тег ошибки", seed.str.contains(source, ".set SALTIC_ABI_TAG_ERROR, 7"))
    suite = testing.test_yes(suite, "ABI: runtime получает системную ошибку", seed.str.contains(source, ".set SALTIC_ABI_ERROR_FIXED_INTEGER_OVERFLOW, 55"))
    suite = testing.test_yes(suite, "ABI: runtime получает начало пользовательских ошибок", seed.str.contains(source, ".set SALTIC_ABI_USER_ERROR_FIRST, 8"))
    suite = testing.test_yes(suite, "ABI: runtime получает вид i32", seed.str.contains(source, ".set SALTIC_ABI_FIXED_I32, 4"))
    suite = testing.test_yes(suite, "ABI: runtime получает предел аргументов", seed.str.contains(source, ".set SALTIC_ABI_CALL_ARGUMENT_LIMIT, 8"))
    suite = testing.test_yes(suite, "ABI: runtime получает отдельный регистр ошибки", seed.str.contains(source, ".set SALTIC_ABI_CALL_RETURN_ERROR_REGISTER, 11"))
    suite = testing.test_yes(suite, "ABI: runtime получает размер заголовка", seed.str.contains(source, ".set SALTIC_ABI_OBJECT_HEADER_BYTES, 12"))
    suite = testing.test_yes(suite, "ABI: runtime получает представление raw", seed.str.contains(source, ".set SALTIC_ABI_VALUE_REPRESENTATION_RAW, 2"))
    suite = testing.test_yes(suite, "ABI: runtime получает источник raw-типа", seed.str.contains(source, ".set SALTIC_ABI_VALUE_TYPE_SOURCE_SIGNATURE, 2"))
    suite = testing.test_yes(suite, "ABI: runtime получает выравнивание вызова", seed.str.contains(source, ".set SALTIC_ABI_CALL_STACK_ALIGNMENT, 16"))
    suite = testing.test_yes(suite, "ABI: runtime получает нулевую ошибку вызова", seed.str.contains(source, ".set SALTIC_ABI_CALL_NO_ERROR, 0"))
    suite = testing.test_yes(suite, "ABI: runtime получает начало payload", seed.str.contains(source, ".set SALTIC_ABI_OBJECT_PAYLOAD_OFFSET, 12"))
    suite = testing.test_yes(suite, "ABI: runtime получает виды объектов", seed.str.contains(source, ".set SALTIC_ABI_OBJECT_KIND_BOX, 3"))
    suite = testing.test_yes(suite, "ABI: runtime получает flags объектов", seed.str.contains(source, ".set SALTIC_ABI_OBJECT_FLAGS_MASK, 1"))
    suite = testing.test_yes(suite, "ABI: runtime получает id цикла константы", seed.str.contains(source, ".set SALTIC_ABI_ERROR_ID_CONSTANT_CYCLE, 7"))
    out suite
}

program() {
    @suite = testing.test_new()
    suite = value_tags(suite)
    suite = error_space(suite)
    suite = fixed_types(suite)
    suite = value_contract(suite)
    suite = call_contract(suite)
    suite = object_contract(suite)
    suite = assembly_contract(suite)
    testing.test_finish(suite)
    out none
}
