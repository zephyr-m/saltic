-- abi test — контракт selfhost.abi: теги значений, пространство ошибок,
-- фиксированные типы, упаковка value / call / object, слово дробного.
-- Набор на craft.testing; гоняет tests/run.sh (test_abi).
--
-- value_tags / error_space / fixed_types / value_contract / call_contract /
--     object_contract / fraction_words(suite) -> suite; fraction_words — слово
--     дробного против эталона (Python, Fraction, округление к 50 значимым битам)
-- program() -> итог testing.test_finish

use core.group
use craft.testing
use selfhost.abi
use selfhost.abi.value
use selfhost.abi.tags
use selfhost.abi.object
use selfhost.abi.fixed
use selfhost.abi.call
use selfhost.abi.fraction
use selfhost.machine.wide

skill value_tags(suite) {
    suite = testing.test_equal(suite, "ABI: сдвиг тега", abi.TAG_SHIFT, 3)
    suite = testing.test_equal(suite, "ABI: масштаб значения", abi.TAG_SCALE, 8)
    suite = testing.test_equal(suite, "ABI: маска тега", abi.TAG_MASK, 7)
    suite = testing.test_equal(suite, "ABI: тег числа", abi.TAG_NUMBER, 0)
    suite = testing.test_equal(suite, "ABI: тег малых констант", abi.TAG_SMALL, 1)
    suite = testing.test_equal(suite, "ABI: тег дробного", abi.TAG_FRACTION, 2)
    suite = testing.test_equal(suite, "ABI: тег строки", abi.TAG_STRING, 3)
    suite = testing.test_equal(suite, "ABI: тег группы", abi.TAG_GROUP, 4)
    suite = testing.test_equal(suite, "ABI: тег объекта", abi.TAG_BOX, 5)
    suite = testing.test_equal(suite, "ABI: тег перечисления", abi.TAG_ENUM, 6)
    suite = testing.test_equal(suite, "ABI: тег ошибки", abi.TAG_ERROR, 7)
    suite = testing.test_equal(suite, "ABI: значение нет", abi.NO, 1)
    suite = testing.test_equal(suite, "ABI: значение да", abi.YES, 9)
    suite = testing.test_equal(suite, "ABI: значение пустоты", abi.NONE, 17)
    suite = testing.test_equal(suite, "ABI: упаковка", abi.tagged(42, abi.TAG_ENUM), 342)
    suite = testing.test_equal(suite, "ABI: распаковка номера", tags.id(342), 42)
    suite = testing.test_equal(suite, "ABI: распаковка тега", tags.tag(342), abi.TAG_ENUM)
    suite = testing.test_equal(suite, "ABI: payload совпадает с номером", tags.payload(342), 42)
    suite = testing.test_equal(suite, "ABI: отрицательный payload сохраняется", tags.payload(abi.tagged(-1, abi.TAG_NUMBER)), -1)
    suite = testing.test_yes(suite, "ABI: последний тег допустим", tags.valid(abi.TAG_ERROR))
    suite = testing.test_no(suite, "ABI: тег за диапазоном запрещён", tags.valid(8))
    suite = testing.test_equal(suite, "ABI: неверный тег даёт пустоту", abi.tagged(1, 8), abi.NONE)
    out suite
}

skill error_space(suite) {
    suite = testing.test_equal(suite, "ABI: первая системная ошибка", abi.SYSTEM_ERROR_FIRST, 1)
    suite = testing.test_equal(suite, "ABI: последняя системная ошибка", abi.SYSTEM_ERROR_LAST, 16)
    suite = testing.test_equal(suite, "ABI: отрицательный счётчик drum закреплён", abi.ERROR_NEGATIVE_COUNT, 9)
    suite = testing.test_equal(suite, "ABI: нет метода закреплён", abi.ERROR_NO_METHOD, 10)
    suite = testing.test_equal(suite, "ABI: переполнение числа закреплено", abi.ERROR_NUMBER_OVERFLOW, 11)
    suite = testing.test_equal(suite, "ABI: тронуто пустое закреплено", abi.ERROR_EMPTY_TOUCHED, 14)
    suite = testing.test_equal(suite, "ABI: фиксированное не влезло закреплено", abi.ERROR_FIXED_TOO_BIG, 15)
    suite = testing.test_equal(suite, "ABI: выход за арену закреплён", abi.ERROR_ARENA_BOUNDS, 16)
    suite = testing.test_equal(suite, "ABI: первая пользовательская ошибка", abi.USER_ERROR_FIRST, 17)
    suite = testing.test_equal(suite, "ABI: переполнение сохраняет значение", abi.error_value(abi.ERROR_FIXED_INTEGER_OVERFLOW), 55)
    suite = testing.test_equal(suite, "ABI: первая пользовательская ошибка упакована", abi.user_error_value(0), 143)
    suite = testing.test_yes(suite, "ABI: системный диапазон распознаётся", abi.is_system_error(abi.ERROR_FIXED_INTEGER_OVERFLOW))
    suite = testing.test_no(suite, "ABI: пользовательская ошибка не системная", abi.is_system_error(abi.USER_ERROR_FIRST))
    suite = testing.test_yes(suite, "ABI: пользовательский диапазон распознаётся", abi.is_user_error(abi.USER_ERROR_FIRST))
    suite = testing.test_no(suite, "ABI: системная ошибка не пользовательская", abi.is_user_error(abi.SYSTEM_ERROR_LAST))
    suite = testing.test_equal(suite, "ABI: отсутствие ошибки равно нулю", abi.ERROR_NONE, 0)
    suite = testing.test_equal(suite, "ABI: цикл константы закреплён", abi.ERROR_CONSTANT_CYCLE, 7)
    suite = testing.test_equal(suite, "ABI: исчерпание памяти закреплено", abi.ERROR_MEMORY_EXHAUSTED, 8)
    suite = testing.test_yes(suite, "ABI: исчерпание памяти системное", abi.is_system_error(abi.ERROR_MEMORY_EXHAUSTED))
    suite = testing.test_equal(suite, "ABI: максимум ошибки зафиксирован текстом", abi.ERROR_MAXIMUM_TEXT, "268435455")
    suite = testing.test_no(suite, "ABI: нулевая ошибка не является ошибкой", abi.valid_error_id(abi.ERROR_NONE))
    suite = testing.test_equal(suite, "ABI: отрицательный индекс пользователя запрещён", abi.user_error_id(-1), abi.ERROR_NONE)
    suite = testing.test_equal(suite, "ABI: неверная ошибка не упаковывается", abi.error_value(abi.ERROR_NONE), abi.NONE)
    out suite
}

skill fixed_types(suite) {
    suite = testing.test_equal(suite, "ABI: вид u8", fixed.kind("u8"), 1)
    suite = testing.test_equal(suite, "ABI: вид u16", fixed.kind("u16"), 2)
    suite = testing.test_equal(suite, "ABI: вид u32", fixed.kind("u32"), 3)
    suite = testing.test_equal(suite, "ABI: вид i32", fixed.kind("i32"), 4)
    suite = testing.test_equal(suite, "ABI: вид bits32", fixed.kind("bits32"), 5)
    suite = testing.test_equal(suite, "ABI: вид address", fixed.kind("address"), 6)
    suite = testing.test_equal(suite, "ABI: вид usize", fixed.kind("usize"), 7)
    suite = testing.test_equal(suite, "ABI: неизвестный fixed не становится usize", fixed.kind("string"), fixed.UNKNOWN)
    suite = testing.test_equal(suite, "ABI: вид fixed возвращает имя", fixed.type(fixed.ADDRESS), "address")
    suite = testing.test_yes(suite, "ABI: известный вид fixed допустим", fixed.valid_kind(fixed.U16))
    suite = testing.test_no(suite, "ABI: нулевой вид fixed запрещён", fixed.valid_kind(fixed.UNKNOWN))
    suite = testing.test_equal(suite, "ABI: ширина u8 равна восьми битам", fixed.width_bits("u8"), 8)
    suite = testing.test_equal(suite, "ABI: ширина address равна слову", fixed.width_bits("address"), 32)
    suite = testing.test_yes(suite, "ABI: i32 является знаковым", fixed.is_signed("i32"))
    suite = testing.test_no(suite, "ABI: u32 является беззнаковым", fixed.is_signed("u32"))
    suite = testing.test_yes(suite, "ABI: фиксированный тип известен", fixed.is_type("address"))
    suite = testing.test_no(suite, "ABI: посторонний тип неизвестен", fixed.is_type("string"))
    suite = testing.test_yes(suite, "ABI: u8 принимает 255", fixed.in_range("u8", "255", no))
    suite = testing.test_no(suite, "ABI: u8 отвергает 256", fixed.in_range("u8", "256", no))
    suite = testing.test_yes(suite, "ABI: i32 принимает минимум", fixed.in_range("i32", "-2147483648", no))
    suite = testing.test_no(suite, "ABI: i32 отвергает переполнение", fixed.in_range("i32", "-2147483649", no))
    suite = testing.test_yes(suite, "ABI: address принимает максимум", fixed.in_range("address", "4294967295", no))
    suite = testing.test_no(suite, "ABI: address отвергает переполнение", fixed.in_range("address", "4294967296", no))
    suite = testing.test_yes(suite, "ABI: address на 64 битах принимает 2^32", fixed.in_range("address", "4294967296", yes))
    suite = testing.test_yes(suite, "ABI: usize на 64 битах принимает 2^60 - 1", fixed.in_range("usize", "1152921504606846975", yes))
    suite = testing.test_no(suite, "ABI: usize на 64 битах отвергает 2^60", fixed.in_range("usize", "1152921504606846976", yes))
    suite = testing.test_no(suite, "ABI: u32 на 64 битах остаётся 32-битным", fixed.in_range("u32", "4294967296", yes))
    suite = testing.test_equal(suite, "ABI: диапазон usize на 64 битах", fixed.range_text("usize", yes), "0..1152921504606846975")
    suite = testing.test_no(suite, "ABI: fixed отвергает пустой текст", fixed.in_range("u8", "", no))
    suite = testing.test_no(suite, "ABI: fixed отвергает посторонний символ", fixed.in_range("u8", "2x", no))
    suite = testing.test_equal(suite, "ABI: неизвестный fixed не имеет диапазона", fixed.range_text("string", no), "")
    out suite
}

skill value_contract(suite) {
    suite = testing.test_equal(suite, "ABI: машинное слово содержит 32 бита", abi.VALUE_WORD_BITS, 32)
    suite = testing.test_equal(suite, "ABI: машинное слово содержит 4 байта", abi.VALUE_WORD_BYTES, 4)
    suite = testing.test_equal(suite, "ABI: фиксированное значение хранится сырым", value.representation("u32"), value.REPRESENTATION_RAW)
    suite = testing.test_equal(suite, "ABI: строка хранится с тегом", value.representation("string"), value.REPRESENTATION_TAGGED)
    suite = testing.test_equal(suite, "ABI: неизвестное представление явно неизвестно", value.representation("mystery"), value.REPRESENTATION_UNKNOWN)
    suite = testing.test_equal(suite, "ABI: raw-тип берётся из сигнатуры", value.type_source("u32"), value.TYPE_SOURCE_SIGNATURE)
    suite = testing.test_equal(suite, "ABI: tagged-тип берётся из тега", value.type_source("string"), value.TYPE_SOURCE_TAG)
    suite = testing.test_equal(suite, "ABI: неизвестный тип не имеет источника", value.type_source("mystery"), value.TYPE_SOURCE_UNKNOWN)
    suite = testing.test_yes(suite, "ABI: raw-тип является допустимым значением", value.valid_type("u32"))
    suite = testing.test_no(suite, "ABI: посторонний тип не является значением", value.valid_type("mystery"))
    suite = testing.test_equal(suite, "ABI: тип строки определяет тег", value.type_tag("string"), abi.TAG_STRING)
    suite = testing.test_equal(suite, "ABI: тег перечисления определяет тип", value.tag_type(abi.TAG_ENUM), "enum:unknown")
    suite = testing.test_equal(suite, "ABI: минимум обычного числа зафиксирован", value.NUMBER_MINIMUM_TEXT, "-268435456")
    suite = testing.test_equal(suite, "ABI: максимум обычного числа зафиксирован", value.NUMBER_MAXIMUM_TEXT, "268435455")
    out suite
}

skill call_contract(suite) {
    suite = testing.test_equal(suite, "ABI: доступно восемь аргументов", call.ARGUMENT_LIMIT, 8)
    suite = testing.test_equal(suite, "ABI: первый аргумент получает регистр 10", call.argument_register(0), 10)
    suite = testing.test_equal(suite, "ABI: восьмой аргумент получает регистр 17", call.argument_register(7), 17)
    suite = testing.test_equal(suite, "ABI: девятого регистра аргумента нет", call.argument_register(8), -1)
    suite = testing.test_equal(suite, "ABI: отрицательного регистра аргумента нет", call.argument_register(-1), -1)
    suite = testing.test_yes(suite, "ABI: восемь аргументов допустимы", call.valid_argument_count(8))
    suite = testing.test_no(suite, "ABI: девять аргументов запрещены", call.valid_argument_count(9))
    suite = testing.test_equal(suite, "ABI: кадр выравнивается до 16 байт", call.frame_bytes(1, 1), 16)
    suite = testing.test_equal(suite, "ABI: отрицательный кадр запрещён", call.frame_bytes(-1, 1), -1)
    suite = testing.test_equal(suite, "ABI: значение возвращается отдельно", call.RETURN_VALUE_REGISTER, 10)
    suite = testing.test_equal(suite, "ABI: ошибка возвращается отдельно", call.RETURN_ERROR_REGISTER, 11)
    suite = testing.test_equal(suite, "ABI: source fixed kind передаётся через a6", call.FIXED_SOURCE_KIND_REGISTER, 16)
    suite = testing.test_equal(suite, "ABI: target fixed kind передаётся через a7", call.FIXED_TARGET_KIND_REGISTER, 17)
    suite = testing.test_equal(suite, "ABI: успешный вызов возвращает нулевую ошибку", abi.CALL_NO_ERROR, 0)
    suite = testing.test_equal(suite, "ABI: тип raw-вызова задаёт сигнатура", call.RAW_TYPE_SOURCE, value.TYPE_SOURCE_SIGNATURE)
    suite = testing.test_equal(suite, "ABI: ошибка вызова является сырым id", call.ERROR_REPRESENTATION_RAW_ID, 1)
    suite = testing.test_equal(suite, "ABI: аргумент u32 передаётся сырым", call.argument_representation("u32"), value.REPRESENTATION_RAW)
    suite = testing.test_equal(suite, "ABI: аргумент string передаётся tagged", call.argument_representation("string"), value.REPRESENTATION_TAGGED)
    @success = call.success(42, "u32")
    suite = testing.test_no(suite, "ABI: успешный результат не является ошибкой", call.failed(success))
    suite = testing.test_yes(suite, "ABI: успешный raw-результат согласован", call.valid_result(success))
    @failure = call.failure(abi.ERROR_FILE)
    suite = testing.test_yes(suite, "ABI: ошибочный результат распознаётся", call.failed(failure))
    suite = testing.test_yes(suite, "ABI: отдельная ошибка вызова согласована", call.valid_result(failure))
    suite = testing.test_no(suite, "ABI: неизвестный тип вызова запрещён", call.valid_call_type("mystery"))
    out suite
}

skill object_contract(suite) {
    suite = testing.test_equal(suite, "ABI: объект выровнен по 8 байтам", abi.OBJECT_ALIGNMENT, 8)
    suite = testing.test_equal(suite, "ABI: заголовок объекта занимает 12 байт", abi.OBJECT_HEADER_BYTES, 12)
    suite = testing.test_equal(suite, "ABI: kind лежит в начале заголовка", abi.OBJECT_HEADER_KIND_OFFSET, 0)
    suite = testing.test_equal(suite, "ABI: размер payload лежит после kind", abi.OBJECT_HEADER_PAYLOAD_BYTES_OFFSET, 4)
    suite = testing.test_equal(suite, "ABI: flags лежат после размера", abi.OBJECT_HEADER_FLAGS_OFFSET, 8)
    suite = testing.test_equal(suite, "ABI: payload начинается после заголовка", abi.OBJECT_PAYLOAD_OFFSET, 12)
    suite = testing.test_equal(suite, "ABI: пустой объект занимает заголовок", object.allocation_size(0), 16)
    suite = testing.test_equal(suite, "ABI: полезная нагрузка выравнивается", object.allocation_size(1), 16)
    suite = testing.test_equal(suite, "ABI: отрицательный payload запрещён", object.allocation_size(-1), -1)
    suite = testing.test_yes(suite, "ABI: строка является известным объектом", object.valid_kind(abi.OBJECT_KIND_STRING))
    suite = testing.test_yes(suite, "ABI: группа является известным объектом", object.valid_kind(abi.OBJECT_KIND_GROUP))
    suite = testing.test_yes(suite, "ABI: Box является известным объектом", object.valid_kind(abi.OBJECT_KIND_BOX))
    suite = testing.test_no(suite, "ABI: неизвестный вид объекта запрещён", object.valid_kind(99))
    suite = testing.test_yes(suite, "ABI: статический объект распознаётся", object.has_flag(abi.OBJECT_FLAG_STATIC, abi.OBJECT_FLAG_STATIC))
    suite = testing.test_yes(suite, "ABI: единственный флаг допустим", object.valid_flags(abi.OBJECT_FLAGS_MASK))
    suite = testing.test_no(suite, "ABI: посторонний flag запрещён", object.valid_flags(4))
    suite = testing.test_no(suite, "ABI: нулевой искомый flag безопасно отвергается", object.has_flag(abi.OBJECT_FLAGS_NONE, abi.OBJECT_FLAGS_NONE))
    out suite
}

skill fraction_words(suite) {
    @cases = [
        ["0.5", "4602678819172646914"],
        ["0.1", "4591870180066957722"],
        ["3.14159", "4614256650576692850"],
        ["0", "2"],
        ["-0.75", "13828302655841107970"],
        ["0.30000000000000004", "4599075939470750514"],
        ["9999999999999999999.5", "4891288408196988162"],
        ["0.000001", "4517329193108106642"]
    ]
    drum (cases) {
        @literal = group.get(beat, 0)
        @bits = fraction.word(literal)
        suite = testing.test_equal(suite, "ABI: дробное {literal}", wide.text(bits), group.get(beat, 1))
    }
    out suite
}

program() {
    @suite = testing.test_new()
    suite = value_tags(suite)
    suite = error_space(suite)
    suite = fixed_types(suite)
    suite = value_contract(suite)
    suite = call_contract(suite)
    suite = object_contract(suite)
    suite = fraction_words(suite)
    out testing.test_finish(suite)
}
