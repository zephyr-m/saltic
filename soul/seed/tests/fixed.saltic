-- fixed test — фиксированные типы на деле: арифметика с переполнением,
-- преобразования from, операции bits32, типизированная память по address.
-- Проверки — craft/testing, как у остальных тестов; фиксированное значение
-- не покидает навык, поэтому сравнивается на месте (== даёт yes/no).
-- Гоняет tests/run.sh (fixed-types).
--
-- limits / checked_arithmetic / checked_conversions / bit_operations /
--     typed_memory(suite) -> Testing
-- program() -> none; TestsFailed, если есть провалы

use core.mem
use core.bits32
use core.address
use core.u8
use core.u16
use core.u32
use core.i32
use core.usize
use craft.testing

skill limits(suite) {
    suite = testing.test_yes(suite, "u8 limits", u8.from(255) > u8.from(0))
    suite = testing.test_yes(suite, "u16 limits", u16.from(65535) > u16.from(0))
    suite = testing.test_yes(suite, "u32 limits", u32.from(4294967295) > u32.from(0))
    suite = testing.test_yes(suite, "i32 limits", i32.from(2147483647) > i32.from(-2147483648))
    suite = testing.test_yes(suite, "usize", usize.from(4294967295) == usize.from(4294967295))
    out suite
}

skill checked_arithmetic(suite) {
    @byte = u8.from(250)
    @word = u16.from(60000)
    @signed = i32.from(0 - 2000000000)
    suite = testing.test_yes(suite, "u8 arithmetic", byte + u8.from(5) == u8.from(255))
    suite = testing.test_yes(suite, "u16 arithmetic", word + u16.from(5535) == u16.from(65535))
    suite = testing.test_yes(suite, "i32 arithmetic", signed + i32.from(2000000001) == i32.from(1))
    suite = testing.test_yes(suite, "u8 subtraction", u8.from(10) - u8.from(3) == u8.from(7))
    suite = testing.test_yes(suite, "u16 multiplication", u16.from(200) * u16.from(300) == u16.from(60000))
    suite = testing.test_yes(suite, "u32 division", u32.from(4000000000) / u32.from(2) == u32.from(2000000000))
    suite = testing.test_yes(suite, "i32 multiplication", i32.from(-7) * i32.from(6) == i32.from(-42))
    suite = testing.test_yes(suite, "i32 division", i32.from(-84) / i32.from(2) == i32.from(-42))
    suite = testing.test_yes(suite, "u32 comparison", u32.from(4294967295) > u32.from(1))
    suite = testing.test_yes(suite, "i32 comparison", i32.from(-1) < i32.from(0))

    @byte_overflow = u8.from(255) + u8.from(1) rescue |err| {
        suite = testing.test_yes(suite, "переполнение u8", err == error.FixedIntegerOverflow)
        u8.from(0)
    }
    @signed_overflow = i32.from(2147483647) + i32.from(1) rescue |err| {
        suite = testing.test_yes(suite, "переполнение i32", err == error.FixedIntegerOverflow)
        i32.from(0)
    }
    @unsigned_underflow = u8.from(0) - u8.from(1) rescue |err| {
        suite = testing.test_yes(suite, "выход ниже границы u8", err == error.FixedIntegerOverflow)
        u8.from(0)
    }
    suite = testing.test_yes(suite, "u8 after overflow", byte_overflow == u8.from(0))
    suite = testing.test_yes(suite, "i32 after overflow", signed_overflow == i32.from(0))
    suite = testing.test_yes(suite, "u8 after underflow", unsigned_underflow == u8.from(0))
    out suite
}

skill checked_conversions(suite) {
    @word = u16.from(u8.from(255))
    suite = testing.test_yes(suite, "u8 to u16", word == u16.from(255))
    suite = testing.test_yes(suite, "u16 to u32", u32.from(word) == u32.from(255))
    suite = testing.test_yes(suite, "u16 to i32", i32.from(word) == i32.from(255))
    suite = testing.test_yes(suite, "checked narrowing", u8.from(u16.from(255)) == u8.from(255))

    @failed = u8.from(u16.from(256)) rescue |err| {
        suite = testing.test_yes(suite, "ошибка сужения до u8", err == error.FixedIntegerOverflow)
        u8.from(0)
    }
    @failed_signed = i32.from(u32.from(4294967295)) rescue |err| {
        suite = testing.test_yes(suite, "ошибка преобразования в i32", err == error.FixedIntegerOverflow)
        i32.from(0)
    }
    @failed_unsigned = u32.from(i32.from(0 - 1)) rescue |err| {
        suite = testing.test_yes(suite, "ошибка преобразования в u32", err == error.FixedIntegerOverflow)
        u32.from(0)
    }
    suite = testing.test_yes(suite, "u8 after narrowing", failed == u8.from(0))
    suite = testing.test_yes(suite, "i32 after conversion", failed_signed == i32.from(0))
    suite = testing.test_yes(suite, "u32 after conversion", failed_unsigned == u32.from(0))
    out suite
}

skill bit_operations(suite) {
    @left = bits32.from(4042322160)
    @right = bits32.from(252645135)
    @all = bits32.from(4294967295)
    suite = testing.test_yes(suite, "bits and", bits32.and(left, right) == bits32.from(0))
    suite = testing.test_yes(suite, "bits or", bits32.or(left, right) == all)
    suite = testing.test_yes(suite, "bits xor", bits32.xor(left, right) == all)
    suite = testing.test_yes(suite, "bits not", bits32.not(bits32.from(0)) == all)
    suite = testing.test_yes(suite, "bits shift left", bits32.shift_left(bits32.from(1), u8.from(31)) == bits32.from(2147483648))
    suite = testing.test_yes(suite, "bits shift right", bits32.shift_right(bits32.from(2147483648), u8.from(31)) == bits32.from(1))
    out suite
}

skill typed_memory(suite) {
    @arena = mem.arena(1) * 65536 + mem.arena(0)
    @memory = address.from(u32.from(arena))
    mem.store8(memory, usize.from(0), u8.from(171))
    mem.store16(memory, usize.from(2), u16.from(52719))
    mem.store32(memory, usize.from(4), u32.from(3735928559))
    @next = address.add(memory, usize.from(4))
    suite = testing.test_yes(suite, "load8", mem.load8(memory, usize.from(0)) == u8.from(171))
    suite = testing.test_yes(suite, "load16", mem.load16(memory, usize.from(2)) == u16.from(52719))
    suite = testing.test_yes(suite, "load32", mem.load32(next, usize.from(0)) == u32.from(3735928559))
    out suite
}

program() {
    @suite = testing.test_new()
    suite = limits(suite)
    suite = checked_arithmetic(suite)
    suite = checked_conversions(suite)
    suite = bit_operations(suite)
    suite = typed_memory(suite)
    out testing.test_finish(suite)
}
