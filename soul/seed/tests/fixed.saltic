-- fixed test — фиксированные типы на деле: арифметика с переполнением,
-- преобразования from, операции bits32, типизированная память по address.
-- Печатает через io.show; эталон — expected/fixed.txt, гоняет tests/run.sh
-- (fixed-types).
--
-- checked_arithmetic / checked_conversions / bit_operations / typed_memory() -> none
-- program() -> none; сначала печатает границы u8…usize

use core.mem
use io
use core.bits32
use core.address
use core.u8
use core.u16
use core.u32
use core.i32
use core.usize

skill checked_arithmetic() {
    @byte = u8.from(250)
    @byte_sum = byte + u8.from(5)
    @word = u16.from(60000)
    @word_sum = word + u16.from(5535)
    @signed = i32.from(0 - 2000000000)
    @signed_sum = signed + i32.from(2000000001)
    @difference = u8.from(10) - u8.from(3)
    @product = u16.from(200) * u16.from(300)
    @quotient = u32.from(4000000000) / u32.from(2)
    @signed_product = i32.from(-7) * i32.from(6)
    @signed_quotient = i32.from(-84) / i32.from(2)

    io.show("u8 arithmetic: ", byte_sum)
    io.show("u16 arithmetic: ", word_sum)
    io.show("i32 arithmetic: ", signed_sum)
    io.show("u8 subtraction: ", difference)
    io.show("u16 multiplication: ", product)
    io.show("u32 division: ", quotient)
    io.show("i32 multiplication: ", signed_product)
    io.show("i32 division: ", signed_quotient)
    io.show("u32 comparison: ", u32.from(4294967295) > u32.from(1))
    io.show("i32 comparison: ", i32.from(-1) < i32.from(0))

    @byte_overflow = u8.from(255) + u8.from(1) rescue |err| {
        io.show("переполнение u8: ", err)
        u8.from(0)
    }
    @signed_overflow = i32.from(2147483647) + i32.from(1) rescue |err| {
        io.show("переполнение i32: ", err)
        i32.from(0)
    }
    @unsigned_underflow = u8.from(0) - u8.from(1) rescue |err| {
        io.show("выход ниже границы u8: ", err)
        u8.from(0)
    }

    io.show("u8 after overflow: ", byte_overflow)
    io.show("i32 after overflow: ", signed_overflow)
    io.show("u8 after underflow: ", unsigned_underflow)
    out none
}

skill checked_conversions() {
    @byte = u8.from(255)
    @word = u16.from(byte)
    @double_word = u32.from(word)
    @signed = i32.from(word)
    @narrow = u8.from(u16.from(255))

    io.show("u8 to u16: ", word)
    io.show("u16 to u32: ", double_word)
    io.show("u16 to i32: ", signed)
    io.show("checked narrowing: ", narrow)

    @failed = u8.from(u16.from(256)) rescue |err| {
        io.show("ошибка сужения до u8: ", err)
        u8.from(0)
    }
    @failed_signed = i32.from(u32.from(4294967295)) rescue |err| {
        io.show("ошибка преобразования в i32: ", err)
        i32.from(0)
    }
    @failed_unsigned = u32.from(i32.from(0 - 1)) rescue |err| {
        io.show("ошибка преобразования в u32: ", err)
        u32.from(0)
    }
    io.show("u8 after narrowing: ", failed)
    io.show("i32 after conversion: ", failed_signed)
    io.show("u32 after conversion: ", failed_unsigned)
    out none
}

skill bit_operations() {
    @left = bits32.from(4042322160)
    @right = bits32.from(252645135)

    io.show("bits and: ", bits32.and(left, right))
    io.show("bits or: ", bits32.or(left, right))
    io.show("bits xor: ", bits32.xor(left, right))
    io.show("bits not: ", bits32.not(bits32.from(0)))
    io.show("bits shift left: ", bits32.shift_left(bits32.from(1), u8.from(31)))
    io.show("bits shift right: ", bits32.shift_right(bits32.from(2147483648), u8.from(31)))
    out none
}

skill typed_memory() {
    @memory = address.from(u32.from(4096))
    mem.store8(memory, usize.from(0), u8.from(171))
    mem.store16(memory, usize.from(2), u16.from(52719))
    mem.store32(memory, usize.from(4), u32.from(3735928559))

    @next = address.add(memory, usize.from(4))
    io.show("load8: ", mem.load8(memory, usize.from(0)))
    io.show("load16: ", mem.load16(memory, usize.from(2)))
    io.show("load32: ", mem.load32(next, usize.from(0)))
    out none
}

program() {
    io.show("u8 limits: ", u8.from(0), " ", u8.from(255))
    io.show("u16 limits: ", u16.from(0), " ", u16.from(65535))
    io.show("u32 limits: ", u32.from(0), " ", u32.from(4294967295))
    io.show("i32 limits: ", i32.from(-2147483648), " ", i32.from(2147483647))
    io.show("usize: ", usize.from(4294967295))

    checked_arithmetic()
    checked_conversions()
    bit_operations()
    typed_memory()
    out none
}
