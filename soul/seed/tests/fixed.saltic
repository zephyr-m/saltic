use seed

skill checked_arithmetic() {
    @byte = u8(250)
    @byte_sum = byte + u8(5)
    @word = u16(60000)
    @word_sum = word + u16(5535)
    @signed = i32(0 - 2000000000)
    @signed_sum = signed + i32(2000000001)
    @difference = u8(10) - u8(3)
    @product = u16(200) * u16(300)
    @quotient = u32(4000000000) / u32(2)
    @signed_product = i32(0 - 7) * i32(6)
    @signed_quotient = i32(0 - 84) / i32(2)

    seed.io.show("u8 arithmetic: ", byte_sum)
    seed.io.show("u16 arithmetic: ", word_sum)
    seed.io.show("i32 arithmetic: ", signed_sum)
    seed.io.show("u8 subtraction: ", difference)
    seed.io.show("u16 multiplication: ", product)
    seed.io.show("u32 division: ", quotient)
    seed.io.show("i32 multiplication: ", signed_product)
    seed.io.show("i32 division: ", signed_quotient)
    seed.io.show("u32 comparison: ", u32(4294967295) > u32(1))
    seed.io.show("i32 comparison: ", i32(0 - 1) < i32(0))

    @byte_overflow = u8(255) + u8(1) rescue |err| {
        seed.io.show("переполнение u8: ", err)
        u8(0)
    }
    @signed_overflow = i32(2147483647) + i32(1) rescue |err| {
        seed.io.show("переполнение i32: ", err)
        i32(0)
    }
    @unsigned_underflow = u8(0) - u8(1) rescue |err| {
        seed.io.show("выход ниже границы u8: ", err)
        u8(0)
    }

    seed.io.show("u8 after overflow: ", byte_overflow)
    seed.io.show("i32 after overflow: ", signed_overflow)
    seed.io.show("u8 after underflow: ", unsigned_underflow)
    out none
}

skill checked_conversions() {
    @byte = u8(255)
    @word = seed.u16.from(byte)
    @double_word = seed.u32.from(word)
    @signed = seed.i32.from(word)
    @narrow = seed.u8.from(u16(255))

    seed.io.show("u8 to u16: ", word)
    seed.io.show("u16 to u32: ", double_word)
    seed.io.show("u16 to i32: ", signed)
    seed.io.show("checked narrowing: ", narrow)

    @failed = seed.u8.from(u16(256)) rescue |err| {
        seed.io.show("ошибка сужения до u8: ", err)
        u8(0)
    }
    @failed_signed = seed.i32.from(u32(4294967295)) rescue |err| {
        seed.io.show("ошибка преобразования в i32: ", err)
        i32(0)
    }
    @failed_unsigned = seed.u32.from(i32(0 - 1)) rescue |err| {
        seed.io.show("ошибка преобразования в u32: ", err)
        u32(0)
    }
    seed.io.show("u8 after narrowing: ", failed)
    seed.io.show("i32 after conversion: ", failed_signed)
    seed.io.show("u32 after conversion: ", failed_unsigned)
    out none
}

skill bit_operations() {
    @left = bits32(4042322160)
    @right = bits32(252645135)

    seed.io.show("bits and: ", seed.bits32.and(left, right))
    seed.io.show("bits or: ", seed.bits32.or(left, right))
    seed.io.show("bits xor: ", seed.bits32.xor(left, right))
    seed.io.show("bits not: ", seed.bits32.not(bits32(0)))
    seed.io.show("bits shift left: ", seed.bits32.shift_left(bits32(1), u8(31)))
    seed.io.show("bits shift right: ", seed.bits32.shift_right(bits32(2147483648), u8(31)))
    out none
}

skill typed_memory() {
    @memory = address(u32(4096))
    seed.mem.store8(memory, usize(0), u8(171))
    seed.mem.store16(memory, usize(2), u16(52719))
    seed.mem.store32(memory, usize(4), u32(3735928559))

    @next = seed.address.add(memory, usize(4))
    seed.io.show("load8: ", seed.mem.load8(memory, usize(0)))
    seed.io.show("load16: ", seed.mem.load16(memory, usize(2)))
    seed.io.show("load32: ", seed.mem.load32(next, usize(0)))
    out none
}

program() {
    seed.io.show("u8 limits: ", u8(0), " ", u8(255))
    seed.io.show("u16 limits: ", u16(0), " ", u16(65535))
    seed.io.show("u32 limits: ", u32(0), " ", u32(4294967295))
    seed.io.show("i32 limits: ", i32(0 - 2147483648), " ", i32(2147483647))
    seed.io.show("usize: ", usize(4294967295))

    checked_arithmetic()
    checked_conversions()
    bit_operations()
    typed_memory()
    out none
}
