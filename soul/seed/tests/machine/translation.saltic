use seed
use seed.abi
use craft.testing
use seed.compiler.state
use seed.compiler.codegen
use seed.compiler.constants
use seed.runtime.emit
use seed.machine.instruction
use seed.machine.codec
use seed.machine.layout

skill behavior_string_program() {
    @compiler = state.State {}
    compiler.machine = layout.host("_start")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "_start")
    compiler = codegen.compile_expression(compiler, ["string", "saltic"])
    compiler.machine = layout.emit_call(compiler.machine, "rt_string_len")
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.EBREAK, codec.ZERO, codec.ZERO, codec.ZERO, 0)
    compiler = emit.emit_string_len(compiler)
    out layout.resolve(compiler.machine)
}

skill behavior_arithmetic_program() {
    @compiler = state.State {}
    compiler.machine = layout.host("_start")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "_start")
    compiler = codegen.compile_binary(compiler, "+", ["number", 2], ["number", 3])
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.EBREAK, codec.ZERO, codec.ZERO, codec.ZERO, 0)
    compiler = emit.emit_add(compiler)
    out layout.resolve(compiler.machine)
}

skill behavior_if_program() {
    @compiler = state.State {}
    compiler.machine = layout.host("_start")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "_start")
    compiler = codegen.compile_statement(compiler, ["if", ["answer", "yes"], ["block", ["expr", ["number", 7]]]], no)
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.EBREAK, codec.ZERO, codec.ZERO, codec.ZERO, 0)
    out layout.resolve(compiler.machine)
}

skill behavior_group_program() {
    @compiler = state.State {}
    compiler.machine = layout.host("_start")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "_start")
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.S1, "behavior_group_heap", 0)
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.S2, "behavior_group_heap_end", 0)
    compiler = codegen.compile_expression(compiler, ["group", ["number", 1], ["number", 2]])
    compiler.machine = layout.emit_call(compiler.machine, "rt_group_count")
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.EBREAK, codec.ZERO, codec.ZERO, codec.ZERO, 0)
    compiler = emit.emit_alloc(compiler)
    compiler = emit.emit_group_count(compiler)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_out_of_memory")
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.EBREAK, codec.ZERO, codec.ZERO, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.BSS, "behavior_group_heap")
    compiler.machine = layout.reserve_bss(compiler.machine, 64)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.BSS, "behavior_group_heap_end")
    out layout.resolve(compiler.machine)
}

skill behavior_box_program() {
    @compiler = state.State {}
    compiler.machine = layout.host("_start")
    compiler = state.collect_box(compiler, ["box", "Point", ["field", "x", ["number", 1]], ["field", "y", ["number", 2]]], "")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "_start")
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.S1, "behavior_box_heap", 0)
    compiler.machine = layout.emit_relative_address(compiler.machine, codec.S2, "behavior_box_heap_end", 0)
    compiler.machine = layout.emit_call(compiler.machine, "saltic_box_behavior")
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.EBREAK, codec.ZERO, codec.ZERO, codec.ZERO, 0)
    compiler = codegen.compile_function(compiler, "box_behavior", [], ["block", ["var", "point", ["box-new", "Point"]], ["field-assign", ["path", "point", "x"], ["number", 7]], ["out", ["path", "point", "x"]]], "", "")
    compiler = emit.emit_alloc(compiler)
    compiler = emit.emit_box_get(compiler)
    compiler = emit.emit_box_set(compiler)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_out_of_memory")
    compiler.machine = layout.define_label(compiler.machine, layout.Section.CODE, "rt_missing_field")
    compiler.machine = layout.emit(compiler.machine, instruction.Kind.EBREAK, codec.ZERO, codec.ZERO, codec.ZERO, 0)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.BSS, "behavior_box_heap")
    compiler.machine = layout.reserve_bss(compiler.machine, 64)
    compiler.machine = layout.define_label(compiler.machine, layout.Section.BSS, "behavior_box_heap_end")
    out layout.resolve(compiler.machine)
}

skill run(suite) {
    @compiler = state.State {}
    compiler = emit.emit_add(compiler)
    compiler = emit.emit_sub(compiler)
    @expected = [51, 5, 181, 0, 103, 128, 0, 0, 51, 5, 181, 64, 103, 128, 0, 0]
    suite = testing.test_equal(suite, "перевод rt_add/sub: длина", compiler.machine.code.length, 16)
    @index = 0
    drum (16) {
        suite = testing.test_equal(suite, seed.str.add("перевод rt_add/sub: байт ", seed.num.text(index)), codec.byte_at(compiler.machine.code, index), seed.group.item(expected, index))
        index = index + 1
    }
    @add_label = layout.find_label(compiler.machine, "rt_add")
    @sub_label = layout.find_label(compiler.machine, "rt_sub")
    suite = testing.test_yes(suite, "перевод rt_add: метка существует", add_label.present)
    suite = testing.test_equal(suite, "перевод rt_add: смещение", add_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_sub: метка существует", sub_label.present)
    suite = testing.test_equal(suite, "перевод rt_sub: смещение", sub_label.offset, 8)

    @multiply = state.State {}
    multiply = emit.emit_mul(multiply)
    multiply.machine = layout.resolve(multiply.machine)
    @multiply_bytes = [
        19, 85, 53, 64, 147, 213, 53, 64,
        147, 2, 0, 0, 19, 131, 5, 0,
        99, 86, 3, 0, 51, 3, 96, 64,
        51, 5, 160, 64, 99, 14, 3, 0,
        147, 115, 19, 0, 99, 132, 3, 0,
        179, 130, 162, 0, 19, 21, 21, 0,
        19, 83, 19, 0, 227, 22, 3, 254,
        19, 149, 50, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_mul: длина", multiply.machine.code.length, 64)
    suite = testing.test_equal(suite, "перевод rt_mul: четыре перехода", multiply.machine.patch_count, 4)
    @multiply_index = 0
    drum (64) {
        suite = testing.test_equal(suite, seed.str.add("перевод rt_mul: байт ", seed.num.text(multiply_index)), codec.byte_at(multiply.machine.code, multiply_index), seed.group.item(multiply_bytes, multiply_index))
        multiply_index = multiply_index + 1
    }
    @multiply_label = layout.find_label(multiply.machine, "rt_mul")
    @multiply_positive = layout.find_label(multiply.machine, ".L_mul_positive")
    @multiply_loop = layout.find_label(multiply.machine, ".L_mul_loop")
    @multiply_skip = layout.find_label(multiply.machine, ".L_mul_skip")
    @multiply_done = layout.find_label(multiply.machine, ".L_mul_done")
    suite = testing.test_yes(suite, "перевод rt_mul: метка существует", multiply_label.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение", multiply_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_mul: положительная ветка существует", multiply_positive.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение положительной ветки", multiply_positive.offset, 28)
    suite = testing.test_yes(suite, "перевод rt_mul: цикл существует", multiply_loop.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение цикла", multiply_loop.offset, 32)
    suite = testing.test_yes(suite, "перевод rt_mul: пропуск существует", multiply_skip.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение пропуска", multiply_skip.offset, 44)
    suite = testing.test_yes(suite, "перевод rt_mul: завершение существует", multiply_done.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение завершения", multiply_done.offset, 56)

    @division = state.State {}
    division = emit.emit_div(division)
    division = emit.emit_division_by_zero(division)
    division.machine = layout.resolve(division.machine)
    @division_bytes = [
        19, 85, 53, 64, 147, 213, 53, 64,
        99, 130, 5, 4, 147, 2, 0, 0,
        19, 3, 0, 0, 99, 86, 5, 0,
        51, 5, 160, 64, 19, 67, 19, 0,
        99, 214, 5, 0, 179, 5, 176, 64,
        19, 67, 19, 0, 99, 104, 181, 0,
        51, 5, 181, 64, 147, 130, 18, 0,
        227, 124, 181, 254, 99, 4, 3, 0,
        179, 2, 80, 64, 19, 149, 50, 0,
        103, 128, 0, 0, 19, 5, 240, 1,
        103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_div: длина", division.machine.code.length, 84)
    suite = testing.test_equal(suite, "перевод rt_div: шесть переходов", division.machine.patch_count, 6)
    @division_index = 0
    drum (84) {
        suite = testing.test_equal(suite, seed.str.add("перевод rt_div: байт ", seed.num.text(division_index)), codec.byte_at(division.machine.code, division_index), seed.group.item(division_bytes, division_index))
        division_index = division_index + 1
    }
    @division_label = layout.find_label(division.machine, "rt_div")
    @division_left = layout.find_label(division.machine, ".L_div_left")
    @division_right = layout.find_label(division.machine, ".L_div_right")
    @division_loop = layout.find_label(division.machine, ".L_div_loop")
    @division_done = layout.find_label(division.machine, ".L_div_done")
    @division_encode = layout.find_label(division.machine, ".L_div_encode")
    @division_zero = layout.find_label(division.machine, "rt_division_by_zero")
    suite = testing.test_yes(suite, "перевод rt_div: метка существует", division_label.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение", division_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_div: левая ветка существует", division_left.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение левой ветки", division_left.offset, 32)
    suite = testing.test_yes(suite, "перевод rt_div: правая ветка существует", division_right.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение правой ветки", division_right.offset, 44)
    suite = testing.test_yes(suite, "перевод rt_div: цикл существует", division_loop.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение цикла", division_loop.offset, 48)
    suite = testing.test_yes(suite, "перевод rt_div: завершение существует", division_done.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение завершения", division_done.offset, 60)
    suite = testing.test_yes(suite, "перевод rt_div: кодирование существует", division_encode.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение кодирования", division_encode.offset, 68)
    suite = testing.test_yes(suite, "перевод деления на ноль: метка существует", division_zero.present)
    suite = testing.test_equal(suite, "перевод деления на ноль: смещение", division_zero.offset, 76)

    @equality = state.State {}
    equality = emit.emit_equal(equality)
    equality.machine = layout.resolve(equality.machine)
    @equality_bytes = [
        99, 8, 181, 4, 147, 114, 117, 0,
        19, 243, 117, 0, 99, 150, 98, 4,
        147, 3, 48, 0, 99, 146, 114, 4,
        19, 117, 133, 255, 147, 245, 133, 255,
        131, 34, 5, 0, 3, 163, 5, 0,
        99, 152, 98, 2, 147, 3, 0, 0,
        99, 128, 83, 2, 51, 14, 117, 0,
        179, 142, 117, 0, 3, 78, 78, 0,
        131, 206, 78, 0, 99, 26, 222, 1,
        147, 131, 19, 0, 111, 240, 95, 254,
        19, 5, 144, 0, 103, 128, 0, 0,
        19, 5, 16, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_equal: длина", equality.machine.code.length, 96)
    suite = testing.test_equal(suite, "перевод rt_equal: семь переходов", equality.machine.patch_count, 7)
    @equality_index = 0
    drum (96) {
        suite = testing.test_equal(suite, seed.str.add("перевод rt_equal: байт ", seed.num.text(equality_index)), codec.byte_at(equality.machine.code, equality_index), seed.group.item(equality_bytes, equality_index))
        equality_index = equality_index + 1
    }
    @equality_label = layout.find_label(equality.machine, "rt_equal")
    @equality_string = layout.find_label(equality.machine, ".L_equal_string")
    @equality_yes = layout.find_label(equality.machine, ".L_equal_yes")
    @equality_no = layout.find_label(equality.machine, ".L_equal_no")
    suite = testing.test_yes(suite, "перевод rt_equal: метка существует", equality_label.present)
    suite = testing.test_equal(suite, "перевод rt_equal: смещение", equality_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_equal: строковый цикл существует", equality_string.present)
    suite = testing.test_equal(suite, "перевод rt_equal: смещение строкового цикла", equality_string.offset, 48)
    suite = testing.test_yes(suite, "перевод rt_equal: ветка yes существует", equality_yes.present)
    suite = testing.test_equal(suite, "перевод rt_equal: смещение yes", equality_yes.offset, 80)
    suite = testing.test_yes(suite, "перевод rt_equal: ветка no существует", equality_no.present)
    suite = testing.test_equal(suite, "перевод rt_equal: смещение no", equality_no.offset, 88)

    @comparison = state.State {}
    comparison = emit.emit_less(comparison)
    comparison = emit.emit_greater(comparison)
    comparison.machine = layout.resolve(comparison.machine)
    @comparison_bytes = [
        19, 85, 53, 64, 147, 213, 53, 64,
        99, 70, 181, 0, 19, 5, 16, 0,
        103, 128, 0, 0, 19, 5, 144, 0,
        103, 128, 0, 0,
        19, 85, 53, 64, 147, 213, 53, 64,
        99, 198, 165, 0, 19, 5, 16, 0,
        103, 128, 0, 0, 19, 5, 144, 0,
        103, 128, 0, 0,
