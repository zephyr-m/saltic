    suite = testing.test_equal(suite, "перевод сравнений: длина", comparison.machine.code.length, 56)
    suite = testing.test_equal(suite, "перевод сравнений: два перехода", comparison.machine.patch_count, 2)
    @byte_index = 0
    drum (56) {
        suite = testing.test_equal(suite, seed.str.add("перевод сравнений: байт ", seed.num.text(byte_index)), codec.byte_at(comparison.machine.code, byte_index), seed.group.item(comparison_bytes, byte_index))
        byte_index = byte_index + 1
    }
    @less_label = layout.find_label(comparison.machine, "rt_less")
    @less_yes = layout.find_label(comparison.machine, ".L_less_yes")
    @greater_label = layout.find_label(comparison.machine, "rt_greater")
    @greater_yes = layout.find_label(comparison.machine, ".L_greater_yes")
    suite = testing.test_yes(suite, "перевод rt_less: метка существует", less_label.present)
    suite = testing.test_equal(suite, "перевод rt_less: смещение", less_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_less: ветка yes существует", less_yes.present)
    suite = testing.test_equal(suite, "перевод rt_less: смещение yes", less_yes.offset, 20)
    suite = testing.test_yes(suite, "перевод rt_greater: метка существует", greater_label.present)
    suite = testing.test_equal(suite, "перевод rt_greater: смещение", greater_label.offset, 28)
    suite = testing.test_yes(suite, "перевод rt_greater: ветка yes существует", greater_yes.present)
    suite = testing.test_equal(suite, "перевод rt_greater: смещение yes", greater_yes.offset, 48)

    @boxes = state.State {}
    boxes = emit.emit_box_get(boxes)
    boxes = emit.emit_box_set(boxes)
    boxes = emit.emit_missing_field(boxes)
    boxes.machine = layout.resolve(boxes.machine)
    @box_bytes = [
        19, 117, 133, 255, 131, 34, 5, 0,
        19, 5, 69, 0, 99, 136, 2, 4,
        3, 35, 5, 0, 99, 8, 179, 0,
        19, 5, 133, 0, 147, 130, 242, 255,
        111, 240, 223, 254, 3, 37, 69, 0,
        103, 128, 0, 0, 19, 117, 133, 255,
        131, 34, 5, 0, 19, 5, 69, 0,
        99, 130, 2, 2, 3, 35, 5, 0,
        99, 8, 179, 0, 19, 5, 133, 0,
        147, 130, 242, 255, 111, 240, 223, 254,
        35, 34, 197, 0, 19, 5, 32, 0,
        103, 128, 0, 0, 19, 5, 240, 0,
        103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод Box: длина", boxes.machine.code.length, 100)
    suite = testing.test_equal(suite, "перевод Box: шесть переходов", boxes.machine.patch_count, 6)
    @box_index = 0
