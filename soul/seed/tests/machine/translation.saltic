-- translation — эталоны перевода рантайма в машинный код RV32I, байт в байт.
-- Части лежат в translation/ по темам; каждая собирает свой кусок рантайма
-- и сверяет байты, метки и смещения с эталоном.
--
-- run(suite) -> suite со всеми проверками перевода

use seed.tests.machine.translation.tr_arith
use seed.tests.machine.translation.tr_objects
use seed.tests.machine.translation.tr_system
use seed.tests.machine.translation.tr_memory
use seed.tests.machine.translation.tr_text
use seed.tests.machine.translation.tr_fixed
use seed.tests.machine.translation.tr_image

skill run(suite) {
    suite = tr_arith.run(suite)
    suite = tr_objects.run(suite)
    suite = tr_system.run(suite)
    suite = tr_memory.run(suite)
    suite = tr_text.run(suite)
    suite = tr_fixed.run(suite)
    suite = tr_image.run(suite)
    out suite
}
