        19, 5, 240, 2, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод чтения String: длина", string_read.machine.code.length, 56)
    suite = testing.test_equal(suite, "перевод чтения String: один переход", string_read.machine.patch_count, 1)
    @string_read_index = 0
    drum (56) {
        suite = testing.test_equal(suite, seed.str.add("перевод чтения String: байт ", seed.num.text(string_read_index)), codec.byte_at(string_read.machine.code, string_read_index), seed.group.item(string_read_bytes, string_read_index))
        string_read_index = string_read_index + 1
    }
