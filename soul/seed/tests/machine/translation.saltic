    suite = testing.test_equal(suite, "машинный switch: размер", machine_switch.machine.code.length, 24)
    suite = testing.test_equal(suite, "машинный switch: branch и jump", machine_switch.machine.patch_count, 2)
    machine_switch.machine = layout.resolve(machine_switch.machine)
    suite = testing.test_yes(suite, "машинный switch: ссылки разрешены", machine_switch.machine.resolved)

    @machine_drum = state.State {}
    machine_drum.current_function = state.Function { slots = [state.Symbol { name = "$drum:1" kind = "slot" value = 0 - 12 }] }
    machine_drum = codegen.compile_statement(machine_drum, ["drum", ["number", 2], ["block"]], no)
    suite = testing.test_equal(suite, "машинный drum: размер", machine_drum.machine.code.length, 32)
    suite = testing.test_equal(suite, "машинный drum: branch и jump", machine_drum.machine.patch_count, 2)
    @machine_drum_opcodes = [19, 19, 35, 131, 99, 147, 35, 111]
    @machine_drum_word = 0
    drum (8) {
        suite = testing.test_equal(suite, seed.str.add("машинный drum: opcode ", seed.num.text(machine_drum_word)), codec.byte_at(machine_drum.machine.code, machine_drum_word * 4), seed.group.item(machine_drum_opcodes, machine_drum_word))
        machine_drum_word = machine_drum_word + 1
    }
    machine_drum.machine = layout.resolve(machine_drum.machine)
    suite = testing.test_yes(suite, "машинный drum: ссылки разрешены", machine_drum.machine.resolved)

    @machine_rescue = state.State {}
    machine_rescue.current_function = state.Function { slots = [state.Symbol { name = "failure" kind = "slot" value = 0 - 12 }] }
    machine_rescue = codegen.compile_rescue(machine_rescue, ["rescue", ["number", 1], "failure", ["block"]])
    suite = testing.test_equal(suite, "машинный rescue: размер", machine_rescue.machine.code.length, 24)
    suite = testing.test_equal(suite, "машинный rescue: один branch", machine_rescue.machine.patch_count, 1)
    machine_rescue.machine = layout.resolve(machine_rescue.machine)
    suite = testing.test_yes(suite, "машинный rescue: ссылки разрешены", machine_rescue.machine.resolved)

    @machine_constant_flow = state.State {}
    @machine_constant = state.Symbol { name = "sample" kind = "const" node = ["number", 1] }
    machine_constant_flow = codegen.compile_constant(machine_constant_flow, machine_constant)
    machine_constant_flow.constants = [machine_constant]
    machine_constant_flow = constants.emit_storage(machine_constant_flow)
    suite = testing.test_equal(suite, "машинная константа: полный getter", machine_constant_flow.machine.code.length, 112)
    suite = testing.test_equal(suite, "машинная константа: переходы и data patches", machine_constant_flow.machine.patch_count, 12)
    machine_constant_flow.machine = layout.resolve(machine_constant_flow.machine)
    suite = testing.test_yes(suite, "машинная константа: переходы разрешены", machine_constant_flow.machine.resolved)

    @machine_constant_storage = state.State { constants = [state.Symbol { name = "sample" kind = "const" }] }
    machine_constant_storage = constants.emit_storage(machine_constant_storage)
    @machine_constant_state = layout.find_label(machine_constant_storage.machine, constants.state_label("sample"))
    @machine_constant_value = layout.find_label(machine_constant_storage.machine, constants.value_label("sample"))
    suite = testing.test_equal(suite, "машинная константа: размер data", machine_constant_storage.machine.data.length, constants.CONSTANT_STORAGE_BYTES)
    suite = testing.test_yes(suite, "машинная константа: state label существует", machine_constant_state.present)
    suite = testing.test_equal(suite, "машинная константа: state в data", machine_constant_state.section, layout.Section.DATA)
    suite = testing.test_equal(suite, "машинная константа: state offset", machine_constant_state.offset, constants.CONSTANT_STATE_OFFSET)
    suite = testing.test_yes(suite, "машинная константа: value label существует", machine_constant_value.present)
    suite = testing.test_equal(suite, "машинная константа: value в data", machine_constant_value.section, layout.Section.DATA)
    suite = testing.test_equal(suite, "машинная константа: value offset", machine_constant_value.offset, constants.CONSTANT_VALUE_OFFSET)
    suite = testing.test_equal(suite, "машинная константа: начальное состояние", codec.byte_at(machine_constant_storage.machine.data, constants.CONSTANT_STATE_OFFSET), constants.STATE_EMPTY)
    suite = testing.test_equal(suite, "машинная константа: начальное значение", codec.byte_at(machine_constant_storage.machine.data, constants.CONSTANT_VALUE_OFFSET), abi.NONE)

    @machine_storage = state.State {}
    machine_storage.machine = layout.reserve_bss(machine_storage.machine, 3)
    machine_storage = state.finish_data(machine_storage)
    @machine_heap = layout.find_label(machine_storage.machine, "saltic_heap")
    @machine_heap_end = layout.find_label(machine_storage.machine, "saltic_heap_end")
    suite = testing.test_equal(suite, "машинный bss: полный размер", machine_storage.machine.bss_size, abi.OBJECT_ALIGNMENT + constants.HEAP_BYTES)
    suite = testing.test_yes(suite, "машинный bss: heap существует", machine_heap.present)
    suite = testing.test_equal(suite, "машинный bss: heap section", machine_heap.section, layout.Section.BSS)
    suite = testing.test_equal(suite, "машинный bss: heap выровнен", machine_heap.offset, abi.OBJECT_ALIGNMENT)
    suite = testing.test_yes(suite, "машинный bss: heap end существует", machine_heap_end.present)
    suite = testing.test_equal(suite, "машинный bss: heap end section", machine_heap_end.section, layout.Section.BSS)
    suite = testing.test_equal(suite, "машинный bss: размер heap", machine_heap_end.offset - machine_heap.offset, constants.HEAP_BYTES)

    @whole_runtime = state.State {}
    whole_runtime = emit.append_runtime(whole_runtime)
    suite = testing.test_equal(suite, "цельный runtime: число меток", whole_runtime.machine.label_count, 184)
    suite = testing.test_equal(suite, "цельный runtime: размер rodata", whole_runtime.machine.rodata.length, 129)
    suite = testing.test_equal(suite, "цельный runtime: длина unknown", codec.byte_at(whole_runtime.machine.rodata, 0), 7)
    suite = testing.test_equal(suite, "цельный runtime: длина overflow", codec.byte_at(whole_runtime.machine.rodata, 16), 89)
    suite = testing.test_equal(suite, "цельный runtime: newline", codec.byte_at(whole_runtime.machine.rodata, 128), 10)
    @whole_unknown = layout.find_label(whole_runtime.machine, "rt_unknown_text")
    @whole_overflow = layout.find_label(whole_runtime.machine, "rt_fixed_overflow_text")
    @whole_yes = layout.find_label(whole_runtime.machine, "rt_yes_text")
    @whole_no = layout.find_label(whole_runtime.machine, "rt_no_text")
    @whole_newline = layout.find_label(whole_runtime.machine, "rt_newline_text")
    suite = testing.test_equal(suite, "цельный runtime: unknown offset", whole_unknown.offset, 0)
    suite = testing.test_equal(suite, "цельный runtime: overflow offset", whole_overflow.offset, 16)
    suite = testing.test_equal(suite, "цельный runtime: yes offset", whole_yes.offset, 112)
    suite = testing.test_equal(suite, "цельный runtime: no offset", whole_no.offset, 120)
    suite = testing.test_equal(suite, "цельный runtime: newline offset", whole_newline.offset, 128)
    whole_runtime.machine = layout.resolve(whole_runtime.machine)
    suite = testing.test_yes(suite, "цельный runtime: все ссылки разрешены", whole_runtime.machine.resolved)
    out suite
}
