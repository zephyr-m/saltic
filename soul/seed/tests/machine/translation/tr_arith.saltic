-- tr_arith — эталоны перевода в машинный код, часть translation:
-- арифметика и сравнения рантайма: rt_add, rt_sub, rt_mul, rt_div, rt_equal, rt_less, rt_greater.
-- Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use craft.testing
use selfhost.compiler.state
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.buffer
use selfhost.compiler.runtime.emit.numbers

skill run(suite) {
    @compiler = state.State {}
    compiler = numbers.emit_add(compiler)
    compiler = numbers.emit_sub(compiler)
    @expected = [
        51, 5, 181, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 51, 5, 181, 64,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_add/sub: длина", compiler.machine.code.length, 24)
    drum (24) {
        suite = testing.test_equal(suite, "перевод rt_add/sub: байт {beat}", buffer.byte_at(compiler.machine.code, beat), group.get(expected, beat))
    }
    @add_label = layout.find_label(compiler.machine, "rt_add")
    @sub_label = layout.find_label(compiler.machine, "rt_sub")
    suite = testing.test_yes(suite, "перевод rt_add: метка существует", add_label.present)
    suite = testing.test_equal(suite, "перевод rt_add: смещение", add_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_sub: метка существует", sub_label.present)
    suite = testing.test_equal(suite, "перевод rt_sub: смещение", sub_label.offset, 12)

    @multiply = state.State {}
    multiply = numbers.emit_mul(multiply)
    multiply = numbers.emit_number_overflow(multiply)
    multiply.machine = layout.resolve(multiply.machine)
    @multiply_bytes = [
        19, 85, 53, 64, 19, 211, 53, 64,
        51, 78, 101, 0, 99, 84, 5, 0,
        51, 5, 160, 64, 99, 84, 3, 0,
        51, 3, 96, 64, 183, 5, 0, 16,
        147, 133, 245, 255, 147, 133, 21, 0,
        147, 2, 0, 0, 99, 4, 3, 2,
        147, 115, 19, 0, 99, 134, 3, 0,
        179, 130, 162, 0, 99, 234, 85, 2,
        19, 83, 19, 0, 99, 8, 3, 0,
        19, 21, 21, 0, 99, 226, 165, 2,
        111, 240, 31, 254, 99, 86, 14, 0,
        179, 2, 80, 64, 111, 0, 128, 0,
        99, 136, 178, 0, 19, 149, 50, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        19, 5, 0, 0, 147, 5, 176, 0,
        103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_mul: длина", multiply.machine.code.length, 124)
    suite = testing.test_equal(suite, "перевод rt_mul: переходы", multiply.machine.patch_count, 11)
    drum (124) {
        suite = testing.test_equal(suite, "перевод rt_mul: байт {beat}", buffer.byte_at(multiply.machine.code, beat), group.get(multiply_bytes, beat))
    }
    @multiply_label = layout.find_label(multiply.machine, "rt_mul")
    @multiply_positive = layout.find_label(multiply.machine, ".L_mul_positive")
    @multiply_loop = layout.find_label(multiply.machine, ".L_mul_loop")
    @multiply_skip = layout.find_label(multiply.machine, ".L_mul_skip")
    @multiply_done = layout.find_label(multiply.machine, ".L_mul_done")
    suite = testing.test_yes(suite, "перевод rt_mul: метка существует", multiply_label.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение", multiply_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_mul: положительная ветка существует", multiply_positive.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение положительной ветки", multiply_positive.offset, 96)
    suite = testing.test_yes(suite, "перевод rt_mul: цикл существует", multiply_loop.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение цикла", multiply_loop.offset, 48)
    suite = testing.test_yes(suite, "перевод rt_mul: пропуск существует", multiply_skip.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение пропуска", multiply_skip.offset, 64)
    suite = testing.test_yes(suite, "перевод rt_mul: завершение существует", multiply_done.present)
    suite = testing.test_equal(suite, "перевод rt_mul: смещение завершения", multiply_done.offset, 84)

    @division = state.State {}
    division = numbers.emit_div(division)
    division = numbers.emit_division_by_zero(division)
    division = numbers.emit_number_overflow(division)
    division.machine = layout.resolve(division.machine)
    @division_bytes = [
        19, 85, 53, 64, 147, 213, 53, 64,
        99, 130, 5, 10, 147, 2, 0, 0,
        19, 3, 0, 0, 99, 86, 5, 0,
        51, 5, 160, 64, 19, 67, 19, 0,
        99, 214, 5, 0, 179, 5, 176, 64,
        19, 67, 19, 0, 99, 110, 181, 4,
        147, 131, 245, 255, 179, 243, 179, 0,
        99, 144, 3, 2, 147, 3, 16, 0,
        99, 136, 117, 0, 147, 213, 21, 0,
        19, 85, 21, 0, 111, 240, 95, 255,
        147, 2, 5, 0, 111, 0, 64, 3,
        147, 3, 0, 0, 19, 14, 0, 2,
        147, 94, 245, 1, 147, 147, 19, 0,
        179, 227, 211, 1, 19, 21, 21, 0,
        147, 146, 18, 0, 99, 230, 179, 0,
        179, 131, 179, 64, 147, 226, 18, 0,
        19, 14, 254, 255, 227, 30, 14, 252,
        99, 6, 3, 0, 179, 2, 80, 64,
        111, 0, 0, 1, 183, 3, 0, 16,
        147, 131, 243, 255, 99, 238, 83, 0,
        19, 149, 50, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 0, 0,
        147, 5, 48, 0, 103, 128, 0, 0,
        19, 5, 0, 0, 147, 5, 176, 0,
        103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_div: длина", division.machine.code.length, 196)
    suite = testing.test_equal(suite, "перевод rt_div: переходы", division.machine.patch_count, 13)
    drum (196) {
        suite = testing.test_equal(suite, "перевод rt_div: байт {beat}", buffer.byte_at(division.machine.code, beat), group.get(division_bytes, beat))
    }
    @division_label = layout.find_label(division.machine, "rt_div")
    @division_left = layout.find_label(division.machine, ".L_div_left")
    @division_right = layout.find_label(division.machine, ".L_div_right")
    @division_loop = layout.find_label(division.machine, ".L_div_loop")
    @division_done = layout.find_label(division.machine, ".L_div_done")
    @division_encode = layout.find_label(division.machine, ".L_div_encode")
    @division_zero = layout.find_label(division.machine, "rt_division_by_zero")
    suite = testing.test_yes(suite, "перевод rt_div: метка существует", division_label.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение", division_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_div: левая ветка существует", division_left.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение левой ветки", division_left.offset, 32)
    suite = testing.test_yes(suite, "перевод rt_div: правая ветка существует", division_right.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение правой ветки", division_right.offset, 44)
    suite = testing.test_yes(suite, "перевод rt_div: цикл существует", division_loop.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение цикла", division_loop.offset, 96)
    suite = testing.test_yes(suite, "перевод rt_div: завершение существует", division_done.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение завершения", division_done.offset, 136)
    suite = testing.test_yes(suite, "перевод rt_div: кодирование существует", division_encode.present)
    suite = testing.test_equal(suite, "перевод rt_div: смещение кодирования", division_encode.offset, 160)
    suite = testing.test_yes(suite, "перевод деления на ноль: метка существует", division_zero.present)
    suite = testing.test_equal(suite, "перевод деления на ноль: смещение", division_zero.offset, 172)

    @equality = state.State {}
    equality = numbers.emit_equal(equality)
    equality.machine = layout.resolve(equality.machine)
    @equality_bytes = [
        99, 8, 181, 4, 147, 114, 117, 0,
        19, 243, 117, 0, 99, 152, 98, 4,
        147, 3, 48, 0, 99, 148, 114, 4,
        19, 117, 133, 255, 147, 245, 133, 255,
        131, 34, 197, 0, 3, 163, 197, 0,
        99, 154, 98, 2, 147, 3, 0, 0,
        99, 128, 83, 2, 51, 14, 117, 0,
        179, 142, 117, 0, 3, 78, 14, 1,
        131, 206, 14, 1, 99, 28, 222, 1,
        147, 131, 19, 0, 111, 240, 95, 254,
        19, 5, 144, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 16, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_equal: длина", equality.machine.code.length, 104)
    suite = testing.test_equal(suite, "перевод rt_equal: семь переходов", equality.machine.patch_count, 7)
    drum (104) {
        suite = testing.test_equal(suite, "перевод rt_equal: байт {beat}", buffer.byte_at(equality.machine.code, beat), group.get(equality_bytes, beat))
    }
    @equality_label = layout.find_label(equality.machine, "rt_equal")
    @equality_string = layout.find_label(equality.machine, ".L_equal_string")
    @equality_yes = layout.find_label(equality.machine, ".L_equal_yes")
    @equality_no = layout.find_label(equality.machine, ".L_equal_no")
    suite = testing.test_yes(suite, "перевод rt_equal: метка существует", equality_label.present)
    suite = testing.test_equal(suite, "перевод rt_equal: смещение", equality_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_equal: строковый цикл существует", equality_string.present)
    suite = testing.test_equal(suite, "перевод rt_equal: смещение строкового цикла", equality_string.offset, 48)
    suite = testing.test_yes(suite, "перевод rt_equal: ветка yes существует", equality_yes.present)
    suite = testing.test_equal(suite, "перевод rt_equal: смещение yes", equality_yes.offset, 80)
    suite = testing.test_yes(suite, "перевод rt_equal: ветка no существует", equality_no.present)
    suite = testing.test_equal(suite, "перевод rt_equal: смещение no", equality_no.offset, 92)

    @comparison = state.State {}
    comparison = numbers.emit_less(comparison)
    comparison = numbers.emit_greater(comparison)
    comparison.machine = layout.resolve(comparison.machine)
    @comparison_bytes = [
        19, 85, 53, 64, 147, 213, 53, 64,
        99, 72, 181, 0, 19, 5, 16, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        19, 5, 144, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 85, 53, 64,
        147, 213, 53, 64, 99, 200, 165, 0,
        19, 5, 16, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 144, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод сравнений: длина", comparison.machine.code.length, 72)
    suite = testing.test_equal(suite, "перевод сравнений: два перехода", comparison.machine.patch_count, 2)
    drum (72) {
        suite = testing.test_equal(suite, "перевод сравнений: байт {beat}", buffer.byte_at(comparison.machine.code, beat), group.get(comparison_bytes, beat))
    }
    @less_label = layout.find_label(comparison.machine, "rt_less")
    @less_yes = layout.find_label(comparison.machine, ".L_less_yes")
    @greater_label = layout.find_label(comparison.machine, "rt_greater")
    @greater_yes = layout.find_label(comparison.machine, ".L_greater_yes")
    suite = testing.test_yes(suite, "перевод rt_less: метка существует", less_label.present)
    suite = testing.test_equal(suite, "перевод rt_less: смещение", less_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_less: ветка yes существует", less_yes.present)
    suite = testing.test_equal(suite, "перевод rt_less: смещение yes", less_yes.offset, 24)
    suite = testing.test_yes(suite, "перевод rt_greater: метка существует", greater_label.present)
    suite = testing.test_equal(suite, "перевод rt_greater: смещение", greater_label.offset, 36)
    suite = testing.test_yes(suite, "перевод rt_greater: ветка yes существует", greater_yes.present)
    suite = testing.test_equal(suite, "перевод rt_greater: смещение yes", greater_yes.offset, 60)

    out suite
}
