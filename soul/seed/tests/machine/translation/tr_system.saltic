-- tr_system — эталоны перевода в машинный код, часть translation:
-- платформа, CPU, запись файла, ошибки и сравнения fixed.
-- Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use craft.testing
use selfhost.compiler.state
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.buffer
use selfhost.compiler.backend.rv32i.runtime.fixed
use selfhost.compiler.backend.rv32i.runtime.host
use selfhost.compiler.backend.rv32i.runtime.numbers

skill run(suite) {
    @platform = state.State {}
    platform = host.emit_platform_write(platform)
    platform = host.emit_platform_exit(platform)
    platform = host.emit_cpu_wait(platform)
    platform = host.emit_cpu_fence(platform)
    platform.machine = layout.resolve(platform.machine)
    @platform_bytes = [
        147, 8, 0, 4, 115, 0, 0, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        147, 8, 208, 5, 115, 0, 0, 0,
        115, 0, 80, 16, 19, 5, 32, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        15, 0, 48, 3, 19, 5, 32, 0,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод платформы и CPU: длина", platform.machine.code.length, 56)
    suite = testing.test_equal(suite, "перевод платформы и CPU: переходов нет", platform.machine.patch_count, 0)
    drum (56) {
        suite = testing.test_equal(suite, "перевод платформы и CPU: байт {beat}", buffer.byte_at(platform.machine.code, beat), group.get(platform_bytes, beat))
    }
    @platform_write = layout.find_label(platform.machine, "rt_platform_write")
    @platform_exit = layout.find_label(platform.machine, "rt_platform_exit")
    @cpu_wait = layout.find_label(platform.machine, "rt_cpu_wait")
    @cpu_fence = layout.find_label(platform.machine, "rt_cpu_fence")
    suite = testing.test_yes(suite, "перевод rt_platform_write: метка существует", platform_write.present)
    suite = testing.test_equal(suite, "перевод rt_platform_write: смещение", platform_write.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_platform_exit: метка существует", platform_exit.present)
    suite = testing.test_equal(suite, "перевод rt_platform_exit: смещение", platform_exit.offset, 16)
    suite = testing.test_yes(suite, "перевод rt_cpu_wait: метка существует", cpu_wait.present)
    suite = testing.test_equal(suite, "перевод rt_cpu_wait: смещение", cpu_wait.offset, 24)
    suite = testing.test_yes(suite, "перевод rt_cpu_fence: метка существует", cpu_fence.present)
    suite = testing.test_equal(suite, "перевод rt_cpu_fence: смещение", cpu_fence.offset, 40)

    @file_write = state.State {}
    file_write = host.emit_file_write(file_write)
    file_write = host.emit_file_error(file_write)
    file_write.machine = layout.resolve(file_write.machine)
    @file_write_bytes = [
        19, 1, 1, 254, 35, 46, 17, 0,
        35, 44, 177, 0, 147, 114, 133, 255,
        147, 133, 2, 1, 19, 5, 192, 249,
        19, 6, 16, 36, 147, 6, 64, 26,
        147, 8, 128, 3, 115, 0, 0, 0,
        99, 66, 5, 4, 35, 42, 161, 0,
        131, 34, 129, 1, 147, 242, 130, 255,
        3, 166, 194, 0, 147, 133, 2, 1,
        3, 37, 65, 1, 147, 8, 0, 4,
        115, 0, 0, 0, 3, 37, 65, 1,
        147, 8, 144, 3, 115, 0, 0, 0,
        19, 5, 32, 0, 131, 32, 193, 1,
        19, 1, 1, 2, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 0, 0,
        147, 5, 64, 0, 131, 32, 193, 1,
        19, 1, 1, 2, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод rt_file_write и ошибки: длина", file_write.machine.code.length, 128)
    suite = testing.test_equal(suite, "перевод rt_file_write и ошибки: один переход", file_write.machine.patch_count, 1)
    drum (128) {
        suite = testing.test_equal(suite, "перевод rt_file_write и ошибки: байт {beat}", buffer.byte_at(file_write.machine.code, beat), group.get(file_write_bytes, beat))
    }
    @file_write_label = layout.find_label(file_write.machine, "rt_file_write")
    @file_error = layout.find_label(file_write.machine, "rt_file_error")
    suite = testing.test_yes(suite, "перевод rt_file_write: метка существует", file_write_label.present)
    suite = testing.test_equal(suite, "перевод rt_file_write: смещение", file_write_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_file_error: метка существует", file_error.present)
    suite = testing.test_equal(suite, "перевод rt_file_error: смещение", file_error.offset, 108)

    @runtime_links = state.State {}
    runtime_links = host.emit_newline(runtime_links)
    runtime_links = host.emit_missing_args(runtime_links)
    runtime_links = host.emit_platform_write(runtime_links)
    runtime_links = host.emit_platform_exit(runtime_links)
    runtime_links.machine = layout.define_label(runtime_links.machine, layout.Section.RODATA, "rt_newline_text")
    runtime_links.machine = layout.resolve(runtime_links.machine)
    @runtime_link_bytes = [
        19, 5, 16, 0, 151, 5, 0, 0,
        147, 133, 197, 4, 19, 6, 16, 0,
        19, 1, 1, 255, 35, 38, 17, 0,
        239, 0, 192, 1, 131, 32, 193, 0,
        19, 1, 1, 1, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 0, 4,
        111, 0, 64, 1, 147, 8, 0, 4,
        115, 0, 0, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 147, 8, 208, 5,
        115, 0, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод newline и missing args: длина", runtime_links.machine.code.length, 76)
    suite = testing.test_equal(suite, "перевод newline и missing args: пять переходов", runtime_links.machine.patch_count, 4)
    drum (76) {
        suite = testing.test_equal(suite, "перевод newline и missing args: байт {beat}", buffer.byte_at(runtime_links.machine.code, beat), group.get(runtime_link_bytes, beat))
    }
    @newline = layout.find_label(runtime_links.machine, "rt_newline")
    @missing_args = layout.find_label(runtime_links.machine, "rt_missing_args")
    @linked_platform_write = layout.find_label(runtime_links.machine, "rt_platform_write")
    @linked_platform_exit = layout.find_label(runtime_links.machine, "rt_platform_exit")
    @newline_text = layout.find_label(runtime_links.machine, "rt_newline_text")
    suite = testing.test_yes(suite, "перевод rt_newline: метка существует", newline.present)
    suite = testing.test_equal(suite, "перевод rt_newline: смещение", newline.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_missing_args: метка существует", missing_args.present)
    suite = testing.test_equal(suite, "перевод rt_missing_args: смещение", missing_args.offset, 44)
    suite = testing.test_yes(suite, "связанный rt_platform_write существует", linked_platform_write.present)
    suite = testing.test_equal(suite, "связанный rt_platform_write: смещение", linked_platform_write.offset, 52)
    suite = testing.test_yes(suite, "связанный rt_platform_exit существует", linked_platform_exit.present)
    suite = testing.test_equal(suite, "связанный rt_platform_exit: смещение", linked_platform_exit.offset, 68)
    suite = testing.test_yes(suite, "связанный rt_newline_text существует", newline_text.present)
    suite = testing.test_equal(suite, "связанный rt_newline_text: смещение в rodata", newline_text.offset, 0)

    @fixed_overflow = state.State {}
    fixed_overflow = fixed.emit_fixed_overflow_restore(fixed_overflow)
    fixed_overflow = fixed.emit_fixed_overflow(fixed_overflow)
    fixed_overflow.machine = layout.resolve(fixed_overflow.machine)
    @fixed_overflow_bytes = [
        19, 5, 0, 0, 147, 5, 96, 0,
        131, 32, 193, 0, 19, 1, 1, 1,
        103, 128, 0, 0, 19, 5, 0, 0,
        147, 5, 96, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод ошибок fixed: длина", fixed_overflow.machine.code.length, 32)
    suite = testing.test_equal(suite, "перевод ошибок fixed: переходов нет", fixed_overflow.machine.patch_count, 0)
    drum (32) {
        suite = testing.test_equal(suite, "перевод ошибок fixed: байт {beat}", buffer.byte_at(fixed_overflow.machine.code, beat), group.get(fixed_overflow_bytes, beat))
    }
    @fixed_overflow_restore = layout.find_label(fixed_overflow.machine, "rt_fixed_overflow_restore")
    @fixed_overflow_label = layout.find_label(fixed_overflow.machine, "rt_fixed_overflow")
    suite = testing.test_yes(suite, "перевод rt_fixed_overflow_restore: метка существует", fixed_overflow_restore.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_overflow_restore: смещение", fixed_overflow_restore.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_fixed_overflow: метка существует", fixed_overflow_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_overflow: смещение", fixed_overflow_label.offset, 20)

    @fixed_comparison = state.State {}
    fixed_comparison = fixed.emit_fixed_equal(fixed_comparison)
    fixed_comparison = fixed.emit_fixed_less(fixed_comparison)
    fixed_comparison = fixed.emit_fixed_greater(fixed_comparison)
    fixed_comparison = numbers.emit_equal(fixed_comparison)
    fixed_comparison = numbers.emit_less(fixed_comparison)
    fixed_comparison.machine = layout.resolve(fixed_comparison.machine)
    @fixed_comparison_bytes = [
        99, 0, 181, 8, 111, 0, 128, 8,
        19, 14, 64, 0, 99, 6, 200, 1,
        99, 96, 181, 10, 111, 0, 128, 7,
        99, 76, 181, 8, 111, 0, 0, 7,
        51, 6, 5, 0, 51, 133, 5, 0,
        179, 5, 6, 0, 111, 240, 223, 253,
        99, 8, 181, 4, 147, 114, 117, 0,
        19, 243, 117, 0, 99, 152, 98, 4,
        147, 3, 48, 0, 99, 148, 114, 4,
        19, 117, 133, 255, 147, 245, 133, 255,
        131, 34, 197, 0, 3, 163, 197, 0,
        99, 154, 98, 2, 147, 3, 0, 0,
        99, 128, 83, 2, 51, 14, 117, 0,
        179, 142, 117, 0, 3, 78, 14, 1,
        131, 206, 14, 1, 99, 28, 222, 1,
        147, 131, 19, 0, 111, 240, 95, 254,
        19, 5, 144, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 16, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        19, 85, 53, 64, 147, 213, 53, 64,
        99, 72, 181, 0, 19, 5, 16, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        19, 5, 144, 0, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод сравнений fixed: длина", fixed_comparison.machine.code.length, 188)
    suite = testing.test_equal(suite, "перевод сравнений fixed: шестнадцать переходов", fixed_comparison.machine.patch_count, 16)
    drum (188) {
        suite = testing.test_equal(suite, "перевод сравнений fixed: байт {beat}", buffer.byte_at(fixed_comparison.machine.code, beat), group.get(fixed_comparison_bytes, beat))
    }
    @fixed_equal = layout.find_label(fixed_comparison.machine, "rt_fixed_equal")
    @fixed_less = layout.find_label(fixed_comparison.machine, "rt_fixed_less")
    @fixed_less_signed = layout.find_label(fixed_comparison.machine, ".L_fixed_less_signed")
    @fixed_greater = layout.find_label(fixed_comparison.machine, "rt_fixed_greater")
    @linked_equal = layout.find_label(fixed_comparison.machine, "rt_equal")
    @linked_equal_string = layout.find_label(fixed_comparison.machine, ".L_equal_string")
    @linked_equal_yes = layout.find_label(fixed_comparison.machine, ".L_equal_yes")
    @linked_equal_no = layout.find_label(fixed_comparison.machine, ".L_equal_no")
    @linked_less = layout.find_label(fixed_comparison.machine, "rt_less")
    @linked_less_yes = layout.find_label(fixed_comparison.machine, ".L_less_yes")
    suite = testing.test_yes(suite, "перевод rt_fixed_equal: метка существует", fixed_equal.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_equal: смещение", fixed_equal.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_fixed_less: метка существует", fixed_less.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_less: смещение", fixed_less.offset, 8)
    suite = testing.test_yes(suite, "перевод rt_fixed_less: signed существует", fixed_less_signed.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_less: смещение signed", fixed_less_signed.offset, 24)
    suite = testing.test_yes(suite, "перевод rt_fixed_greater: метка существует", fixed_greater.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_greater: смещение", fixed_greater.offset, 32)
    suite = testing.test_yes(suite, "связанный rt_equal существует", linked_equal.present)
    suite = testing.test_equal(suite, "связанный rt_equal: смещение", linked_equal.offset, 48)
    suite = testing.test_yes(suite, "связанный строковый цикл equal существует", linked_equal_string.present)
    suite = testing.test_equal(suite, "связанный строковый цикл equal: смещение", linked_equal_string.offset, 96)
    suite = testing.test_yes(suite, "связанная ветка equal yes существует", linked_equal_yes.present)
    suite = testing.test_equal(suite, "связанная ветка equal yes: смещение", linked_equal_yes.offset, 128)
    suite = testing.test_yes(suite, "связанная ветка equal no существует", linked_equal_no.present)
    suite = testing.test_equal(suite, "связанная ветка equal no: смещение", linked_equal_no.offset, 140)
    suite = testing.test_yes(suite, "связанный rt_less существует", linked_less.present)
    suite = testing.test_equal(suite, "связанный rt_less: смещение", linked_less.offset, 152)
    suite = testing.test_yes(suite, "связанная ветка less yes существует", linked_less_yes.present)
    suite = testing.test_equal(suite, "связанная ветка less yes: смещение", linked_less_yes.offset, 176)

    out suite
}
