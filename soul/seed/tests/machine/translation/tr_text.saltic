    suite = testing.test_equal(suite, "перевод string case: длина", string_case.machine.code.length, 180)
    suite = testing.test_equal(suite, "перевод string case: одиннадцать переходов", string_case.machine.patch_count, 10)
    drum (180) {
        suite = testing.test_equal(suite, "перевод string case: байт {beat}", buffer.byte_at(string_case.machine.code, beat), group.get(string_case_bytes, beat))
    }
    @string_lower_label = layout.find_label(string_case.machine, "rt_string_lower")
    @string_upper_label = layout.find_label(string_case.machine, "rt_string_upper")
    @string_case_label = layout.find_label(string_case.machine, "rt_string_case")
    @case_loop = layout.find_label(string_case.machine, ".L_case_loop")
    @case_lower = layout.find_label(string_case.machine, ".L_case_lower")
    @case_store = layout.find_label(string_case.machine, ".L_case_store")
    @case_done = layout.find_label(string_case.machine, ".L_case_done")
    @string_case_alloc = layout.find_label(string_case.machine, "rt_alloc")
    suite = testing.test_yes(suite, "перевод rt_string_lower: метка существует", string_lower_label.present)
    suite = testing.test_equal(suite, "перевод rt_string_lower: смещение", string_lower_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_string_upper: метка существует", string_upper_label.present)
    suite = testing.test_equal(suite, "перевод rt_string_upper: смещение", string_upper_label.offset, 8)
    suite = testing.test_yes(suite, "перевод rt_string_case: метка существует", string_case_label.present)
    suite = testing.test_equal(suite, "перевод rt_string_case: смещение", string_case_label.offset, 12)
    suite = testing.test_yes(suite, "string case: цикл существует", case_loop.present)
    suite = testing.test_equal(suite, "string case: смещение цикла", case_loop.offset, 76)
    suite = testing.test_yes(suite, "string case: lower существует", case_lower.present)
    suite = testing.test_equal(suite, "string case: смещение lower", case_lower.offset, 116)
    suite = testing.test_yes(suite, "string case: запись существует", case_store.present)
    suite = testing.test_equal(suite, "string case: смещение записи", case_store.offset, 136)
    suite = testing.test_yes(suite, "string case: завершение существует", case_done.present)
    suite = testing.test_equal(suite, "string case: смещение завершения", case_done.offset, 152)
    suite = testing.test_yes(suite, "string case: связанный alloc существует", string_case_alloc.present)
    suite = testing.test_equal(suite, "string case: смещение alloc", string_case_alloc.offset, 180)

    @number_text = state.State {}
    number_text = numbers.emit_number_text(number_text)
    number_text.machine = layout.define_label(number_text.machine, layout.Section.CODE, "rt_alloc")
    number_text.machine = layout.resolve(number_text.machine)
    @number_text_bytes = [
        19, 1, 1, 253, 35, 38, 17, 2,
        147, 82, 53, 64, 19, 3, 0, 0,
        99, 214, 2, 0, 19, 3, 16, 0,
        179, 2, 80, 64, 147, 3, 1, 0,
        19, 14, 0, 0, 99, 154, 2, 0,
        147, 14, 0, 3, 35, 128, 211, 1,
        19, 14, 16, 0, 111, 0, 128, 3,
        147, 14, 160, 0, 19, 15, 0, 0,
        147, 143, 2, 0, 99, 232, 223, 1,
        147, 143, 111, 255, 19, 15, 31, 0,
        111, 240, 95, 255, 147, 143, 15, 3,
        179, 142, 195, 1, 35, 128, 254, 1,
        19, 14, 30, 0, 147, 2, 15, 0,
        227, 152, 2, 252, 99, 4, 3, 0,
        19, 14, 30, 0, 35, 36, 193, 3,
        35, 34, 97, 2, 35, 32, 113, 2,
        19, 5, 94, 0, 239, 0, 0, 7,
        3, 46, 129, 2, 3, 35, 65, 2,
        131, 35, 1, 2, 147, 14, 16, 0,
        35, 32, 213, 1, 35, 38, 197, 1,
        147, 14, 0, 0, 99, 10, 3, 0,
        19, 15, 208, 2, 35, 8, 229, 1,
        147, 14, 16, 0, 19, 14, 254, 255,
        99, 0, 14, 2, 19, 14, 254, 255,
        51, 143, 195, 1, 131, 79, 15, 0,
        51, 15, 213, 1, 35, 8, 255, 1,
        147, 142, 30, 0, 111, 240, 95, 254,
        51, 15, 213, 1, 35, 8, 15, 0,
        19, 101, 53, 0, 131, 32, 193, 2,
        19, 1, 1, 3, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод number text: длина", number_text.machine.code.length, 244)
    suite = testing.test_equal(suite, "перевод number text: двенадцать переходов", number_text.machine.patch_count, 11)
    drum (244) {
        suite = testing.test_equal(suite, "перевод number text: байт {beat}", buffer.byte_at(number_text.machine.code, beat), group.get(number_text_bytes, beat))
    }
    @number_text_label = layout.find_label(number_text.machine, "rt_number_text")
    @number_abs = layout.find_label(number_text.machine, ".L_number_abs")
    @number_digits = layout.find_label(number_text.machine, ".L_number_digits")
    @number_digit_loop = layout.find_label(number_text.machine, ".L_number_digit_loop")
    @number_div10 = layout.find_label(number_text.machine, ".L_number_div10")
    @number_remainder = layout.find_label(number_text.machine, ".L_number_remainder")
    @number_ready = layout.find_label(number_text.machine, ".L_number_ready")
    @number_alloc = layout.find_label(number_text.machine, ".L_number_alloc")
    @number_copy = layout.find_label(number_text.machine, ".L_number_copy")
    @number_done = layout.find_label(number_text.machine, ".L_number_done")
    @number_text_alloc = layout.find_label(number_text.machine, "rt_alloc")
    suite = testing.test_yes(suite, "перевод rt_number_text: метка существует", number_text_label.present)
    suite = testing.test_equal(suite, "перевод rt_number_text: смещение", number_text_label.offset, 0)
    suite = testing.test_yes(suite, "number text: модуль существует", number_abs.present)
    suite = testing.test_equal(suite, "number text: смещение модуля", number_abs.offset, 28)
    suite = testing.test_yes(suite, "number text: цифры существуют", number_digits.present)
    suite = testing.test_equal(suite, "number text: смещение цифр", number_digits.offset, 56)
    suite = testing.test_yes(suite, "number text: цикл цифры существует", number_digit_loop.present)
    suite = testing.test_equal(suite, "number text: смещение цикла цифры", number_digit_loop.offset, 60)
    suite = testing.test_yes(suite, "number text: деление существует", number_div10.present)
    suite = testing.test_equal(suite, "number text: смещение деления", number_div10.offset, 68)
    suite = testing.test_yes(suite, "number text: остаток существует", number_remainder.present)
    suite = testing.test_equal(suite, "number text: смещение остатка", number_remainder.offset, 84)
    suite = testing.test_yes(suite, "number text: готовность существует", number_ready.present)
    suite = testing.test_equal(suite, "number text: смещение готовности", number_ready.offset, 108)
    suite = testing.test_yes(suite, "number text: выделение существует", number_alloc.present)
    suite = testing.test_equal(suite, "number text: смещение выделения", number_alloc.offset, 116)
    suite = testing.test_yes(suite, "number text: копирование существует", number_copy.present)
    suite = testing.test_equal(suite, "number text: смещение копирования", number_copy.offset, 184)
    suite = testing.test_yes(suite, "number text: завершение существует", number_done.present)
    suite = testing.test_equal(suite, "number text: смещение завершения", number_done.offset, 216)
    suite = testing.test_yes(suite, "number text: связанный alloc существует", number_text_alloc.present)
    suite = testing.test_equal(suite, "number text: смещение alloc", number_text_alloc.offset, 244)

    out suite
}
