-- tr_text — эталоны перевода в машинный код, часть translation:
-- тексты: fixed show, group add, cstring, склейка, срезы, регистр, число в текст.
-- Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use craft.testing
use selfhost.compiler.state
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.buffer
use selfhost.compiler.backend.rv32i.runtime.collections
use selfhost.compiler.backend.rv32i.runtime.fixed
use selfhost.compiler.backend.rv32i.runtime.numbers
use selfhost.compiler.backend.rv32i.runtime.strings

skill run(suite) {
    @fixed_show = state.State {}
    fixed_show = fixed.emit_fixed_show(fixed_show)
    fixed_show.machine = layout.define_label(fixed_show.machine, layout.Section.CODE, "rt_alloc")
    fixed_show.machine = layout.define_label(fixed_show.machine, layout.Section.CODE, "rt_show")
    fixed_show.machine = layout.resolve(fixed_show.machine)
    @fixed_show_bytes = [
        19, 1, 1, 252, 35, 46, 17, 2,
        179, 2, 5, 0, 147, 3, 0, 0,
        19, 14, 64, 0, 99, 24, 200, 1,
        99, 214, 2, 0, 147, 3, 16, 0,
        179, 2, 80, 64, 19, 14, 0, 0,
        147, 14, 0, 0, 19, 15, 0, 0,
        147, 15, 0, 2, 179, 134, 2, 0,
        19, 215, 246, 1, 147, 150, 22, 0,
        19, 31, 31, 0, 51, 111, 239, 0,
        147, 158, 30, 0, 19, 7, 160, 0,
        99, 102, 239, 0, 19, 15, 111, 255,
        147, 238, 30, 0, 147, 143, 255, 255,
        227, 156, 15, 252, 19, 15, 15, 3,
        51, 7, 193, 1, 35, 0, 231, 1,
        19, 14, 30, 0, 179, 130, 14, 0,
        227, 152, 2, 250, 179, 14, 126, 0,
        35, 44, 193, 3, 35, 42, 113, 2,
        35, 40, 209, 3, 19, 133, 94, 0,
        239, 0, 0, 7, 3, 46, 129, 3,
        131, 35, 65, 3, 131, 46, 1, 3,
        19, 15, 16, 0, 35, 32, 229, 1,
        35, 38, 213, 1, 19, 15, 0, 0,
        99, 136, 3, 0, 147, 15, 208, 2,
        35, 8, 245, 1, 19, 15, 16, 0,
        99, 0, 14, 2, 19, 14, 254, 255,
        179, 15, 193, 1, 131, 207, 15, 0,
        179, 6, 229, 1, 35, 136, 246, 1,
        19, 15, 31, 0, 111, 240, 95, 254,
        179, 6, 213, 1, 35, 136, 6, 0,
        19, 101, 53, 0, 239, 0, 64, 1,
        131, 32, 193, 3, 19, 1, 1, 4,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод fixed show: длина", fixed_show.machine.code.length, 256)
    suite = testing.test_equal(suite, "перевод fixed show: двенадцать переходов", fixed_show.machine.patch_count, 10)
    drum (256) {
        suite = testing.test_equal(suite, "перевод fixed show: байт {beat}", buffer.byte_at(fixed_show.machine.code, beat), group.get(fixed_show_bytes, beat))
    }
    @fixed_show_label = layout.find_label(fixed_show.machine, "rt_fixed_show")
    @fixed_text_digits = layout.find_label(fixed_show.machine, ".L_fixed_text_digits")
    @fixed_text_digit = layout.find_label(fixed_show.machine, ".L_fixed_text_digit")
    @fixed_text_div10 = layout.find_label(fixed_show.machine, ".L_fixed_text_div10")
    @fixed_text_div10_next = layout.find_label(fixed_show.machine, ".L_fixed_text_div10_next")
    @fixed_text_copy = layout.find_label(fixed_show.machine, ".L_fixed_text_copy")
    @fixed_text_done = layout.find_label(fixed_show.machine, ".L_fixed_text_done")
    @fixed_show_alloc = layout.find_label(fixed_show.machine, "rt_alloc")
    @fixed_show_show = layout.find_label(fixed_show.machine, "rt_show")
    suite = testing.test_yes(suite, "перевод rt_fixed_show: метка существует", fixed_show_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_show: смещение", fixed_show_label.offset, 0)
    suite = testing.test_yes(suite, "fixed show: цифры существуют", fixed_text_digits.present)
    suite = testing.test_equal(suite, "fixed show: смещение цифр", fixed_text_digits.offset, 36)
    suite = testing.test_yes(suite, "fixed show: цифра существует", fixed_text_digit.present)
    suite = testing.test_equal(suite, "fixed show: смещение цифры", fixed_text_digit.offset, 40)
    suite = testing.test_yes(suite, "fixed show: деление существует", fixed_text_div10.present)
    suite = testing.test_equal(suite, "fixed show: смещение деления", fixed_text_div10.offset, 56)
    suite = testing.test_yes(suite, "fixed show: шаг деления существует", fixed_text_div10_next.present)
    suite = testing.test_equal(suite, "fixed show: смещение шага деления", fixed_text_div10_next.offset, 92)
    suite = testing.test_yes(suite, "fixed show: копирование существует", fixed_text_copy.present)
    suite = testing.test_equal(suite, "fixed show: смещение копирования", fixed_text_copy.offset, 192)
    suite = testing.test_yes(suite, "fixed show: завершение существует", fixed_text_done.present)
    suite = testing.test_equal(suite, "fixed show: смещение завершения", fixed_text_done.offset, 224)
    suite = testing.test_yes(suite, "fixed show: связанный alloc существует", fixed_show_alloc.present)
    suite = testing.test_equal(suite, "fixed show: смещение alloc", fixed_show_alloc.offset, 256)
    suite = testing.test_yes(suite, "fixed show: связанный show существует", fixed_show_show.present)
    suite = testing.test_equal(suite, "fixed show: смещение show", fixed_show_show.offset, 256)

    @group_add = state.State {}
    group_add = collections.emit_group_add(group_add)
    group_add.machine = layout.define_label(group_add.machine, layout.Section.CODE, "rt_alloc")
    group_add.machine = layout.resolve(group_add.machine)
    @group_add_bytes = [
        19, 1, 1, 255, 35, 38, 17, 0,
        35, 36, 161, 0, 35, 34, 177, 0,
        147, 114, 133, 255, 3, 163, 194, 0,
        19, 5, 35, 0, 19, 21, 37, 0,
        239, 0, 128, 6, 131, 34, 129, 0,
        147, 242, 130, 255, 3, 163, 194, 0,
        147, 3, 19, 0, 19, 14, 32, 0,
        35, 32, 197, 1, 35, 38, 117, 0,
        147, 3, 0, 0, 99, 128, 99, 2,
        19, 158, 35, 0, 179, 142, 194, 1,
        3, 175, 14, 1, 179, 14, 197, 1,
        35, 168, 238, 1, 147, 131, 19, 0,
        111, 240, 95, 254, 19, 30, 35, 0,
        51, 14, 197, 1, 131, 46, 65, 0,
        35, 40, 222, 1, 19, 101, 69, 0,
        131, 32, 193, 0, 19, 1, 1, 1,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод group add: длина", group_add.machine.code.length, 136)
    suite = testing.test_equal(suite, "перевод group add: четыре перехода", group_add.machine.patch_count, 3)
    drum (136) {
        suite = testing.test_equal(suite, "перевод group add: байт {beat}", buffer.byte_at(group_add.machine.code, beat), group.get(group_add_bytes, beat))
    }
    @group_add_label = layout.find_label(group_add.machine, "rt_group_add")
    @group_copy = layout.find_label(group_add.machine, ".L_group_copy")
    @group_copy_done = layout.find_label(group_add.machine, ".L_group_copy_done")
    @group_add_alloc = layout.find_label(group_add.machine, "rt_alloc")
    suite = testing.test_yes(suite, "перевод rt_group_add: метка существует", group_add_label.present)
    suite = testing.test_equal(suite, "перевод rt_group_add: смещение", group_add_label.offset, 0)
    suite = testing.test_yes(suite, "group add: копирование существует", group_copy.present)
    suite = testing.test_equal(suite, "group add: смещение копирования", group_copy.offset, 68)
    suite = testing.test_yes(suite, "group add: завершение существует", group_copy_done.present)
    suite = testing.test_equal(suite, "group add: смещение завершения", group_copy_done.offset, 100)
    suite = testing.test_yes(suite, "group add: связанный alloc существует", group_add_alloc.present)
    suite = testing.test_equal(suite, "group add: смещение alloc", group_add_alloc.offset, 136)

    @cstring = state.State {}
    cstring = strings.emit_cstring(cstring)
    cstring.machine = layout.define_label(cstring.machine, layout.Section.CODE, "rt_alloc")
    cstring.machine = layout.resolve(cstring.machine)
    @cstring_bytes = [
        19, 1, 1, 255, 35, 38, 17, 0,
        35, 36, 161, 0, 147, 2, 5, 0,
        19, 3, 0, 0, 131, 195, 2, 0,
        99, 136, 3, 0, 147, 130, 18, 0,
        19, 3, 19, 0, 111, 240, 31, 255,
        35, 34, 97, 0, 19, 5, 83, 0,
        239, 0, 192, 4, 3, 35, 65, 0,
        147, 3, 16, 0, 35, 32, 117, 0,
        35, 38, 101, 0, 131, 34, 129, 0,
        147, 3, 0, 0, 99, 110, 115, 0,
        51, 142, 114, 0, 131, 78, 14, 0,
        51, 14, 117, 0, 35, 8, 222, 1,
        147, 131, 19, 0, 111, 240, 159, 254,
        19, 101, 53, 0, 131, 32, 193, 0,
        19, 1, 1, 1, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод cstring: длина", cstring.machine.code.length, 124)
    suite = testing.test_equal(suite, "перевод cstring: шесть переходов", cstring.machine.patch_count, 5)
    drum (124) {
        suite = testing.test_equal(suite, "перевод cstring: байт {beat}", buffer.byte_at(cstring.machine.code, beat), group.get(cstring_bytes, beat))
    }
    @cstring_label = layout.find_label(cstring.machine, "rt_cstring")
    @cstring_len = layout.find_label(cstring.machine, ".L_cstring_len")
    @cstring_alloc = layout.find_label(cstring.machine, ".L_cstring_alloc")
    @cstring_copy = layout.find_label(cstring.machine, ".L_cstring_copy")
    @cstring_done = layout.find_label(cstring.machine, ".L_cstring_done")
    @cstring_rt_alloc = layout.find_label(cstring.machine, "rt_alloc")
    suite = testing.test_yes(suite, "перевод rt_cstring: метка существует", cstring_label.present)
    suite = testing.test_equal(suite, "перевод rt_cstring: смещение", cstring_label.offset, 0)
    suite = testing.test_yes(suite, "cstring: подсчёт существует", cstring_len.present)
    suite = testing.test_equal(suite, "cstring: смещение подсчёта", cstring_len.offset, 20)
    suite = testing.test_yes(suite, "cstring: выделение существует", cstring_alloc.present)
    suite = testing.test_equal(suite, "cstring: смещение выделения", cstring_alloc.offset, 40)
    suite = testing.test_yes(suite, "cstring: копирование существует", cstring_copy.present)
    suite = testing.test_equal(suite, "cstring: смещение копирования", cstring_copy.offset, 76)
    suite = testing.test_yes(suite, "cstring: завершение существует", cstring_done.present)
    suite = testing.test_equal(suite, "cstring: смещение завершения", cstring_done.offset, 104)
    suite = testing.test_yes(suite, "cstring: связанный alloc существует", cstring_rt_alloc.present)
    suite = testing.test_equal(suite, "cstring: смещение alloc", cstring_rt_alloc.offset, 124)

    @string_add = state.State {}
    string_add = strings.emit_string_add(string_add)
    string_add.machine = layout.define_label(string_add.machine, layout.Section.CODE, "rt_alloc")
    string_add.machine = layout.resolve(string_add.machine)
    @string_add_bytes = [
        19, 1, 1, 254, 35, 46, 17, 0,
        147, 114, 133, 255, 19, 243, 133, 255,
        35, 44, 81, 0, 35, 42, 97, 0,
        131, 163, 194, 0, 3, 46, 195, 0,
        35, 40, 113, 0, 35, 38, 193, 1,
        179, 142, 195, 1, 35, 36, 209, 1,
        19, 133, 94, 0, 239, 0, 64, 8,
        131, 46, 129, 0, 19, 15, 16, 0,
        35, 32, 229, 1, 35, 38, 213, 1,
        19, 15, 0, 0, 131, 34, 129, 1,
        3, 35, 65, 1, 131, 35, 1, 1,
        99, 14, 127, 0, 51, 142, 226, 1,
        131, 78, 14, 1, 51, 14, 229, 1,
        35, 8, 222, 1, 19, 15, 31, 0,
        111, 240, 159, 254, 147, 15, 0, 0,
        131, 35, 193, 0, 99, 128, 127, 2,
        51, 14, 243, 1, 131, 78, 14, 1,
        51, 14, 229, 1, 35, 8, 222, 1,
        19, 15, 31, 0, 147, 143, 31, 0,
        111, 240, 95, 254, 51, 14, 229, 1,
        35, 8, 14, 0, 19, 101, 53, 0,
        131, 32, 193, 1, 19, 1, 1, 2,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод string add: длина", string_add.machine.code.length, 184)
    suite = testing.test_equal(suite, "перевод string add: шесть переходов", string_add.machine.patch_count, 5)
    drum (184) {
        suite = testing.test_equal(suite, "перевод string add: байт {beat}", buffer.byte_at(string_add.machine.code, beat), group.get(string_add_bytes, beat))
    }
    @string_add_label = layout.find_label(string_add.machine, "rt_string_add")
    @string_left = layout.find_label(string_add.machine, ".L_string_left")
    @string_right_start = layout.find_label(string_add.machine, ".L_string_right_start")
    @string_right = layout.find_label(string_add.machine, ".L_string_right")
    @string_done = layout.find_label(string_add.machine, ".L_string_done")
    @string_add_alloc = layout.find_label(string_add.machine, "rt_alloc")
    suite = testing.test_yes(suite, "перевод rt_string_add: метка существует", string_add_label.present)
    suite = testing.test_equal(suite, "перевод rt_string_add: смещение", string_add_label.offset, 0)
    suite = testing.test_yes(suite, "string add: левая часть существует", string_left.present)
    suite = testing.test_equal(suite, "string add: смещение левой части", string_left.offset, 88)
    suite = testing.test_yes(suite, "string add: начало правой части существует", string_right_start.present)
    suite = testing.test_equal(suite, "string add: смещение начала правой части", string_right_start.offset, 116)
    suite = testing.test_yes(suite, "string add: правая часть существует", string_right.present)
    suite = testing.test_equal(suite, "string add: смещение правой части", string_right.offset, 124)
    suite = testing.test_yes(suite, "string add: завершение существует", string_done.present)
    suite = testing.test_equal(suite, "string add: смещение завершения", string_done.offset, 156)
    suite = testing.test_yes(suite, "string add: связанный alloc существует", string_add_alloc.present)
    suite = testing.test_equal(suite, "string add: смещение alloc", string_add_alloc.offset, 184)

    @string_at = state.State {}
    string_at = strings.emit_string_at(string_at)
    string_at.machine = layout.define_label(string_at.machine, layout.Section.CODE, "rt_alloc")
    string_at.machine = layout.define_label(string_at.machine, layout.Section.CODE, "rt_string_bounds")
    string_at.machine = layout.resolve(string_at.machine)
    @string_at_bytes = [
        19, 1, 1, 255, 35, 38, 17, 0,
        147, 114, 133, 255, 147, 213, 53, 64,
        3, 163, 194, 0, 99, 244, 101, 4,
        179, 130, 178, 0, 3, 195, 2, 1,
        35, 36, 97, 0, 19, 5, 96, 0,
        239, 0, 64, 3, 147, 2, 16, 0,
        35, 32, 85, 0, 147, 2, 16, 0,
        35, 38, 85, 0, 3, 35, 129, 0,
        35, 8, 101, 0, 163, 8, 5, 0,
        19, 101, 53, 0, 131, 32, 193, 0,
        19, 1, 1, 1, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод string at: длина", string_at.machine.code.length, 92)
    suite = testing.test_equal(suite, "перевод string at: три перехода", string_at.machine.patch_count, 2)
    drum (92) {
        suite = testing.test_equal(suite, "перевод string at: байт {beat}", buffer.byte_at(string_at.machine.code, beat), group.get(string_at_bytes, beat))
    }
    @string_at_label = layout.find_label(string_at.machine, "rt_string_at")
    @string_at_alloc = layout.find_label(string_at.machine, "rt_alloc")
    @string_at_bounds = layout.find_label(string_at.machine, "rt_string_bounds")
    suite = testing.test_yes(suite, "перевод rt_string_at: метка существует", string_at_label.present)
    suite = testing.test_equal(suite, "перевод rt_string_at: смещение", string_at_label.offset, 0)
    suite = testing.test_yes(suite, "string at: связанный alloc существует", string_at_alloc.present)
    suite = testing.test_equal(suite, "string at: смещение alloc", string_at_alloc.offset, 92)
    suite = testing.test_yes(suite, "string at: связанные границы существуют", string_at_bounds.present)
    suite = testing.test_equal(suite, "string at: смещение границ", string_at_bounds.offset, 92)

    @string_slice = state.State {}
    string_slice = strings.emit_string_slice(string_slice)
    string_slice.machine = layout.define_label(string_slice.machine, layout.Section.CODE, "rt_alloc")
    string_slice.machine = layout.define_label(string_slice.machine, layout.Section.CODE, "rt_string_bounds")
    string_slice.machine = layout.resolve(string_slice.machine)
    @string_slice_bytes = [
        19, 1, 1, 254, 35, 46, 17, 0,
        147, 114, 133, 255, 147, 213, 53, 64,
        19, 86, 54, 64, 3, 163, 194, 0,
        99, 108, 182, 6, 99, 106, 195, 6,
        179, 3, 182, 64, 35, 44, 81, 0,
        35, 42, 177, 0, 35, 40, 113, 0,
        19, 133, 83, 0, 239, 0, 192, 5,
        131, 34, 129, 1, 3, 35, 65, 1,
        131, 35, 1, 1, 19, 14, 16, 0,
        35, 32, 197, 1, 35, 38, 117, 0,
        19, 14, 0, 0, 99, 0, 126, 2,
        179, 14, 195, 1, 179, 142, 210, 1,
        3, 207, 14, 1, 179, 14, 197, 1,
        35, 136, 238, 1, 19, 14, 30, 0,
        111, 240, 95, 254, 179, 14, 117, 0,
        35, 136, 14, 0, 19, 101, 53, 0,
        131, 32, 193, 1, 19, 1, 1, 2,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод string slice: длина", string_slice.machine.code.length, 144)
    suite = testing.test_equal(suite, "перевод string slice: шесть переходов", string_slice.machine.patch_count, 5)
    drum (144) {
        suite = testing.test_equal(suite, "перевод string slice: байт {beat}", buffer.byte_at(string_slice.machine.code, beat), group.get(string_slice_bytes, beat))
    }
    @string_slice_label = layout.find_label(string_slice.machine, "rt_string_slice")
    @slice_copy = layout.find_label(string_slice.machine, ".L_slice_copy")
    @slice_done = layout.find_label(string_slice.machine, ".L_slice_done")
    @string_slice_alloc = layout.find_label(string_slice.machine, "rt_alloc")
    @string_slice_bounds = layout.find_label(string_slice.machine, "rt_string_bounds")
    suite = testing.test_yes(suite, "перевод rt_string_slice: метка существует", string_slice_label.present)
    suite = testing.test_equal(suite, "перевод rt_string_slice: смещение", string_slice_label.offset, 0)
    suite = testing.test_yes(suite, "string slice: копирование существует", slice_copy.present)
    suite = testing.test_equal(suite, "string slice: смещение копирования", slice_copy.offset, 84)
    suite = testing.test_yes(suite, "string slice: завершение существует", slice_done.present)
    suite = testing.test_equal(suite, "string slice: смещение завершения", slice_done.offset, 116)
    suite = testing.test_yes(suite, "string slice: связанный alloc существует", string_slice_alloc.present)
    suite = testing.test_equal(suite, "string slice: смещение alloc", string_slice_alloc.offset, 144)
    suite = testing.test_yes(suite, "string slice: связанные границы существуют", string_slice_bounds.present)
    suite = testing.test_equal(suite, "string slice: смещение границ", string_slice_bounds.offset, 144)

    @string_case = state.State {}
    string_case = strings.emit_string_lower(string_case)
    string_case = strings.emit_string_upper(string_case)
    string_case = strings.emit_string_case(string_case)
    string_case.machine = layout.define_label(string_case.machine, layout.Section.CODE, "rt_alloc")
    string_case.machine = layout.resolve(string_case.machine)
    @string_case_bytes = [
        147, 5, 0, 0, 111, 0, 128, 0,
        147, 5, 16, 0, 19, 1, 1, 254,
        35, 46, 17, 0, 147, 114, 133, 255,
