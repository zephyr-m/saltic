-- tr_objects — эталоны перевода в машинный код, часть translation:
-- Box, группы и строки: чтение полей, границы, дерево группы, поиск в строке.
-- Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use craft.testing
use selfhost.compiler.state
use selfhost.machine.layout
use selfhost.machine.buffer
use selfhost.compiler.runtime.emit.collections
use selfhost.compiler.runtime.emit.strings

skill run(suite) {
    @boxes = state.State {}
    boxes = collections.emit_box_get(boxes)
    boxes = collections.emit_box_set(boxes)
    boxes = collections.emit_missing_field(boxes)
    boxes.machine = layout.define_label(boxes.machine, layout.Section.CODE, "rt_region_barrier")
    boxes.machine = layout.resolve(boxes.machine)
    @box_bytes = [
        19, 117, 133, 255, 131, 34, 197, 0,
        99, 112, 86, 2, 19, 19, 54, 0,
        51, 3, 101, 0, 131, 35, 3, 1,
        99, 152, 179, 0, 3, 37, 67, 1,
        147, 5, 0, 0, 103, 128, 0, 0,
        19, 5, 5, 1, 99, 128, 2, 8,
        3, 35, 5, 0, 99, 8, 179, 0,
        19, 5, 133, 0, 147, 130, 242, 255,
        111, 240, 223, 254, 3, 37, 69, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        19, 117, 133, 255, 147, 3, 5, 0,
        131, 34, 197, 0, 99, 242, 86, 2,
        19, 147, 54, 0, 51, 131, 99, 0,
        3, 46, 3, 1, 99, 26, 190, 0,
        35, 42, 195, 0, 19, 5, 32, 0,
        147, 5, 0, 0, 111, 0, 192, 3,
        19, 5, 5, 1, 99, 132, 2, 2,
        3, 35, 5, 0, 99, 8, 179, 0,
        19, 5, 133, 0, 147, 130, 242, 255,
        111, 240, 223, 254, 35, 34, 197, 0,
        19, 5, 32, 0, 147, 5, 0, 0,
        111, 0, 0, 1, 19, 5, 0, 0,
        147, 5, 16, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод Box: длина", boxes.machine.code.length, 184)
    suite = testing.test_equal(suite, "перевод Box: двенадцать переходов", boxes.machine.patch_count, 12)
    drum (184) {
        suite = testing.test_equal(suite, "перевод Box: байт {beat}", buffer.byte_at(boxes.machine.code, beat), group.get(box_bytes, beat))
    }
    @box_get = layout.find_label(boxes.machine, "rt_box_get")
    @box_get_loop = layout.find_label(boxes.machine, ".L_box_get_loop")
    @box_get_found = layout.find_label(boxes.machine, ".L_box_get_found")
    @box_set = layout.find_label(boxes.machine, "rt_box_set")
    @box_set_loop = layout.find_label(boxes.machine, ".L_box_set_loop")
    @box_set_found = layout.find_label(boxes.machine, ".L_box_set_found")
    @missing_field = layout.find_label(boxes.machine, "rt_missing_field")
    suite = testing.test_yes(suite, "перевод rt_box_get: метка существует", box_get.present)
    suite = testing.test_equal(suite, "перевод rt_box_get: смещение", box_get.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_box_get: цикл существует", box_get_loop.present)
    suite = testing.test_equal(suite, "перевод rt_box_get: смещение цикла", box_get_loop.offset, 44)
    suite = testing.test_yes(suite, "перевод rt_box_get: поле найдено", box_get_found.present)
    suite = testing.test_equal(suite, "перевод rt_box_get: смещение найденного поля", box_get_found.offset, 68)
    suite = testing.test_yes(suite, "перевод rt_box_set: метка существует", box_set.present)
    suite = testing.test_equal(suite, "перевод rt_box_set: смещение", box_set.offset, 80)
    suite = testing.test_yes(suite, "перевод rt_box_set: цикл существует", box_set_loop.present)
    suite = testing.test_equal(suite, "перевод rt_box_set: смещение цикла", box_set_loop.offset, 132)
    suite = testing.test_yes(suite, "перевод rt_box_set: поле найдено", box_set_found.present)
    suite = testing.test_equal(suite, "перевод rt_box_set: смещение найденного поля", box_set_found.offset, 156)
    suite = testing.test_yes(suite, "перевод отсутствующего поля: метка существует", missing_field.present)
    suite = testing.test_equal(suite, "перевод отсутствующего поля: смещение", missing_field.offset, 172)

    @groups = state.State {}
    groups = collections.emit_group_count(groups)
    groups = collections.emit_group_at(groups)
    groups = collections.emit_group_bounds(groups)
    groups = collections.emit_group_tree_at(groups)
    groups.machine = layout.resolve(groups.machine)
    @group_bytes = [
        19, 117, 133, 255, 3, 37, 197, 0,
        19, 21, 53, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 117, 133, 255,
        147, 213, 53, 64, 131, 34, 5, 0,
        19, 3, 64, 0, 99, 134, 98, 2,
        131, 34, 197, 0, 99, 252, 85, 0,
        147, 149, 37, 0, 51, 5, 181, 0,
        3, 37, 5, 1, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 0, 0,
        147, 5, 32, 0, 103, 128, 0, 0,
        131, 34, 197, 0, 227, 248, 85, 254,
        3, 35, 133, 1, 19, 115, 131, 255,
        131, 35, 195, 0, 51, 142, 114, 64,
        99, 252, 197, 5, 131, 46, 5, 1,
        3, 47, 69, 1, 19, 127, 143, 255,
        147, 143, 254, 255, 19, 158, 47, 0,
        179, 143, 207, 1, 99, 130, 15, 2,
        51, 222, 245, 1, 19, 126, 254, 1,
        19, 30, 46, 0, 51, 14, 207, 1,
        3, 47, 14, 1, 19, 127, 143, 255,
        147, 143, 191, 255, 111, 240, 31, 254,
        19, 254, 245, 1, 19, 30, 46, 0,
        51, 14, 207, 1, 3, 37, 14, 1,
        147, 5, 0, 0, 103, 128, 0, 0,
        51, 142, 197, 65, 19, 30, 46, 0,
        51, 14, 195, 1, 3, 37, 14, 1,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод чтения Group: длина", groups.machine.code.length, 216)
    suite = testing.test_equal(suite, "перевод чтения Group: переходов", groups.machine.patch_count, 6)
    drum (216) {
        suite = testing.test_equal(suite, "перевод чтения Group: байт {beat}", buffer.byte_at(groups.machine.code, beat), group.get(group_bytes, beat))
    }
    @group_count = layout.find_label(groups.machine, "rt_group_count")
    @group_at = layout.find_label(groups.machine, "rt_group_at")
    @group_bounds = layout.find_label(groups.machine, "rt_group_bounds")
    @group_tree_at = layout.find_label(groups.machine, "rt_group_tree_at")
    suite = testing.test_yes(suite, "перевод rt_group_count: метка существует", group_count.present)
    suite = testing.test_equal(suite, "перевод rt_group_count: смещение", group_count.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_group_at: метка существует", group_at.present)
    suite = testing.test_equal(suite, "перевод rt_group_at: смещение", group_at.offset, 20)
    suite = testing.test_yes(suite, "перевод границ Group: метка существует", group_bounds.present)
    suite = testing.test_equal(suite, "перевод границ Group: смещение", group_bounds.offset, 68)
    suite = testing.test_yes(suite, "перевод дерева Group: метка существует", group_tree_at.present)
    suite = testing.test_equal(suite, "перевод дерева Group: смещение", group_tree_at.offset, 80)

    @string_read = state.State {}
    string_read = strings.emit_string_len(string_read)
    string_read = strings.emit_string_byte(string_read)
    string_read = strings.emit_string_bounds(string_read)
    string_read.machine = layout.resolve(string_read.machine)
    @string_read_bytes = [
        19, 117, 133, 255, 3, 37, 197, 0,
        19, 21, 53, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 147, 114, 133, 255,
        147, 213, 53, 64, 3, 163, 194, 0,
        99, 252, 101, 0, 179, 130, 178, 0,
        3, 197, 2, 1, 19, 21, 53, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        19, 5, 0, 0, 147, 5, 80, 0,
        103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод чтения String: длина", string_read.machine.code.length, 68)
    suite = testing.test_equal(suite, "перевод чтения String: один переход", string_read.machine.patch_count, 1)
    drum (68) {
        suite = testing.test_equal(suite, "перевод чтения String: байт {beat}", buffer.byte_at(string_read.machine.code, beat), group.get(string_read_bytes, beat))
    }
    @string_len = layout.find_label(string_read.machine, "rt_string_len")
    @string_byte = layout.find_label(string_read.machine, "rt_string_byte")
    @string_bounds = layout.find_label(string_read.machine, "rt_string_bounds")
    suite = testing.test_yes(suite, "перевод rt_string_len: метка существует", string_len.present)
    suite = testing.test_equal(suite, "перевод rt_string_len: смещение", string_len.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_string_byte: метка существует", string_byte.present)
    suite = testing.test_equal(suite, "перевод rt_string_byte: смещение", string_byte.offset, 20)
    suite = testing.test_yes(suite, "перевод границ String: метка существует", string_bounds.present)
    suite = testing.test_equal(suite, "перевод границ String: смещение", string_bounds.offset, 56)

    @string_match = state.State {}
    string_match = strings.emit_string_starts_with(string_match)
    string_match = strings.emit_string_ends_with(string_match)
    string_match.machine = layout.resolve(string_match.machine)
    @string_match_bytes = [
        19, 117, 133, 255, 147, 245, 133, 255,
        131, 34, 197, 0, 3, 163, 197, 0,
        99, 238, 98, 4, 147, 3, 0, 0,
        111, 0, 128, 2, 19, 117, 133, 255,
        147, 245, 133, 255, 131, 34, 197, 0,
        3, 163, 197, 0, 99, 224, 98, 4,
        51, 5, 5, 64, 51, 142, 98, 64,
        51, 5, 197, 1, 147, 3, 0, 0,
        99, 128, 99, 2, 51, 14, 117, 0,
        179, 142, 117, 0, 3, 78, 14, 1,
        131, 206, 14, 1, 99, 28, 222, 1,
        147, 131, 19, 0, 111, 240, 95, 254,
        19, 5, 144, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 16, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод начала и конца String: длина", string_match.machine.code.length, 120)
    suite = testing.test_equal(suite, "перевод начала и конца String: шесть переходов", string_match.machine.patch_count, 6)
    drum (120) {
        suite = testing.test_equal(suite, "перевод начала и конца String: байт {beat}", buffer.byte_at(string_match.machine.code, beat), group.get(string_match_bytes, beat))
    }
    @string_starts_with = layout.find_label(string_match.machine, "rt_string_starts_with")
    @string_ends_with = layout.find_label(string_match.machine, "rt_string_ends_with")
    @string_match_loop = layout.find_label(string_match.machine, ".L_string_match_loop")
    @string_match_yes = layout.find_label(string_match.machine, ".L_string_match_yes")
    @string_match_no = layout.find_label(string_match.machine, ".L_string_match_no")
    suite = testing.test_yes(suite, "перевод rt_string_starts_with: метка существует", string_starts_with.present)
    suite = testing.test_equal(suite, "перевод rt_string_starts_with: смещение", string_starts_with.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_string_ends_with: метка существует", string_ends_with.present)
    suite = testing.test_equal(suite, "перевод rt_string_ends_with: смещение", string_ends_with.offset, 28)
    suite = testing.test_yes(suite, "перевод String: цикл сравнения существует", string_match_loop.present)
    suite = testing.test_equal(suite, "перевод String: смещение цикла сравнения", string_match_loop.offset, 64)
    suite = testing.test_yes(suite, "перевод String: ветка yes существует", string_match_yes.present)
    suite = testing.test_equal(suite, "перевод String: смещение yes", string_match_yes.offset, 96)
    suite = testing.test_yes(suite, "перевод String: ветка no существует", string_match_no.present)
    suite = testing.test_equal(suite, "перевод String: смещение no", string_match_no.offset, 108)

    @string_contains = state.State {}
    string_contains = strings.emit_string_contains(string_contains)
    string_contains.machine = layout.resolve(string_contains.machine)
    @string_contains_bytes = [
        19, 117, 133, 255, 147, 245, 133, 255,
        131, 34, 197, 0, 3, 163, 197, 0,
        99, 4, 3, 4, 99, 232, 98, 4,
        179, 131, 98, 64, 147, 131, 19, 0,
        19, 14, 0, 0, 99, 0, 126, 4,
        147, 14, 0, 0, 99, 134, 110, 2,
        51, 15, 222, 1, 51, 15, 229, 1,
        3, 79, 15, 1, 179, 143, 213, 1,
        131, 207, 15, 1, 99, 22, 255, 1,
        147, 142, 30, 0, 111, 240, 31, 254,
        19, 14, 30, 0, 111, 240, 31, 253,
        19, 5, 144, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 16, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_string_contains: длина", string_contains.machine.code.length, 112)
    suite = testing.test_equal(suite, "перевод rt_string_contains: семь переходов", string_contains.machine.patch_count, 7)
    drum (112) {
        suite = testing.test_equal(suite, "перевод rt_string_contains: байт {beat}", buffer.byte_at(string_contains.machine.code, beat), group.get(string_contains_bytes, beat))
    }
    @string_contains_label = layout.find_label(string_contains.machine, "rt_string_contains")
    @string_contains_outer = layout.find_label(string_contains.machine, ".L_contains_outer")
    @string_contains_inner = layout.find_label(string_contains.machine, ".L_contains_inner")
    @string_contains_next = layout.find_label(string_contains.machine, ".L_contains_next")
    @string_contains_yes = layout.find_label(string_contains.machine, ".L_contains_yes")
    @string_contains_no = layout.find_label(string_contains.machine, ".L_contains_no")
    suite = testing.test_yes(suite, "перевод rt_string_contains: метка существует", string_contains_label.present)
    suite = testing.test_equal(suite, "перевод rt_string_contains: смещение", string_contains_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_string_contains: внешний цикл существует", string_contains_outer.present)
    suite = testing.test_equal(suite, "перевод rt_string_contains: смещение внешнего цикла", string_contains_outer.offset, 36)
    suite = testing.test_yes(suite, "перевод rt_string_contains: внутренний цикл существует", string_contains_inner.present)
    suite = testing.test_equal(suite, "перевод rt_string_contains: смещение внутреннего цикла", string_contains_inner.offset, 44)
    suite = testing.test_yes(suite, "перевод rt_string_contains: переход к следующей позиции существует", string_contains_next.present)
    suite = testing.test_equal(suite, "перевод rt_string_contains: смещение следующей позиции", string_contains_next.offset, 80)
    suite = testing.test_yes(suite, "перевод rt_string_contains: ветка yes существует", string_contains_yes.present)
    suite = testing.test_equal(suite, "перевод rt_string_contains: смещение yes", string_contains_yes.offset, 88)
    suite = testing.test_yes(suite, "перевод rt_string_contains: ветка no существует", string_contains_no.present)
    suite = testing.test_equal(suite, "перевод rt_string_contains: смещение no", string_contains_no.offset, 100)

    @line_count = state.State {}
    line_count = strings.emit_line_count(line_count)
    line_count.machine = layout.resolve(line_count.machine)
    @line_count_bytes = [
        19, 117, 133, 255, 131, 34, 197, 0,
        99, 134, 2, 4, 19, 3, 0, 0,
        147, 3, 0, 0, 99, 128, 83, 2,
        51, 14, 117, 0, 131, 78, 14, 1,
        19, 15, 160, 0, 99, 148, 238, 1,
        19, 3, 19, 0, 147, 131, 19, 0,
        111, 240, 95, 254, 51, 14, 85, 0,
        131, 78, 254, 0, 19, 15, 160, 0,
        99, 132, 238, 1, 19, 3, 19, 0,
        19, 21, 51, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 0, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_line_count: длина", line_count.machine.code.length, 96)
    suite = testing.test_equal(suite, "перевод rt_line_count: пять переходов", line_count.machine.patch_count, 5)
    drum (96) {
        suite = testing.test_equal(suite, "перевод rt_line_count: байт {beat}", buffer.byte_at(line_count.machine.code, beat), group.get(line_count_bytes, beat))
    }
    @line_count_label = layout.find_label(line_count.machine, "rt_line_count")
    @line_loop = layout.find_label(line_count.machine, ".L_line_loop")
    @line_next = layout.find_label(line_count.machine, ".L_line_next")
    @line_done = layout.find_label(line_count.machine, ".L_line_done")
    @line_encode = layout.find_label(line_count.machine, ".L_line_encode")
    @line_empty = layout.find_label(line_count.machine, ".L_line_empty")
    suite = testing.test_yes(suite, "перевод rt_line_count: метка существует", line_count_label.present)
    suite = testing.test_equal(suite, "перевод rt_line_count: смещение", line_count_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_line_count: цикл существует", line_loop.present)
    suite = testing.test_equal(suite, "перевод rt_line_count: смещение цикла", line_loop.offset, 20)
    suite = testing.test_yes(suite, "перевод rt_line_count: следующая позиция существует", line_next.present)
    suite = testing.test_equal(suite, "перевод rt_line_count: смещение следующей позиции", line_next.offset, 44)
    suite = testing.test_yes(suite, "перевод rt_line_count: завершение цикла существует", line_done.present)
    suite = testing.test_equal(suite, "перевод rt_line_count: смещение завершения цикла", line_done.offset, 52)
    suite = testing.test_yes(suite, "перевод rt_line_count: кодирование существует", line_encode.present)
    suite = testing.test_equal(suite, "перевод rt_line_count: смещение кодирования", line_encode.offset, 72)
    suite = testing.test_yes(suite, "перевод rt_line_count: пустая строка существует", line_empty.present)
    suite = testing.test_equal(suite, "перевод rt_line_count: смещение пустой строки", line_empty.offset, 84)

    out suite
}
