-- tr_fixed — эталоны перевода в машинный код, часть translation:
-- чтение файла, запись группы байтов, арифметика и перевод fixed.
-- Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use craft.testing
use selfhost.compiler.state
use selfhost.compiler.backend.rv32i
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.buffer
use selfhost.compiler.backend.rv32i.runtime.fixed
use selfhost.compiler.backend.rv32i.runtime.host

skill run(suite) {
    @file_read = state.State { executor = rv32i.Executor {} }
    file_read = host.emit_file_read(file_read)
    file_read.machine = layout.define_label(file_read.machine, layout.Section.CODE, "rt_alloc")
    file_read.machine = layout.define_label(file_read.machine, layout.Section.CODE, "rt_file_error")
    file_read.machine = layout.resolve(file_read.machine)
    @file_read_bytes = [
        19, 1, 1, 254, 35, 46, 17, 0,
        147, 114, 133, 255, 147, 133, 2, 1,
        19, 5, 192, 249, 19, 6, 0, 0,
        147, 6, 0, 0, 147, 8, 128, 3,
        115, 0, 0, 0, 99, 74, 5, 6,
        35, 44, 161, 0, 55, 5, 16, 0,
        19, 5, 85, 0, 239, 0, 64, 6,
        147, 2, 16, 0, 35, 32, 85, 0,
        35, 42, 161, 0, 3, 37, 129, 1,
        131, 37, 65, 1, 147, 133, 5, 1,
        55, 6, 16, 0, 19, 6, 6, 0,
        147, 8, 240, 3, 115, 0, 0, 0,
        99, 76, 5, 2, 131, 34, 65, 1,
        35, 166, 162, 0, 51, 131, 162, 0,
        35, 8, 3, 0, 3, 37, 129, 1,
        147, 8, 144, 3, 115, 0, 0, 0,
        3, 37, 65, 1, 19, 101, 53, 0,
        131, 32, 193, 1, 19, 1, 1, 2,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод file read: длина", file_read.machine.code.length, 152)
    suite = testing.test_equal(suite, "перевод file read: четыре перехода", file_read.machine.patch_count, 3)
    drum (152) {
        suite = testing.test_equal(suite, "перевод file read: байт {beat}", buffer.byte_at(file_read.machine.code, beat), group.get(file_read_bytes, beat))
    }
    @file_read_label = layout.find_label(file_read.machine, "rt_file_read")
    @file_read_alloc = layout.find_label(file_read.machine, "rt_alloc")
    @file_read_error = layout.find_label(file_read.machine, "rt_file_error")
    suite = testing.test_yes(suite, "перевод rt_file_read: метка существует", file_read_label.present)
    suite = testing.test_equal(suite, "перевод rt_file_read: смещение", file_read_label.offset, 0)
    suite = testing.test_yes(suite, "file read: связанный alloc существует", file_read_alloc.present)
    suite = testing.test_equal(suite, "file read: смещение alloc", file_read_alloc.offset, 152)
    suite = testing.test_yes(suite, "file read: связанная ошибка существует", file_read_error.present)
    suite = testing.test_equal(suite, "file read: смещение ошибки", file_read_error.offset, 152)

    @file_write_byte_group = state.State { executor = rv32i.Executor {} }
    file_write_byte_group = host.emit_file_write_byte_group(file_write_byte_group)
    file_write_byte_group.machine = layout.define_label(file_write_byte_group.machine, layout.Section.CODE, "rt_alloc")
    file_write_byte_group.machine = layout.define_label(file_write_byte_group.machine, layout.Section.CODE, "rt_group_flatten")
    file_write_byte_group.machine = layout.resolve(file_write_byte_group.machine)
    @file_write_byte_group_bytes = [
        19, 1, 1, 254, 35, 46, 17, 0,
        35, 44, 161, 0, 35, 42, 177, 0,
        35, 40, 193, 0, 35, 38, 209, 0,
        19, 133, 5, 0, 239, 0, 128, 11,
        35, 42, 161, 0, 147, 5, 5, 0,
        3, 37, 129, 1, 3, 38, 1, 1,
        131, 38, 193, 0, 99, 6, 6, 8,
        19, 5, 86, 0, 239, 0, 128, 9,
        147, 2, 16, 0, 35, 32, 85, 0,
        3, 35, 1, 1, 35, 38, 101, 0,
        35, 36, 161, 0, 131, 34, 65, 1,
        147, 242, 130, 255, 3, 35, 1, 1,
        131, 35, 129, 0, 19, 14, 0, 0,
        99, 10, 110, 2, 147, 30, 46, 0,
        179, 142, 210, 1, 3, 175, 14, 1,
        131, 47, 193, 0, 99, 134, 15, 0,
        19, 127, 143, 255, 3, 47, 79, 1,
        19, 95, 63, 64, 179, 143, 195, 1,
        35, 136, 239, 1, 19, 14, 30, 0,
        111, 240, 31, 253, 179, 130, 99, 0,
        35, 136, 2, 0, 3, 37, 129, 1,
        131, 37, 129, 0, 147, 133, 5, 1,
        3, 38, 1, 1, 147, 8, 0, 4,
        115, 0, 0, 0, 111, 0, 128, 0,
        19, 5, 0, 0, 131, 32, 193, 1,
        19, 1, 1, 2, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод file write byte group: длина", file_write_byte_group.machine.code.length, 212)
    suite = testing.test_equal(suite, "перевод file write byte group: переходов", file_write_byte_group.machine.patch_count, 7)
    drum (212) {
        suite = testing.test_equal(suite, "перевод file write byte group: байт {beat}", buffer.byte_at(file_write_byte_group.machine.code, beat), group.get(file_write_byte_group_bytes, beat))
    }
    @file_write_byte_group_label = layout.find_label(file_write_byte_group.machine, "rt_file_write_byte_group")
    @file_write_byte_group_copy = layout.find_label(file_write_byte_group.machine, ".L_file_write_byte_group_copy")
    @file_write_byte_group_value = layout.find_label(file_write_byte_group.machine, ".L_file_write_byte_group_value")
    @file_write_byte_group_ready = layout.find_label(file_write_byte_group.machine, ".L_file_write_byte_group_ready")
    @file_write_byte_group_empty = layout.find_label(file_write_byte_group.machine, ".L_file_write_byte_group_empty")
    @file_write_byte_group_return = layout.find_label(file_write_byte_group.machine, ".L_file_write_byte_group_return")
    @file_write_byte_group_alloc = layout.find_label(file_write_byte_group.machine, "rt_alloc")
    suite = testing.test_yes(suite, "перевод rt_file_write_byte_group: метка существует", file_write_byte_group_label.present)
    suite = testing.test_equal(suite, "перевод rt_file_write_byte_group: смещение", file_write_byte_group_label.offset, 0)
    suite = testing.test_yes(suite, "file write byte group: копирование существует", file_write_byte_group_copy.present)
    suite = testing.test_equal(suite, "file write byte group: смещение копирования", file_write_byte_group_copy.offset, 104)
    suite = testing.test_yes(suite, "file write byte group: значение существует", file_write_byte_group_value.present)
    suite = testing.test_equal(suite, "file write byte group: смещение значения", file_write_byte_group_value.offset, 136)
    suite = testing.test_yes(suite, "file write byte group: готовность существует", file_write_byte_group_ready.present)
    suite = testing.test_equal(suite, "file write byte group: смещение готовности", file_write_byte_group_ready.offset, 156)
    suite = testing.test_yes(suite, "file write byte group: пустой ввод существует", file_write_byte_group_empty.present)
    suite = testing.test_equal(suite, "file write byte group: смещение пустого ввода", file_write_byte_group_empty.offset, 192)
    suite = testing.test_yes(suite, "file write byte group: возврат существует", file_write_byte_group_return.present)
    suite = testing.test_equal(suite, "file write byte group: смещение возврата", file_write_byte_group_return.offset, 196)
    suite = testing.test_yes(suite, "file write byte group: связанный alloc существует", file_write_byte_group_alloc.present)
    suite = testing.test_equal(suite, "file write byte group: смещение alloc", file_write_byte_group_alloc.offset, 212)

    @fixed_add_sub = state.State { executor = rv32i.Executor {} }
    fixed_add_sub = fixed.emit_fixed_add(fixed_add_sub)
    fixed_add_sub = fixed.emit_fixed_sub(fixed_add_sub)
    fixed_add_sub.machine = layout.define_label(fixed_add_sub.machine, layout.Section.CODE, "rt_fixed_overflow")
    fixed_add_sub.machine = layout.define_label(fixed_add_sub.machine, layout.Section.CODE, "rt_fixed_new")
    fixed_add_sub.machine = layout.resolve(fixed_add_sub.machine)
    @fixed_add_sub_bytes = [
        147, 3, 5, 0, 19, 142, 5, 0,
        51, 133, 195, 1, 147, 14, 64, 0,
        99, 6, 216, 1, 99, 102, 117, 4,
        111, 0, 128, 4, 179, 78, 117, 0,
        51, 79, 197, 1, 179, 254, 238, 1,
        99, 204, 14, 2, 111, 0, 64, 3,
        147, 3, 5, 0, 19, 142, 5, 0,
        51, 133, 195, 65, 147, 14, 64, 0,
        99, 6, 216, 1, 99, 238, 195, 1,
        111, 0, 128, 1, 179, 206, 195, 1,
        51, 79, 117, 0, 179, 254, 238, 1,
        99, 196, 14, 0, 111, 0, 64, 0
    ]
    suite = testing.test_equal(suite, "перевод fixed add/sub: длина", fixed_add_sub.machine.code.length, 96)
    suite = testing.test_equal(suite, "перевод fixed add/sub: десять переходов", fixed_add_sub.machine.patch_count, 10)
    drum (96) {
        suite = testing.test_equal(suite, "перевод fixed add/sub: байт {beat}", buffer.byte_at(fixed_add_sub.machine.code, beat), group.get(fixed_add_sub_bytes, beat))
    }
    @fixed_add_label = layout.find_label(fixed_add_sub.machine, "rt_fixed_add")
    @fixed_add_signed = layout.find_label(fixed_add_sub.machine, ".L_fixed_add_signed")
    @fixed_sub_label = layout.find_label(fixed_add_sub.machine, "rt_fixed_sub")
    @fixed_sub_signed = layout.find_label(fixed_add_sub.machine, ".L_fixed_sub_signed")
    @fixed_add_sub_overflow = layout.find_label(fixed_add_sub.machine, "rt_fixed_overflow")
    @fixed_add_sub_new = layout.find_label(fixed_add_sub.machine, "rt_fixed_new")
    suite = testing.test_yes(suite, "перевод rt_fixed_add: метка существует", fixed_add_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_add: смещение", fixed_add_label.offset, 0)
    suite = testing.test_yes(suite, "fixed add: signed существует", fixed_add_signed.present)
    suite = testing.test_equal(suite, "fixed add: смещение signed", fixed_add_signed.offset, 28)
    suite = testing.test_yes(suite, "перевод rt_fixed_sub: метка существует", fixed_sub_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_sub: смещение", fixed_sub_label.offset, 48)
    suite = testing.test_yes(suite, "fixed sub: signed существует", fixed_sub_signed.present)
    suite = testing.test_equal(suite, "fixed sub: смещение signed", fixed_sub_signed.offset, 76)
    suite = testing.test_yes(suite, "fixed add/sub: overflow существует", fixed_add_sub_overflow.present)
    suite = testing.test_equal(suite, "fixed add/sub: смещение overflow", fixed_add_sub_overflow.offset, 96)
    suite = testing.test_yes(suite, "fixed add/sub: new существует", fixed_add_sub_new.present)
    suite = testing.test_equal(suite, "fixed add/sub: смещение new", fixed_add_sub_new.offset, 96)

    @fixed_mul = state.State { executor = rv32i.Executor {} }
    fixed_mul = fixed.emit_fixed_mul(fixed_mul)
    fixed_mul.machine = layout.define_label(fixed_mul.machine, layout.Section.CODE, "rt_fixed_new")
    fixed_mul.machine = layout.define_label(fixed_mul.machine, layout.Section.CODE, "rt_fixed_overflow")
    fixed_mul.machine = layout.resolve(fixed_mul.machine)
    @fixed_mul_bytes = [
        147, 3, 5, 0, 19, 142, 5, 0,
        147, 7, 0, 0, 19, 6, 64, 0,
        99, 30, 200, 0, 99, 214, 3, 0,
        179, 3, 112, 64, 147, 199, 23, 0,
        99, 86, 14, 0, 51, 14, 192, 65,
        147, 199, 23, 0, 147, 14, 0, 0,
        19, 15, 0, 0, 19, 7, 0, 0,
        147, 15, 0, 2, 19, 118, 30, 0,
        99, 12, 6, 0, 51, 134, 126, 0,
        179, 54, 214, 1, 51, 15, 239, 0,
        51, 15, 223, 0, 147, 14, 6, 0,
        19, 94, 30, 0, 19, 214, 243, 1,
        147, 147, 19, 0, 19, 23, 23, 0,
        51, 103, 199, 0, 147, 143, 255, 255,
        227, 150, 15, 252, 99, 28, 15, 2,
        19, 6, 64, 0, 99, 20, 200, 2,
        99, 140, 7, 0, 55, 6, 0, 128,
        19, 6, 6, 0, 99, 96, 214, 3,
        179, 14, 208, 65, 111, 0, 0, 1,
        55, 6, 0, 128, 19, 6, 246, 255,
        99, 102, 214, 1, 19, 133, 14, 0,
        111, 0, 128, 0, 111, 0, 64, 0
    ]
    suite = testing.test_equal(suite, "перевод fixed mul: длина", fixed_mul.machine.code.length, 176)
    suite = testing.test_equal(suite, "перевод fixed mul: тринадцать переходов", fixed_mul.machine.patch_count, 13)
    drum (176) {
        suite = testing.test_equal(suite, "перевод fixed mul: байт {beat}", buffer.byte_at(fixed_mul.machine.code, beat), group.get(fixed_mul_bytes, beat))
    }
    @fixed_mul_label = layout.find_label(fixed_mul.machine, "rt_fixed_mul")
    @fixed_mul_left_ready = layout.find_label(fixed_mul.machine, ".L_fixed_mul_left_ready")
    @fixed_mul_unsigned = layout.find_label(fixed_mul.machine, ".L_fixed_mul_unsigned")
    @fixed_mul_loop = layout.find_label(fixed_mul.machine, ".L_fixed_mul_loop")
    @fixed_mul_shift = layout.find_label(fixed_mul.machine, ".L_fixed_mul_shift")
    @fixed_mul_positive = layout.find_label(fixed_mul.machine, ".L_fixed_mul_positive")
    @fixed_mul_ready = layout.find_label(fixed_mul.machine, ".L_fixed_mul_ready")
    @fixed_mul_overflow = layout.find_label(fixed_mul.machine, ".L_fixed_mul_overflow")
    @fixed_mul_new = layout.find_label(fixed_mul.machine, "rt_fixed_new")
    suite = testing.test_yes(suite, "перевод rt_fixed_mul: метка существует", fixed_mul_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_mul: смещение", fixed_mul_label.offset, 0)
    suite = testing.test_yes(suite, "fixed mul: левый операнд готов", fixed_mul_left_ready.present)
    suite = testing.test_equal(suite, "fixed mul: смещение левого операнда", fixed_mul_left_ready.offset, 32)
    suite = testing.test_yes(suite, "fixed mul: беззнаковая часть существует", fixed_mul_unsigned.present)
    suite = testing.test_equal(suite, "fixed mul: смещение беззнаковой части", fixed_mul_unsigned.offset, 44)
    suite = testing.test_yes(suite, "fixed mul: цикл существует", fixed_mul_loop.present)
    suite = testing.test_equal(suite, "fixed mul: смещение цикла", fixed_mul_loop.offset, 60)
    suite = testing.test_yes(suite, "fixed mul: сдвиг существует", fixed_mul_shift.present)
    suite = testing.test_equal(suite, "fixed mul: смещение сдвига", fixed_mul_shift.offset, 88)
    suite = testing.test_yes(suite, "fixed mul: положительный результат существует", fixed_mul_positive.present)
    suite = testing.test_equal(suite, "fixed mul: смещение положительного результата", fixed_mul_positive.offset, 152)
    suite = testing.test_yes(suite, "fixed mul: готовность существует", fixed_mul_ready.present)
    suite = testing.test_equal(suite, "fixed mul: смещение готовности", fixed_mul_ready.offset, 164)
    suite = testing.test_yes(suite, "fixed mul: переполнение существует", fixed_mul_overflow.present)
    suite = testing.test_equal(suite, "fixed mul: смещение переполнения", fixed_mul_overflow.offset, 172)
    suite = testing.test_yes(suite, "fixed mul: связанный new существует", fixed_mul_new.present)
    suite = testing.test_equal(suite, "fixed mul: смещение new", fixed_mul_new.offset, 176)

    @fixed_div = state.State { executor = rv32i.Executor {} }
    fixed_div = fixed.emit_fixed_div(fixed_div)
    fixed_div.machine = layout.define_label(fixed_div.machine, layout.Section.CODE, "rt_division_by_zero")
    fixed_div.machine = layout.define_label(fixed_div.machine, layout.Section.CODE, "rt_fixed_overflow")
    fixed_div.machine = layout.define_label(fixed_div.machine, layout.Section.CODE, "rt_fixed_new")
    fixed_div.machine = layout.resolve(fixed_div.machine)
    @fixed_div_bytes = [
        147, 3, 5, 0, 19, 142, 5, 0,
        99, 20, 14, 0, 111, 0, 192, 7,
        19, 7, 0, 0, 19, 6, 64, 0,
        99, 30, 200, 0, 99, 214, 3, 0,
        179, 3, 112, 64, 19, 71, 23, 0,
        99, 86, 14, 0, 51, 14, 192, 65,
        19, 71, 23, 0, 147, 14, 0, 0,
        19, 15, 0, 0, 147, 15, 0, 2,
        19, 214, 243, 1, 147, 147, 19, 0,
        19, 31, 31, 0, 51, 111, 207, 0,
        147, 158, 30, 0, 99, 102, 207, 1,
        51, 15, 207, 65, 147, 238, 30, 0,
        147, 143, 255, 255, 227, 158, 15, 252,
        99, 6, 7, 0, 179, 14, 208, 65,
        111, 0, 0, 1, 19, 6, 64, 0,
        99, 20, 200, 0, 99, 198, 14, 0,
        19, 133, 14, 0, 111, 0, 64, 0
    ]
    suite = testing.test_equal(suite, "перевод fixed div: длина", fixed_div.machine.code.length, 136)
    suite = testing.test_equal(suite, "перевод fixed div: переходы", fixed_div.machine.patch_count, 12)
    drum (136) {
        suite = testing.test_equal(suite, "перевод fixed div: байт {beat}", buffer.byte_at(fixed_div.machine.code, beat), group.get(fixed_div_bytes, beat))
    }
    @fixed_div_label = layout.find_label(fixed_div.machine, "rt_fixed_div")
    @fixed_div_left_ready = layout.find_label(fixed_div.machine, ".L_fixed_div_left_ready")
    @fixed_div_unsigned = layout.find_label(fixed_div.machine, ".L_fixed_div_unsigned")
    @fixed_div_loop = layout.find_label(fixed_div.machine, ".L_fixed_div_loop")
    @fixed_div_next = layout.find_label(fixed_div.machine, ".L_fixed_div_next")
    @fixed_div_positive = layout.find_label(fixed_div.machine, ".L_fixed_div_positive")
    @fixed_div_ready = layout.find_label(fixed_div.machine, ".L_fixed_div_ready")
    @fixed_div_zero = layout.find_label(fixed_div.machine, "rt_division_by_zero")
    @fixed_div_overflow = layout.find_label(fixed_div.machine, "rt_fixed_overflow")
    @fixed_div_new = layout.find_label(fixed_div.machine, "rt_fixed_new")
    suite = testing.test_yes(suite, "перевод rt_fixed_div: метка существует", fixed_div_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_div: смещение", fixed_div_label.offset, 0)
    suite = testing.test_yes(suite, "fixed div: левый операнд готов", fixed_div_left_ready.present)
    suite = testing.test_equal(suite, "fixed div: смещение левого операнда", fixed_div_left_ready.offset, 40)
    suite = testing.test_yes(suite, "fixed div: беззнаковая часть существует", fixed_div_unsigned.present)
    suite = testing.test_equal(suite, "fixed div: смещение беззнаковой части", fixed_div_unsigned.offset, 52)
    suite = testing.test_yes(suite, "fixed div: цикл существует", fixed_div_loop.present)
    suite = testing.test_equal(suite, "fixed div: смещение цикла", fixed_div_loop.offset, 64)
    suite = testing.test_yes(suite, "fixed div: следующий бит существует", fixed_div_next.present)
    suite = testing.test_equal(suite, "fixed div: смещение следующего бита", fixed_div_next.offset, 96)
    suite = testing.test_yes(suite, "fixed div: положительный результат существует", fixed_div_positive.present)
    suite = testing.test_equal(suite, "fixed div: смещение положительного результата", fixed_div_positive.offset, 116)
    suite = testing.test_yes(suite, "fixed div: готовность существует", fixed_div_ready.present)
    suite = testing.test_equal(suite, "fixed div: смещение готовности", fixed_div_ready.offset, 128)
    suite = testing.test_yes(suite, "fixed div: деление на ноль связано", fixed_div_zero.present)
    suite = testing.test_equal(suite, "fixed div: смещение деления на ноль", fixed_div_zero.offset, 136)
    suite = testing.test_yes(suite, "fixed div: переполнение связано", fixed_div_overflow.present)
    suite = testing.test_equal(suite, "fixed div: смещение переполнения", fixed_div_overflow.offset, 136)
    suite = testing.test_yes(suite, "fixed div: new связан", fixed_div_new.present)
    suite = testing.test_equal(suite, "fixed div: смещение new", fixed_div_new.offset, 136)

    @fixed_bits = state.State { executor = rv32i.Executor {} }
    fixed_bits = fixed.emit_fixed_and(fixed_bits)
    fixed_bits = fixed.emit_fixed_or(fixed_bits)
    fixed_bits = fixed.emit_fixed_xor(fixed_bits)
    fixed_bits = fixed.emit_fixed_not(fixed_bits)
    fixed_bits.machine = layout.define_label(fixed_bits.machine, layout.Section.CODE, "rt_fixed_new")
    fixed_bits.machine = layout.resolve(fixed_bits.machine)
    @fixed_bits_bytes = [
        51, 117, 181, 0, 111, 0, 192, 1,
        51, 101, 181, 0, 111, 0, 64, 1,
        51, 69, 181, 0, 111, 0, 192, 0,
        19, 69, 245, 255, 111, 0, 64, 0
    ]
    suite = testing.test_equal(suite, "перевод fixed bits: длина", fixed_bits.machine.code.length, 32)
    suite = testing.test_equal(suite, "перевод fixed bits: четыре перехода", fixed_bits.machine.patch_count, 4)
    drum (32) {
        suite = testing.test_equal(suite, "перевод fixed bits: байт {beat}", buffer.byte_at(fixed_bits.machine.code, beat), group.get(fixed_bits_bytes, beat))
    }
    @fixed_and_label = layout.find_label(fixed_bits.machine, "rt_fixed_and")
    @fixed_or_label = layout.find_label(fixed_bits.machine, "rt_fixed_or")
    @fixed_xor_label = layout.find_label(fixed_bits.machine, "rt_fixed_xor")
    @fixed_not_label = layout.find_label(fixed_bits.machine, "rt_fixed_not")
    @fixed_bits_new = layout.find_label(fixed_bits.machine, "rt_fixed_new")
    suite = testing.test_yes(suite, "перевод rt_fixed_and: метка существует", fixed_and_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_and: смещение", fixed_and_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_fixed_or: метка существует", fixed_or_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_or: смещение", fixed_or_label.offset, 8)
    suite = testing.test_yes(suite, "перевод rt_fixed_xor: метка существует", fixed_xor_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_xor: смещение", fixed_xor_label.offset, 16)
    suite = testing.test_yes(suite, "перевод rt_fixed_not: метка существует", fixed_not_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_not: смещение", fixed_not_label.offset, 24)
    suite = testing.test_yes(suite, "fixed bits: new связан", fixed_bits_new.present)
    suite = testing.test_equal(suite, "fixed bits: смещение new", fixed_bits_new.offset, 32)

    @fixed_shifts = state.State { executor = rv32i.Executor {} }
    fixed_shifts = fixed.emit_fixed_shift_left(fixed_shifts)
    fixed_shifts = fixed.emit_fixed_shift_right(fixed_shifts)
    fixed_shifts.machine = layout.define_label(fixed_shifts.machine, layout.Section.CODE, "rt_fixed_new")
    fixed_shifts.machine = layout.resolve(fixed_shifts.machine)
    @fixed_shifts_bytes = [
        51, 21, 181, 0, 111, 0, 192, 0,
        51, 85, 181, 0, 111, 0, 64, 0
    ]
    suite = testing.test_equal(suite, "перевод fixed shifts: длина", fixed_shifts.machine.code.length, 16)
    suite = testing.test_equal(suite, "перевод fixed shifts: два перехода", fixed_shifts.machine.patch_count, 2)
    drum (16) {
        suite = testing.test_equal(suite, "перевод fixed shifts: байт {beat}", buffer.byte_at(fixed_shifts.machine.code, beat), group.get(fixed_shifts_bytes, beat))
    }
    @fixed_shift_left_label = layout.find_label(fixed_shifts.machine, "rt_fixed_shift_left")
    @fixed_shift_right_label = layout.find_label(fixed_shifts.machine, "rt_fixed_shift_right")
    @fixed_shifts_new = layout.find_label(fixed_shifts.machine, "rt_fixed_new")
    suite = testing.test_yes(suite, "перевод rt_fixed_shift_left: метка существует", fixed_shift_left_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_shift_left: смещение", fixed_shift_left_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_fixed_shift_right: метка существует", fixed_shift_right_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_shift_right: смещение", fixed_shift_right_label.offset, 8)
    suite = testing.test_yes(suite, "fixed shifts: new связан", fixed_shifts_new.present)
    suite = testing.test_equal(suite, "fixed shifts: смещение new", fixed_shifts_new.offset, 16)

    @fixed_convert = state.State { executor = rv32i.Executor {} }
    fixed_convert = fixed.emit_fixed_convert(fixed_convert)
    fixed_convert.machine = layout.define_label(fixed_convert.machine, layout.Section.CODE, "rt_fixed_overflow")
    fixed_convert.machine = layout.define_label(fixed_convert.machine, layout.Section.CODE, "rt_fixed_new")
    fixed_convert.machine = layout.resolve(fixed_convert.machine)
    @fixed_convert_bytes = [
        147, 2, 64, 0, 99, 20, 88, 0,
        99, 74, 5, 0, 99, 148, 88, 0,
        99, 70, 5, 0, 19, 136, 8, 0,
        111, 0, 64, 0
    ]
    suite = testing.test_equal(suite, "перевод fixed convert: длина", fixed_convert.machine.code.length, 28)
    suite = testing.test_equal(suite, "перевод fixed convert: пять переходов", fixed_convert.machine.patch_count, 5)
    drum (28) {
        suite = testing.test_equal(suite, "перевод fixed convert: байт {beat}", buffer.byte_at(fixed_convert.machine.code, beat), group.get(fixed_convert_bytes, beat))
    }
    @fixed_convert_label = layout.find_label(fixed_convert.machine, "rt_fixed_convert")
    @fixed_convert_to_signed = layout.find_label(fixed_convert.machine, ".L_fixed_convert_to_signed")
    @fixed_convert_ready = layout.find_label(fixed_convert.machine, ".L_fixed_convert_ready")
    @fixed_convert_overflow = layout.find_label(fixed_convert.machine, "rt_fixed_overflow")
    @fixed_convert_new = layout.find_label(fixed_convert.machine, "rt_fixed_new")
    suite = testing.test_yes(suite, "перевод rt_fixed_convert: метка существует", fixed_convert_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_convert: смещение", fixed_convert_label.offset, 0)
    suite = testing.test_yes(suite, "fixed convert: перевод в signed существует", fixed_convert_to_signed.present)
    suite = testing.test_equal(suite, "fixed convert: смещение перевода в signed", fixed_convert_to_signed.offset, 12)
    suite = testing.test_yes(suite, "fixed convert: готовность существует", fixed_convert_ready.present)
    suite = testing.test_equal(suite, "fixed convert: смещение готовности", fixed_convert_ready.offset, 20)
    suite = testing.test_yes(suite, "fixed convert: переполнение связано", fixed_convert_overflow.present)
    suite = testing.test_equal(suite, "fixed convert: смещение переполнения", fixed_convert_overflow.offset, 28)
    suite = testing.test_yes(suite, "fixed convert: new связан", fixed_convert_new.present)
    suite = testing.test_equal(suite, "fixed convert: смещение new", fixed_convert_new.offset, 28)

    out suite
}
