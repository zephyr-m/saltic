-- tr_memory — эталоны перевода в машинный код, часть translation:
-- память: rt_alloc, rt_fixed_new, загрузки и записи fixed и обычной памяти.
-- Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use craft.testing
use selfhost.compiler.state
use selfhost.compiler.backend.rv32i.runtime.memory
use selfhost.compiler.backend.rv32i.machine.instruction
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.compiler.backend.rv32i.machine.buffer
use selfhost.compiler.backend.rv32i.runtime.fixed
use selfhost.compiler.backend.rv32i.runtime.host
use selfhost.compiler.backend.rv32i.runtime.raw_memory

skill run(suite) {
    @allocation = state.State {}
    allocation = memory.emit_alloc(allocation)
    allocation.machine = layout.define_label(allocation.machine, layout.Section.CODE, "rt_out_of_memory")
    allocation.machine = layout.emit(allocation.machine, instruction.Kind.EBREAK, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    allocation = host.emit_platform_exit(allocation)
    allocation.machine = layout.resolve(allocation.machine)
    @allocation_bytes = [
        51, 3, 5, 0, 99, 104, 153, 2,
        147, 2, 53, 1, 99, 228, 162, 2,
        147, 242, 130, 255, 179, 3, 153, 64,
        99, 238, 83, 0, 19, 133, 4, 0,
        179, 132, 84, 0, 35, 34, 101, 0,
        35, 36, 5, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 115, 0, 16, 0,
        147, 8, 208, 5, 115, 0, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_alloc: длина", allocation.machine.code.length, 64)
    suite = testing.test_equal(suite, "перевод rt_alloc: три перехода", allocation.machine.patch_count, 3)
    drum (64) {
        suite = testing.test_equal(suite, "перевод rt_alloc: байт {beat}", buffer.byte_at(allocation.machine.code, beat), group.get(allocation_bytes, beat))
    }
    @alloc = layout.find_label(allocation.machine, "rt_alloc")
    @out_of_memory = layout.find_label(allocation.machine, "rt_out_of_memory")
    @allocation_platform_exit = layout.find_label(allocation.machine, "rt_platform_exit")
    suite = testing.test_yes(suite, "перевод rt_alloc: метка существует", alloc.present)
    suite = testing.test_equal(suite, "перевод rt_alloc: смещение", alloc.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_out_of_memory: метка существует", out_of_memory.present)
    suite = testing.test_equal(suite, "перевод rt_out_of_memory: смещение", out_of_memory.offset, 52)
    suite = testing.test_yes(suite, "связанный rt_platform_exit для памяти существует", allocation_platform_exit.present)
    suite = testing.test_equal(suite, "связанный rt_platform_exit для памяти: смещение", allocation_platform_exit.offset, 56)

    @fixed_new = state.State {}
    fixed_new = fixed.emit_fixed_new(fixed_new)
    fixed_new.machine = layout.define_label(fixed_new.machine, layout.Section.CODE, "rt_fixed_overflow")
    fixed_new.machine = layout.resolve(fixed_new.machine)
    @fixed_new_bytes = [
        147, 2, 16, 0, 99, 10, 88, 0,
        147, 2, 32, 0, 99, 14, 88, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        147, 82, 133, 0, 99, 158, 2, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        147, 82, 5, 1, 99, 150, 2, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод rt_fixed_new: длина", fixed_new.machine.code.length, 56)
    suite = testing.test_equal(suite, "перевод rt_fixed_new: четыре перехода", fixed_new.machine.patch_count, 4)
    drum (56) {
        suite = testing.test_equal(suite, "перевод rt_fixed_new: байт {beat}", buffer.byte_at(fixed_new.machine.code, beat), group.get(fixed_new_bytes, beat))
    }
    @fixed_new_label = layout.find_label(fixed_new.machine, "rt_fixed_new")
    @fixed_check_u8 = layout.find_label(fixed_new.machine, ".L_fixed_check_u8")
    @fixed_check_u16 = layout.find_label(fixed_new.machine, ".L_fixed_check_u16")
    @fixed_new_overflow = layout.find_label(fixed_new.machine, "rt_fixed_overflow")
    suite = testing.test_yes(suite, "перевод rt_fixed_new: метка существует", fixed_new_label.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_new: смещение", fixed_new_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_fixed_new: проверка u8 существует", fixed_check_u8.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_new: смещение проверки u8", fixed_check_u8.offset, 24)
    suite = testing.test_yes(suite, "перевод rt_fixed_new: проверка u16 существует", fixed_check_u16.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_new: смещение проверки u16", fixed_check_u16.offset, 40)
    suite = testing.test_yes(suite, "связанный fixed overflow существует", fixed_new_overflow.present)
    suite = testing.test_equal(suite, "связанный fixed overflow: смещение", fixed_new_overflow.offset, 56)

    @fixed_memory_load = state.State {}
    fixed_memory_load = fixed.emit_fixed_mem_load8(fixed_memory_load)
    fixed_memory_load = fixed.emit_fixed_mem_load16(fixed_memory_load)
    fixed_memory_load = fixed.emit_fixed_mem_load32(fixed_memory_load)
    fixed_memory_load = fixed.emit_fixed_mem_load(fixed_memory_load)
    fixed_memory_load.machine = layout.resolve(fixed_memory_load.machine)
    @fixed_memory_load_bytes = [
        19, 6, 16, 0, 111, 0, 0, 1,
        19, 6, 32, 0, 111, 0, 128, 0,
        19, 6, 48, 0, 179, 2, 181, 0,
        19, 3, 16, 0, 99, 12, 102, 0,
        19, 3, 32, 0, 99, 14, 102, 0,
        3, 165, 2, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 3, 197, 2, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        3, 213, 2, 0, 147, 5, 0, 0,
        103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод загрузок fixed-памяти: длина", fixed_memory_load.machine.code.length, 76)
    suite = testing.test_equal(suite, "перевод загрузок fixed-памяти: четыре перехода", fixed_memory_load.machine.patch_count, 4)
    drum (76) {
        suite = testing.test_equal(suite, "перевод загрузок fixed-памяти: байт {beat}", buffer.byte_at(fixed_memory_load.machine.code, beat), group.get(fixed_memory_load_bytes, beat))
    }
    @fixed_mem_load8 = layout.find_label(fixed_memory_load.machine, "rt_fixed_mem_load8")
    @fixed_mem_load16 = layout.find_label(fixed_memory_load.machine, "rt_fixed_mem_load16")
    @fixed_mem_load32 = layout.find_label(fixed_memory_load.machine, "rt_fixed_mem_load32")
    @fixed_mem_load = layout.find_label(fixed_memory_load.machine, "rt_fixed_mem_load")
    @fixed_mem_load8_body = layout.find_label(fixed_memory_load.machine, ".L_fixed_mem_load8")
    @fixed_mem_load16_body = layout.find_label(fixed_memory_load.machine, ".L_fixed_mem_load16")
    suite = testing.test_yes(suite, "перевод rt_fixed_mem_load8: метка существует", fixed_mem_load8.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_mem_load8: смещение", fixed_mem_load8.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_fixed_mem_load16: метка существует", fixed_mem_load16.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_mem_load16: смещение", fixed_mem_load16.offset, 8)
    suite = testing.test_yes(suite, "перевод rt_fixed_mem_load32: метка существует", fixed_mem_load32.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_mem_load32: смещение", fixed_mem_load32.offset, 16)
    suite = testing.test_yes(suite, "перевод rt_fixed_mem_load: метка существует", fixed_mem_load.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_mem_load: смещение", fixed_mem_load.offset, 20)
    suite = testing.test_yes(suite, "перевод fixed load8: тело существует", fixed_mem_load8_body.present)
    suite = testing.test_equal(suite, "перевод fixed load8: смещение тела", fixed_mem_load8_body.offset, 52)
    suite = testing.test_yes(suite, "перевод fixed load16: тело существует", fixed_mem_load16_body.present)
    suite = testing.test_equal(suite, "перевод fixed load16: смещение тела", fixed_mem_load16_body.offset, 64)

    @fixed_memory_store = state.State {}
    fixed_memory_store = fixed.emit_fixed_mem_store8(fixed_memory_store)
    fixed_memory_store = fixed.emit_fixed_mem_store16(fixed_memory_store)
    fixed_memory_store = fixed.emit_fixed_mem_store32(fixed_memory_store)
    fixed_memory_store = fixed.emit_fixed_mem_store(fixed_memory_store)
    fixed_memory_store.machine = layout.resolve(fixed_memory_store.machine)
    @fixed_memory_store_bytes = [
        19, 14, 16, 0, 111, 0, 0, 1,
        19, 14, 32, 0, 111, 0, 128, 0,
        19, 14, 48, 0, 179, 2, 181, 0,
        19, 3, 16, 0, 99, 10, 110, 0,
        19, 3, 32, 0, 99, 10, 110, 0,
        35, 160, 194, 0, 111, 0, 0, 1,
        35, 128, 194, 0, 111, 0, 128, 0,
        35, 144, 194, 0, 19, 5, 32, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод записей fixed-памяти: длина", fixed_memory_store.machine.code.length, 72)
    suite = testing.test_equal(suite, "перевод записей fixed-памяти: шесть переходов", fixed_memory_store.machine.patch_count, 6)
    drum (72) {
        suite = testing.test_equal(suite, "перевод записей fixed-памяти: байт {beat}", buffer.byte_at(fixed_memory_store.machine.code, beat), group.get(fixed_memory_store_bytes, beat))
    }
    @fixed_mem_store8 = layout.find_label(fixed_memory_store.machine, "rt_fixed_mem_store8")
    @fixed_mem_store16 = layout.find_label(fixed_memory_store.machine, "rt_fixed_mem_store16")
    @fixed_mem_store32 = layout.find_label(fixed_memory_store.machine, "rt_fixed_mem_store32")
    @fixed_mem_store = layout.find_label(fixed_memory_store.machine, "rt_fixed_mem_store")
    @fixed_mem_store8_body = layout.find_label(fixed_memory_store.machine, ".L_fixed_mem_store8")
    @fixed_mem_store16_body = layout.find_label(fixed_memory_store.machine, ".L_fixed_mem_store16")
    @fixed_mem_store_done = layout.find_label(fixed_memory_store.machine, ".L_fixed_mem_store_done")
    suite = testing.test_yes(suite, "перевод rt_fixed_mem_store8: метка существует", fixed_mem_store8.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_mem_store8: смещение", fixed_mem_store8.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_fixed_mem_store16: метка существует", fixed_mem_store16.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_mem_store16: смещение", fixed_mem_store16.offset, 8)
    suite = testing.test_yes(suite, "перевод rt_fixed_mem_store32: метка существует", fixed_mem_store32.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_mem_store32: смещение", fixed_mem_store32.offset, 16)
    suite = testing.test_yes(suite, "перевод rt_fixed_mem_store: метка существует", fixed_mem_store.present)
    suite = testing.test_equal(suite, "перевод rt_fixed_mem_store: смещение", fixed_mem_store.offset, 20)
    suite = testing.test_yes(suite, "перевод fixed store8: тело существует", fixed_mem_store8_body.present)
    suite = testing.test_equal(suite, "перевод fixed store8: смещение тела", fixed_mem_store8_body.offset, 48)
    suite = testing.test_yes(suite, "перевод fixed store16: тело существует", fixed_mem_store16_body.present)
    suite = testing.test_equal(suite, "перевод fixed store16: смещение тела", fixed_mem_store16_body.offset, 56)
    suite = testing.test_yes(suite, "перевод fixed store: завершение существует", fixed_mem_store_done.present)
    suite = testing.test_equal(suite, "перевод fixed store: смещение завершения", fixed_mem_store_done.offset, 60)

    @memory_load = state.State {}
    memory_load = raw_memory.emit_mem_load8(memory_load)
    memory_load = raw_memory.emit_mem_load16(memory_load)
    memory_load = raw_memory.emit_mem_load32(memory_load)
    memory_load.machine = layout.resolve(memory_load.machine)
    @memory_load_bytes = [
        147, 114, 133, 255, 3, 163, 2, 1,
        131, 163, 66, 1, 19, 83, 51, 64,
        147, 211, 51, 64, 19, 19, 3, 1,
        147, 147, 3, 1, 147, 211, 3, 1,
        147, 213, 53, 64, 179, 98, 115, 0,
        179, 130, 178, 0, 3, 197, 2, 0,
        19, 21, 53, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 147, 114, 133, 255,
        3, 163, 2, 1, 131, 163, 66, 1,
        19, 83, 51, 64, 147, 211, 51, 64,
        19, 19, 3, 1, 147, 147, 3, 1,
        147, 211, 3, 1, 147, 213, 53, 64,
        179, 98, 115, 0, 179, 130, 178, 0,
        3, 213, 2, 0, 19, 21, 53, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        147, 114, 133, 255, 3, 163, 2, 1,
        131, 163, 66, 1, 19, 83, 51, 64,
        147, 211, 51, 64, 19, 19, 3, 1,
        147, 147, 3, 1, 147, 211, 3, 1,
        147, 213, 53, 64, 179, 98, 115, 0,
        179, 130, 178, 0, 3, 165, 2, 0,
        19, 21, 53, 0, 147, 5, 0, 0,
        103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод загрузок памяти: длина", memory_load.machine.code.length, 180)
    suite = testing.test_equal(suite, "перевод загрузок памяти: нет переходов", memory_load.machine.patch_count, 0)
    drum (180) {
        suite = testing.test_equal(suite, "перевод загрузок памяти: байт {beat}", buffer.byte_at(memory_load.machine.code, beat), group.get(memory_load_bytes, beat))
    }
    @mem_load8 = layout.find_label(memory_load.machine, "rt_mem_load8")
    @mem_load16 = layout.find_label(memory_load.machine, "rt_mem_load16")
    @mem_load32 = layout.find_label(memory_load.machine, "rt_mem_load32")
    suite = testing.test_yes(suite, "перевод rt_mem_load8: метка существует", mem_load8.present)
    suite = testing.test_equal(suite, "перевод rt_mem_load8: смещение", mem_load8.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_mem_load16: метка существует", mem_load16.present)
    suite = testing.test_equal(suite, "перевод rt_mem_load16: смещение", mem_load16.offset, 60)
    suite = testing.test_yes(suite, "перевод rt_mem_load32: метка существует", mem_load32.present)
    suite = testing.test_equal(suite, "перевод rt_mem_load32: смещение", mem_load32.offset, 120)

    @memory_store = state.State {}
    memory_store = raw_memory.emit_mem_store8(memory_store)
    memory_store = raw_memory.emit_mem_store16(memory_store)
    memory_store = raw_memory.emit_mem_store32(memory_store)
    memory_store.machine = layout.resolve(memory_store.machine)
    @memory_store_bytes = [
        147, 114, 133, 255, 3, 163, 2, 1,
        131, 163, 66, 1, 19, 83, 51, 64,
        147, 211, 51, 64, 19, 19, 3, 1,
        147, 147, 3, 1, 147, 211, 3, 1,
        147, 213, 53, 64, 19, 86, 54, 64,
        179, 98, 115, 0, 179, 130, 178, 0,
        35, 128, 194, 0, 19, 5, 32, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        147, 114, 133, 255, 3, 163, 2, 1,
        131, 163, 66, 1, 19, 83, 51, 64,
        147, 211, 51, 64, 19, 19, 3, 1,
        147, 147, 3, 1, 147, 211, 3, 1,
        147, 213, 53, 64, 19, 86, 54, 64,
        179, 98, 115, 0, 179, 130, 178, 0,
        35, 144, 194, 0, 19, 5, 32, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        147, 114, 133, 255, 3, 163, 2, 1,
        131, 163, 66, 1, 19, 83, 51, 64,
        147, 211, 51, 64, 19, 19, 3, 1,
        147, 147, 3, 1, 147, 211, 3, 1,
        147, 213, 53, 64, 19, 86, 54, 64,
        179, 98, 115, 0, 179, 130, 178, 0,
        35, 160, 194, 0, 19, 5, 32, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод записей памяти: длина", memory_store.machine.code.length, 192)
    suite = testing.test_equal(suite, "перевод записей памяти: нет переходов", memory_store.machine.patch_count, 0)
    drum (192) {
        suite = testing.test_equal(suite, "перевод записей памяти: байт {beat}", buffer.byte_at(memory_store.machine.code, beat), group.get(memory_store_bytes, beat))
    }
    @mem_store8 = layout.find_label(memory_store.machine, "rt_mem_store8")
    @mem_store16 = layout.find_label(memory_store.machine, "rt_mem_store16")
    @mem_store32 = layout.find_label(memory_store.machine, "rt_mem_store32")
    suite = testing.test_yes(suite, "перевод rt_mem_store8: метка существует", mem_store8.present)
    suite = testing.test_equal(suite, "перевод rt_mem_store8: смещение", mem_store8.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_mem_store16: метка существует", mem_store16.present)
    suite = testing.test_equal(suite, "перевод rt_mem_store16: смещение", mem_store16.offset, 64)
    suite = testing.test_yes(suite, "перевод rt_mem_store32: метка существует", mem_store32.present)
    suite = testing.test_equal(suite, "перевод rt_mem_store32: смещение", mem_store32.offset, 128)

    @memory_store_address = state.State {}
    memory_store_address = raw_memory.emit_mem_store_address32(memory_store_address)
    memory_store_address.machine = layout.resolve(memory_store_address.machine)
    @memory_store_address_bytes = [
        147, 114, 133, 255, 3, 163, 2, 1,
        131, 163, 66, 1, 19, 83, 51, 64,
        147, 211, 51, 64, 19, 19, 3, 1,
        147, 147, 3, 1, 147, 211, 3, 1,
        179, 98, 115, 0, 147, 213, 53, 64,
        179, 130, 178, 0, 19, 126, 134, 255,
        3, 35, 14, 1, 131, 35, 78, 1,
        19, 83, 51, 64, 147, 211, 51, 64,
        19, 19, 3, 1, 147, 147, 3, 1,
        147, 211, 3, 1, 51, 110, 115, 0,
        35, 160, 194, 1, 19, 5, 32, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
    ]
    suite = testing.test_equal(suite, "перевод записи адреса памяти: длина", memory_store_address.machine.code.length, 96)
    suite = testing.test_equal(suite, "перевод записи адреса памяти: нет переходов", memory_store_address.machine.patch_count, 0)
    drum (96) {
        suite = testing.test_equal(suite, "перевод записи адреса памяти: байт {beat}", buffer.byte_at(memory_store_address.machine.code, beat), group.get(memory_store_address_bytes, beat))
    }
    @mem_store_address32 = layout.find_label(memory_store_address.machine, "rt_mem_store_address32")
    suite = testing.test_yes(suite, "перевод rt_mem_store_address32: метка существует", mem_store_address32.present)
    suite = testing.test_equal(suite, "перевод rt_mem_store_address32: смещение", mem_store_address32.offset, 0)

    out suite
}
