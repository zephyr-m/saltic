use seed
use craft.testing
use seed.machine.instruction
use seed.machine.codec

skill accepts(kind, rd, rs1, rs2, immediate) {
    @accepted = yes
    @value = codec.encode_kind(kind, rd, rs1, rs2, immediate) rescue |failure| {
        accepted = no
        codec.word(0, 0, 0, 0)
    }
    value = value
    out accepted
}

skill rejects(kind, rd, rs1, rs2, immediate) {
    out accepts(kind, rd, rs1, rs2, immediate) == no
}

skill run(suite) {
    suite = testing.test_yes(suite, "immediate I: минимум -2048", accepts(instruction.Kind.ADDI, 1, 2, 0, 0 - 2048))
    suite = testing.test_yes(suite, "immediate I: максимум 2047", accepts(instruction.Kind.ADDI, 1, 2, 0, 2047))
    suite = testing.test_yes(suite, "immediate I: ниже минимума запрещён", rejects(instruction.Kind.ADDI, 1, 2, 0, 0 - 2049))
    suite = testing.test_yes(suite, "immediate I: выше максимума запрещён", rejects(instruction.Kind.ADDI, 1, 2, 0, 2048))

    suite = testing.test_yes(suite, "immediate S: минимум -2048", accepts(instruction.Kind.SW, 0, 2, 3, 0 - 2048))
    suite = testing.test_yes(suite, "immediate S: максимум 2047", accepts(instruction.Kind.SW, 0, 2, 3, 2047))
    suite = testing.test_yes(suite, "immediate S: переполнение запрещено", rejects(instruction.Kind.SW, 0, 2, 3, 2048))

    suite = testing.test_yes(suite, "immediate B: минимум -4096", accepts(instruction.Kind.BEQ, 0, 2, 3, 0 - 4096))
    suite = testing.test_yes(suite, "immediate B: максимум 4094", accepts(instruction.Kind.BEQ, 0, 2, 3, 4094))
    suite = testing.test_yes(suite, "immediate B: нечётное смещение запрещено", rejects(instruction.Kind.BEQ, 0, 2, 3, 3))
    suite = testing.test_yes(suite, "immediate B: выход за границу запрещён", rejects(instruction.Kind.BEQ, 0, 2, 3, 4096))

    suite = testing.test_yes(suite, "immediate U: ноль", accepts(instruction.Kind.LUI, 1, 0, 0, 0))
    suite = testing.test_yes(suite, "immediate U: максимум 1048575", accepts(instruction.Kind.LUI, 1, 0, 0, 1048575))
    suite = testing.test_yes(suite, "immediate U: отрицательное значение запрещено", rejects(instruction.Kind.LUI, 1, 0, 0, 0 - 1))
    suite = testing.test_yes(suite, "immediate U: переполнение запрещено", rejects(instruction.Kind.LUI, 1, 0, 0, 1048576))

    suite = testing.test_yes(suite, "immediate J: минимум -1048576", accepts(instruction.Kind.JAL, 1, 0, 0, 0 - 1048576))
    suite = testing.test_yes(suite, "immediate J: максимум 1048574", accepts(instruction.Kind.JAL, 1, 0, 0, 1048574))
    suite = testing.test_yes(suite, "immediate J: нечётное смещение запрещено", rejects(instruction.Kind.JAL, 1, 0, 0, 5))
    suite = testing.test_yes(suite, "immediate J: выход за границу запрещён", rejects(instruction.Kind.JAL, 1, 0, 0, 1048576))

    suite = testing.test_yes(suite, "shift: ноль", accepts(instruction.Kind.SLLI, 1, 2, 0, 0))
    suite = testing.test_yes(suite, "shift: максимум 31", accepts(instruction.Kind.SRAI, 1, 2, 0, 31))
    suite = testing.test_yes(suite, "shift: 32 запрещён", rejects(instruction.Kind.SRLI, 1, 2, 0, 32))
    suite = testing.test_yes(suite, "shift: отрицательное значение запрещено", rejects(instruction.Kind.SLLI, 1, 2, 0, 0 - 1))

    suite = testing.test_yes(suite, "CSR: ноль", accepts(instruction.Kind.CSRRW, 1, 2, 0, 0))
    suite = testing.test_yes(suite, "CSR: максимум 4095", accepts(instruction.Kind.CSRRS, 1, 2, 0, 4095))
    suite = testing.test_yes(suite, "CSR: отрицательный номер запрещён", rejects(instruction.Kind.CSRRW, 1, 2, 0, 0 - 1))
    suite = testing.test_yes(suite, "CSR: переполнение запрещено", rejects(instruction.Kind.CSRRS, 1, 2, 0, 4096))

    suite = testing.test_yes(suite, "регистр: номер 31 допустим", accepts(instruction.Kind.ADD, 31, 31, 31, 0))
    suite = testing.test_yes(suite, "регистр: номер 32 запрещён", rejects(instruction.Kind.ADD, 32, 1, 2, 0))
    suite = testing.test_yes(suite, "регистр: отрицательный номер запрещён", rejects(instruction.Kind.ADD, 1, 0 - 1, 2, 0))
    out suite
}
