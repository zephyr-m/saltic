-- runtime_bytes — побайтовые эталоны машинного кода рантайма RV32I.
-- Части лежат в runtime_bytes/ по темам; каждая собирает свой кусок рантайма
-- и сверяет байты, метки и смещения с эталоном.
--
-- run(suite) -> suite со всеми проверками эталонов

use seed.tests.machine.runtime_bytes.tr_arith
use seed.tests.machine.runtime_bytes.tr_objects
use seed.tests.machine.runtime_bytes.tr_system
use seed.tests.machine.runtime_bytes.tr_memory
use seed.tests.machine.runtime_bytes.tr_text
use seed.tests.machine.runtime_bytes.tr_fixed
use seed.tests.machine.runtime_bytes.tr_image

skill run(suite) {
    suite = tr_arith.run(suite)
    suite = tr_objects.run(suite)
    suite = tr_system.run(suite)
    suite = tr_memory.run(suite)
    suite = tr_text.run(suite)
    suite = tr_fixed.run(suite)
    suite = tr_image.run(suite)
    out suite
}
