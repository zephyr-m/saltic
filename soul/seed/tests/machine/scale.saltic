use core.group
use craft.testing
use selfhost.machine.instruction
use selfhost.machine.layout
use selfhost.machine.image
use selfhost.compiler.backend.rv32i
use selfhost.machine.buffer

SCALE_BYTES = 65536

skill run(suite) {
    @bytes = buffer.empty()
    bytes = buffer.append_zeroes(bytes, SCALE_BYTES)
    bytes = buffer.set_byte(bytes, 0, 17)
    bytes = buffer.set_byte(bytes, buffer.CHUNK_SIZE - 1, 34)
    bytes = buffer.set_byte(bytes, buffer.CHUNK_SIZE, 51)
    bytes = buffer.set_byte(bytes, SCALE_BYTES - 1, 68)

    suite = testing.test_equal(suite, "scale: длина буфера 64 KiB", bytes.length, SCALE_BYTES)
    suite = testing.test_equal(suite, "scale: первый байт доступен", buffer.byte_at(bytes, 0), 17)
    suite = testing.test_equal(suite, "scale: конец первого chunk доступен", buffer.byte_at(bytes, buffer.CHUNK_SIZE - 1), 34)
    suite = testing.test_equal(suite, "scale: начало второго chunk доступно", buffer.byte_at(bytes, buffer.CHUNK_SIZE), 51)
    suite = testing.test_equal(suite, "scale: последний байт доступен", buffer.byte_at(bytes, SCALE_BYTES - 1), 68)
    suite = testing.test_equal(suite, "scale: число chunks конечно", buffer.chunk_count(bytes), 256)
    suite = testing.test_equal(suite, "scale: file boundary не расплющивает байты", group.count(buffer.file_chunks(bytes)), 256)
    suite = testing.test_yes(suite, "scale: таблица команд создаётся один раз", instruction.all() == instruction.all())

    @target = rv32i.host("_start")
    target = rv32i.label(target, layout.Section.CODE, "_start")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.EBREAK, 0, 0, 0, 0))
    target.data = bytes
    @current = layout.layout(target)
    @output = image.executable(target)
    suite = testing.test_yes(suite, "scale: ELF с payload 64 KiB создан", output.length > SCALE_BYTES)
    suite = testing.test_equal(suite, "scale: ELF сохранил последний байт payload", buffer.byte_at(output, 4096 + current.data_offset + SCALE_BYTES - 1), 68)
    out suite
}
