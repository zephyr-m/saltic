-- scale test — буфер на 64 KiB: байты на границах чанков, buffer.whole,
-- единственность таблицы команд, ELF с большим payload.
--
-- run(suite) -> suite

use core.group
use craft.testing
use selfhost.machine.instruction
use selfhost.machine.layout
use selfhost.machine.image
use selfhost.compiler.backend.rv32i
use selfhost.machine.buffer
use core.bytes

SCALE_BYTES = 65536

skill run(suite) {
    @scaled = buffer.empty()
    scaled = buffer.append_zeroes(scaled, SCALE_BYTES)
    scaled = buffer.set_byte(scaled, 0, 17)
    scaled = buffer.set_byte(scaled, buffer.CHUNK_SIZE - 1, 34)
    scaled = buffer.set_byte(scaled, buffer.CHUNK_SIZE, 51)
    scaled = buffer.set_byte(scaled, SCALE_BYTES - 1, 68)

    suite = testing.test_equal(suite, "scale: длина буфера 64 KiB", scaled.length, SCALE_BYTES)
    suite = testing.test_equal(suite, "scale: первый байт доступен", buffer.byte_at(scaled, 0), 17)
    suite = testing.test_equal(suite, "scale: конец первого chunk доступен", buffer.byte_at(scaled, buffer.CHUNK_SIZE - 1), 34)
    suite = testing.test_equal(suite, "scale: начало второго chunk доступно", buffer.byte_at(scaled, buffer.CHUNK_SIZE), 51)
    suite = testing.test_equal(suite, "scale: последний байт доступен", buffer.byte_at(scaled, SCALE_BYTES - 1), 68)
    suite = testing.test_equal(suite, "scale: число chunks конечно", buffer.chunk_count(scaled), SCALE_BYTES / buffer.CHUNK_SIZE)
    @whole = buffer.whole(scaled)
    suite = testing.test_equal(suite, "scale: целый буфер — длина", bytes.count(whole), SCALE_BYTES)
    suite = testing.test_equal(suite, "scale: целый буфер — последний", bytes.get(whole, SCALE_BYTES - 1), 68)
    suite = testing.test_yes(suite, "scale: таблица команд создаётся один раз", instruction.all() == instruction.all())

    @target = rv32i.host("_start")
    target = rv32i.label(target, layout.Section.CODE, "_start")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.EBREAK, 0, 0, 0, 0))
    target.data = scaled
    @current = layout.layout(target)
    @output = image.executable(target)
    suite = testing.test_yes(suite, "scale: ELF с payload 64 KiB создан", output.length > SCALE_BYTES)
    suite = testing.test_equal(suite, "scale: ELF сохранил последний байт payload", buffer.byte_at(output, 4096 + current.data_offset + SCALE_BYTES - 1), 68)
    out suite
}
