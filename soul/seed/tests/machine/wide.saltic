-- wide test — 64-битное значение для RV64 из двух word: десятичный текст в
-- обе стороны, перенос между половинами, знак, сдвиг, переполнение 64 бит.
--
-- overflows(text) -> yes/no — from_decimal дал WideOutsideRange
-- run(suite) -> suite

use craft.testing
use selfhost.machine.word
use selfhost.machine.wide

skill overflows(text) {
    @failed = no
    @value = wide.from_decimal(text) rescue |failure| {
        failed = yes
        wide.Wide {}
    }
    value = value
    out failed
}

skill run(suite) {
    @top = wide.from_decimal("1152921504606846975")
    suite = testing.test_equal(suite, "wide: 2^60 - 1 туда и обратно", wide.text(top), "1152921504606846975")
    suite = testing.test_equal(suite, "wide: старшее слово 2^60 - 1", word.text(top.high), "268435455")
    suite = testing.test_equal(suite, "wide: младшее слово 2^60 - 1", word.text(top.low), "4294967295")
    @max = wide.from_decimal("18446744073709551615")
    suite = testing.test_equal(suite, "wide: 2^64 - 1", wide.text(max), "18446744073709551615")
    suite = testing.test_yes(suite, "wide: 2^64 — переполнение", overflows("18446744073709551616"))
    @carry = wide.add(wide.from_decimal("4294967295"), wide.from_number(1))
    suite = testing.test_equal(suite, "wide: перенос в старшее слово", wide.text(carry), "4294967296")
    @minus = wide.from_signed(-1)
    suite = testing.test_equal(suite, "wide: -1 — все единицы", wide.text(minus), "18446744073709551615")
    @negative = wide.from_decimal("-1152921504606846976")
    suite = testing.test_equal(suite, "wide: -2^60 в дополнительном коде", wide.text(negative), "17293822569102704640")
    @shifted = wide.shift_left(wide.from_number(1), 63)
    suite = testing.test_equal(suite, "wide: 1 << 63", wide.text(shifted), "9223372036854775808")
    suite = testing.test_yes(suite, "wide: ноль", wide.is_zero(wide.Wide {}))
    @small = wide.to_word(wide.from_number(4096))
    suite = testing.test_equal(suite, "wide: в word, если влезает", word.to_number(small), 4096)
    out suite
}
