use seed
use craft.testing
use seed.machine.instruction
use seed.machine.codec
use seed.machine.layout
use seed.compiler.backend.rv32i

skill word_is(buffer, offset, b0, b1, b2, b3) {
    (codec.byte_at(buffer, offset) == b0) {
        (codec.byte_at(buffer, offset + 1) == b1) {
            (codec.byte_at(buffer, offset + 2) == b2) {
                out codec.byte_at(buffer, offset + 3) == b3
            }
        }
    }
    out no
}

skill fixture() {
    @target = rv32i.host("_start")
    target = rv32i.label(target, layout.Section.CODE, "_start")
    target = rv32i.branch(target, instruction.Kind.BEQ, 1, 2, "forward")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, 0, 0, 0, 0))
    target = rv32i.label(target, layout.Section.CODE, "forward")
    target = rv32i.branch(target, instruction.Kind.BNE, 3, 4, "_start")
    target = rv32i.jump(target, 5, "jump_target")
    target = rv32i.emit(target, rv32i.operation(instruction.Kind.ADDI, 0, 0, 0, 0))
    target = rv32i.label(target, layout.Section.CODE, "jump_target")
    target = rv32i.relative_address(target, 6, "target", 0)
    target = rv32i.absolute_address(target, 7, "target", 0)
    target.code = codec.append_zeroes(target.code, 2034)
    target = rv32i.label(target, layout.Section.CODE, "target")
    target = layout.append_label_address(target, layout.Section.DATA, "target", 0)
    out rv32i.resolve(target)
}

skill run(suite) {
    @target = fixture()
    suite = testing.test_equal(suite, "patches: четыре метки сохранены", target.label_count, 4)
    suite = testing.test_equal(suite, "patches: восемь исправлений сохранены", target.patch_count, 8)
    suite = testing.test_yes(suite, "patch branch: положительное смещение", word_is(target.code, 0, 99, 132, 32, 0))
    suite = testing.test_yes(suite, "patch branch: отрицательное смещение", word_is(target.code, 8, 227, 156, 65, 254))
    suite = testing.test_yes(suite, "patch jump", word_is(target.code, 12, 239, 2, 128, 0))
    suite = testing.test_yes(suite, "patch relative high: перенос low", word_is(target.code, 20, 23, 19, 0, 0))
    suite = testing.test_yes(suite, "patch relative low: отрицательный остаток", word_is(target.code, 24, 19, 3, 35, 128))
    suite = testing.test_yes(suite, "patch absolute high: перенос low", word_is(target.code, 28, 183, 19, 1, 0))
    suite = testing.test_yes(suite, "patch absolute low: отрицательный остаток", word_is(target.code, 32, 147, 131, 99, 129))
    suite = testing.test_yes(suite, "patch address word", word_is(target.data, 0, 22, 8, 1, 0))
    out suite
}
