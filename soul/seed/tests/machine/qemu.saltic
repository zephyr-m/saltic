use craft.testing
use selfhost.machine.layout
use selfhost.machine.image
use selfhost.compiler
use selfhost.machine.word
use selfhost.machine.buffer

skill ordinary_program(heap_bytes) {
    @ast = ["program", ["entry", [], ["block", ["out", ["number", 7]]]]]
    @target = compiler.compile_machine_with_heap(ast, word.from_number(heap_bytes))
    out layout.resolve(target)
}

skill exhausted_program() {
    @ast = ["program", ["entry", [], ["block", ["out", ["group", ["number", 1]]]]]]
    @target = compiler.compile_machine_with_heap(ast, word.from_number(16))
    out layout.resolve(target)
}

skill wide_heap_program() {
    @ast = ["program", ["entry", [], ["block", ["out", ["number", 7]]]]]
    @target = compiler.compile_machine_with_heap(ast, word.from_decimal("4026531840"))
    out layout.resolve(target)
}

skill run(suite, output_path) {
    @ordinary = ordinary_program(64)
    @output = image.executable(ordinary)
    @start = layout.find_label(ordinary, "_start")
    @entry = layout.find_label(ordinary, "saltic_program")
    @exit_label = layout.find_label(ordinary, "rt_platform_exit")
    suite = testing.test_yes(suite, "обычная программа: машинный канал разрешён", ordinary.resolved)
    suite = testing.test_yes(suite, "обычная программа: _start существует", start.present)
    suite = testing.test_yes(suite, "обычная программа: program существует", entry.present)
    suite = testing.test_yes(suite, "обычная программа: runtime существует", exit_label.present)
    suite = testing.test_equal(suite, "обычная программа: параметр heap", word.to_number(ordinary.heap_size), 64)
    suite = testing.test_equal(suite, "обычная программа: BSS — арена и heap", word.to_number(ordinary.bss_size), 2097216)
    suite = testing.test_equal(suite, "обычная программа: ELF magic", buffer.byte_at(output, 0), 127)
    suite = testing.test_yes(suite, "обычная программа: ELF содержит payload", output.length > 4096)
    @exhausted = exhausted_program()
    suite = testing.test_equal(suite, "квота: маленький heap сохранён", word.to_number(exhausted.heap_size), 16)
    @wide = wide_heap_program()
    @wide_output = image.executable(wide)
    suite = testing.test_equal(suite, "широкая квота: decimal сохраняется", word.text(wide.heap_size), "4026531840")
    suite = testing.test_equal(suite, "широкая квота: heap занимает 0xf0000000", wide.heap_size.b3, 240)
    suite = testing.test_equal(suite, "широкая квота: BSS занимает 0xf0000000", wide.bss_size.b3, 240)
    suite = testing.test_yes(suite, "широкая квота: ELF не расплющивает BSS в файл", wide_output.length < 65536)
    image.write_buffer(output_path, output)
    out suite
}
