-- qemu test — compiler.compile_machine_with_heap: метки _start,
-- saltic_program, rt_platform_exit; размер heap и BSS (в том числе
-- 0xf0000000), ELF без раздутого BSS. Пишет ELF обычной программы в
-- output_path — его потом запускает qemu-riscv32 (tests/run.sh).
--
-- ordinary_program(heap_bytes) / exhausted_program() / wide_heap_program()
--     -> разрешённая цель
-- run(suite, output_path) -> suite

use craft.testing
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.image
use selfhost.compiler
use selfhost.machine.word
use selfhost.machine.wide
use selfhost.compiler.backend.rv32i.machine.buffer

skill ordinary_program(heap_bytes) {
    @ast = ["program", ["entry", [], ["block", ["out", ["number", 7]]]]]
    @target = compiler.compile_machine_with_heap(ast, wide.from_number(heap_bytes))
    out layout.resolve(target)
}

skill exhausted_program() {
    @ast = ["program", ["entry", [], ["block", ["out", ["group", ["number", 1]]]]]]
    @target = compiler.compile_machine_with_heap(ast, wide.from_number(16))
    out layout.resolve(target)
}

skill wide_heap_program() {
    @ast = ["program", ["entry", [], ["block", ["out", ["number", 7]]]]]
    @target = compiler.compile_machine_with_heap(ast, wide.from_decimal("4026531840"))
    out layout.resolve(target)
}

skill run(suite, output_path) {
    @ordinary = ordinary_program(64)
    @output = image.executable(ordinary)
    @start = layout.find_label(ordinary, "_start")
    @entry = layout.find_label(ordinary, "saltic_program")
    @exit_label = layout.find_label(ordinary, "rt_platform_exit")
    suite = testing.test_yes(suite, "обычная программа: машинный канал разрешён", ordinary.resolved)
    suite = testing.test_yes(suite, "обычная программа: _start существует", start.present)
    suite = testing.test_yes(suite, "обычная программа: program существует", entry.present)
    suite = testing.test_yes(suite, "обычная программа: runtime существует", exit_label.present)
    suite = testing.test_equal(suite, "обычная программа: параметр heap", word.to_number(wide.to_word(ordinary.heap_size)), 64)
    suite = testing.test_equal(suite, "обычная программа: BSS — арена и слово начала кучи", word.to_number(wide.to_word(ordinary.bss_size)), 4194564)
    suite = testing.test_equal(suite, "обычная программа: ELF magic", buffer.byte_at(output, 0), 127)
    suite = testing.test_yes(suite, "обычная программа: ELF содержит payload", output.length > 4096)
    @exhausted = exhausted_program()
    suite = testing.test_equal(suite, "квота: маленький heap сохранён", word.to_number(wide.to_word(exhausted.heap_size)), 16)
    @large = wide_heap_program()
    @large_output = image.executable(large)
    suite = testing.test_equal(suite, "широкая квота: decimal сохраняется", wide.text(large.heap_size), "4026531840")
    suite = testing.test_equal(suite, "широкая квота: heap занимает 0xf0000000", large.heap_size.low.b3, 240)
    suite = testing.test_equal(suite, "широкая квота: куча не в BSS — её даёт платформа", large.bss_size.low.b3, 0)
    suite = testing.test_yes(suite, "широкая квота: ELF не расплющивает BSS в файл", large_output.length < 65536)
    image.write_buffer(output_path, output)
    out suite
}
