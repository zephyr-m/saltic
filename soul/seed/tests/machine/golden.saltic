use seed
use craft.testing
use seed.machine.instruction
use seed.machine.codec

skill same(actual, b0, b1, b2, b3) {
    (actual.b0 == b0) {
        (actual.b1 == b1) {
            (actual.b2 == b2) { out actual.b3 == b3 }
        }
    }
    out no
}

skill check(suite, title, kind, b0, b1, b2, b3) {
    @actual = codec.encode_kind(kind, 1, 2, 3, 4)
    out testing.test_yes(suite, seed.str.add("golden: ", title), same(actual, b0, b1, b2, b3))
}

skill run(suite) {
    suite = testing.test_equal(suite, "golden: таблица содержит 44 команды", instruction.count(), 44)
    suite = check(suite, "lui", instruction.Kind.LUI, 183, 64, 0, 0)
    suite = check(suite, "auipc", instruction.Kind.AUIPC, 151, 64, 0, 0)
    suite = check(suite, "jal", instruction.Kind.JAL, 239, 0, 64, 0)
    suite = check(suite, "jalr", instruction.Kind.JALR, 231, 0, 65, 0)
    suite = check(suite, "beq", instruction.Kind.BEQ, 99, 2, 49, 0)
    suite = check(suite, "bne", instruction.Kind.BNE, 99, 18, 49, 0)
    suite = check(suite, "blt", instruction.Kind.BLT, 99, 66, 49, 0)
    suite = check(suite, "bge", instruction.Kind.BGE, 99, 82, 49, 0)
    suite = check(suite, "bltu", instruction.Kind.BLTU, 99, 98, 49, 0)
    suite = check(suite, "bgeu", instruction.Kind.BGEU, 99, 114, 49, 0)
    suite = check(suite, "lb", instruction.Kind.LB, 131, 0, 65, 0)
    suite = check(suite, "lh", instruction.Kind.LH, 131, 16, 65, 0)
    suite = check(suite, "lw", instruction.Kind.LW, 131, 32, 65, 0)
    suite = check(suite, "lbu", instruction.Kind.LBU, 131, 64, 65, 0)
    suite = check(suite, "lhu", instruction.Kind.LHU, 131, 80, 65, 0)
    suite = check(suite, "sb", instruction.Kind.SB, 35, 2, 49, 0)
    suite = check(suite, "sh", instruction.Kind.SH, 35, 18, 49, 0)
    suite = check(suite, "sw", instruction.Kind.SW, 35, 34, 49, 0)
    suite = check(suite, "addi", instruction.Kind.ADDI, 147, 0, 65, 0)
    suite = check(suite, "slti", instruction.Kind.SLTI, 147, 32, 65, 0)
    suite = check(suite, "sltiu", instruction.Kind.SLTIU, 147, 48, 65, 0)
    suite = check(suite, "xori", instruction.Kind.XORI, 147, 64, 65, 0)
    suite = check(suite, "ori", instruction.Kind.ORI, 147, 96, 65, 0)
    suite = check(suite, "andi", instruction.Kind.ANDI, 147, 112, 65, 0)
    suite = check(suite, "slli", instruction.Kind.SLLI, 147, 16, 65, 0)
    suite = check(suite, "srli", instruction.Kind.SRLI, 147, 80, 65, 0)
    suite = check(suite, "srai", instruction.Kind.SRAI, 147, 80, 65, 64)
    suite = check(suite, "add", instruction.Kind.ADD, 179, 0, 49, 0)
    suite = check(suite, "sub", instruction.Kind.SUB, 179, 0, 49, 64)
    suite = check(suite, "sll", instruction.Kind.SLL, 179, 16, 49, 0)
    suite = check(suite, "slt", instruction.Kind.SLT, 179, 32, 49, 0)
    suite = check(suite, "sltu", instruction.Kind.SLTU, 179, 48, 49, 0)
    suite = check(suite, "xor", instruction.Kind.XOR, 179, 64, 49, 0)
    suite = check(suite, "srl", instruction.Kind.SRL, 179, 80, 49, 0)
    suite = check(suite, "sra", instruction.Kind.SRA, 179, 80, 49, 64)
    suite = check(suite, "or", instruction.Kind.OR, 179, 96, 49, 0)
    suite = check(suite, "and", instruction.Kind.AND, 179, 112, 49, 0)
    suite = check(suite, "fence", instruction.Kind.FENCE, 15, 0, 64, 0)
    suite = check(suite, "ecall", instruction.Kind.ECALL, 115, 0, 0, 0)
    suite = check(suite, "ebreak", instruction.Kind.EBREAK, 115, 0, 16, 0)
    suite = check(suite, "csrrw", instruction.Kind.CSRRW, 243, 16, 65, 0)
    suite = check(suite, "csrrs", instruction.Kind.CSRRS, 243, 32, 65, 0)
    suite = check(suite, "mret", instruction.Kind.MRET, 115, 0, 32, 48)
    suite = check(suite, "wfi", instruction.Kind.WFI, 115, 0, 80, 16)
    out suite
}
