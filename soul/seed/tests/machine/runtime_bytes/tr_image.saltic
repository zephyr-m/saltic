-- tr_image — эталоны машинного кода, часть runtime_bytes:
-- show, запись байтов в файл и машинный образ: _start, литералы, Box, drum, bss, цельный рантайм.
-- Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use selfhost.abi
use craft.testing
use selfhost.compiler.state
use selfhost.compiler.codegen
use selfhost.compiler.constants
use selfhost.abi.shape
use selfhost.compiler.backend.rv32i.runtime
use selfhost.compiler.backend.rv32i.machine.layout
use selfhost.compiler.backend.rv32i.machine.registers
use selfhost.compiler.backend.rv32i
use selfhost.compiler.backend.rv32i.assembler
use selfhost.machine.word
use selfhost.machine.wide
use selfhost.compiler.backend.rv32i.machine.buffer
use selfhost.compiler.backend.rv32i.runtime.host
use selfhost.compiler.platform.linux
use selfhost.compiler.functions

skill run(suite) {
    @show = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    show = host.emit_show(show)
    show.machine = layout.define_label(show.machine, layout.Section.CODE, "rt_number_text")
    show.machine = layout.define_label(show.machine, layout.Section.CODE, "rt_platform_write")
    show.machine = layout.define_label(show.machine, layout.Section.CODE, "rt_error_text")
    show.machine = layout.define_label(show.machine, layout.Section.RODATA, "rt_unknown_text")
    show.machine = layout.define_label(show.machine, layout.Section.RODATA, "rt_yes_text")
    show.machine = layout.define_label(show.machine, layout.Section.RODATA, "rt_no_text")
    show.machine = layout.define_label(show.machine, layout.Section.BSS, "saltic_out_fd")
    show.machine = layout.resolve(show.machine)
    @show_bytes = [
        147, 114, 117, 0, 19, 3, 48, 0,
        99, 142, 98, 8, 19, 3, 0, 0,
        99, 134, 98, 2, 19, 3, 144, 0,
        99, 2, 101, 4, 19, 3, 16, 0,
        99, 14, 101, 2, 19, 3, 112, 0,
        99, 142, 98, 4, 23, 5, 0, 0,
        19, 5, 197, 11, 19, 101, 53, 0,
        111, 0, 192, 6, 19, 1, 1, 255,
        35, 38, 17, 0, 239, 0, 0, 10,
        239, 240, 159, 251, 131, 32, 193, 0,
        19, 1, 1, 1, 147, 5, 0, 0,
        103, 128, 0, 0, 147, 2, 16, 0,
        99, 10, 85, 0, 23, 5, 0, 0,
        19, 5, 69, 8, 19, 101, 53, 0,
        111, 0, 64, 3, 23, 5, 0, 0,
        19, 5, 69, 7, 19, 101, 53, 0,
        111, 0, 64, 2, 19, 1, 1, 255,
        35, 38, 17, 0, 239, 0, 128, 5,
        239, 240, 31, 247, 131, 32, 193, 0,
        19, 1, 1, 1, 147, 5, 0, 0,
        103, 128, 0, 0, 147, 114, 133, 255,
        3, 166, 194, 0, 147, 133, 2, 1,
        23, 21, 0, 0, 19, 5, 5, 245,
        3, 37, 5, 0, 99, 20, 5, 0,
        19, 5, 16, 0, 19, 1, 1, 255,
        35, 38, 17, 0, 239, 0, 128, 1,
        131, 32, 193, 0, 19, 1, 1, 1,
        19, 5, 16, 1, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон show: длина", show.machine.code.length, 228)
    suite = testing.test_equal(suite, "эталон show: переходы", show.machine.patch_count, 23)
    drum (228) {
        suite = testing.test_equal(suite, "эталон show: байт {beat}", buffer.byte_at(show.machine.code, beat), group.get(show_bytes, beat))
    }
    @show_label = layout.find_label(show.machine, "rt_show")
    @show_number = layout.find_label(show.machine, ".L_show_number")
    @show_answer = layout.find_label(show.machine, ".L_show_answer")
    @show_no = layout.find_label(show.machine, ".L_show_no")
    @show_error = layout.find_label(show.machine, ".L_show_error")
    @show_string = layout.find_label(show.machine, ".L_show_string")
    @show_number_text = layout.find_label(show.machine, "rt_number_text")
    @show_platform_write = layout.find_label(show.machine, "rt_platform_write")
    @show_unknown_text = layout.find_label(show.machine, "rt_unknown_text")
    @show_yes_text = layout.find_label(show.machine, "rt_yes_text")
    @show_no_text = layout.find_label(show.machine, "rt_no_text")
    @show_error_text = layout.find_label(show.machine, "rt_error_text")
    suite = testing.test_yes(suite, "эталон rt_show: метка существует", show_label.present)
    suite = testing.test_equal(suite, "эталон rt_show: смещение", show_label.offset, 0)
    suite = testing.test_yes(suite, "show: число существует", show_number.present)
    suite = testing.test_equal(suite, "show: смещение числа", show_number.offset, 60)
    suite = testing.test_yes(suite, "show: answer существует", show_answer.present)
    suite = testing.test_equal(suite, "show: смещение answer", show_answer.offset, 92)
    suite = testing.test_yes(suite, "show: no существует", show_no.present)
    suite = testing.test_equal(suite, "show: смещение no", show_no.offset, 116)
    suite = testing.test_yes(suite, "show: error существует", show_error.present)
    suite = testing.test_equal(suite, "show: смещение error", show_error.offset, 132)
    suite = testing.test_yes(suite, "show: строка существует", show_string.present)
    suite = testing.test_equal(suite, "show: смещение строки", show_string.offset, 164)
    suite = testing.test_yes(suite, "show: number text связан", show_number_text.present)
    suite = testing.test_equal(suite, "show: смещение number text", show_number_text.offset, 228)
    suite = testing.test_yes(suite, "show: platform write связан", show_platform_write.present)
    suite = testing.test_equal(suite, "show: смещение platform write", show_platform_write.offset, 228)
    suite = testing.test_yes(suite, "show: unknown text связан", show_unknown_text.present)
    suite = testing.test_equal(suite, "show: смещение unknown text в rodata", show_unknown_text.offset, 0)
    suite = testing.test_yes(suite, "show: yes text связан", show_yes_text.present)
    suite = testing.test_equal(suite, "show: смещение yes text в rodata", show_yes_text.offset, 0)
    suite = testing.test_yes(suite, "show: no text связан", show_no_text.present)
    suite = testing.test_equal(suite, "show: смещение no text в rodata", show_no_text.offset, 0)
    suite = testing.test_yes(suite, "show: error text связан", show_error_text.present)
    suite = testing.test_equal(suite, "show: смещение error text", show_error_text.offset, 228)

    @file_write_bytes_runtime = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    file_write_bytes_runtime = host.emit_file_write_bytes(file_write_bytes_runtime)
    file_write_bytes_runtime.machine = layout.define_label(file_write_bytes_runtime.machine, layout.Section.CODE, "rt_platform_file_write")
    file_write_bytes_runtime.machine = layout.define_label(file_write_bytes_runtime.machine, layout.Section.CODE, "rt_file_bytes_text")
    file_write_bytes_runtime.machine = layout.define_label(file_write_bytes_runtime.machine, layout.Section.CODE, "rt_group_flatten")
    file_write_bytes_runtime.machine = layout.resolve(file_write_bytes_runtime.machine)
    @file_write_bytes_runtime_bytes = [
        19, 1, 1, 255, 35, 38, 17, 0,
        35, 36, 161, 0, 19, 133, 5, 0,
        239, 0, 192, 2, 147, 114, 133, 255,
        131, 165, 194, 0, 19, 6, 0, 0,
        239, 0, 192, 1, 147, 5, 5, 0,
        3, 37, 129, 0, 239, 0, 0, 1,
        131, 32, 193, 0, 19, 1, 1, 1,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон file write bytes: длина", file_write_bytes_runtime.machine.code.length, 60)
    suite = testing.test_equal(suite, "эталон file write bytes: переходов", file_write_bytes_runtime.machine.patch_count, 3)
    drum (60) {
        suite = testing.test_equal(suite, "эталон file write bytes: байт {beat}", buffer.byte_at(file_write_bytes_runtime.machine.code, beat), group.get(file_write_bytes_runtime_bytes, beat))
    }
    @file_write_bytes_runtime_label = layout.find_label(file_write_bytes_runtime.machine, "rt_file_write_bytes")
    @file_write_bytes_error = layout.find_label(file_write_bytes_runtime.machine, "rt_platform_file_write")
    @file_write_bytes_group = layout.find_label(file_write_bytes_runtime.machine, "rt_file_bytes_text")
    suite = testing.test_yes(suite, "эталон rt_file_write_bytes: метка существует", file_write_bytes_runtime_label.present)
    suite = testing.test_equal(suite, "эталон rt_file_write_bytes: смещение", file_write_bytes_runtime_label.offset, 0)
    suite = testing.test_yes(suite, "file write bytes: file error связан", file_write_bytes_error.present)
    suite = testing.test_equal(suite, "file write bytes: смещение file error", file_write_bytes_error.offset, 60)
    suite = testing.test_yes(suite, "file write bytes: byte group связан", file_write_bytes_group.present)
    suite = testing.test_equal(suite, "file write bytes: смещение byte group", file_write_bytes_group.offset, 60)

    @machine_start = state.State { entry = ["entry", ["first", "second"], ["block"]], executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_start = state.header(machine_start)
    machine_start = state.start(machine_start)
    suite = testing.test_equal(suite, "машинный _start: размер кода", machine_start.machine.code.length, 128)
    suite = testing.test_equal(suite, "машинный _start: число patches", machine_start.machine.patch_count, 11)
    @start_label = layout.find_label(machine_start.machine, "_start")
    suite = testing.test_yes(suite, "машинный _start: метка существует", start_label.present)
    suite = testing.test_equal(suite, "машинный _start: смещение метки", start_label.offset, 0)
    suite = testing.test_equal(suite, "машинный _start: стек входа — mv a0, sp (addi)", buffer.byte_at(machine_start.machine.code, 0), 19)
    suite = testing.test_equal(suite, "машинный _start: lw opcode", buffer.byte_at(machine_start.machine.code, 8), 3)
    suite = testing.test_equal(suite, "машинный _start: lw registers", buffer.byte_at(machine_start.machine.code, 9), 37)
    suite = testing.test_equal(suite, "машинный _start: адрес кучи начинается с auipc", buffer.byte_at(machine_start.machine.code, 12), 151)
    suite = testing.test_equal(suite, "машинный _start: обязательные аргументы", buffer.byte_at(machine_start.machine.code, 46), 48)
    @start_args_ready = layout.find_label(machine_start.machine, ".L_start_args_ready")
    suite = testing.test_yes(suite, "машинный _start: метка готовых аргументов существует", start_args_ready.present)
    suite = testing.test_equal(suite, "машинный _start: смещение готовых аргументов", start_args_ready.offset, 60)
    suite = testing.test_equal(suite, "машинный _start: дальний переход начинается с auipc", buffer.byte_at(machine_start.machine.code, 52), 19)
    suite = testing.test_equal(suite, "машинный _start: дальний переход заканчивается jalr", buffer.byte_at(machine_start.machine.code, 60), 3)
    machine_start.machine = layout.define_label(machine_start.machine, layout.Section.CODE, "rt_environment_capture")
    machine_start.machine = layout.define_label(machine_start.machine, layout.Section.CODE, "rt_missing_args")
    machine_start.machine = layout.define_label(machine_start.machine, layout.Section.CODE, "rt_cstring")
    machine_start.machine = layout.define_label(machine_start.machine, layout.Section.CODE, "saltic_program")
    machine_start.machine = layout.define_label(machine_start.machine, layout.Section.CODE, "rt_platform_exit")
    machine_start.machine = layout.define_label(machine_start.machine, layout.Section.CODE, "rt_start_failure")
    machine_start.machine = layout.define_label(machine_start.machine, layout.Section.BSS, "saltic_heap")
    machine_start.machine = layout.reserve_bss(machine_start.machine, wide.from_number(16))
    machine_start.machine = layout.define_label(machine_start.machine, layout.Section.BSS, "saltic_heap_end")
    machine_start.machine = layout.resolve(machine_start.machine)
    suite = testing.test_yes(suite, "машинный _start: все ссылки разрешены", machine_start.machine.resolved)

    @machine_function = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_function.machine = layout.host("saltic_sample")
    machine_function = functions.compile_function(machine_function, "sample", ["first", "second"], ["block"], "", "")
    suite = testing.test_equal(suite, "машинная функция: размер каркаса", machine_function.machine.code.length, 116)
    suite = testing.test_equal(suite, "машинная функция: jump, регион, путь ошибки и вызов выхода", machine_function.machine.patch_count, 6)
    @function_label = layout.find_label(machine_function.machine, "saltic_sample")
    @function_return = layout.find_label(machine_function.machine, ".L_sample_return_0")
    suite = testing.test_yes(suite, "машинная функция: метка существует", function_label.present)
    suite = testing.test_equal(suite, "машинная функция: начало", function_label.offset, 0)
    suite = testing.test_yes(suite, "машинная функция: return существует", function_return.present)
    suite = testing.test_equal(suite, "машинная функция: return offset", function_return.offset, 80)
    suite = testing.test_equal(suite, "машинная функция: addi sp opcode", buffer.byte_at(machine_function.machine.code, 0), 19)
    suite = testing.test_equal(suite, "машинная функция: frame immediate", buffer.byte_at(machine_function.machine.code, 2), 1)
    machine_function.machine = layout.define_label(machine_function.machine, layout.Section.CODE, "rt_region_exit")
    machine_function.machine = layout.define_label(machine_function.machine, layout.Section.CODE, "rt_trail_push")
    machine_function.machine = layout.resolve(machine_function.machine)
    suite = testing.test_yes(suite, "машинная функция: все ссылки разрешены", machine_function.machine.resolved)

    @machine_call = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_call.machine = layout.host("caller")
    machine_call.skills = [state.Symbol { name = "callee", kind = "skill" }]
    machine_call.current_function = state.Function {}
    machine_call = codegen.compile_call(machine_call, ["call", ["path", "callee"]])
    suite = testing.test_equal(suite, "машинный call: размер", machine_call.machine.code.length, 4)
    suite = testing.test_equal(suite, "машинный call: два patches", machine_call.machine.patch_count, 1)
    machine_call.machine = layout.define_label(machine_call.machine, layout.Section.CODE, "saltic_callee")
    machine_call.machine = layout.resolve(machine_call.machine)
    suite = testing.test_yes(suite, "машинный call: ссылки разрешены", machine_call.machine.resolved)
    suite = testing.test_equal(suite, "машинный call: jal", buffer.byte_at(machine_call.machine.code, 0), 239)

    @machine_literals = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_literals.machine = layout.host("literal")
    machine_literals = codegen.compile_expression(machine_literals, ["number", 300])
    machine_literals = codegen.compile_expression(machine_literals, ["answer", "yes"])
    machine_literals = codegen.compile_expression(machine_literals, ["none"])
    machine_literals = codegen.compile_expression(machine_literals, ["string", "saltic"])
    suite = testing.test_equal(suite, "машинные литералы: размер", machine_literals.machine.code.length, 28)
    suite = testing.test_equal(suite, "машинная строка: два patches", machine_literals.machine.patch_count, 2)
    suite = testing.test_equal(suite, "машинная строка: размер rodata", machine_literals.machine.rodata.length, 24)
    suite = testing.test_equal(suite, "машинная строка: kind", buffer.byte_at(machine_literals.machine.rodata, 0), abi.OBJECT_KIND_STRING)
    suite = testing.test_equal(suite, "машинная строка: payload bytes", buffer.byte_at(machine_literals.machine.rodata, 4), 11)
    suite = testing.test_equal(suite, "машинная строка: static flag", buffer.byte_at(machine_literals.machine.rodata, 8), abi.OBJECT_FLAG_STATIC)
    suite = testing.test_equal(suite, "машинная строка: длина", buffer.byte_at(machine_literals.machine.rodata, 12), 6)
    suite = testing.test_equal(suite, "машинная строка: первый байт", buffer.byte_at(machine_literals.machine.rodata, 16), 115)
    suite = testing.test_equal(suite, "машинная строка: нулевой конец", buffer.byte_at(machine_literals.machine.rodata, 22), 0)
    @machine_string_label = layout.find_label(machine_literals.machine, ".L_string_0")
    suite = testing.test_yes(suite, "машинная строка: метка существует", machine_string_label.present)
    suite = testing.test_equal(suite, "машинная строка: секция rodata", machine_string_label.section, layout.Section.RODATA)
    suite = testing.test_equal(suite, "машинная строка: смещение", machine_string_label.offset, 0)
    machine_literals.machine = layout.resolve(machine_literals.machine)
    suite = testing.test_yes(suite, "машинные литералы: ссылки разрешены", machine_literals.machine.resolved)

    @machine_group = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_group.machine = layout.host("group")
    machine_group = codegen.compile_expression(machine_group, ["group", ["number", 1], ["answer", "yes"]])
    suite = testing.test_equal(suite, "машинная группа: полный конструктор", machine_group.machine.code.length, 72)
    suite = testing.test_equal(suite, "машинная группа: два call patches", machine_group.machine.patch_count, 1)
    @machine_group_opcodes = [19, 19, 35, 19, 19, 35, 19, 239, 19, 35, 19, 35, 131, 35, 131, 35, 19, 19]
    drum (18) {
        suite = testing.test_equal(suite, "машинная группа: opcode {beat}", buffer.byte_at(machine_group.machine.code, beat * 4), group.get(machine_group_opcodes, beat))
    }
    machine_group.machine = layout.define_label(machine_group.machine, layout.Section.CODE, "rt_alloc")
    machine_group.machine = layout.resolve(machine_group.machine)
    suite = testing.test_yes(suite, "машинная группа: ссылки разрешены", machine_group.machine.resolved)

    @machine_box = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_box.machine = layout.host("box")
    machine_box = state.collect_box(machine_box, ["box", "Point", ["field", "x", ["number", 0]], ["field", "y", ["number", 0]]], "")
    machine_box = codegen.compile_expression(machine_box, ["box-new", "Point"])
    suite = testing.test_equal(suite, "машинный box: полный конструктор", machine_box.machine.code.length, 104)
    suite = testing.test_equal(suite, "машинный box: два call patches", machine_box.machine.patch_count, 1)
    @machine_box_opcodes = [19, 19, 35, 19, 19, 35, 19, 239, 19, 35, 19, 35, 147, 35, 131, 35, 147, 35, 131, 35, 147, 35, 147, 35, 19, 19]
    drum (26) {
        suite = testing.test_equal(suite, "машинный box: opcode {beat}", buffer.byte_at(machine_box.machine.code, beat * 4), group.get(machine_box_opcodes, beat))
    }
    machine_box.machine = layout.define_label(machine_box.machine, layout.Section.CODE, "rt_alloc")
    machine_box.machine = layout.resolve(machine_box.machine)
    suite = testing.test_yes(suite, "машинный box: ссылки разрешены", machine_box.machine.resolved)

    @machine_field = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_field.machine = layout.host("field")
    machine_field.fields = [state.Symbol { name = "x", kind = "field", value = 1 }]
    machine_field.current_function = state.Function { slots = [state.Symbol { name = "point", kind = "slot", value = -12 }] }
    machine_field = codegen.compile_expression(machine_field, ["path", "point", "x"])
    suite = testing.test_equal(suite, "машинное поле: чтение", machine_field.machine.code.length, 16)
    suite = testing.test_equal(suite, "машинное поле: два call patches", machine_field.machine.patch_count, 1)
    @machine_field_opcodes = [3, 147, 19, 239]
    drum (4) {
        suite = testing.test_equal(suite, "машинное поле: opcode {beat}", buffer.byte_at(machine_field.machine.code, beat * 4), group.get(machine_field_opcodes, beat))
    }
    machine_field.machine = layout.define_label(machine_field.machine, layout.Section.CODE, "rt_box_get")
    machine_field.machine = layout.resolve(machine_field.machine)
    suite = testing.test_yes(suite, "машинное поле: чтение связано", machine_field.machine.resolved)

    @machine_field_assign = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_field_assign.machine = layout.host("field_assign")
    machine_field_assign.fields = [state.Symbol { name = "x", kind = "field", value = 1 }]
    machine_field_assign.current_function = state.Function { slots = [state.Symbol { name = "point", kind = "slot", value = -12 }] }
    machine_field_assign = codegen.compile_statement(machine_field_assign, ["field-assign", ["path", "point", "x"], ["number", 7]], no)
    suite = testing.test_equal(suite, "машинное поле: запись", machine_field_assign.machine.code.length, 40)
    suite = testing.test_equal(suite, "машинное поле: запись имеет два call patches", machine_field_assign.machine.patch_count, 1)
    @machine_field_assign_opcodes = [3, 19, 35, 19, 19, 3, 19, 147, 147, 239]
    drum (10) {
        suite = testing.test_equal(suite, "машинная запись поля: opcode {beat}", buffer.byte_at(machine_field_assign.machine.code, beat * 4), group.get(machine_field_assign_opcodes, beat))
    }
    machine_field_assign.machine = layout.define_label(machine_field_assign.machine, layout.Section.CODE, "rt_box_set")
    machine_field_assign.machine = layout.resolve(machine_field_assign.machine)
    suite = testing.test_yes(suite, "машинное поле: запись связана", machine_field_assign.machine.resolved)

    @machine_local = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_local.current_function = state.Function { slots = [state.Symbol { name = "item", kind = "slot", value = -12 }] }
    machine_local = codegen.compile_expression(machine_local, ["number", 7])
    machine_local = codegen.compile_statement(machine_local, ["var", "item", ["number", 8]], no)
    machine_local = codegen.compile_path(machine_local, ["path", "item"])
    suite = testing.test_equal(suite, "машинный local: literal, store и load", machine_local.machine.code.length, 16)

    @machine_arguments = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_arguments = codegen.compile_arguments(machine_arguments, [["number", 1], ["number", 2]])
    suite = testing.test_equal(suite, "машинные аргументы: push, load и restore", machine_arguments.machine.code.length, 36)

    @machine_arithmetic = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_arithmetic.machine = layout.host("arithmetic")
    machine_arithmetic = codegen.compile_binary(machine_arithmetic, "+", ["number", 2], ["number", 3])
    suite = testing.test_equal(suite, "машинная арифметика: размер", machine_arithmetic.machine.code.length, 36)
    suite = testing.test_equal(suite, "машинная арифметика: без вызова runtime", machine_arithmetic.machine.patch_count, 0)
    @machine_arithmetic_opcodes = [19, 147, 179, 51, 147, 19, 147, 99, 147]
    drum (9) {
        suite = testing.test_equal(suite, "машинная арифметика: opcode {beat}", buffer.byte_at(machine_arithmetic.machine.code, beat * 4), group.get(machine_arithmetic_opcodes, beat))
    }
    machine_arithmetic.machine = layout.define_label(machine_arithmetic.machine, layout.Section.CODE, "rt_add")
    machine_arithmetic.machine = layout.resolve(machine_arithmetic.machine)
    suite = testing.test_yes(suite, "машинная арифметика: ссылки разрешены", machine_arithmetic.machine.resolved)

    @machine_comparison = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_comparison.machine = layout.host("comparison")
    machine_comparison = codegen.compile_binary(machine_comparison, "<", ["number", 2], ["number", 3])
    machine_comparison.machine = layout.define_label(machine_comparison.machine, layout.Section.CODE, "rt_less")
    machine_comparison.machine = layout.resolve(machine_comparison.machine)
    suite = testing.test_yes(suite, "машинное сравнение: runtime связан", machine_comparison.machine.resolved)

    @machine_fixed_literal = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_fixed_literal.machine = layout.host("fixed_literal")
    machine_fixed_literal = codegen.compile_call(machine_fixed_literal, ["call", ["path", "core", "i32", "from"], ["binary", "-", ["number", 0], ["number", 42]]])
    suite = testing.test_equal(suite, "машинный fixed literal: размер", machine_fixed_literal.machine.code.length, 12)
    suite = testing.test_equal(suite, "машинный fixed literal: два call patches", machine_fixed_literal.machine.patch_count, 1)
    suite = testing.test_equal(suite, "машинный fixed literal: source kind загружен в a6", buffer.byte_at(machine_fixed_literal.machine.code, 4), 19)
    machine_fixed_literal.machine = layout.define_label(machine_fixed_literal.machine, layout.Section.CODE, "rt_fixed_new")
    machine_fixed_literal.machine = layout.resolve(machine_fixed_literal.machine)
    suite = testing.test_yes(suite, "машинный fixed literal: runtime связан", machine_fixed_literal.machine.resolved)

    @negative_immediate = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    negative_immediate = assembler.load_immediate(negative_immediate, registers.A0, -4097)
    suite = testing.test_equal(suite, "машинный отрицательный immediate: lui/addi", negative_immediate.machine.code.length, 8)

    @maximum_word = word.from_decimal("4294967295")
    suite = testing.test_equal(suite, "decimal word: max b0", maximum_word.b0, 255)
    suite = testing.test_equal(suite, "decimal word: max b1", maximum_word.b1, 255)
    suite = testing.test_equal(suite, "decimal word: max b2", maximum_word.b2, 255)
    suite = testing.test_equal(suite, "decimal word: max b3", maximum_word.b3, 255)
    @minimum_word = word.from_decimal("-2147483648")
    suite = testing.test_equal(suite, "decimal word: min b0", minimum_word.b0, 0)
    suite = testing.test_equal(suite, "decimal word: min b1", minimum_word.b1, 0)
    suite = testing.test_equal(suite, "decimal word: min b2", minimum_word.b2, 0)
    suite = testing.test_equal(suite, "decimal word: min b3", minimum_word.b3, 128)

    @machine_wide_literal = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_wide_literal.machine = layout.host("wide_literal")
    machine_wide_literal = codegen.compile_call(machine_wide_literal, ["call", ["path", "core", "u32", "from"], ["wide-number", "4294967295"]])
    suite = testing.test_equal(suite, "машинный wide fixed: размер", machine_wide_literal.machine.code.length, 16)
    suite = testing.test_equal(suite, "машинный wide fixed: два call patches", machine_wide_literal.machine.patch_count, 1)
    machine_wide_literal.machine = layout.define_label(machine_wide_literal.machine, layout.Section.CODE, "rt_fixed_new")
    machine_wide_literal.machine = layout.resolve(machine_wide_literal.machine)
    suite = testing.test_yes(suite, "машинный wide fixed: runtime связан", machine_wide_literal.machine.resolved)
    suite = testing.test_equal(suite, "машинный wide fixed: lui", buffer.byte_at(machine_wide_literal.machine.code, 0), 55)
    suite = testing.test_equal(suite, "машинный wide fixed: addi", buffer.byte_at(machine_wide_literal.machine.code, 4), 19)

    @machine_if = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_if = codegen.compile_statement(machine_if, ["if", ["answer", "yes"], ["block", ["expr", ["number", 1]]]], no)
    suite = testing.test_equal(suite, "машинный if: размер", machine_if.machine.code.length, 40)
    suite = testing.test_equal(suite, "машинный if: три дальних перехода", machine_if.machine.patch_count, 3)
    @machine_if_opcodes = [19, 147, 99, 111, 147, 99, 111, 99, 111, 19]
    drum (10) {
        suite = testing.test_equal(suite, "машинный if: opcode {beat}", buffer.byte_at(machine_if.machine.code, beat * 4), group.get(machine_if_opcodes, beat))
    }
    machine_if.machine = layout.resolve(machine_if.machine)
    suite = testing.test_yes(suite, "машинный if: ссылки разрешены", machine_if.machine.resolved)

    @machine_switch = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_switch.variants = [state.Symbol { name = "Ready", kind = "variant", value = 6 }]
    machine_switch = codegen.compile_statement(machine_switch, ["switch", ["enum-value", "Ready"], ["case", "Ready", ["number", 1]]], no)
    suite = testing.test_equal(suite, "машинный switch: размер", machine_switch.machine.code.length, 28)
    suite = testing.test_equal(suite, "машинный switch: branch и jump", machine_switch.machine.patch_count, 2)
    machine_switch.machine = layout.resolve(machine_switch.machine)
    suite = testing.test_yes(suite, "машинный switch: ссылки разрешены", machine_switch.machine.resolved)

    @machine_drum = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_drum.current_function = state.Function { end = "drum_function_end", slots = [state.Symbol { name = "$drum:1", kind = "slot", value = -12 }] }
    machine_drum = codegen.compile_statement(machine_drum, ["drum", ["number", 2], ["block"]], no)
    suite = testing.test_equal(suite, "машинный drum: размер", machine_drum.machine.code.length, 80)
    suite = testing.test_equal(suite, "машинный drum: branch и jump", machine_drum.machine.patch_count, 6)
    @machine_drum_opcodes = [19, 19, 147, 99, 19, 3, 111, 19, 99, 19, 147, 19, 111, 35, 131, 99, 111, 147, 35, 111]
    drum (20) {
        suite = testing.test_equal(suite, "машинный drum: opcode {beat}", buffer.byte_at(machine_drum.machine.code, beat * 4), group.get(machine_drum_opcodes, beat))
    }
    machine_drum.machine = layout.define_label(machine_drum.machine, layout.Section.CODE, "drum_function_end")
    machine_drum.machine = layout.resolve(machine_drum.machine)
    suite = testing.test_yes(suite, "машинный drum: ссылки разрешены", machine_drum.machine.resolved)

    @machine_rescue = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_rescue.current_function = state.Function { slots = [state.Symbol { name = "failure", kind = "slot", value = -12 }, state.Symbol { name = "$rescue:1", kind = "slot", value = -16 }] }
    machine_rescue = codegen.compile_rescue(machine_rescue, ["rescue", ["number", 1], "failure", ["block"]])
    suite = testing.test_equal(suite, "машинный rescue: размер", machine_rescue.machine.code.length, 44)
    suite = testing.test_equal(suite, "машинный rescue: дальний переход и очистка пути", machine_rescue.machine.patch_count, 2)
    machine_rescue.machine = layout.define_label(machine_rescue.machine, layout.Section.CODE, "rt_trail_clear")
    machine_rescue.machine = layout.resolve(machine_rescue.machine)
    suite = testing.test_yes(suite, "машинный rescue: ссылки разрешены", machine_rescue.machine.resolved)

    @machine_constant_flow = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    @machine_constant = state.Symbol { name = "sample", kind = "const", node = ["number", 1] }
    machine_constant_flow = functions.compile_constant(machine_constant_flow, machine_constant)
    machine_constant_flow.constants = [machine_constant]
    machine_constant_flow = constants.emit_storage(machine_constant_flow)
    suite = testing.test_equal(suite, "машинная константа: полный getter", machine_constant_flow.machine.code.length, 160)
    suite = testing.test_equal(suite, "машинная константа: переходы и data patches", machine_constant_flow.machine.patch_count, 16)
    machine_constant_flow.machine = layout.define_label(machine_constant_flow.machine, layout.Section.CODE, "rt_region_remember_slot")
    machine_constant_flow.machine = layout.resolve(machine_constant_flow.machine)
    suite = testing.test_yes(suite, "машинная константа: переходы разрешены", machine_constant_flow.machine.resolved)

    @machine_constant_storage = state.State { constants = [state.Symbol { name = "sample", kind = "const" }], executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_constant_storage = constants.emit_storage(machine_constant_storage)
    @machine_constant_state = layout.find_label(machine_constant_storage.machine, constants.state_label("sample"))
    @machine_constant_value = layout.find_label(machine_constant_storage.machine, constants.value_label("sample"))
    @narrow = shape.of(4)
    suite = testing.test_equal(suite, "машинная константа: размер data", machine_constant_storage.machine.data.length, narrow.constant_storage)
    suite = testing.test_yes(suite, "машинная константа: state label существует", machine_constant_state.present)
    suite = testing.test_equal(suite, "машинная константа: state в data", machine_constant_state.section, layout.Section.DATA)
    suite = testing.test_equal(suite, "машинная константа: state offset", machine_constant_state.offset, constants.CONSTANT_STATE_OFFSET)
    suite = testing.test_yes(suite, "машинная константа: value label существует", machine_constant_value.present)
    suite = testing.test_equal(suite, "машинная константа: value в data", machine_constant_value.section, layout.Section.DATA)
    suite = testing.test_equal(suite, "машинная константа: value offset", machine_constant_value.offset, narrow.constant_value)
    suite = testing.test_equal(suite, "машинная константа: начальное состояние", buffer.byte_at(machine_constant_storage.machine.data, constants.CONSTANT_STATE_OFFSET), constants.STATE_EMPTY)
    suite = testing.test_equal(suite, "машинная константа: начальное значение", buffer.byte_at(machine_constant_storage.machine.data, narrow.constant_value), abi.NONE)

    @machine_storage = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_storage.machine = layout.reserve_bss(machine_storage.machine, wide.from_number(3))
    machine_storage = state.finish_data(machine_storage)
    @machine_heap = layout.find_label(machine_storage.machine, "saltic_heap")
    @machine_heap_end = layout.find_label(machine_storage.machine, "saltic_heap_end")
    suite = testing.test_equal(suite, "машинный bss: полный размер", word.to_number(wide.to_word(machine_storage.machine.bss_size)), 4194560 + constants.HEAP_BYTES)
    suite = testing.test_equal(suite, "машинный bss: параметр heap сохранён", word.to_number(wide.to_word(machine_storage.machine.heap_size)), constants.HEAP_BYTES)
    suite = testing.test_yes(suite, "машинный bss: heap существует", machine_heap.present)
    suite = testing.test_equal(suite, "машинный bss: heap section", machine_heap.section, layout.Section.BSS)
    suite = testing.test_equal(suite, "машинный bss: heap после арены", word.to_number(machine_heap.offset), 4194560)
    @machine_arena = layout.find_label(machine_storage.machine, "saltic_arena")
    suite = testing.test_yes(suite, "машинный bss: арена существует", machine_arena.present)
    suite = testing.test_equal(suite, "машинный bss: арена выровнена на 256", word.to_number(machine_arena.offset), 256)
    suite = testing.test_no(suite, "машинный bss: end вычисляется без большой метки", machine_heap_end.present)

    @machine_quota = state.State { heap_bytes = wide.from_number(64), executor = rv32i.Executor {}, machine = layout.Program {} }
    machine_quota = state.finish_data(machine_quota)
    @quota_heap = layout.find_label(machine_quota.machine, "saltic_heap")
    @quota_heap_end = layout.find_label(machine_quota.machine, "saltic_heap_end")
    suite = testing.test_equal(suite, "машинная квота: параметр сохранён", word.to_number(wide.to_word(machine_quota.machine.heap_size)), 64)
    suite = testing.test_equal(suite, "машинная квота: BSS — арена и параметр", word.to_number(wide.to_word(machine_quota.machine.bss_size)), 4194368)
    suite = testing.test_no(suite, "машинная квота: end вычисляется без большой метки", quota_heap_end.present)
    suite = testing.test_yes(suite, "машинная квота: heap существует", quota_heap.present)

    @whole_runtime = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    whole_runtime = runtime.append_runtime(whole_runtime)
    @whole_platform = linux.Linux {}
    whole_runtime = whole_platform.append(whole_runtime)
    suite = testing.test_equal(suite, "цельный runtime: число меток", whole_runtime.machine.label_count, 460)
    suite = testing.test_equal(suite, "цельный runtime: размер rodata", whole_runtime.machine.rodata.length, 1145)
    suite = testing.test_equal(suite, "цельный runtime: kind unknown", buffer.byte_at(whole_runtime.machine.rodata, 0), abi.OBJECT_KIND_STRING)
    suite = testing.test_equal(suite, "цельный runtime: длина unknown", buffer.byte_at(whole_runtime.machine.rodata, 12), 7)
    suite = testing.test_equal(suite, "цельный runtime: длина overflow", buffer.byte_at(whole_runtime.machine.rodata, 36), 89)
    suite = testing.test_equal(suite, "цельный runtime: newline", buffer.byte_at(whole_runtime.machine.rodata, 232), 1)
    @whole_unknown = layout.find_label(whole_runtime.machine, "rt_unknown_text")
    @whole_overflow = layout.find_label(whole_runtime.machine, "rt_fixed_overflow_text")
    @whole_yes = layout.find_label(whole_runtime.machine, "rt_yes_text")
    @whole_no = layout.find_label(whole_runtime.machine, "rt_no_text")
    @whole_newline = layout.find_label(whole_runtime.machine, "rt_newline_text")
    suite = testing.test_equal(suite, "цельный runtime: unknown offset", whole_unknown.offset, 0)
    suite = testing.test_equal(suite, "цельный runtime: overflow offset", whole_overflow.offset, 24)
    suite = testing.test_equal(suite, "цельный runtime: yes offset", whole_yes.offset, 184)
    suite = testing.test_equal(suite, "цельный runtime: no offset", whole_no.offset, 208)
    suite = testing.test_equal(suite, "цельный runtime: newline offset", whole_newline.offset, 464)
    whole_runtime.machine = layout.define_label(whole_runtime.machine, layout.Section.BSS, "saltic_arena")
    whole_runtime.machine = layout.define_label(whole_runtime.machine, layout.Section.BSS, "saltic_heap")
    whole_runtime.machine = layout.resolve(whole_runtime.machine)
    suite = testing.test_yes(suite, "цельный runtime: все ссылки разрешены", whole_runtime.machine.resolved)
    out suite
}
