use seed
use seed.abi
use seed.machine.instruction

NAME = "saltic-rv32i-machine"

WORD_BITS = 32
WORD_BYTES = 4
REGISTER_COUNT = 32
INSTRUCTION_BYTES = 4
INSTRUCTION_ALIGNMENT = 4

ENDIAN_LITTLE = 1
ENDIAN = ENDIAN_LITTLE

BASE_INSTRUCTION_COUNT = 40
MACHINE_INSTRUCTION_COUNT = 4
INSTRUCTION_COUNT = BASE_INSTRUCTION_COUNT + MACHINE_INSTRUCTION_COUNT

HAS_COMPRESSED_INSTRUCTIONS = no
HAS_ATOMIC_INSTRUCTIONS = no
HAS_MULTIPLICATION_EXTENSION = no
HAS_FLOATING_POINT = no
HAS_CSR_ACCESS = yes
HAS_MACHINE_RETURN = yes
HAS_MACHINE_WAIT = yes

skill supports(name) {
    @item = instruction.find(name)
    out (item.kind == instruction.Kind.UNKNOWN_INSTRUCTION) == no
}

skill is_machine(kind) {
    (kind == instruction.Kind.CSRRW) { out yes }
    (kind == instruction.Kind.CSRRS) { out yes }
    (kind == instruction.Kind.MRET) { out yes }
    (kind == instruction.Kind.WFI) { out yes }
    out no
}

skill decode(opcode, funct3, funct7, system) {
    out instruction.decode(opcode, funct3, funct7, system)
}

skill valid() {
    ((WORD_BITS == abi.VALUE_WORD_BITS) == no) { out no }
    ((WORD_BYTES == abi.VALUE_WORD_BYTES) == no) { out no }
    ((INSTRUCTION_BYTES == INSTRUCTION_ALIGNMENT) == no) { out no }
    ((INSTRUCTION_COUNT == instruction.count()) == no) { out no }
    ((BASE_INSTRUCTION_COUNT == instruction.BASE_COUNT) == no) { out no }
    ((MACHINE_INSTRUCTION_COUNT == instruction.MACHINE_COUNT) == no) { out no }
    (instruction.valid_table() == no) { out no }
    (supports("csrrw") == no) { out no }
    (supports("csrrs") == no) { out no }
    (supports("mret") == no) { out no }
    (supports("wfi") == no) { out no }
    out yes
}
