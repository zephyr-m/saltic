use seed

BASE_COUNT = 40
MACHINE_COUNT = 4
COUNT = BASE_COUNT + MACHINE_COUNT
ANY = 0 - 1

Form = enum {
    R,
    I,
    S,
    B,
    U,
    J,
}

Kind = enum {
    UNKNOWN_INSTRUCTION,
    LUI, AUIPC, JAL, JALR,
    BEQ, BNE, BLT, BGE, BLTU, BGEU,
    LB, LH, LW, LBU, LHU,
    SB, SH, SW,
    ADDI, SLTI, SLTIU, XORI, ORI, ANDI,
    SLLI, SRLI, SRAI,
    ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND,
    FENCE, ECALL, EBREAK,
    CSRRW, CSRRS, MRET, WFI,
}

Definition = Box {
    kind = Kind.UNKNOWN_INSTRUCTION
    name = ""
    form = Form.R
    opcode = 0
    funct3 = ANY
    funct7 = ANY
    system = ANY
}

skill definition(kind, name, form, opcode, funct3, funct7, system) {
    out Definition {
        kind = kind
        name = name
        form = form
        opcode = opcode
        funct3 = funct3
        funct7 = funct7
        system = system
    }
}

skill all() {
    out [
        definition(Kind.LUI, "lui", Form.U, 55, ANY, ANY, ANY),
        definition(Kind.AUIPC, "auipc", Form.U, 23, ANY, ANY, ANY),
        definition(Kind.JAL, "jal", Form.J, 111, ANY, ANY, ANY),
        definition(Kind.JALR, "jalr", Form.I, 103, 0, ANY, ANY),

        definition(Kind.BEQ, "beq", Form.B, 99, 0, ANY, ANY),
        definition(Kind.BNE, "bne", Form.B, 99, 1, ANY, ANY),
        definition(Kind.BLT, "blt", Form.B, 99, 4, ANY, ANY),
        definition(Kind.BGE, "bge", Form.B, 99, 5, ANY, ANY),
        definition(Kind.BLTU, "bltu", Form.B, 99, 6, ANY, ANY),
        definition(Kind.BGEU, "bgeu", Form.B, 99, 7, ANY, ANY),

        definition(Kind.LB, "lb", Form.I, 3, 0, ANY, ANY),
        definition(Kind.LH, "lh", Form.I, 3, 1, ANY, ANY),
        definition(Kind.LW, "lw", Form.I, 3, 2, ANY, ANY),
        definition(Kind.LBU, "lbu", Form.I, 3, 4, ANY, ANY),
        definition(Kind.LHU, "lhu", Form.I, 3, 5, ANY, ANY),

        definition(Kind.SB, "sb", Form.S, 35, 0, ANY, ANY),
        definition(Kind.SH, "sh", Form.S, 35, 1, ANY, ANY),
        definition(Kind.SW, "sw", Form.S, 35, 2, ANY, ANY),

        definition(Kind.ADDI, "addi", Form.I, 19, 0, ANY, ANY),
        definition(Kind.SLTI, "slti", Form.I, 19, 2, ANY, ANY),
        definition(Kind.SLTIU, "sltiu", Form.I, 19, 3, ANY, ANY),
        definition(Kind.XORI, "xori", Form.I, 19, 4, ANY, ANY),
        definition(Kind.ORI, "ori", Form.I, 19, 6, ANY, ANY),
        definition(Kind.ANDI, "andi", Form.I, 19, 7, ANY, ANY),
        definition(Kind.SLLI, "slli", Form.I, 19, 1, 0, ANY),
        definition(Kind.SRLI, "srli", Form.I, 19, 5, 0, ANY),
        definition(Kind.SRAI, "srai", Form.I, 19, 5, 32, ANY),

        definition(Kind.ADD, "add", Form.R, 51, 0, 0, ANY),
        definition(Kind.SUB, "sub", Form.R, 51, 0, 32, ANY),
        definition(Kind.SLL, "sll", Form.R, 51, 1, 0, ANY),
        definition(Kind.SLT, "slt", Form.R, 51, 2, 0, ANY),
        definition(Kind.SLTU, "sltu", Form.R, 51, 3, 0, ANY),
        definition(Kind.XOR, "xor", Form.R, 51, 4, 0, ANY),
        definition(Kind.SRL, "srl", Form.R, 51, 5, 0, ANY),
        definition(Kind.SRA, "sra", Form.R, 51, 5, 32, ANY),
        definition(Kind.OR, "or", Form.R, 51, 6, 0, ANY),
        definition(Kind.AND, "and", Form.R, 51, 7, 0, ANY),

        definition(Kind.FENCE, "fence", Form.I, 15, 0, ANY, ANY),
        definition(Kind.ECALL, "ecall", Form.I, 115, 0, ANY, 0),
        definition(Kind.EBREAK, "ebreak", Form.I, 115, 0, ANY, 1),
        definition(Kind.CSRRW, "csrrw", Form.I, 115, 1, ANY, ANY),
        definition(Kind.CSRRS, "csrrs", Form.I, 115, 2, ANY, ANY),
        definition(Kind.MRET, "mret", Form.I, 115, 0, ANY, 770),
        definition(Kind.WFI, "wfi", Form.I, 115, 0, ANY, 261),
    ]
}

skill count() {
    out COUNT
}

skill at(index) {
    (index < 0) { out Definition {} }
    ((index < COUNT) == no) { out Definition {} }
    out seed.group.item(all(), index)
}

skill find(name) {
    @index = 0
    drum (COUNT) {
        @item = at(index)
        (item.name == name) { out item }
        index = index + 1
    }
    out Definition {}
}

skill find_kind(kind) {
    @index = 0
    drum (COUNT) {
        @item = at(index)
        (item.kind == kind) { out item }
        index = index + 1
    }
    out Definition {}
}

skill valid_form(form) {
    (form == Form.R) { out yes }
    (form == Form.I) { out yes }
    (form == Form.S) { out yes }
    (form == Form.B) { out yes }
    (form == Form.U) { out yes }
    (form == Form.J) { out yes }
    out no
}

skill valid_optional(value, maximum) {
    (value == ANY) { out yes }
    (value < 0) { out no }
    (value > maximum) { out no }
    out yes
}

skill valid(item) {
    (item.kind == Kind.UNKNOWN_INSTRUCTION) { out no }
    (seed.str.len(item.name) == 0) { out no }
    (valid_form(item.form) == no) { out no }
    (item.opcode < 0) { out no }
    (item.opcode > 127) { out no }
    (valid_optional(item.funct3, 7) == no) { out no }
    (valid_optional(item.funct7, 127) == no) { out no }
    (valid_optional(item.system, 4095) == no) { out no }
    out yes
}

skill overlaps(left, right) {
    (left == ANY) { out yes }
    (right == ANY) { out yes }
    out left == right
}

skill same_encoding(left, right) {
    ((left.opcode == right.opcode) == no) { out no }
    (overlaps(left.funct3, right.funct3) == no) { out no }
    (overlaps(left.funct7, right.funct7) == no) { out no }
    out overlaps(left.system, right.system)
}

skill valid_table() {
    @items = all()
    ((seed.group.count(items) == COUNT) == no) { out no }
    @left_index = 0
    drum (COUNT) {
        @left = seed.group.item(items, left_index)
        (valid(left) == no) { out no }
        @right_index = left_index + 1
        drum (COUNT) {
            (right_index < COUNT) {
                @right = seed.group.item(items, right_index)
                (left.name == right.name) { out no }
                (left.kind == right.kind) { out no }
                (same_encoding(left, right) == yes) { out no }
                right_index = right_index + 1
            }
        }
        left_index = left_index + 1
    }
    out yes
}

skill matches(item, opcode, funct3, funct7, system) {
    (item.kind == Kind.UNKNOWN_INSTRUCTION) { out no }
    ((item.opcode == opcode) == no) { out no }
    ((item.funct3 == ANY) == no) {
        ((item.funct3 == funct3) == no) { out no }
    }
    ((item.funct7 == ANY) == no) {
        ((item.funct7 == funct7) == no) { out no }
    }
    ((item.system == ANY) == no) {
        ((item.system == system) == no) { out no }
    }
    out yes
}
