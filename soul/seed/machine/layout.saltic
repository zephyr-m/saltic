use seed
use seed.machine.instruction
use seed.machine.codec

Section = enum {
    CODE,
    RODATA,
    DATA,
    BSS,
}

PatchKind = enum {
    BRANCH,
    JUMP,
    RELATIVE_HIGH,
    RELATIVE_LOW,
    ABSOLUTE_HIGH,
    ABSOLUTE_LOW,
    ADDRESS_WORD,
}

Label = Box {
    name = ""
    section = Section.CODE
    offset = 0
    present = no
    next = none
}

Patch = Box {
    kind = PatchKind.BRANCH
    instruction_kind = instruction.Kind.BEQ
    section = Section.CODE
    offset = 0
    base = 0
    label = ""
    addend = 0
    rd = 0
    rs1 = 0
    rs2 = 0
    next = none
}

Layout = Box {
    code_offset = 0
    rodata_offset = 0
    data_offset = 0
    bss_offset = 0
    file_size = 0
    memory_size = codec.Word {}
}

Program = Box {
    load_address = codec.Word {}
    low_memory_size = 0
    entry = ""
    code = codec.Buffer {}
    rodata = codec.Buffer {}
    data = codec.Buffer {}
    bss_size = codec.Word {}
    heap_size = codec.Word {}
    labels_first = none
    labels_last = none
    label_count = 0
    patches_first = none
    patches_last = none
    patch_count = 0
    resolved = no
}

skill word_address(b0, b1, b2, b3) {
    (codec.valid_unsigned(b0, 8) == no) { out error.InvalidAddress }
    (codec.valid_unsigned(b1, 8) == no) { out error.InvalidAddress }
    (codec.valid_unsigned(b2, 8) == no) { out error.InvalidAddress }
    (codec.valid_unsigned(b3, 8) == no) { out error.InvalidAddress }
    out codec.word(b0, b1, b2, b3)
}

skill address_from_number(value) {
    out codec.word_from_number(value)
}

skill address_add(value, amount) {
    (amount < 0) { out error.InvalidAddress }
    @v0 = value.b0 + codec.mod(amount, 256)
    amount = amount / 256
    @v1 = value.b1 + codec.mod(amount, 256) + v0 / 256
    amount = amount / 256
    @v2 = value.b2 + codec.mod(amount, 256) + v1 / 256
    amount = amount / 256
    @v3 = value.b3 + codec.mod(amount, 256) + v2 / 256
    (v3 > 255) { out error.AddressOverflow }
    out codec.word(codec.mod(v0, 256), codec.mod(v1, 256), codec.mod(v2, 256), v3)
}

skill address_upper(value) {
    @upper = value.b1 / 16 + value.b2 * 16 + value.b3 * 4096
    @low = value.b0 + codec.mod(value.b1, 16) * 256
    (low > 2047) { upper = codec.mod(upper + 1, 1048576) }
    out upper
}

skill address_low(value) {
    @low = value.b0 + codec.mod(value.b1, 16) * 256
    (low > 2047) { low = low - 4096 }
    out low
}

skill align(value, boundary) {
    (boundary < 1) { out error.InvalidAlignment }
    @remainder = codec.mod(value, boundary)
    (remainder == 0) { out value }
    out value + boundary - remainder
}

skill floor_div(value, divisor) {
    @quotient = value / divisor
    @remainder = value - quotient * divisor
    (value < 0) {
        ((remainder == 0) == no) { quotient = quotient - 1 }
    }
    out quotient
}

skill relative_high(value) {
    out floor_div(value + 2048, 4096)
}

skill relative_low(value) {
    @high = relative_high(value)
    out value - high * 4096
}

skill create(load_address, entry) {
    out Program { load_address = load_address entry = entry }
}

skill host(entry) {
    out Program {
        load_address = address_from_number(65536)
        low_memory_size = 65536
        entry = entry
    }
}

skill qemu_virt(entry) {
    out Program {
        load_address = word_address(0, 0, 0, 128)
        entry = entry
    }
}

skill section_buffer(value, section) {
    (section == Section.CODE) { out value.code }
    (section == Section.RODATA) { out value.rodata }
    (section == Section.DATA) { out value.data }
    out error.SectionHasNoFileData
}

skill section_length(value, section) {
    (section == Section.CODE) { out value.code.length }
    (section == Section.RODATA) { out value.rodata.length }
    (section == Section.DATA) { out value.data.length }
    out value.bss_size
}

skill assign_section(value, section, target) {
    (section == Section.CODE) { value.code = target }
    (section == Section.RODATA) { value.rodata = target }
    (section == Section.DATA) { value.data = target }
    value.resolved = no
    out value
}

skill append_text(target, text) {
    @index = 0
    @length = seed.str.len(text)
    drum (length) {
        target = codec.append_byte(target, seed.str.byte(text, index))
        index = index + 1
    }
    out target
}

skill align_buffer(target, boundary) {
    @target_length = align(target.length, boundary)
    out codec.append_zeroes(target, target_length - target.length)
}

skill emit_word(value, word) {
    value.code = codec.append_word(value.code, word)
    value.resolved = no
    out value
}

skill emit(value, kind, rd, rs1, rs2, immediate) {
    @word = codec.encode_kind(kind, rd, rs1, rs2, immediate)
    out emit_word(value, word)
}

skill emit_patch(value, patch, placeholder) {
    patch.offset = value.code.length
    (value.patch_count == 0) { value.patches_first = patch }
    (value.patch_count > 0) { value.patches_last.next = patch }
    value.patches_last = patch
    value.patch_count = value.patch_count + 1
    out emit_word(value, placeholder)
}

skill find_label(value, name) {
    @label = value.labels_first
    drum (value.label_count) {
        (label.name == name) { out label }
        label = label.next
    }
    out Label {}
}

skill define_label(value, section, name) {
    @old = find_label(value, name)
    (old.present == yes) { out error.DuplicateLabel }
    @label = Label {
        name = name
        section = section
        offset = section_length(value, section)
        present = yes
    }
    (value.label_count == 0) { value.labels_first = label }
    (value.label_count > 0) { value.labels_last.next = label }
    value.labels_last = label
    value.label_count = value.label_count + 1
    value.resolved = no
    out value
}

skill reserve_bss(value, count) {
    value.bss_size = codec.word_add(value.bss_size, count)
    value.resolved = no
    out value
}

skill append_section_byte(value, section, byte) {
    @target = section_buffer(value, section)
    target = codec.append_byte(target, byte)
    out assign_section(value, section, target)
}

skill append_section_word(value, section, word) {
    @target = section_buffer(value, section)
    target = codec.append_word(target, word)
    out assign_section(value, section, target)
}

skill append_section_text(value, section, text, terminated) {
    @target = section_buffer(value, section)
    target = append_text(target, text)
    (terminated == yes) { target = codec.append_byte(target, 0) }
    out assign_section(value, section, target)
}

skill align_section(value, section, boundary) {
    (section == Section.BSS) {
        value.bss_size = codec.word_align(value.bss_size, boundary)
        value.resolved = no
        out value
    }
    @target = section_buffer(value, section)
    target = align_buffer(target, boundary)
    out assign_section(value, section, target)
}

skill emit_branch(value, kind, rs1, rs2, label) {
    @item = instruction.find_kind(kind)
    ((item.form == instruction.Form.B) == no) { out error.InvalidBranchInstruction }
    @placeholder = codec.encode(item, codec.ZERO, rs1, rs2, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.BRANCH
        instruction_kind = kind
        label = label
        rs1 = rs1
        rs2 = rs2
    }, placeholder)
}

skill emit_jump(value, rd, label) {
    @placeholder = codec.encode_kind(instruction.Kind.JAL, rd, codec.ZERO, codec.ZERO, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.JUMP
        instruction_kind = instruction.Kind.JAL
        label = label
        rd = rd
    }, placeholder)
}

skill emit_load_immediate(value, rd, immediate) {
    (immediate > 0 - 2049) {
        (immediate < 2048) {
            @word = codec.encode_kind(instruction.Kind.ADDI, rd, codec.ZERO, codec.ZERO, immediate)
            out emit_word(value, word)
        }
    }
    @low = relative_low(immediate)
    @upper = codec.signed_value(relative_high(immediate), 20)
    @lui = codec.encode_kind(instruction.Kind.LUI, rd, codec.ZERO, codec.ZERO, upper)
    value = emit_word(value, lui)
    @addi = codec.encode_kind(instruction.Kind.ADDI, rd, rd, codec.ZERO, low)
    out emit_word(value, addi)
}

skill emit_load_word(value, rd, immediate) {
    @lui = codec.encode_kind(instruction.Kind.LUI, rd, codec.ZERO, codec.ZERO, address_upper(immediate))
    value = emit_word(value, lui)
    @addi = codec.encode_kind(instruction.Kind.ADDI, rd, rd, codec.ZERO, address_low(immediate))
    out emit_word(value, addi)
}

skill emit_branch_unsigned_greater(value, rs1, rs2, label) {
    @item = instruction.find_kind(instruction.Kind.BLTU)
    @placeholder = codec.encode(item, codec.ZERO, rs2, rs1, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.BRANCH
        instruction_kind = instruction.Kind.BLTU
        label = label
        rs1 = rs2
        rs2 = rs1
    }, placeholder)
}

skill emit_relative_address(value, rd, label, addend) {
    @base = value.code.length
    @high = codec.encode_kind(instruction.Kind.AUIPC, rd, codec.ZERO, codec.ZERO, 0)
    value = emit_patch(value, Patch {
        kind = PatchKind.RELATIVE_HIGH
        instruction_kind = instruction.Kind.AUIPC
        base = base
        label = label
        addend = addend
        rd = rd
    }, high)
    @low = codec.encode_kind(instruction.Kind.ADDI, rd, rd, codec.ZERO, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.RELATIVE_LOW
        instruction_kind = instruction.Kind.ADDI
        base = base
        label = label
        addend = addend
        rd = rd
        rs1 = rd
    }, low)
}

skill emit_call(value, label) {
    @base = value.code.length
    @high = codec.encode_kind(instruction.Kind.AUIPC, codec.RA, codec.ZERO, codec.ZERO, 0)
    value = emit_patch(value, Patch {
        kind = PatchKind.RELATIVE_HIGH
        instruction_kind = instruction.Kind.AUIPC
        base = base
        label = label
        rd = codec.RA
    }, high)
    @low = codec.encode_kind(instruction.Kind.JALR, codec.RA, codec.RA, codec.ZERO, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.RELATIVE_LOW
        instruction_kind = instruction.Kind.JALR
        base = base
        label = label
        rd = codec.RA
        rs1 = codec.RA
    }, low)
}

skill emit_absolute_address(value, rd, label, addend) {
    @high = codec.encode_kind(instruction.Kind.LUI, rd, codec.ZERO, codec.ZERO, 0)
    value = emit_patch(value, Patch {
        kind = PatchKind.ABSOLUTE_HIGH
        instruction_kind = instruction.Kind.LUI
        label = label
        addend = addend
        rd = rd
    }, high)
    @low = codec.encode_kind(instruction.Kind.ADDI, rd, rd, codec.ZERO, 0)
    out emit_patch(value, Patch {
        kind = PatchKind.ABSOLUTE_LOW
        instruction_kind = instruction.Kind.ADDI
        label = label
        addend = addend
        rd = rd
        rs1 = rd
    }, low)
}

skill append_label_address(value, section, label, addend) {
    @target = section_buffer(value, section)
    @offset = target.length
    target = codec.append_word(target, codec.word(0, 0, 0, 0))
    value = assign_section(value, section, target)
    @patch = Patch {
        kind = PatchKind.ADDRESS_WORD
        section = section
        offset = offset
        label = label
        addend = addend
    }
    (value.patch_count == 0) { value.patches_first = patch }
    (value.patch_count > 0) { value.patches_last.next = patch }
    value.patches_last = patch
    value.patch_count = value.patch_count + 1
    value.resolved = no
    out value
}

skill layout(value) {
    @rodata_offset = align(value.code.length, 8)
    @data_offset = align(rodata_offset + value.rodata.length, 4096)
    @bss_offset = align(data_offset + value.data.length, 8)
    out Layout {
        code_offset = 0
        rodata_offset = rodata_offset
        data_offset = data_offset
        bss_offset = bss_offset
        file_size = bss_offset
        memory_size = codec.word_add_number(value.bss_size, bss_offset)
    }
}

skill section_offset(current_layout, section) {
    (section == Section.CODE) { out current_layout.code_offset }
    (section == Section.RODATA) { out current_layout.rodata_offset }
    (section == Section.DATA) { out current_layout.data_offset }
    out current_layout.bss_offset
}

skill label_offset(value, current_layout, name) {
    @label = find_label(value, name)
    (label.present == no) { out error.UnknownLabel }
    (label.section == Section.BSS) {
        @offset = codec.word_add_number(label.offset, current_layout.bss_offset)
        out codec.word_to_number(offset)
    }
    out section_offset(current_layout, label.section) + label.offset
}

skill label_address(value, current_layout, name, addend) {
    @label = find_label(value, name)
    (label.present == no) { out error.UnknownLabel }
    (label.section == Section.BSS) {
        @offset = codec.word_add_number(label.offset, current_layout.bss_offset + addend)
        out codec.word_add(value.load_address, offset)
    }
    @offset = label_offset(value, current_layout, name) + addend
    (offset < 0) { out error.InvalidAddress }
    out address_add(value.load_address, offset)
}

skill set_section_word(value, section, offset, word) {
    @target = section_buffer(value, section)
    target = codec.set_word(target, offset, word)
    out assign_section(value, section, target)
}

skill resolve_patch(value, current_layout, patch) {
    @target_offset = label_offset(value, current_layout, patch.label) + patch.addend
    (patch.kind == PatchKind.BRANCH) {
        @distance = target_offset - patch.offset
        @word = codec.encode_kind(patch.instruction_kind, codec.ZERO, patch.rs1, patch.rs2, distance)
        out set_section_word(value, Section.CODE, patch.offset, word)
    }
    (patch.kind == PatchKind.JUMP) {
        @distance = target_offset - patch.offset
        @word = codec.encode_kind(patch.instruction_kind, patch.rd, codec.ZERO, codec.ZERO, distance)
        out set_section_word(value, Section.CODE, patch.offset, word)
    }
    (patch.kind == PatchKind.RELATIVE_HIGH) {
        @distance = target_offset - patch.base
        @upper = codec.signed_value(relative_high(distance), 20)
        @word = codec.encode_kind(patch.instruction_kind, patch.rd, codec.ZERO, codec.ZERO, upper)
        out set_section_word(value, Section.CODE, patch.offset, word)
    }
    (patch.kind == PatchKind.RELATIVE_LOW) {
        @distance = target_offset - patch.base
        @low = relative_low(distance)
        @word = codec.encode_kind(patch.instruction_kind, patch.rd, patch.rs1, codec.ZERO, low)
        out set_section_word(value, Section.CODE, patch.offset, word)
    }
    (patch.kind == PatchKind.ABSOLUTE_HIGH) {
        @target = label_address(value, current_layout, patch.label, patch.addend)
        @word = codec.encode_kind(patch.instruction_kind, patch.rd, codec.ZERO, codec.ZERO, address_upper(target))
        out set_section_word(value, Section.CODE, patch.offset, word)
    }
    (patch.kind == PatchKind.ABSOLUTE_LOW) {
        @target = label_address(value, current_layout, patch.label, patch.addend)
        @word = codec.encode_kind(patch.instruction_kind, patch.rd, patch.rs1, codec.ZERO, address_low(target))
        out set_section_word(value, Section.CODE, patch.offset, word)
    }
    (patch.kind == PatchKind.ADDRESS_WORD) {
        @target = label_address(value, current_layout, patch.label, patch.addend)
        out set_section_word(value, patch.section, patch.offset, target)
    }
    out error.UnknownPatch
}

skill resolve(value) {
    @current_layout = layout(value)
    @patch = value.patches_first
    drum (value.patch_count) {
        value = resolve_patch(value, current_layout, patch)
        patch = patch.next
    }
    value.resolved = yes
    out value
}
