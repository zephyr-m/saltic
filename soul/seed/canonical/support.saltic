use seed

Name = "canonical"

Mode = enum {
    ENABLED,
    DISABLED,
}

Badge = Box {
    prefix = "badge:"
    mode = Mode.ENABLED

    skill text(name) {
        out seed.str.add(prefix, name)
    }
}

skill active() {
    out Mode.ENABLED
}

skill badge(name) {
    @value = Badge {}
    out value.text(name)
}
