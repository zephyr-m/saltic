use seed
use seed.abi
use seed.compiler.state
use seed.compiler.codegen
use seed.compiler.constants
use seed.runtime.runtime
use seed.runtime.emit
use seed.memory.model
use seed.machine.codec

skill valid_heap_size(heap_bytes) {
    (codec.mod(heap_bytes.b0, model.ALIGNMENT) > 0) { out no }
    (heap_bytes.b3 > 0) { out yes }
    (heap_bytes.b2 > 0) { out yes }
    (heap_bytes.b1 > 0) { out yes }
    (heap_bytes.b0 < model.MINIMUM_HEAP_BYTES) { out no }
    out yes
}

skill compile_state_with_heap(ast, heap_bytes) {
    (valid_heap_size(heap_bytes) == no) { out error.ValueOutsideRange }
    @compiler = state.State { ast = ast heap_bytes = heap_bytes }
    compiler = state.collect_top_level(compiler)
    compiler = state.emit(compiler, abi.assembly())
    compiler = state.header(compiler)
    compiler = state.start(compiler)
    compiler = codegen.compile_functions(compiler)
    compiler = codegen.compile_constants(compiler)
    compiler = state.emit(compiler, runtime.assembly())
    compiler = emit.append_runtime(compiler)
    compiler = constants.emit_storage(compiler)
    compiler = state.finish_data(compiler)
    out compiler
}

skill compile_common_state_with_heap(ast, heap_bytes) {
    (valid_heap_size(heap_bytes) == no) { out error.ValueOutsideRange }
    @compiler = state.State { ast = ast heap_bytes = heap_bytes }
    compiler = state.collect_top_level(compiler)
    compiler = state.emit(compiler, abi.assembly())
    compiler = state.header(compiler)
    compiler = state.start(compiler)
    compiler = codegen.compile_functions(compiler)
    compiler = codegen.compile_constants(compiler)
    compiler = state.emit(compiler, runtime.assembly())
    compiler = emit.append_runtime_common(compiler)
    compiler = constants.emit_storage(compiler)
    compiler = state.finish_data(compiler)
    out compiler
}

skill compile_state(ast) {
    out compile_state_with_heap(ast, codec.word_from_number(constants.HEAP_BYTES))
}

skill compile(ast) {
    @compiler = compile_state(ast)
    out state.render_lines(compiler.lines)
}

skill compile_machine(ast) {
    @compiler = compile_state(ast)
    out compiler.machine
}

skill compile_machine_with_heap(ast, heap_bytes) {
    @compiler = compile_state_with_heap(ast, heap_bytes)
    out compiler.machine
}

skill compile_machine_common_with_heap(ast, heap_bytes) {
    @compiler = compile_common_state_with_heap(ast, heap_bytes)
    out compiler.machine
}

program() {
    seed.io.show("библиотека компилятора")
    out none
}
