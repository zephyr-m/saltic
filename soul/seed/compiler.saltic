use seed
use seed.abi
use seed.compiler.state
use seed.compiler.codegen
use seed.compiler.constants
use seed.runtime.runtime
use seed.runtime.emit

skill compile_state(ast) {
    @compiler = state.State { ast = ast }
    compiler = state.collect_top_level(compiler)
    compiler = state.emit(compiler, abi.assembly())
    compiler = state.header(compiler)
    compiler = state.start(compiler)
    compiler = codegen.compile_functions(compiler)
    compiler = codegen.compile_constants(compiler)
    compiler = state.emit(compiler, runtime.assembly())
    compiler = emit.append_runtime(compiler)
    compiler = constants.emit_storage(compiler)
    compiler = state.finish_data(compiler)
    out compiler
}

skill compile(ast) {
    @compiler = compile_state(ast)
    out state.render_lines(compiler.lines)
}

skill compile_machine(ast) {
    @compiler = compile_state(ast)
    out compiler.machine
}

program() {
    seed.io.show("библиотека компилятора")
    out none
}
