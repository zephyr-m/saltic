use seed
use seed.str
use seed.num
use seed.io
use seed.vm.state
use seed.vm.loader
use seed.vm.cpu

skill run(image, options) {
    @machine = state.new_machine(options)
    (options.step_limit > 1000000) { io.show("vm: загружаю образ") }
    loader.load(machine, image, options.load_address)
    (str.len(machine.trap) == 0) {
        (options.step_limit > 1000000) { io.show("vm: готовлю стек") }
        loader.prepare_stack(machine, options)
    }
    @index = 0
    (options.step_limit > 1000000) {
        io.show("vm: старт, лимит ", num.text(options.step_limit))
        io.show("vm: ", num.text(machine.steps), " / ", num.text(options.step_limit))
    }
    drum (options.step_limit) {
        (machine.halted == yes) { out cpu.result(machine) }
        cpu.step(machine)
        index = index + 1
        (index == 5000) {
            (options.step_limit > 1000000) {
                io.show("vm: ", num.text(machine.steps), " / ", num.text(options.step_limit))
            }
            index = 0
        }
    }
    (machine.halted == no) {
        @detail = str.add(num.text(options.step_limit), " инструкций")
        state.trap(machine, "исчерпан лимит инструкций", detail)
    }
    out cpu.result(machine)
}
