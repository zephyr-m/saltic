-- elf32 test — заголовки ELF32: образ host (три сегмента, восемь секций, BSS,
-- symtab) и qemu_virt (один сегмент с 0x80000000).
--
-- read_u16 / read_u32(bytes, offset) -> число из буфера, little endian
-- bytes4(bytes, offset, b0, b1, b2, b3) -> yes/no
-- host_fixture() -> цель layout.host с кодом, rodata, data и bss
-- host / virt / run(suite) -> suite

use craft.testing
use compiler.gorn.backend.riscv.instruction
use compiler.gorn.backend.layout
use compiler.gorn.backend.riscv.rv32i.elf
use compiler.gorn.machine.word
use compiler.gorn.machine.wide
use compiler.gorn.backend.buffer
use compiler.gorn.backend.riscv.emit

skill read_u16(bytes, offset) {
    out bytes.byte_at(offset) + bytes.byte_at(offset + 1) * 256
}

skill read_u32(bytes, offset) {
    out read_u16(bytes, offset) + read_u16(bytes, offset + 2) * 65536
}

skill bytes4(bytes, offset, b0, b1, b2, b3) {
    (bytes.byte_at(offset) == b0) {
        (bytes.byte_at(offset + 1) == b1) {
            (bytes.byte_at(offset + 2) == b2) {
                out bytes.byte_at(offset + 3) == b3
            }
        }
    }
    out no
}

skill host_fixture() {
    @writer = emit.Emit {}
    @target = layout.host("_start")
    target.define_label(Layout.Section.CODE, "_start")
    writer.op(target, Instruction.Kind.EBREAK, 0, 0, 0, 0)
    target.append_section_text(Layout.Section.RODATA, "saltic", yes)
    target.define_label(Layout.Section.RODATA, "message")
    target.append_section_word(Layout.Section.DATA, word.from_bytes(1, 2, 3, 4))
    target.reserve_bss(wide.from_number(17))
    out target
}

skill host(suite) {
    @target = host_fixture()
    @current = target.layout()
    @target_elf = Elf {
        machine = target
    }
    @output = target_elf.executable()
    @section_table = read_u32(output, 32)
    @low_header = 52
    @load_header = 84
    @data_header = 116
    @text_header = section_table + 40
    @bss_header = section_table + 160
    @symtab_header = section_table + 200

    suite = testing.test_yes(suite, "ELF host: magic", bytes4(output, 0, 127, 69, 76, 70))
    suite = testing.test_equal(suite, "ELF host: class ELF32", output.byte_at(4), 1)
    suite = testing.test_equal(suite, "ELF host: little endian", output.byte_at(5), 1)
    suite = testing.test_equal(suite, "ELF host: RISC-V", read_u16(output, 18), 243)
    suite = testing.test_equal(suite, "ELF host: entry", read_u32(output, 24), 65536)
    suite = testing.test_equal(suite, "ELF host: program table offset", read_u32(output, 28), 52)
    suite = testing.test_equal(suite, "ELF host: header size", read_u16(output, 40), 52)
    suite = testing.test_equal(suite, "ELF host: три load segments", read_u16(output, 44), 3)
    suite = testing.test_equal(suite, "ELF host: восемь sections", read_u16(output, 48), 8)
    suite = testing.test_equal(suite, "ELF host: shstrtab index", read_u16(output, 50), 7)
    suite = testing.test_equal(suite, "ELF host: low memory segment загружаемый", read_u32(output, low_header), 1)
    suite = testing.test_equal(suite, "ELF host: low memory начинается с нуля", read_u32(output, low_header + 8), 0)
    suite = testing.test_equal(suite, "ELF host: low memory занимает 64 KiB", read_u32(output, low_header + 20), 65536)
    suite = testing.test_equal(suite, "ELF host: low memory доступна для записи", read_u32(output, low_header + 24), 6)
    suite = testing.test_equal(suite, "ELF host: low memory выровнена по странице", read_u32(output, low_header + 28), 4096)
    suite = testing.test_equal(suite, "ELF host: payload offset", read_u32(output, load_header + 4), 4096)
    suite = testing.test_equal(suite, "ELF host: virtual address", read_u32(output, load_header + 8), 65536)
    suite = testing.test_equal(suite, "ELF host: RX заканчивается перед data", read_u32(output, load_header + 16), current.data_offset)
    suite = testing.test_equal(suite, "ELF host: код только RX", read_u32(output, load_header + 24), 5)
    suite = testing.test_equal(suite, "ELF host: data начинается с новой страницы", current.data_offset % 4096, 0)
    suite = testing.test_equal(suite, "ELF host: data segment начинается после RX", read_u32(output, data_header + 4), 4096 + current.data_offset)
    suite = testing.test_equal(suite, "ELF host: data segment writable", read_u32(output, data_header + 24), 6)
    suite = testing.test_equal(suite, "ELF host: BSS увеличивает data memory size", read_u32(output, data_header + 20), current.file_size - current.data_offset + 17)
    suite = testing.test_equal(suite, "ELF host: text section type", read_u32(output, text_header + 4), 1)
    suite = testing.test_equal(suite, "ELF host: text section address", read_u32(output, text_header + 12), 65536)
    suite = testing.test_equal(suite, "ELF host: BSS section type", read_u32(output, bss_header + 4), 8)
    suite = testing.test_equal(suite, "ELF host: BSS section size", read_u32(output, bss_header + 20), 17)
    suite = testing.test_equal(suite, "ELF host: symtab связан со strtab", read_u32(output, symtab_header + 24), 6)
    suite = testing.test_equal(suite, "ELF host: таблица sections завершает файл", output.length, section_table + 320)
    out suite
}

skill virt(suite) {
    @writer = emit.Emit {}
    @target = layout.qemu_virt("_start")
    target.define_label(Layout.Section.CODE, "_start")
    writer.op(target, Instruction.Kind.WFI, 0, 0, 0, 0)
    @target_elf = Elf {
        machine = target
    }
    @output = target_elf.executable()
    suite = testing.test_yes(suite, "ELF virt: entry 0x80000000", bytes4(output, 24, 0, 0, 0, 128))
    suite = testing.test_equal(suite, "ELF virt: один load segment", read_u16(output, 44), 1)
    suite = testing.test_yes(suite, "ELF virt: segment 0x80000000", bytes4(output, 60, 0, 0, 0, 128))
    suite = testing.test_equal(suite, "ELF virt: payload offset", read_u32(output, 56), 4096)
    out suite
}

skill run(suite) {
    suite = host(suite)
    out virt(suite)
}
