-- scale test — буфер на 64 KiB: байты на границах чанков, buffer.whole,
-- единственность таблицы команд, ELF с большим payload.
--
-- run(suite) -> suite

use core.group
use craft.testing
use compiler.gorn.backend.riscv.instruction
use compiler.gorn.backend.layout
use compiler.gorn.backend.riscv.rv32i.elf
use compiler.gorn.backend.buffer
use core.bytes
use compiler.gorn.backend.riscv.emit

SCALE_BYTES = 65536

skill run(suite) {
    @catalog = instruction.Catalog {}
    @second_catalog = instruction.Catalog {}
    @scaled = buffer.empty()
    scaled.append_zeroes(SCALE_BYTES)
    scaled.set_byte(0, 17)
    scaled.set_byte(buffer.CHUNK_SIZE - 1, 34)
    scaled.set_byte(buffer.CHUNK_SIZE, 51)
    scaled.set_byte(SCALE_BYTES - 1, 68)

    suite = testing.test_equal(suite, "scale: длина буфера 64 KiB", scaled.length, SCALE_BYTES)
    suite = testing.test_equal(suite, "scale: первый байт доступен", scaled.byte_at(0), 17)
    suite = testing.test_equal(suite, "scale: конец первого chunk доступен", scaled.byte_at(buffer.CHUNK_SIZE - 1), 34)
    suite = testing.test_equal(suite, "scale: начало второго chunk доступно", scaled.byte_at(buffer.CHUNK_SIZE), 51)
    suite = testing.test_equal(suite, "scale: последний байт доступен", scaled.byte_at(SCALE_BYTES - 1), 68)
    suite = testing.test_equal(suite, "scale: число chunks конечно", scaled.chunk_count(), SCALE_BYTES / buffer.CHUNK_SIZE)
    @whole = scaled.whole()
    suite = testing.test_equal(suite, "scale: целый буфер — длина", bytes.count(whole), SCALE_BYTES)
    suite = testing.test_equal(suite, "scale: целый буфер — последний", bytes.get(whole, SCALE_BYTES - 1), 68)
    suite = testing.test_yes(suite, "scale: таблица команд создаётся один раз", catalog.items == second_catalog.items)

    @target = layout.host("_start")
    target.define_label(Layout.Section.CODE, "_start")
    target = emit.op(target, Instruction.Kind.EBREAK, 0, 0, 0, 0)
    target.data = scaled
    @current = target.layout()
    @target_elf = Elf {
        machine = target
    }
    @output = target_elf.executable()
    suite = testing.test_yes(suite, "scale: ELF с payload 64 KiB создан", output.length > SCALE_BYTES)
    suite = testing.test_equal(suite, "scale: ELF сохранил последний байт payload", output.byte_at(4096 + current.data_offset + SCALE_BYTES - 1), 68)
    out suite
}
