-- qemu test — gorn.compile_machine_with_heap: метки _start,
-- saltic_program, rt_platform_exit; размер heap и BSS (в том числе
-- 0xf0000000), ELF без раздутого BSS. Пишет ELF обычной программы в
-- output_path — его потом запускает qemu-riscv32 (tests/run.sh).
--
-- ordinary_program(heap_bytes) / exhausted_program() / wide_heap_program()
--     -> разрешённая цель
-- run(suite, output_path) -> suite

use craft.testing
use compiler.gorn.backend.layout
use compiler.gorn.backend.riscv.rv32i.elf
use compiler.gorn
use compiler.gorn.machine.word
use compiler.gorn.machine.wide
use compiler.gorn.backend.buffer

skill ordinary_program(heap_bytes) {
    @forge = gorn.Gorn {}
    @ast = ["program", ["entry", [], ["block", ["out", ["number", 7]]]]]
    @target = forge.compile_machine_with_heap(ast, wide.from_number(heap_bytes))
    out layout.resolve(target)
}

skill exhausted_program() {
    @forge = gorn.Gorn {}
    @ast = ["program", ["entry", [], ["block", ["out", ["group", ["number", 1]]]]]]
    @target = forge.compile_machine_with_heap(ast, wide.from_number(16))
    out layout.resolve(target)
}

skill wide_heap_program() {
    @forge = gorn.Gorn {}
    @ast = ["program", ["entry", [], ["block", ["out", ["number", 7]]]]]
    @target = forge.compile_machine_with_heap(ast, wide.from_decimal("4026531840"))
    out layout.resolve(target)
}

skill run(suite, output_path) {
    @ordinary = ordinary_program(64)
    @ordinary_elf = Elf {
        machine = ordinary
    }
    @output = ordinary_elf.executable()
    @start = ordinary.find_label("_start")
    @entry = ordinary.find_label("saltic_program")
    @exit_label = ordinary.find_label("rt_platform_exit")
    suite = testing.test_yes(suite, "обычная программа: машинный канал разрешён", ordinary.resolved)
    suite = testing.test_yes(suite, "обычная программа: _start существует", start.present)
    suite = testing.test_yes(suite, "обычная программа: program существует", entry.present)
    suite = testing.test_yes(suite, "обычная программа: runtime существует", exit_label.present)
    @ordinary_heap = ordinary.heap_size
    @ordinary_heap_word = ordinary_heap.narrow()
    suite = testing.test_equal(suite, "обычная программа: параметр heap", ordinary_heap_word.as_number(), 64)
    @ordinary_bss = ordinary.bss_size
    @ordinary_bss_word = ordinary_bss.narrow()
    suite = testing.test_equal(suite, "обычная программа: BSS — арена и слово начала кучи", ordinary_bss_word.as_number(), 4194820)
    suite = testing.test_equal(suite, "обычная программа: ELF magic", output.byte_at(0), 127)
    suite = testing.test_yes(suite, "обычная программа: ELF содержит payload", output.length > 4096)
    @exhausted = exhausted_program()
    @exhausted_heap = exhausted.heap_size
    @exhausted_heap_word = exhausted_heap.narrow()
    suite = testing.test_equal(suite, "квота: маленький heap сохранён", exhausted_heap_word.as_number(), 16)
    @large = wide_heap_program()
    @large_elf = Elf {
        machine = large
    }
    @large_output = large_elf.executable()
    @large_heap = large.heap_size
    suite = testing.test_equal(suite, "широкая квота: decimal сохраняется", large_heap.decimal(), "4026531840")
    suite = testing.test_equal(suite, "широкая квота: heap занимает 0xf0000000", large.heap_size.low.b3, 240)
    suite = testing.test_equal(suite, "широкая квота: куча не в BSS — её даёт платформа", large.bss_size.low.b3, 0)
    suite = testing.test_yes(suite, "широкая квота: ELF не расплющивает BSS в файл", large_output.length < 65536)
    output.write_program(output_path)
    out suite
}
