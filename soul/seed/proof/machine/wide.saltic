-- wide test — 64-битное значение для RV64 из двух word: десятичный текст в
-- обе стороны, перенос между половинами, знак, сдвиг, переполнение 64 бит.
--
-- overflows(text) -> yes/no — from_decimal дал WideOutsideRange
-- run(suite) -> suite

use craft.testing
use compiler.gorn.machine.word
use compiler.gorn.machine.wide

skill overflows(text) {
    @failed = no
    @value = wide.from_decimal(text) rescue |failure| {
        failed = yes
        wide.Wide {}
    }
    value = value
    out failed
}

skill run(suite) {
    @top = wide.from_decimal("1152921504606846975")
    suite = testing.test_equal(suite, "wide: 2^60 - 1 туда и обратно", top.decimal(), "1152921504606846975")
    @top_high = top.high
    suite = testing.test_equal(suite, "wide: старшее слово 2^60 - 1", top_high.decimal(), "268435455")
    @top_low = top.low
    suite = testing.test_equal(suite, "wide: младшее слово 2^60 - 1", top_low.decimal(), "4294967295")
    @max = wide.from_decimal("18446744073709551615")
    suite = testing.test_equal(suite, "wide: 2^64 - 1", max.decimal(), "18446744073709551615")
    suite = testing.test_yes(suite, "wide: 2^64 — переполнение", overflows("18446744073709551616"))
    @low_full = wide.from_decimal("4294967295")
    @carry = low_full.sum(wide.from_number(1))
    suite = testing.test_equal(suite, "wide: перенос в старшее слово", carry.decimal(), "4294967296")
    @minus = wide.from_signed(-1)
    suite = testing.test_equal(suite, "wide: -1 — все единицы", minus.decimal(), "18446744073709551615")
    @negative = wide.from_decimal("-1152921504606846976")
    suite = testing.test_equal(suite, "wide: -2^60 в дополнительном коде", negative.decimal(), "17293822569102704640")
    @one = wide.from_number(1)
    @shifted = one.shifted(63)
    suite = testing.test_equal(suite, "wide: 1 << 63", shifted.decimal(), "9223372036854775808")
    @nothing = wide.Wide {}
    suite = testing.test_yes(suite, "wide: ноль", nothing.is_zero())
    @page = wide.from_number(4096)
    @small = page.narrow()
    suite = testing.test_equal(suite, "wide: в word, если влезает", small.as_number(), 4096)
    out suite
}
