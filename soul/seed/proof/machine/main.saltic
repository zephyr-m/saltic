-- machine test — машинный слой RV32I: профиль команд, понижение li / bgtu,
-- кодировщик, исполняемый образ; собирает детей machine/{golden, immediate,
-- patches, elf, scale, runtime_bytes, qemu, wide}.
-- Набор на craft.testing; гоняет tests/run.sh (test_machine).
--
-- machine_profile / lowering / encoding / executable(suite) -> suite
-- program(output_path) -> итог testing.test_finish; output_path — куда qemu
--     пишет ELF обычной программы

use core.group
use craft.testing
use compiler.gorn.backend.riscv.instruction
use compiler.gorn.backend.riscv.rv32i.profile
use compiler.gorn.backend.riscv.codec
use compiler.gorn.backend.layout
use proof.machine.golden
use proof.machine.immediate
use proof.machine.patches
use proof.machine.elf32
use proof.machine.scale
use proof.machine.runtime_bytes
use proof.machine.qemu
use proof.machine.wide
use compiler.gorn.backend.riscv.registers
use compiler.gorn.machine.word
use compiler.gorn.backend.buffer
use compiler.gorn.backend.riscv.emit
use compiler.gorn.backend.riscv.rv32i.elf

skill machine_profile(suite) {
    @passport = profile.Profile {}
    @catalog = instruction.Catalog {}
    @names = [
        "lui", "auipc", "jal", "jalr",
        "beq", "bne", "blt", "bge", "bltu", "bgeu",
        "lb", "lh", "lw", "lbu", "lhu",
        "sb", "sh", "sw",
        "addi", "slti", "sltiu", "xori", "ori", "andi", "slli", "srli", "srai",
        "add", "sub", "sll", "slt", "sltu", "xor", "srl", "sra", "or", "and",
        "fence", "ecall", "ebreak",
        "csrrw", "csrrs", "mret", "wfi"
    ]
    @known = yes
    @machine_count = 0
    drum (profile.INSTRUCTION_COUNT) {
        @name = group.get(names, beat)
        (passport.supports(name) == no) { known = no }
        @item = catalog.at(beat)
        (passport.is_machine(item.kind) == yes) { machine_count = machine_count + 1 }
    }
    @add = catalog.find("add")
    @csrrw = catalog.find("csrrw")
    @mret = catalog.find("mret")
    @wfi = catalog.find("wfi")
    @ecall = catalog.find("ecall")
    @outside = catalog.at(44)
    suite = testing.test_yes(suite, "профиль: внутренне согласован", passport.valid())
    suite = testing.test_yes(suite, "профиль: таблица не имеет дыр и пересечений", catalog.valid())
    suite = testing.test_equal(suite, "профиль: слово содержит 32 бита", profile.WORD_BITS, 32)
    suite = testing.test_equal(suite, "профиль: регистров ровно 32", profile.REGISTER_COUNT, 32)
    suite = testing.test_equal(suite, "профиль: команда занимает 4 байта", profile.INSTRUCTION_BYTES, 4)
    suite = testing.test_equal(suite, "профиль: базовых команд ровно 40", profile.BASE_INSTRUCTION_COUNT, 40)
    suite = testing.test_equal(suite, "профиль: добавочных машинных команд ровно 4", profile.MACHINE_INSTRUCTION_COUNT, 4)
    suite = testing.test_equal(suite, "профиль: полный профиль содержит 44 команды", catalog.count(), 44)
    suite = testing.test_equal(suite, "профиль: независимый список содержит 44 команды", group.count(names), 44)
    suite = testing.test_yes(suite, "профиль: все 44 имени найдены", known)
    suite = testing.test_equal(suite, "профиль: четыре машинные команды отделены", machine_count, 4)
    suite = testing.test_no(suite, "профиль: сжатых команд нет", profile.HAS_COMPRESSED_INSTRUCTIONS)
    suite = testing.test_equal(suite, "профиль: код операции add закреплён", add.opcode, 51)
    suite = testing.test_equal(suite, "профиль: вид CSR-записи закреплён", csrrw.funct3, 1)
    suite = testing.test_equal(suite, "профиль: возврат из ловушки закреплён", mret.system, 770)
    suite = testing.test_equal(suite, "профиль: ожидание процессора закреплено", wfi.system, 261)
    suite = testing.test_yes(suite, "профиль: возврат распознаётся однозначно", mret.matches(115, 0, 24, 770))
    suite = testing.test_no(suite, "профиль: системный вызов не становится возвратом", ecall.matches(115, 0, 0, 770))
    suite = testing.test_equal(suite, "профиль: выход за таблицу даёт неизвестную команду", outside.kind, Instruction.Kind.UNKNOWN_INSTRUCTION)
    out suite
}

skill lowering(suite) {
    @writer = emit.Emit {}
    @target = layout.host("_start")
    writer.load_immediate(target, registers.T0, 5)
    writer.load_immediate(target, registers.T0, 2048)
    target.define_label(Layout.Section.CODE, "target")
    writer.branch_unsigned_greater(target, registers.T1, registers.T2, "target")
    target = layout.resolve(target)

    @target_code = target.code
    suite = testing.test_equal(suite, "lowering: li малого значения", target_code.byte_at(0), 147)
    target_code = target.code
    suite = testing.test_equal(suite, "lowering: li малого значения bs1", target_code.byte_at(1), 2)
    target_code = target.code
    suite = testing.test_equal(suite, "lowering: li малого значения bs2", target_code.byte_at(2), 80)
    target_code = target.code
    suite = testing.test_equal(suite, "lowering: li малого значения bs3", target_code.byte_at(3), 0)
    target_code = target.code
    suite = testing.test_equal(suite, "lowering: li большого значения — lui", target_code.byte_at(4), 183)
    target_code = target.code
    suite = testing.test_equal(suite, "lowering: li большого значения — addi b0", target_code.byte_at(8), 147)
    suite = testing.test_yes(suite, "lowering: li эмитит четыре байта на два слова", target.code.length == 16)
    suite = testing.test_yes(suite, "lowering: bgtu эмитирует bltu с перестановкой", target.patches() == 1)
    out suite
}

skill encoding(suite) {
    @coder = codec.Codec {}
    @catalog = instruction.Catalog {}
    @encoded = buffer.empty()
    @valid = yes
    drum (catalog.count()) {
        @item = catalog.at(beat)
        @bits = coder.encode(item, 1, 2, 3, 4) rescue |failure| {
            valid = no
            word.from_bytes(0, 0, 0, 0)
        }
        encoded.append_word(bits)
    }
    @addi = coder.encode_kind(Instruction.Kind.ADDI, 1, 2, 0, 3)
    suite = testing.test_yes(suite, "кодировщик: все 44 команды кодируются", valid)
    suite = testing.test_equal(suite, "кодировщик: каждая команда занимает четыре байта", encoded.length, 176)
    suite = testing.test_equal(suite, "кодировщик: первый байт addi закреплён", addi.b0, 147)
    suite = testing.test_equal(suite, "кодировщик: второй байт addi закреплён", addi.b1, 0)
    suite = testing.test_equal(suite, "кодировщик: третий байт addi закреплён", addi.b2, 49)
    suite = testing.test_equal(suite, "кодировщик: четвёртый байт addi закреплён", addi.b3, 0)
    suite = testing.test_equal(
        suite,
        "кодировщик: машинное слово видно только нулями и единицами",
        word.binary_text(addi),
        "10010011 00000000 00110001 00000000"
    )
    out suite
}

skill executable(suite) {
    @writer = emit.Emit {}
    @target = layout.host("_start")
    target.define_label(Layout.Section.CODE, "_start")
    writer.branch(target, Instruction.Kind.BEQ, registers.ZERO, registers.ZERO, "done")
    writer.op(target, Instruction.Kind.ADDI, registers.A0, registers.ZERO, registers.ZERO, 9)
    target.define_label(Layout.Section.CODE, "done")
    writer.op(target, Instruction.Kind.EBREAK, registers.ZERO, registers.ZERO, registers.ZERO, 0)
    target = layout.resolve(target)

    @current_layout = target.layout()
    @done_offset = target.label_offset(current_layout, "done")
    @target_code = target.code
    @branch_byte = target_code.byte_at(1)
    @target_elf = Elf {
        machine = target
    }
    @output = target_elf.executable()

    suite = testing.test_equal(suite, "программа: метка получила точное смещение", done_offset, 8)
    suite = testing.test_equal(suite, "программа: ссылка на метку исправлена", branch_byte, 4)
    suite = testing.test_yes(suite, "образ: исполняемый файл создан", output.length > 4096)
    out suite
}

program(output_path) {
    @suite = testing.test_new()
    suite = lowering(suite)
    suite = runtime_bytes.run(suite)
    suite = machine_profile(suite)
    suite = encoding(suite)
    suite = executable(suite)
    suite = golden.run(suite)
    suite = immediate.run(suite)
    suite = patches.run(suite)
    suite = elf32.run(suite)
    suite = scale.run(suite)
    suite = wide.run(suite)
    suite = qemu.run(suite, output_path)
    out testing.test_finish(suite)
}
