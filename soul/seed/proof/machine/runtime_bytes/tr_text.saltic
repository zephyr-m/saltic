-- tr_text — эталоны машинного кода, часть runtime_bytes:
-- тексты: fixed show, group add, cstring, склейка (срезы, регистр и число
-- в текст — tr_slices).
-- Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use craft.testing
use compiler.gorn.state
use compiler.gorn.backend.riscv.rv32i
use compiler.gorn.backend.layout
use compiler.gorn.backend.buffer
use compiler.gorn.backend.runtime.collections
use compiler.gorn.backend.runtime.fixed
use compiler.gorn.backend.runtime.strings

skill run(suite) {
    @fixed_show = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    fixed_show = fixed.emit_fixed_text(fixed_show)
    @fixed_show_machine = fixed_show.machine
    fixed_show_machine.define_label(Layout.Section.CODE, "rt_alloc")
    fixed_show_machine = fixed_show.machine
    fixed_show_machine.define_label(Layout.Section.CODE, "rt_show")
    fixed_show.machine = layout.resolve(fixed_show.machine)
    @fixed_show_bytes = [
        19, 1, 1, 252, 35, 46, 17, 2,
        147, 2, 5, 0, 147, 3, 0, 0,
        19, 14, 64, 0, 99, 24, 200, 1,
        99, 214, 2, 0, 147, 3, 16, 0,
        179, 2, 80, 64, 19, 14, 0, 0,
        147, 14, 0, 0, 19, 15, 0, 0,
        19, 6, 0, 2, 147, 134, 2, 0,
        19, 215, 246, 1, 147, 150, 22, 0,
        19, 31, 31, 0, 51, 111, 239, 0,
        147, 158, 30, 0, 19, 7, 160, 0,
        99, 102, 239, 0, 19, 15, 111, 255,
        147, 238, 30, 0, 19, 6, 246, 255,
        227, 28, 6, 252, 19, 15, 15, 3,
        51, 7, 193, 1, 35, 0, 231, 1,
        19, 14, 30, 0, 147, 130, 14, 0,
        227, 152, 2, 250, 179, 14, 126, 0,
        35, 44, 193, 3, 35, 42, 113, 2,
        35, 40, 209, 3, 19, 133, 94, 0,
        239, 0, 192, 6, 3, 46, 129, 3,
        131, 35, 65, 3, 131, 46, 1, 3,
        19, 15, 16, 0, 35, 32, 229, 1,
        35, 38, 213, 1, 19, 15, 0, 0,
        99, 136, 3, 0, 19, 6, 208, 2,
        35, 8, 197, 0, 19, 15, 16, 0,
        99, 0, 14, 2, 19, 14, 254, 255,
        51, 6, 193, 1, 3, 70, 6, 0,
        179, 6, 229, 1, 35, 136, 198, 0,
        19, 15, 31, 0, 111, 240, 95, 254,
        179, 6, 213, 1, 35, 136, 6, 0,
        19, 101, 53, 0, 131, 32, 193, 3,
        19, 1, 1, 4, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон fixed show: длина", fixed_show.machine.code.length, 252)
    fixed_show_machine = fixed_show.machine
    suite = testing.test_equal(suite, "эталон fixed show: девять переходов", fixed_show_machine.patches(), 9)
    drum (252) {
        @fixed_show_machine_code = fixed_show.machine.code
        suite = testing.test_equal(suite, "эталон fixed show: байт {beat}", fixed_show_machine_code.byte_at(beat), group.get(fixed_show_bytes, beat))
    }
    fixed_show_machine = fixed_show.machine
    @fixed_show_label = fixed_show_machine.find_label("rt_fixed_text")
    fixed_show_machine = fixed_show.machine
    @fixed_text_digits = fixed_show_machine.find_label(".L_fixed_text_digits")
    fixed_show_machine = fixed_show.machine
    @fixed_text_digit = fixed_show_machine.find_label(".L_fixed_text_digit")
    fixed_show_machine = fixed_show.machine
    @fixed_text_div10 = fixed_show_machine.find_label(".L_fixed_text_div10")
    fixed_show_machine = fixed_show.machine
    @fixed_text_div10_next = fixed_show_machine.find_label(".L_fixed_text_div10_next")
    fixed_show_machine = fixed_show.machine
    @fixed_text_copy = fixed_show_machine.find_label(".L_fixed_text_copy")
    fixed_show_machine = fixed_show.machine
    @fixed_text_done = fixed_show_machine.find_label(".L_fixed_text_done")
    fixed_show_machine = fixed_show.machine
    @fixed_show_alloc = fixed_show_machine.find_label("rt_alloc")
    fixed_show_machine = fixed_show.machine
    @fixed_show_show = fixed_show_machine.find_label("rt_show")
    suite = testing.test_yes(suite, "эталон rt_fixed_show: метка существует", fixed_show_label.present)
    suite = testing.test_equal(suite, "эталон rt_fixed_text: смещение", fixed_show_label.offset, 0)
    suite = testing.test_yes(suite, "fixed show: цифры существуют", fixed_text_digits.present)
    suite = testing.test_equal(suite, "fixed show: смещение цифр", fixed_text_digits.offset, 36)
    suite = testing.test_yes(suite, "fixed show: цифра существует", fixed_text_digit.present)
    suite = testing.test_equal(suite, "fixed show: смещение цифры", fixed_text_digit.offset, 40)
    suite = testing.test_yes(suite, "fixed show: деление существует", fixed_text_div10.present)
    suite = testing.test_equal(suite, "fixed show: смещение деления", fixed_text_div10.offset, 56)
    suite = testing.test_yes(suite, "fixed show: шаг деления существует", fixed_text_div10_next.present)
    suite = testing.test_equal(suite, "fixed show: смещение шага деления", fixed_text_div10_next.offset, 92)
    suite = testing.test_yes(suite, "fixed show: копирование существует", fixed_text_copy.present)
    suite = testing.test_equal(suite, "fixed show: смещение копирования", fixed_text_copy.offset, 192)
    suite = testing.test_yes(suite, "fixed show: завершение существует", fixed_text_done.present)
    suite = testing.test_equal(suite, "fixed show: смещение завершения", fixed_text_done.offset, 224)
    suite = testing.test_yes(suite, "fixed show: связанный alloc существует", fixed_show_alloc.present)
    suite = testing.test_equal(suite, "fixed show: смещение alloc", fixed_show_alloc.offset, 252)
    suite = testing.test_yes(suite, "fixed show: связанный show существует", fixed_show_show.present)
    suite = testing.test_equal(suite, "fixed show: смещение show", fixed_show_show.offset, 252)

    @group_add = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    group_add = collections.emit_group_add(group_add)
    @group_add_machine = group_add.machine
    group_add_machine.define_label(Layout.Section.CODE, "rt_alloc")
    group_add.machine = layout.resolve(group_add.machine)
    @group_add_bytes = [
        19, 1, 1, 255, 35, 38, 17, 0,
        35, 36, 161, 0, 35, 34, 177, 0,
        147, 114, 133, 255, 3, 163, 194, 0,
        19, 5, 35, 0, 19, 21, 37, 0,
        239, 0, 128, 6, 131, 34, 129, 0,
        147, 242, 130, 255, 3, 163, 194, 0,
        147, 3, 19, 0, 19, 14, 32, 0,
        35, 32, 197, 1, 35, 38, 117, 0,
        147, 3, 0, 0, 99, 128, 99, 2,
        19, 158, 35, 0, 179, 142, 194, 1,
        3, 175, 14, 1, 179, 14, 197, 1,
        35, 168, 238, 1, 147, 131, 19, 0,
        111, 240, 95, 254, 19, 30, 35, 0,
        51, 14, 197, 1, 131, 46, 65, 0,
        35, 40, 222, 1, 19, 101, 69, 0,
        131, 32, 193, 0, 19, 1, 1, 1,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон group add: длина", group_add.machine.code.length, 136)
    group_add_machine = group_add.machine
    suite = testing.test_equal(suite, "эталон group add: четыре перехода", group_add_machine.patches(), 3)
    drum (136) {
        @group_add_machine_code = group_add.machine.code
        suite = testing.test_equal(suite, "эталон group add: байт {beat}", group_add_machine_code.byte_at(beat), group.get(group_add_bytes, beat))
    }
    group_add_machine = group_add.machine
    @group_add_label = group_add_machine.find_label("rt_group_add")
    group_add_machine = group_add.machine
    @group_copy = group_add_machine.find_label(".L_group_copy")
    group_add_machine = group_add.machine
    @group_copy_done = group_add_machine.find_label(".L_group_copy_done")
    group_add_machine = group_add.machine
    @group_add_alloc = group_add_machine.find_label("rt_alloc")
    suite = testing.test_yes(suite, "эталон rt_group_add: метка существует", group_add_label.present)
    suite = testing.test_equal(suite, "эталон rt_group_add: смещение", group_add_label.offset, 0)
    suite = testing.test_yes(suite, "group add: копирование существует", group_copy.present)
    suite = testing.test_equal(suite, "group add: смещение копирования", group_copy.offset, 68)
    suite = testing.test_yes(suite, "group add: завершение существует", group_copy_done.present)
    suite = testing.test_equal(suite, "group add: смещение завершения", group_copy_done.offset, 100)
    suite = testing.test_yes(suite, "group add: связанный alloc существует", group_add_alloc.present)
    suite = testing.test_equal(suite, "group add: смещение alloc", group_add_alloc.offset, 136)

    @cstring = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    cstring = strings.emit_cstring(cstring)
    @cstring_machine = cstring.machine
    cstring_machine.define_label(Layout.Section.CODE, "rt_alloc")
    cstring.machine = layout.resolve(cstring.machine)
    @cstring_bytes = [
        19, 1, 1, 255, 35, 38, 17, 0,
        35, 36, 161, 0, 147, 2, 5, 0,
        19, 3, 0, 0, 131, 195, 2, 0,
        99, 136, 3, 0, 147, 130, 18, 0,
        19, 3, 19, 0, 111, 240, 31, 255,
        35, 34, 97, 0, 19, 5, 83, 0,
        239, 0, 192, 4, 3, 35, 65, 0,
        147, 3, 16, 0, 35, 32, 117, 0,
        35, 38, 101, 0, 131, 34, 129, 0,
        147, 3, 0, 0, 99, 110, 115, 0,
        51, 142, 114, 0, 131, 78, 14, 0,
        51, 14, 117, 0, 35, 8, 222, 1,
        147, 131, 19, 0, 111, 240, 159, 254,
        19, 101, 53, 0, 131, 32, 193, 0,
        19, 1, 1, 1, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон cstring: длина", cstring.machine.code.length, 124)
    cstring_machine = cstring.machine
    suite = testing.test_equal(suite, "эталон cstring: шесть переходов", cstring_machine.patches(), 5)
    drum (124) {
        @cstring_machine_code = cstring.machine.code
        suite = testing.test_equal(suite, "эталон cstring: байт {beat}", cstring_machine_code.byte_at(beat), group.get(cstring_bytes, beat))
    }
    cstring_machine = cstring.machine
    @cstring_label = cstring_machine.find_label("rt_cstring")
    cstring_machine = cstring.machine
    @cstring_len = cstring_machine.find_label(".L_cstring_len")
    cstring_machine = cstring.machine
    @cstring_alloc = cstring_machine.find_label(".L_cstring_alloc")
    cstring_machine = cstring.machine
    @cstring_copy = cstring_machine.find_label(".L_cstring_copy")
    cstring_machine = cstring.machine
    @cstring_done = cstring_machine.find_label(".L_cstring_done")
    cstring_machine = cstring.machine
    @cstring_rt_alloc = cstring_machine.find_label("rt_alloc")
    suite = testing.test_yes(suite, "эталон rt_cstring: метка существует", cstring_label.present)
    suite = testing.test_equal(suite, "эталон rt_cstring: смещение", cstring_label.offset, 0)
    suite = testing.test_yes(suite, "cstring: подсчёт существует", cstring_len.present)
    suite = testing.test_equal(suite, "cstring: смещение подсчёта", cstring_len.offset, 20)
    suite = testing.test_yes(suite, "cstring: выделение существует", cstring_alloc.present)
    suite = testing.test_equal(suite, "cstring: смещение выделения", cstring_alloc.offset, 40)
    suite = testing.test_yes(suite, "cstring: копирование существует", cstring_copy.present)
    suite = testing.test_equal(suite, "cstring: смещение копирования", cstring_copy.offset, 76)
    suite = testing.test_yes(suite, "cstring: завершение существует", cstring_done.present)
    suite = testing.test_equal(suite, "cstring: смещение завершения", cstring_done.offset, 104)
    suite = testing.test_yes(suite, "cstring: связанный alloc существует", cstring_rt_alloc.present)
    suite = testing.test_equal(suite, "cstring: смещение alloc", cstring_rt_alloc.offset, 124)

    @string_add = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    string_add = strings.emit_string_add(string_add)
    @string_add_machine = string_add.machine
    string_add_machine.define_label(Layout.Section.CODE, "rt_alloc")
    string_add.machine = layout.resolve(string_add.machine)
    @string_add_bytes = [
        19, 1, 1, 254, 35, 46, 17, 0,
        147, 114, 133, 255, 19, 243, 133, 255,
        35, 44, 81, 0, 35, 42, 97, 0,
        131, 163, 194, 0, 3, 46, 195, 0,
        35, 40, 113, 0, 35, 38, 193, 1,
        179, 142, 195, 1, 35, 36, 209, 1,
        19, 133, 94, 0, 239, 0, 64, 8,
        131, 46, 129, 0, 19, 15, 16, 0,
        35, 32, 229, 1, 35, 38, 213, 1,
        19, 15, 0, 0, 131, 34, 129, 1,
        3, 35, 65, 1, 131, 35, 1, 1,
        99, 14, 127, 0, 51, 142, 226, 1,
        131, 78, 14, 1, 51, 14, 229, 1,
        35, 8, 222, 1, 19, 15, 31, 0,
        111, 240, 159, 254, 19, 6, 0, 0,
        131, 35, 193, 0, 99, 0, 118, 2,
        51, 14, 195, 0, 131, 78, 14, 1,
        51, 14, 229, 1, 35, 8, 222, 1,
        19, 15, 31, 0, 19, 6, 22, 0,
        111, 240, 95, 254, 51, 14, 229, 1,
        35, 8, 14, 0, 19, 101, 53, 0,
        131, 32, 193, 1, 19, 1, 1, 2,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон string add: длина", string_add.machine.code.length, 184)
    string_add_machine = string_add.machine
    suite = testing.test_equal(suite, "эталон string add: шесть переходов", string_add_machine.patches(), 5)
    drum (184) {
        @string_add_machine_code = string_add.machine.code
        suite = testing.test_equal(suite, "эталон string add: байт {beat}", string_add_machine_code.byte_at(beat), group.get(string_add_bytes, beat))
    }
    string_add_machine = string_add.machine
    @string_add_label = string_add_machine.find_label("rt_string_add")
    string_add_machine = string_add.machine
    @string_left = string_add_machine.find_label(".L_string_left")
    string_add_machine = string_add.machine
    @string_right_start = string_add_machine.find_label(".L_string_right_start")
    string_add_machine = string_add.machine
    @string_right = string_add_machine.find_label(".L_string_right")
    string_add_machine = string_add.machine
    @string_done = string_add_machine.find_label(".L_string_done")
    string_add_machine = string_add.machine
    @string_add_alloc = string_add_machine.find_label("rt_alloc")
    suite = testing.test_yes(suite, "эталон rt_string_add: метка существует", string_add_label.present)
    suite = testing.test_equal(suite, "эталон rt_string_add: смещение", string_add_label.offset, 0)
    suite = testing.test_yes(suite, "string add: левая часть существует", string_left.present)
    suite = testing.test_equal(suite, "string add: смещение левой части", string_left.offset, 88)
    suite = testing.test_yes(suite, "string add: начало правой части существует", string_right_start.present)
    suite = testing.test_equal(suite, "string add: смещение начала правой части", string_right_start.offset, 116)
    suite = testing.test_yes(suite, "string add: правая часть существует", string_right.present)
    suite = testing.test_equal(suite, "string add: смещение правой части", string_right.offset, 124)
    suite = testing.test_yes(suite, "string add: завершение существует", string_done.present)
    suite = testing.test_equal(suite, "string add: смещение завершения", string_done.offset, 156)
    suite = testing.test_yes(suite, "string add: связанный alloc существует", string_add_alloc.present)
    suite = testing.test_equal(suite, "string add: смещение alloc", string_add_alloc.offset, 184)

    out suite
}
