-- tr_slices — эталоны машинного кода, часть runtime_bytes: тексты по
-- кусочкам — символ по номеру, срез, регистр, число в текст (вынесено из
-- tr_text, 22.11.2026). Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use craft.testing
use compiler.gorn.state
use compiler.gorn.backend.riscv.rv32i
use compiler.gorn.backend.layout
use compiler.gorn.backend.buffer
use compiler.gorn.backend.runtime.numbers
use compiler.gorn.backend.runtime.strings

skill run(suite) {
    @string_at = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    string_at = strings.emit_string_at(string_at)
    @string_at_machine = string_at.machine
    string_at_machine.define_label(layout.Section.CODE, "rt_alloc")
    string_at_machine = string_at.machine
    string_at_machine.define_label(layout.Section.CODE, "rt_string_bounds")
    string_at.machine = layout.resolve(string_at.machine)
    @string_at_bytes = [
        147, 114, 133, 255, 147, 213, 53, 64,
        3, 163, 194, 0, 99, 248, 101, 4,
        19, 1, 1, 255, 35, 38, 17, 0,
        179, 130, 178, 0, 3, 195, 2, 1,
        35, 36, 97, 0, 19, 5, 96, 0,
        239, 0, 64, 3, 147, 2, 16, 0,
        35, 32, 85, 0, 147, 2, 16, 0,
        35, 38, 85, 0, 3, 35, 129, 0,
        35, 8, 101, 0, 163, 8, 5, 0,
        19, 101, 53, 0, 131, 32, 193, 0,
        19, 1, 1, 1, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон string at: длина", string_at.machine.code.length, 92)
    string_at_machine = string_at.machine
    suite = testing.test_equal(suite, "эталон string at: три перехода", string_at_machine.patches(), 2)
    drum (92) {
        @string_at_machine_code = string_at.machine.code
        suite = testing.test_equal(suite, "эталон string at: байт {beat}", string_at_machine_code.byte_at(beat), group.get(string_at_bytes, beat))
    }
    string_at_machine = string_at.machine
    @string_at_label = string_at_machine.find_label("rt_string_at")
    string_at_machine = string_at.machine
    @string_at_alloc = string_at_machine.find_label("rt_alloc")
    string_at_machine = string_at.machine
    @string_at_bounds = string_at_machine.find_label("rt_string_bounds")
    suite = testing.test_yes(suite, "эталон rt_string_at: метка существует", string_at_label.present)
    suite = testing.test_equal(suite, "эталон rt_string_at: смещение", string_at_label.offset, 0)
    suite = testing.test_yes(suite, "string at: связанный alloc существует", string_at_alloc.present)
    suite = testing.test_equal(suite, "string at: смещение alloc", string_at_alloc.offset, 92)
    suite = testing.test_yes(suite, "string at: связанные границы существуют", string_at_bounds.present)
    suite = testing.test_equal(suite, "string at: смещение границ", string_at_bounds.offset, 92)

    @string_slice = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    string_slice = strings.emit_string_slice(string_slice)
    @string_slice_machine = string_slice.machine
    string_slice_machine.define_label(layout.Section.CODE, "rt_alloc")
    string_slice_machine = string_slice.machine
    string_slice_machine.define_label(layout.Section.CODE, "rt_string_bounds")
    string_slice.machine = layout.resolve(string_slice.machine)
    @string_slice_bytes = [
        147, 114, 133, 255, 147, 213, 53, 64,
        19, 86, 54, 64, 3, 163, 194, 0,
        99, 96, 182, 8, 99, 110, 195, 6,
        19, 1, 1, 254, 35, 46, 17, 0,
        179, 3, 182, 64, 35, 44, 81, 0,
        35, 42, 177, 0, 35, 40, 113, 0,
        19, 133, 83, 0, 239, 0, 192, 5,
        131, 34, 129, 1, 3, 35, 65, 1,
        131, 35, 1, 1, 19, 14, 16, 0,
        35, 32, 197, 1, 35, 38, 117, 0,
        19, 14, 0, 0, 99, 0, 126, 2,
        179, 14, 195, 1, 179, 142, 210, 1,
        3, 207, 14, 1, 179, 14, 197, 1,
        35, 136, 238, 1, 19, 14, 30, 0,
        111, 240, 95, 254, 179, 14, 117, 0,
        35, 136, 14, 0, 19, 101, 53, 0,
        131, 32, 193, 1, 19, 1, 1, 2,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон string slice: длина", string_slice.machine.code.length, 144)
    string_slice_machine = string_slice.machine
    suite = testing.test_equal(suite, "эталон string slice: шесть переходов", string_slice_machine.patches(), 5)
    drum (144) {
        @string_slice_machine_code = string_slice.machine.code
        suite = testing.test_equal(suite, "эталон string slice: байт {beat}", string_slice_machine_code.byte_at(beat), group.get(string_slice_bytes, beat))
    }
    string_slice_machine = string_slice.machine
    @string_slice_label = string_slice_machine.find_label("rt_string_slice")
    string_slice_machine = string_slice.machine
    @slice_copy = string_slice_machine.find_label(".L_slice_copy")
    string_slice_machine = string_slice.machine
    @slice_done = string_slice_machine.find_label(".L_slice_done")
    string_slice_machine = string_slice.machine
    @string_slice_alloc = string_slice_machine.find_label("rt_alloc")
    string_slice_machine = string_slice.machine
    @string_slice_bounds = string_slice_machine.find_label("rt_string_bounds")
    suite = testing.test_yes(suite, "эталон rt_string_slice: метка существует", string_slice_label.present)
    suite = testing.test_equal(suite, "эталон rt_string_slice: смещение", string_slice_label.offset, 0)
    suite = testing.test_yes(suite, "string slice: копирование существует", slice_copy.present)
    suite = testing.test_equal(suite, "string slice: смещение копирования", slice_copy.offset, 84)
    suite = testing.test_yes(suite, "string slice: завершение существует", slice_done.present)
    suite = testing.test_equal(suite, "string slice: смещение завершения", slice_done.offset, 116)
    suite = testing.test_yes(suite, "string slice: связанный alloc существует", string_slice_alloc.present)
    suite = testing.test_equal(suite, "string slice: смещение alloc", string_slice_alloc.offset, 144)
    suite = testing.test_yes(suite, "string slice: связанные границы существуют", string_slice_bounds.present)
    suite = testing.test_equal(suite, "string slice: смещение границ", string_slice_bounds.offset, 144)

    @string_case = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    string_case = strings.emit_string_lower(string_case)
    string_case = strings.emit_string_case(string_case)
    @string_case_machine = string_case.machine
    string_case_machine.define_label(layout.Section.CODE, "rt_alloc")
    string_case.machine = layout.resolve(string_case.machine)
    @string_case_bytes = [
        147, 5, 0, 0, 111, 0, 128, 0,
        147, 5, 16, 0, 19, 1, 1, 254,
        35, 46, 17, 0, 147, 114, 133, 255,
        3, 163, 194, 0, 35, 44, 81, 0,
        35, 42, 97, 0, 35, 40, 177, 0,
        19, 5, 83, 0, 239, 0, 192, 21,
        131, 34, 129, 1, 3, 35, 65, 1,
        131, 35, 1, 1, 19, 14, 16, 0,
        35, 32, 197, 1, 35, 38, 101, 0,
        19, 14, 0, 0, 99, 0, 110, 18,
        179, 142, 194, 1, 3, 207, 14, 1,
        147, 5, 0, 13, 99, 6, 191, 4,
        147, 5, 16, 13, 99, 2, 191, 4,
        99, 142, 3, 0, 147, 14, 16, 6,
        99, 100, 223, 3, 147, 14, 176, 7,
        99, 112, 223, 3, 19, 15, 15, 254,
        111, 0, 128, 1, 147, 14, 16, 4,
        99, 104, 223, 1, 147, 14, 176, 5,
        99, 116, 223, 1, 19, 15, 15, 2,
        179, 14, 197, 1, 35, 136, 238, 1,
        19, 14, 30, 0, 111, 240, 159, 250,
        147, 5, 30, 0, 227, 254, 101, 250,
        179, 142, 194, 1, 3, 198, 30, 1,
        147, 5, 0, 13, 99, 138, 3, 4,
        99, 16, 191, 2, 147, 14, 0, 11,
        99, 104, 214, 9, 147, 14, 0, 12,
        99, 116, 214, 9, 19, 15, 0, 13,
        19, 6, 6, 254, 111, 0, 192, 7,
        147, 14, 16, 9, 99, 0, 214, 3,
        147, 14, 0, 8, 99, 102, 214, 7,
        147, 14, 0, 9, 99, 114, 214, 7,
        19, 15, 0, 13, 19, 6, 6, 2,
        111, 0, 128, 5, 19, 15, 0, 13,
        19, 6, 6, 255, 111, 0, 192, 4,
        99, 20, 191, 4, 147, 14, 16, 8,
        99, 10, 214, 3, 147, 14, 0, 9,
        99, 108, 214, 3, 147, 14, 0, 11,
        99, 120, 214, 3, 147, 14, 0, 10,
        99, 104, 214, 1, 19, 15, 16, 13,
        19, 6, 6, 254, 111, 0, 192, 1,
        19, 15, 0, 13, 19, 6, 6, 2,
        111, 0, 0, 1, 19, 15, 16, 13,
        19, 6, 6, 1, 111, 0, 64, 0,
        179, 14, 197, 1, 35, 136, 238, 1,
        163, 136, 206, 0, 19, 14, 46, 0,
        111, 240, 95, 238, 179, 14, 101, 0,
        35, 136, 14, 0, 19, 101, 53, 0,
        131, 32, 193, 1, 19, 1, 1, 2,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон string case: длина", string_case.machine.code.length, 392)
    string_case_machine = string_case.machine
    suite = testing.test_equal(suite, "эталон string case: тридцать два перехода", string_case_machine.patches(), 32)
    drum (392) {
        @string_case_machine_code = string_case.machine.code
        suite = testing.test_equal(suite, "эталон string case: байт {beat}", string_case_machine_code.byte_at(beat), group.get(string_case_bytes, beat))
    }
    string_case_machine = string_case.machine
    @string_lower_label = string_case_machine.find_label("rt_string_lower")
    string_case_machine = string_case.machine
    @string_upper_label = string_case_machine.find_label("rt_string_upper")
    string_case_machine = string_case.machine
    @string_case_label = string_case_machine.find_label("rt_string_case")
    string_case_machine = string_case.machine
    @case_loop = string_case_machine.find_label(".L_case_loop")
    string_case_machine = string_case.machine
    @case_lower = string_case_machine.find_label(".L_case_lower")
    string_case_machine = string_case.machine
    @case_store = string_case_machine.find_label(".L_case_store")
    string_case_machine = string_case.machine
    @case_done = string_case_machine.find_label(".L_case_done")
    string_case_machine = string_case.machine
    @string_case_alloc = string_case_machine.find_label("rt_alloc")
    suite = testing.test_yes(suite, "эталон rt_string_lower: метка существует", string_lower_label.present)
    suite = testing.test_equal(suite, "эталон rt_string_lower: смещение", string_lower_label.offset, 0)
    suite = testing.test_yes(suite, "эталон rt_string_upper: метка существует", string_upper_label.present)
    suite = testing.test_equal(suite, "эталон rt_string_upper: смещение", string_upper_label.offset, 8)
    suite = testing.test_yes(suite, "эталон rt_string_case: метка существует", string_case_label.present)
    suite = testing.test_equal(suite, "эталон rt_string_case: смещение", string_case_label.offset, 12)
    suite = testing.test_yes(suite, "string case: цикл существует", case_loop.present)
    suite = testing.test_equal(suite, "string case: смещение цикла", case_loop.offset, 76)
    suite = testing.test_yes(suite, "string case: lower существует", case_lower.present)
    suite = testing.test_equal(suite, "string case: смещение lower", case_lower.offset, 132)
    suite = testing.test_yes(suite, "string case: запись существует", case_store.present)
    suite = testing.test_equal(suite, "string case: смещение записи", case_store.offset, 152)
    suite = testing.test_yes(suite, "string case: завершение существует", case_done.present)
    suite = testing.test_equal(suite, "string case: смещение завершения", case_done.offset, 364)
    suite = testing.test_yes(suite, "string case: связанный alloc существует", string_case_alloc.present)
    suite = testing.test_equal(suite, "string case: смещение alloc", string_case_alloc.offset, 392)

    @number_text = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    number_text = numbers.emit_number_text(number_text)
    @number_text_machine = number_text.machine
    number_text_machine.define_label(layout.Section.CODE, "rt_alloc")
    number_text.machine = layout.resolve(number_text.machine)
    @number_text_bytes = [
        19, 1, 1, 253, 35, 38, 17, 2,
        147, 82, 53, 64, 19, 3, 0, 0,
        99, 214, 2, 0, 19, 3, 16, 0,
        179, 2, 80, 64, 147, 3, 1, 0,
        19, 14, 0, 0, 99, 154, 2, 0,
        147, 14, 0, 3, 35, 128, 211, 1,
        19, 14, 16, 0, 111, 0, 128, 3,
        147, 14, 160, 0, 19, 15, 0, 0,
        19, 134, 2, 0, 99, 104, 214, 1,
        19, 6, 102, 255, 19, 15, 31, 0,
        111, 240, 95, 255, 19, 6, 6, 3,
        179, 142, 195, 1, 35, 128, 206, 0,
        19, 14, 30, 0, 147, 2, 15, 0,
        227, 152, 2, 252, 99, 4, 3, 0,
        19, 14, 30, 0, 35, 36, 193, 3,
        35, 34, 97, 2, 35, 32, 113, 2,
        19, 5, 94, 0, 239, 0, 0, 7,
        3, 46, 129, 2, 3, 35, 65, 2,
        131, 35, 1, 2, 147, 14, 16, 0,
        35, 32, 213, 1, 35, 38, 197, 1,
        147, 14, 0, 0, 99, 10, 3, 0,
        19, 15, 208, 2, 35, 8, 229, 1,
        147, 14, 16, 0, 19, 14, 254, 255,
        99, 0, 14, 2, 19, 14, 254, 255,
        51, 143, 195, 1, 3, 70, 15, 0,
        51, 15, 213, 1, 35, 8, 207, 0,
        147, 142, 30, 0, 111, 240, 95, 254,
        51, 15, 213, 1, 35, 8, 15, 0,
        19, 101, 53, 0, 131, 32, 193, 2,
        19, 1, 1, 3, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон number text: длина", number_text.machine.code.length, 244)
    number_text_machine = number_text.machine
    suite = testing.test_equal(suite, "эталон number text: двенадцать переходов", number_text_machine.patches(), 11)
    drum (244) {
        @number_text_machine_code = number_text.machine.code
        suite = testing.test_equal(suite, "эталон number text: байт {beat}", number_text_machine_code.byte_at(beat), group.get(number_text_bytes, beat))
    }
    number_text_machine = number_text.machine
    @number_text_label = number_text_machine.find_label("rt_number_text")
    number_text_machine = number_text.machine
    @number_abs = number_text_machine.find_label(".L_number_abs")
    number_text_machine = number_text.machine
    @number_digits = number_text_machine.find_label(".L_number_digits")
    number_text_machine = number_text.machine
    @number_digit_loop = number_text_machine.find_label(".L_number_digit_loop")
    number_text_machine = number_text.machine
    @number_div10 = number_text_machine.find_label(".L_number_div10")
    number_text_machine = number_text.machine
    @number_remainder = number_text_machine.find_label(".L_number_remainder")
    number_text_machine = number_text.machine
    @number_ready = number_text_machine.find_label(".L_number_ready")
    number_text_machine = number_text.machine
    @number_alloc = number_text_machine.find_label(".L_number_alloc")
    number_text_machine = number_text.machine
    @number_copy = number_text_machine.find_label(".L_number_copy")
    number_text_machine = number_text.machine
    @number_done = number_text_machine.find_label(".L_number_done")
    number_text_machine = number_text.machine
    @number_text_alloc = number_text_machine.find_label("rt_alloc")
    suite = testing.test_yes(suite, "эталон rt_number_text: метка существует", number_text_label.present)
    suite = testing.test_equal(suite, "эталон rt_number_text: смещение", number_text_label.offset, 0)
    suite = testing.test_yes(suite, "number text: модуль существует", number_abs.present)
    suite = testing.test_equal(suite, "number text: смещение модуля", number_abs.offset, 28)
    suite = testing.test_yes(suite, "number text: цифры существуют", number_digits.present)
    suite = testing.test_equal(suite, "number text: смещение цифр", number_digits.offset, 56)
    suite = testing.test_yes(suite, "number text: цикл цифры существует", number_digit_loop.present)
    suite = testing.test_equal(suite, "number text: смещение цикла цифры", number_digit_loop.offset, 60)
    suite = testing.test_yes(suite, "number text: деление существует", number_div10.present)
    suite = testing.test_equal(suite, "number text: смещение деления", number_div10.offset, 68)
    suite = testing.test_yes(suite, "number text: остаток существует", number_remainder.present)
    suite = testing.test_equal(suite, "number text: смещение остатка", number_remainder.offset, 84)
    suite = testing.test_yes(suite, "number text: готовность существует", number_ready.present)
    suite = testing.test_equal(suite, "number text: смещение готовности", number_ready.offset, 108)
    suite = testing.test_yes(suite, "number text: выделение существует", number_alloc.present)
    suite = testing.test_equal(suite, "number text: смещение выделения", number_alloc.offset, 116)
    suite = testing.test_yes(suite, "number text: копирование существует", number_copy.present)
    suite = testing.test_equal(suite, "number text: смещение копирования", number_copy.offset, 184)
    suite = testing.test_yes(suite, "number text: завершение существует", number_done.present)
    suite = testing.test_equal(suite, "number text: смещение завершения", number_done.offset, 216)
    suite = testing.test_yes(suite, "number text: связанный alloc существует", number_text_alloc.present)
    suite = testing.test_equal(suite, "number text: смещение alloc", number_text_alloc.offset, 244)

    out suite
}
