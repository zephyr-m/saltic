-- tr_system — эталоны машинного кода, часть runtime_bytes:
-- платформа, CPU, запись файла, ошибки и сравнения fixed.
-- Собирает кусок рантайма и сверяет байты с эталоном.
--
-- run(suite) -> suite с проверками этой части

use core.group
use craft.testing
use compiler.gorn.state
use compiler.gorn.backend.riscv
use compiler.gorn.backend.layout
use compiler.gorn.backend.buffer
use compiler.gorn.backend.runtime.fixed
use compiler.gorn.backend.runtime.host
use compiler.gorn.platform.linux
use compiler.gorn.backend.runtime.numbers

skill run(suite) {
    @linux_calls = linux.Linux {}
    @numerals = numbers.Numbers {}
    @fixeds = fixed.Fixed {}
    @host_calls = host.Host {}
    @platform = state.State { executor = riscv.Executor {}, machine = layout.Program {} }
    platform = linux_calls.emit_write(platform)
    platform = linux_calls.emit_exit(platform)
    platform = host_calls.emit_cpu_wait(platform)
    platform = host_calls.emit_cpu_fence(platform)
    @platform_machine = platform.machine
    platform_machine.define_label(Layout.Section.CODE, "rt_platform_wait")
    platform.machine = layout.resolve(platform.machine)
    @platform_bytes = [
        147, 8, 0, 4, 115, 0, 0, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        147, 8, 208, 5, 115, 0, 0, 0,
        111, 0, 64, 1, 15, 0, 48, 3,
        19, 5, 16, 1, 147, 5, 0, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон платформы и CPU: длина", platform.machine.code.length, 44)
    platform_machine = platform.machine
    suite = testing.test_equal(suite, "эталон платформы и CPU: переходов нет", platform_machine.patches(), 1)
    drum (44) {
        @platform_machine_code = platform.machine.code
        suite = testing.test_equal(suite, "эталон платформы и CPU: байт {beat}", platform_machine_code.byte_at(beat), group.get(platform_bytes, beat))
    }
    platform_machine = platform.machine
    @platform_write = platform_machine.find_label("rt_platform_write")
    platform_machine = platform.machine
    @platform_exit = platform_machine.find_label("rt_platform_exit")
    platform_machine = platform.machine
    @cpu_wait = platform_machine.find_label("rt_cpu_wait")
    platform_machine = platform.machine
    @cpu_fence = platform_machine.find_label("rt_cpu_fence")
    suite = testing.test_yes(suite, "эталон rt_platform_write: метка существует", platform_write.present)
    suite = testing.test_equal(suite, "эталон rt_platform_write: смещение", platform_write.offset, 0)
    suite = testing.test_yes(suite, "эталон rt_platform_exit: метка существует", platform_exit.present)
    suite = testing.test_equal(suite, "эталон rt_platform_exit: смещение", platform_exit.offset, 16)
    suite = testing.test_yes(suite, "эталон rt_cpu_wait: метка существует", cpu_wait.present)
    suite = testing.test_equal(suite, "эталон rt_cpu_wait: смещение", cpu_wait.offset, 24)
    suite = testing.test_yes(suite, "эталон rt_cpu_fence: метка существует", cpu_fence.present)
    suite = testing.test_equal(suite, "эталон rt_cpu_fence: смещение", cpu_fence.offset, 28)

    @file_write = state.State { executor = riscv.Executor {}, machine = layout.Program {} }
    file_write = linux_calls.emit_file_write(file_write)
    file_write = linux_calls.emit_file_error(file_write)
    file_write.machine = layout.resolve(file_write.machine)
    @file_write_bytes = [
        19, 1, 1, 254, 35, 46, 17, 0,
        35, 44, 177, 0, 147, 114, 133, 255,
        147, 133, 2, 1, 19, 5, 192, 249,
        19, 6, 16, 36, 147, 6, 64, 26,
        147, 8, 128, 3, 115, 0, 0, 0,
        99, 66, 5, 4, 35, 42, 161, 0,
        131, 34, 129, 1, 147, 242, 130, 255,
        3, 166, 194, 0, 147, 133, 2, 1,
        3, 37, 65, 1, 147, 8, 0, 4,
        115, 0, 0, 0, 3, 37, 65, 1,
        147, 8, 144, 3, 115, 0, 0, 0,
        19, 5, 16, 1, 131, 32, 193, 1,
        19, 1, 1, 2, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 0, 0,
        147, 5, 64, 0, 131, 32, 193, 1,
        19, 1, 1, 2, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон rt_file_write и ошибки: длина", file_write.machine.code.length, 128)
    @file_write_machine = file_write.machine
    suite = testing.test_equal(suite, "эталон rt_file_write и ошибки: один переход", file_write_machine.patches(), 1)
    drum (128) {
        @file_write_machine_code = file_write.machine.code
        suite = testing.test_equal(suite, "эталон rt_file_write и ошибки: байт {beat}", file_write_machine_code.byte_at(beat), group.get(file_write_bytes, beat))
    }
    file_write_machine = file_write.machine
    @file_write_label = file_write_machine.find_label("rt_platform_file_write")
    file_write_machine = file_write.machine
    @file_error = file_write_machine.find_label(linux.FILE_ERROR)
    suite = testing.test_yes(suite, "эталон rt_file_write: метка существует", file_write_label.present)
    suite = testing.test_equal(suite, "эталон rt_file_write: смещение", file_write_label.offset, 0)
    suite = testing.test_yes(suite, "эталон rt_file_error: метка существует", file_error.present)
    suite = testing.test_equal(suite, "эталон rt_file_error: смещение", file_error.offset, 108)

    @runtime_links = state.State { executor = riscv.Executor {}, machine = layout.Program {} }
    runtime_links = host_calls.emit_newline(runtime_links)
    runtime_links = host_calls.emit_missing_args(runtime_links)
    runtime_links = linux_calls.emit_write(runtime_links)
    runtime_links = linux_calls.emit_exit(runtime_links)
    @runtime_links_machine = runtime_links.machine
    runtime_links_machine.define_label(Layout.Section.CODE, "rt_show")
    runtime_links_machine = runtime_links.machine
    runtime_links_machine.define_label(Layout.Section.RODATA, "rt_newline_text")
    runtime_links_machine = runtime_links.machine
    runtime_links_machine.define_label(Layout.Section.RODATA, "rt_need_text")
    runtime_links_machine = runtime_links.machine
    runtime_links_machine.define_label(Layout.Section.RODATA, "rt_arguments_text")
    runtime_links_machine = runtime_links.machine
    runtime_links_machine.define_label(Layout.Section.BSS, "saltic_out_fd")
    runtime_links.machine = layout.resolve(runtime_links.machine)
    @runtime_link_bytes = [
        23, 21, 0, 0, 19, 5, 5, 0,
        3, 37, 5, 0, 99, 20, 5, 0,
        19, 5, 16, 0, 151, 5, 0, 0,
        147, 133, 69, 8, 19, 6, 16, 0,
        19, 1, 1, 255, 35, 38, 17, 0,
        239, 0, 64, 5, 131, 32, 193, 0,
        19, 1, 1, 1, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 1, 1, 255,
        35, 38, 17, 0, 35, 36, 161, 0,
        23, 5, 0, 0, 19, 5, 5, 5,
        19, 101, 53, 0, 239, 0, 0, 4,
        3, 37, 129, 0, 239, 0, 128, 3,
        23, 5, 0, 0, 19, 5, 133, 3,
        19, 101, 53, 0, 239, 0, 128, 2,
        239, 240, 31, 249, 19, 5, 0, 4,
        111, 0, 64, 1, 147, 8, 0, 4,
        115, 0, 0, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 147, 8, 208, 5,
        115, 0, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон newline и missing args: длина", runtime_links.machine.code.length, 148)
    runtime_links_machine = runtime_links.machine
    suite = testing.test_equal(suite, "эталон newline и missing args: пять переходов", runtime_links_machine.patches(), 15)
    drum (148) {
        @runtime_links_machine_code = runtime_links.machine.code
        suite = testing.test_equal(suite, "эталон newline и missing args: байт {beat}", runtime_links_machine_code.byte_at(beat), group.get(runtime_link_bytes, beat))
    }
    runtime_links_machine = runtime_links.machine
    @newline = runtime_links_machine.find_label("rt_newline")
    runtime_links_machine = runtime_links.machine
    @missing_args = runtime_links_machine.find_label("rt_missing_args")
    runtime_links_machine = runtime_links.machine
    @linked_platform_write = runtime_links_machine.find_label("rt_platform_write")
    runtime_links_machine = runtime_links.machine
    @linked_platform_exit = runtime_links_machine.find_label("rt_platform_exit")
    runtime_links_machine = runtime_links.machine
    @newline_text = runtime_links_machine.find_label("rt_newline_text")
    suite = testing.test_yes(suite, "эталон rt_newline: метка существует", newline.present)
    suite = testing.test_equal(suite, "эталон rt_newline: смещение", newline.offset, 0)
    suite = testing.test_yes(suite, "эталон rt_missing_args: метка существует", missing_args.present)
    suite = testing.test_equal(suite, "эталон rt_missing_args: смещение", missing_args.offset, 60)
    suite = testing.test_yes(suite, "связанный rt_platform_write существует", linked_platform_write.present)
    suite = testing.test_equal(suite, "связанный rt_platform_write: смещение", linked_platform_write.offset, 124)
    suite = testing.test_yes(suite, "связанный rt_platform_exit существует", linked_platform_exit.present)
    suite = testing.test_equal(suite, "связанный rt_platform_exit: смещение", linked_platform_exit.offset, 140)
    suite = testing.test_yes(suite, "связанный rt_newline_text существует", newline_text.present)
    suite = testing.test_equal(suite, "связанный rt_newline_text: смещение в rodata", newline_text.offset, 0)

    @fixed_overflow = state.State { executor = riscv.Executor {}, machine = layout.Program {} }
    fixed_overflow = fixeds.emit_fixed_overflow(fixed_overflow)
    fixed_overflow.machine = layout.resolve(fixed_overflow.machine)
    @fixed_overflow_bytes = [
        19, 5, 0, 0, 147, 5, 96, 0,
        103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон ошибок fixed: длина", fixed_overflow.machine.code.length, 12)
    @fixed_overflow_machine = fixed_overflow.machine
    suite = testing.test_equal(suite, "эталон ошибок fixed: переходов нет", fixed_overflow_machine.patches(), 0)
    drum (12) {
        @fixed_overflow_machine_code = fixed_overflow.machine.code
        suite = testing.test_equal(suite, "эталон ошибок fixed: байт {beat}", fixed_overflow_machine_code.byte_at(beat), group.get(fixed_overflow_bytes, beat))
    }
    fixed_overflow_machine = fixed_overflow.machine
    @fixed_overflow_label = fixed_overflow_machine.find_label("rt_fixed_overflow")
    suite = testing.test_yes(suite, "эталон rt_fixed_overflow: метка существует", fixed_overflow_label.present)
    suite = testing.test_equal(suite, "эталон rt_fixed_overflow: смещение", fixed_overflow_label.offset, 0)

    @fixed_comparison = state.State { executor = riscv.Executor {}, machine = layout.Program {} }
    fixed_comparison = fixeds.emit_fixed_equal(fixed_comparison)
    fixed_comparison = fixeds.emit_fixed_less(fixed_comparison)
    fixed_comparison = fixeds.emit_fixed_greater(fixed_comparison)
    fixed_comparison = numerals.emit_equal(fixed_comparison)
    fixed_comparison.machine = layout.resolve(fixed_comparison.machine)
    @fixed_comparison_bytes = [
        99, 12, 181, 10, 111, 0, 0, 12,
        19, 14, 64, 0, 99, 6, 200, 1,
        99, 100, 181, 10, 111, 0, 0, 11,
        99, 64, 181, 10, 111, 0, 128, 10,
        19, 6, 5, 0, 19, 133, 5, 0,
        147, 5, 6, 0, 111, 240, 223, 253,
        99, 4, 181, 8, 147, 114, 117, 0,
        19, 243, 117, 0, 99, 148, 98, 8,
        147, 3, 80, 0, 99, 154, 114, 2,
        19, 117, 133, 255, 147, 245, 133, 255,
        3, 46, 133, 0, 147, 126, 30, 0,
        99, 132, 14, 0, 19, 117, 142, 255,
        3, 174, 133, 0, 147, 126, 30, 0,
        99, 132, 14, 0, 147, 117, 142, 255,
        99, 4, 181, 4, 111, 0, 0, 5,
        147, 3, 48, 0, 99, 148, 114, 4,
        19, 117, 133, 255, 147, 245, 133, 255,
        131, 34, 197, 0, 3, 163, 197, 0,
        99, 154, 98, 2, 147, 3, 0, 0,
        99, 128, 83, 2, 51, 14, 117, 0,
        179, 142, 117, 0, 3, 78, 14, 1,
        131, 206, 14, 1, 99, 28, 222, 1,
        147, 131, 19, 0, 111, 240, 95, 254,
        19, 5, 144, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 16, 0,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "эталон сравнений fixed: длина", fixed_comparison.machine.code.length, 208)
    @fixed_comparison_machine = fixed_comparison.machine
    suite = testing.test_equal(suite, "эталон сравнений fixed: двадцать переходов", fixed_comparison_machine.patches(), 20)
    drum (208) {
        @fixed_comparison_machine_code = fixed_comparison.machine.code
        suite = testing.test_equal(suite, "эталон сравнений fixed: байт {beat}", fixed_comparison_machine_code.byte_at(beat), group.get(fixed_comparison_bytes, beat))
    }
    fixed_comparison_machine = fixed_comparison.machine
    @fixed_equal = fixed_comparison_machine.find_label("rt_fixed_equal")
    fixed_comparison_machine = fixed_comparison.machine
    @fixed_less = fixed_comparison_machine.find_label("rt_fixed_less")
    fixed_comparison_machine = fixed_comparison.machine
    @fixed_less_signed = fixed_comparison_machine.find_label(".L_fixed_less_signed")
    fixed_comparison_machine = fixed_comparison.machine
    @fixed_greater = fixed_comparison_machine.find_label("rt_fixed_greater")
    fixed_comparison_machine = fixed_comparison.machine
    @linked_equal = fixed_comparison_machine.find_label("rt_equal")
    fixed_comparison_machine = fixed_comparison.machine
    @linked_equal_string = fixed_comparison_machine.find_label(".L_equal_string")
    fixed_comparison_machine = fixed_comparison.machine
    @linked_equal_yes = fixed_comparison_machine.find_label(".L_equal_yes")
    fixed_comparison_machine = fixed_comparison.machine
    @linked_equal_no = fixed_comparison_machine.find_label(".L_equal_no")
    suite = testing.test_yes(suite, "эталон rt_fixed_equal: метка существует", fixed_equal.present)
    suite = testing.test_equal(suite, "эталон rt_fixed_equal: смещение", fixed_equal.offset, 0)
    suite = testing.test_yes(suite, "эталон rt_fixed_less: метка существует", fixed_less.present)
    suite = testing.test_equal(suite, "эталон rt_fixed_less: смещение", fixed_less.offset, 8)
    suite = testing.test_yes(suite, "эталон rt_fixed_less: signed существует", fixed_less_signed.present)
    suite = testing.test_equal(suite, "эталон rt_fixed_less: смещение signed", fixed_less_signed.offset, 24)
    suite = testing.test_yes(suite, "эталон rt_fixed_greater: метка существует", fixed_greater.present)
    suite = testing.test_equal(suite, "эталон rt_fixed_greater: смещение", fixed_greater.offset, 32)
    suite = testing.test_yes(suite, "связанный rt_equal существует", linked_equal.present)
    suite = testing.test_equal(suite, "связанный rt_equal: смещение", linked_equal.offset, 48)
    suite = testing.test_yes(suite, "связанный строковый цикл equal существует", linked_equal_string.present)
    suite = testing.test_equal(suite, "связанный строковый цикл equal: смещение", linked_equal_string.offset, 152)
    suite = testing.test_yes(suite, "связанная ветка equal yes существует", linked_equal_yes.present)
    suite = testing.test_equal(suite, "связанная ветка equal yes: смещение", linked_equal_yes.offset, 184)
    suite = testing.test_yes(suite, "связанная ветка equal no существует", linked_equal_no.present)
    suite = testing.test_equal(suite, "связанная ветка equal no: смещение", linked_equal_no.offset, 196)

    out suite
}
