-- patches test — исправления меток в rv32i: branch вперёд и назад, jump,
-- relative / absolute address с переносом, слово адреса в data.
--
-- word_is(bytes, offset, b0, b1, b2, b3) -> yes/no
-- fixture() -> разрешённая цель с четырьмя метками и восемью исправлениями
-- far_fixture() -> дальний условный переход (far_calls): bne на +12, auipc t6, jalr x0
-- run(suite) -> suite

use craft.testing
use compiler.gorn.backend.riscv.instruction
use compiler.gorn.backend.layout
use compiler.gorn.backend.buffer
use compiler.gorn.backend.riscv.emit

skill word_is(bytes, offset, b0, b1, b2, b3) {
    @first = (bytes.byte_at(offset) == b0) ○ (bytes.byte_at(offset + 1) == b1)
    @second = (bytes.byte_at(offset + 2) == b2) ○ (bytes.byte_at(offset + 3) == b3)
    out first ○ second
}

skill fixture() {
    @writer = emit.Emit {}
    @target = layout.host("_start")
    target.define_label(Layout.Section.CODE, "_start")
    writer.branch(target, Instruction.Kind.BEQ, 1, 2, "forward")
    writer.op(target, Instruction.Kind.ADDI, 0, 0, 0, 0)
    target.define_label(Layout.Section.CODE, "forward")
    writer.branch(target, Instruction.Kind.BNE, 3, 4, "_start")
    writer.jal(target, 5, "jump_target")
    writer.op(target, Instruction.Kind.ADDI, 0, 0, 0, 0)
    target.define_label(Layout.Section.CODE, "jump_target")
    writer.relative_address(target, 6, "target", 0)
    writer.absolute_address(target, 7, "target", 0)
    @target_code = target.code
    target_code.append_zeroes(2034)
    target.define_label(Layout.Section.CODE, "target")
    target.append_label_address(Layout.Section.DATA, "target", 0)
    out layout.resolve(target)
}

skill far_fixture() {
    @writer = emit.Emit {}
    @target = layout.host("_start")
    target.far_calls = yes
    target.define_label(Layout.Section.CODE, "_start")
    writer.branch(target, Instruction.Kind.BEQ, 1, 2, "far")
    target.define_label(Layout.Section.CODE, "far")
    out layout.resolve(target)
}

skill run(suite) {
    @target = fixture()
    suite = testing.test_equal(suite, "patches: четыре метки сохранены", target.label_count, 4)
    suite = testing.test_equal(suite, "patches: восемь исправлений сохранены", target.patches(), 8)
    suite = testing.test_yes(suite, "patch branch: положительное смещение", word_is(target.code, 0, 99, 132, 32, 0))
    suite = testing.test_yes(suite, "patch branch: отрицательное смещение", word_is(target.code, 8, 227, 156, 65, 254))
    suite = testing.test_yes(suite, "patch jump", word_is(target.code, 12, 239, 2, 128, 0))
    suite = testing.test_yes(suite, "patch relative high: перенос low", word_is(target.code, 20, 23, 19, 0, 0))
    suite = testing.test_yes(suite, "patch relative low: отрицательный остаток", word_is(target.code, 24, 19, 3, 35, 128))
    suite = testing.test_yes(suite, "patch absolute high: перенос low", word_is(target.code, 28, 183, 19, 1, 0))
    suite = testing.test_yes(suite, "patch absolute low: отрицательный остаток", word_is(target.code, 32, 147, 131, 99, 129))
    suite = testing.test_yes(suite, "patch address word", word_is(target.data, 0, 22, 8, 1, 0))
    @far = far_fixture()
    suite = testing.test_equal(suite, "patch far branch: три команды", far.code.length, 12)
    suite = testing.test_yes(suite, "patch far branch: обратное условие на +12", word_is(far.code, 0, 99, 150, 32, 0))
    suite = testing.test_yes(suite, "patch far branch: auipc t6", word_is(far.code, 4, 151, 15, 0, 0))
    suite = testing.test_yes(suite, "patch far branch: jalr x0, t6, +8", word_is(far.code, 8, 103, 128, 143, 0))
    out suite
}
