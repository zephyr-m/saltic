-- assembly — контракт сборки: каталог intrinsic (все 48 операций известны,
-- типизированы, исполнимы), фантомных операций нет, AST (место, модуль, части
-- пути, имена), архитектор (gather по use) и чекер (фантомная операция,
-- тип памяти).
--
-- Assembly = Box {}:
--     prove(suite) -> suite — все проверки сборки
--     catalog(suite), phantoms(suite), tree(suite), stages(suite) -> suite

use core.str
use core.group
use compiler.nodes
use compiler.contract.intrinsic
use compiler.contract.intrinsic.contract
use compiler.parser
use compiler.architect
use compiler.checker
use craft.testing

Assembly = Box {
    contract_ops = contract.Contract {},
    node_ops = nodes.Nodes {}

    skill prove(suite) {
        suite = catalog(suite)
        suite = phantoms(suite)
        suite = tree(suite)
        out stages(suite)
    }

    skill catalog(suite) {
        @names = [
            "core.group.count", "core.group.get", "core.group.add", "core.group.replaced",
            "core.mem.load8", "core.mem.load16", "core.mem.load32",
            "core.mem.store8", "core.mem.store16", "core.mem.store32",
            "core.cpu.wait", "core.cpu.fence",
            "core.str.line_count", "core.str.concat", "core.str.bytes",
            "core.str.get", "core.str.byte", "core.str.slice", "core.str.contains",
            "core.str.starts_with", "core.str.ends_with", "core.str.lower", "core.str.upper",
            "core.num.text", "io.show", "io.key", "io.clear",
            "io.file.read", "io.file.write", "io.file.write_bytes",
            "core.u8.from", "core.u16.from", "core.u32.from", "core.i32.from", "core.usize.from",
            "core.bits32.and", "core.bits32.or", "core.bits32.xor", "core.bits32.invert",
            "core.bits32.shift_left", "core.bits32.shift_right", "core.address.add",
            "core.bytes.new", "core.bytes.count", "core.bytes.get", "core.bytes.set",
            "core.bytes.slice", "io.file.read_bytes"
        ]
        @known = yes
        @typed = yes
        @runnable = yes
        @count = group.count(names)
        drum (names) {
            @kind = contract_ops.find(beat)
            (kind == intrinsic.Kind.UNKNOWN) { known = no }
            (contract_ops.result_for(kind, "number") == "unknown") { typed = no }
            @input = "number"
            (contract_ops.is_memory(kind) == yes) { input = "address" }
            @target = contract_ops.target_for(kind, input)
            @special = contract_ops.conversion(kind)
            (contract_ops.is_show(kind) == yes) { special = "show" }
            (str.bytes(target) == 0) {
                (str.bytes(special) == 0) { runnable = no }
            }
        }
        suite = testing.test_equal(suite, "seed: количество операций", count, 48)
        suite = testing.test_yes(suite, "seed: все операции известны", known)
        suite = testing.test_yes(suite, "seed: все результаты определены", typed)
        suite = testing.test_yes(suite, "seed: все операции исполнимы", runnable)
        out suite
    }

    skill phantoms(suite) {
        @names = [
            "core.str.eq", "core.str.is_empty", "core.str.trim", "core.str.split",
            "core.num.parse", "core.num.abs", "core.num.min", "core.num.max", "core.num.round",
            "core.group.at", "core.group.item", "core.group.append", "core.str.at", "core.str.join"
        ]
        @absent = yes
        @index = 0
        @count = group.count(names)
        drum (count) {
            (index < count) {
                (contract_ops.is_known(group.get(names, index)) == yes) { absent = no }
                index = index + 1
            }
        }
        suite = testing.test_yes(suite, "seed: фантомные операции отсутствуют", absent)
        out suite
    }

    skill tree(suite) {
        @path = node_ops.in_module("demo", node_ops.with_location(["path", "tool", "run"], 12, 34))
        @place = node_ops.location(path)
        suite = testing.test_equal(suite, "AST: имя модуля", node_ops.module_name(path), "demo")
        suite = testing.test_equal(suite, "AST: строка", group.get(place, 0), 12)
        suite = testing.test_equal(suite, "AST: колонка", group.get(place, 1), 34)
        suite = testing.test_equal(suite, "AST: тег узла", node_ops.tag(path), "path")
        suite = testing.test_equal(suite, "AST: часть узла", node_ops.part(path, 2), "run")
        suite = testing.test_equal(suite, "AST: полный путь", node_ops.path_text(path), "tool.run")
        suite = testing.test_equal(suite, "AST: префикс пути", node_ops.path_prefix(path), "tool")
        suite = testing.test_equal(suite, "AST: полное имя", node_ops.qualified("demo", "Skill"), "demo.Skill")
        suite = testing.test_equal(suite, "AST: ключ псевдонима", node_ops.alias_key("demo", "tool"), "demo|tool")
        suite = testing.test_equal(suite, "AST: голова имени", node_ops.name_head("tool.run"), "tool")
        suite = testing.test_equal(suite, "AST: хвост имени", node_ops.name_tail("tool.run"), ".run")
        suite = testing.test_equal(suite, "AST: модуль имени", node_ops.name_module("demo.tool.run"), "demo.tool")
        out suite
    }

    skill stages(suite) {
        @marking = Parser {
            locations = yes
        }
        @phantom_source = "use core.str\nprogram() \{\n    str.trim(\"text\")\n    out none\n\}\n"
        @phantom_ast = marking.parse_text(phantom_source, "phantom.case")
        @inspector = Checker {}
        @phantom_checked = inspector.check(phantom_ast.ast)
        suite = testing.test_equal(suite, "чекер: одна фантомная операция", group.count(phantom_checked.diagnostics), 1)
        @phantom = group.get(phantom_checked.diagnostics, 0)
        suite = testing.test_equal(suite, "чекер: код фантомной операции", phantom.code, "unknown_name")
        @plan = Architect {
            locations = yes
        }
        @loaded_file = plan.gather("tests/fixtures/modules/main.saltic")
        suite = testing.test_equal(suite, "архитектор: gather без ошибок", group.count(loaded_file.diagnostics), 0)
        suite = testing.test_equal(suite, "архитектор: только реальные файлы", group.count(loaded_file.included), 9)
        @memory_loaded = plan.gather("tests/fixtures/memory-type.saltic")
        @memory_checked = inspector.check(memory_loaded.ast)
        suite = testing.test_equal(suite, "чекер: одна ошибка типа памяти", group.count(memory_checked.diagnostics), 1)
        @memory_error = group.get(memory_checked.diagnostics, 0)
        suite = testing.test_equal(suite, "чекер: тип load8 согласован", memory_error.code, "variable_type_mismatch")
        out suite
    }
}
