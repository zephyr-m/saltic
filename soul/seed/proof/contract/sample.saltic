-- sample — пробный разбор для контракта: кусок исходника как отдельный файл.
-- Сколько ошибок даст разбор и какие коды скажет чекер — общий инструмент
-- детей контракта (counting, flow).
--
-- Sample = Box {}:
--     faults(source) -> число ошибок разбора
--     verdicts(source) -> коды диагностик чекера подряд одной строкой

use core.str
use core.group
use compiler.parser
use compiler.checker

Sample = Box {
    skill faults(source) {
        @marking = Parser {
            locations = yes
        }
        @parsed = marking.parse_text(source, "negative.case")
        out group.count(parsed.diagnostics)
    }

    skill verdicts(source) {
        @marking = Parser {
            locations = yes
        }
        @parsed = marking.parse_text(source, "template.case")
        @inspector = Checker {}
        @checked = inspector.check(parsed.ast)
        @codes = ""
        drum (group.count(checked.diagnostics)) {
            @item = group.get(checked.diagnostics, beat)
            codes = str.concat(codes, item.code)
        }
        out codes
    }
}
