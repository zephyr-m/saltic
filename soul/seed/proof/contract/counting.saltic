-- counting — контракт счёта: переполнение (max, min, half), отрицательные
-- литералы и минус перед выражением, целое деление со знаком и на ноль.
--
-- Counting = Box { sample } — пробный разбор:
--     prove(suite) -> suite — все проверки счёта
--     overflow(suite), negatives(suite), division(suite) -> suite
--     added(a, b), subtracted(a, b), multiplied(a, b), divided(a, b) —
--         результат или ошибка значением; maximum() — наибольшее целое;
--         quotient(left, right) -> left / right

use core.group
use craft.testing
use proof.contract.sample

Counting = Box {
    sample = Sample {}

    skill prove(suite) {
        suite = overflow(suite)
        suite = negatives(suite)
        out division(suite)
    }

    skill added(a, b) {
        @r = a + b rescue |err| { err }
        out r
    }

    skill subtracted(a, b) {
        @r = a - b rescue |err| { err }
        out r
    }

    skill multiplied(a, b) {
        @r = a * b rescue |err| { err }
        out r
    }

    skill divided(a, b) {
        @r = a / b rescue |err| { err }
        out r
    }

    skill maximum() {
        @top = 1
        always {
            @next = top * 2 rescue |err| {
                out top - 1 + top
            }
            top = next
        }
    }

    skill quotient(left, right) {
        out left / right
    }

    skill overflow(suite) {
        @max = maximum()
        @min = -max - 1
        @half = max / 2 + 1
        suite = testing.test_yes(suite, "переполнение: max + 1", (added(max, 1) == error.NumberOverflow))
        suite = testing.test_equal(suite, "переполнение: max + 0 в пределах", added(max, 0), max)
        suite = testing.test_yes(suite, "переполнение: min - 1", (subtracted(min, 1) == error.NumberOverflow))
        suite = testing.test_yes(suite, "переполнение: 0 - min", (subtracted(0, min) == error.NumberOverflow))
        suite = testing.test_equal(suite, "переполнение: min + max в пределах", added(min, max), -1)
        suite = testing.test_yes(suite, "переполнение: max * 2", (multiplied(max, 2) == error.NumberOverflow))
        suite = testing.test_yes(suite, "переполнение: max * max", (multiplied(max, max) == error.NumberOverflow))
        suite = testing.test_yes(suite, "переполнение: half * 2", (multiplied(half, 2) == error.NumberOverflow))
        suite = testing.test_equal(suite, "переполнение: half * -2 ровно min", multiplied(half, -2), min)
        suite = testing.test_yes(suite, "переполнение: min * -1", (multiplied(min, -1) == error.NumberOverflow))
        suite = testing.test_equal(suite, "переполнение: min * 1 в пределах", multiplied(min, 1), min)
        suite = testing.test_equal(suite, "переполнение: -7 * 6", multiplied(-7, 6), -42)
        suite = testing.test_yes(suite, "переполнение: min / -1", (divided(min, -1) == error.NumberOverflow))
        suite = testing.test_equal(suite, "переполнение: min / 1 в пределах", divided(min, 1), min)
        out suite
    }

    skill negatives(suite) {
        suite = testing.test_equal(suite, "минус: литерал равен 0 - N", -5, 0 - 5)
        @five = 5
        suite = testing.test_equal(suite, "минус: -x у имени", -five, -5)
        suite = testing.test_equal(suite, "минус: -(a + b)", -(five + 1), -6)
        suite = testing.test_equal(suite, "минус: -вызов", -group.count([1, 2]), -2)
        suite = testing.test_equal(suite, "минус: вычитание отрицательного", 3 - -2, 5)
        suite = testing.test_equal(suite, "минус: умножение на отрицательный", 2 * -3, -6)
        suite = testing.test_equal(suite, "минус: слитный бинарный минус", 7 -2, 5)
        suite = testing.test_equal(suite, "минус: в группе", group.get([1, -2], 1), -2)
        suite = testing.test_equal(suite, "минус: аргумент навыка", quotient(-9, -4), 2)
        suite = testing.test_equal(suite, "минус: граница обычного числа", -268435455 + 268435455, 0)
        suite = testing.test_equal(suite, "минус: литерал разбирается", sample.faults("program() \{\n    @x = -5\n    out none\n\}\n"), 0)
        suite = testing.test_equal(suite, "минус: отдельный от цифры — тоже -x", sample.faults("program() \{\n    @x = - 5\n    out none\n\}\n"), 0)
        suite = testing.test_equal(suite, "минус: перед именем — -x (Q-025)", sample.faults("program() \{\n    @y = 1\n    @x = -y\n    out none\n\}\n"), 0)
        out suite
    }

    skill division(suite) {
        suite = testing.test_equal(suite, "деление: степень двойки", quotient(100000, 256), 390)
        suite = testing.test_equal(suite, "деление: на единицу", quotient(268435455, 1), 268435455)
        suite = testing.test_equal(suite, "деление: общее", quotient(1000000, 3), 333333)
        suite = testing.test_equal(suite, "деление: большое на большое", quotient(268435455, 268435455), 1)
        suite = testing.test_equal(suite, "деление: меньшее на большее", quotient(5, 7), 0)
        suite = testing.test_equal(suite, "деление: отрицательное делимое", quotient(-7, 2), -3)
        suite = testing.test_equal(suite, "деление: отрицательный делитель", quotient(7, -2), -3)
        suite = testing.test_equal(suite, "деление: оба отрицательные", quotient(-9, -4), 2)
        suite = testing.test_equal(suite, "деление: отрицательное на степень двойки", quotient(-1000, 8), -125)
        suite = testing.test_equal(suite, "деление: остаток", 1000003 - quotient(1000003, 1000) * 1000, 3)
        @failed = quotient(1, 0) rescue |err| { "ошибка" }
        suite = testing.test_equal(suite, "деление: на ноль", failed, "ошибка")
        out suite
    }
}
