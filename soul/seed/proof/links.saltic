-- links test — звенья ○ (и) и ○○ (или) на деле (решение автора 21.11.2026):
-- таблицы истинности, цепочки, скобки внутри скобок, короткий счёт — правое
-- звено не считается, если левое уже решило (побочное действие в Box и вызов,
-- который упал бы на пустой группе), звенья в условии и в цикле. Гоняет
-- tests/run/main.saltic (links) на rv32i, x86-64, rv64 и arm64.
--
-- Meter { calls } — считает, сколько раз его спросили; touch(answer) ->
--     answer, calls + 1
-- tables / chains / shortcuts / places(suite) -> Testing
-- program() -> none; TestsFailed, если есть провалы

use core.group
use craft.testing

Meter = Box {
    calls = 0

    skill touch(answer) {
        calls = calls + 1
        out answer
    }
}

skill tables(suite) {
    suite = testing.test_yes(suite, "yes ○ yes", yes ○ yes)
    suite = testing.test_no(suite, "yes ○ no", yes ○ no)
    suite = testing.test_no(suite, "no ○ yes", no ○ yes)
    suite = testing.test_no(suite, "no ○ no", no ○ no)
    suite = testing.test_yes(suite, "yes ○○ yes", yes ○○ yes)
    suite = testing.test_yes(suite, "yes ○○ no", yes ○○ no)
    suite = testing.test_yes(suite, "no ○○ yes", no ○○ yes)
    suite = testing.test_no(suite, "no ○○ no", no ○○ no)
    @shown = yes ○ no
    suite = testing.test_equal(suite, "ответ звена — настоящий no", "{shown}", "no")
    out suite
}

skill chains(suite) {
    suite = testing.test_no(suite, "цепь ○: одно звено no — вся no", yes ○ yes ○ no)
    suite = testing.test_yes(suite, "цепь ○: все yes — yes", yes ○ yes ○ yes)
    suite = testing.test_yes(suite, "цепь ○○: хватит одного yes", no ○○ no ○○ yes)
    suite = testing.test_no(suite, "цепь ○○: все no — no", no ○○ no ○○ no)
    @mixed = ((yes ○ no) ○○ (no ○○ yes)) ○ yes
    suite = testing.test_yes(suite, "скобки решают порядок", mixed)
    @code = 52
    @digit = (code >= 48) ○ (code <= 57)
    @upper = (code >= 65) ○ (code <= 90)
    suite = testing.test_yes(suite, "сравнения в своих скобках", (code == 95) ○○ digit ○○ upper)
    out suite
}

skill shortcuts(suite) {
    @meter = Meter {}
    @first = no ○ meter.touch(yes)
    suite = testing.test_equal(suite, "no ○ … — правое не спрошено", meter.calls, 0)
    @second = yes ○○ meter.touch(no)
    suite = testing.test_equal(suite, "yes ○○ … — правое не спрошено", meter.calls, 0)
    @third = yes ○ meter.touch(yes)
    suite = testing.test_equal(suite, "yes ○ … — правое спрошено", meter.calls, 1)
    @fourth = no ○○ meter.touch(yes)
    suite = testing.test_equal(suite, "no ○○ … — правое спрошено", meter.calls, 2)
    suite = testing.test_yes(suite, "ответ правого звена", third ○ fourth)
    suite = testing.test_no(suite, "no ○ … — ответ no от левого", first)
    suite = testing.test_yes(suite, "yes ○○ … — ответ yes от левого", second)
    @empty = []
    @guarded = (group.count(empty) > 0) ○ (group.get(empty, 0) == 1)
    suite = testing.test_no(suite, "звено бережёт от GroupBounds", guarded)
    @rescued = (group.count(empty) == 0) ○○ (group.get(empty, 0) == 1)
    suite = testing.test_yes(suite, "○○ бережёт так же", rescued)
    out suite
}

skill places(suite) {
    @a = 3
    @hit = no
    ((a > 1) ○ (a < 5)) {
        hit = yes
    }
    suite = testing.test_yes(suite, "звенья в условии", hit)
    @missed = no
    ((a > 4) ○○ (a < 0)) {
        missed = yes
    }
    suite = testing.test_no(suite, "условие на ○○ не сработало зря", missed)
    @found = 0
    drum (10) {
        @number = beat + 1
        ((number % 2 == 0) ○ (number > 4)) {
            found = found + 1
        }
    }
    suite = testing.test_equal(suite, "звенья в цикле: 6, 8, 10", found, 3)
    out suite
}

program() {
    @suite = testing.test_new()
    suite = tables(suite)
    suite = chains(suite)
    suite = shortcuts(suite)
    suite = places(suite)
    out testing.test_finish(suite)
}
