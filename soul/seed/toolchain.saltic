use seed
use seed.parser
use seed.checker
use seed.compiler
use seed.machine.codec
use seed.machine.image
use seed.compiler.backend.x86_64

skill toolchain_show_diagnostics(diagnostics) {
    @index = 0
    @count = seed.group.count(diagnostics)
    drum (count) {
        @item = seed.group.item(diagnostics, index)
        seed.io.show(item.code, "|", item.line, "|", item.col, "|", item.message)
        index = index + 1
    }
    out none
}

skill write_native(ast, heap_size, output_path) {
    @machine = compiler.compile_machine_with_heap(ast, heap_size)
    seed.io.show("toolchain: перевожу в x86-64 ", output_path)
    x86_64.write(output_path, machine) rescue |failure| {
        seed.io.show("toolchain: код больше 1 МБ, собираю с дальними вызовами")
        @far = compiler.compile_machine_far_with_heap(ast, heap_size, no)
        x86_64.write(output_path, far) rescue |again| { out error.WriteFailed }
        out none
    }
    out none
}

program(source_path, output_path, heap_text, target) {
    seed.io.show("toolchain: читаю ", source_path)
    @loaded = parser.load_modules(source_path, ".")
    (seed.group.count(loaded.diagnostics) > 0) {
        toolchain_show_diagnostics(loaded.diagnostics)
        out error.ParseFailed
    }

    seed.io.show("toolchain: проверяю")
    @checked = checker.check(loaded.ast)
    (seed.group.count(checked.diagnostics) > 0) {
        toolchain_show_diagnostics(checked.diagnostics)
        out error.CheckFailed
    }

    (seed.str.starts_with(heap_text, "-") == yes) { out error.ValueOutsideRange }
    @heap_size = codec.word_from_decimal(heap_text)
    seed.io.show("toolchain: собираю")
    (target == "x86_64") { out write_native(loaded.ast, heap_size, output_path) }
    ((target == "rv32i") == no) { out error.UnknownTarget }
    @machine = compiler.compile_machine_with_heap(loaded.ast, heap_size)
    seed.io.show("toolchain: пишу ", output_path)
    image.write(output_path, machine) rescue |failure| {
        seed.io.show("toolchain: код больше 1 МБ, собираю с дальними вызовами")
        @far = compiler.compile_machine_far_with_heap(loaded.ast, heap_size, no)
        image.write(output_path, far) rescue |again| { out error.WriteFailed }
        out none
    }
    out none
}
