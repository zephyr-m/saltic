use seed
use seed.parser
use seed.checker
use seed.compiler

skill toolchain_show_diagnostics(diagnostics) {
    @index = 0
    @count = seed.group.count(diagnostics)
    drum (count) {
        @item = seed.group.item(diagnostics, index)
        seed.io.show(item.code, "|", item.line, "|", item.col, "|", item.message)
        index = index + 1
    }
    out none
}

program(source_path, assembly_path) {
    @loaded = parser.load_modules(source_path, ".")
    (seed.group.count(loaded.diagnostics) > 0) {
        toolchain_show_diagnostics(loaded.diagnostics)
        out error.ParseFailed
    }

    @checked = checker.check(loaded.ast)
    (seed.group.count(checked.diagnostics) > 0) {
        toolchain_show_diagnostics(checked.diagnostics)
        out error.CheckFailed
    }

    @assembly = compiler.compile(loaded.ast)
    seed.file.write(assembly_path, assembly)
    out none
}
