Kind = enum {
    UNKNOWN,
    GROUP_COUNT, GROUP_AT, GROUP_ITEM, GROUP_ADD, GROUP_APPEND,
    MEM_LOAD8, MEM_LOAD16, MEM_LOAD32,
    MEM_STORE8, MEM_STORE16, MEM_STORE32, MEM_STORE_ADDRESS32,
    CPU_WAIT, CPU_FENCE,
    FILE_READ, FILE_WRITE, FILE_WRITE_BYTES,
    STR_LINE_COUNT, STR_ADD, STR_JOIN, STR_LEN, STR_AT, STR_BYTE, STR_SLICE,
    STR_CONTAINS, STR_STARTS_WITH, STR_ENDS_WITH, STR_LOWER, STR_UPPER,
    NUM_TEXT, IO_SHOW,
    U8_FROM, U16_FROM, U32_FROM, I32_FROM, USIZE_FROM,
    BITS32_AND, BITS32_OR, BITS32_XOR, BITS32_NOT,
    BITS32_SHIFT_LEFT, BITS32_SHIFT_RIGHT,
    ADDRESS_ADD,
}

skill find(name) {
    (name == "seed.group.count") { out Kind.GROUP_COUNT }
    (name == "seed.group.at") { out Kind.GROUP_AT }
    (name == "seed.group.item") { out Kind.GROUP_ITEM }
    (name == "seed.group.add") { out Kind.GROUP_ADD }
    (name == "seed.group.append") { out Kind.GROUP_APPEND }
    (name == "seed.mem.load8") { out Kind.MEM_LOAD8 }
    (name == "seed.mem.load16") { out Kind.MEM_LOAD16 }
    (name == "seed.mem.load32") { out Kind.MEM_LOAD32 }
    (name == "seed.mem.store8") { out Kind.MEM_STORE8 }
    (name == "seed.mem.store16") { out Kind.MEM_STORE16 }
    (name == "seed.mem.store32") { out Kind.MEM_STORE32 }
    (name == "seed.mem.store_address32") { out Kind.MEM_STORE_ADDRESS32 }
    (name == "seed.cpu.wait") { out Kind.CPU_WAIT }
    (name == "seed.cpu.fence") { out Kind.CPU_FENCE }
    (name == "seed.file.read") { out Kind.FILE_READ }
    (name == "seed.file.write") { out Kind.FILE_WRITE }
    (name == "seed.file.write_bytes") { out Kind.FILE_WRITE_BYTES }
    (name == "seed.str.line_count") { out Kind.STR_LINE_COUNT }
    (name == "seed.str.add") { out Kind.STR_ADD }
    (name == "seed.str.join") { out Kind.STR_JOIN }
    (name == "seed.str.len") { out Kind.STR_LEN }
    (name == "seed.str.at") { out Kind.STR_AT }
    (name == "seed.str.byte") { out Kind.STR_BYTE }
    (name == "seed.str.slice") { out Kind.STR_SLICE }
    (name == "seed.str.contains") { out Kind.STR_CONTAINS }
    (name == "seed.str.starts_with") { out Kind.STR_STARTS_WITH }
    (name == "seed.str.ends_with") { out Kind.STR_ENDS_WITH }
    (name == "seed.str.lower") { out Kind.STR_LOWER }
    (name == "seed.str.upper") { out Kind.STR_UPPER }
    (name == "seed.num.text") { out Kind.NUM_TEXT }
    (name == "seed.io.show") { out Kind.IO_SHOW }
    (name == "seed.u8.from") { out Kind.U8_FROM }
    (name == "seed.u16.from") { out Kind.U16_FROM }
    (name == "seed.u32.from") { out Kind.U32_FROM }
    (name == "seed.i32.from") { out Kind.I32_FROM }
    (name == "seed.usize.from") { out Kind.USIZE_FROM }
    (name == "seed.bits32.and") { out Kind.BITS32_AND }
    (name == "seed.bits32.or") { out Kind.BITS32_OR }
    (name == "seed.bits32.xor") { out Kind.BITS32_XOR }
    (name == "seed.bits32.not") { out Kind.BITS32_NOT }
    (name == "seed.bits32.shift_left") { out Kind.BITS32_SHIFT_LEFT }
    (name == "seed.bits32.shift_right") { out Kind.BITS32_SHIFT_RIGHT }
    (name == "seed.address.add") { out Kind.ADDRESS_ADD }
    out Kind.UNKNOWN
}

skill result(kind) {
    (kind == Kind.GROUP_COUNT) { out "number" }
    (kind == Kind.GROUP_AT) { out "group-item" }
    (kind == Kind.GROUP_ITEM) { out "group-item" }
    (kind == Kind.GROUP_ADD) { out "group-add" }
    (kind == Kind.GROUP_APPEND) { out "group-add" }
    (kind == Kind.MEM_LOAD8) { out "memory-load" }
    (kind == Kind.MEM_LOAD16) { out "memory-load" }
    (kind == Kind.MEM_LOAD32) { out "memory-load" }
    (kind == Kind.MEM_STORE8) { out "none" }
    (kind == Kind.MEM_STORE16) { out "none" }
    (kind == Kind.MEM_STORE32) { out "none" }
    (kind == Kind.MEM_STORE_ADDRESS32) { out "none" }
    (kind == Kind.CPU_WAIT) { out "none" }
    (kind == Kind.CPU_FENCE) { out "none" }
    (kind == Kind.FILE_READ) { out "string" }
    (kind == Kind.FILE_WRITE) { out "none" }
    (kind == Kind.FILE_WRITE_BYTES) { out "none" }
    (kind == Kind.STR_LINE_COUNT) { out "number" }
    (kind == Kind.STR_ADD) { out "string" }
    (kind == Kind.STR_JOIN) { out "string" }
    (kind == Kind.STR_LEN) { out "number" }
    (kind == Kind.STR_AT) { out "string" }
    (kind == Kind.STR_BYTE) { out "number" }
    (kind == Kind.STR_SLICE) { out "string" }
    (kind == Kind.STR_CONTAINS) { out "answer" }
    (kind == Kind.STR_STARTS_WITH) { out "answer" }
    (kind == Kind.STR_ENDS_WITH) { out "answer" }
    (kind == Kind.STR_LOWER) { out "string" }
    (kind == Kind.STR_UPPER) { out "string" }
    (kind == Kind.NUM_TEXT) { out "string" }
    (kind == Kind.IO_SHOW) { out "none" }
    (kind == Kind.U8_FROM) { out "u8" }
    (kind == Kind.U16_FROM) { out "u16" }
    (kind == Kind.U32_FROM) { out "u32" }
    (kind == Kind.I32_FROM) { out "i32" }
    (kind == Kind.USIZE_FROM) { out "usize" }
    (kind == Kind.BITS32_AND) { out "bits32" }
    (kind == Kind.BITS32_OR) { out "bits32" }
    (kind == Kind.BITS32_XOR) { out "bits32" }
    (kind == Kind.BITS32_NOT) { out "bits32" }
    (kind == Kind.BITS32_SHIFT_LEFT) { out "bits32" }
    (kind == Kind.BITS32_SHIFT_RIGHT) { out "bits32" }
    (kind == Kind.ADDRESS_ADD) { out "address" }
    out "unknown"
}

skill target(kind) {
    (kind == Kind.GROUP_COUNT) { out "rt_group_count" }
    (kind == Kind.GROUP_AT) { out "rt_group_at" }
    (kind == Kind.GROUP_ITEM) { out "rt_group_at" }
    (kind == Kind.GROUP_ADD) { out "rt_group_add" }
    (kind == Kind.GROUP_APPEND) { out "rt_group_add" }
    (kind == Kind.CPU_WAIT) { out "rt_cpu_wait" }
    (kind == Kind.CPU_FENCE) { out "rt_cpu_fence" }
    (kind == Kind.FILE_READ) { out "rt_file_read" }
    (kind == Kind.FILE_WRITE) { out "rt_file_write" }
    (kind == Kind.FILE_WRITE_BYTES) { out "rt_file_write_bytes" }
    (kind == Kind.STR_LINE_COUNT) { out "rt_line_count" }
    (kind == Kind.STR_ADD) { out "rt_string_add" }
    (kind == Kind.STR_JOIN) { out "rt_string_add" }
    (kind == Kind.STR_LEN) { out "rt_string_len" }
    (kind == Kind.STR_AT) { out "rt_string_at" }
    (kind == Kind.STR_BYTE) { out "rt_string_byte" }
    (kind == Kind.STR_SLICE) { out "rt_string_slice" }
    (kind == Kind.STR_CONTAINS) { out "rt_string_contains" }
    (kind == Kind.STR_STARTS_WITH) { out "rt_string_starts_with" }
    (kind == Kind.STR_ENDS_WITH) { out "rt_string_ends_with" }
    (kind == Kind.STR_LOWER) { out "rt_string_lower" }
    (kind == Kind.STR_UPPER) { out "rt_string_upper" }
    (kind == Kind.NUM_TEXT) { out "rt_number_text" }
    out ""
}
