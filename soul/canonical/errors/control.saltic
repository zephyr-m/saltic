-- Управление: drum по строке, leave вне drum, pick с блоком без условия
-- не в конце, beat в always вне drum, строка во внешнюю переменную в always,
-- сопоставление enum веткой pick; в условии не yes/no (строка, число в pick) — Q-016.

Mode = enum {
    ON,
    OFF
}

program() {
    drum ("text") {
        @inside = none
    }
    leave
    pick {
        { @early = none }
        (1 > 0) { @late = none }
    }
    always {
        @step = beat
        leave
    }
    @title = ""
    always {
        title = "оборот"
        leave
    }
    ("text") { @word = none }
    pick {
        (7) { @number = none }
    }
    @mode = Mode.ON
    pick {
        (mode) {
            .ON => none,
            .OFF => none
        }
    }
    out none
}
