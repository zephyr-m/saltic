-- Управление: drum по строке, leave вне drum, pick с блоком без условия
-- не в конце, beat в always вне drum.

program() {
    drum ("text") {
        @inside = none
    }
    leave
    pick {
        { @early = none }
        (1 > 0) { @late = none }
    }
    always {
        @step = beat
        leave
    }
    out none
}
