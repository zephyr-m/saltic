-- Циклы ссылок (запрещены): обратная ссылка через литерал Box, через чтение
-- поля (значение) |имя|, через две записи полей; ссылка вперёд и общий элемент
-- без возврата ошибок не дают.

Node = Box {
    parent = none,
    child = none,
    items = []
}

program() {
    @root = Node {}
    @leaf = Node { parent = root }
    root.child = leaf
    @second = Node { child = Node {} }
    (second.child) |kid| {
        kid.parent = second
    }
    @a = Node {}
    @b = Node {}
    a.child = b
    b.parent = a
    @chain = Node { child = Node { child = root } }
    @extra = Node {}
    extra.items = [leaf, chain]
    out none
}
