-- enum: общий вариант у двух enum, неизвестный вариант, повтор и чужой
-- вариант в сопоставлении.

Shade = enum {
    LIGHT,
    DARK
}

OtherShade = enum {
    LIGHT,
    BRIGHT
}

program() {
    @unknown_enum = Shade.INVISIBLE
    @unknown_short_enum = .INVISIBLE
    @shade = Shade.LIGHT
    (shade) {
        .LIGHT => none,
        .LIGHT => none,
        .BRIGHT => none
    }
    out none
}
