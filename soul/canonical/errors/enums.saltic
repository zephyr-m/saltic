-- enum (Q-015): вариант принадлежит своему enum — LIGHT у двух enum можно, а
-- дважды в одном нельзя; короткое .X — только в ветке сопоставления; там же —
-- повтор, чужой вариант и общий вариант при значении неизвестного типа.

Shade = enum {
    LIGHT,
    DARK
}

OtherShade = enum {
    LIGHT,
    BRIGHT
}

Doubled = enum {
    ONE,
    ONE
}

skill unknown_shade(value) {
    (value) {
        .LIGHT => none
    }
    out none
}

program() {
    @unknown_enum = Shade.INVISIBLE
    @unknown_short_enum = .INVISIBLE
    @shade = Shade.LIGHT
    (shade) {
        .LIGHT => none,
        .LIGHT => none,
        .BRIGHT => none
    }
    out none
}
