-- enum (Q-015): вариант принадлежит своему enum — LIGHT у двух enum можно, а
-- дважды в одном нельзя; короткое .X — только в ветке сопоставления; там же —
-- повтор, чужой вариант, общий вариант при значении неизвестного типа; ветка
-- обязана что-то делать (голое значение — ошибка, Q-017) и перечислить все
-- варианты (нет DARK — ошибка, Q-018); «ничего» — { }.

Shade = enum {
    LIGHT,
    DARK
}

OtherShade = enum {
    LIGHT,
    BRIGHT
}

Doubled = enum {
    ONE,
    ONE
}

skill unknown_shade(value) {
    (value) {
        .LIGHT => { }
    }
    out none
}

program() {
    @unknown_enum = Shade.INVISIBLE
    @unknown_short_enum = .INVISIBLE
    @shade = Shade.LIGHT
    (shade) {
        .LIGHT => { },
        .LIGHT => { },
        .BRIGHT => { }
    }
    @other = OtherShade.BRIGHT
    (other) {
        .LIGHT => "светло",
        .BRIGHT => { }
    }
    out none
}
