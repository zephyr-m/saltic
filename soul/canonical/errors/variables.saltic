-- Переменные: смена типа, повтор, тень имени верхнего уровня, присваивание
-- константе и Box, необъявленная, имя модуля.

use io

Number = 1
Answer = yes

Point = Box {
    x = 0
}

program() {
    @number = 1
    number = "text"
    @number = 2
    @Answer = no
    @group = [1]
    group = ["text"]
    Number = 3
    Point = Point {}
    missing = 1
    @io = 1
    out none
}
