-- Фиксированные типы: в группе и в обычном аргументе теряются, плохой
-- аргумент u8 и u16.

skill requires_two(left, right) {
    out left + right
}

program() {
    @fixed_group = [u8(1)]
    @fixed_argument = requires_two(u8(1), 2)
    @bad_fixed = u8("text")
    @empty_fixed = u8()
    @fractional_fixed = u16(1.5)
    out none
}
