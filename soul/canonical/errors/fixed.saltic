-- Фиксированные типы: в группе и в обычном аргументе теряются, плохой
-- аргумент u8 и u16.

use core.u8
use core.u16

skill requires_two(left, right) {
    out left + right
}

program() {
    @fixed_group = [u8.from(1)]
    @fixed_argument = requires_two(u8.from(1), 2)
    @bad_fixed = u8.from("text")
    @empty_fixed = u8.from()
    @fractional_fixed = u16.from(1.5)
    out none
}
