-- Фиксированные типы: рядом со значением неизвестного типа — ошибка (Q-037);
-- параметр — один тип на все вызовы
-- (u8 из одного вызова, число из другого — ошибка); плохой аргумент u8 и
-- u16; остаток % — только для обычных чисел; литерал рядом с фиксированным
-- тип не берёт (Q-002): == и сдвиг адреса — тоже явно.

use core.u8
use core.u16
use core.u32
use core.address
use core.group

skill requires_two(left, right) {
    out left + right
}

skill unknown_partner(value) {
    out u8.from(1) + value
}

program() {
    @fixed_group = [u8.from(1)]
    @first = u8.from(group.get(fixed_group, 0))
    @fixed_argument = requires_two(u8.from(1), u8.from(2))
    @plain_argument = requires_two(1, u8.from(2))
    @bad_fixed = u8.from("text")
    @empty_fixed = u8.from()
    @fractional_fixed = u16.from(1.5)
    @fixed_rest = u16.from(7) % u16.from(2)
    @bare_equal = u8.from(1) == 1
    @bare_offset = address.add(address.from(u32.from(4096)), 1)
    out none
}
