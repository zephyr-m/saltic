-- Навыки: повтор параметра; фиксированный результат — один тип на все out,
-- тело кончается out.

use core.u32

skill duplicate_parameters(item, item) {
    out none
}

skill fixed_result(flag) {
    (flag == yes) { out u32.from(1) }
    out 0
}

skill fixed_tail(flag) {
    (flag == yes) { out u32.from(1) }
}

program() {
    @first = fixed_result(yes)
    @second = fixed_tail(no)
    out none
}
