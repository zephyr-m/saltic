-- Box: повтор поля и навыка, метод одного имени с разной арностью (Q-045),
-- неизвестный Box, ошибки в литерале Box;
-- поле с фиксированным по умолчанию — обычное число (Q-035), строку не примет.

use core.u32

Point = Box {
    x = 0,
    label = "point"
}

BrokenFields = Box {
    value = 0,
    value = 1
}

FixedFields = Box {
    size = u32.from(0)
}

BrokenSkills = Box {
    value = 0

    skill duplicate(item, item) {
        out none
    }

    skill duplicate() {
        out none
    }
}

Walker = Box {
    steps = 0

    skill go(count) {
        out count
    }
}

Runner = Box {
    pace = 0

    skill go(count, speed) {
        out count * speed
    }
}

program() {
    @unknown_box = MissingBox {}
    @wrong_field_type = Point { x = "text" }
    @extra_field = Point { missing = 1 }
    @duplicate_field = Point { x = 1, x = 2 }
    @fixed_field = FixedFields { size = "много" }
    out none
}
