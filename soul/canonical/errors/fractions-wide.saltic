-- Дробные на 64-битной цели (Q-041): с целым не смешиваются, == и % у них
-- нет, ~= — только для двух дробных, показ в {…} требует use core.fraction.

program() {
    @mixed = 1.5 * 2
    @equal = 1.5 == 1.5
    @rest = 7.5 % 2.0
    @near = 1 ~= 1
    @shown = 0.5
    @text = "{shown}"
    out none
}
