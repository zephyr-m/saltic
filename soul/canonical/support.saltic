-- support — помощник канона: модуль, который подключает main, чтобы
-- проверить use, enum, Box и навыки из другого модуля.
--
-- Name — константа "canonical"
-- Mode — enum ENABLED, DISABLED
-- Badge — Box { prefix, mode } с навыком text(name) -> prefix + name
-- active() -> Mode.ENABLED
-- badge(name) -> текст — Badge по умолчанию

use core.str

Name = "canonical"

Mode = enum {
    ENABLED,
    DISABLED
}

Badge = Box {
    prefix = "badge:",
    mode = Mode.ENABLED

    skill text(name) {
        out str.add(prefix, name)
    }
}

skill active() {
    out Mode.ENABLED
}

skill badge(name) {
    @value = Badge {}
    out value.text(name)
}
