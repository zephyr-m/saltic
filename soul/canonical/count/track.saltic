-- track — дорожка канона: круги по числу и ошибка, которая идёт наверх.
--
-- Track — Box { count }: laps() — drum по числу, отрицательный — NegativeCount;
--     bonus() — ошибка поднимается к вызвавшему; relay() — rescue внутри

use io

Track = Box {
    count = 0

    skill laps() {
        @done = 0
        drum (count) {
            done = done + 1
        }
        out done
    }

    skill bonus() {
        @done = laps()
        out done + 1
    }

    skill relay() {
        @done = laps() rescue |err| {
            io.show("relay: {err}")
            out err
        }
        out done
    }
}
