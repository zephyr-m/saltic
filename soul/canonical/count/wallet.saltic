-- wallet — кошелёк канона: копит сумму, пока число не переполнится.
--
-- Wallet — Box { total }: pay(price) -> сумма; переполнение — NumberOverflow
--     (удвоение до переполнения — одинаково на 29- и 61-битном числе); не число —
--     TypeMismatch (Q-026)

Wallet = Box {
    total = 1

    skill pay(price) {
        total = total + price
        out total
    }
}
