-- ruler — линейка канона: все действия над двумя числами разом.
--
-- Ruler — Box { left, right }: measure() -> [сумма, разность, произведение,
--     частное, остаток]; InvalidMeasure (имена ошибок, Q-022: вне диапазона —
--     …OutsideRange, неверный — Invalid…, не вышло — …Failed)

Ruler = Box {
    left = 0,
    right = 1

    skill measure() {
        @sum = left + right
        @difference = left - right
        @product = left * right
        @quotient = product / right
        @rest = (left + 1) % right

        (quotient == left) {
            out [sum, difference, product, quotient, rest]
        }

        out error.InvalidMeasure
    }
}
