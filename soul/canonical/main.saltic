-- main — канон языка: эталон всех возможностей, один пример на каждую.
-- Вывод программы сверяется с expected/output.txt. Комментарии -- только
-- в шапке, до кода.
--
-- State, Kind, Mood — enum (SIGNAL у Kind и Mood свой); Point, Agent, Signal — Box
-- Cursor — Box с навыками at, has, peek, next; next отдаёт новый Cursor
-- Link — Box с полем next = none; next_name(link) — (link.next) |next| { … }:
--     блок, только если значение не none, имя видно лишь в нём
-- move(point, step) -> Point — новый Box из старого; spend(energy, cost) -> число; NotEnoughEnergy
-- measure(left, right) -> [сумма, разность, произведение, частное, остаток]; BadMeasure
-- laps(count) -> count — drum по числу; отрицательный — NegativeCount
-- budget(total, price) -> сумма; переполнение — NumberOverflow (удвоение
--     до переполнения — одинаково на 29-битном и 61-битном числе)
-- cursor_ready(cursor) -> yes/no — метод у параметра; не Box — NoMethod
-- lap_bonus(count) -> число — ошибка поднимается к вызвавшему; relay_laps(count) — rescue внутри
-- memory_probe() -> число — core.arena: store/load 8, 16, 32 по смещению, за арену —
--     ArenaBounds; cpu.fence, mem.heap (занято < квоты)
-- fixed_probe() -> none — u8…u32, i32, bits32, address, from; fixed_step -> u32, next_byte -> address;
--     в группе, поле Box и общем навыке (group.contains) фиксированное — обычное число
-- module_probe() -> none — use, enum, Box и навыки из support, константа-группа
--     его Box (ShelfBadges)
-- core_probe() -> none — ядро: str (split, join, lines, count, from_byte, letters, регистр),
--     group (slice, concat, contains), num (and, or, xor, shift, bit), bits32,
--     core.bytes, core.dict (UnknownKey — через rescue)
-- react(agent, signal) -> Agent — pick; show_state(state) — (state) { .X => … }: все варианты, ветка — инструкция или { … }
-- line_count_probe() -> число — io.read_line до конца ввода; program не зовёт
-- run(agent, signals) -> Agent — drum по группе, rescue со значением
-- report(agent, input_path, output_path) -> none — io.file, строка "{…}", текст #…#;
--     process_probe() -> none — core.process: run и capture
-- program(input_path, output_path) — всё вместе: leave, условия, константы,
--     сравнения <= и >= (числа и фиксированные), always { … } с выходом leave

use io.file
use core.group
use core.mem
use core.arena
use io
use core.cpu
use core.bits32
use core.address
use core.u16
use canonical.support
use core.str
use core.u8
use core.u32
use core.i32
use core.usize
use core.process
use core.num
use core.bytes
use core.dict

AppName = "Saltic"
MaxEnergy = 100
DefaultStep = 2
Tracing = yes
Silent = no
ShelfBadges = [
    support.Badge { prefix = "shelf:" }
]

State = enum {
    READY,
    ACTIVE,
    EMPTY
}

Kind = enum {
    AGENT,
    SIGNAL
}

Mood = enum {
    SIGNAL,
    CALM
}

Point = Box {
    x = 0,
    y = 0
}

Agent = Box {
    name = "agent",
    kind = Kind.AGENT,
    state = State.READY,
    energy = MaxEnergy,
    point = Point {}
}

Signal = Box {
    name = "signal",
    kind = Kind.SIGNAL,
    step = DefaultStep,
    cost = 0
}

Link = Box {
    name = "",
    next = none
}

skill next_name(link) {
    (link.next) |next| { out next.name }
    out "конец"
}

Cursor = Box {
    items = [],
    index = 0

    skill at(offset) {
        out group.get(items, index + offset)
    }

    skill has() {
        out index < group.count(items)
    }

    skill peek() {
        @item = at(0)
        out item
    }

    skill next() {
        @cursor = Cursor()
        cursor.items = items
        cursor.index = index + 1
        out cursor
    }
}

skill move(point, step) {
    out Point {
        x = point.x + step,
        y = point.y + 1
    }
}

skill spend(energy, cost) {
    (cost > energy) {
        out error.NotEnoughEnergy
    }

    out energy - cost
}

skill measure(left, right) {
    @sum = left + right
    @difference = left - right
    @product = left * right
    @quotient = product / right
    @rest = (left + 1) % right

    (quotient == left) {
        out [sum, difference, product, quotient, rest]
    }

    out error.BadMeasure
}

skill laps(count) {
    @done = 0
    drum (count) { done = done + 1 }
    out done
}

skill budget(total, price) {
    out total + price
}

skill cursor_ready(cursor) {
    out cursor.has()
}

skill lap_bonus(count) {
    @done = laps(count)
    out done + 1
}

skill relay_laps(count) {
    @done = laps(count) rescue |err| {
        io.show("relay: {err}")
        out err
    }
    out done
}

skill line_count_probe() {
    @count = 0
    drum (1000000) {
        @line = io.read_line() rescue |err| { "" }
        (str.bytes(line) == 0) { leave }
        count = count + 1
    }
    out count
}

skill memory_probe() {
    arena.store8(0, str.byte("Z", 0))
    arena.store16(2, 12345)
    arena.store32(4, 123456)
    cpu.fence()
    @outside = arena.load8(arena.SIZE) rescue |err| { 0 - 1 }

    @used = mem.heap(0)
    (used >= mem.heap(2)) { out error.MemoryProbeFailed }
    (mem.heap(1) < 0) { out error.MemoryProbeFailed }
    (used > 0) {
        (arena.load8(0) == 90) {
            (arena.load16(2) == 12345) {
                (outside < 0) { out arena.load32(4) }
            }
        }
    }

    out error.MemoryProbeFailed
}

skill fixed_step(value, step) {
    out value + step
}

skill next_byte(at) {
    out address.add(at, usize.from(1))
}

skill fixed_probe() {
    @byte = u8.from(250) + u8.from(5)
    @word = u16.from(60000) + u16.from(5535)
    @wide = u32.from(4000000000) / u32.from(2)
    @signed = i32.from(-42)
    @converted = u16.from(u8.from(250))
    @mask = bits32.shift_left(bits32.from(1), u8.from(8))
    @memory = address.add(arena.start(), usize.from(64))
    @next = next_byte(memory)
    @stepped = fixed_step(wide, u32.from(7))

    mem.store8(memory, usize.from(0), u8.from(171))
    mem.store8(next, usize.from(0), u8.from(172))

    io.show("fixed: {byte} {word} {wide} {signed}")
    @stored = [byte, u8.from(5)]
    @stored_sum = group.get(stored, 0) + group.get(stored, 1)
    @stored_has = group.contains(stored, byte)
    io.show("conversion: {converted} skill: {stepped} stored: {stored_sum} {stored_has}")
    io.show("bits: {mask}")
    @shown_1 = mem.load8(memory, usize.from(0))
    @shown_2 = mem.load8(next, usize.from(0))
    io.show("typed memory: {shown_1} {shown_2}")

    out none
}

skill core_probe() {
    @parts = str.split("a,b,,c", ",")
    @shown_3 = group.count(parts)
    @shown_4 = str.join(parts, "-")
    io.show("split: {shown_3} join: {shown_4}")
    @shown_5 = group.count(str.lines("один\n\nдва\n"))
    @shown_6 = str.count("сталь")
    @shown_7 = str.bytes("сталь")
    @shown_8 = str.from_byte(83)
    io.show("lines: {shown_5} letters: {shown_6} bytes: {shown_7} byte: {shown_8}")
    @upper = str.upper("Зэф и ёж, hello")
    @lower = str.lower("ПРИВЕТ, ЁЛКА")
    @pieces = group.count(str.letters("сталь"))
    @third = str.letter("сталь", 2)
    io.show("case: {upper} / {lower} letters: {pieces} {third}")
    @middle = group.slice([1, 2, 3, 4], 1, 3)
    @longer = group.concat(middle, [9])
    @shown_9 = group.count(middle)
    @shown_10 = group.get(longer, 2)
    @shown_11 = group.contains(longer, 9)
    io.show("group: {shown_9} {shown_10} {shown_11}")
    @shown_12 = num.text(42)
    @shown_13 = 17 % 5
    @shown_14 = num.hex_char(11)
    io.show("num: {shown_12} {shown_13} {shown_14}")
    @mask = bits32.from(12)
    @shown_15 = bits32.and(mask, bits32.from(10))
    @shown_16 = bits32.or(mask, bits32.from(3))
    @shown_17 = bits32.xor(mask, bits32.from(5))
    @shown_18 = bits32.not(bits32.from(0))
    io.show("bits32: {shown_15} {shown_16} {shown_17} {shown_18}")
    @masked = num.and(13, 6)
    @joined = num.or(8, 3)
    @flipped = num.xor(12, 10)
    @lifted = num.shift_left(3, 4)
    @lowered = num.shift_right(0 - 40, 3)
    @second = num.bit(6, 1)
    io.show("num bits: {masked} {joined} {flipped} {lifted} {lowered} {second}")
    @buffer = bytes.new(3)
    bytes.set(buffer, 1, 200)
    @tail = bytes.slice(buffer, 1, 3)
    @pair = bytes.to_group(bytes.from_group([7, 8]))
    @shown_19 = bytes.count(buffer)
    @shown_20 = bytes.get(buffer, 1)
    @shown_21 = bytes.count(tail)
    @shown_22 = group.get(pair, 1)
    io.show("bytes: {shown_19} {shown_20} {shown_21} {shown_22}")
    @table = dict.new()
    dict.set(table, "имя", "Зэф")
    @missing = dict.get(table, "город") rescue |err| { "{err}" }
    @shown_23 = dict.get(table, "имя")
    @shown_24 = dict.has(table, "имя")
    io.show("dict: {shown_23} {shown_24} {missing}")

    out none
}

skill module_probe() {
    @short_badge = support.Badge { prefix = "short:" }
    @full_badge = support.Badge { prefix = "full:" }

    io.show("module name: {support.Name}")
    @shown_25 = support.active() == support.Mode.ENABLED
    io.show("module enum: {shown_25}")
    @shown_26 = support.badge("skill")
    io.show("module skill: {shown_26}")
    @shown_27 = short_badge.text("box")
    io.show("module short Box: {shown_27}")
    @shown_28 = full_badge.text("box")
    io.show("module full Box: {shown_28}")
    @shelf_badge = group.get(ShelfBadges, 0)
    io.show("module Box in constant: {shelf_badge.prefix}")
    @shown_29 = str.contains("Saltic", "alt")
    io.show("core string: {shown_29}")

    out none
}

skill react(agent, signal) {
    @energy = spend(agent.energy, signal.cost)
    @state = State.READY

    pick {
        (energy < 1) { state = State.EMPTY }
        { state = State.ACTIVE }
    }

    out Agent {
        name = agent.name,
        kind = agent.kind,
        state = state,
        energy = energy,
        point = move(agent.point, signal.step)
    }
}

skill show_state(state) {
    (state) {
        .READY => io.show("state: ready"),
        .ACTIVE => io.show("state: active"),
        .EMPTY => io.show("state: empty")
    }

    out none
}

skill run(agent, signals) {
    @current = agent

    drum (signals) {
        current = react(current, beat) rescue |err| {
            io.show("rescue: {err}")
            current
        }
        show_state(current.state)
    }

    out current
}

skill process_probe() {
    @echoed = process.capture(["echo", "pip"], "", [])
    @shown_30 = process.run(["true"], "", [])
    io.show("process run: {shown_30} capture: {echoed.output}code: {echoed.code}")
    out none
}

skill report(agent, input_path, output_path) {
    @text = file.read(input_path)
    @lines = str.line_count(text)
    @summary = "{agent.name}:{agent.energy}"

    io.show(AppName)
    io.show("input lines: {lines}")
    io.show("agent: {summary}")
    @card = #
        card: {agent.name}
          energy \{{agent.energy}\}

        end
        #
    io.show(card)
    file.write(output_path, summary)

    out none
}

program(input_path, output_path) {
    @agent = Agent {
        name = "pip",
        energy = 23,
        point = Point { x = 2, y = 3 }
    }

    @signals = [
        Signal { name = "scan", step = 1, cost = 5 },
        Signal { name = "move", step = 2, cost = 7 },
        Signal { name = "build", step = 3, cost = 11 },
        Signal { name = "back", step = -2, cost = 0 }
    ]

    @numbers = measure(8, 2) rescue |err| {
        io.show("measure failed: {err}")
        []
    }

    @cursor = Cursor()
    cursor.items = numbers

    drum (group.count(numbers)) {
        (cursor.has() == no) { leave }
        @shown_31 = cursor.peek()
        io.show("cursor: {shown_31}")
        cursor = cursor.next()
    }

    @lap_count = laps(0 - 1) rescue |err| {
        (err == error.NegativeCount) { io.show("negative drum: {err}") }
        0
    }
    lap_count = lap_count + laps(3)
    io.show("laps: {lap_count}")

    @spins = 0
    always {
        spins = spins + 1
        (spins == 3) { leave }
    }
    io.show("always: {spins}")

    @tail = Link { name = "хвост" }
    @head = Link { name = "голова", next = tail }
    @after_head = next_name(head)
    @after_tail = next_name(tail)
    io.show("present: {after_head} {after_tail}")

    @bonus = lap_bonus(0 - 1) rescue |err| {
        io.show("lifted: {err}")
        0
    }
    @relayed = relay_laps(0 - 1) rescue |err| {
        io.show("relayed: {err}")
        0
    }
    @spent = 1
    @broke = no
    drum (70) {
        (broke == no) {
            spent = budget(spent, spent) rescue |err| {
                io.show("budget: {err}")
                broke = yes
                0
            }
        }
    }

    @cursors = [Cursor { items = numbers }, cursor]
    @fresh = group.get(cursors, 0)
    @shown_32 = fresh.has()
    io.show("group method: {shown_32}")
    @shown_33 = cursor_ready(fresh)
    io.show("parameter method: {shown_33}")
    @stone = cursor_ready(7) rescue |err| {
        io.show("no method: {err}")
        no
    }

    (Tracing == yes) {
        @shown_34 = group.count(numbers)
        io.show("measure count: {shown_34}")
    }

    (group.count(numbers) >= 4) {
        @shown_35 = 2 <= 3
        @shown_36 = 3 >= 3
        @shown_37 = u8.from(5) <= u8.from(4)
        @shown_38 = [1, [2, "три"]] == [1, [2, "три"]]
        io.show("compare: {shown_35} {shown_36} {shown_37} {shown_38}")
    }

    (Silent == no) {
        io.show("run: visible")
    }

    @mood = Mood.SIGNAL
    (mood) {
        .SIGNAL => {
            @heard = "signal"
            io.show("mood: {heard}")
        },
        .CALM => { }
    }

    @shown_39 = memory_probe()
    io.show("memory: {shown_39}")
    fixed_probe()
    module_probe()
    process_probe()
    core_probe()

    agent = run(agent, signals)
    report(agent, input_path, output_path)

    out none
}
