-- main — вход канона языка: эталон всех возможностей, один пример на каждую.
-- Вывод программы сверяется с checks/expected/output.txt. Комментарии -- только
-- в шапке, до кода. Свободных навыков нет: у каждого навыка есть хозяин; один
-- объект — один файл, части объекта — вложенные Box; имя из use без заикания
-- (Agent, а не agent.Agent):
--     agent/ — Agent (с вложенным Point), Signal и enum State, Kind, Mood
--     walk/ — Cursor, Reader, Link; count/ — Track, Wallet, Ruler
--     probe/ — испытатель ядра Probe и чужой модуль Badge
-- Соседние каноны со своим входом: edges/ — граничные случаи, wide/ — 64 бита;
-- checks/ — случаи ошибок чекера и эталоны вывода.
--
-- Tracing, Silent — константы-флаги условий
-- program(input_path, output_path) — всё вместе: leave, условия, константы,
--     сравнения <= и >= (числа и фиксированные), always { … } с выходом leave,
--     минус -x, enum в условии с веткой { … }

use io
use core.group
use core.u8
use canonical.agent.kinds
use canonical.agent.signal
use canonical.agent.agent
use canonical.walk.cursor
use canonical.walk.reader
use canonical.walk.link
use canonical.count.track
use canonical.count.wallet
use canonical.count.ruler
use canonical.probe.probe

Tracing = yes
Silent = no

program(input_path, output_path) {
    @pip = Agent {
        name = "pip",
        energy = 23,
        place = Agent.Point {
            x = 2,
            y = 3
        }
    }

    @signals = [
        Signal {
            name = "scan",
            step = 1,
            cost = 5
        },
        Signal {
            name = "move",
            step = 2,
            cost = 7
        },
        Signal {
            name = "build",
            step = 3,
            cost = 11
        },
        Signal {
            name = "back",
            step = -2,
            cost = 0
        }
    ]

    @scale = Ruler {
        left = 8,
        right = 2
    }
    @numbers = scale.measure() rescue |err| {
        io.show("measure failed: {err}")
        []
    }

    @walker = Cursor()
    walker.items = numbers

    drum (group.count(numbers)) {
        (walker.has() == no) { leave }
        @shown_31 = walker.peek()
        io.show("cursor: {shown_31}")
        walker = walker.next()
    }

    @backward = Track {
        count = -1
    }
    @forward = Track {
        count = 3
    }
    @lap_count = backward.laps() rescue |err| {
        (err == error.NegativeCount) { io.show("negative drum: {err}") }
        0
    }
    lap_count = lap_count + forward.laps()
    io.show("laps: {lap_count}")
    @away = -(lap_count + 1)
    @back = -away
    io.show("minus: {away} {back}")

    @spins = 0
    always {
        spins = spins + 1
        (spins == 3) { leave }
    }
    io.show("always: {spins}")

    @tail = Link {
        name = "хвост"
    }
    @head = Link {
        name = "голова",
        next = tail
    }
    @after_head = head.after()
    @after_tail = tail.after()
    io.show("present: {after_head} {after_tail}")

    @bonus = backward.bonus() rescue |err| {
        io.show("lifted: {err}")
        0
    }
    @relayed = backward.relay() rescue |err| {
        io.show("relayed: {err}")
        0
    }
    @purse = Wallet {
        total = 1
    }
    @broke = no
    drum (70) {
        (broke == no) {
            purse.pay(purse.total) rescue |err| {
                io.show("budget: {err}")
                broke = yes
                0
            }
        }
    }
    @odd = Wallet {
        total = 1
    }
    odd.pay("word") rescue |err| {
        io.show("mixed: {err}")
        0
    }

    @tester = Probe {}
    @spare = Cursor {
        items = numbers
    }
    @walkers = [spare, walker]
    @fresh = group.get(walkers, 0)
    @shown_32 = fresh.has()
    io.show("group method: {shown_32}")
    @shown_33 = tester.ready(fresh)
    io.show("parameter method: {shown_33}")
    @book = Reader {}
    @steps = book.step()
    @inner = book.hand
    io.show("own field: {steps} {inner.index}")
    @stone = tester.ready(7) rescue |err| {
        io.show("no method: {err}")
        no
    }

    (Tracing == yes) {
        @shown_34 = group.count(numbers)
        io.show("measure count: {shown_34}")
    }

    (group.count(numbers) >= 4) {
        @shown_35 = 2 <= 3
        @shown_36 = 3 >= 3
        @shown_37 = u8.from(5) <= u8.from(4)
        @shown_38 = [1, [2, "три"]] == [1, [2, "три"]]
        io.show("compare: {shown_35} {shown_36} {shown_37} {shown_38}")
    }

    (Silent == no) {
        io.show("run: visible")
    }

    @mood = kinds.Mood.SIGNAL
    (mood) {
        .SIGNAL => {
            @heard = "signal"
            io.show("mood: {heard}")
        },
        .CALM => { }
    }

    @shown_39 = tester.check_memory()
    io.show("memory: {shown_39}")
    tester.check_fixed()
    tester.check_modules()
    tester.check_process()
    tester.check_core()

    pip = pip.run(signals)
    pip.report(input_path, output_path)

    out none
}
