-- main — канон языка: эталон всех возможностей, один пример на каждую.
-- Вывод программы сверяется с expected/output.txt. Комментарии -- только
-- в шапке, до кода.
--
-- State, Kind — enum; Point, Agent, Signal — Box с полями по умолчанию
-- Cursor — Box с навыками at, has, peek, next; next отдаёт новый Cursor
-- move(point, step) -> Point — новый Box из старого
-- spend(energy, cost) -> число; NotEnoughEnergy
-- measure(left, right) -> [сумма, разность, произведение, частное]; BadMeasure
-- laps(count) -> count — drum по числу; отрицательный — NegativeCount
-- budget(total, price) -> сумма; переполнение — NumberOverflow
-- cursor_ready(cursor) -> yes/no — метод у параметра; не Box — NoMethod
-- lap_bonus(count) -> число — ошибка поднимается к вызвавшему
-- relay_laps(count) -> число — rescue внутри навыка
-- memory_probe() -> число — core.mem: store/load 8, 16, 32, cpu.fence
-- fixed_probe() -> none — u8…u32, i32, bits32, address, from
-- module_probe() -> none — use, enum, Box и навыки из support, константа-группа
--     его Box (ShelfBadges)
-- react(agent, signal) -> Agent — pick
-- show_state(state) -> none — сопоставление enum (state) { .X => … }
-- run(agent, signals) -> Agent — drum по группе, rescue со значением
-- report(agent, input_path, output_path) -> none — io.file, строка "{…}"
-- program(input_path, output_path) — всё вместе: leave, условия, константы,
--     сравнения <= и >= (числа и фиксированные), always { … } с выходом leave

use io.file
use core.group
use core.mem
use io
use core.cpu
use core.bits32
use core.address
use core.u16
use canonical.support
use core.str
use core.u8
use core.u32
use core.i32
use core.usize

AppName = "Saltic"
MaxEnergy = 100
DefaultStep = 2
Tracing = yes
Silent = no
ShelfBadges = [
    support.Badge { prefix = "shelf:" }
]

State = enum {
    READY,
    ACTIVE,
    EMPTY
}

Kind = enum {
    AGENT,
    SIGNAL
}

Point = Box {
    x = 0,
    y = 0
}

Agent = Box {
    name = "agent",
    kind = Kind.AGENT,
    state = State.READY,
    energy = MaxEnergy,
    point = Point {}
}

Signal = Box {
    name = "signal",
    kind = Kind.SIGNAL,
    step = DefaultStep,
    cost = 0
}

Cursor = Box {
    items = [],
    index = 0

    skill at(offset) {
        out group.get(items, index + offset)
    }

    skill has() {
        out index < group.count(items)
    }

    skill peek() {
        @item = at(0)
        out item
    }

    skill next() {
        @cursor = Cursor()
        cursor.items = items
        cursor.index = index + 1
        out cursor
    }
}

skill move(point, step) {
    out Point {
        x = point.x + step,
        y = point.y + 1
    }
}

skill spend(energy, cost) {
    (cost > energy) {
        out error.NotEnoughEnergy
    }

    out energy - cost
}

skill measure(left, right) {
    @sum = left + right
    @difference = left - right
    @product = left * right
    @quotient = product / right

    (quotient == left) {
        out [sum, difference, product, quotient]
    }

    out error.BadMeasure
}

skill laps(count) {
    @done = 0
    drum (count) { done = done + 1 }
    out done
}

skill budget(total, price) {
    out total + price
}

skill cursor_ready(cursor) {
    out cursor.has()
}

skill lap_bonus(count) {
    @done = laps(count)
    out done + 1
}

skill relay_laps(count) {
    @done = laps(count) rescue |err| {
        io.show("relay: ", err)
        out err
    }
    out done
}

skill memory_probe() {
    @region = [0, 4096]
    mem.store8(region, 0, str.byte("Z", 0))
    mem.store16(region, 2, 12345)
    mem.store32(region, 4, 123456)
    mem.store_address32(region, 8, [0, 4096])
    cpu.fence()

    (mem.load8(region, 0) == 90) {
        (mem.load16(region, 2) == 12345) {
            out mem.load32(region, 4)
        }
    }

    out error.MemoryProbeFailed
}

skill fixed_probe() {
    @byte = u8.from(250) + u8.from(5)
    @word = u16.from(60000) + u16.from(5535)
    @wide = u32.from(4000000000) / u32.from(2)
    @signed = i32.from(-42)
    @converted = u16.from(u8.from(250))
    @mask = bits32.shift_left(bits32.from(1), u8.from(8))
    @memory = address.from(u32.from(8192))
    @next = address.add(memory, usize.from(1))

    mem.store8(memory, usize.from(0), u8.from(171))
    mem.store8(next, usize.from(0), u8.from(172))

    io.show("fixed: ", byte, " ", word, " ", wide, " ", signed)
    io.show("conversion: ", converted)
    io.show("bits: ", mask)
    io.show("typed memory: ", mem.load8(memory, usize.from(0)), " ", mem.load8(next, usize.from(0)))

    out none
}

skill module_probe() {
    @short_badge = support.Badge { prefix = "short:" }
    @full_badge = support.Badge { prefix = "full:" }

    io.show("module name: ", support.Name)
    io.show("module enum: ", support.active() == support.Mode.ENABLED)
    io.show("module skill: ", support.badge("skill"))
    io.show("module short Box: ", short_badge.text("box"))
    io.show("module full Box: ", full_badge.text("box"))
    @shelf_badge = group.get(ShelfBadges, 0)
    io.show("module Box in constant: ", shelf_badge.prefix)
    io.show("core string: ", str.contains("Saltic", "alt"))

    out none
}

skill react(agent, signal) {
    @energy = spend(agent.energy, signal.cost)
    @state = State.READY

    pick {
        (energy < 1) { state = State.EMPTY }
        { state = State.ACTIVE }
    }

    out Agent {
        name = agent.name,
        kind = agent.kind,
        state = state,
        energy = energy,
        point = move(agent.point, signal.step)
    }
}

skill show_state(state) {
    (state) {
        .READY => io.show("state: ready"),
        .ACTIVE => io.show("state: active"),
        .EMPTY => io.show("state: empty")
    }

    out none
}

skill run(agent, signals) {
    @current = agent

    drum (signals) {
        current = react(current, beat) rescue |err| {
            io.show("rescue: ", err)
            current
        }
        show_state(current.state)
    }

    out current
}

skill report(agent, input_path, output_path) {
    @text = file.read(input_path)
    @lines = str.line_count(text)
    @summary = "{agent.name}:{agent.energy}"

    io.show(AppName)
    io.show("input lines: ", lines)
    io.show("agent: ", summary)
    file.write(output_path, summary)

    out none
}

program(input_path, output_path) {
    @agent = Agent {
        name = "pip",
        energy = 23,
        point = Point { x = 2, y = 3 }
    }

    @signals = [
        Signal { name = "scan", step = 1, cost = 5 },
        Signal { name = "move", step = 2, cost = 7 },
        Signal { name = "build", step = 3, cost = 11 },
        Signal { name = "back", step = -2, cost = 0 }
    ]

    @numbers = measure(8, 2) rescue |err| {
        io.show("measure failed: ", err)
        []
    }

    @cursor = Cursor()
    cursor.items = numbers

    drum (group.count(numbers)) {
        (cursor.has() == no) { leave }
        io.show("cursor: ", cursor.peek())
        cursor = cursor.next()
    }

    @lap_count = laps(0 - 1) rescue |err| {
        (err == error.NegativeCount) { io.show("negative drum: ", err) }
        0
    }
    lap_count = lap_count + laps(3)
    io.show("laps: ", lap_count)

    @spins = 0
    always {
        spins = spins + 1
        (spins == 3) { leave }
    }
    io.show("always: ", spins)

    @bonus = lap_bonus(0 - 1) rescue |err| {
        io.show("lifted: ", err)
        0
    }
    @relayed = relay_laps(0 - 1) rescue |err| {
        io.show("relayed: ", err)
        0
    }
    @spent = budget(268435455, 1) rescue |err| {
        io.show("budget: ", err)
        0
    }

    @cursors = [Cursor { items = numbers }, cursor]
    @fresh = group.get(cursors, 0)
    io.show("group method: ", fresh.has())
    io.show("parameter method: ", cursor_ready(fresh))
    @stone = cursor_ready(7) rescue |err| {
        io.show("no method: ", err)
        no
    }

    (Tracing == yes) {
        io.show("measure count: ", group.count(numbers))
    }

    (group.count(numbers) >= 4) {
        io.show("compare: ", 2 <= 3, " ", 3 >= 3, " ", u8.from(5) <= u8.from(4), " ", [1, [2, "три"]] == [1, [2, "три"]])
    }

    (Silent == no) {
        io.show("run: visible")
    }

    io.show("memory: ", memory_probe())
    fixed_probe()
    module_probe()

    agent = run(agent, signals)
    report(agent, input_path, output_path)

    out none
}
