-- wide — канон 64-битных целей (x86-64, RV64): то, чего нет на 32-битных
-- платах, — 61-битные числа и дробные. Вывод сверяется с checks/expected/wide.txt;
-- гоняют tests/run (wide) на x86-64 и под qemu-riscv64. Комментарии -- только
-- в шапке, до кода.
--
-- Пробы — у испытателя Wide в probe.saltic.
-- program() — всё вместе

use canonical.wide.probe

program() {
    @tester = probe.Wide {}
    tester.check_big()
    tester.check_fractions()
    tester.check_whole()
    tester.check_failures()
    tester.check_matrices()
    out none
}
