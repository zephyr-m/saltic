-- kinds — enum канона: состояние агента, вид участника, настроение. У Kind
-- и Mood свой вариант SIGNAL — одно имя в разных enum не спорит.
--
-- State — READY, ACTIVE, EMPTY; Kind — AGENT, SIGNAL; Mood — SIGNAL, CALM

State = enum {
    READY,
    ACTIVE,
    EMPTY
}

Kind = enum {
    AGENT,
    SIGNAL
}

Mood = enum {
    SIGNAL,
    CALM
}
