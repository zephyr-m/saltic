-- agent — агент канона: тратит энергию на сигналы, двигается, говорит своё
-- состояние и пишет отчёт. Объект виден разом: его состояния State — вложенный
-- enum для его конечного автомата, его точка Point — вложенный Box (снаружи —
-- Agent.State.READY, Agent.Point { … }).
--
-- Agent — Box { name, kind, state, energy, place }:
--     State — enum READY, ACTIVE, EMPTY
--     Point — Box { x, y }: moved(step) -> новый Point из старого
--     spend(cost) -> число; NotEnoughEnergy
--     react(heard) -> новый Agent — pick
--     show_state() — (state) { .X => … }: все варианты, ветка — инструкция или { … }
--     run(signals) -> Agent — drum по группе, rescue со значением
--     report(input_path, output_path) — io.file, строка "{…}", текст #…#
-- AppName — имя в отчёте; MaxEnergy — энергия по умолчанию

use io
use io.file
use core.str
use canonical.agent.kinds

AppName = "Saltic"
MaxEnergy = 100

Agent = Box {
    name = "agent",
    kind = kinds.Kind.AGENT,
    state = State.READY,
    energy = MaxEnergy,
    place = Point {}

    State = enum {
        READY,
        ACTIVE,
        EMPTY
    }

    Point = Box {
        x = 0,
        y = 0

        skill moved(step) {
            out Point {
                x = x + step,
                y = y + 1
            }
        }
    }

    skill spend(cost) {
        (cost > energy) {
            out error.NotEnoughEnergy
        }

        out energy - cost
    }

    skill react(heard) {
        @left = spend(heard.cost)
        @now = State.READY

        pick {
            (left < 1) { now = State.EMPTY }
            { now = State.ACTIVE }
        }

        out Agent {
            name = name,
            kind = kind,
            state = now,
            energy = left,
            place = place.moved(heard.step)
        }
    }

    skill show_state() {
        (state) {
            .READY => io.show("state: ready"),
            .ACTIVE => io.show("state: active"),
            .EMPTY => io.show("state: empty")
        }

        out none
    }

    skill run(signals) {
        @current = Agent {
            name = name,
            kind = kind,
            state = state,
            energy = energy,
            place = place
        }

        drum (signals) {
            current = current.react(beat) rescue |err| {
                io.show("rescue: {err}")
                current
            }
            current.show_state()
        }

        out current
    }

    skill report(input_path, output_path) {
        @text = file.read(input_path)
        @lines = str.line_count(text)
        @summary = "{name}:{energy}"

        io.show(AppName)
        io.show("input lines: {lines}")
        io.show("agent: {summary}")
        @card = #
            card: {name}
              energy \{{energy}\}

            end
            #
        io.show(card)
        file.write(output_path, summary)

        out none
    }
}
