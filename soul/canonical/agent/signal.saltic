-- signal — сигнал канона: что агент слышит — шаг и цена в энергии. Сигнал и
-- агент знают друг друга: use по кругу (agent ↔ signal) разрешён, модули — граф
-- (решение автора 21.11.2026).
--
-- Signal — Box { name, kind, step, cost }; wakes(pip) -> разбудит ли агента
--     (тот ещё READY); DefaultStep — шаг по умолчанию

use canonical.agent.kinds
use canonical.agent.agent

DefaultStep = 2

Signal = Box {
    name = "signal",
    kind = kinds.Kind.SIGNAL,
    step = DefaultStep,
    cost = 0

    skill wakes(pip) {
        out (pip.state == Agent.State.READY)
    }
}
