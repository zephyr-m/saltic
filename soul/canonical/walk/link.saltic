-- link — звено цепочки канона: поле next может быть none.
--
-- Link — Box { name, next = none }: after() — (next) |ahead| { … }: блок,
--     только если значение не none, имя видно лишь в нём

Link = Box {
    name = "",
    next = none

    skill after() {
        (next) |ahead| { out ahead.name }
        out "конец"
    }
}
