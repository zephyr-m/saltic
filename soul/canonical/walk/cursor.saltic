-- cursor — курсор канона: идёт по группе, сам знает, есть ли что дальше.
--
-- Cursor — Box { items, index }: at(offset), has(), peek(), next() -> новый
--     Cursor, skip() — пишет своё поле

use core.group

Cursor = Box {
    items = [],
    index = 0

    skill at(offset) {
        out group.get(items, index + offset)
    }

    skill has() {
        out index < group.count(items)
    }

    skill peek() {
        @item = at(0)
        out item
    }

    skill next() {
        @ahead = Cursor()
        ahead.items = items
        ahead.index = index + 1
        out ahead
    }

    skill skip() {
        index = index + 1
        out index
    }
}
