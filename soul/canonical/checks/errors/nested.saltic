-- Вложенные Box и enum (решение автора 19.11.2026): часть объекта видна в
-- модуле коротким именем; если в модуле две части с одним именем, короткое
-- имя неоднозначно — пиши полное Car.Engine, Lamp.Mode.

Car = Box {
    engine = Car.Engine {}

    Engine = Box {
        fuel = 40
    }
}

Plane = Box {
    engine = Plane.Engine {}

    Engine = Box {
        fuel = 900
    }
}

Lamp = Box {
    mode = Lamp.Mode.ON

    Mode = enum {
        ON,
        OFF
    }
}

Fan = Box {
    mode = Fan.Mode.ON

    Mode = enum {
        ON,
        FAST
    }
}

program() {
    @spare = Engine {}
    @which = Mode.ON
    out none
}
