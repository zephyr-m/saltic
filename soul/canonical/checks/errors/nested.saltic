-- Вложенные Box (решение автора 19.11.2026): часть объекта видна в модуле
-- коротким именем; если в модуле две части с одним именем, короткое имя
-- неоднозначно — пиши полное Car.Engine.

Car = Box {
    engine = Car.Engine {}

    Engine = Box {
        fuel = 40
    }
}

Plane = Box {
    engine = Plane.Engine {}

    Engine = Box {
        fuel = 900
    }
}

program() {
    @spare = Engine {}
    out none
}
