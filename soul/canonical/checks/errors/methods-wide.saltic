-- Навык субъекта (решение автора 19.11.2026): тип параметра выводится по прямым
-- вызовам, как у свободного навыка; если навык выбирается во время работы (тип
-- хозяина неизвестен), дробное в него не уходит — ошибка с причиной.

Scale = Box {
    skill half(value) {
        out value / 2.0
    }
}

Holder = Box {
    skill pass(scale) {
        out scale.half(1.5)
    }
}

program() {
    @holder = Holder {}
    @scale = Scale {}
    @direct = scale.half(3.0)
    @passed = holder.pass(scale)
    out none
}
