-- badge — значок канона: чужой модуль для испытателя, чтобы проверить use,
-- константу, enum, Box и его навыки из другого модуля.
--
-- Name — константа "canonical"
-- Mode — enum ENABLED, DISABLED
-- Badge — Box { prefix, mode }: text(name) -> prefix + name; active() -> свой mode

use core.str

Name = "canonical"

Mode = enum {
    ENABLED,
    DISABLED
}

Badge = Box {
    prefix = "badge:",
    mode = Mode.ENABLED

    skill text(name) {
        out str.concat(prefix, name)
    }

    skill active() {
        out mode
    }
}
