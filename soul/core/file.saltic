use seed

skill write_bytes(path, bytes) {
    @index = 0
    @count = seed.group.count(bytes)
    drum (count) {
        @value = seed.group.at(bytes, index)
        (value < 0) { out error.ByteOutsideRange }
        (value > 255) { out error.ByteOutsideRange }
        index = index + 1
    }
    out seed.file.write_bytes(path, bytes)
}
