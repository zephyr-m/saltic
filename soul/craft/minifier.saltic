use seed
use seed.parser

CHUNK_SIZE = 256

TextBuffer = Box {
    chunks = []
    tail = ""
    last = ""

    skill add(value) {
        @next_chunks = chunks
        @next_tail = seed.str.add(tail, value)
        (seed.str.len(next_tail) == CHUNK_SIZE) {
            next_chunks = seed.group.add(next_chunks, next_tail)
            next_tail = ""
        }
        out TextBuffer {
            chunks = next_chunks
            tail = next_tail
            last = value
        }
    }

    skill text() {
        @parts = chunks
        (seed.str.len(tail) > 0) {
            parts = seed.group.add(parts, tail)
        }
        @active = yes
        @limit = seed.group.count(parts) + 1
        drum (limit) {
            (active == yes) {
                @count = seed.group.count(parts)
                (count == 0) { out "" }
                (count == 1) { out seed.group.item(parts, 0) }
                @joined = []
                @index = 0
                drum (count) {
                    (index < count) {
                        @part = seed.group.item(parts, index)
                        (index + 1 < count) {
                            part = seed.str.add(part, seed.group.item(parts, index + 1))
                        }
                        joined = seed.group.add(joined, part)
                        index = index + 2
                    }
                }
                parts = joined
            }
        }
        out ""
    }
}

skill is_digit_char(ch) {
    out seed.str.contains("0123456789", ch)
}

skill word_part(ch) {
    (ch == "_") { out yes }
    (is_digit_char(ch) == yes) { out yes }
    (seed.str.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) == yes) { out yes }
    @upper = seed.str.upper(ch)
    @lower = seed.str.lower(ch)
    (upper == lower) { out no }
    out yes
}

skill needs_space(left, right) {
    (word_part(left) == no) { out no }
    out word_part(right)
}

skill minify(source) {
    @buffer = TextBuffer {}
    @index = 0
    @length = seed.str.len(source)
    @inside_string = no
    @escaped = no
    @pending_space = no
    @pending_line = no

    drum (length) {
        @ch = seed.str.at(source, index)
        @handled = no

        (inside_string == yes) {
            buffer = buffer.add(ch)
            handled = yes
            @was_escaped = escaped
            (escaped == yes) { escaped = no }
            (was_escaped == no) {
                (ch == "\\") { escaped = yes }
                (ch == "\"") { inside_string = no }
            }
        }

        (handled == no) {
            (ch == " ") { pending_space = yes handled = yes }
            (ch == "\t") { pending_space = yes handled = yes }
            (ch == "\n") {
                pending_line = yes
                pending_space = no
                handled = yes
            }
        }

        (handled == no) {
            (pending_line == yes) {
                (seed.str.len(buffer.last) > 0) {
                    (buffer.last == "\n") { pending_line = no }
                    (pending_line == yes) { buffer = buffer.add("\n") }
                }
                pending_line = no
            }
            (pending_space == yes) {
                (seed.str.len(buffer.last) > 0) {
                    (buffer.last == "\n") { pending_space = no }
                    (pending_space == yes) {
                        (needs_space(buffer.last, ch) == yes) { buffer = buffer.add(" ") }
                    }
                }
                pending_space = no
            }
            buffer = buffer.add(ch)
            (ch == "\"") { inside_string = yes }
        }

        index = index + 1
    }

    out buffer.text()
}

skill minify_file(input_path, output_path) {
    (input_path == output_path) {
        seed.io.show("минификатор: вход и выход не могут совпадать")
        out error.SamePath
    }
    @source = seed.io.file.read(input_path) rescue |failure| {
        seed.io.show("минификатор: не удалось прочитать ", input_path)
        out error.ReadFailed
    }
    @parsed = parser.parse_string(source, input_path)
    (seed.group.count(parsed.diagnostics) > 0) {
        seed.io.show("минификатор: исходник содержит ошибки")
        out error.InvalidSource
    }
    @compact = minify(source)
    @checked = parser.parse_string(compact, output_path)
    (seed.group.count(checked.diagnostics) > 0) {
        seed.io.show("минификатор: результат не прошёл проверку")
        out error.InvalidOutput
    }
    seed.io.file.write(output_path, compact)
    seed.io.show("минификатор: ", seed.str.len(source), " -> ", seed.str.len(compact), " байт")
    out none
}

program(input_path, output_path) {
    out minify_file(input_path, output_path)
}
