use seed
use seed.vm.state
use craft.tracer.model

Image = Box {
    chunks = []
    length = 0
}

Section = Box {
    offset = 0
    size = 0
    link = 0
    entry_size = 0
    present = no
}

skill image(text) {
    @chunks = []
    @chunk = []
    @index = 0
    @length = seed.str.len(text)
    drum (length) {
        chunk = seed.group.add(chunk, seed.str.byte(text, index))
        index = index + 1
        (seed.group.count(chunk) == state.PAGE_SIZE) {
            chunks = seed.group.add(chunks, chunk)
            chunk = []
        }
    }
    (seed.group.count(chunk) > 0) { chunks = seed.group.add(chunks, chunk) }
    out Image { chunks = chunks length = length }
}

skill valid_range(source, offset, size) {
    (offset < 0) { out no }
    (size < 0) { out no }
    (offset > source.length - size) { out no }
    out yes
}

skill byte(source, offset) {
    @chunk = seed.group.at(source.chunks, offset / state.PAGE_SIZE)
    out seed.group.at(chunk, state.mod(offset, state.PAGE_SIZE))
}

skill read_u16(source, offset) {
    out byte(source, offset) + byte(source, offset + 1) * 256
}

skill read_u32(source, offset) {
    out byte(source, offset) + byte(source, offset + 1) * 256 + byte(source, offset + 2) * 65536 + byte(source, offset + 3) * 16777216
}

skill byte_text(value) {
    (value > 31) {
        (value < 127) { out seed.str.at(state.PRINTABLE, value - 32) }
    }
    out "?"
}

skill name(source, offset, limit) {
    @text = ""
    @index = 0
    drum (limit) {
        @value = byte(source, offset + index)
        (value == 0) { out text }
        text = seed.str.add(text, byte_text(value))
        index = index + 1
    }
    out text
}

skill failure(message) {
    out model.SymbolTable { diagnostic = message }
}

skill section(source, table, entry_size, count, index) {
    (index < 0) { out Section {} }
    (index > count - 1) { out Section {} }
    @header = table + index * entry_size
    (valid_range(source, header, 40) == no) { out Section {} }
    out Section {
        offset = read_u32(source, header + 16)
        size = read_u32(source, header + 20)
        link = read_u32(source, header + 24)
        entry_size = read_u32(source, header + 36)
        present = yes
    }
}

skill symbol_kind(symbol_name) {
    (seed.str.starts_with(symbol_name, "saltic_") == yes) { out "saltic" }
    (seed.str.starts_with(symbol_name, "rt_") == yes) { out "runtime" }
    out "other"
}

skill useful_symbol(symbol_name) {
    (seed.str.starts_with(symbol_name, "saltic_") == yes) { out yes }
    (seed.str.starts_with(symbol_name, "rt_") == yes) { out yes }
    (symbol_name == "_start") { out yes }
    out no
}

skill symbols(source) {
    (valid_range(source, 0, 52) == no) { out failure("заголовок ELF обрезан") }
    (byte(source, 0) == 127) {
        (byte(source, 1) == 69) {
            (byte(source, 2) == 76) {
                (byte(source, 3) == 70) {
                    @class = byte(source, 4)
                    @endian = byte(source, 5)
                    (class > 1) { out failure("трассер поддерживает только ELF32") }
                    (class < 1) { out failure("трассер поддерживает только ELF32") }
                    (endian > 1) { out failure("трассер поддерживает только little-endian ELF") }
                    (endian < 1) { out failure("трассер поддерживает только little-endian ELF") }

                    @table = read_u32(source, 32)
                    @entry_size = read_u16(source, 46)
                    @count = read_u16(source, 48)
                    (entry_size < 40) { out failure("некорректный размер заголовка секции ELF") }
                    (count == 0) { out failure("в ELF нет таблицы секций") }
                    (valid_range(source, table, entry_size * count) == no) { out failure("таблица секций ELF обрезана") }

                    @symbols_section = Section {}
                    @section_index = 0
                    drum (count) {
                        @header = table + section_index * entry_size
                        (read_u32(source, header + 4) == 2) {
                            symbols_section = section(source, table, entry_size, count, section_index)
                        }
                        section_index = section_index + 1
                    }
                    (symbols_section.present == no) { out failure("в ELF нет таблицы символов") }
                    (symbols_section.entry_size < 16) { out failure("некорректный размер символа ELF") }
                    (valid_range(source, symbols_section.offset, symbols_section.size) == no) { out failure("таблица символов ELF обрезана") }

                    @strings_section = section(source, table, entry_size, count, symbols_section.link)
                    (strings_section.present == no) { out failure("в ELF нет таблицы имён символов") }
                    (valid_range(source, strings_section.offset, strings_section.size) == no) { out failure("таблица имён символов ELF обрезана") }

                    @items = []
                    @symbol_count = symbols_section.size / symbols_section.entry_size
                    @symbol_index = 0
                    drum (symbol_count) {
                        @symbol_offset = symbols_section.offset + symbol_index * symbols_section.entry_size
                        @name_offset = read_u32(source, symbol_offset)
                        @address = read_u32(source, symbol_offset + 4)
                        @size = read_u32(source, symbol_offset + 8)
                        (name_offset < strings_section.size) {
                            @available = strings_section.size - name_offset
                            @symbol_name = name(source, strings_section.offset + name_offset, available)
                            (useful_symbol(symbol_name) == yes) {
                                items = seed.group.add(items, model.Symbol {
                                    name = symbol_name
                                    address = address
                                    size = size
                                    kind = symbol_kind(symbol_name)
                                    present = yes
                                })
                            }
                        }
                        symbol_index = symbol_index + 1
                    }
                    out model.SymbolTable { ok = yes symbols = items }
                }
            }
        }
    }
    out failure("файл не является ELF")
}

skill find(table, address) {
    @index = 0
    @count = seed.group.count(table.symbols)
    drum (count) {
        @symbol = seed.group.at(table.symbols, index)
        (symbol.address == address) { out symbol }
        index = index + 1
    }
    out model.Symbol {}
}
