use seed.str
use seed.group
use seed.num
use seed.abi
use seed.vm.state

skill raw_text(word) {
    out str.add("0x", state.word_hex(word))
}

skill pointer(word) {
    @address = state.word_copy(word)
    address.b0 = address.b0 - state.mod(address.b0, abi.TAG_SCALE)
    out state.word_address(address)
}

skill hex_byte(value) {
    @text = str.at(state.HEX, value / 16)
    out str.add(text, str.at(state.HEX, state.mod(value, 16)))
}

skill string_byte(value) {
    (value == 9) { out "\\t" }
    (value == 10) { out "\\n" }
    (value == 13) { out "\\r" }
    (value == 34) { out "\\\"" }
    (value == 92) { out "\\\\" }
    (value > 31) {
        (value < 127) { out str.at(state.PRINTABLE, value - 32) }
    }
    out str.add("\\x", hex_byte(value))
}

skill string_value(machine, word) {
    @address = pointer(word)
    (address < 0) { out str.add(raw_text(word), " (некорректная строка)") }
    (address > machine.memory.size - abi.OBJECT_PAYLOAD_OFFSET - 4) { out str.add(raw_text(word), " (строка вне памяти)") }
    @length = state.word_address(state.memory_load_word(machine.memory, address + abi.OBJECT_PAYLOAD_OFFSET))
    (length < 0) { out str.add(raw_text(word), " (некорректная длина строки)") }
    (address > machine.memory.size - length - abi.OBJECT_PAYLOAD_OFFSET - 4) { out str.add(raw_text(word), " (строка вне памяти)") }

    @text = "\""
    @limit = length
    (limit > 80) { limit = 80 }
    @index = 0
    drum (limit) {
        text = str.add(text, string_byte(state.memory_raw_load8(machine.memory, address + abi.OBJECT_PAYLOAD_OFFSET + 4 + index)))
        index = index + 1
    }
    (length > limit) { text = "{text}…" }
    text = "{text}\""
    out str.add(raw_text(word), " ({text})")
}

skill tagged_id(word) {
    out state.word_address(word) / abi.TAG_SCALE
}

skill render(machine, word) {
    @tag = state.mod(word.b0, abi.TAG_SCALE)
    @raw = raw_text(word)
    (tag == abi.TAG_NUMBER) {
        @number = state.word_signed_number(word) / abi.TAG_SCALE
        out "{raw} (число {number})"
    }
    (tag == abi.TAG_ANSWER) {
        (state.word_equal(word, state.word_number(abi.YES)) == yes) { out "{raw} (да)" }
        (state.word_equal(word, state.word_number(abi.NO)) == yes) { out "{raw} (нет)" }
        out "{raw} (ответ)"
    }
    (tag == abi.TAG_NONE) { out "{raw} (пусто)" }
    (tag == abi.TAG_STRING) { out string_value(machine, word) }
    (tag == abi.TAG_GROUP) { out "{raw} (группа)" }
    (tag == abi.TAG_BOX) { out "{raw} (объект)" }
    (tag == abi.TAG_ENUM) { out str.add(raw, str.add(" (перечисление #", str.add(num.text(tagged_id(word)), ")"))) }
    out str.add(raw, str.add(" (ошибка #", str.add(num.text(tagged_id(word)), ")")))
}

skill registers(machine) {
    @values = []
    @index = 0
    drum (4) {
        values = group.add(values, render(machine, state.register(machine, index + 10)))
        index = index + 1
    }
    out values
}
