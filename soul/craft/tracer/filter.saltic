use seed
use seed.str

skill include(symbol, options) {
    (symbol.present == no) { out no }
    (symbol.kind == "runtime") { out options.show_runtime }
    (symbol.kind == "saltic") {
        (str.len(options.prefix) == 0) { out yes }
        out str.starts_with(symbol.name, options.prefix)
    }
    out no
}

skill display_name(symbol) {
    @prefix = "saltic_"
    (str.starts_with(symbol.name, prefix) == yes) {
        out str.slice(symbol.name, str.len(prefix), str.len(symbol.name))
    }
    out symbol.name
}
