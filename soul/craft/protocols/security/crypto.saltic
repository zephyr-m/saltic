-- crypto — сравнение секретов за постоянное время (craft: рядом с tls и ssh;
-- из ядра перенесён 11.11.2026, Q-023). Проверка — tests/crypto.saltic.
--
-- equal(left, right) -> yes/no; строки сравниваются целиком, без раннего выхода
--     по первому различию (только по длине)

use core.str
use core.bits32

skill equal(left, right) {
    @size = str.bytes(left)
    ((str.bytes(right) == size) == no) { out no }
    @difference = bits32.from(0)
    drum (size) {
        @pair = bits32.xor(bits32.from(str.byte(left, beat)), bits32.from(str.byte(right, beat)))
        difference = bits32.or(difference, pair)
    }
    out difference == bits32.from(0)
}
