-- json — общие типы JSON: вид значения, значение, член объекта и результаты
-- чтения. Навыков нет: чтение — в reader, запись — в writer, сборка
-- значений — в value, строки — в text, числа — в number.
-- Строки хранятся как Text { units = [кодовые точки] }, число — как текст
-- в исходной записи; результаты чтения несут ok, index (куда дочитали)
-- и message (текст ошибки по-русски).
--
-- JsonKind — enum NULL, ANSWER, NUMBER, STRING, ARRAY, OBJECT
-- ASCII — печатные знаки 32…126 по порядку, для writer
-- Text — Box { units }
-- Value — Box { kind, answer, number, string, items, members }
-- Member — Box { name = Text, value = Value }
-- Parse — Box { ok, value, index, message } — результат reader
-- TextRead — Box { ok, text, index, message } — результат text.read
-- CodepointRead — Box { ok, value, index, message } — одна кодовая точка
-- Lookup — Box { found, value } — результат value.get

JsonKind = enum {
    NULL,
    ANSWER,
    NUMBER,
    STRING,
    ARRAY,
    OBJECT
}

ASCII = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz\{|\}~"

Text = Box {
    units = []
}

Value = Box {
    kind = JsonKind.NULL,
    answer = no,
    number = "",
    string = Text {},
    items = [],
    members = []
}

Member = Box {
    name = Text {},
    value = Value {}
}

Parse = Box {
    ok = no,
    value = Value {},
    index = 0,
    message = ""
}

TextRead = Box {
    ok = no,
    text = Text {},
    index = 0,
    message = ""
}

CodepointRead = Box {
    ok = no,
    value = 0,
    index = 0,
    message = ""
}

Lookup = Box {
    found = no,
    value = Value {}
}
