-- encoder — запись json_rpc.Message и Packet в текст JSON-RPC 2.0.
-- Порядок полей: jsonrpc, method, params, id — у запроса; jsonrpc,
-- result/error, id — у ответа. INVALID пишется как ошибочный ответ.
--
-- encode(message) -> текст одного сообщения
-- encode_packet(packet) -> текст: массив для batch, иначе первое сообщение;
--     пустой пакет — ошибка invalid_request
-- message_value(message) -> json.Value любого сообщения
-- request_value / success_value / failure_value(message) -> json.Value

use core.group
use craft.protocols.data.json
use craft.protocols.data.json.value
use craft.protocols.data.json.writer
use craft.protocols.data.json_rpc

skill request_value(message) {
    @members = [
        value.field("jsonrpc", value.string("2.0")),
        value.field_text(json_rpc.rpc_text("method"), value.string_text(message.method))
    ]
    (message.has_params == yes) { members = group.add(members, value.field("params", message.params)) }
    (message.has_id == yes) { members = group.add(members, value.field("id", message.id)) }
    out value.object(members)
}

skill success_value(message) {
    out value.object([
        value.field("jsonrpc", value.string("2.0")),
        value.field("result", message.result),
        value.field("id", message.id)
    ])
}

skill failure_value(message) {
    @error_members = [
        value.field("code", value.number_value(message.error_code)),
        value.field_text(json_rpc.rpc_text("message"), value.string_text(message.error_message))
    ]
    (message.has_error_data == yes) { error_members = group.add(error_members, value.field("data", message.error_data)) }
    out value.object([
        value.field("jsonrpc", value.string("2.0")),
        value.field("error", value.object(error_members)),
        value.field("id", message.id)
    ])
}

skill message_value(message) {
    (message.kind == json_rpc.MessageKind.REQUEST) { out request_value(message) }
    (message.kind == json_rpc.MessageKind.NOTIFICATION) { out request_value(message) }
    (message.kind == json_rpc.MessageKind.SUCCESS) { out success_value(message) }
    (message.kind == json_rpc.MessageKind.FAILURE) { out failure_value(message) }
    out failure_value(message)
}

skill encode(message) {
    out writer.encode(message_value(message))
}

skill encode_packet(packet) {
    (packet.batch == yes) {
        @items = []
        @index = 0
        @count = group.count(packet.messages)
        drum (count) {
            (index < count) {
                items = group.add(items, message_value(group.get(packet.messages, index)))
                index = index + 1
            }
        }
        out writer.encode(value.array(items))
    }
    (group.count(packet.messages) > 0) { out encode(group.get(packet.messages, 0)) }
    out encode(json_rpc.invalid_request("пакет не содержит сообщений"))
}
