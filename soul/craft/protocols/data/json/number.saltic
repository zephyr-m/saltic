use seed
use craft.protocols.data.json
use craft.protocols.data.json.value

skill is_digit(ch) {
    out seed.str.contains("0123456789", ch)
}

skill is_nonzero_digit(ch) {
    out seed.str.contains("123456789", ch)
}

skill failure(index, message) {
    out json.Parse { index = index message = message }
}

skill parse_at(source, start) {
    @length = seed.str.len(source)
    @index = start
    (index < length) {
        (seed.str.at(source, index) == "-") { index = index + 1 }
    }
    (index == length) { out failure(index, "неполное число JSON") }

    @first = seed.str.at(source, index)
    (first == "0") {
        index = index + 1
        (index < length) {
            (is_digit(seed.str.at(source, index)) == yes) { out failure(index, "ведущий ноль в числе JSON") }
        }
    }
    (first == "0") { first = "" }
    (seed.str.len(first) > 0) {
        (is_nonzero_digit(first) == no) { out failure(index, "ожидалось число JSON") }
        index = index + 1
        @active = yes
        drum (length + 1) {
            (active == yes) {
                (index < length) {
                    @digit = is_digit(seed.str.at(source, index))
                    (digit == yes) { index = index + 1 }
                    (digit == no) { active = no }
                }
                (index == length) { active = no }
            }
        }
    }

    (index < length) {
        (seed.str.at(source, index) == ".") {
            index = index + 1
            (index == length) { out failure(index, "в дробной части нет цифр") }
            (is_digit(seed.str.at(source, index)) == no) { out failure(index, "в дробной части нет цифр") }
            @active = yes
            drum (length + 1) {
                (active == yes) {
                    (index < length) {
                        @digit = is_digit(seed.str.at(source, index))
                        (digit == yes) { index = index + 1 }
                        (digit == no) { active = no }
                    }
                    (index == length) { active = no }
                }
            }
        }
    }

    (index < length) {
        @exponent = seed.str.at(source, index)
        (exponent == "e") { index = index + 1 }
        (exponent == "E") { index = index + 1 }
        (exponent == "e") { exponent = "" }
        (exponent == "E") { exponent = "" }
        (seed.str.len(exponent) == 0) {
            (index == length) { out failure(index, "в экспоненте нет цифр") }
            @sign = seed.str.at(source, index)
            (sign == "+") { index = index + 1 }
            (sign == "-") { index = index + 1 }
            (index == length) { out failure(index, "в экспоненте нет цифр") }
            (is_digit(seed.str.at(source, index)) == no) { out failure(index, "в экспоненте нет цифр") }
            @active = yes
            drum (length + 1) {
                (active == yes) {
                    (index < length) {
                        @digit = is_digit(seed.str.at(source, index))
                        (digit == yes) { index = index + 1 }
                        (digit == no) { active = no }
                    }
                    (index == length) { active = no }
                }
            }
        }
    }

    out json.Parse { ok = yes value = value.number_value(seed.str.slice(source, start, index)) index = index }
}

skill text_valid(subject) {
    @parsed = parse_at(subject, 0)
    (parsed.ok == yes) { out parsed.index == seed.str.len(subject) }
    out no
}

skill integer_text_valid(subject) {
    (text_valid(subject) == no) { out no }
    (seed.str.contains(subject, ".") == yes) { out no }
    (seed.str.contains(seed.str.lower(subject), "e") == yes) { out no }
    out yes
}
