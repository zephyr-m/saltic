-- writer — запись json.Value в компактный текст JSON без пробелов.
-- Строки: печатный ASCII как есть, спецзнаки через \", \\, \b, \f, \n,
-- \r, \t, остальное — \uXXXX (выше 65535 — парой суррогатов).
--
-- encode(item) -> текст JSON любого Value
-- encode_text(Text) -> строка в кавычках
-- encode_array(items) / encode_object(members) -> текст
-- encode_unit(кодовая точка) -> текст одного знака; hex4(число) -> 4 hex-цифры

use core.str
use core.group
use craft.protocols.data.json
use craft.protocols.data.json.text
use core.num

skill hex4(item) {
    @a = item / 4096
    @rest = item - a * 4096
    @b = rest / 256
    rest = rest - b * 256
    @c = rest / 16
    @d = rest - c * 16
    @encoded = num.hex_digit(a)
    encoded = str.concat(encoded, num.hex_digit(b))
    encoded = str.concat(encoded, num.hex_digit(c))
    out str.concat(encoded, num.hex_digit(d))
}

skill encode_unit(unit) {
    (unit == 34) { out "\\\"" }
    (unit == 92) { out "\\\\" }
    (unit == 8) { out "\\b" }
    (unit == 12) { out "\\f" }
    (unit == 10) { out "\\n" }
    (unit == 13) { out "\\r" }
    (unit == 9) { out "\\t" }
    (unit > 31) {
        (unit < 127) { out str.get(json.ASCII, unit - 32) }
    }
    (unit < 65536) { out str.concat("\\u", hex4(unit)) }

    @rest = unit - 65536
    @high = 55296 + rest / 1024
    @low = 56320 + rest - rest / 1024 * 1024
    @encoded = str.concat("\\u", hex4(high))
    out str.concat(encoded, str.concat("\\u", hex4(low)))
}

skill encode_text(subject) {
    @encoded = "\""
    @index = 0
    @count = text.count(subject)
    drum (count) {
        (index < count) {
            encoded = str.concat(encoded, encode_unit(text.at(subject, index)))
            index = index + 1
        }
    }
    out "{encoded}\""
}

skill encode_array(items) {
    @encoded = "["
    @index = 0
    @count = group.count(items)
    drum (count) {
        (index < count) {
            (index > 0) { encoded = "{encoded}," }
            encoded = str.concat(encoded, encode(group.get(items, index)))
            index = index + 1
        }
    }
    out "{encoded}]"
}

skill encode_object(members) {
    @encoded = "\{"
    @index = 0
    @count = group.count(members)
    drum (count) {
        (index < count) {
            @member = group.get(members, index)
            (index > 0) { encoded = "{encoded}," }
            encoded = str.concat(encoded, encode_text(member.name))
            encoded = "{encoded}:"
            encoded = str.concat(encoded, encode(member.value))
            index = index + 1
        }
    }
    out "{encoded}\}"
}

skill encode(item) {
    (item.kind == json.JsonKind.NULL) { out "null" }
    (item.kind == json.JsonKind.ANSWER) {
        (item.answer == yes) { out "true" }
        out "false"
    }
    (item.kind == json.JsonKind.NUMBER) { out item.number }
    (item.kind == json.JsonKind.STRING) { out encode_text(item.string) }
    (item.kind == json.JsonKind.ARRAY) { out encode_array(item.items) }
    (item.kind == json.JsonKind.OBJECT) { out encode_object(item.members) }
    out "null"
}
