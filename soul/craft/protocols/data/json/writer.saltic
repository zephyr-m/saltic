use seed.str
use seed.group
use craft.protocols.data.json
use craft.protocols.data.json.text

skill hex_digit(item) {
    out str.at(json.HEX, item)
}

skill hex4(item) {
    @a = item / 4096
    @rest = item - a * 4096
    @b = rest / 256
    rest = rest - b * 256
    @c = rest / 16
    @d = rest - c * 16
    @encoded = hex_digit(a)
    encoded = str.add(encoded, hex_digit(b))
    encoded = str.add(encoded, hex_digit(c))
    out str.add(encoded, hex_digit(d))
}

skill encode_unit(unit) {
    (unit == 34) { out "\\\"" }
    (unit == 92) { out "\\\\" }
    (unit == 8) { out "\\b" }
    (unit == 12) { out "\\f" }
    (unit == 10) { out "\\n" }
    (unit == 13) { out "\\r" }
    (unit == 9) { out "\\t" }
    (unit > 31) {
        (unit < 127) { out str.at(json.ASCII, unit - 32) }
    }
    (unit < 65536) { out str.add("\\u", hex4(unit)) }

    @rest = unit - 65536
    @high = 55296 + rest / 1024
    @low = 56320 + rest - rest / 1024 * 1024
    @encoded = str.add("\\u", hex4(high))
    out str.add(encoded, str.add("\\u", hex4(low)))
}

skill encode_text(subject) {
    @encoded = "\""
    @index = 0
    @count = text.count(subject)
    drum (count) {
        (index < count) {
            encoded = str.add(encoded, encode_unit(text.at(subject, index)))
            index = index + 1
        }
    }
    out str.add(encoded, "\"")
}

skill encode_array(items) {
    @encoded = "["
    @index = 0
    @count = group.count(items)
    drum (count) {
        (index < count) {
            (index > 0) { encoded = str.add(encoded, ",") }
            encoded = str.add(encoded, encode(group.item(items, index)))
            index = index + 1
        }
    }
    out str.add(encoded, "]")
}

skill encode_object(members) {
    @encoded = "\{"
    @index = 0
    @count = group.count(members)
    drum (count) {
        (index < count) {
            @member = group.item(members, index)
            (index > 0) { encoded = str.add(encoded, ",") }
            encoded = str.add(encoded, encode_text(member.name))
            encoded = str.add(encoded, ":")
            encoded = str.add(encoded, encode(member.value))
            index = index + 1
        }
    }
    out str.add(encoded, "\}")
}

skill encode(item) {
    (item.kind == json.JsonKind.NULL) { out "null" }
    (item.kind == json.JsonKind.ANSWER) {
        (item.answer == yes) { out "true" }
        out "false"
    }
    (item.kind == json.JsonKind.NUMBER) { out item.number }
    (item.kind == json.JsonKind.STRING) { out encode_text(item.string) }
    (item.kind == json.JsonKind.ARRAY) { out encode_array(item.items) }
    (item.kind == json.JsonKind.OBJECT) { out encode_object(item.members) }
    out "null"
}
