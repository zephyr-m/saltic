use seed.io.file
use seed.str
use seed.group
use craft.tracer.model
use craft.tracer.elf
use craft.tracer.session
use craft.tracer.render

skill options() {
    out model.Options {}
}

skill trace_image(source, table, settings) {
    out session.run(source, table, settings)
}

skill trace_text(binary, path, settings) {
    @source = elf.image(binary)
    @table = elf.symbols(source)
    (table.ok == no) {
        out model.Result { diagnostic = table.diagnostic }
    }
    render.start(path, group.count(table.symbols), settings)
    out trace_image(source, table, settings)
}

skill trace_file(path, settings) {
    @binary = file.read(path) rescue |failure| {
        @message = str.add("не удалось прочитать ELF: ", path)
        out model.Result { diagnostic = message }
    }
    out trace_text(binary, path, settings)
}

program(path) {
    @result = trace_file(path, options())
    render.finish(result)
    (result.ok == no) { out error.TraceFailed }
    out none
}
