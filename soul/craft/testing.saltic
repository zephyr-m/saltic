-- testing — тестовый набор: счётчики и печать проверок; на нём стоят
-- tests/ и soul/seed/tests/.
-- Каждая проверка печатает «имя -> значение [ok]/[FAIL]» и отдаёт
-- обновлённый набор — результат нужно присваивать обратно.
--
-- Testing — Box { passed, failed, failures = [[имя, факт, ожидание]…] }
-- test_new() -> Testing
-- test_equal(suite, name, actual, expected) -> Testing
-- test_yes / test_no(suite, name, actual) -> Testing
-- test_pass(suite, name, actual) / test_fail(suite, name, actual, expected)
--     -> Testing; внутренние, зовутся из test_equal/test_yes/test_no
-- test_summary(suite) -> число провалов; печатает итог и список провалов
-- test_finish(suite) -> none; TestsFailed, если есть провалы

use core.group
use io

Testing = Box {
    passed = 0,
    failed = 0,
    failures = []
}

skill test_new() {
    out Testing {}
}

skill test_pass(suite, name, actual) {
    suite.passed = suite.passed + 1
    io.show(name, " -> ", actual, "  [ok]")
    out suite
}

skill test_fail(suite, name, actual, expected) {
    suite.failed = suite.failed + 1
    suite.failures = group.add(suite.failures, [name, actual, expected])
    io.show(name, " -> ", actual, "  [FAIL] (ожидалось ", expected, ")")
    out suite
}

skill test_equal(suite, name, actual, expected) {
    (actual == expected) {
        out test_pass(suite, name, actual)
    }
    out test_fail(suite, name, actual, expected)
}

skill test_yes(suite, name, actual) {
    (actual == yes) {
        out test_pass(suite, name, actual)
    }
    out test_fail(suite, name, actual, yes)
}

skill test_no(suite, name, actual) {
    (actual == no) {
        out test_pass(suite, name, actual)
    }
    out test_fail(suite, name, actual, no)
}

skill test_summary(suite) {
    io.show("итог: пройдено ", suite.passed, ", провалено ", suite.failed)
    (suite.failed > 0) {
        io.show("проваленные проверки:")
        drum (group.count(suite.failures)) {
            @failure = group.get(suite.failures, beat)
            io.show("- ", group.get(failure, 0), " -> ", group.get(failure, 1), "  [FAIL] (ожидалось ", group.get(failure, 2), ")")
        }
    }
    out suite.failed
}

skill test_finish(suite) {
    test_summary(suite)
    (suite.failed > 0) {
        out error.TestsFailed
    }
    out none
}
