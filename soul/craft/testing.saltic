use seed

Testing = Box {
    passed = 0
    failed = 0
    failures = []
}

skill test_new() {
    out Testing {}
}

skill test_pass(suite, name, actual) {
    suite.passed = suite.passed + 1
    seed.io.show(name, " -> ", actual, "  [ok]")
    out suite
}

skill test_fail(suite, name, actual, expected) {
    suite.failed = suite.failed + 1
    suite.failures = seed.group.add(suite.failures, [name, actual, expected])
    seed.io.show(name, " -> ", actual, "  [FAIL] (ожидалось ", expected, ")")
    out suite
}

skill test_equal(suite, name, actual, expected) {
    (actual == expected) {
        out test_pass(suite, name, actual)
    }
    out test_fail(suite, name, actual, expected)
}

skill test_yes(suite, name, actual) {
    (actual == yes) {
        out test_pass(suite, name, actual)
    }
    out test_fail(suite, name, actual, yes)
}

skill test_no(suite, name, actual) {
    (actual == no) {
        out test_pass(suite, name, actual)
    }
    out test_fail(suite, name, actual, no)
}

skill test_summary(suite) {
    seed.io.show("итог: пройдено ", suite.passed, ", провалено ", suite.failed)
    (suite.failed > 0) {
        seed.io.show("проваленные проверки:")
        @index = 0
        drum (seed.group.count(suite.failures)) {
            @failure = seed.group.item(suite.failures, index)
            seed.io.show("- ", seed.group.item(failure, 0), " -> ", seed.group.item(failure, 1), "  [FAIL] (ожидалось ", seed.group.item(failure, 2), ")")
            index = index + 1
        }
    }
    out suite.failed
}

skill test_finish(suite) {
    test_summary(suite)
    (suite.failed > 0) {
        out error.TestsFailed
    }
    out none
}
