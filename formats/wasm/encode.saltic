-- encode — байты модуля WebAssembly: LEB128, опкоды i32 и те немногие i64,
-- что нужны часам; VOID, FUNC, I32, I64 — типы.
-- Отрицательный сдвиг — через беззнаковое 32-битное представление.

use core.group
use selfhost.compiler.backend.rv32i.machine.buffer

skill asr7(n) {
    (n >= 0) { out n / 128 }
    @q = (n + 4294967296) / 128
    (q / 16777216 % 2 == 1) { out q - 33554432 }
    out q
}

skill sleb_push(items, n) {
    @b = n % 128
    (b < 0) { b = b + 128 }
    @next = asr7(n)
    @sign = b / 64
    @done = no
    (next == 0) {
        (sign == 0) { done = yes }
    }
    (next == (0 - 1)) {
        (sign == 1) { done = yes }
    }
    (done == yes) { out group.add(items, b) }
    out sleb_push(group.add(items, b + 128), next)
}

skill uleb_push(items, n) {
    (n < 128) { out group.add(items, n) }
    out uleb_push(group.add(items, n % 128 + 128), n / 128)
}

skill onto(buf, items) {
    drum (group.count(items)) { buf = buffer.append_byte(buf, group.get(items, beat)) }
    out buf
}

skill uleb(buf, n) {
    out onto(buf, uleb_push([], n))
}

skill sleb(buf, n) {
    out onto(buf, sleb_push([], n))
}

skill op(buf, byte) {
    out buffer.append_byte(buf, byte)
}

skill iconst(buf, n) {
    buf = op(buf, 65)
    out sleb(buf, n)
}

skill get(buf, index) {
    buf = op(buf, 32)
    out uleb(buf, index)
}

skill setl(buf, index) {
    buf = op(buf, 33)
    out uleb(buf, index)
}

skill bin(buf, opcode, left, right) {
    buf = get(buf, left)
    buf = get(buf, right)
    out op(buf, opcode)
}

skill mem(buf, opcode) {
    buf = op(buf, opcode)
    buf = uleb(buf, 0)
    out uleb(buf, 0)
}

skill call(buf, index) {
    buf = op(buf, 16)
    out uleb(buf, index)
}

skill br(buf, depth) {
    buf = op(buf, 12)
    out uleb(buf, depth)
}

BLOCK = 2
LOOP = 3
IF = 4
ELSE = 5
END = 11
BR_TABLE = 14
DROP = 26
LOAD = 40
LOAD64 = 41
LOAD8_U = 45
LOAD16_U = 47
STORE = 54
STORE8 = 58
STORE16 = 59
CONST64 = 66
DIV64_U = 128
REM64_U = 130
WRAP64 = 167
VOID = 64
FUNC = 96
I32 = 127
I64 = 126
ADD = 106
SUB = 107
AND = 113
OR = 114
XOR = 115
SHL = 116
SHR_S = 117
SHR_U = 118
EQZ = 69
EQ = 70
NE = 71
LT_S = 72
LT_U = 73
GT_S = 74
GE_S = 78
GE_U = 79
LE_S = 76
