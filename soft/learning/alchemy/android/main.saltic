-- alchemy — алхимия языка на телефоне (APK, just android alchemy): экран
-- «Гильдия · Локации» — та же страница programs/alchemy/page, что на Acer и в
-- окне Linux, тема cocoa (themes.named, ночь сайта — проба 18.11.2026), рисунок
-- atoms.draw прямо в окно Android.
-- Окно даёт платформа через cpu.firmware (0 — адрес пикселей, 1 / 2 — ширина
-- и высота, 3 — шаг строки в пикселях); буфер втрое меньше экрана — Android
-- растягивает его сам, поэтому раскладка в точках, как у телефона в CSS.
-- Шрифты и значки — из своей папки приложения FILES (кладёт adb push); нет
-- файла — причина в журнал (adb logcat -s saltic), а экран рисуется Spleen
-- без значков. Кадр рисуется заново на каждый cpu.wait(): после него адрес
-- пикселей другой.
--
-- program() -> none
-- Внутри: canvas() -> graphics.Screen окна; dressed(screen) -> палитра со
--     шрифтами и значками, если они есть; face(name) -> Typeface из FILES

use io
use io.file
use core.cpu
use core.bytes
use tarantul.icons.icons
use tarantul.fonts.ttf
use tarantul.uiengine.jtml
use tarantul.uiengine.jtml.read
use tarantul.graphics.graphics
use tarantul.uiengine.draw.typeface
use tarantul.uiengine.draw.atoms
use soft.learning.alchemy.page
use tarantul.uiengine.themes

FILES = "/sdcard/Android/data/dev.saltic.alchemy/files/"

skill canvas() {
    out graphics.Screen { width = cpu.firmware(1), height = cpu.firmware(2), stride = cpu.firmware(3), format = graphics.FORMAT_RGB, memory = cpu.firmware(0), vsync = no }
}

skill face(name) {
    out typeface.from_bytes(file.read_bytes("{FILES}{name}"))
}

skill dressed(screen) {
    @plain = themes.named("cocoa", screen)
    @typed = atoms.with_faces(themes.named("cocoa", screen), face("INTER.TTF"), face("INTERB.TTF"), face("MONO.TTF")) rescue |err| {
        io.show("alchemy: шрифтов нет в {FILES} ({err}), рисую Spleen")
        out plain
    }
    @sheet = file.read_bytes("{FILES}ICONS.TXT") rescue |err| {
        io.show("alchemy: значков нет в {FILES} ({err}), рисую без них")
        out typed
    }
    out atoms.with_icons(typed, icons.open(ttf.from_bytes(sheet), bytes.count(sheet)))
}

program() {
    @screen = canvas()
    @palette = dressed(screen)
    @view = page.narrow()
    @tree = atoms.fitted(read.page(view.jtml()), no, palette)
    @runtime = jtml.mount(screen, tree)
    io.show("alchemy: окно {screen.width}×{screen.height}")
    always {
        atoms.draw(canvas(), runtime, palette)
        cpu.wait()
    }
    out none
}
