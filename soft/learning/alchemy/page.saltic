-- page — экран «Гильдия · Локации» алхимии языка (тренажёр слов автора,
-- ~/dev/rnd/EngApp), уровень 5: Box Page держит компоненты — шапку (top),
-- рейку разделов (side), карточки локаций (cards) и нижнюю навигацию (foot),
-- каждый — Box в alchemy/components, — и ставит их: шапка сверху, рейка и
-- карточки в ряд, навигация внизу. Тема — alchemy (themes). Логики пока нет.
--
-- Page { top, side, cards, foot, edge, above, below } — edge — отступ страницы
--     от краёв; above / below — место под полосы системы сверху и снизу
--     (телефон: часы и кнопки Android), снизу — цветом навигации;
--     jtml() -> текст страницы
-- narrow() -> Page для узкого экрана стоя (телефон): по две карточки в ряд

use soft.learning.alchemy.components.head
use soft.learning.alchemy.components.rail
use soft.learning.alchemy.components.places
use soft.learning.alchemy.components.navigation

Page = Box {
    top = head.Head {},
    side = rail.Rail {},
    cards = places.Places {},
    foot = navigation.Navigation {},
    edge = 28,
    above = 0,
    below = 0

    skill jtml() {
        @upper = top.jtml()
        @left = side.jtml()
        @middle = cards.jtml()
        @lower = foot.jtml()
        @upper_room = 20 + above
        out "\{\"box\": \{\"fill\": \"ground\", \"gap\": 0, \"children\": [\{\"box\": \{\"grow\": 1, \"padding\": [{upper_room}, {edge}, 16, {edge}], \"gap\": 20, \"children\": [{upper}, \{\"box\": \{\"flow\": \"row\", \"grow\": 1, \"gap\": {edge}, \"children\": [{left}, {middle}]\}\}]\}\}, \{\"box\": \{\"fill\": \"panel\", \"padding\": [0, 0, {below}, 0], \"gap\": 0, \"children\": [{lower}]\}\}]\}\}"
    }
}

skill narrow() {
    out Page { cards = places.Places { columns = 2, width = 149, height = 150 }, foot = navigation.Navigation { width = 74 }, edge = 14, above = 40, below = 48 }
}
