-- navigation — нижняя навигация алхимии: пять разделов со значками, выбранный
-- — изумрудный; вид — жители nav-item, nav-item-active и bottom-nav.
--
-- Navigation { active, width } — выбранный раздел, ширина пункта; jtml() -> текст JTML

use core.group
use tarantul.uiengine.jtml.calls

ITEMS = ["Главная", "Гильдия", "Тренировка", "Профиль", "Словарь"]
ICONS = ["house", "shield", "flask-conical", "user-round", "book-open"]

Navigation = Box {
    active = "Гильдия",
    width = 120

    skill jtml() {
        @items = []
        drum (group.count(ITEMS)) {
            @name = group.get(ITEMS, beat)
            @kind = "nav-item"
            (name == active) { kind = "nav-item-active" }
            items = group.add(items, calls.call(kind, [["icon", calls.quoted(group.get(ICONS, beat))], ["text", calls.quoted(name)], ["width", "{width}"]]))
        }
        out calls.call("bottom-nav", [["items", calls.listed(items)]])
    }
}
