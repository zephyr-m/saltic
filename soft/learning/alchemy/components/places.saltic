-- places — локации гильдии: «Локации» — четыре карточки в ряд, «Особые места»
-- — две; у карточки имя, ранг в монетке (нет ранга — «?»; у особых мест
-- ранга нет вовсе, rank "" — житель special-card) и строка состояния.
-- Картинок локаций пока нет (нет разбора PNG) — карточка без фона-рисунка.
--
-- Place { title, rank, note } — одна карточка
-- Places { main, special, columns, width, height } — две группы карточек,
--     карточек в ряду и размер карточки; jtml() -> текст JTML
-- Внутри: cards(list, [columns, width, height]) -> ряды карточек; row(made) -> ряд

use core.str
use core.group
use tarantul.uiengine.jtml.calls

Place = Box {
    title = "",
    rank = "?",
    note = ""
}

Places = Box {
    main = [Place { title = "Пещера слизней", rank = "E", note = "Побеждено: 0 из 6" }, Place { title = "Логово неправильных гоблинов", rank = "E", note = "Пока закрыто" }, Place { title = "Башня времён", note = "Пока закрыто" }, Place { title = "Долина суккубов", note = "Пока закрыто" }],
    columns = 4,
    width = 300,
    height = 190,
    special = [Place { title = "Равнина парящих слов", rank = "", note = "Свитки: 5 / 98" }, Place { title = "Эльфийский лес", rank = "", note = "Духи: 0 / 6 · закрыто" }]

    skill jtml() {
        @first = calls.call("section-title", [["text", calls.quoted("Локации")]])
        @second = calls.call("section-title", [["text", calls.quoted("Особые места")]])
        @upper = cards(main, [columns, width, height])
        @lower = cards(special, [columns, width, height])
        out "\{\"box\": \{\"grow\": 1, \"gap\": 14, \"children\": [{first}, {upper}, {second}, {lower}]\}\}"
    }
}

skill cards(list, shape) {
    @columns = group.get(shape, 0)
    @width = group.get(shape, 1)
    @height = group.get(shape, 2)
    @rows = []
    @made = []
    drum (list) {
        @kind = "location-card"
        @pairs = [["title", calls.quoted(beat.title)], ["note", calls.quoted(beat.note)], ["width", "{width}"], ["height", "{height}"]]
        (str.bytes(beat.rank) > 0) { pairs = group.add(pairs, ["rank", calls.quoted(beat.rank)]) }
        (str.bytes(beat.rank) == 0) { kind = "special-card" }
        made = group.add(made, calls.call(kind, pairs))
        (group.count(made) == columns) {
            rows = group.add(rows, row(made))
            made = []
        }
    }
    (group.count(made) > 0) { rows = group.add(rows, row(made)) }
    @inside = calls.join(rows)
    out "\{\"box\": \{\"gap\": 12, \"children\": [{inside}]\}\}"
}

skill row(made) {
    @inside = calls.join(made)
    out "\{\"box\": \{\"flow\": \"row\", \"gap\": 12, \"children\": [{inside}]\}\}"
}
