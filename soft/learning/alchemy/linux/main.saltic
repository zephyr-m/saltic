-- alchemy — алхимия языка (экран «Гильдия · Локации») в окне Wayland.
-- Страница та же, что на Acer: programs/alchemy/page (компоненты и жители
-- библиотеки), тема alchemy (themes), рисунок atoms.draw
-- шрифтами TTF из os/fonts и значками os/icons в адаптер os.target.linux.screen. Кнопки шапки:
-- Esc или закрытие окна — выход.
--
-- program() — вход; face(path) -> Typeface из файла

use core.bytes
use core.group
use core.socket
use io.file
use tarantul.icons.icons
use tarantul.fonts.ttf
use tarantul.uiengine.jtml.read
use tarantul.uiengine.draw.typeface
use tarantul.uiengine.jtml
use tarantul.wayland.wayland.screen
use tarantul.uiengine.draw.atoms
use soft.learning.alchemy.page
use tarantul.uiengine.themes

REGULAR = "tarantul/fonts/inter/Inter-Regular.ttf"
BOLD = "tarantul/fonts/inter/Inter-Bold.ttf"
MONO = "tarantul/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
ICONS = "tarantul/icons/lucide/icons.txt"

skill face(path) {
    out typeface.from_bytes(file.read_bytes(path))
}

program() {
    @host = screen.open()
    (group.count(host) == 0) { out none }
    @canvas = group.get(host, 0)
    @link = group.get(host, 1)
    @palette = atoms.with_faces(themes.named("alchemy", canvas), face(REGULAR), face(BOLD), face(MONO))
    @sheet = file.read_bytes(ICONS)
    palette = atoms.with_icons(palette, icons.open(ttf.from_bytes(sheet), bytes.count(sheet)))
    @view = page.Page {}
    @tree = atoms.fitted(read.page(view.jtml()), no, palette)
    @runtime = jtml.mount(canvas, tree)
    atoms.draw(canvas, runtime, palette)
    screen.present(link)
    @packet = bytes.new(8192)
    @hold = bytes.new(4096)
    @joined = bytes.new(12288)
    always {
        (link.way_closed == yes) { leave }
        (link.way_failed == yes) { leave }
        (link.way_clicked == yes) {
            link.way_clicked = no
            @hit = jtml.hit(runtime, link.way_click_x, link.way_click_y)
            (hit.id == "close") { leave }
            (hit.id == "minimize") { screen.minimize(link) }
        }
        screen.pump(link, packet, hold, joined)
        socket.sleep(50)
    }
    out none
}
