-- node — объект сцены редактора «Сцена»: свои имя, вид, значок, место в
-- дереве и свойства, сам знает, как выглядит строкой дерева и как — в
-- инспекторе. Данные — образец (движка ещё нет), так и подписано у окна.
--
-- Node { name, kind, icon, tone, depth, group, position, rotation, scale,
--     light, rough, metal, triangles, tags } — kind — «группа», «меш», «свет»,
--     «камера»; group — yes у папки сцены; position, rotation, scale — текст
--     «x y z»; light, rough, metal — 0…100; triangles — число; tags — группа
-- row(id, chosen) -> JTML строки дерева: группа — tree-group, остальное —
--     menu-row (выбранный — menu-row-current)
-- details() -> группа JTML инспектора: трансформ, материал, теги
-- Внутри: axes(label, text, id) — поле «x y z» одной строкой

use core.str
use core.group
use tarantul.uiengine.jtml.calls

INDENT = "    "

Node = Box {
    name = "",
    kind = "меш",
    icon = "box",
    tone = "quiet",
    depth = 0,
    group = no,
    position = "0 0 0",
    rotation = "0 0 0",
    scale = "1 1 1",
    light = 50,
    rough = 50,
    metal = 0,
    triangles = 0,
    tags = []

    skill row(id, chosen) {
        @shift = ""
        drum (depth) { shift = "{shift}{INDENT}" }
        @label = "{shift}{name}"
        (group == yes) { out calls.call("tree-group", [["id", calls.quoted(id)], ["chevron", calls.quoted("chevron-down")], ["text", calls.quoted(label)], ["count", calls.quoted(kind)]]) }
        @kind_row = "menu-row"
        (chosen == yes) { kind_row = "menu-row-current" }
        @count = "{triangles}"
        (triangles == 0) { count = kind }
        out calls.call(kind_row, [["id", calls.quoted(id)], ["icon", calls.quoted(icon)], ["text", calls.quoted(label)], ["count", calls.quoted(count)]])
    }

    skill axes(label, text, id) {
        @spaced = str.join(str.split(text, " "), "   ")
        out [calls.call("labeled-field", [["label", calls.quoted(label)], ["id", calls.quoted(id)], ["value", calls.quoted(spaced)]])]
    }

    skill details() {
        @made = [calls.call("section-head", [["text", calls.quoted(name)]]), calls.call("detail-row", [["label", calls.quoted("вид")], ["value", calls.quoted(kind)]])]
        made = group.add(made, calls.call("section-head", [["text", calls.quoted("трансформ · x y z")]]))
        made = group.concat(made, axes("место", position, "position"))
        made = group.concat(made, axes("поворот", rotation, "rotation"))
        made = group.concat(made, axes("масштаб", scale, "scale"))
        made = group.add(made, calls.call("section-head", [["text", calls.quoted("материал")]]))
        made = group.add(made, calls.call("labeled-slider", [["label", calls.quoted("свет")], ["id", calls.quoted("light")], ["value", "{light}"], ["min", "0"], ["max", "100"], ["unit", calls.quoted("{light}")]]))
        made = group.add(made, calls.call("labeled-slider", [["label", calls.quoted("грубость")], ["id", calls.quoted("rough")], ["value", "{rough}"], ["min", "0"], ["max", "100"], ["unit", calls.quoted("{rough}")]]))
        made = group.add(made, calls.call("labeled-slider", [["label", calls.quoted("металл")], ["id", calls.quoted("metal")], ["value", "{metal}"], ["min", "0"], ["max", "100"], ["unit", calls.quoted("{metal}")]]))
        @chips = []
        drum (tags) { chips = group.add(chips, calls.call("chip", [["text", calls.quoted(beat)], ["fill", calls.quoted("raise")], ["tone", calls.quoted("ink")]])) }
        (group.count(chips) > 0) {
            @inside = calls.join(chips)
            made = group.add(made, "\{\"box\": \{\"flow\": \"row\", \"gap\": 6, \"children\": [{inside}]\}\}")
        }
        out made
    }
}
