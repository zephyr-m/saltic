-- editor — страница редактора «Сцена»: держит сцену, вьюпорт, таймлайн и
-- журнал и ставит их по местам: сверху — шапка с режимами, слева —
-- инструменты и дерево сцены, в середине — вьюпорт и таймлайн, справа —
-- инспектор выбранного объекта, снизу — журнал, сводка кадра и строка
-- состояния. Своего вида нет — только жители; данные — образец.
--
-- Editor { world, view, tape, notes } — сцена, вьюпорт, таймлайн, журнал
-- jtml() -> JTML всего окна; choose(id) -> yes, если щелчок что-то поменял
-- Внутри: shelf(flow, gap, grow, items) — ряд или столбик; head() — шапка

use tarantul.uiengine.jtml.calls
use soft.graphics.scene.scene
use soft.graphics.scene.viewport
use soft.graphics.scene.timeline
use soft.graphics.scene.journal

Editor = Box {
    world = scene.Scene {},
    view = viewport.Viewport {},
    tape = timeline.Timeline {},
    notes = journal.Journal {}

    skill shelf(flow, gap, grow, items) {
        @inside = calls.join(items)
        out "\{\"box\": \{\"flow\": \"{flow}\", \"gap\": {gap}, \"grow\": {grow}, \"children\": [{inside}]\}\}"
    }

    skill head() {
        @name = calls.call("figure", [["text", calls.quoted("Сцена")], ["size", "20"], ["tone", calls.quoted("ink")]])
        @file = calls.call("badge", [["text", calls.quoted("комната с садом · образец")], ["tone", calls.quoted("quiet")]])
        @render = calls.call("chip", [["text", calls.quoted("рендер")], ["fill", calls.quoted("accent_soft")], ["tone", calls.quoted("accent")]])
        @save = calls.call("chip", [["text", calls.quoted("сохранить")], ["fill", calls.quoted("panel")], ["tone", calls.quoted("quiet")]])
        @gap = "\{\"box\": \{\"grow\": 1, \"gap\": 0\}\}"
        @modes = shelf("row", 6, 0, world.modes())
        @row = "\{\"box\": \{\"flow\": \"row\", \"gap\": 14, \"align\": \"center\", \"children\": [{name}, {file}, {modes}, {gap}, {render}, {save}]\}\}"
        out calls.call("top-bar", [["height", "60"], ["children", calls.listed([row])]])
    }

    skill jtml() {
        @triangles = world.triangles()
        @tools = world.tools()
        @left = shelf("row", 12, 0, ["\{\"box\": \{\"padding\": [4, 0, 0, 0], \"gap\": 0, \"children\": [{tools}]\}\}", world.tree()])
        view.triangles = triangles
        @middle = shelf("column", 12, 1, [view.jtml(), tape.jtml()])
        @body = shelf("row", 12, 1, [left, middle, world.inspector()])
        @bottom = shelf("row", 12, 0, [notes.jtml(), notes.summary(triangles)])
        @tool = world.tool
        @mode = world.mode
        @status = calls.call("status-bar", [["text", calls.quoted("инструмент: {tool} · режим: {mode} · {triangles} треугольников · образец: движка ещё нет")], ["height", "28"]])
        @work = "\{\"box\": \{\"grow\": 1, \"gap\": 12, \"padding\": [12, 12, 12, 12], \"children\": [{body}, {bottom}]\}\}"
        @top = head()
        out "\{\"box\": \{\"fill\": \"ground\", \"gap\": 0, \"grow\": 1, \"children\": [{top}, {work}, {status}]\}\}"
    }

    skill choose(id) {
        out world.choose(id)
    }
}
