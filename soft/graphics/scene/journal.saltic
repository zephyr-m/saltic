-- journal — журнал редактора «Сцена»: строки со временем, что делала сцена
-- (загрузка, запекание света, сборка); рядом — сводка памяти и кадров.
-- Образец, так и подписано.
--
-- Journal { lines, frames } — строки [время, текст, тон], длительность
--     последних кадров в мс
-- jtml() -> JTML панели журнала; summary(triangles) -> JTML сводки

use core.group
use tarantul.uiengine.jtml.calls

Journal = Box {
    lines = [["04:51:02", "сцена «комната с садом» открыта — 12 объектов", ""], ["04:51:02", "текстуры: 9 файлов, 48 МБ", ""], ["04:51:03", "запекаю свет: солнце, лампа, окно", ""], ["04:51:07", "свет запечён за 4.1 с", "up"], ["04:51:07", "дерево: 18 400 треугольников — больше бюджета куста", "mustard"], ["04:51:08", "камни: нет карты нормалей", "down"], ["04:51:09", "кадр 36 — ключ у чашки", ""]],
    frames = [16, 17, 16, 18, 22, 16, 15, 16, 17, 30, 16, 16, 17, 16]

    skill jtml() {
        @rows = []
        drum (lines) { rows = group.add(rows, calls.call("log-line", [["time", calls.quoted(group.get(beat, 0))], ["text", calls.quoted(group.get(beat, 1))], ["tone", calls.quoted(group.get(beat, 2))]])) }
        out calls.call("console-panel", [["title", calls.quoted("журнал")], ["note", calls.quoted("образец")], ["width", "0"], ["radius", "14"], ["grow", "1"], ["children", calls.listed(rows)]])
    }

    skill summary(triangles) {
        @bars = []
        drum (frames) {
            @tone = "accent_rim"
            (beat > 20) { tone = "down" }
            @tall = beat * 2
            bars = group.add(bars, calls.call("bar", [["width", "10"], ["height", "{tall}"], ["tone", calls.quoted(tone)], ["radius", "3"]]))
        }
        @spark = calls.call("spark", [["bars", calls.listed(bars)]])
        @memory = calls.call("gauge", [["label", calls.quoted("видеопамять")], ["fill", "150"], ["tone", calls.quoted("accent")], ["text", calls.quoted("1.2 из 2 ГБ")], ["size", "13"], ["small", "11"]])
        @share = triangles * 220 / 50000
        @budget = calls.call("gauge", [["label", calls.quoted("треугольники")], ["fill", "{share}"], ["tone", calls.quoted("mustard")], ["text", calls.quoted("{triangles} из 50 000")], ["size", "13"], ["small", "11"]])
        @made = calls.call("donut", [["size", "124"], ["first", "180"], ["second", "120"], ["third", "60"], ["note", calls.quoted("время кадра")]])
        @gauges = "\{\"box\": \{\"width\": 220, \"gap\": 14, \"children\": [{memory}, {budget}]\}\}"
        @inside = "\{\"box\": \{\"flow\": \"row\", \"gap\": 22, \"align\": \"center\", \"children\": [{made}, {gauges}, {spark}]\}\}"
        out calls.call("console-panel", [["title", calls.quoted("кадр")], ["note", calls.quoted("последние 14 кадров, мс")], ["width", "0"], ["radius", "14"], ["grow", "0"], ["children", calls.listed([inside])]])
    }
}
