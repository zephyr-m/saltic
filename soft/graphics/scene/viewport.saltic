-- viewport — середина редактора «Сцена»: место, где будет рисовать движок
-- (честно пустое и так и подписано), на сетке с фонариком; поверх — компас
-- осей, кадры в секунду, нагрузка и бюджет треугольников. Числа — образец.
--
-- Viewport { fps, load, budget, triangles } — кадров в секунду, нагрузка в
--     процентах, предел и число треугольников сцены
-- jtml() -> JTML вьюпорта

use tarantul.uiengine.jtml.calls

Viewport = Box {
    fps = 60,
    load = 42,
    budget = 50000,
    triangles = 0

    skill jtml() {
        @share = triangles * 100 / budget
        @arc = share * 360 / 100
        @spent = calls.call("progress-ring", [["size", "92"], ["sweep", "{arc}"], ["tone", calls.quoted("accent")], ["value", calls.quoted("{share}%")], ["note", calls.quoted("треугольники")]])
        @frames = calls.call("dial", [["size", "104"], ["sweep", "{fps}"], ["tone", calls.quoted("up")], ["value", calls.quoted("{fps}")], ["note", calls.quoted("кадров/с")]])
        @busy = load * 180 / 100
        @heat = calls.call("dial", [["size", "104"], ["sweep", "{busy}"], ["tone", calls.quoted("mustard")], ["value", calls.quoted("{load}%")], ["note", calls.quoted("нагрузка")]])
        @x = calls.call("badge", [["text", calls.quoted("x")], ["tone", calls.quoted("down")]])
        @y = calls.call("badge", [["text", calls.quoted("y")], ["tone", calls.quoted("up")]])
        @z = calls.call("badge", [["text", calls.quoted("z")], ["tone", calls.quoted("info")]])
        @compass = calls.call("ring", [["size", "92"], ["tone", calls.quoted("line")], ["border", "2"], ["children", calls.listed(["\{\"box\": \{\"flow\": \"row\", \"gap\": 4, \"children\": [{x}, {y}, {z}]\}\}"])]])
        @title = calls.call("headline", [["text", calls.quoted("здесь рисует движок")]])
        @note = calls.call("hint", [["text", calls.quoted("вьюпорт пуст: 3D-движка в окне ещё нет, сцена и числа — образец")]])
        @middle = "\{\"box\": \{\"grow\": 1, \"gap\": 8, \"justify\": \"center\", \"align\": \"center\", \"children\": [{title}, {note}]\}\}"
        @gauges = "\{\"box\": \{\"flow\": \"row\", \"gap\": 18, \"padding\": [14, 16, 14, 16], \"justify\": \"end\", \"align\": \"center\", \"children\": [{compass}, {spent}, {frames}, {heat}]\}\}"
        out calls.call("plate", [["tone", calls.quoted("ground")], ["grow", "1"], ["children", calls.listed([gauges, middle])]])
    }
}
