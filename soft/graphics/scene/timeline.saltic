-- timeline — таймлайн анимации редактора «Сцена»: линейка кадров, дорожки
-- объектов с ключами и текущий кадр; кнопки «играть» и «пауза». Образец.
--
-- Timeline { frame, length, tracks } — текущий кадр, кадров всего, дорожки
--     [имя, тон, ключи — группа номеров кадров]
-- jtml() -> JTML панели таймлайна
-- Внутри: ruler() — линейка кадров; track(item) — дорожка с ключами

use core.group
use tarantul.uiengine.jtml.calls

STEP = 10
CELL = 52

Timeline = Box {
    frame = 36,
    length = 120,
    tracks = [["камера", "accent", [0, 30, 60, 90, 120]], ["солнце", "mustard", [0, 120]], ["лампа", "up", [20, 40, 70]], ["чашка", "info", [36, 48]]]

    skill ruler() {
        @marks = [calls.call("tick-label", [["text", calls.quoted("")], ["width", "90"], ["height", "18"]])]
        drum (length / STEP + 1) {
            @at = beat * STEP
            marks = group.add(marks, calls.call("tick-label", [["text", calls.quoted("{at}")], ["width", "{CELL}"], ["height", "18"]]))
        }
        @inside = calls.join(marks)
        out "\{\"box\": \{\"flow\": \"row\", \"gap\": 0, \"children\": [{inside}]\}\}"
    }

    skill track(item) {
        @name = group.get(item, 0)
        @tone = group.get(item, 1)
        @keys = group.get(item, 2)
        @cells = [calls.call("tick-label", [["text", calls.quoted(name)], ["width", "90"], ["height", "22"]])]
        drum (length / STEP + 1) {
            @at = beat * STEP
            @mark = calls.call("bar", [["width", "6"], ["height", "6"], ["tone", calls.quoted("line")], ["radius", "3"]])
            (group.contains(keys, at) == yes) { mark = calls.call("bar", [["width", "12"], ["height", "12"], ["tone", calls.quoted(tone)], ["radius", "6"]]) }
            cells = group.add(cells, "\{\"box\": \{\"width\": {CELL}, \"height\": 22, \"gap\": 0, \"align\": \"start\", \"justify\": \"center\", \"children\": [{mark}]\}\}")
        }
        @inside = calls.join(cells)
        out "\{\"box\": \{\"flow\": \"row\", \"gap\": 0, \"align\": \"center\", \"children\": [{inside}]\}\}"
    }

    skill jtml() {
        @rows = [ruler()]
        drum (tracks) { rows = group.add(rows, track(beat)) }
        @play = calls.call("chip", [["text", calls.quoted("▶ играть")], ["fill", calls.quoted("up_soft")], ["tone", calls.quoted("up")]])
        @stop = calls.call("chip", [["text", calls.quoted("пауза")], ["fill", calls.quoted("panel")], ["tone", calls.quoted("quiet")]])
        @where = calls.call("badge", [["text", calls.quoted("кадр {frame} из {length}")], ["tone", calls.quoted("accent")]])
        @controls = "\{\"box\": \{\"flow\": \"row\", \"gap\": 8, \"align\": \"center\", \"children\": [{play}, {stop}, {where}]\}\}"
        rows = group.add(rows, controls)
        out calls.call("console-panel", [["title", calls.quoted("таймлайн")], ["note", calls.quoted("24 кадра/с · образец")], ["width", "0"], ["radius", "14"], ["grow", "1"], ["children", calls.listed(rows)]])
    }
}
