-- scene — сцена редактора: свои объекты (Node) по порядку дерева, выбранный
-- объект, инструмент и режим. Сама знает свой образец, своё дерево и свой
-- инспектор; щелчок по строке дерева, инструменту или режиму меняет её.
--
-- Scene { nodes, chosen, tool, mode } — объекты, номер выбранного, имена
--     инструмента и режима
-- sample() — наполнить образцом: камера, свет, комната, стол, лампа
-- tree() -> JTML панели дерева; inspector() -> JTML панели инспектора
-- choose(id) -> yes, если щелчок что-то поменял: NODE и номер — объект,
--     TOOL и имя — инструмент, MODE и имя — режим
-- triangles() -> сумма треугольников; tools() / modes() -> JTML кнопок
-- TOOLS, MODES — [значок, имя]

use core.str
use core.group
use os.text.parse
use tarantul.uiengine.jtml.calls
use soft.graphics.scene.node

NODE = "node:"
TOOL = "tool:"
MODE = "mode:"
TOOLS = [["mouse-pointer-2", "выбор"], ["move", "сдвиг"], ["rotate-3d", "поворот"], ["scale-3d", "масштаб"], ["ruler", "линейка"], ["magnet", "магнит"], ["brush", "кисть"]]
MODES = [["box", "объекты"], ["triangle", "грани"], ["palette", "материалы"], ["film", "анимация"]]

Scene = Box {
    nodes = [],
    chosen = 3,
    tool = "сдвиг",
    mode = "объекты"

    skill sample() {
        nodes = [node.Node { name = "камера", kind = "камера", icon = "camera", position = "4.2 2.6 6.0", rotation = "-18 34 0", tags = ["главная"] }, node.Node { name = "солнце", kind = "свет", icon = "sun", position = "0 12 0", rotation = "-55 20 0", light = 92, tags = ["тени", "тёплый"] }, node.Node { name = "комната", kind = "группа", group = yes }, node.Node { name = "пол", depth = 1, icon = "square", triangles = 2, rough = 80, tags = ["дерево"] }, node.Node { name = "стены", depth = 1, icon = "cuboid", triangles = 48, rough = 90 }, node.Node { name = "стол", depth = 1, icon = "cuboid", position = "0.8 0 -0.4", rotation = "0 12 0", triangles = 1260, rough = 60, metal = 5, tags = ["дуб", "мебель"] }, node.Node { name = "лампа", depth = 1, icon = "lightbulb", position = "0.9 1.1 -0.5", triangles = 3420, light = 74, metal = 80, rough = 20, tags = ["свет", "латунь"] }, node.Node { name = "чашка", depth = 1, icon = "cylinder", position = "0.4 0.78 -0.2", triangles = 960, rough = 35, tags = ["керамика"] }, node.Node { name = "окно", depth = 1, icon = "aperture", triangles = 220, light = 60 }, node.Node { name = "сад", kind = "группа", group = yes }, node.Node { name = "дерево", depth = 1, icon = "cone", triangles = 18400, rough = 95, tags = ["листва"] }, node.Node { name = "камни", depth = 1, icon = "torus", triangles = 6200, rough = 100 }]
        out none
    }

    skill triangles() {
        @sum = 0
        drum (nodes) { sum = sum + beat.triangles }
        out sum
    }

    skill tree() {
        @rows = []
        drum (group.count(nodes)) {
            @item = group.get(nodes, beat)
            rows = group.add(rows, item.row("{NODE}{beat}", beat == chosen))
        }
        @many = group.count(nodes)
        out calls.call("console-panel", [["title", calls.quoted("сцена")], ["note", calls.quoted("{many} объектов")], ["width", "270"], ["radius", "14"], ["grow", "0"], ["children", calls.listed(rows)]])
    }

    skill inspector() {
        @item = group.get(nodes, chosen)
        out calls.call("console-panel", [["title", calls.quoted("инспектор")], ["note", calls.quoted(item.kind)], ["width", "330"], ["radius", "14"], ["grow", "0"], ["children", calls.listed(item.details())]])
    }

    skill tools() {
        @made = []
        drum (TOOLS) {
            @icon = group.get(beat, 0)
            @name = group.get(beat, 1)
            @kind = "rail-button"
            (name == tool) { kind = "rail-button-active" }
            @button = calls.call(kind, [["icon", calls.quoted(icon)]])
            made = group.add(made, "\{\"box\": \{\"id\": \"{TOOL}{name}\", \"gap\": 0, \"children\": [{button}]\}\}")
        }
        out calls.call("section-rail", [["buttons", calls.listed(made)]])
    }

    skill modes() {
        @made = []
        drum (MODES) {
            @icon = group.get(beat, 0)
            @name = group.get(beat, 1)
            @button = calls.call("chip", [["text", calls.quoted(name)], ["fill", calls.quoted("panel")], ["tone", calls.quoted("quiet")]])
            (name == mode) { button = calls.call("mode-active", [["text", calls.quoted(name)], ["icon", calls.quoted(icon)]]) }
            made = group.add(made, "\{\"box\": \{\"id\": \"{MODE}{name}\", \"gap\": 0, \"children\": [{button}]\}\}")
        }
        out made
    }

    skill choose(id) {
        (str.starts_with(id, NODE) == yes) {
            @at = parse.parse_size(str.slice(id, str.bytes(NODE), str.bytes(id)))
            @item = group.get(nodes, at)
            (item.group == yes) { out no }
            chosen = at
            out yes
        }
        (str.starts_with(id, TOOL) == yes) {
            tool = str.slice(id, str.bytes(TOOL), str.bytes(id))
            out yes
        }
        (str.starts_with(id, MODE) == yes) {
            mode = str.slice(id, str.bytes(MODE), str.bytes(id))
            out yes
        }
        out no
    }
}
