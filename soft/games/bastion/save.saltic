-- save — сохранение «Бастиона» в файл строками «ключ=значение», башни —
-- «tower=код,столбец,строка,уровень». Отлучка считается честно, по скорости,
-- которую намерила сама игра: золото и волны за всё прожитое время (earned,
-- cleared за played мс) умножаются на мс отлучки. Часы языка — мс от полуночи,
-- поэтому отлучка дольше суток видна как остаток от суток.
--
-- Keeper { path } — где лежит файл
--     store(realm, clock) — записать мир и время clock (time.now)
--     restore(realm, clock) — прочитать, если есть, и начислить отлучку; нет
--         файла — мир остаётся первым запуском
--     number_of(text) -> число из десятичного текста со знаком
--     value_of(line) -> текст после «=»

use io.file
use core.str
use core.num
use core.group
use core.time
use soft.games.bastion.world.tower

Keeper = Box {
    path = ".cache/bastion.save"

    skill store(realm, clock) {
        @master = 0
        (realm.master == yes) {
            master = 1
        }
        @lines = [
            "saved={clock}",
            "wave={realm.wave}",
            "gold={realm.gold}",
            "lives={realm.lives}",
            "damage_level={realm.damage_level}",
            "speed_level={realm.speed_level}",
            "income_level={realm.income_level}",
            "earned={realm.earned}",
            "cleared={realm.cleared}",
            "played={realm.played}",
            "master={master}"
        ]
        drum (realm.towers) {
            @code = beat.code()
            lines = group.add(lines, "tower={code},{beat.column},{beat.row},{beat.level}")
        }
        file.write(path, str.join(lines, "\n"))
        out none
    }

    skill restore(realm, clock) {
        @text = file.read(path) rescue |missing| {
            out none
        }
        @saved = clock
        @towers = []
        drum (str.lines(text)) {
            @value = value_of(beat)
            (str.starts_with(beat, "saved=") == yes) {
                saved = number_of(value)
            }
            (str.starts_with(beat, "wave=") == yes) {
                realm.wave = number_of(value)
            }
            (str.starts_with(beat, "gold=") == yes) {
                realm.gold = number_of(value)
            }
            (str.starts_with(beat, "lives=") == yes) {
                realm.lives = number_of(value)
            }
            (str.starts_with(beat, "damage_level=") == yes) {
                realm.damage_level = number_of(value)
            }
            (str.starts_with(beat, "speed_level=") == yes) {
                realm.speed_level = number_of(value)
            }
            (str.starts_with(beat, "income_level=") == yes) {
                realm.income_level = number_of(value)
            }
            (str.starts_with(beat, "earned=") == yes) {
                realm.earned = number_of(value)
            }
            (str.starts_with(beat, "cleared=") == yes) {
                realm.cleared = number_of(value)
            }
            (str.starts_with(beat, "played=") == yes) {
                realm.played = number_of(value)
            }
            (str.starts_with(beat, "master=") == yes) {
                realm.master = (number_of(value) == 1)
            }
            (str.starts_with(beat, "tower=") == yes) {
                @parts = str.split(value, ",")
                towers = group.add(towers, tower.tower_of(number_of(group.get(parts, 0)), number_of(group.get(parts, 1)), number_of(group.get(parts, 2)), number_of(group.get(parts, 3))))
            }
        }
        realm.towers = towers
        realm.first = no
        @away = clock - saved
        (away < 0) {
            away = away + time.DAY_MILLISECONDS
        }
        realm.away_minutes = away / 60000
        (realm.played > 0) {
            realm.away_gold = realm.earned * away / realm.played
            realm.away_waves = realm.cleared * away / realm.played
        }
        realm.gold = realm.gold + realm.away_gold
        realm.wave = realm.wave + realm.away_waves
        out none
    }

    skill value_of(line) {
        @parts = str.split(line, "=")
        (group.count(parts) < 2) {
            out ""
        }
        out group.get(parts, 1)
    }

    skill number_of(text) {
        @length = str.bytes(text)
        @negative = str.starts_with(text, "-")
        @first = 0
        (negative == yes) {
            first = 1
        }
        @total = 0
        drum (length - first) {
            total = total * 10 + num.digit_value(str.get(text, beat + first))
        }
        (negative == yes) {
            out -total
        }
        out total
    }
}
