-- tower — башня «Бастиона» на клетке поля: вид, радиус, урон, перезарядка.
--
-- Tower { column, row, kind, level, wait } — башня; Kind — ARCHER, CANNON, FROST
--     tone() / title() / icon() -> вид; reach() / power() / pause() -> радиус,
--     урон, перезарядка без улучшений; splashes() / chills() -> бьёт ли по
--     соседям, замедляет ли; code() -> 0, 1, 2
-- tower_of(code, column, row, level) -> Tower по коду вида

Tower = Box {
    column = 0,
    row = 0,
    kind = Kind.ARCHER,
    level = 1,
    wait = 0

    Kind = enum {
        ARCHER,
        CANNON,
        FROST
    }

    skill tone() {
        @shade = "accent"
        (kind) {
            .ARCHER => shade = "accent",
            .CANNON => shade = "down",
            .FROST => shade = "info"
        }
        out shade
    }

    skill title() {
        @name = ""
        (kind) {
            .ARCHER => name = "Лучник",
            .CANNON => name = "Пушка",
            .FROST => name = "Мороз"
        }
        out name
    }

    skill icon() {
        @name = ""
        (kind) {
            .ARCHER => name = "target",
            .CANNON => name = "flame",
            .FROST => name = "snowflake"
        }
        out name
    }

    skill reach() {
        @cells = 0
        (kind) {
            .ARCHER => cells = 260,
            .CANNON => cells = 200,
            .FROST => cells = 220
        }
        out cells
    }

    skill power() {
        @hit = 0
        (kind) {
            .ARCHER => hit = 12,
            .CANNON => hit = 40,
            .FROST => hit = 3
        }
        out hit * level
    }

    skill pause() {
        @time = 0
        (kind) {
            .ARCHER => time = 600,
            .CANNON => time = 1800,
            .FROST => time = 1000
        }
        out time
    }

    skill splashes() {
        out (kind == Kind.CANNON)
    }

    skill chills() {
        out (kind == Kind.FROST)
    }

    skill code() {
        @number = 0
        (kind) {
            .ARCHER => number = 0,
            .CANNON => number = 1,
            .FROST => number = 2
        }
        out number
    }
}

skill tower_of(code, column, row, level) {
    @kind = Tower.Kind.ARCHER
    (code == 1) {
        kind = Tower.Kind.CANNON
    }
    (code == 2) {
        kind = Tower.Kind.FROST
    }
    out Tower {
        column = column,
        row = row,
        kind = kind,
        level = level
    }
}
