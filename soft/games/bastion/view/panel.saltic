-- panel — интерфейс «Бастиона» из жителей закрытой библиотеки UIEngine: шапка
-- (волна, золото с доходом, жизни ядра), место под поле (box с id field —
-- его рисует Field, не UIEngine), справа башни и улучшения, снизу лента
-- «пока тебя не было». Щелчки — по id: buy-archer, buy-cannon, buy-frost,
-- up-damage, up-speed, up-income, up-master, pause.
--
-- Panel { store } — store — лавка (shop.Shop), из неё строки башен и улучшений
--     page(realm) -> JTML всего окна; realm — world.World
--     head(realm) / side(realm) / tape(realm) -> JTML частей
--     tower_card(offer) -> карточка башни; upgrade(offer) -> строка улучшения;
--         offer — shop.offer.Offer
--     clicked(id, button) -> box с id вокруг жителя — цель щелчка
--     grouped(value) -> «12 480»: число с пробелами между тысячами

use core.str
use tarantul.uiengine.jtml.calls
use core.group
use soft.games.bastion.shop

FIELD = "field"
SIDE_WIDTH = 300

Panel = Box {
    store = shop.Shop {}

    skill page(realm) {
        @top = head(realm)
        @right = side(realm)
        @bottom = tape(realm)
        @field = "\{\"box\": \{\"id\": \"{FIELD}\", \"grow\": 1, \"fill\": \"well\", \"radius\": 12, \"gap\": 0\}\}"
        @body = "\{\"box\": \{\"flow\": \"row\", \"grow\": 1, \"gap\": 12, \"padding\": [12, 12, 0, 12], \"children\": [{field}, {right}]\}\}"
        out "\{\"box\": \{\"fill\": \"ground\", \"grow\": 1, \"gap\": 0, \"children\": [{top}, {body}, {bottom}]\}\}"
    }

    skill head(realm) {
        @title = calls.call("headline", [["text", calls.quoted("Бастион")], ["grow", "1"]])
        @wave = calls.call("chip", [["text", calls.quoted("Волна {realm.wave}")], ["fill", calls.quoted("panel")], ["tone", calls.quoted("ink")]])
        @money = grouped(realm.gold)
        @income = grouped(realm.income())
        @gold = calls.call("gold-pill", [["icon", calls.quoted("coins")], ["text", calls.quoted("{money}  +{income}/с")]])
        @lives = calls.call("status", [["icon", calls.quoted("heart")], ["text", calls.quoted("{realm.lives}/{realm.lives_most}")], ["tone", calls.quoted("down")], ["mono", calls.quoted("no")]])
        @word = "Пауза"
        (realm.paused == yes) {
            word = "Дальше"
        }
        @pause = clicked("pause", calls.call("button", [["text", calls.quoted(word)], ["fill", calls.quoted("panel")], ["tone", calls.quoted("ink")]]))
        @row = "\{\"box\": \{\"flow\": \"row\", \"gap\": 14, \"align\": \"center\", \"children\": [{title}, {wave}, {gold}, {lives}, {pause}]\}\}"
        out calls.call("top-bar", [["height", "64"], ["children", calls.listed([row])]])
    }

    skill side(realm) {
        @towers_title = calls.call("section-title", [["text", calls.quoted("Башни")]])
        @cards = []
        drum (store.towers_on_sale(realm)) {
            cards = group.add(cards, tower_card(beat))
        }
        @upgrades_title = calls.call("section-title", [["text", calls.quoted("Улучшения")]])
        @rows = []
        drum (store.upgrades(realm)) {
            rows = group.add(rows, upgrade(beat))
        }
        @shelf = calls.listed(cards)
        @lines = calls.listed(rows)
        @card_box = "\{\"box\": \{\"gap\": 10, \"children\": {shelf}\}\}"
        @row_box = "\{\"box\": \{\"gap\": 8, \"children\": {lines}\}\}"
        out calls.call("side-plate", [["width", "{SIDE_WIDTH}"], ["children", calls.listed([towers_title, card_box, upgrades_title, row_box])]])
    }

    skill tower_card(offer) {
        @crest = calls.call("crest", [["icon", calls.quoted(offer.icon)]])
        @title = calls.call("words", [["text", calls.quoted(offer.title)], ["tone", calls.quoted("ink")], ["weight", calls.quoted("bold")], ["grow", "1"]])
        @owned = calls.call("badge", [["text", calls.quoted("{offer.count}")], ["tone", calls.quoted("accent")]])
        @top = "\{\"box\": \{\"flow\": \"row\", \"gap\": 10, \"align\": \"center\", \"children\": [{crest}, {title}, {owned}]\}\}"
        @power = calls.call("hint", [["text", calls.quoted("урон {offer.power}")]])
        @cost = grouped(offer.price)
        @buy = clicked(offer.id, calls.call("button", [["text", calls.quoted("купить {cost}")], ["fill", calls.quoted("accent")], ["tone", calls.quoted("ground")]]))
        @bottom = "\{\"box\": \{\"flow\": \"row\", \"gap\": 10, \"align\": \"center\", \"justify\": \"between\", \"children\": [{power}, {buy}]\}\}"
        out calls.call("card", [["gap", "10"], ["padding", "12"], ["width", "0"], ["grow", "0"], ["children", calls.listed([top, bottom])]])
    }

    skill upgrade(offer) {
        @title = calls.call("words", [["text", calls.quoted(offer.title)], ["tone", calls.quoted("ink")], ["weight", calls.quoted("regular")], ["grow", "1"]])
        @cost = grouped(offer.price)
        @buy = clicked(offer.id, calls.call("button", [["text", calls.quoted("⇪ {cost}")], ["fill", calls.quoted("panel")], ["tone", calls.quoted("accent")]]))
        (offer.done == yes) {
            buy = calls.call("badge", [["text", calls.quoted("✓")], ["tone", calls.quoted("up")]])
        }
        out "\{\"box\": \{\"flow\": \"row\", \"gap\": 10, \"align\": \"center\", \"children\": [{title}, {buy}]\}\}"
    }

    skill tape(realm) {
        @line = "первый запуск: жми «купить» справа — башня встанет на лучшее место у дорожки"
        (realm.first == no) {
            @money = grouped(realm.away_gold)
            @hours = realm.away_minutes / 60
            @minutes = realm.away_minutes % 60
            line = "{hours} ч {minutes} мин: +{money} золота, пройдено волн: {realm.away_waves}"
        }
        @when = "пока тебя не было"
        (str.bytes(realm.news) > 0) {
            when = "сейчас"
            line = realm.news
        }
        @note = calls.call("event-row", [["time", calls.quoted(when)], ["text", calls.quoted(line)]])
        out "\{\"box\": \{\"padding\": [10, 16, 10, 16], \"gap\": 0, \"children\": [{note}]\}\}"
    }

    skill clicked(id, button) {
        out "\{\"box\": \{\"id\": \"{id}\", \"gap\": 0, \"children\": [{button}]\}\}"
    }

    skill grouped(value) {
        @text = "{value}"
        @length = str.bytes(text)
        @result = ""
        drum (length) {
            @left = length - beat
            ((beat > 0) ○ ((left % 3) == 0)) {
                result = "{result} "
            }
            result = str.concat(result, str.get(text, beat))
        }
        out result
    }
}
