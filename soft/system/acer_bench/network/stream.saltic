-- stream — журнал по кабелю к нам в файл: строка — один кадр UDP с 10.0.0.2 на
-- 10.0.0.1:5557, MAC получателя широковещательный (адрес нашей машины знать не
-- нужно). Принимает tools/log_receiver.py и дописывает в .cache/acer/net.log с
-- нашим временем. Только кабель (rtl8111); ошибок не бросает — не ушло, молчим:
-- журнал не должен ронять того, кого он журналирует.
--
-- send(card, text) — отправить строку (длиннее LIMIT байт — обрезается)

use core.group
use tarantul.rtl8111.rtl8111
use tarantul.net.net
use soft.system.acer_bench.network.netlog.journal

HOST = [10, 0, 0, 1]
SELF = [10, 0, 0, 2]
EVERYONE = [255, 255, 255, 255, 255, 255]
PORT = 5557
LIMIT = 1400

skill send(card, text) {
    @bytes = journal.bytes_of(text)
    (group.count(bytes) > LIMIT) { bytes = group.slice(bytes, 0, LIMIT) }
    rtl8111.send(card, net.udp_frame_bytes(card.mac, SELF, EVERYONE, HOST, PORT, PORT, bytes)) rescue |err| { none }
    out none
}
