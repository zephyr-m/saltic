-- gallery — галерея жителей UIEngine для jtml-view, по уровням (решение автора
-- 17.11.2026): слева меню уровней (атомы, 2, 3, 4 — у каждого число жителей),
-- справа жители выбранного уровня карточками console-panel в COLUMNS колонки:
-- имя, параметры, из чего собран (жители ниже — метками цвета их уровня, и
-- сколько сырых атомов), сам житель с образцами параметров. Образец — по тому,
-- где параметр стоит в теле жителя: значение цвета (fill, tone, edge, ink,
-- fade) — тон accent, в fill — подложка accent_soft, в edge — рамка accent_rim; число (width, height, size, gap, padding, radius, grow,
-- border… и место в at) — число по имени; icon — значок box; перечисление
-- (justify, align, corners, flow…) — первое допустимое из ENUMS; элемент списка
-- (дети) — label «образец»; остальное — текст: имя параметра. Не развернулся —
-- в карточке причина; житель с отступами (padding) у корня стоит своим
-- размером (box с align start), прочие — на всю ширину. Прокрутка — по точкам до конца уровня (offset), корень —
-- viewer-deck: содержимое внизу, меню и шапка слоем сверху.
--
-- Gallery { level, offset, wide, high, view } — уровень, сдвиг содержимого
--     (≤ 0), ширина содержимого, его высота (мерка после смены уровня), высота
--     окна под содержимым
-- choose(id) -> yes, если id — пункт меню уровня (LEVEL и номер)
-- scroll(steps) — на STEP точек за шаг; sized(palette) — высота содержимого
-- jtml() -> текст JTML экрана
-- Внутри: place(text, needle) -> место needle или -1; context(text, param) ->
--     [вид, ключ]; sample(text, param) -> значение JTML; params(text) ->
--     параметры; uses(text) -> [жители внутри]; atoms_in(text) -> рисующих атомов
--     (text, field, slider и box с видом из VISUAL; box-полка — не атом);
--     card(index) — карточка; content() — содержимое уровня; side() — меню
use core.str
use core.group
use tarantul.uiengine.library
use tarantul.uiengine.jtml.read
use tarantul.uiengine.jtml.calls
use tarantul.uiengine.jtml.reader
use tarantul.uiengine.jtml.measure
use tarantul.uiengine.draw.atoms

COLORS = ["fill", "tone", "edge", "ink", "fade"]
NUMBERS = [["width", "160"], ["height", "28"], ["size", "13"], ["gap", "8"], ["padding", "8"], ["radius", "8"], ["grow", "0"], ["border", "1"], ["leading", "0"], ["shadow", "4"], ["inset", "2"], ["level", "40"], ["least", "0"], ["most", "100"]]
GUESSES = [["fill", "80"], ["small", "12"], ["indent", "12"], ["header", "28"], ["footer", "30"], ["offset", "10"], ["lead", "-20"], ["wide", "120"], ["x", "0"], ["y", "0"]]
ENUMS = [["justify", "start"], ["align", "center"], ["corners", "all"], ["flow", "row"], ["cut", "yes"], ["mono", "yes"], ["caps", "yes"], ["weight", "bold"]]
SPACE = 32
VISUAL = ["fill", "edge", "radius", "shadow", "inset", "icon", "ink", "tone", "border", "corners", "fade"]
LEVEL = "level-"
STEP = 80
COLUMNS = 3
GAP = 16
TONES = ["quiet", "quiet", "accent", "mustard", "info"]
ATOM_SAMPLES = [["box", "\{\"box\": \{\"fill\": \"well\", \"edge\": \"line\", \"radius\": 10, \"padding\": 12, \"gap\": 8, \"children\": [\{\"text\": \{\"value\": \"box — всё компонует\"\}\}]\}\}"], ["text", "\{\"text\": \{\"value\": \"text — слова, кегль, жирность, моно\", \"size\": 15\}\}"], ["field", "\{\"field\": \{\"id\": \"образец\", \"value\": \"field — поле ввода\"\}\}"], ["slider", "\{\"slider\": \{\"id\": \"громкость\", \"value\": 40, \"min\": 0, \"max\": 100\}\}"], ["circle", "\{\"box\": \{\"flow\": \"row\", \"gap\": 16, \"children\": [\{\"circle\": \{\"size\": 56, \"fill\": \"accent\"\}\}, \{\"circle\": \{\"size\": 56, \"edge\": \"line\", \"border\": 6, \"children\": [\{\"circle\": \{\"size\": 56, \"edge\": \"accent\", \"border\": 6, \"sweep\": 230\}\}]\}\}, \{\"circle\": \{\"size\": 56, \"fill\": \"mustard\", \"sweep\": 120, \"start\": -90\}\}]\}\}"]]

skill place(text, needle) {
    @size = str.bytes(needle)
    drum (str.bytes(text) - size + 1) {
        (str.slice(text, beat, beat + size) == needle) { out beat }
    }
    out -1
}

skill trimmed(text) {
    @end = str.bytes(text)
    drum (str.bytes(text)) {
        (end > 0) {
            (str.byte(text, end - 1) == SPACE) { end = end - 1 }
        }
    }
    out str.slice(text, 0, end)
}

skill key_before(head) {
    @left = trimmed(head)
    (str.ends_with(left, ":") == no) { out "" }
    @parts = str.split(str.slice(left, 0, str.bytes(left) - 1), "\"")
    out group.get(parts, group.count(parts) - 1)
}

skill context(text, param) {
    @at = place(text, "\"\{{param}\}\"")
    (at < 0) { out ["text", ""] }
    @head = trimmed(str.slice(text, 0, at))
    (str.ends_with(head, ":") == yes) { out ["value", key_before(head)] }
    (str.ends_with(head, "[") == yes) {
        (key_before(str.slice(head, 0, str.bytes(head) - 1)) == "at") { out ["value", "at"] }
        out ["list", ""]
    }
    (str.ends_with(head, ",") == yes) {
        @open = -1
        drum (str.bytes(head)) {
            (str.byte(head, beat) == 91) { open = beat }
            (str.byte(head, beat) == 93) { open = -1 }
        }
        (open >= 0) {
            (key_before(str.slice(head, 0, open)) == "at") { out ["value", "at"] }
        }
        out ["list", ""]
    }
    out ["text", ""]
}

skill number_of(name, fallback) {
    drum (NUMBERS) {
        (group.get(beat, 0) == name) { out group.get(beat, 1) }
    }
    drum (GUESSES) {
        (group.get(beat, 0) == name) { out group.get(beat, 1) }
    }
    out fallback
}

skill sample(text, param) {
    @where = context(text, param)
    @kind = group.get(where, 0)
    @key = group.get(where, 1)
    (kind == "list") { out calls.listed([calls.call("label", [["text", calls.quoted("образец")]])]) }
    (kind == "value") {
        (group.contains(COLORS, key) == yes) {
            (key == "fill") {
                (param == "fill") {
                    (place(text, "\"width\": \"\{fill\}\"") >= 0) { out "80" }
                }
            }
            (key == "fill") { out calls.quoted("accent_soft") }
            (key == "edge") { out calls.quoted("accent_rim") }
            out calls.quoted("accent")
        }
        (key == "icon") { out calls.quoted("box") }
        drum (ENUMS) {
            (group.get(beat, 0) == key) { out calls.quoted(group.get(beat, 1)) }
        }
        (key == "at") { out number_of(param, "0") }
        (group.contains(["width", "height", "size", "gap", "padding", "radius", "grow", "border", "leading", "shadow", "inset", "level", "least", "most"], key) == yes) { out number_of(param, number_of(key, "8")) }
        (key == "value") { out calls.quoted(param) }
    }
    out calls.quoted(param)
}

skill params(text) {
    @root = reader.read_jtml(text)
    @found = []
    drum (group.count(root.keys)) {
        (group.get(root.keys, beat) == "component") {
            @inner = group.get(root.items, beat)
            drum (group.count(inner.keys)) {
                (group.get(inner.keys, beat) == "params") {
                    @list = group.get(inner.items, beat)
                    drum (list.items) { found = group.add(found, beat.words) }
                }
            }
        }
    }
    out found
}

skill parse_level(text) {
    @value = 0
    drum (str.bytes(text)) { value = value * 10 + str.byte(text, beat) - 48 }
    out value
}

skill count_of(text, needle) {
    @size = str.bytes(needle)
    @found = 0
    drum (str.bytes(text) - size + 1) {
        (str.slice(text, beat, beat + size) == needle) { found = found + 1 }
    }
    out found
}

skill uses(text) {
    @found = []
    drum (library.NAMES) {
        (place(text, "\"{beat}\": \{") >= 0) { found = group.add(found, beat) }
    }
    out found
}

skill drawing(value) {
    @found = 0
    (value.kind == reader.Kind.JTML_ARRAY) {
        drum (value.items) { found = found + drawing(beat) }
        out found
    }
    ((value.kind == reader.Kind.JTML_OBJECT) == no) { out 0 }
    drum (group.count(value.keys)) {
        @key = group.get(value.keys, beat)
        @inner = group.get(value.items, beat)
        (group.contains(["text", "field", "slider", "circle"], key) == yes) {
            (inner.kind == reader.Kind.JTML_OBJECT) { found = found + 1 }
        }
        (key == "box") {
            @seen = no
            (inner.kind == reader.Kind.JTML_OBJECT) {
                drum (inner.keys) {
                    (group.contains(VISUAL, beat) == yes) { seen = yes }
                }
            }
            (seen == yes) { found = found + 1 }
        }
        found = found + drawing(inner)
    }
    out found
}

skill atoms_in(text) {
    @root = reader.read_jtml(text)
    @about = group.get(root.items, 0)
    @body = none
    drum (group.count(about.keys)) {
        (group.get(about.keys, beat) == "body") { body = group.get(about.items, beat) }
    }
    out drawing(body)
}

skill level_count(level) {
    @found = 0
    drum (library.LEVELS) {
        (beat == level) { found = found + 1 }
    }
    out found
}

Gallery = Box {
    level = 2,
    offset = 0,
    wide = 1336,
    high = 0,
    view = 900

    skill choose(id) {
        (str.starts_with(id, LEVEL) == no) { out no }
        level = parse_level(str.slice(id, str.bytes(LEVEL), str.bytes(id)))
        offset = 0
        out yes
    }

    skill scroll(steps) {
        offset = offset - steps * STEP
        @least = view - high
        (least > 0) { least = 0 }
        (offset < least) { offset = least }
        (offset > 0) { offset = 0 }
        out none
    }

    skill sized(palette) {
        @tree = atoms.fitted(read.page(content()), no, palette)
        high = measure.node_intrinsic_height(tree)
        out none
    }

    skill card(index) {
        @name = group.get(library.NAMES, index)
        @text = library.find(name)
        @names = params(text)
        @pairs = []
        drum (names) { pairs = group.add(pairs, [beat, sample(text, beat)]) }
        @made = calls.call(name, pairs)
        @inside = made
        read.page(made) rescue |err| { inside = calls.call("label", [["text", calls.quoted("не развернулся: {err}")]]) }
        @list = str.join(names, ", ")
        (group.count(names) == 0) { list = "без параметров" }
        @marks = []
        drum (uses(text)) {
            @used = beat
            @tone = "quiet"
            drum (group.count(library.NAMES)) {
                (group.get(library.NAMES, beat) == used) { tone = group.get(TONES, group.get(library.LEVELS, beat)) }
            }
            marks = group.add(marks, calls.call("badge", [["text", calls.quoted(used)], ["tone", calls.quoted(tone)]]))
        }
        @raw = atoms_in(text)
        marks = group.add(marks, calls.call("badge", [["text", calls.quoted("атомов {raw}")], ["tone", calls.quoted("quiet")]]))
        @padded = place(text, "\"padding\"")
        @nested = place(text, "\"children\"")
        (nested < 0) { nested = str.bytes(text) }
        (padded >= 0) { (padded < nested) { inside = "\{\"box\": \{\"gap\": 0, \"align\": \"start\", \"children\": [{inside}]\}\}" } }
        @meta = calls.call("console-line", [["text", calls.quoted(list)], ["tone", calls.quoted("quiet")], ["size", "11"]])
        @made_of = calls.call("strip", [["gap", "6"], ["children", calls.listed(marks)]])
        @width = (wide - GAP * (COLUMNS - 1)) / COLUMNS
        out calls.call("console-panel", [["title", calls.quoted(name)], ["note", calls.quoted("уровень {level}")], ["width", "{width}"], ["radius", "14"], ["grow", "0"], ["children", calls.listed([meta, made_of, inside])]])
    }

    skill atom_cards() {
        @made = []
        @width = (wide - GAP * (COLUMNS - 1)) / COLUMNS
        drum (ATOM_SAMPLES) {
            @note = calls.call("console-line", [["text", calls.quoted("атом — рисует движок, жителем не бывает")], ["tone", calls.quoted("quiet")], ["size", "11"]])
            made = group.add(made, calls.call("console-panel", [["title", calls.quoted(group.get(beat, 0))], ["note", calls.quoted("уровень 1")], ["width", "{width}"], ["radius", "14"], ["grow", "0"], ["children", calls.listed([note, group.get(beat, 1)])]]))
        }
        out made
    }

    skill content() {
        @cards = []
        (level == 1) { cards = atom_cards() }
        (level > 1) {
            drum (group.count(library.NAMES)) {
                (group.get(library.LEVELS, beat) == level) { cards = group.add(cards, card(beat)) }
            }
        }
        @rows = []
        @at = 0
        drum (group.count(cards)) {
            (at < group.count(cards)) {
                @end = at + COLUMNS
                (end > group.count(cards)) { end = group.count(cards) }
                rows = group.add(rows, calls.call("strip", [["gap", "{GAP}"], ["justify", calls.quoted("start")], ["children", calls.listed(group.slice(cards, at, end))]]))
                at = end
            }
        }
        out calls.call("stack", [["gap", "{GAP}"], ["justify", calls.quoted("start")], ["grow", "0"], ["children", calls.listed(rows)]])
    }

    skill side() {
        @rows = []
        drum (4) {
            @number = beat + 1
            @kind = "file-row"
            (number == level) { kind = "file-row-current" }
            @many = level_count(number)
            @name = "уровень {number} · {many}"
            (number == 1) { name = "атомы · 5" }
            rows = group.add(rows, calls.call(kind, [["id", calls.quoted("{LEVEL}{number}")], ["name", calls.quoted(name)], ["indent", "0"]]))
        }
        out calls.call("side-list", [["title", calls.quoted("уровни")], ["rows", calls.listed(rows)], ["hint", calls.quoted("колесо — листать")], ["width", "232"]])
    }

    skill jtml() {
        @title = calls.call("figure", [["text", calls.quoted("Жители UIEngine")], ["size", "20"], ["tone", calls.quoted("ink")]])
        @total = group.count(library.NAMES)
        @count = calls.call("badge", [["text", calls.quoted("{total}")], ["tone", calls.quoted("mustard")]])
        @hint = calls.call("label", [["text", calls.quoted("метки — из каких жителей собран (цвет — их уровень), «атомов» — сколько сырых")]])
        @head = calls.call("strip", [["gap", "12"], ["children", calls.listed([title, count, hint])]])
        out calls.call("viewer-deck", [["side", side()], ["head", head], ["content", content()], ["offset", "{offset}"], ["wide", "{wide}"]])
    }
}
