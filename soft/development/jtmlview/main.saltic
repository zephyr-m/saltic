-- jtmlview — jtml-view: жители UIEngine, нарисованные настоящим UIEngine, в
-- окне Wayland (решение автора 17.11.2026 — вместо расширения браузера: один
-- движок, без второго рисовальщика на JS). Галерея всех жителей закрытой
-- библиотеки по уровням — jtmlview/gallery; тёмная палитра (язык вида —
-- docs/design/LANGUAGE.md), шрифты TTF из os/fonts, значки icons. Щелчок
-- по уровню в меню — его жители, колесо — прокрутка до конца уровня
-- (input/gestures), «×» окна — выход.
--
-- program() — вход; face(path) -> Typeface из файла; drawn(canvas, view,
--     palette) -> runtime нарисованной галереи (для попаданий щелчка)

use core.bytes
use core.group
use core.socket
use io.file
use tarantul.icons.icons
use tarantul.fonts.ttf
use tarantul.input.gestures
use tarantul.wayland.wayland.screen
use soft.development.jtmlview.gallery
use tarantul.uiengine.jtml
use tarantul.uiengine.jtml.read
use tarantul.uiengine.draw.atoms
use tarantul.uiengine.draw.typeface
use tarantul.uiengine.themes

REGULAR = "tarantul/fonts/inter/Inter-Regular.ttf"
BOLD = "tarantul/fonts/inter/Inter-Bold.ttf"
MONO = "tarantul/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
ICONS = "tarantul/icons/lucide/icons.txt"
TITLE = "jtml-view"
WIDE = 1600
HIGH = 1000

skill face(path) {
    out typeface.from_bytes(file.read_bytes(path))
}

skill drawn(canvas, view, palette) {
    @tree = atoms.fitted(read.page(view.jtml()), no, palette)
    @runtime = jtml.mount(canvas, tree)
    atoms.draw(canvas, runtime, palette)
    out runtime
}

program() {
    @host = screen.sized(TITLE, WIDE, HIGH)
    (group.count(host) == 0) { out none }
    @canvas = group.get(host, 0)
    @link = group.get(host, 1)
    @palette = atoms.with_faces(themes.named("soft", canvas), face(REGULAR), face(BOLD), face(MONO))
    @sheet = file.read_bytes(ICONS)
    palette = atoms.with_icons(palette, icons.open(ttf.from_bytes(sheet), bytes.count(sheet)))
    @view = gallery.Gallery { wide = WIDE - 248 - 16, view = HIGH - 76 - 16 }
    view.sized(palette)
    @runtime = drawn(canvas, view, palette)
    screen.present(link)
    @reader = gestures.Reader {}
    @packet = bytes.new(8192)
    @hold = bytes.new(4096)
    @joined = bytes.new(12288)
    always {
        (link.way_closed == yes) { leave }
        (link.way_failed == yes) { leave }
        screen.pump(link, packet, hold, joined)
        @drained = reader.drain(link.way_events)
        link.way_events = drained.core
        @changed = no
        drum (drained.gestures) {
            (beat.kind == gestures.Kind.CLICK) {
                @hit = jtml.hit(runtime, beat.x, beat.y)
                (view.choose(hit.id) == yes) {
                    view.sized(palette)
                    changed = yes
                }
            }
            (beat.kind == gestures.Kind.WHEEL) {
                view.scroll(beat.amount)
                changed = yes
            }
        }
        (changed == yes) {
            runtime = drawn(canvas, view, palette)
            screen.present(link)
        }
        socket.sleep(16)
    }
    out none
}
