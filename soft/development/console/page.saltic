-- page — экран пульта текстом JTML на жителях UIEngine
-- (registry/libraries/uiengine/library): console-deck — шапка strip (название,
-- четыре вида chip, часы), слева console-panel «Сеть» — строки журнала агента
-- (netlog.entries, новые снизу, перенос journal.wrap по ширине моноширинного
-- шрифта), справа console-panel «Система» — Wi-Fi и кабель (link-row), память,
-- диск и куча (gauge), приём и итоги, графики кадров и приёма (graph из bar).
-- Центр пуст (решение автора 16.11.2026: карта мира — потом). Виды — как в
-- docs/site/private/CONSOLE-LOOK.html: Броня, Читать (Броня крупнее), Мягкая,
-- Тихо (Мягкая, где ничего не движется само: часы без секунд).
--
-- Look { name, armor, radius, line, label, small, still } — вид пульта
-- LOOKS — четыре вида по порядку кнопок
-- deck(look, chosen, clock, lines, told) -> текст JTML экрана; lines —
--     netlog.entries, told — system_panel.Facts или none (сети нет)
-- Панели «Сеть» и «Система» — общие с агентом (screen/sides/panels)
-- Внутри: top(look, chosen, clock) — шапка

use core.str
use core.group
use core.bytes
use tarantul.uiengine.jtml.calls
use soft.system.acer_bench.screen.sides.panels

SIDE = 300
LOG_HIGH = 640

Look = Box {
    name = "",
    armor = no,
    radius = 14,
    line = 12,
    label = 14,
    small = 12,
    still = no
}

LOOKS = [
    Look { name = "Броня", armor = yes, radius = 0, line = 12, label = 13, small = 11 },
    Look { name = "Читать", armor = yes, radius = 0, line = 15, label = 16, small = 14 },
    Look { name = "Мягкая" },
    Look { name = "Тихо", still = yes }
]








skill top(look, chosen, clock) {
    @buttons = []
    drum (group.count(LOOKS)) {
        @one = group.get(LOOKS, beat)
        @fill = "panel"
        @tone = "quiet"
        (beat == chosen) {
            fill = "accent"
            tone = "ground"
            (look.armor == no) { fill = "mustard" }
        }
        @number = beat + 1
        buttons = group.add(buttons, calls.call("chip", [["text", calls.quoted("{number} {one.name}")], ["fill", calls.quoted(fill)], ["tone", calls.quoted(tone)]]))
    }
    @title = calls.call("figure", [["text", calls.quoted("Пульт · Saltic")], ["size", "20"], ["tone", calls.quoted("ink")]])
    @looks = calls.call("strip", [["gap", "6"], ["children", calls.listed(buttons)]])
    @time = calls.call("strip", [["gap", "8"], ["children", calls.listed([calls.call("dot", [["tone", calls.quoted("up")]]), calls.call("number", [["text", calls.quoted(clock)], ["tone", calls.quoted("ink")]])])]])
    out calls.call("strip", [["gap", "16"], ["justify", calls.quoted("between")], ["children", calls.listed([title, looks, time])]])
}

skill deck(look, chosen, clock, lines, told) {
    @middle = calls.call("gap", [["grow", "1"]])
    @sizes = panels.Look { radius = look.radius, line = look.line, label = look.label, small = look.small, wide = SIDE, high = LOG_HIGH }
    out calls.call("console-deck", [["top", top(look, chosen, clock)], ["left", panels.network(sizes, lines)], ["middle", middle], ["right", panels.system(sizes, told)]])
}
