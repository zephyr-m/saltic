-- salticide — SalticIDE с сайта (docs/site/public/IDE.html) на весь экран Acer:
-- светлая тема 1 автора, страница salticide/page (Box из компонентов, вид —
-- жители закрытой библиотеки registry/libraries/uiengine/library), шрифты TTF Inter и JetBrains Mono с
-- диска Acer, значки Lucide оттуда же (FONTS\ICONS.TXT; их страницы — агенту
-- через remote.own). Логики нет — только вид.
-- Esc — выход; по сети — state, quit, key, shot.
--
-- program() — нарисовать один раз и ждать Esc
-- Внутри: dressed(whole, base, link) -> палитра со шрифтами; не вышло — Spleen,
--     причина — в журнал по кабелю

use tarantul.firmware.firmware
use tarantul.firmware.firmware.uefi
use tarantul.graphics.graphics
use tarantul.gop.gop
use tarantul.uiengine.draw.atoms
use tarantul.uiengine.draw.typeface
use os.network.reply
use os.network.remote
use os.network.stream
use soft.development.salticide.page
use soft.development.salticide.code
use tarantul.uiengine.jtml
use tarantul.uiengine.jtml.read
use tarantul.uiengine.themes

PAUSE = 10000
SCAN_ESCAPE = 23

skill dressed(whole, base, link) {
    @plain = themes.named("site", whole)
    @typed = atoms.with_fonts(themes.named("site", whole), base) rescue |err| {
        (link) |link| { stream.send(link.card, "salticide: шрифты TTF не загрузились ({err}), рисую Spleen") }
        out plain
    }
    (link) |link| {
        remote.own(link, typed.regular.place, typed.regular.pages)
        remote.own(link, typed.bold.place, typed.bold.pages)
        remote.own(link, typed.mono.place, typed.mono.pages)
    }
    @sheet = typeface.load_icons(base) rescue |err| {
        (link) |link| { stream.send(link.card, "salticide: значки не загрузились ({err}), рисую без них") }
        out typed
    }
    (link) |link| { remote.own(link, sheet.place, sheet.pages) }
    out atoms.with_icons(typed, sheet.set)
}

skill show(base, whole, back, palette) {
    @view = page.opened(code.ACTOR)
    view.fit(whole.height)
    @tree = atoms.fitted(read.page(view.jtml()), no, palette)
    atoms.draw(back, jtml.mount(back, tree), palette)
    out gop.push(base, whole, back)
}

program() {
    @base = firmware.guest_base()
    uefi.forget_keys(base)
    @whole = gop.open_whole(base)
    @back = gop.buffer_like(base, whole)
    @link = remote.open_remote() rescue |err| { none }
    (link) |link| {
        remote.own(link, back.frame, gop.buffer_pages(whole))
        remote.hide_panels(link)
        remote.tell(link, "salticide: SalticIDE с сайта, тема 1")
    }
    show(base, whole, back, dressed(whole, base, link))
    always {
        (link) |link| {
            drum (remote.serve(link)) { }
        }
        @key = uefi.poll_key(base, PAUSE)
        (key.ready == yes) {
            (key.scan == SCAN_ESCAPE) {
                uefi.free_pages(base, back.frame, gop.buffer_pages(whole))
                reply.home("salticide: вышла")
                out none
            }
        }
    }
    out none
}
