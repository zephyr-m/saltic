-- editor — редактор SalticIDE: вкладки и shown строк открытого файла с
-- подсветкой по смыслу (salticide/syntax), начиная с first; строка light —
-- под курсором; вид — житель editor, строки — code-line из code-token (id
-- строки — LINE и номер, по нему щелчок ставит курсор); переменные (info)
-- переливаются в цвет текста, как на сайте.
--
-- Editor { lines, info, first, light, shown, tabs, active } — строки файла,
--     разбор, первая показанная строка, строка курсора, сколько строк влезает
--     (SHOWN, пока страница не скажет иначе: page.fit), пути открытых файлов
--     и путь активного; вкладок нет — образец с сайта, а нет и строк —
--     приветствие (WELCOME); jtml() -> текст JTML
-- TAB — начало id вкладки (дальше путь): щелчок переключает файл; CLOSE —
--     начало id крестика на вкладке: щелчок закрывает файл
-- ROW — высота строки кода в точках
-- scroll(steps) — прокрутка на STEP строк за шаг колеса, в пределах файла
-- point(id) -> yes, если id — строка кода: курсор на неё
-- jump(at, high) — щелчок по полосе прокрутки (TRACK) на высоте at из high:
--     туда же и код; полоса — житель scrollbar, ползунок — видимая часть файла
-- Внутри: row(number) — строка кода жителем code-line; tab(path) — вкладка; last() — самая нижняя
--     первая строка; bar() — полоса прокрутки; greeting() — строки приветствия

use core.str
use core.group
use os.text.parse
use registry.libraries.uiengine.jtml.calls
use soft.development.salticide.syntax

SHOWN = 35
STEP = 3
ROW = 20
LEAST = 24
TRACK = "scroll-track"
LINE = "line-"
TAB = "tab:"
CLOSE = "close:"
WELCOME = ["Открой файл в дереве слева — он появится во вкладке.", "Колесо над деревом листает файлы, над кодом — код.", "Крестик на вкладке закрывает файл."]

Editor = Box {
    lines = [],
    info = syntax.Info {},
    first = 1,
    light = 24,
    shown = SHOWN,
    tabs = [],
    active = ""

    skill row(number) {
        @tokens = []
        drum (syntax.line(group.get(lines, number - 1), number, info)) {
            @fade = ""
            (beat.tone == "info") { fade = "ink" }
            tokens = group.add(tokens, calls.call("code-token", [["text", calls.quoted(beat.value)], ["tone", calls.quoted(beat.tone)], ["fade", calls.quoted(fade)]]))
        }
        @tone = ""
        (number == light) { tone = "select" }
        out calls.call("code-line", [["id", calls.quoted("{LINE}{number}")], ["number", calls.quoted("{number}")], ["tokens", calls.listed(tokens)], ["tone", calls.quoted(tone)]])
    }

    skill last() {
        @bottom = group.count(lines) - shown + 1
        (bottom < 1) { out 1 }
        out bottom
    }

    skill scroll(steps) {
        first = first + steps * STEP
        (first > last()) { first = last() }
        (first < 1) { first = 1 }
        out none
    }

    skill jump(at, high) {
        (high < 1) { out none }
        first = 1 + (last() - 1) * at / high
        (first > last()) { first = last() }
        (first < 1) { first = 1 }
        out none
    }

    skill bar() {
        @track = shown * ROW
        @size = track
        @total = group.count(lines)
        (total > shown) { size = track * shown / total }
        (size < LEAST) { size = LEAST }
        @offset = 0
        (last() > 1) { offset = (track - size) * (first - 1) / (last() - 1) }
        out calls.call("scrollbar", [["id", calls.quoted(TRACK)], ["offset", "{offset}"], ["size", "{size}"], ["height", "{track}"]])
    }

    skill point(id) {
        (str.starts_with(id, LINE) == no) { out no }
        light = parse.parse_size(str.slice(id, str.bytes(LINE), str.bytes(id)))
        out yes
    }

    skill tab(path) {
        @parts = str.split(path, "/")
        @name = group.get(parts, group.count(parts) - 1)
        @kind = "tab"
        (path == active) { kind = "tab-active" }
        out calls.call(kind, [["id", calls.quoted("{TAB}{path}")], ["text", calls.quoted(name)], ["close", calls.quoted("{CLOSE}{path}")]])
    }

    skill greeting() {
        @rows = [calls.call("headline", [["text", calls.quoted("SalticIDE")]])]
        drum (WELCOME) { rows = group.add(rows, calls.call("hint", [["text", calls.quoted(beat)]])) }
        @inside = calls.join(rows)
        out ["\{\"box\": \{\"padding\": [24, 24, 24, 24], \"gap\": 10, \"children\": [{inside}]\}\}"]
    }

    skill jtml() {
        @heads = [calls.call("tab-active", [["id", calls.quoted("")], ["text", calls.quoted("actor.saltic")]]), calls.call("tab", [["id", calls.quoted("")], ["text", calls.quoted("stamp.saltic")]])]
        (group.count(tabs) > 0) {
            heads = []
            drum (tabs) { heads = group.add(heads, tab(beat)) }
        }
        (group.count(lines) == 0) {
            (group.count(tabs) == 0) { out calls.call("editor", [["tabs", calls.listed([])], ["lines", calls.listed(greeting())], ["scroll", bar()]]) }
        }
        @rows = []
        @count = shown
        (group.count(lines) - first + 1 < count) { count = group.count(lines) - first + 1 }
        drum (count) { rows = group.add(rows, row(first + beat)) }
        out calls.call("editor", [["tabs", calls.listed(heads)], ["lines", calls.listed(rows)], ["scroll", bar()]])
    }
}
