-- build — правая панель SalticIDE: сборка и запуск, сводка по файлу, журнал
-- со временем и карточка навыка под курсором; вид — житель build-panel, строки
-- журнала — log-line, карточка — skill-card.
--
-- Build { lines, info } — строки файла и разбор; jtml() -> текст JTML

use core.group
use registry.libraries.uiengine.jtml.calls
use soft.development.salticide.syntax

LOG = [["17:42:01", "toolchain: читаю workbench/actor.saltic", ""], ["17:42:01", "toolchain: проверяю", ""], ["17:42:01", "toolchain: собираю", ""], ["17:42:02", "toolchain: пишу родной x86-64 .cache/build/actor", ""], ["17:42:02", "собрано за 0.4 с — цель x86_64", "up"], ["17:42:05", "запускаю .cache/build/actor", ""], ["17:42:05", "NotEnoughEnergy: нужно 40", "down"], ["17:42:05", "pip: осталось 18", ""], ["17:42:05", "pip устал", ""], ["17:42:05", "код выхода 0 — 12 мс", "up"]]

Build = Box {
    lines = [],
    info = syntax.Info {}

    skill jtml() {
        @count = group.count(lines)
        @skills = group.count(info.scopes)
        @log = []
        drum (LOG) { log = group.add(log, calls.call("log-line", [["time", calls.quoted(group.get(beat, 0))], ["text", calls.quoted(group.get(beat, 1))], ["tone", calls.quoted(group.get(beat, 2))]])) }
        @card = calls.call("skill-card", [["name", calls.quoted("spend")], ["signature", calls.quoted("(actor, cost)")], ["about", calls.quoted("Тратит силы актёра; не хватает — ошибка.")], ["errors", calls.quoted("ошибки: NotEnoughEnergy")], ["line", calls.quoted("строка 18")]])
        out calls.call("build-panel", [["summary", calls.quoted("{count} строк · {skills} навыков · ошибок в подписях: 1")], ["log", calls.listed(log)], ["card", calls.listed([card])]])
    }
}
