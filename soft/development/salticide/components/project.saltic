-- project — левая панель SalticIDE: файлы проекта; вид — житель
-- project-panel, строки — folder-row, file-row, file-row-current. Файлы —
-- строки rows, их даёт хозяин окна (Linux — с диска,
-- soft/development/salticide/linux/disk); нет строк — образец с сайта. id строки — FOLDER или FILE и путь: по нему щелчок
-- раскрывает папку или открывает файл.
--
-- Row { kind, name, path, depth, open } — строка дерева: kind — FOLDER или
--     FILE, depth — вложенность, open — папка раскрыта
-- Project { rows, current, first, space } — строки дерева, путь открытого
--     файла, первая показанная строка дерева, высота панели в точках (0 —
--     показать все); jtml() -> текст JTML
-- WIDTH — ширина панели: колесо левее — прокрутка дерева
-- fit(height) — панель высотой height (страница без заголовка и режимов)
-- scroll(steps) — прокрутка дерева на STEP строк за шаг колеса
-- Внутри: file(name, chosen) — строка образца; row(item) — строка дерева;
--     room() -> сколько строк дерева влезает в панель

use core.group
use registry.libraries.uiengine.jtml.calls

INDENT = 12
WIDTH = 230
STEP = 3
ROW = 29
FRAME = 45
LEAST = 5
FOLDER = "dir:"
FILE = "file:"

Row = Box {
    kind = "file:",
    name = "",
    path = "",
    depth = 0,
    open = no
}

Project = Box {
    rows = [],
    current = "",
    first = 0,
    space = 0

    skill fit(height) {
        space = height
        out scroll(0)
    }

    skill room() {
        (space == 0) { out group.count(rows) }
        @fits = (space - FRAME) / ROW
        (fits < LEAST) { out LEAST }
        out fits
    }

    skill scroll(steps) {
        first = first + steps * STEP
        @bottom = group.count(rows) - room()
        (first > bottom) { first = bottom }
        (first < 0) { first = 0 }
        out none
    }

    skill file(name, chosen) {
        @kind = "file-row"
        (chosen == yes) { kind = "file-row-current" }
        out calls.call(kind, [["id", calls.quoted("")], ["name", calls.quoted(name)], ["indent", "{INDENT}"]])
    }

    skill row(item) {
        @indent = item.depth * INDENT
        (item.kind == FOLDER) {
            @icon = "chevron-right"
            (item.open == yes) { icon = "chevron-down" }
            out calls.call("folder-row", [["id", calls.quoted("{FOLDER}{item.path}")], ["name", calls.quoted(item.name)], ["indent", "{indent}"], ["icon", calls.quoted(icon)]])
        }
        @kind = "file-row"
        (item.path == current) { kind = "file-row-current" }
        out calls.call(kind, [["id", calls.quoted("{FILE}{item.path}")], ["name", calls.quoted(item.name)], ["indent", "{indent}"]])
    }

    skill jtml() {
        @files = [calls.call("folder-row", [["id", calls.quoted("")], ["name", calls.quoted("soul/seed")], ["indent", "0"], ["icon", calls.quoted("chevron-down")]]), file("time.saltic", no), calls.call("folder-row", [["id", calls.quoted("")], ["name", calls.quoted("workbench")], ["indent", "0"], ["icon", calls.quoted("chevron-down")]]), file("actor.saltic", yes), file("stamp.saltic", no)]
        (group.count(rows) > 0) {
            files = []
            @count = room()
            (group.count(rows) - first < count) { count = group.count(rows) - first }
            drum (count) { files = group.add(files, row(group.get(rows, first + beat))) }
        }
        out calls.call("project-panel", [["files", calls.listed(files)]])
    }
}
