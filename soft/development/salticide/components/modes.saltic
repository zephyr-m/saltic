-- modes — нижняя полоса SalticIDE: режимы окна (выбранный — mode-active) и
-- состояние — ветка, цель, место курсора, ошибки; вид — житель mode-bar;
-- у каждого режима значок Lucide (ICONS — по порядку MODES).
--
-- Modes { active, place } — выбранный режим и место курсора «строка:столбец»;
--     jtml() -> текст JTML

use core.group
use tarantul.uiengine.jtml.calls

MODES = ["код", "поток", "база", "проверки", "железо", "время", "git", "ветки"]
ICONS = ["code", "workflow", "database", "circle-check", "cpu", "clock", "git-commit-horizontal", "git-branch"]

Modes = Box {
    active = "код",
    place = "24:5"

    skill jtml() {
        @buttons = []
        drum (group.count(MODES)) {
            @name = group.get(MODES, beat)
            @kind = "mode"
            (name == active) { kind = "mode-active" }
            buttons = group.add(buttons, calls.call(kind, [["text", calls.quoted(name)], ["icon", calls.quoted(group.get(ICONS, beat))]]))
        }
        out calls.call("mode-bar", [["modes", calls.listed(buttons)], ["branch", calls.quoted("main +12")], ["target", calls.quoted("x86_64")], ["place", calls.quoted(place)], ["errors", calls.quoted("ошибок 1")]])
    }
}
