-- title — заголовок окна SalticIDE: огоньки окна, значок, путь открытого файла,
-- кнопки «тема» и «весь экран»; вид — житель title-bar.
--
-- TitleBar { path } — путь файла; jtml() -> текст JTML

use tarantul.uiengine.jtml.calls

TitleBar = Box {
    path = ""

    skill jtml() {
        out calls.call("title-bar", [["path", calls.quoted(path)]])
    }
}
