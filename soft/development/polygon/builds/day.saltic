-- day — день календаря коммитов, субъект Day: номер от 1970-01-01 (по нему
-- дни складываются и сравниваются), сколько в нём коммитов и всё, что день
-- знает о себе сам — дату, день недели (с понедельника), как себя назвать,
-- свою клетку в календаре (яркость по LEVELS: ноль — well, дальше _rim, _mid
-- и сам цвет; будущий день — фон) и подсказку о себе.
--
-- Day { number, commits, future } — read(text) — стать днём "ГГГГ-ММ-ДД";
--     cell() -> клетка heat-cell с id CELL и номер; tone() -> её тон;
--     bubble(x, y) -> подсказка о себе в месте x, y; date() -> [год,
--     месяц, число]; weekday() -> 0 — понедельник … 6 — воскресенье; named()
--     -> «11 ноября 2026»; weekday_name() -> «вторник»; short() -> «вт»;
--     month_short() -> «ноя»; opens_month() -> yes, если число первое
-- Внутри: digits(text) -> целое из цифр

use core.str
use core.group
use tarantul.uiengine.jtml.calls
use soft.development.polygon.builds.word

CELL = "day-"
LEVELS = [[25, "accent"], [10, "accent_mid"], [1, "accent_rim"]]
EPOCH_SHIFT = 719468
ERA = 146097
GENITIVE = ["января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря"]
MONTHS = ["янв", "фев", "мар", "апр", "май", "июн", "июл", "авг", "сен", "окт", "ноя", "дек"]
NAMES = ["понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье"]
SHORT = ["пн", "вт", "ср", "чт", "пт", "сб", "вс"]

Day = Box {
    number = 0,
    commits = 0,
    future = no

    skill tone() {
        (future == yes) { out "ground" }
        drum (LEVELS) {
            (commits >= group.get(beat, 0)) { out group.get(beat, 1) }
        }
        out "well"
    }

    skill cell() {
        @shade = tone()
        out calls.call("heat-cell", [["id", calls.quoted("{CELL}{number}")], ["tone", calls.quoted(shade)]])
    }

    skill bubble(x, y) {
        @commit = word.Noun { one = "коммит", few = "коммита", many = "коммитов" }
        @said = commit.say(commits)
        @weekday = weekday_name()
        @when = named()
        @shown = calls.call("tooltip", [["text", calls.quoted(said)], ["note", calls.quoted("{weekday}, {when}")], ["x", "{x}"], ["y", "{y}"]])
        out "\{\"box\": \{\"gap\": 0, \"children\": [{shown}]\}\}"
    }

    skill digits(text) {
        @read_number = 0
        drum (str.bytes(text)) { read_number = read_number * 10 + str.byte(text, beat) - 48 }
        out read_number
    }

    skill read(text) {
        @year = digits(str.slice(text, 0, 4))
        @month = digits(str.slice(text, 5, 7))
        @date = digits(str.slice(text, 8, 10))
        (month <= 2) { year = year - 1 }
        @era = year / 400
        @of_era = year - era * 400
        @shifted = month + 9
        (month > 2) { shifted = month - 3 }
        @of_year = (153 * shifted + 2) / 5 + date - 1
        @of_cycle = of_era * 365 + of_era / 4 - of_era / 100 + of_year
        number = era * ERA + of_cycle - EPOCH_SHIFT
        out none
    }

    skill date() {
        @shifted = number + EPOCH_SHIFT
        @era = shifted / ERA
        @of_cycle = shifted - era * ERA
        @of_era = (of_cycle - of_cycle / 1460 + of_cycle / 36524 - of_cycle / 146096) / 365
        @year = of_era + era * 400
        @of_year = of_cycle - (365 * of_era + of_era / 4 - of_era / 100)
        @spot = (5 * of_year + 2) / 153
        @day = of_year - (153 * spot + 2) / 5 + 1
        @month = spot + 3
        (spot >= 10) { month = spot - 9 }
        (month <= 2) { year = year + 1 }
        out [year, month, day]
    }

    skill weekday() {
        out (number + 3) % 7
    }

    skill named() {
        @parts = date()
        @month = group.get(GENITIVE, group.get(parts, 1) - 1)
        @day = group.get(parts, 2)
        @year = group.get(parts, 0)
        out "{day} {month} {year}"
    }

    skill weekday_name() {
        out group.get(NAMES, weekday())
    }

    skill short() {
        out group.get(SHORT, weekday())
    }

    skill month_short() {
        @parts = date()
        out group.get(MONTHS, group.get(parts, 1) - 1)
    }

    skill opens_month() {
        @parts = date()
        out group.get(parts, 2) == 1
    }
}
