-- word — русское слово со своими формами при числе, субъект Noun: один
-- коммит, два коммита, пять коммитов (11–14 — всегда «много»).
--
-- Noun { one, few, many } — формы при 1, 2–4 и 5+; say(count) -> «98
--     коммитов» — число и слово в нужной форме

Noun = Box {
    one = "",
    few = "",
    many = ""

    skill say(count) {
        @last = count % 10
        @tens = count % 100
        (tens >= 11) {
            (tens <= 14) { out "{count} {many}" }
        }
        (last == 1) { out "{count} {one}" }
        (last >= 2) {
            (last <= 4) { out "{count} {few}" }
        }
        out "{count} {many}"
    }
}
