-- totals — итоги года экрана «Сборки», субъект Totals: смотрит в календарь
-- коммитов (builds/calendar) и показывает четыре главных числа — коммитов,
-- дней с коммитами, самая длинная серия, лучший день.
--
-- Totals { calendar } — jtml() -> ряд итогов; stat(label, value, tone, size,
--     note, grow) — одно число

use tarantul.uiengine.jtml.calls
use soft.development.polygon.builds.calendar

Totals = Box {
    calendar = calendar.Calendar {}

    skill stat(label, value, tone, size, note, grow) {
        out calls.call("stat-panel", [["label", calls.quoted(label)], ["value", calls.quoted(value)], ["tone", calls.quoted(tone)], ["size", "{size}"], ["note", calls.quoted(note)], ["grow", "{grow}"]])
    }

    skill jtml() {
        @total = calendar.total()
        @active = calendar.active()
        @longest = calendar.streak()
        @best = calendar.best()
        @items = [stat("коммитов за год", "{total}", "accent", 64, "настоящие — из git log этого репозитория", 2), stat("дней с коммитами", "{active}", "up", 34, "из 371 в сетке", 1), stat("самая длинная серия", "{longest}", "mustard", 34, "дней подряд", 1), stat("лучший день", "{best.commits}", "info", 34, best.named(), 1)]
        @inside = calls.join(items)
        out "\{\"box\": \{\"flow\": \"row\", \"gap\": 14, \"children\": [{inside}]\}\}"
    }
}
