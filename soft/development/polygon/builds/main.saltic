-- builds — экран «Сборки» Полигона, субъект Builds: держит календарь коммитов
-- (builds/calendar — недели из дней, каждый день знает свои коммиты), историю
-- (builds/history — читает git log и раскладывает коммиты по дням календаря)
-- и две части, которые смотрят в календарь: итоги года (builds/totals) и
-- коммиты по дням недели (builds/weekdays). Наведение на день — его подсказка.
--
-- Builds { commits, calendar, totals, weekdays } — refresh() — история заново
--     заполняет календарь, части смотрят в него; jtml() -> список JTML
--     экрана; tip(id, x, y) -> подсказка дня или ""

use tarantul.uiengine.jtml.calls
use soft.development.polygon.builds.word
use soft.development.polygon.builds.history
use soft.development.polygon.builds.calendar
use soft.development.polygon.builds.totals
use soft.development.polygon.builds.weekdays

Builds = Box {
    commits = history.Commits {},
    calendar = calendar.Calendar {},
    totals = totals.Totals {},
    weekdays = weekdays.Weekdays {}

    skill refresh() {
        commits.fill(calendar)
        totals.calendar = calendar
        weekdays.calendar = calendar
        out none
    }

    skill tip(id, x, y) {
        out calendar.tip(id, x, y)
    }

    skill jtml() {
        ((commits.trouble == "") == no) {
            @failed = calls.call("page-head", [["title", calls.quoted("Сборки")], ["note", calls.quoted(commits.trouble)], ["badge", calls.quoted("нет истории")], ["tone", calls.quoted("down")]])
            out calls.listed([failed])
        }
        @commit = word.Noun { one = "коммит", few = "коммита", many = "коммитов" }
        @head = calls.call("page-head", [["title", calls.quoted("Сборки")], ["note", calls.quoted("Коммиты репозитория Saltic за год")], ["badge", calls.quoted(commit.say(calendar.total()))], ["tone", calls.quoted("accent")]])
        out calls.listed([head, totals.jtml(), calendar.jtml(), weekdays.jtml()])
    }
}
