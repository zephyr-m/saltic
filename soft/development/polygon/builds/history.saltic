-- history — история коммитов репозитория для экрана «Сборки», субъект
-- Commits: тот, кто читает git log за столько недель, сколько охватывает календарь (дата коммита —
-- день ГГГГ-ММ-ДД; сегодня — date +%F) и раскладывает коммиты по дням
-- календаря (builds/calendar). Не прочиталось — trouble словами.
--
-- Commits { trouble } — fill(calendar) — построить календарь до сегодня и
--     отметить в нём каждый коммит; причина сбоя или ""

use core.str
use core.process
use soft.development.polygon.builds.day

Commits = Box {
    trouble = ""

    skill fill(calendar) {
        @asked = process.capture(["date", "+%F"], "", []) rescue |err| {
            trouble = "date не ответил — {err}"
            out none
        }
        @today = day.Day {}
        today.read(asked.output)
        calendar.grid(today)
        @weeks = calendar.span()
        @log = process.capture(["git", "log", "--since={weeks} weeks ago", "--format=%cd", "--date=short"], "", []) rescue |err| {
            trouble = "git не запустился — {err}"
            out none
        }
        ((log.code == 0) == no) {
            trouble = "git log ответил кодом {log.code} — не репозиторий?"
            out none
        }
        drum (str.lines(log.output)) {
            (str.bytes(beat) >= 10) { calendar.mark(beat) }
        }
        trouble = ""
        out none
    }
}
