-- weekdays — коммиты по дням недели экрана «Сборки», субъект Weekdays: смотрит
-- в календарь коммитов (builds/calendar) — столбик на каждый день с
-- понедельника, высота — доля от самого людного дня.
--
-- Weekdays { calendar } — jtml() -> панель; sums() -> коммитов по дням
--     недели [пн … вс]; shelf(flow, gap, items) — ряд или столбик

use core.group
use tarantul.uiengine.jtml.calls
use soft.development.polygon.builds.calendar

HIGHEST = 96

Weekdays = Box {
    calendar = calendar.Calendar {}

    skill shelf(flow, gap, items) {
        @inside = calls.join(items)
        out "\{\"box\": \{\"flow\": \"{flow}\", \"gap\": {gap}, \"children\": [{inside}]\}\}"
    }

    skill sums() {
        @made = [0, 0, 0, 0, 0, 0, 0]
        drum (calendar.days()) {
            @slot = beat.weekday()
            made = group.replaced(made, slot, group.get(made, slot) + beat.commits)
        }
        out made
    }

    skill jtml() {
        @per_day = sums()
        @most = 1
        drum (per_day) {
            (beat > most) { most = beat }
        }
        @first_week = group.get(calendar.weeks, 0)
        @bars = []
        drum (7) {
            @height = group.get(per_day, beat) * HIGHEST / most + 2
            @bar = calls.call("bar", [["width", "36"], ["height", "{height}"], ["tone", calls.quoted("accent_mid")], ["radius", "4"]])
            @column = "\{\"box\": \{\"height\": 100, \"justify\": \"end\", \"gap\": 0, \"children\": [{bar}]\}\}"
            @named = first_week.at(beat)
            bars = group.add(bars, shelf("column", 6, [column, calls.call("tick-label", [["text", calls.quoted(named.short())], ["width", "36"], ["height", "16"]])]))
        }
        out calls.call("console-panel", [["title", calls.quoted("по дням недели")], ["note", calls.quoted("все коммиты года")], ["radius", "16"], ["children", calls.listed([shelf("row", 10, bars)])]])
    }
}
