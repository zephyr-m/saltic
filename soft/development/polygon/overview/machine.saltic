-- machine — устройство-образец «Обзора», субъект Machine: имя, что за железо,
-- состояние и две полоски («память 2.9 из 7.9 ГБ» и т. п.) в процентах.
--
-- Machine { name, kind, state, tone, first, first_value, first_share,
--     first_tone, second, second_value, second_share, second_tone, track } —
--     jtml() -> карточка device-card; полоска — доля от дорожки track точек

use tarantul.uiengine.jtml.calls

Machine = Box {
    name = "",
    kind = "",
    state = "",
    tone = "up",
    first = "",
    first_value = "",
    first_share = 0,
    first_tone = "accent",
    second = "",
    second_value = "",
    second_share = 0,
    second_tone = "accent",
    track = 248

    skill jtml() {
        @one = first_share * track / 100
        @two = second_share * track / 100
        out calls.call("device-card", [["name", calls.quoted(name)], ["kind", calls.quoted(kind)], ["state", calls.quoted(state)], ["tone", calls.quoted(tone)], ["grow", "1"], ["one", calls.quoted(first)], ["one_value", calls.quoted(first_value)], ["one_fill", "{one}"], ["one_tone", calls.quoted(first_tone)], ["two", calls.quoted(second)], ["two_value", calls.quoted(second_value)], ["two_fill", "{two}"], ["two_tone", calls.quoted(second_tone)]])
    }
}
