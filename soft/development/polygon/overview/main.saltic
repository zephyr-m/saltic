-- overview — экран «Обзор» Полигона, субъект Overview: образец платформы из
-- docs/site/private/PLATFORM-DEMO.html. Экран держит свои образцы — главные
-- числа (поля), столбики суток, устройства (overview/machine) и последние
-- сборки (overview/run). Всё — образец и так подписано (метка вверху и подпись
-- таблицы); живые данные — в «Сборках» и «Устройствах».
--
-- Overview { checks, total, left, passed, failed, failed_note, shelf_version,
--     spark, machines, runs } — числа, столбики суток, образцы
--     jtml() -> список JTML экрана; shelf(flow, gap, items) — ряд или
--     столбик; numbers() — главные числа; table() — последние сборки

use core.group
use tarantul.uiengine.jtml.calls
use soft.development.polygon.overview.machine
use soft.development.polygon.overview.run

Overview = Box {
    checks = "17 522",
    total = "24 884",
    left = "~2 мин",
    passed = "21",
    failed = "2",
    failed_note = "jtml, esp32",
    shelf_version = "300:82:281",
    spark = [10, 16, 12, 22, 18, 26, 34],
    machines = [machine.Machine { name = "Acer E5-575G", kind = "x86-64 · UEFI · агент 56", state = "в сети", tone = "up", first = "память", first_value = "2.9 из 7.9 ГБ", first_share = 37, second = "диск Saltic", second_value = "66 из 510 МБ", second_share = 13 }, machine.Machine { name = "POCO X6 Pro", kind = "arm64 · Android · gaze", state = "в сети", tone = "up", first = "камера", first_value = "230 кадров", first_share = 62, second = "сеть взгляда", second_value = "4 мс на кадр", second_share = 20, second_tone = "mustard" }, machine.Machine { name = "ESP32 DevKit", kind = "xtensa · LX6 · задача 20", state = "IllegalInstruction", tone = "down", first = "код", first_value = "158 из 128 КБ", first_share = 100, first_tone = "down", second = "куча", second_value = "21 из 64 КБ", second_share = 33 }, machine.Machine { name = "Ноутбук", kind = "x86-64 · NixOS · полка 300", state = "собирает", tone = "accent", first = "процессор", first_value = "8 потоков", first_share = 86, first_tone = "mustard", second = "память", second_value = "11 из 32 ГБ", second_share = 34 }],
    runs = [run.Run { name = "global-check", target = "все", state = "идёт", tone = "accent", author = "Зэф", time = "4:12" }, run.Run { name = "esp32-console", target = "xtensa", state = "провал", tone = "down", author = "Claude", time = "0:24" }, run.Run { name = "agent 56", target = "x86-64-uefi", state = "прошло", tone = "up", author = "Claude", time = "1:03" }, run.Run { name = "salticide", target = "x86-64", state = "прошло", tone = "up", author = "Claude", time = "0:48" }, run.Run { name = "gaze", target = "arm64-android", state = "ждёт", tone = "quiet", author = "Fable", time = "—" }]

    skill shelf(flow, gap, items) {
        @inside = calls.join(items)
        out "\{\"box\": \{\"flow\": \"{flow}\", \"gap\": {gap}, \"children\": [{inside}]\}\}"
    }

    skill numbers() {
        @bars = []
        @peak = 0
        drum (spark) {
            (beat > peak) { peak = beat }
        }
        drum (spark) {
            @tone = "accent_rim"
            (beat == peak) { tone = "accent" }
            bars = group.add(bars, calls.call("bar", [["width", "22"], ["height", "{beat}"], ["tone", calls.quoted(tone)], ["radius", "3"]]))
        }
        @day = calls.call("spark", [["bars", calls.listed(bars)]])
        out shelf("row", 14, [calls.call("stat-panel", [["label", calls.quoted("проверок прошло")], ["value", calls.quoted(checks)], ["tone", calls.quoted("accent")], ["size", "64"], ["note", calls.quoted("из {total} · осталось {left}")], ["grow", "2"]]), calls.call("stat-panel", [["label", calls.quoted("прошло")], ["value", calls.quoted(passed)], ["tone", calls.quoted("up")], ["size", "34"], ["note", calls.quoted("за сутки")], ["grow", "1"], ["extra", day]]), calls.call("stat-panel", [["label", calls.quoted("провал")], ["value", calls.quoted(failed)], ["tone", calls.quoted("down")], ["size", "34"], ["note", calls.quoted(failed_note)], ["grow", "1"]]), calls.call("stat-panel", [["label", calls.quoted("полка")], ["value", calls.quoted("300")], ["tone", calls.quoted("mustard")], ["size", "34"], ["note", calls.quoted(shelf_version)], ["grow", "1"]])])
    }

    skill table() {
        @rows = [calls.call("build-head", [])]
        drum (runs) { rows = group.add(rows, beat.jtml()) }
        out calls.call("console-panel", [["title", calls.quoted("последние сборки")], ["note", calls.quoted("образец")], ["radius", "16"], ["children", calls.listed([shelf("column", 0, rows)])]])
    }

    skill jtml() {
        @cards = []
        drum (machines) { cards = group.add(cards, beat.jtml()) }
        @head = calls.call("page-head", [["title", calls.quoted("Обзор")], ["note", calls.quoted("Сборки и железо за сегодня")], ["badge", calls.quoted("идёт global-check")], ["tone", calls.quoted("accent")]])
        out calls.listed([head, numbers(), calls.call("section-head", [["text", calls.quoted("устройства")]]), shelf("row", 14, cards), table()])
    }
}
