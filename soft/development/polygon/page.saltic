-- page — экран «Полигона Saltic» (docs/site/private/PLATFORM-DEMO.html) из
-- жителей UIEngine, субъект Polygon: меню слева и дек polygon-deck 4-го
-- этажа, в его ячейке — экран выбранного раздела, а каждый экран — свой
-- субъект в своём файле: «Обзор» — overview (образец, так и подписан),
-- «Сборки» — builds (настоящий git log), «Устройства» — schema (живой опрос
-- железа), «Пакеты» — packages (реестр tarantul с поиском), проект «saltic» —
-- project (язык в числах); витрина «Круги» — circles (пятый атом, образцы);
-- у прочих — честное «раздел пока пуст». Метка вверху — по разделу.
-- Ниже в меню — темы UIEngine (themes.NAMES): щелчок перекрашивает экран.
--
-- Polygon { section, theme, worn, summary, calendar, hardware, registry,
--     language, rings } —
--     выбранный раздел (имя из SECTIONS), выбранная тема и та, в которой экран
--     нарисован сейчас (окно сверяет), экраны «Обзор», «Сборки», «Устройства»,
--     «Пакеты», «saltic», витрина «Круги»
-- type(text) -> yes, если набранное что-то поменяло (поиск «Пакетов»)
-- choose(id) -> yes, если щелчок что-то поменял: пункт меню (MENU и имя
--     раздела), тема (PAINT и имя темы) или карточка схемы — её экрану
-- tip(id, x, y) -> JTML подсказки над наведённым (у «Сборок») или ""
-- refresh() — экранам перечитать свои данные (история коммитов); poll() ->
--     yes, если экран раздела сам что-то обновил (опрос «Устройств»)
-- jtml() -> текст JTML экрана
-- Внутри: menu_row(id, icon, text, count, current) — строка меню (навык
--     страницы — она строит своё меню); side() —
--     меню; empty(title) — пустой раздел; title() — имя раздела словами

use core.str
use core.group
use tarantul.uiengine.jtml.calls
use tarantul.uiengine.themes
use soft.development.polygon.overview
use soft.development.polygon.builds
use soft.development.polygon.schema
use soft.development.polygon.packages
use soft.development.polygon.project
use soft.development.polygon.circles

MENU = "menu-"
PAINT = "theme-"
SECTIONS = [["overview", "layout-grid", "Обзор", ""], ["builds", "code", "Сборки", ""], ["devices", "monitor", "Устройства", "4"], ["packages", "package", "Пакеты", ""]]
SHOWCASE = [["circles", "circle-dashed", "Круги", ""]]
PROJECTS = [["esp32-console", "circle", "esp32-console", ""], ["saltic", "circle", "saltic", ""]]
LIVE = ["builds", "devices", "packages", "saltic"]


Polygon = Box {
    section = "overview",
    theme = "soft",
    worn = "soft",
    summary = overview.Overview {},
    calendar = builds.Builds {},
    hardware = schema.Schema {},
    registry = packages.Packages {},
    language = project.Project {},
    rings = circles.Circles {}

    skill menu_row(id, icon, text, count, current) {
        @kind = "menu-row"
        (current == yes) { kind = "menu-row-current" }
        out calls.call(kind, [["id", calls.quoted("{MENU}{id}")], ["icon", calls.quoted(icon)], ["text", calls.quoted(text)], ["count", calls.quoted(count)]])
    }

    skill choose(id) {
        (str.starts_with(id, PAINT) == yes) {
            theme = str.slice(id, str.bytes(PAINT), str.bytes(id))
            out yes
        }
        (section == "devices") {
            (hardware.choose(id) == yes) { out yes }
        }
        (section == "packages") {
            (registry.choose(id) == yes) { out yes }
        }
        (str.starts_with(id, MENU) == no) { out no }
        section = str.slice(id, str.bytes(MENU), str.bytes(id))
        out yes
    }

    skill refresh() {
        calendar.refresh()
        registry.refresh()
        out language.refresh()
    }

    skill type(text) {
        ((section == "packages") == no) { out no }
        out registry.type(text)
    }

    skill poll() {
        ((section == "devices") == no) { out no }
        (hardware.due() == no) { out no }
        hardware.survey()
        out yes
    }

    skill tip(id, x, y) {
        ((section == "builds") == no) { out "" }
        out calendar.tip(id, x, y)
    }

    skill title() {
        drum (group.concat(group.concat(SECTIONS, PROJECTS), SHOWCASE)) {
            (group.get(beat, 0) == section) { out group.get(beat, 2) }
        }
        out section
    }

    skill side() {
        @rows = [calls.call("brand", [["letter", calls.quoted("S")], ["name", calls.quoted("Полигон Saltic")]])]
        drum (SECTIONS) { rows = group.add(rows, menu_row(group.get(beat, 0), group.get(beat, 1), group.get(beat, 2), group.get(beat, 3), group.get(beat, 0) == section)) }
        rows = group.add(rows, calls.call("section-head", [["text", calls.quoted("проекты")]]))
        drum (PROJECTS) { rows = group.add(rows, menu_row(group.get(beat, 0), group.get(beat, 1), group.get(beat, 2), group.get(beat, 3), group.get(beat, 0) == section)) }
        rows = group.add(rows, calls.call("section-head", [["text", calls.quoted("витрина")]]))
        drum (SHOWCASE) { rows = group.add(rows, menu_row(group.get(beat, 0), group.get(beat, 1), group.get(beat, 2), group.get(beat, 3), group.get(beat, 0) == section)) }
        rows = group.add(rows, calls.call("section-head", [["text", calls.quoted("темы")]]))
        drum (themes.NAMES) {
            @kind = "menu-row"
            (beat == theme) { kind = "menu-row-current" }
            rows = group.add(rows, calls.call(kind, [["id", calls.quoted("{PAINT}{beat}")], ["icon", calls.quoted("palette")], ["text", calls.quoted(beat)], ["count", calls.quoted("")]]))
        }
        rows = group.add(rows, "\{\"box\": \{\"grow\": 1, \"gap\": 0\}\}")
        rows = group.add(rows, calls.call("side-foot", [["text", calls.quoted("Обзор, витрина — образец")], ["note", calls.quoted("остальное — живое")]]))
        out calls.listed(rows)
    }

    skill empty(name) {
        @head = calls.call("page-head", [["title", calls.quoted(name)], ["note", calls.quoted("раздел пока пуст")], ["badge", calls.quoted("пусто")], ["tone", calls.quoted("quiet")]])
        out calls.listed([head])
    }

    skill jtml() {
        @name = title()
        @badge = "образец"
        @tone = "mustard"
        (group.contains(LIVE, section) == yes) {
            badge = "живые данные"
            tone = "up"
        }
        @top = calls.call("crumbs", [["path", calls.quoted("полигон / {name}")], ["badge", calls.quoted(badge)], ["tone", calls.quoted(tone)]])
        @content = empty(name)
        (section == "overview") { content = summary.jtml() }
        (section == "builds") { content = calendar.jtml() }
        (section == "devices") { content = hardware.jtml() }
        (section == "packages") { content = registry.jtml() }
        (section == "saltic") { content = language.jtml() }
        (section == "circles") { content = rings.jtml() }
        out calls.call("polygon-deck", [["side", side()], ["top", top], ["content", content]])
    }
}
