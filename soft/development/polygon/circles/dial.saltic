-- dial — спидометр витрины «Круги», субъект Dial: что показывает, значение
-- из ста, цвет смысла; полукольцо слева направо.
--
-- Dial { name, value, tone } — jtml() -> житель dial; sweep() -> градусы
--     полукольца из значения

use tarantul.uiengine.jtml.calls

Dial = Box {
    name = "",
    value = 0,
    tone = "mustard"

    skill sweep() {
        out value * 180 / 100
    }

    skill jtml() {
        @arc = sweep()
        out calls.call("dial", [["size", "150"], ["sweep", "{arc}"], ["tone", calls.quoted(tone)], ["value", calls.quoted("{value}")], ["note", calls.quoted(name)]])
    }
}
