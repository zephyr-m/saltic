-- ring — кольцо прогресса витрины «Круги», субъект Ring: что меряет, сколько
-- процентов, каким цветом смысла.
--
-- Ring { name, value, tone } — jtml() -> житель progress-ring; sweep() ->
--     градусы дуги из процентов

use tarantul.uiengine.jtml.calls

Ring = Box {
    name = "",
    value = 0,
    tone = "accent"

    skill sweep() {
        out value * 360 / 100
    }

    skill jtml() {
        @arc = sweep()
        out calls.call("progress-ring", [["size", "110"], ["sweep", "{arc}"], ["tone", calls.quoted(tone)], ["value", calls.quoted("{value}%")], ["note", calls.quoted(name)]])
    }
}
