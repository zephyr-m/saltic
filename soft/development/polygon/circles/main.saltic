-- circles — экран витрины «Круги» Полигона, субъект Circles: что умеет пятый
-- атом UIEngine — circle (решение автора 18.11.2026) и жители на нём. Экран
-- держит своих: кольца прогресса (circles/ring), спидометры (circles/dial),
-- людей (circles/person), состояния (circles/status), и сам показывает
-- бублик, круговую диаграмму и мишень. Все числа — образец, так и подписано.
--
-- Circles { rings, dials, people, states, sample } — свои кружки и подпись
--     образцов; jtml() -> список JTML экрана; lay(flow, gap, align, items)
--     — ряд или столбик; panel(title, items) — панель с рядом внутри;
--     shapes() — бублик, круговая, мишень, люди и состояния

use core.group
use tarantul.uiengine.jtml.calls
use soft.development.polygon.circles.ring
use soft.development.polygon.circles.dial
use soft.development.polygon.circles.person
use soft.development.polygon.circles.status

Circles = Box {
    rings = [ring.Ring { name = "проверки", value = 63, tone = "accent" }, ring.Ring { name = "память", value = 72, tone = "mustard" }, ring.Ring { name = "диск Saltic", value = 13, tone = "up" }, ring.Ring { name = "провалы", value = 8, tone = "down" }],
    dials = [dial.Dial { name = "нагрузка", value = 67, tone = "mustard" }, dial.Dial { name = "сеть", value = 34, tone = "accent" }, dial.Dial { name = "температура", value = 88, tone = "down" }],
    people = [person.Person { letters = "ЗЭ", tone = "mustard" }, person.Person { letters = "CL", tone = "info" }, person.Person { letters = "FA", tone = "accent" }, person.Person { letters = "GR", tone = "up" }],
    states = [status.Status { name = "в сети", tone = "up" }, status.Status { name = "собирает", tone = "accent" }, status.Status { name = "ждёт", tone = "mustard" }, status.Status { name = "упал", tone = "down" }],
    sample = "образец"

    skill lay(flow, gap, align, items) {
        @inside = calls.join(items)
        out "\{\"box\": \{\"flow\": \"{flow}\", \"gap\": {gap}, \"align\": \"{align}\", \"children\": [{inside}]\}\}"
    }

    skill panel(title, items) {
        @inside = calls.join(items)
        @row = "\{\"box\": \{\"flow\": \"row\", \"gap\": 28, \"justify\": \"between\", \"align\": \"center\", \"padding\": [6, 8, 6, 8], \"children\": [{inside}]\}\}"
        out calls.call("console-panel", [["title", calls.quoted(title)], ["note", calls.quoted(sample)], ["radius", "16"], ["grow", "1"], ["children", calls.listed([row])]])
    }

    skill shapes() {
        @faces = []
        drum (people) { faces = group.add(faces, beat.jtml()) }
        @words = []
        drum (states) { words = group.add(words, beat.jtml()) }
        out [calls.call("donut", [["size", "130"], ["first", "200"], ["second", "110"], ["third", "110"], ["note", calls.quoted("код")]]), calls.call("pie", [["size", "130"], ["first", "150"], ["second", "120"], ["third", "60"]]), calls.call("target", [["size", "136"], ["tone", calls.quoted("down")]]), lay("column", 14, "center", [lay("row", 10, "center", faces), lay("column", 8, "start", words)])]
    }

    skill jtml() {
        @progress = []
        drum (rings) { progress = group.add(progress, beat.jtml()) }
        @gauges = []
        drum (dials) { gauges = group.add(gauges, beat.jtml()) }
        @head = calls.call("page-head", [["title", calls.quoted("Круги")], ["note", calls.quoted("пятый атом circle и жители на нём — числа образец")], ["badge", calls.quoted("атом 5")], ["tone", calls.quoted("info")]])
        out calls.listed([head, panel("кольца прогресса", progress), panel("спидометры", gauges), panel("бублик, круговая, мишень, аватары, статусы", shapes())])
    }
}
