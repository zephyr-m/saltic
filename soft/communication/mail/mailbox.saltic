-- mailbox — ящик почтового клиента «Почта»: свои папки и письма, открытая
-- папка и выбранное письмо. Сам знает свой образец, список папок, список
-- писем открытой папки и открытое письмо; щелчок по папке открывает её, по
-- письму — открывает его и снимает «непрочитано».
--
-- Mailbox { owner, letters, folder, chosen } — адрес ящика, письма, открытая
--     папка, номер выбранного письма
-- sample() — наполнить образцом
-- folders() -> JTML панели папок; list() -> JTML списка писем папки;
--     opened() -> JTML открытого письма; choose(id) -> yes, если щелчок что-то
--     поменял; unread(name) -> сколько непрочитанных в папке; holds(name,
--     item) -> yes, если письмо в папке (в «важном» — все со звездой)
-- FOLDERS — [значок, имя]; FOLDER, LETTER — начала id

use core.str
use core.group
use os.text.parse
use tarantul.uiengine.jtml.calls
use soft.communication.mail.letter

FOLDER = "folder:"
LETTER = "letter:"
FOLDERS = [["inbox", "входящие"], ["star", "важное"], ["send", "отправленные"], ["file-text", "черновики"], ["archive", "архив"], ["trash-2", "корзина"]]
STARRED = "важное"
REPLIES = ["Спасибо, посмотрю!", "Да, давай так", "Созвонимся вечером?"]

Mailbox = Box {
    owner = "zephyr@saltic",
    letters = [],
    folder = "входящие",
    chosen = 0

    skill sample() {
        letters = [letter.Letter { author = "Fable", letters = "FA", tone = "accent", address = "fable@agents", subject = "Утечка SalticIDE найдена", time = "05:12", unread = yes, starred = yes, tags = ["память", "IDE"], lines = ["Нашёл, где течёт: пока корневой регион больше 512 КБ, карантин хранилища ничего не освобождает.", "Окно стало субъектом Window — побеги встают на полке около 20 МБ и дальше не растут.", "Сам предел в рантайме остался, варианты — в отчёте."], files = [["отчёт.md", "14 КБ"], ["замер.png", "220 КБ"]] }, letter.Letter { author = "tarantul", letters = "TA", tone = "up", address = "bot@saltic-registry", subject = "Привезено 10 пакетов", time = "04:02", unread = yes, tags = ["реестр"], lines = ["Каталог — git@github.com:zephyr-m/saltic-registry.git, коммит 418a9f7.", "Отпечатки всех десяти пакетов сошлись байт в байт."] }, letter.Letter { author = "Acer", letters = "AC", tone = "mustard", address = "agent@acer", subject = "Агент 58 на связи", time = "03:40", tags = ["железо"], lines = ["Хранитель экрана включится через 15 минут без жестов.", "Сеть: rtl8111, адрес 10.0.0.42."] }, letter.Letter { author = "global-check", letters = "GC", tone = "up", address = "check@saltic", subject = "12 из 12 — зелень", time = "02:46", lines = ["Все проверки прошли за 980 с, дольше всех — самосборка rv64."], files = [["чек.png", "1.4 МБ"]] }, letter.Letter { author = "Друг", letters = "ДР", tone = "info", address = "friend@mail", subject = "Как покодить на твоём языке?", time = "вчера", unread = yes, lines = ["Слышал, ты язык сделал. Можно попробовать? Хочу дать агенту поиграться."] }, letter.Letter { author = "ESP32", letters = "ES", tone = "down", address = "pult@esp32", subject = "Кнопка 3 залипла", time = "вчера", tags = ["пульт"], lines = ["Дребезг 40 мс на кнопке 3 — подними порог до 60."] }, letter.Letter { author = "Зэф", letters = "ЗЭ", tone = "mustard", address = "zephyr@saltic", subject = "Черновик: план на неделю", time = "пн", folder = "черновики", lines = ["Память правилами компилятора, ядро ОС, 92 репозитория."] }, letter.Letter { author = "Зэф", letters = "ЗЭ", tone = "mustard", address = "zephyr@saltic", subject = "Релиз «Тарантул»", time = "05:00", folder = "отправленные", lines = ["Saltic 310:82:286 вышел: реестр в своём репозитории."] }]
        out none
    }

    skill holds(name, item) {
        (name == STARRED) { out item.starred }
        out item.folder == name
    }

    skill unread(name) {
        @many = 0
        drum (letters) {
            (holds(name, beat) == yes) {
                (beat.unread == yes) { many = many + 1 }
            }
        }
        out many
    }

    skill folders() {
        @rows = []
        drum (FOLDERS) {
            @name = group.get(beat, 1)
            @kind = "menu-row"
            (name == folder) { kind = "menu-row-current" }
            @count = ""
            @many = unread(name)
            (many > 0) { count = "{many}" }
            rows = group.add(rows, calls.call(kind, [["id", calls.quoted("{FOLDER}{name}")], ["icon", calls.quoted(group.get(beat, 0))], ["text", calls.quoted(name)], ["count", calls.quoted(count)]]))
        }
        out calls.call("console-panel", [["title", calls.quoted("папки")], ["note", calls.quoted(owner)], ["width", "240"], ["radius", "14"], ["grow", "0"], ["children", calls.listed(rows)]])
    }

    skill list() {
        @rows = []
        @shown = 0
        drum (group.count(letters)) {
            @item = group.get(letters, beat)
            (holds(folder, item) == yes) {
                rows = group.add(rows, item.row("{LETTER}{beat}", beat == chosen))
                shown = shown + 1
            }
        }
        @fresh = unread(folder)
        out calls.call("console-panel", [["title", calls.quoted(folder)], ["note", calls.quoted("{shown} писем · {fresh} новых · образец")], ["width", "460"], ["radius", "14"], ["grow", "0"], ["children", calls.listed(rows)]])
    }

    skill opened() {
        @item = group.get(letters, chosen)
        @made = item.reading()
        @answers = []
        drum (REPLIES) { answers = group.add(answers, calls.call("chip", [["text", calls.quoted(beat)], ["fill", calls.quoted("panel")], ["tone", calls.quoted("accent")]])) }
        @quick = calls.join(answers)
        made = group.add(made, calls.call("section-head", [["text", calls.quoted("быстрый ответ")]]))
        made = group.add(made, "\{\"box\": \{\"flow\": \"row\", \"gap\": 8, \"children\": [{quick}]\}\}")
        made = group.add(made, calls.call("labeled-field", [["label", calls.quoted("ответ")], ["id", calls.quoted("reply")], ["value", calls.quoted("")]]))
        made = group.add(made, calls.call("button", [["text", calls.quoted("отправить")], ["fill", calls.quoted("accent")], ["tone", calls.quoted("ground")]]))
        out calls.call("console-panel", [["title", calls.quoted("письмо")], ["note", calls.quoted(item.folder)], ["width", "0"], ["radius", "14"], ["grow", "1"], ["children", calls.listed(made)]])
    }

    skill choose(id) {
        (str.starts_with(id, FOLDER) == yes) {
            folder = str.slice(id, str.bytes(FOLDER), str.bytes(id))
            drum (group.count(letters)) {
                @item = group.get(letters, group.count(letters) - 1 - beat)
                (holds(folder, item) == yes) { chosen = group.count(letters) - 1 - beat }
            }
            out yes
        }
        (str.starts_with(id, LETTER) == yes) {
            chosen = parse.parse_size(str.slice(id, str.bytes(LETTER), str.bytes(id)))
            @item = group.get(letters, chosen)
            item.unread = no
            out yes
        }
        out no
    }
}
