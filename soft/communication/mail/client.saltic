-- client — страница почтового клиента «Почта»: держит ящик и ставит части
-- по местам: сверху — шапка с поиском и кнопкой «написать», слева — ящики
-- аватарами и папки, в середине — список писем, справа — открытое письмо с
-- быстрым ответом, снизу — строка состояния. Своего вида нет — только
-- жители; письма — образец.
--
-- Client { box, accounts } — ящик и аватары ящиков [буквы, тон]
-- jtml() -> JTML всего окна; choose(id) -> yes, если щелчок что-то поменял
-- Внутри: shelf(flow, gap, grow, items) — ряд или столбик; head() — шапка;
--     rail() — ящики аватарами

use core.group
use tarantul.uiengine.jtml.calls
use soft.communication.mail.mailbox

Client = Box {
    box = mailbox.Mailbox {},
    accounts = [["ЗЭ", "mustard"], ["РА", "info"], ["SA", "up"]]

    skill shelf(flow, gap, grow, items) {
        @inside = calls.join(items)
        out "\{\"box\": \{\"flow\": \"{flow}\", \"gap\": {gap}, \"grow\": {grow}, \"children\": [{inside}]\}\}"
    }

    skill head() {
        @name = calls.call("figure", [["text", calls.quoted("Почта")], ["size", "20"], ["tone", calls.quoted("ink")]])
        @owner = box.owner
        @where = calls.call("badge", [["text", calls.quoted("{owner} · образец")], ["tone", calls.quoted("quiet")]])
        @search = calls.call("search-box", [["text", calls.quoted("|")], ["hint", calls.quoted("от кого, тема, текст")], ["tone", calls.quoted("line")]])
        @find = "\{\"box\": \{\"width\": 520, \"gap\": 0, \"children\": [{search}]\}\}"
        @gap = "\{\"box\": \{\"grow\": 1, \"gap\": 0\}\}"
        @write = calls.call("button", [["text", calls.quoted("написать")], ["fill", calls.quoted("accent")], ["tone", calls.quoted("ground")]])
        @row = "\{\"box\": \{\"flow\": \"row\", \"gap\": 14, \"align\": \"center\", \"children\": [{name}, {where}, {gap}, {find}, {gap}, {write}]\}\}"
        out calls.call("top-bar", [["height", "64"], ["children", calls.listed([row])]])
    }

    skill rail() {
        @faces = []
        drum (accounts) { faces = group.add(faces, calls.call("avatar", [["letters", calls.quoted(group.get(beat, 0))], ["tone", calls.quoted(group.get(beat, 1))]])) }
        out shelf("column", 12, 0, faces)
    }

    skill jtml() {
        @left = shelf("row", 12, 0, [rail(), box.folders()])
        @body = shelf("row", 12, 1, [left, box.list(), box.opened()])
        @folder = box.folder
        @fresh = box.unread("входящие")
        @status = calls.call("status-bar", [["text", calls.quoted("папка: {folder} · непрочитанных во входящих: {fresh} · образец: почта не подключена")], ["height", "28"]])
        @work = "\{\"box\": \{\"grow\": 1, \"gap\": 12, \"padding\": [12, 12, 12, 12], \"children\": [{body}]\}\}"
        @top = head()
        out "\{\"box\": \{\"fill\": \"ground\", \"gap\": 0, \"grow\": 1, \"children\": [{top}, {work}, {status}]\}\}"
    }

    skill choose(id) {
        out box.choose(id)
    }
}
