-- main — вход почтового клиента «Почта» (soft/communication/mail): окно
-- Wayland на этом компьютере, страница — client (ящики, папки, список писем,
-- открытое письмо из жителей UIEngine), тема soft, шрифты TTF из os/fonts и
-- значки os/icons. Щелчок по папке — она открыта, по письму — оно открыто и
-- прочитано; «×» окна или Esc — выход. Экран пересобирается только после
-- щелчка. Пока только Linux: общего слоя окна для всех машин ещё нет.
-- Письма — образец, почта не подключена — так и подписано.
--
-- Window { canvas, link, palette, desk, runtime, reader, packet, hold,
--     joined } — окно и всё долгое — его поля (корневой регион пуст);
--     start() — окно, шрифты, первый кадр; NoWindow; step() -> no, когда пора
--     выходить; drawn() — пересобрать и нарисовать
-- program() — вход
-- Внутри: face(path) -> Typeface из файла

use io.file
use core.bytes
use core.group
use core.socket
use tarantul.icons.icons
use tarantul.fonts.ttf
use tarantul.wayland.wayland.screen
use tarantul.graphics.graphics
use tarantul.input.gestures
use tarantul.uiengine.jtml
use tarantul.uiengine.jtml.read
use tarantul.uiengine.draw.atoms
use tarantul.uiengine.draw.typeface
use tarantul.uiengine.themes
use soft.communication.mail.client

REGULAR = "tarantul/fonts/inter/Inter-Regular.ttf"
BOLD = "tarantul/fonts/inter/Inter-Bold.ttf"
MONO = "tarantul/fonts/jetbrains-mono/JetBrainsMono-Regular.ttf"
ICONS = "tarantul/icons/lucide/icons.txt"
TITLE = "Почта"
WIDE = 1600
HIGH = 1000

skill face(path) {
    out typeface.from_bytes(file.read_bytes(path))
}

Window = Box {
    canvas = graphics.Screen {},
    link = screen.Link {},
    palette = atoms.Palette {},
    desk = client.Client {},
    runtime = jtml.Runtime {},
    reader = gestures.Reader {},
    packet = bytes.new(8192),
    hold = bytes.new(4096),
    joined = bytes.new(12288)

    skill drawn() {
        @tree = atoms.fitted(read.page(desk.jtml()), no, palette)
        runtime = jtml.mount(canvas, tree)
        atoms.draw(canvas, runtime, palette)
        out screen.present(link)
    }

    skill start() {
        @host = screen.sized(TITLE, WIDE, HIGH)
        (group.count(host) == 0) { out error.NoWindow }
        canvas = group.get(host, 0)
        link = group.get(host, 1)
        @sheet = file.read_bytes(ICONS)
        palette = atoms.with_icons(atoms.with_faces(themes.named("soft", canvas), face(REGULAR), face(BOLD), face(MONO)), icons.open(ttf.from_bytes(sheet), bytes.count(sheet)))
        @mail = desk.box
        mail.sample()
        out drawn()
    }

    skill step() {
        (link.way_closed == yes) { out no }
        (link.way_failed == yes) { out no }
        screen.pump(link, packet, hold, joined)
        @drained = reader.drain(link.way_events)
        link.way_events = drained.core
        @changed = no
        @closing = no
        drum (drained.gestures) {
            (beat.kind == gestures.Kind.CLICK) {
                @hit = jtml.hit(runtime, beat.x, beat.y)
                (hit.id == "close") { closing = yes }
                (desk.choose(hit.id) == yes) { changed = yes }
            }
        }
        (closing == yes) { out no }
        (changed == yes) { drawn() }
        socket.sleep(16)
        out yes
    }
}

program() {
    @window = Window {}
    window.start()
    always {
        (window.step() == no) { leave }
    }
    out none
}
