-- letter — письмо почтового клиента «Почта»: свои отправитель, тема, текст,
-- время, папка, вложения и метки; само знает, как выглядит строкой списка
-- и как — открытым. Письма — образец, так и подписано у окна.
--
-- Letter { author, letters, tone, address, subject, lines, time, folder,
--     unread, starred, files, tags } — letters — две буквы аватара, tone —
--     его цвет, lines — абзацы текста, files — [имя, размер], tags — метки
-- row(id, chosen) -> JTML строки списка: аватар, отправитель, тема, начало
--     текста, время; непрочитанное — с точкой, выбранное — в ячейке
-- reading() -> группа JTML открытого письма: шапка, метки, текст, вложения
-- Внутри: preview() -> начало первого абзаца, SHORT букв (не байтов)

use core.str
use core.group
use tarantul.uiengine.jtml.calls

SHORT = 60

Letter = Box {
    author = "",
    letters = "",
    tone = "accent",
    address = "",
    subject = "",
    lines = [],
    time = "",
    folder = "входящие",
    unread = no,
    starred = no,
    files = [],
    tags = []

    skill preview() {
        (group.count(lines) == 0) { out "" }
        @first = str.letters(group.get(lines, 0))
        (group.count(first) <= SHORT) { out str.join(first, "") }
        @cut = str.join(group.slice(first, 0, SHORT), "")
        out "{cut}…"
    }

    skill row(id, chosen) {
        @face = calls.call("avatar", [["letters", calls.quoted(letters)], ["tone", calls.quoted(tone)]])
        @weight = "regular"
        (unread == yes) { weight = "bold" }
        @who = calls.call("words", [["text", calls.quoted(author)], ["tone", calls.quoted("ink")], ["weight", calls.quoted(weight)], ["grow", "1"]])
        @when = calls.call("hint", [["text", calls.quoted(time)]])
        @mark = ""
        (unread == yes) { mark = calls.call("status-dot", [["tone", calls.quoted("accent")]]) }
        @top = "\{\"box\": \{\"flow\": \"row\", \"gap\": 8, \"align\": \"center\", \"children\": [{who}, {mark}, {when}]\}\}"
        (str.bytes(mark) == 0) { top = "\{\"box\": \{\"flow\": \"row\", \"gap\": 8, \"align\": \"center\", \"children\": [{who}, {when}]\}\}" }
        @about = calls.call("words", [["text", calls.quoted(subject)], ["tone", calls.quoted("ink")], ["weight", calls.quoted("regular")], ["grow", "0"]])
        @start = calls.call("hint", [["text", calls.quoted(preview())]])
        @text = "\{\"box\": \{\"gap\": 3, \"grow\": 1, \"children\": [{top}, {about}, {start}]\}\}"
        @inside = "\{\"box\": \{\"id\": \"{id}\", \"flow\": \"row\", \"gap\": 12, \"padding\": [10, 12, 10, 12], \"align\": \"center\", \"children\": [{face}, {text}]\}\}"
        (chosen == no) { out inside }
        out calls.call("cell", [["fill", calls.quoted("accent_soft")], ["edge", calls.quoted("accent_rim")], ["children", calls.listed([inside])]])
    }

    skill reading() {
        @face = calls.call("avatar", [["letters", calls.quoted(letters)], ["tone", calls.quoted(tone)]])
        @title = calls.call("headline", [["text", calls.quoted(subject)], ["grow", "1"]])
        @who = calls.call("hint", [["text", calls.quoted("{author} <{address}> · {time}")]])
        @names = "\{\"box\": \{\"gap\": 4, \"grow\": 1, \"children\": [{title}, {who}]\}\}"
        @made = ["\{\"box\": \{\"flow\": \"row\", \"gap\": 14, \"align\": \"center\", \"children\": [{face}, {names}]\}\}"]
        @chips = []
        drum (tags) { chips = group.add(chips, calls.call("chip", [["text", calls.quoted(beat)], ["fill", calls.quoted("raise")], ["tone", calls.quoted("ink")]])) }
        (starred == yes) { chips = group.add(chips, calls.call("chip", [["text", calls.quoted("★ важное")], ["fill", calls.quoted("mustard_soft")], ["tone", calls.quoted("mustard")]])) }
        (group.count(chips) > 0) {
            @row = calls.join(chips)
            made = group.add(made, "\{\"box\": \{\"flow\": \"row\", \"gap\": 6, \"children\": [{row}]\}\}")
        }
        made = group.add(made, calls.call("divider", [["width", "0"], ["height", "1"]]))
        drum (lines) { made = group.add(made, calls.call("words", [["text", calls.quoted(beat)], ["tone", calls.quoted("ink")], ["weight", calls.quoted("regular")], ["grow", "0"]])) }
        (group.count(files) > 0) {
            @count = group.count(files)
            made = group.add(made, calls.call("section-head", [["text", calls.quoted("вложения · {count}")]]))
            @cards = []
            drum (files) { cards = group.add(cards, calls.call("link-row", [["icon", calls.quoted("paperclip")], ["tone", calls.quoted("accent")], ["title", calls.quoted(group.get(beat, 0))], ["text", calls.quoted(group.get(beat, 1))], ["size", "13"], ["small", "11"]])) }
            @inside = calls.join(cards)
            made = group.add(made, "\{\"box\": \{\"flow\": \"row\", \"gap\": 24, \"children\": [{inside}]\}\}")
        }
        out made
    }
}
