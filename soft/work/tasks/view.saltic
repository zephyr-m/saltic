-- view — доска задач текстом JTML на жителях закрытой библиотеки
-- (registry/libraries/uiengine/library — она и есть UIEngine): шапка board-head, подсказка label,
-- строка выбранной, три колонки task-column по COLUMN_WIDE, в каждой —
-- карточки task-card с номером. Выбранная задача — тёмный номер, «в руке» —
-- красный. Длинное название режет сам атом по ширине (cut), строка выбранной
-- — целиком. Кавычки и обратные слэши в тексте задач заменяются, чтобы не
-- ломать JTML.
--
-- board_jtml(desk, note) -> текст JTML; note — строка состояния рядом с заголовком
-- column_card(desk, column, width) -> колонка task-column; chosen_line(desk) ->
--     строка выбранной; task_card(desk, number) -> карточка задачи
-- safe(words) -> текст без «"» и «\»

use core.str
use core.group
use tarantul.uiengine.jtml.calls
use soft.work.tasks.board

QUOTE = 34
BACKSLASH = 92
COLUMN_WIDE = 200

skill safe(words) {
    @clean = ""
    drum (str.bytes(words)) {
        @code = str.byte(words, beat)
        pick {
            (code == QUOTE) { clean = str.concat(clean, "'") }
            (code == BACKSLASH) { clean = str.concat(clean, "/") }
            { clean = str.concat(clean, str.get(words, beat)) }
        }
    }
    out clean
}

skill chosen_line(desk) {
    (desk.selected == 0) { out "ничего не выбрано" }
    @number = desk.selected
    @name = safe(group.get(desk.names, number - 1))
    out "{number}. {name}"
}

skill task_card(desk, number) {
    @fill = "well"
    @tone = "quiet"
    (number == desk.selected) {
        fill = "ink"
        tone = "ground"
        (desk.holding == yes) { fill = "down" }
    }
    @name = safe(group.get(desk.names, number - 1))
    out calls.call("task-card", [["id", calls.quoted("task-{number}")], ["number", calls.quoted("{number}")], ["name", calls.quoted(name)], ["fill", calls.quoted(fill)], ["tone", calls.quoted(tone)]])
}

skill column_card(desk, column, width) {
    @title = group.get(board.COLUMN_NAMES, column)
    @numbers = board.tasks_in(desk, column)
    @cards = []
    drum (numbers) { cards = group.add(cards, task_card(desk, beat)) }
    @total = group.count(numbers)
    out calls.call("task-column", [["title", calls.quoted(title)], ["count", calls.quoted("{total}")], ["width", "{width}"], ["cards", calls.listed(cards)]])
}

skill board_jtml(desk, note) {
    @columns = []
    drum (3) { columns = group.add(columns, column_card(desk, beat, COLUMN_WIDE)) }
    @row = calls.join(columns)
    @head = calls.call("board-head", [["title", calls.quoted("Задачи Saltic")], ["note", calls.quoted(safe(note))]])
    @hints = calls.call("label", [["text", calls.quoted("стрелки — выбор · Enter — взять и положить · Пробел — открыть · Esc — выход")]])
    @chosen = calls.quoted(chosen_line(desk))
    out "\{\"box\": \{\"fill\": \"ground\", \"padding\": 16, \"gap\": 12, \"children\": [{head}, {hints}, \{\"text\": \{\"value\": {chosen}, \"size\": 14, \"cut\": \"yes\"\}\}, \{\"box\": \{\"flow\": \"row\", \"gap\": 12, \"children\": [{row}]\}\}]\}\}"
}
