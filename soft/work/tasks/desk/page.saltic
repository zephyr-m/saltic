-- page — экраны клиента доски задач без своего вида: та же доска, что на
-- Acer, её же модулями (programs/tasks/view и task_view — жители закрытой
-- библиотеки) над board.Board из mirror.board_of. Доска на узком экране —
-- шапка board-head, подсказка, строка выбранной и одна колонка
-- view.column_card шириной WIDE (свайп меняет колонку); задача —
-- task_view.task_jtml как есть. Касание находит рисовальщик атомов по id
-- (jtml.hit): task-<номер> — открыть, item-<номер> — галочка, back —
-- название в задаче (назад на доску). Ошибка связи — значок «нет связи» и
-- причина строкой под шапкой.
--
-- View { column, inside } — колонка доски, открыта ли задача
-- source(desk, look) -> JTML экрана; look — View
-- act(desk, look, id) -> yes, если касание что-то поменяло (запросы — mirror)
-- swipe(desk, look, step) -> yes, если сменилась колонка (доска) или задача
--     закрылась (свайп вправо в задаче)
-- Внутри: note_of(desk) -> значок шапки; column_jtml — доска одной колонкой

use core.str
use core.group
use tarantul.uiengine.jtml.calls
use craft.text.parse
use soft.work.tasks.board
use soft.work.tasks.view
use soft.work.tasks.task_view
use soft.work.tasks.desk.mirror

WIDE = 374

View = Box {
    column = 1,
    inside = no
}

skill note_of(desk) {
    @host = desk.link.host
    (str.bytes(desk.problem) == 0) { out "Acer {host}" }
    out "нет связи"
}

skill column_jtml(desk, look) {
    @made = mirror.board_of(desk)
    @head = calls.call("board-head", [["title", calls.quoted("Задачи Saltic")], ["note", calls.quoted(note_of(desk))]])
    @parts = [head, calls.call("label", [["text", calls.quoted("свайп — колонки · касание — открыть")]])]
    (str.bytes(desk.problem) > 0) {
        @problem = calls.quoted(view.safe(desk.problem))
        parts = group.add(parts, "\{\"text\": \{\"value\": {problem}, \"size\": 13, \"tone\": \"down\", \"cut\": \"yes\"\}\}")
    }
    parts = group.add(parts, view.column_card(made, look.column, WIDE))
    @inside = calls.join(parts)
    out "\{\"box\": \{\"fill\": \"ground\", \"padding\": 16, \"gap\": 12, \"children\": [{inside}]\}\}"
}

skill source(desk, look) {
    (look.inside == yes) { out task_view.task_jtml(mirror.board_of(desk), note_of(desk)) }
    out column_jtml(desk, look)
}

skill tail(id, prefix) {
    out parse.parse_size(str.slice(id, str.bytes(prefix), str.bytes(id)))
}

skill act(desk, look, id) {
    (str.starts_with(id, "task-") == yes) {
        mirror.open_task(desk, tail(id, "task-"))
        look.inside = yes
        out yes
    }
    (id == "back") {
        look.inside = no
        mirror.refresh(desk)
        out yes
    }
    (str.starts_with(id, "item-") == yes) {
        mirror.tick(desk, tail(id, "item-"))
        out yes
    }
    out no
}

skill swipe(desk, look, step) {
    (look.inside == yes) {
        (step < 0) {
            look.inside = no
            mirror.refresh(desk)
            out yes
        }
        out no
    }
    @next = look.column + step
    (next < 0) { out no }
    (next > 2) { out no }
    look.column = next
    out yes
}
