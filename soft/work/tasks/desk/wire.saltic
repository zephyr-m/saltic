-- wire — клиент mRPC/1.0 по UDP (docs/protocols/MRPC-UDP.md) для клиента
-- доски задач: сокет UDP без блокировки, связанный с адресом Acer; запрос —
-- объект JSON с cmd, id и параметрами, ответ ждётся не дольше WAIT_MS × TRIES
-- (1 с — закон автора об ответе), ответы с чужим id отбрасываются. Ответ —
-- Answer: ok и data, иначе message — причина словами (Acer молчит, ошибка mRPC
-- с кодом), её показывает экран. Работает на Linux и Android (то же ядро).
--
-- Link { fd, host, port, next } — связь; open(host, port) -> Link; host —
--     «a.b.c.d»; NoSocket, BadHost
-- Answer { ok, data, message } — data — json.Value объекта data
-- ask(link, cmd, params) -> Answer; params — поля JSON текстом («"number":15»)
-- Внутри: address(host, port) -> байты sockaddr_in; reply_of(link, id) ->
--     текст ответа или ""; parsed(text, id) -> Answer или none (чужой id)

use core.str
use core.group
use core.bytes
use core.socket
use craft.protocols.data.json
use craft.protocols.data.json.value
use craft.protocols.data.json.reader
use craft.text.utf8
use craft.text.parse
use craft.protocols.mrpc

INET = 2
DATAGRAM = 2
NONBLOCK = 2048
AGAIN = -11
WAIT_MS = 20
TRIES = 50
ROOM = 2048

Link = Box {
    fd = -1,
    host = "",
    port = 0,
    next = 1
}

Answer = Box {
    ok = no,
    data = json.Value {},
    message = ""
}

skill address(host, port) {
    @parts = str.split(host, ".")
    ((group.count(parts) == 4) == no) { out error.BadHost }
    @made = bytes.new(16)
    bytes.set(made, 0, INET)
    bytes.set(made, 2, port / 256)
    bytes.set(made, 3, port % 256)
    drum (4) { bytes.set(made, 4 + beat, parse.parse_size(group.get(parts, beat))) }
    out made
}

skill open(host, port) {
    @fd = socket.open(INET, DATAGRAM + NONBLOCK, 0)
    (fd < 0) { out error.NoSocket }
    socket.connect(fd, address(host, port))
    out Link { fd = fd, host = host, port = port }
}

skill reply_of(link, id) {
    @room = bytes.new(ROOM)
    drum (TRIES) {
        @got = socket.read(link.fd, room)
        (got > 0) {
            @text = utf8.decode(bytes.to_group(bytes.slice(room, 0, got)), 0, got)
            (parsed(text, id)) |answer| { out text }
        }
        (got <= 0) { socket.sleep(WAIT_MS) }
    }
    out ""
}

skill parsed(text, id) {
    @read = reader.parse(text)
    (read.ok == no) { out Answer { message = "ответ Acer — не JSON: {read.message}" } }
    @asked = value.get(read.value, "id")
    (asked.found == no) { out none }
    ((mrpc.plain(asked.value) == "{id}") == no) { out none }
    @fine = value.get(read.value, "ok")
    (fine.found == yes) {
        (fine.value.answer == yes) {
            @data = value.get(read.value, "data")
            out Answer { ok = yes, data = data.value }
        }
    }
    @fault = value.get(read.value, "error")
    @code = value.get(fault.value, "code")
    @said = value.get(fault.value, "message")
    @code_text = mrpc.plain(code.value)
    @said_text = mrpc.plain(said.value)
    out Answer { message = "{code_text}: {said_text}" }
}

skill ask(link, cmd, params) {
    @id = link.next
    link.next = link.next + 1
    @body = "\{\"cmd\":\"{cmd}\",\"id\":{id}\}"
    (str.bytes(params) > 0) { body = "\{\"cmd\":\"{cmd}\",\"id\":{id},{params}\}" }
    @sent = utf8.encode(body)
    socket.write(link.fd, bytes.from_group(sent), group.count(sent))
    @text = reply_of(link, id)
    (str.bytes(text) == 0) { out Answer { message = "Acer молчит ({link.host}:{link.port}) — нет связи или доска на нём закрыта" } }
    @answer = parsed(text, id)
    (answer) |answer| { out answer }
    out Answer { message = "ответ Acer не разобран" }
}
