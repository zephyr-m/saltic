-- store — доска на диске Acer: \SALTIC\TASKS.TXT, по строке на задачу:
-- «колонка|текст» (колонка — цифра 0..2), под ней её пункты строками
-- «  [x] ДД.ММ.ГГГГ ЧЧ:ММ|текст» (сделан; [ ] — нет; время — последнего
-- изменения), события «  @ ДД.ММ.ГГГГ ЧЧ:ММ|что случилось» и сообщения
-- «  > ДД.ММ.ГГГГ ЧЧ:ММ|автор|текст» (автор без «|»). Старые строки
-- без времени («  [x]|текст») и файлы без пунктов читаются как раньше — время
-- у них "" (неизвестно). Пишется целиком заново; старый
-- файл сначала удаляется. Нет файла — доска начинается с наших задач.
-- Буфер — участок арены "tasks" из arena_map (32 КБ).
--
-- load_desk(base) -> Board; нет файла — starting_board
-- Внутри: stamped(found, stamp) — « время|» или «|»; under(desk, last, stored,
--     start, end) — строка пункта или события под задачей last; bar_after,
--     stamp_between — где «|» и что перед ним
-- save_desk(base, desk) -> байт записано; DeskTooBig, WriteFailed

use core.str
use core.group
use tarantul.firmware.firmware
use tarantul.firmware.firmware.arena_map
use craft.text.utf8
use tarantul.files.files
use soft.work.tasks.board

FOLDER = "SALTIC"
FILE_NAME = "TASKS.TXT"
FILE_DELETE = 24
MODE_READ_WRITE = 3
LINE_END = 10
BAR = 124
ZERO = 48
SPACE = 32
OPEN = 91
CLOSE = 93
TICK = 120
AT = 64
QUOTED = 62
ITEM_HEAD = 6

skill desk_buffer(base) {
    out firmware.region(base, "tasks")
}

skill desk_limit() {
    @room = arena_map.region("tasks")
    out room.bytes
}

skill desk_bytes(desk) {
    @found = []
    drum (group.count(desk.names)) {
        found = group.add(found, ZERO + group.get(desk.columns, beat))
        found = group.add(found, BAR)
        found = group.concat(found, utf8.encode(group.get(desk.names, beat)))
        found = group.add(found, LINE_END)
        drum (group.get(desk.items, beat)) {
            @mark = SPACE
            (group.get(beat, 0) == yes) { mark = TICK }
            found = group.concat(found, [SPACE, SPACE, OPEN, mark, CLOSE])
            found = stamped(found, group.get(beat, 2))
            found = group.concat(found, utf8.encode(group.get(beat, 1)))
            found = group.add(found, LINE_END)
        }
        drum (group.get(desk.events, beat)) {
            found = group.concat(found, [SPACE, SPACE, AT])
            found = stamped(found, group.get(beat, 0))
            found = group.concat(found, utf8.encode(group.get(beat, 1)))
            found = group.add(found, LINE_END)
        }
        drum (group.get(desk.messages, beat)) {
            found = group.concat(found, [SPACE, SPACE, QUOTED])
            found = stamped(found, group.get(beat, 0))
            found = group.add(group.concat(found, utf8.encode(group.get(beat, 1))), BAR)
            found = group.concat(found, utf8.encode(group.get(beat, 2)))
            found = group.add(found, LINE_END)
        }
    }
    out found
}

skill stamped(found, stamp) {
    @made = found
    (str.bytes(stamp) > 0) { made = group.concat(group.add(made, SPACE), utf8.encode(stamp)) }
    out group.add(made, BAR)
}

skill bar_after(stored, from, end) {
    drum (end - from) {
        (group.get(stored, from + beat) == BAR) { out from + beat }
    }
    out -1
}

skill stamp_between(stored, from, bar) {
    (bar - from < 2) { out "" }
    out utf8.decode(stored, from + 1, bar - from - 1)
}

skill drop_old(base, folder) {
    @child_at = firmware.scratch(base, files.SCRATCH_POINTER)
    @opened = firmware.call(base, firmware.pointer(folder, base, files.FILE_OPEN), [folder, child_at, files.wide_name(base, FILE_NAME), firmware.number(MODE_READ_WRITE), firmware.number(0)])
    (opened.failed == yes) { out none }
    @old = firmware.pointer(child_at, base, 0)
    out firmware.call(base, firmware.pointer(old, base, FILE_DELETE), [old])
}

skill save_desk(base, desk) {
    @written = desk_bytes(desk)
    (group.count(written) > desk_limit()) { out error.DeskTooBig }
    @buffer = desk_buffer(base)
    drum (group.count(written)) { firmware.write8(buffer, base, beat, group.get(written, beat)) }
    @root = files.saltic_root(base)
    @folder = files.create(base, root, FOLDER, files.DIRECTORY)
    drop_old(base, folder)
    @file = files.create(base, folder, FILE_NAME, 0)
    @size_at = firmware.scratch(base, files.SCRATCH_SIZE)
    firmware.write64(size_at, base, 0, firmware.number(group.count(written)))
    @done = firmware.call(base, firmware.pointer(file, base, files.FILE_WRITE), [file, size_at, buffer])
    firmware.call(base, firmware.pointer(file, base, files.FILE_FLUSH), [file])
    files.close_file(base, file)
    files.close_file(base, folder)
    files.close_file(base, root)
    (done.failed == yes) { out error.WriteFailed }
    out group.count(written)
}

skill stored_bytes(base) {
    @root = files.saltic_root(base)
    @file = files.open_child(base, root, "SALTIC\\TASKS.TXT") rescue |err| {
        files.close_file(base, root)
        out []
    }
    @buffer = desk_buffer(base)
    @size_at = firmware.scratch(base, files.SCRATCH_SIZE)
    firmware.write64(size_at, base, 0, firmware.number(desk_limit()))
    @asked = firmware.call(base, firmware.pointer(file, base, files.FILE_READ), [file, size_at, buffer])
    files.close_file(base, file)
    files.close_file(base, root)
    (asked.failed == yes) { out [] }
    @size = firmware.read16(size_at, base, 0)
    @found = []
    drum (size) { found = group.add(found, firmware.read8(buffer, base, beat)) }
    out found
}

skill under(desk, last, stored, start, end) {
    @event = group.get(stored, start + 2) == AT
    @message = group.get(stored, start + 2) == QUOTED
    @from = start + 5
    (event == yes) { from = start + 3 }
    (message == yes) { from = start + 3 }
    @bar = bar_after(stored, from, end)
    (bar < 0) { out none }
    @stamp = stamp_between(stored, from, bar)
    @text = utf8.decode(stored, bar + 1, end - bar - 1)
    (event == yes) { out board.note_event(desk, last, stamp, text) }
    (message == yes) {
        @split = bar_after(stored, bar + 1, end)
        (split < 0) { out none }
        board.post(desk, last, stamp, utf8.decode(stored, bar + 1, split - bar - 1), utf8.decode(stored, split + 1, end - split - 1))
        out none
    }
    @place = board.add_item(desk, last, text, stamp)
    (group.get(stored, start + 3) == TICK) { board.tick_item(desk, last, place, stamp) }
    out none
}

skill load_desk(base) {
    @stored = stored_bytes(base)
    (group.count(stored) == 0) { out board.starting_board() }
    @desk = board.Board {}
    @start = 0
    drum (group.count(stored)) {
        (group.get(stored, beat) == LINE_END) {
            @item = group.get(stored, start) == SPACE
            (item == no) {
                (beat - start > 2) {
                    @column = group.get(stored, start) - ZERO
                    board.put_task(desk, column, utf8.decode(stored, start + 2, beat - start - 2))
                }
            }
            (item == yes) {
                @last = group.count(desk.names)
                (last > 0) { (beat - start >= ITEM_HEAD) { under(desk, last, stored, start, beat) } }
            }
            start = beat + 1
        }
    }
    (group.count(desk.names) == 0) { out board.starting_board() }
    out desk
}
