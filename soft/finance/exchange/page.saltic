-- page — страница биржи, уровень 5: Box Page держит компоненты — шапку
-- (head), стакан (depth), график (graph), заявку (order), сделки (feed) и
-- баланс (wallet), каждый — Box в своём файле exchange/components, — и ставит
-- их по местам: шапка сверху, стакан, график и заявка в ряд, сделки и баланс
-- внизу. Своего вида у страницы нет. Ссылки только вниз: страница → компоненты.
--
-- Page { head, depth, graph, order, feed, wallet }
-- follow(quotes) — раздать блокам цену и такт рынка (market.Market)
-- jtml() -> текст страницы

use tarantul.uiengine.jtml.calls
use soft.finance.exchange.components.ticker
use soft.finance.exchange.components.book
use soft.finance.exchange.components.chart
use soft.finance.exchange.components.form
use soft.finance.exchange.components.trades
use soft.finance.exchange.components.balance

Page = Box {
    head = ticker.Ticker {},
    depth = book.Book {},
    graph = chart.Chart {},
    order = form.Form {},
    feed = trades.Trades {},
    wallet = balance.Balance {}

    skill follow(quotes) {
        head.price = quotes.price
        depth.price = quotes.price
        depth.tick = quotes.tick
        graph.price = quotes.price
        graph.tick = quotes.tick
        feed.price = quotes.price
        feed.tick = quotes.tick
        out none
    }

    skill jtml() {
        @top = head.jtml()
        @middle = calls.join([depth.jtml(), graph.jtml(), order.jtml()])
        @bottom = calls.join([feed.jtml(), wallet.jtml()])
        out "\{\"box\": \{\"gap\": 8, \"padding\": 10, \"children\": [{top}, \{\"box\": \{\"flow\": \"row\", \"gap\": 8, \"children\": [{middle}]\}\}, \{\"box\": \{\"flow\": \"row\", \"gap\": 8, \"children\": [{bottom}]\}\}]\}\}"
    }
}
