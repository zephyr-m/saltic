-- book — блок биржи «стакан»: ROWS заявок на продажу над ценой и ROWS на покупку
-- под ней, у каждой — полоска глубины по количеству (до BOOK_BAR точек при
-- DEEPEST). Box Book показывает себя жителем order-book, строки — book-row.
--
-- Book { price, tick } — цена и такт рынка; row(level, amount, tone) — строка;
--     jtml() -> текст JTML

use core.group
use soft.finance.exchange.market
use tarantul.uiengine.jtml.calls

ROWS = 8
DEEPEST = 3020
BOOK_BAR = 228
STEP = 950

Book = Box {
    price = market.START,
    tick = 0

    skill row(level, amount, tone) {
        @bar = market.within(amount * BOOK_BAR / DEEPEST, 1, BOOK_BAR)
        out calls.call("book-row", [["price", calls.quoted(market.money(level))], ["amount", calls.quoted(market.coins(amount))], ["tone", calls.quoted(tone)], ["bar", "{bar}"]])
    }

    skill jtml() {
        @asks = []
        drum (ROWS) {
            @step = ROWS - beat
            asks = group.add(asks, row(price + step * STEP, market.noise(tick * 31 + beat) * 3 + 20, "down"))
        }
        @bids = []
        drum (ROWS) { bids = group.add(bids, row(price - (beat + 1) * STEP, market.noise(tick * 17 + beat) * 3 + 20, "up")) }
        out calls.call("order-book", [["asks", calls.listed(asks)], ["mid", calls.quoted(market.money(price))], ["bids", calls.listed(bids)]])
    }
}
