-- chart — блок биржи «график»: CANDLES свечей высотой CHART, сетка из четырёх
-- линий, линия и плашка текущей цены, шкала цен справа (CENTS_PER_PIXEL центов
-- на точку), объём высотой VOLUME. Box Chart показывает себя жителем chart.
--
-- Chart { price, tick } — цена и такт рынка; jtml() -> текст JTML
-- Внутри: candle(height, size, space, tone); price_candle(t) / volume_candle(t)

use core.group
use soft.finance.exchange.market
use tarantul.uiengine.jtml.calls

CANDLES = 48
CHART = 272
VOLUME = 56
CENTS_PER_PIXEL = 1000

Chart = Box {
    price = market.START,
    tick = 0

    skill candle(height, size, space, tone) {
        out calls.call("candle", [["space", "{space}"], ["size", "{size}"], ["tone", calls.quoted(tone)], ["height", "{height}"]])
    }

    skill price_candle(t) {
        @now = market.level(t) * (CHART - 20) / 1000
        @before = market.level(t - 1) * (CHART - 20) / 1000
        @top = now
        (before > top) { top = before }
        @size = now - before
        (size < 0) { size = -size }
        (size < 3) { size = 3 }
        out candle(CHART, size, CHART - 10 - top, market.direction(market.change_sign(now - before)))
    }

    skill volume_candle(t) {
        @size = market.noise(t * 13) * (VOLUME - 4) / 1000 + 4
        out candle(VOLUME, size, VOLUME - size, market.direction(market.change_sign(market.level(t) - market.level(t - 1))))
    }

    skill jtml() {
        @candles = []
        @volumes = []
        drum (CANDLES) {
            @t = tick - CANDLES + beat
            candles = group.add(candles, price_candle(t))
            volumes = group.add(volumes, volume_candle(t))
        }
        @grid = []
        @labels = []
        @at = CHART - 10 - market.level(tick - 1) * (CHART - 20) / 1000
        @quarter = CHART / 4
        @segment = quarter - 1
        drum (4) {
            grid = group.add(grid, calls.call("bar", [["height", "1"], ["tone", calls.quoted("select")]]))
            grid = group.add(grid, calls.call("gap", [["height", "{segment}"]]))
            @mark_price = price + (at - beat * quarter) * CENTS_PER_PIXEL
            labels = group.add(labels, calls.call("scale-mark", [["text", calls.quoted(market.money(mark_price))], ["height", "{quarter}"]]))
        }
        @tag = market.within(at - 8, 0, CHART - 20)
        @line = calls.call("price-line", [["space", "{at}"]])
        @mark = calls.call("price-mark", [["space", "{tag}"], ["price", calls.quoted(market.money(price))]])
        out calls.call("chart", [["title", calls.quoted("BTC/USDT · 15 мин")], ["height", "{CHART}"], ["grid", calls.listed(grid)], ["candles", calls.listed(candles)], ["line", calls.listed([line])], ["mark", calls.listed([mark])], ["labels", calls.listed(labels)], ["volume", "{VOLUME}"], ["volumes", calls.listed(volumes)]])
    }
}
