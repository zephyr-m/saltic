-- ticker — блок биржи «шапка»: цена, её изменение от открытия, пределы дня и
-- объём. Box Ticker знает, что показывает, и показывает себя жителем ticker.
--
-- Ticker { price, user } — цена в центах и имя владельца; jtml() -> текст JTML

use soft.finance.exchange.market
use tarantul.uiengine.jtml.calls

Ticker = Box {
    price = market.START,
    user = "Зефир"

    skill jtml() {
        @change = price - market.START
        @sign = "+"
        (change < 0) {
            sign = "-"
            change = -change
        }
        @percent = change * 10000 / market.START
        @whole = percent / 100
        @part = market.two(percent % 100)
        @tone = market.direction(market.change_sign(price - market.START))
        out calls.call("ticker", [["price", calls.quoted(market.money(price))], ["change", calls.quoted("{sign}{whole}.{part} %")], ["tone", calls.quoted(tone)], ["high", calls.quoted(market.money(market.START + 60770))], ["low", calls.quoted(market.money(market.START - 153250))], ["volume", calls.quoted("12 840 BTC")], ["user", calls.quoted(user)]])
    }
}
