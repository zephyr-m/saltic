-- form — блок биржи «заявка»: поля цены и количества, доля и плечо ползунками,
-- итог. Box Form сам принимает клавиши: Tab — следующее, стрелки — ползунок,
-- цифры, точка и Backspace — в поле.
--
-- Form { price_text, amount_text, share, leverage, focus } — что в форме и что в
--     фокусе (0 цена, 1 количество, 2 доля, 3 плечо)
-- next() — фокус дальше; press(scan, char) — клавиша в фокусное; focused() ->
--     id атома в фокусе; jtml() -> текст JTML
-- Внутри: typed(text, char) -> поле после буквы

use core.str
use core.group
use soft.finance.exchange.market
use tarantul.uiengine.jtml.calls

SCAN_RIGHT = 3
SCAN_LEFT = 4
BACKSPACE = 8
DOT = 46
ZERO = 48
NINE = 57
FIELD_LIMIT = 12
IDS = ["price", "amount", "share", "leverage"]

Form = Box {
    price_text = "67412.50",
    amount_text = "0.150",
    share = 25,
    leverage = 3,
    focus = 0

    skill typed(text, char) {
        (char == BACKSPACE) {
            (str.bytes(text) == 0) { out text }
            out str.slice(text, 0, str.bytes(text) - 1)
        }
        (str.bytes(text) >= FIELD_LIMIT) { out text }
        (char == DOT) { out str.concat(text, ".") }
        (char < ZERO) { out text }
        (char > NINE) { out text }
        out str.concat(text, str.from_byte(char))
    }

    skill next() {
        focus = (focus + 1) % 4
        out none
    }

    skill press(scan, char) {
        @step = 0
        (scan == SCAN_RIGHT) { step = 1 }
        (scan == SCAN_LEFT) { step = -1 }
        (focus == 0) { price_text = typed(price_text, char) }
        (focus == 1) { amount_text = typed(amount_text, char) }
        (focus == 2) { share = market.within(share + step * 5, 0, 100) }
        (focus == 3) { leverage = market.within(leverage + step, 1, 10) }
        out none
    }

    skill focused() {
        out group.get(IDS, focus)
    }

    skill jtml() {
        out calls.call("order-form", [["price", calls.quoted(price_text)], ["amount", calls.quoted(amount_text)], ["share", "{share}"], ["leverage", "{leverage}"], ["total", calls.quoted("итог: цена x кол-во x {leverage}")]])
    }
}
