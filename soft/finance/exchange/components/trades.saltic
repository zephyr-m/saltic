-- trades — блок биржи «сделки»: последние TRADES сделок со временем, ценой,
-- количеством и стороной. Box Trades показывает себя жителем trades.
--
-- Trades { price, tick } — цена и такт рынка; jtml() -> текст JTML

use core.group
use soft.finance.exchange.market
use tarantul.uiengine.jtml.calls

TRADES = 6

Trades = Box {
    price = market.START,
    tick = 0

    skill jtml() {
        @rows = []
        drum (TRADES) {
            @second = (tick - beat + 3600) % 60
            @minute = (tick - beat + 3600) / 60 % 60
            @side = "купля"
            @tone = "up"
            (market.noise(tick - beat) % 2 == 1) {
                side = "продажа"
                tone = "down"
            }
            @minutes = market.two(minute)
            @seconds = market.two(second)
            rows = group.add(rows, calls.call("trade-row", [["time", calls.quoted("17:{minutes}:{seconds}")], ["price", calls.quoted(market.money(price - market.noise(tick - beat) + 500))], ["amount", calls.quoted(market.coins(market.noise(tick * 3 - beat) / 4 + 5))], ["side", calls.quoted(side)], ["tone", calls.quoted(tone)]]))
        }
        out calls.call("trades", [["rows", calls.listed(rows)]])
    }
}
