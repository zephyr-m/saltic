-- x86_64_translation — x86-64 переводом: берёт готовую машину RV32I и
-- переводит её команды в родной код, затем пишет файл. Сама машина остаётся
-- внутри образа как данные гостя. Родной бэкенд — x86_64_native (заглушка).
--
-- write(path, machine) — ELF для Linux x86-64; UnresolvedPatch
-- write_uefi(path, machine) — PE32+ для UEFI; UnresolvedPatch
--
-- Дети: translator (перевод команд), encoder (байты x86), image (ELF),
-- pe (PE32+), platform (заглушки Linux), uefi (заглушки прошивки).

use selfhost.compiler.backend.x86_64_translation.translator
use selfhost.compiler.backend.x86_64_translation.image
use selfhost.compiler.backend.x86_64_translation.pe

skill write_uefi(path, machine) {
    @firmware = translator.translate_uefi(machine) rescue |failure| { out error.UnresolvedPatch }
    out pe.write(path, firmware)
}

skill write(path, machine) {
    @translated = translator.translate(machine) rescue |failure| { out error.UnresolvedPatch }
    out image.write(path, translated)
}
