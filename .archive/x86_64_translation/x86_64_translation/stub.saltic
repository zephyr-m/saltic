-- stub — платформа UEFI для перевода: метки договора платформы (compiler/platform)
-- на RV32I-машине, которые заглушка uefi.SYSCALL_STUB исполняет по номерам
-- ecall: write (64), exit (93), key (29/63), firmware (500), call (503).
-- wait — executor.wait (hlt у родного исполнителя). Файлы и время — NotSupported. Linux-цель перевода
-- платформы своей не имеет: ей годится platform.linux.Linux, заглушка
-- platform.SYSCALL_STUB переводит те же номера.
-- Команды — методами compiler.executor (договор backend), регистры — его роли.
--
-- Uefi { name } — платформа: append(compiler) -> compiler
-- emit_firmware / emit_call / emit_wait(compiler) — rt_platform_firmware / call / wait

use core.system
use selfhost.abi
use selfhost.compiler.backend
use selfhost.compiler.platform
use selfhost.compiler.platform.linux

UNSUPPORTED = ["file_read", "file_write", "now"]

Uefi = Box {
    name = "uefi"

    skill append(compiler) {
        compiler = linux.emit_write(compiler)
        compiler = linux.emit_exit(compiler)
        compiler = linux.emit_key(compiler)
        compiler = linux.append_key_data(compiler)
        compiler = emit_firmware(compiler)
        compiler = emit_call(compiler)
        compiler = emit_wait(compiler)
        out platform.append_unsupported(compiler, UNSUPPORTED)
    }
}

skill emit_wait(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, platform.WAIT)
    compiler = executor.wait(compiler)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NONE)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_firmware(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, platform.FIRMWARE)
    compiler = executor.syscall(compiler, system.SYSCALL_FIRMWARE)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_call(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, platform.CALL)
    compiler = executor.shift_left(compiler, backend.VALUE, backend.VALUE, 16)
    compiler = executor.or(compiler, backend.VALUE, backend.VALUE, backend.ERROR)
    compiler = executor.syscall(compiler, system.SYSCALL_FIRMWARE_CALL)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}
