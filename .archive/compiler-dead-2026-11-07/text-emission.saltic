-- Текстовый путь эмиссии компилятора, 07.11.2026: когда-то компилятор писал
-- ассемблерный текст (.word, .byte, .balign) рядом с машинным кодом. Давно
-- отключён: emit_data / emit_writable / emit_blank были пустышками, а
-- накопители Output (поля State lines, data, writable) не росли — но строки
-- для них всё ещё собирались. Из state.saltic, codegen/emitters.saltic; вызовы —
-- ещё в functions.saltic, constants.saltic (emit_storage) и string_label.

Output = Box {
    chunks = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
}

skill output_add(output, text) {
    @carry = text
    @chunks = []
    @active = yes
    drum (output.chunks) {
        pick {
            (active == no) { chunks = group.add(chunks, beat) }
            (str.bytes(beat) == 0) {
                chunks = group.add(chunks, carry)
                active = no
            }
            {
                chunks = group.add(chunks, "")
                carry = str.concat(beat, carry)
            }
        }
    }
    (active == yes) { chunks = group.add(chunks, carry) }
    out Output { chunks = chunks }
}

skill output_text(output) {
    @result = ""
    @count = group.count(output.chunks)
    drum (count) {
        @chunk = group.get(output.chunks, count - 1 - beat)
        (str.bytes(chunk) > 0) { result = str.concat(result, chunk) }
    }
    out result
}

skill emit_data(compiler, line) {
    out compiler
}

skill emit_writable(compiler, line) {
    out compiler
}

skill emit_blank(compiler) {
    out compiler
}

skill emit_string_data(compiler, text) {
    @line = "  .byte "
    @line_bytes = 0
    @length = str.bytes(text)
    @total = length + 1
    drum (total) {
        @value = 0
        (beat < length) { value = str.byte(text, beat) }
        (line_bytes > 0) { line = "{line}, " }
        line = str.concat(line, num.text(value))
        line_bytes = line_bytes + 1

        @flush = line_bytes == constants.STRING_DATA_LINE_BYTES
        (beat + 1 == total) { flush = yes }
        (flush == yes) {
            compiler = state.emit_data(compiler, line)
            line = "  .byte "
            line_bytes = 0
        }
    }
    out compiler
}
