-- Второй разбор «минус, ноль, число» в checker/rules (аудит 02.11, Б7).
-- С 07.11.2026 is_integer_literal спрашивает types.integer_text; is_zero больше не нужен.

skill is_zero(node) {
    @plain = ast.plain(node)
    (ast.tag(plain) == "number") {
        (ast.part(plain, 1) == 0) { out yes }
    }
    out no
}

skill is_integer_literal(node) {
    @plain = ast.plain(node)
    @tag = ast.tag(plain)
    (tag == "number") { out yes }
    (tag == "wide-number") { out yes }
    (tag == "binary") {
        (ast.part(plain, 1) == "-") {
            (is_zero(ast.part(plain, 2)) == yes) {
                @right_tag = ast.tag(ast.part(plain, 3))
                (right_tag == "number") { out yes }
                (right_tag == "wide-number") { out yes }
            }
        }
    }
    out no
}
