-- Ветка `seed` в чекере — старый путь `use seed` (аудит 02.11, А13). Её
-- перехватывало правило длинного пути (long_path), до неё дело не доходило;
-- убрана 07.11.2026. Ошибки были в soul/seed/selfhost/errors.saltic, ветки —
-- в checker/lookup.saltic, checker/types.saltic и checker/top_level.saltic:
--
--     lookup:    (name == "seed") { нет __seed__ — seed_not_imported;
--                неизвестно contract.is_known(full) — unknown_seed_operation }
--     types:     (name == "seed") { out "module-path" }
--     top_level: use seed… кладёт "__seed__" в globals

skill seed_not_imported() {
    out found("seed_not_imported", "модуль 'seed' не импортирован; добавь 'use seed'")
}

skill unknown_seed_operation(full) {
    out found("unknown_seed_operation", "неизвестная операция seed '{full}'")
}
