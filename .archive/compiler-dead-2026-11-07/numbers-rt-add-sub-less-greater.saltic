-- Из soul/seed/selfhost/compiler/backend/rv32i/runtime/numbers.saltic, 07.11.2026:
-- rt_add, rt_sub, rt_less, rt_greater попадали в каждую программу, но их никто
-- не звал — codegen считает + - < > <= >= на месте (add_checked, emit_number_less),
-- а сравнения fixed прыгали в хвост rt_less (LESS_YES = ".L_less_yes") — теперь
-- в такой же ответ yes у rt_equal (EQUAL_YES).

skill emit_add(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_add")
    compiler = executor.add(compiler, backend.VALUE, backend.VALUE, backend.ERROR)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_sub(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_sub")
    compiler = executor.sub(compiler, backend.VALUE, backend.VALUE, backend.ERROR)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_less(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_less")
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.branch_less(compiler, backend.VALUE, backend.ERROR, LESS_YES)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NO)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, LESS_YES)
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.YES)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}

skill emit_greater(compiler) {
    @executor = compiler.executor
    compiler = executor.label(compiler, "rt_greater")
    compiler = executor.shift_right_signed(compiler, backend.VALUE, backend.VALUE, abi.TAG_SHIFT)
    compiler = executor.shift_right_signed(compiler, backend.ERROR, backend.ERROR, abi.TAG_SHIFT)
    compiler = executor.branch_less(compiler, backend.ERROR, backend.VALUE, ".L_greater_yes")
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.NO)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    compiler = executor.ret(compiler)
    compiler = executor.label(compiler, ".L_greater_yes")
    compiler = executor.load_immediate(compiler, backend.VALUE, abi.YES)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.CALL_NO_ERROR)
    out executor.ret(compiler)
}
