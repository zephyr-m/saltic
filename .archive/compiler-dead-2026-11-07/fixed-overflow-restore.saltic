-- rt_fixed_overflow_restore — ошибка переполнения с откатом кадра 16 байт.
-- Метку никто не звал (аудит 02.11, Б3); убрана из рантайма 07.11.2026.
-- Был в soul/seed/selfhost/compiler/backend/rv32i/runtime/fixed.saltic.

skill emit_fixed_overflow_restore(compiler) {
    @executor = compiler.executor
    @words = compiler.words
    compiler = executor.label(compiler, "rt_fixed_overflow_restore")
    compiler = executor.load_immediate(compiler, backend.VALUE, 0)
    compiler = executor.load_immediate(compiler, backend.ERROR, abi.ERROR_FIXED_INTEGER_OVERFLOW)
    compiler = executor.load(compiler, backend.RETURN, backend.STACK, words.bytes * 3)
    compiler = executor.add_immediate(compiler, backend.STACK, backend.STACK, words.bytes * 4)
    out executor.ret(compiler)
}
