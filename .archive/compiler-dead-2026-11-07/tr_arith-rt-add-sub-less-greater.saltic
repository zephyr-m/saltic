-- Из soul/seed/tests/machine/translation/tr_arith.saltic, 07.11.2026: эталоны
-- мёртвых rt_add, rt_sub, rt_less, rt_greater (их код — numbers-rt-add-sub-less-greater.saltic).

    @compiler = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    compiler = numbers.emit_add(compiler)
    compiler = numbers.emit_sub(compiler)
    @expected = [
        51, 5, 181, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 51, 5, 181, 64,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод rt_add/sub: длина", compiler.machine.code.length, 24)
    drum (24) {
        suite = testing.test_equal(suite, "перевод rt_add/sub: байт {beat}", buffer.byte_at(compiler.machine.code, beat), group.get(expected, beat))
    }
    @add_label = layout.find_label(compiler.machine, "rt_add")
    @sub_label = layout.find_label(compiler.machine, "rt_sub")
    suite = testing.test_yes(suite, "перевод rt_add: метка существует", add_label.present)
    suite = testing.test_equal(suite, "перевод rt_add: смещение", add_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_sub: метка существует", sub_label.present)
    suite = testing.test_equal(suite, "перевод rt_sub: смещение", sub_label.offset, 12)


    @comparison = state.State { executor = rv32i.Executor {}, machine = layout.Program {} }
    comparison = numbers.emit_less(comparison)
    comparison = numbers.emit_greater(comparison)
    comparison.machine = layout.resolve(comparison.machine)
    @comparison_bytes = [
        19, 85, 53, 64, 147, 213, 53, 64,
        99, 72, 181, 0, 19, 5, 16, 0,
        147, 5, 0, 0, 103, 128, 0, 0,
        19, 5, 144, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 85, 53, 64,
        147, 213, 53, 64, 99, 200, 165, 0,
        19, 5, 16, 0, 147, 5, 0, 0,
        103, 128, 0, 0, 19, 5, 144, 0,
        147, 5, 0, 0, 103, 128, 0, 0
    ]
    suite = testing.test_equal(suite, "перевод сравнений: длина", comparison.machine.code.length, 72)
    suite = testing.test_equal(suite, "перевод сравнений: два перехода", comparison.machine.patch_count, 2)
    drum (72) {
        suite = testing.test_equal(suite, "перевод сравнений: байт {beat}", buffer.byte_at(comparison.machine.code, beat), group.get(comparison_bytes, beat))
    }
    @less_label = layout.find_label(comparison.machine, "rt_less")
    @less_yes = layout.find_label(comparison.machine, ".L_less_yes")
    @greater_label = layout.find_label(comparison.machine, "rt_greater")
    @greater_yes = layout.find_label(comparison.machine, ".L_greater_yes")
    suite = testing.test_yes(suite, "перевод rt_less: метка существует", less_label.present)
    suite = testing.test_equal(suite, "перевод rt_less: смещение", less_label.offset, 0)
    suite = testing.test_yes(suite, "перевод rt_less: ветка yes существует", less_yes.present)
    suite = testing.test_equal(suite, "перевод rt_less: смещение yes", less_yes.offset, 24)
    suite = testing.test_yes(suite, "перевод rt_greater: метка существует", greater_label.present)
    suite = testing.test_equal(suite, "перевод rt_greater: смещение", greater_label.offset, 36)
    suite = testing.test_yes(suite, "перевод rt_greater: ветка yes существует", greater_yes.present)
    suite = testing.test_equal(suite, "перевод rt_greater: смещение yes", greater_yes.offset, 60)

