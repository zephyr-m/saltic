-- field_assign_type_mismatch — вторая редакция ошибки присваивания полю, без
-- «типа …» (аудит 02.11, А14). С 07.11.2026 оба места зовут field_type_mismatch.
-- Был в soul/seed/selfhost/errors.saltic.

skill field_assign_type_mismatch(value_name, field_name, box_name) {
    out found("field_assign_type_mismatch", "нельзя присвоить {value_name} полю '{field_name}' Box '{box_name}'")
}
