flowchart LR
    Input["Incoming sticker<br/>opcode 2 bits + data 64 bits<br/>routing target is outside sticker"]

    subgraph Cell["ONE LOGOS v0 — FROZEN PHYSICAL CELL"]
        direction TB
        Inbox["Inbox<br/>ready / valid"]
        Command{"Opcode"}
        Counter["64-bit counter"]
        Reactions["Local reaction table<br/>INC / DEC / ZERO<br/>opcode + target"]
        Outbox["Lossless outbox<br/>ready / valid + backpressure"]
        Halted["Halted state"]

        Inbox --> Command
        Command -->|INC| Counter
        Command -->|DEC nonzero| Counter
        Command -->|DEC zero| Counter
        Command -->|HALT| Halted
        Command -->|NOP| Done["No state change"]
        Counter -->|select INC / DEC / ZERO| Reactions
        Reactions --> Outbox
    end

    Fabric["Fabric<br/>delivers stickers by target<br/>no computation semantics"]
    Next["Another Logos inbox"]

    Input --> Inbox
    Outbox --> Fabric --> Next

    subgraph Existing["EXISTING PHYSICAL EXPERIMENTS"]
        direction TB
        Group["Groups of unchanged Logos<br/>counters + reactions + links"]
        Geometry["Composable geometries<br/>explicit inputs / outputs / wires"]
        Arithmetic["Verified protocols<br/>5+3 / 4-2 / 5×3<br/>ZERO vs NONZERO choice"]
        Parallel["Independent causal tags<br/>parallel graphs do not mix"]

        Group --> Geometry --> Arithmetic
        Geometry --> Parallel
    end

    Next --> Group

    subgraph Direction["FIXED DIRECTION — STILL TO BE PROVED"]
        direction TB
        Interaction["Interaction protocol<br/>DISCOVER → OFFER → LOCK → MATCH<br/>PREPARE → COMMIT → RELEASE"]
        Primitives["Three fundamental forms<br/>APPLY / DUP / DROP"]
        SalticForms["Eight Saltic geometries<br/>VALUE / BIND / CALL / SEQUENCE<br/>PAIR / MATCH / CHOOSE / FEEDBACK"]
        Language["Saltic programs and libraries"]

        Interaction -.-> Primitives
        Primitives -.-> SalticForms
        SalticForms -.-> Language
    end

    Geometry -. experimental basis .-> Interaction

    Formula["Logos defines possible actions<br/>Protocol defines computation<br/>Mass defines available scale"]
    Language -. target architecture .-> Formula

    classDef physical fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef transport fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef experiment fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef hypothesis fill:#f3f4f6,stroke:#6b7280,color:#374151,stroke-dasharray: 5 5
    class Inbox,Command,Counter,Reactions,Outbox,Halted,Done physical
    class Input,Fabric,Next transport
    class Group,Geometry,Arithmetic,Parallel experiment
    class Interaction,Primitives,SalticForms,Language,Formula hypothesis
