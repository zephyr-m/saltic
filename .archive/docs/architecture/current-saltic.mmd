flowchart LR
    Source["Saltic source<br/>*.s"]

    subgraph Bootstrap["WORKING BOOTSTRAP — Racket"]
        direction LR
        Parser["1-parser.rkt<br/>lexer + parser<br/>AST with source locations"]
        Checker["2-checker.rkt<br/>static checks<br/>diagnostics"]
        Compiler["3-compiler.rkt<br/>AST → VM program<br/>bytecode"]
        VM["4-vm.rkt<br/>stack VM<br/>runtime state"]

        Parser --> Checker
        Parser --> Compiler
        Compiler --> VM
    end

    Core["core/*.s<br/>standard modules"]
    Result["Program result<br/>output / value / error<br/>world and visual traces"]

    Source --> Parser
    Core -->|use core| Parser
    Core -->|compiled into program| Compiler
    Checker --> Diagnostics["Diagnostics<br/>text / JSON"]
    VM --> Result

    subgraph Verification["VERIFICATION"]
        direction TB
        ParserTests["parser.rkt"]
        CheckerTests["checker.rkt / modules.rkt"]
        VMTests["vm.rkt"]
        ContractTests["canonical.rkt<br/>user-examples.rkt"]
    end

    ParserTests -.-> Parser
    CheckerTests -.-> Checker
    VMTests -.-> VM
    ContractTests -.-> Checker
    ContractTests -.-> VM

    subgraph Adjacent["EXISTING ADJACENT IMPLEMENTATIONS"]
        direction TB
        JS["js/<br/>JavaScript parser + checker"]
        SelfHost["s2/<br/>parser written in Saltic<br/>checker / compiler / VM are placeholders"]
        Editor["editors/vscode-s/<br/>syntax / language configuration / icons"]
    end

    Source -. parsed separately .-> JS
    Source -. self-hosting direction .-> SelfHost
    Source -. editor support .-> Editor

    classDef working fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef data fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef tests fill:#fef3c7,stroke:#d97706,color:#78350f
    classDef partial fill:#f3f4f6,stroke:#6b7280,color:#374151
    class Parser,Checker,Compiler,VM working
    class Source,Core,Result,Diagnostics data
    class ParserTests,CheckerTests,VMTests,ContractTests tests
    class JS,SelfHost,Editor partial
