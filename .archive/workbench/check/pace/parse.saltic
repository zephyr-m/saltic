-- parse — замер разбора для workbench/check/pace: читает файл и разбирает его
-- ROUNDS раз подряд с местами узлов, как toolchain, через фасад parser (он есть и
-- в старом коде, и в новом — pace собирает обе стороны); печатает число узлов, чтобы
-- разбор нельзя было выбросить.
--
-- program(path) -> none; ROUNDS

use io
use io.file
use core.group
use selfhost.parser

ROUNDS = 20

program(path) {
    @source = file.read(path)
    @total = 0
    drum (ROUNDS) {
        @parsed = parser.parse_string_loc(source, path)
        total = total + group.count(parsed.ast)
    }
    io.show("разбор: узлов {total}")
    out none
}
