-- saver — хранитель экрана агента: середина экрана уходит в градиент
-- с паучком и приветствием, боковые панели остаются. Включает агент после
-- простоя (agent.saltic, SAVER_AFTER), снимает — любая команда или клавиша.
--
-- draw(base, version) — нарисовать хранитель

use os.target.uefi_x86_64.screen.graphics
use os.target.uefi_x86_64.screen.lettering
use os.target.uefi_x86_64.screen.spider

BANDS = 24
SPIDER_SCALE = 6
SPIDER_WIDTH = 40

skill draw(base, version) {
    @screen = graphics.open(base)
    @band = screen.height / BANDS + 1
    drum (BANDS) {
        graphics.fill(screen, 0, beat * band, screen.width, band, graphics.color(screen, 20 + beat * 9, 24, 120 - beat * 4))
    }
    spider.draw_at(base, (screen.width - SPIDER_WIDTH * SPIDER_SCALE) / 2, screen.height / 2 - 260, SPIDER_SCALE)
    lettering.paint_text(screen, lettering.FACE_TITLE, 24, screen.height / 2 + 80, "Привет, Зэф!", graphics.color(screen, 255, 255, 255))
    out lettering.paint_text(screen, lettering.FACE_TEXT, 24, screen.height / 2 + 130, "агент Saltic {version} ждёт команду", graphics.color(screen, 251, 146, 60))
}
