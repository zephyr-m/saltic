use core.str
use core.group
use core.num
use io
use craft.tracer.model

skill indent(depth) {
    @text = ""
    drum (depth) {
        text = "{text}  "
    }
    out text
}

skill values_text(values) {
    @text = ""
    @index = 0
    @count = group.count(values)
    drum (count) {
        (index > 0) { text = "{text} " }
        @value = group.get(values, index)
        text = "{text}a{index}={value}"
        index = index + 1
    }
    out text
}

skill event(item) {
    @space = indent(item.depth)
    (item.kind == model.EventKind.CALL) {
        io.show(space, item.sequence, " → ", item.name, " pc=0x", item.pc)
        (group.count(item.values) > 0) {
            io.show(space, "    ", values_text(item.values))
        }
        out none
    }
    io.show(space, item.sequence, " ← ", item.name, " = ", item.result, " pc=0x", item.pc)
    out none
}

skill start(path, symbol_count, options) {
    io.show("трассировка: ", path)
    io.show("символов: ", symbol_count, ", лимит событий: ", options.event_limit, ", лимит инструкций: ", options.step_limit)
    out none
}

skill finish(result) {
    io.show("событий: ", result.events, ", инструкций: ", result.steps)
    (result.completed == yes) {
        io.show("программа завершилась с кодом ", result.exit_code)
    }
    (str.len(result.diagnostic) > 0) {
        io.show("остановка: ", result.diagnostic)
    }
    out none
}
