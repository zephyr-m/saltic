diff --git a/os/target/android/shell.saltic b/os/target/android/shell.saltic
new file mode 100644
index 0000000..8862a0f
--- /dev/null
+++ b/os/target/android/shell.saltic
@@ -0,0 +1,439 @@
+-- shell — оболочка ОС на телефоне поверх ядра событий (os/ui/events): лаунчер,
+-- приложения-задачи (Музыка, Часы, Настройки, Диспетчер, Claude) и Организм —
+-- экран самой ОС с настоящими счётчиками ядра. Интерфейс — JTML (атомы и шрифт
+-- Acer: screen/atoms), экран — буфер окна Android через cpu.firmware (0 адрес,
+-- 1 ширина, 2 высота, 3 шаг, 4 / 5 x / y пальца, 6 счёт касаний, 7 палец на
+-- экране). Ввод — изменения: касание по цели — счётчик её имени, ползунок —
+-- число, раз в секунду — такт. Задача просыпается, только если подписана на
+-- имя и не на паузе. Кадр рисуется, только когда что-то изменилось, — REDRAW
+-- раз подряд: у окна Android несколько буферов по кругу, обновиться должны все. Claude — агент со своим
+-- курсором: идёт к цели и жмёт её тем же каналом, что и палец. Раз в такт
+-- Организм снимает кучу (mem.heap): занято, пик, долгие поля — рост занятого у
+-- вечной программы — утечка.
+--
+-- Task { id, name, woke } — задача; World — всё состояние оболочки
+-- page(world) -> текст JTML текущего экрана; home / music / clock / settings /
+--     tasks / claude / organism(world) — экраны
+-- route(world, change) -> World — изменение к подписчикам; state_of(world, id)
+-- Переходы помнят путь: «< Назад» в шапке и внизу возвращает на прошлый экран
+-- (went / shell.back), с пустой памятью — домой.
+-- Внутри: text / mark / box / sized / slider / button / join — строители JTML;
+--     two, clock_text, index_of, name_of, frame_of, wake, logged, target_center
+
+use io
+use core.str
+use core.cpu
+use core.time
+use core.mem
+use core.group
+use os.ui.jtml
+use os.ui.jtml.read
+use os.ui.events
+use os.target.uefi_x86_64.screen.atoms
+use os.target.uefi_x86_64.screen.graphics
+
+REDRAW = 5
+TOP = 42
+BOTTOM = 48
+SECOND = 1000
+AGENT_FRAMES = 24
+LOG = 7
+APPS = ["music", "clock", "settings", "tasks", "claude", "organism"]
+NAMES = ["Музыка", "Часы", "Настройки", "Диспетчер", "Claude", "Организм"]
+GLYPHS = ["~", "o", "*", "=", "+", "@"]
+TONES = ["down", "info", "quiet", "accent", "keyword", "up"]
+
+World = Box {
+    app = "home",
+    back = [],
+    core = none,
+    playing = no,
+    volume = 40,
+    played = 0,
+    stopwatch = no,
+    lap = 0,
+    bright = 70,
+    seconds = 0,
+    events = 0,
+    frames = 0,
+    busy = 0,
+    heap = 0,
+    peak = 0,
+    quota = 0,
+    escapes = 0,
+    wakes = [0, 0, 0, 0, 0, 0],
+    log = [],
+    plan = [],
+    step = 0,
+    timer = 0,
+    agent_x = 360,
+    agent_y = 800
+}
+
+skill join(items) {
+    out str.join(items, ", ")
+}
+
+skill text(value, tone) {
+    out "\{\"text\": \{\"value\": \"{value}\", \"tone\": \"{tone}\"\}\}"
+}
+
+skill mark(id, value, tone) {
+    out "\{\"text\": \{\"id\": \"{id}\", \"value\": \"{value}\", \"align\": \"center\", \"grow\": 1, \"tone\": \"{tone}\"\}\}"
+}
+
+skill box(flow, padding, gap, grow, tone, items) {
+    @kids = join(items)
+    out "\{\"box\": \{\"flow\": \"{flow}\", \"padding\": {padding}, \"gap\": {gap}, \"grow\": {grow}, \"tone\": \"{tone}\", \"children\": [{kids}]\}\}"
+}
+
+skill sized(width, height, tone, items) {
+    @kids = join(items)
+    out "\{\"box\": \{\"flow\": \"column\", \"width\": {width}, \"height\": {height}, \"padding\": 8, \"tone\": \"{tone}\", \"children\": [{kids}]\}\}"
+}
+
+skill slider(id, value) {
+    out "\{\"slider\": \{\"id\": \"{id}\", \"value\": {value}, \"min\": 0, \"max\": 100\}\}"
+}
+
+skill button(id, value) {
+    out box("row", 10, 0, 0, "panel", [mark(id, value, "accent")])
+}
+
+skill two(value) {
+    (value < 10) { out "0{value}" }
+    out "{value}"
+}
+
+skill clock_text(seconds) {
+    @m = two(seconds / 60 % 60)
+    @s = two(seconds % 60)
+    out "{m}:{s}"
+}
+
+skill index_of(id) {
+    drum (group.count(APPS)) {
+        (group.get(APPS, beat) == id) { out beat }
+    }
+    out -1
+}
+
+skill name_of(id) {
+    @at = index_of(id)
+    (at < 0) { out "Домой" }
+    out group.get(NAMES, at)
+}
+
+skill state_of(world, id) {
+    (world.app == id) { out "активная" }
+    (id == "clock") { out "в фоне" }
+    (id == "claude") { out "в фоне" }
+    (id == "music") {
+        (world.playing == yes) { out "в фоне" }
+    }
+    out "на паузе"
+}
+
+skill frame_of(world, body) {
+    @title = name_of(world.app)
+    @now = clock_text(world.seconds)
+    @top_items = [text("# {title}", "ink"), box("row", 0, 0, 1, "", []), text(now, "quiet")]
+    @nav_items = [mark("shell.home", "———  Домой  ———", "quiet")]
+    ((world.app == "home") == no) {
+        top_items = group.add(top_items, mark("shell.back", "< Назад", "accent"))
+        nav_items = group.add(nav_items, mark("shell.back", "< Назад", "accent"))
+    }
+    @bar = box("row", 10, 12, 0, "panel", top_items)
+    @nav = box("row", 10, 0, 0, "panel", nav_items)
+    @top = "\{\"box\": \{\"height\": {TOP}, \"tone\": \"panel\"\}\}"
+    @bottom = "\{\"box\": \{\"height\": {BOTTOM}, \"tone\": \"panel\"\}\}"
+    out box("column", 0, 0, 1, "", [top, bar, box("column", 14, 12, 1, "", body), nav, bottom])
+}
+
+skill home(world) {
+    @rows = []
+    @row = []
+    drum (group.count(APPS)) {
+        @id = group.get(APPS, beat)
+        @glyph = group.get(GLYPHS, beat)
+        @name = group.get(NAMES, beat)
+        @tile = sized(72, 72, group.get(TONES, beat), [mark("open.{id}", glyph, "ground")])
+        row = group.add(row, box("column", 4, 6, 1, "", [tile, mark("open.{id}", name, "ink"), text(state_of(world, id), "quiet")]))
+        (group.count(row) == 3) {
+            rows = group.add(rows, box("row", 0, 10, 0, "", row))
+            row = []
+        }
+    }
+    @now = clock_text(world.seconds)
+    out group.concat([text("# {now}", "ink"), text("ядро спит, пока ничего не случилось", "quiet")], rows)
+}
+
+skill music(world) {
+    @label = "Играть"
+    (world.playing == yes) { label = "Пауза" }
+    @played = clock_text(world.played)
+    out [text("# Музыка", "ink"), text("Saltic - Тишина ядра   {played}", "ink"), button("music.play", label),
+        text("громкость {world.volume}", "quiet"), box("row", 0, 0, 0, "", [slider("music.volume", world.volume)]),
+        text("Играет — живёт в фоне по такту.", "quiet"), text("На паузе её никто не будит.", "quiet")]
+}
+
+skill clock(world) {
+    @now = clock_text(world.seconds)
+    @lap = clock_text(world.lap)
+    @label = "Старт"
+    (world.stopwatch == yes) { label = "Стоп" }
+    out [text("# {now}", "ink"), text("секундомер {lap}", "quiet"), button("clock.start", label)]
+}
+
+skill settings(world) {
+    out [text("# Настройки", "ink"), text("яркость {world.bright}", "quiet"), box("row", 0, 0, 0, "", [slider("settings.bright", world.bright)]),
+        text("Тянешь — в ядро идут изменения", "quiet"), text("settings.bright.", "quiet")]
+}
+
+skill tasks(world) {
+    @lines = [text("# Диспетчер", "ink")]
+    drum (5) {
+        @id = group.get(APPS, beat)
+        @name = group.get(NAMES, beat)
+        @woke = group.get(world.wakes, beat)
+        @state = state_of(world, id)
+        lines = group.add(lines, box("row", 0, 8, 0, "", [text(name, "ink"), box("row", 0, 0, 1, "", []), text("{state}, {woke}", "quiet")]))
+    }
+    out lines
+}
+
+skill claude(world) {
+    out [text("# Claude", "ink"), text("Агент — такой же житель:", "quiet"), text("свой курсор, тот же канал.", "quiet"),
+        button("agent.music", "Включи музыку погромче"), button("agent.clock", "Запусти секундомер")]
+}
+
+skill organism(world) {
+    @quiet = 100
+    (world.frames > 0) { quiet = 100 - world.busy * 100 / world.frames }
+    @used = world.heap / 1024
+    @peak = world.peak / 1024
+    @quota = world.quota / 1024
+    @lines = [text("# Организм", "ink"), text("событий {world.events}, кадров {world.frames}", "ink"),
+        text("кадров без работы {quiet}%", "up"), text("память: занято {used} КБ", "ink"),
+        text("пик {peak} КБ из {quota} КБ", "ink"), text("долгих полей в куче: {world.escapes}", "quiet"),
+        text("задачи — сколько раз просыпались:", "quiet")]
+    drum (5) {
+        @name = group.get(NAMES, beat)
+        @woke = group.get(world.wakes, beat)
+        @state = state_of(world, group.get(APPS, beat))
+        lines = group.add(lines, text("{name}: {woke}, {state}", "ink"))
+    }
+    lines = group.add(lines, text("ядро событий, свежие сверху:", "quiet"))
+    drum (world.log) { lines = group.add(lines, text(beat, "accent")) }
+    out lines
+}
+
+skill page(world) {
+    @body = home(world)
+    (world.app == "music") { body = music(world) }
+    (world.app == "clock") { body = clock(world) }
+    (world.app == "settings") { body = settings(world) }
+    (world.app == "tasks") { body = tasks(world) }
+    (world.app == "claude") { body = claude(world) }
+    (world.app == "organism") { body = organism(world) }
+    out frame_of(world, body)
+}
+
+skill wake(world, id) {
+    @at = index_of(id)
+    @list = []
+    drum (group.count(world.wakes)) {
+        @count = group.get(world.wakes, beat)
+        (beat == at) { count = count + 1 }
+        list = group.add(list, count)
+    }
+    world.wakes = list
+    out world
+}
+
+skill logged(world, line) {
+    @list = [line]
+    drum (group.count(world.log)) {
+        (beat < LOG - 1) { list = group.add(list, group.get(world.log, beat)) }
+    }
+    world.log = list
+    out world
+}
+
+skill went(world, next) {
+    (world.app == next) { out world }
+    world.back = group.add(world.back, world.app)
+    world.app = next
+    out world
+}
+
+skill route(world, change, who) {
+    @id = change.id
+    world.events = world.events + 1
+    @who_woke = "никого"
+    (str.starts_with(id, "open.")) {
+        world = went(world, str.slice(id, 5, str.bytes(id)))
+        who_woke = "оболочка ОС"
+    }
+    (id == "shell.home") {
+        world = went(world, "home")
+        who_woke = "оболочка ОС"
+    }
+    (id == "shell.back") {
+        @count = group.count(world.back)
+        world.app = "home"
+        (count > 0) {
+            world.app = group.get(world.back, count - 1)
+            @rest = []
+            drum (count - 1) { rest = group.add(rest, group.get(world.back, beat)) }
+            world.back = rest
+        }
+        who_woke = "оболочка ОС"
+    }
+    (id == events.TICK) {
+        world.seconds = world.seconds + 1
+        world.heap = mem.heap(0)
+        world.escapes = mem.heap(1)
+        world.quota = mem.heap(2)
+        (world.heap > world.peak) { world.peak = world.heap }
+        world = wake(world, "clock")
+        who_woke = "Часы"
+        (world.stopwatch == yes) { world.lap = world.lap + 1 }
+        (world.playing == yes) {
+            world.played = world.played + 1
+            world = wake(world, "music")
+            who_woke = "Часы, Музыка"
+        }
+        (world.app == "tasks") { world = wake(world, "tasks") }
+    }
+    (str.starts_with(id, "music.")) {
+        world = wake(world, "music")
+        who_woke = "Музыка"
+        (id == "music.play") { world.playing = world.playing == no }
+        (id == "music.volume") { world.volume = change.number }
+    }
+    (str.starts_with(id, "clock.")) {
+        world = wake(world, "clock")
+        who_woke = "Часы"
+        (id == "clock.start") { world.stopwatch = world.stopwatch == no }
+    }
+    (str.starts_with(id, "settings.")) {
+        world = wake(world, "settings")
+        who_woke = "Настройки"
+        world.bright = change.number
+    }
+    (str.starts_with(id, "agent.")) {
+        world = wake(world, "claude")
+        who_woke = "Claude"
+        (id == "agent.music") { world.plan = ["shell.home", "open.music", "music.play", "volume"] }
+        (id == "agent.clock") { world.plan = ["shell.home", "open.clock", "clock.start"] }
+        world.step = 0
+        world.timer = 0
+    }
+    (id == events.TICK) { out world }
+    out logged(world, "{id} = {change.number}, {who} -> {who_woke}")
+}
+
+skill target_center(runtime, id) {
+    drum (runtime.targets) {
+        (beat.id == id) { out [beat.x + beat.width / 2, beat.y + beat.height / 2] }
+    }
+    out []
+}
+
+skill slider_center(runtime) {
+    drum (runtime.sliders) { out [beat.x + beat.width * 3 / 4, beat.y + 6] }
+    out []
+}
+
+program() {
+    @world = World { core = events.Core {} }
+    @seen = cpu.firmware(6)
+    @held = no
+    @since = time.now()
+    @redraw = REDRAW
+    @runtime = none
+    io.show("оболочка: старт")
+    always {
+        @began = time.now()
+        @screen = graphics.Screen { width = cpu.firmware(1), height = cpu.firmware(2), stride = cpu.firmware(3), format = graphics.FORMAT_RGB, frame = 0, memory = cpu.firmware(0), accel = [], vsync = no }
+        @who = "палец"
+        @x = cpu.firmware(4)
+        @y = cpu.firmware(5)
+        @touches = cpu.firmware(6)
+        @pressed = cpu.firmware(7)
+        (group.count(world.plan) > 0) {
+            @goal = group.get(world.plan, world.step)
+            @spot = []
+            (runtime) |live| {
+                spot = target_center(live, goal)
+                (goal == "volume") { spot = slider_center(live) }
+            }
+            (group.count(spot) == 2) {
+                world.agent_x = world.agent_x + (group.get(spot, 0) - world.agent_x) / 3
+                world.agent_y = world.agent_y + (group.get(spot, 1) - world.agent_y) / 3
+                redraw = REDRAW
+                world.timer = world.timer + 1
+                (world.timer >= AGENT_FRAMES) {
+                    world.timer = 0
+                    who = "Claude"
+                    (goal == "volume") { world.core = events.change(world.core, "music.volume", world.volume + 35, "", began) }
+                    ((goal == "volume") == no) {
+                        world.core = events.bump(world.core, goal, began)
+                    }
+                    world.step = world.step + 1
+                    (world.step >= group.count(world.plan)) { world.plan = [] }
+                }
+            }
+        }
+        ((touches == seen) == no) {
+            seen = touches
+            (runtime) |live| {
+                @hit = jtml.hit(live, x, y)
+                (hit.found == yes) { world.core = events.bump(world.core, hit.id, began) }
+                held = yes
+            }
+        }
+        (pressed == 1) {
+            (held == yes) {
+                (runtime) |live| {
+                    @moved = jtml.focus_at(live, x, y)
+                    @slot = jtml.find_slider(moved, moved.focused)
+                    (slot.found == yes) {
+                        world.core = events.change(world.core, moved.focused, slot.slot.level, "", began)
+                    }
+                }
+            }
+        }
+        (pressed == 0) { held = no }
+        (time.elapsed(since, began) >= SECOND) {
+            since = began
+            world.core = events.tick(world.core, began)
+        }
+        @worked = no
+        always {
+            @taken = events.take(world.core)
+            (taken.found == no) { leave }
+            world.core = taken.core
+            world = route(world, taken.change, who)
+            worked = yes
+            redraw = REDRAW
+        }
+        world.frames = world.frames + 1
+        (redraw > 0) {
+            redraw = redraw - 1
+            @tree = atoms.measured(read.page(page(world)), no)
+            @live = jtml.mount(screen, tree)
+            atoms.draw(screen, live, atoms.palette_light(screen))
+            (group.count(world.plan) > 0) {
+                graphics.fill(screen, world.agent_x, world.agent_y, 10, 14, graphics.color(screen, 166, 107, 242))
+                graphics.fill(screen, world.agent_x, world.agent_y + 14, 4, 6, graphics.color(screen, 166, 107, 242))
+            }
+            runtime = live
+            worked = yes
+        }
+        (worked == yes) { world.busy = world.busy + 1 }
+        cpu.wait()
+    }
+    out none
+}
diff --git a/os/target/android/toolchain.saltic b/os/target/android/toolchain.saltic
index f446e26..3b99576 100644
--- a/os/target/android/toolchain.saltic
+++ b/os/target/android/toolchain.saltic
@@ -3,8 +3,12 @@
 -- (compiler/linker/shared), двоичный манифест (formats/apk/manifest) и zip
 -- (formats/apk/zip) — неподписанный APK. Подпись — apksigner (just android).
 -- Запуск: toolchain <исходник> <выход.apk> <куча байт>; рядом пишет <выход>.so.
+-- Пакет — dev.saltic.<имя файла> (каждая программа ставится отдельным
+-- приложением), подпись — «Saltic», у не-hello — «Saltic <имя>». Проверка —
+-- широкая (check_wide): у AArch64 слово 8 байт.
 --
 -- program(source_path, output_path, heap_text) -> none; ParseFailed, CheckFailed
+-- Внутри: stem(path) — имя файла без папок и .saltic
 
 use core.str
 use core.group
@@ -20,7 +24,7 @@ use formats.apk.zip
 use formats.apk.manifest
 use os.target.android.platform
 
-PACKAGE = "dev.saltic.hello"
+PACKAGE = "dev.saltic"
 LABEL = "Saltic"
 LIBRARY = "main"
 
@@ -40,7 +44,7 @@ program(source_path, output_path, heap_text) {
         out error.ParseFailed
     }
     io.show("android: проверяю")
-    @checked = checker.check_file(loaded.ast, source_path)
+    @checked = checker.check_wide(loaded.ast, source_path)
     (group.count(checked.diagnostics) > 0) {
         show_diagnostics(checked.diagnostics)
         out error.CheckFailed
@@ -53,7 +57,10 @@ program(source_path, output_path, heap_text) {
     @library_path = "{output_path}.so"
     shared.write(library_path, machine, executor.fixups, platform.library())
     io.show("android: пакую {output_path}")
-    @manifest_bytes = manifest.encode(manifest.native_activity(PACKAGE, LABEL, LIBRARY, 1))
+    @name = stem(source_path)
+    @label = LABEL
+    ((name == "hello") == no) { label = "{LABEL} {name}" }
+    @manifest_bytes = manifest.encode(manifest.native_activity("{PACKAGE}.{name}", label, LIBRARY, 1))
     @entries = [
         zip.Entry { name = "AndroidManifest.xml", data = manifest_bytes, align = 4 },
         zip.Entry { name = "lib/arm64-v8a/lib{LIBRARY}.so", data = file.read_bytes(library_path), align = 16384 }
@@ -61,3 +68,10 @@ program(source_path, output_path, heap_text) {
     file.write_bytes(output_path, zip.archive(entries))
     out none
 }
+
+skill stem(path) {
+    @parts = str.split(path, "/")
+    @last = group.get(parts, group.count(parts) - 1)
+    (str.ends_with(last, ".saltic") == yes) { out str.slice(last, 0, str.bytes(last) - 7) }
+    out last
+}
