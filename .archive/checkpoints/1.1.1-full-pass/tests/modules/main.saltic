use core
use nested.greeting

program() {
    core.io.show(greeting.module_greeting("short"))
    core.io.show(nested.greeting.module_greeting("full"))
    core.io.show(greeting.GreetingPrefix, "constant")
    core.io.show(greeting.module_mood() == greeting.Mood.HAPPY)

    @short_box = greeting.Greeter { prefix = "short box: " }
    @full_box = nested.greeting.Greeter { prefix = "full box: " }
    core.io.show(short_box.message("ok"))
    core.io.show(full_box.message("ok"))
    out none
}
