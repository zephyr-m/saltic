-- pauk/body — тело паука, геометрия и константы физики.
--
-- Константы: STEPS (запас шагов забега), FINISH (финишная черта по x), MASS
--     (масса тела: при LEG_HOLD физики стоять — нужно 4 ступни), UPPER, LOWER, BODY_R, REST_R, BODY_Y, LEG_COUNT,
--     POPULATION, ELITE, MUTATIONS
-- SpiderState { genes, legs, x, y, z, t, lying, vx, vy, vz, aims, brain } —
--     паук: тело, ступни (physics.Leg), гены, шаг, сколько шагов лежал,
--     скорость тела; у нейро-паука —
--     веса мозга и цели ног, которые мозг выдал на этот шаг
-- shoulder_x(leg) / shoulder_z(leg) -> смещение плеча от центра тела
-- rest_x(leg) / rest_z(leg) -> где стоит ступня в покое, от центра тела
-- clamp(value, low, high) -> value в диапазоне

use core.group
use os.target.uefi_x86_64.screen.geometry

STEPS = 1500
FINISH = 3000
MASS = 12
UPPER = 150
LOWER = 150
BODY_R = 90
REST_R = 200
BODY_Y = 300
LEG_COUNT = 8
POPULATION = 2
ELITE = 1
MUTATIONS = 9

SpiderState = Box {
    genes = [],
    legs = [],
    x = 0,
    y = 0,
    z = 0,
    t = 0,
    lying = 0,
    vx = 0,
    vy = 0,
    vz = 0,
    aims = [],
    brain = []
}

skill clamp(value, low, high) {
    (value < low) { out low }
    (value > high) { out high }
    out value
}

skill shoulder_x(leg) {
    @angle = geometry.TURN * leg / LEG_COUNT
    out geometry.cosine(angle) * BODY_R / geometry.ONE
}

skill rest_x(leg) {
    @angle = geometry.TURN * leg / LEG_COUNT
    out geometry.cosine(angle) * REST_R / geometry.ONE
}

skill rest_z(leg) {
    @angle = geometry.TURN * leg / LEG_COUNT
    out geometry.sine(angle) * REST_R / geometry.ONE
}

skill shoulder_z(leg) {
    @angle = geometry.TURN * leg / LEG_COUNT
    out geometry.sine(angle) * BODY_R / geometry.ONE
}
