+    drum (state.legs) { legs = group.add(legs, physics.Leg { x = (beat.x - offset) / MINI, y = beat.y / MINI, z = beat.z / MINI }) }
+    out body.SpiderState { legs = legs, x = (state.x - offset) / MINI, y = state.y / MINI, z = state.z / MINI }
+}
+
+skill shoulder_x(leg) {
+    out body.shoulder_x(leg) / MINI
+}
+
+skill shoulder_z(leg) {
+    out body.shoulder_z(leg) / MINI
+}
+
+skill troop(population) {
+    @team = []
+    drum (TROOP) {
+        @lane = (beat - TROOP / 2) * LANE
+        team = group.add(team, physics.init_lane(group.get(population, beat), lane))
+    }
+    out team
+}
+
 skill overlay(front, gen, best, avg, history) {
     @ink = canvas.paint(front, canvas.INK)
     @white = canvas.paint(front, canvas.PAPER)
diff --git a/os/target/uefi_x86_64/programs/pauk.saltic b/os/target/uefi_x86_64/programs/pauk.saltic
new file mode 100644
index 0000000..9e960d8
--- /dev/null
+++ b/os/target/uefi_x86_64/programs/pauk.saltic
@@ -0,0 +1,106 @@
+-- pauk — эволюция ходьбы трёхмерного паука на Saltic.
+--
+-- program() — вход: поколения, показ лучшего, надписи, график, клавиши
+
+use core.group
+use core.num
+use os.target.uefi_x86_64.platform.firmware
+use os.target.uefi_x86_64.platform.uefi
+use os.target.uefi_x86_64.screen.graphics
+use os.target.uefi_x86_64.network.reply
+use os.target.uefi_x86_64.network.remote
+use os.target.uefi_x86_64.screen.clay.stage
+use os.target.uefi_x86_64.screen.clay.mesh
+use os.target.uefi_x86_64.screen.clay.forms
+use os.target.uefi_x86_64.screen.clay.scene
+use os.uiengine.canvas
+use os.uiengine.fonts
+use os.target.uefi_x86_64.programs.pauk.body
+use os.target.uefi_x86_64.programs.pauk.physics
+use os.target.uefi_x86_64.programs.pauk.genes
+use os.target.uefi_x86_64.programs.pauk.evolution
+use os.target.uefi_x86_64.programs.pauk.view
+
+PAUSE = 1000
+SCAN_ESCAPE = 23
+SCAN_LEFT = 4
+SCAN_RIGHT = 3
+SPACE = 32
+
+Session = Box {
+    history = []
+}
+
+program() {
+    @base = firmware.guest_base()
+    @front = graphics.open(base)
+    uefi.forget_keys(base)
+    @link = remote.open_remote() rescue |err| { none }
+    @set = stage.open_stage(base, front)
+    @pages = stage.pages(set)
+    ((link == none) == no) {
+        remote.own(link, set.sky.frame, pages)
+        remote.own(link, set.back.frame, pages)
+    }
+    @moment = uefi.now(base)
+    @seed = moment.minute * 60 + moment.second + 1
+    (seed <= 0) { seed = 1 }
+    @evo = evolution.init_state(seed)
+    @session = Session {}
+    @state = physics.init_state(genes.make_manual())
+    @generation_frames = 0
+    @paused = no
+    @speed = 3
+    @show_frames = 300
+    @quit = no
+    always {
+        ((link == none) == no) { remote.serve(link) }
+        @key = uefi.poll_key(base, PAUSE)
+        (key.ready == yes) {
+            (key.scan == SCAN_ESCAPE) { quit = yes }
+            (key.scan == SCAN_LEFT) {
+                speed = speed - 1
+                (speed < 1) { speed = 1 }
+            }
+            (key.scan == SCAN_RIGHT) {
+                speed = speed + 1
+                (speed > 12) { speed = 12 }
+            }
+            (key.char == SPACE) { paused = paused == no }
+        }
+        (quit == yes) {
+            stage.close_stage(base, set)
+            @best = evo.best_distance
+            @gen = evo.generation
+            reply.home("паук: поколений {gen}, рекорд {best}")
+            out none
+        }
+        (paused == no) {
+            (generation_frames == 0) {
+                evo = evolution.evolve_once(evo, base, link)
+                session.history = group.add(session.history, evo.best_distance)
+                state = physics.init_state(evo.best_genome)
+                generation_frames = 1
+            }
+            @can_step = (generation_frames > 0)
+            (can_step == yes) {
+                @rep = speed
+                drum (rep) {
+                    (state.t < body.STEPS) { physics.step(state) }
+                    (state.t >= body.STEPS) { state = physics.init_state(evo.best_genome) }
+                }
+                generation_frames = generation_frames + 1
+                (generation_frames > show_frames) { generation_frames = 0 }
+            }
+        }
+        view.render(set, state, base)
+        view.overlay(front, evo.generation, evo.best_distance, evo.average_distance, session.history)
+        ((link == none) == no) {
+            @g = evo.generation
+            @b = evo.best_distance
+            @a = evo.average_distance
+            remote.tell(link, "поколение {g}, рекорд {b}, среднее {a}")
+        }
+    }
+    out none
+}
diff --git a/os/target/uefi_x86_64/programs/pauk/body.saltic b/os/target/uefi_x86_64/programs/pauk/body.saltic
new file mode 100644
index 0000000..0be64d6
--- /dev/null
+++ b/os/target/uefi_x86_64/programs/pauk/body.saltic
@@ -0,0 +1,45 @@
+-- pauk/body — тело паука, геометрия и константы физики.
+--
+-- Константы: STEPS, GRAV, UPPER, LOWER, BODY_R, BODY_Y, LEG_COUNT,
+--     GENE_COUNT, WORLD_SCALE
+-- SpiderState { genes, points, prev, t } — состояние точки Верле
+-- shoulder_offsets(leg) -> [x,z] смещения плеча от центра тела
+-- clamp(value, low, high) -> value в диапазоне
+
+use core.group
+use os.target.uefi_x86_64.screen.geometry
+
+STEPS = 600
+GRAV = 40
+UPPER = 150
+LOWER = 150
+BODY_R = 90
+BODY_Y = 300
+LEG_COUNT = 8
+POPULATION = 28
+ELITE = 6
+MUTATIONS = 9
+POINT_COUNT = 17
+
+SpiderState = Box {
+    genes = [],
+    points = [],
+    prev = [],
+    t = 0
+}
+
+skill clamp(value, low, high) {
+    (value < low) { out low }
+    (value > high) { out high }
+    out value
+}
+
+skill shoulder_x(leg) {
+    @angle = geometry.TURN * leg / LEG_COUNT
+    out geometry.cosine(angle) * BODY_R / geometry.ONE
+}
+
+skill shoulder_z(leg) {
+    @angle = geometry.TURN * leg / LEG_COUNT
+    out geometry.sine(angle) * BODY_R / geometry.ONE
+}
diff --git a/os/target/uefi_x86_64/programs/pauk/evolution.saltic b/os/target/uefi_x86_64/programs/pauk/evolution.saltic
new file mode 100644
index 0000000..c11c915
--- /dev/null
+++ b/os/target/uefi_x86_64/programs/pauk/evolution.saltic
@@ -0,0 +1,122 @@
+-- pauk/evolution — генетический алгоритм: популяция, оценка (без рисования),
+--    отбор элиты, скрещивание и мутация.
+--
+-- EvolutionState { population, distances, generation, best_distance,
+--     best_genome, seed, average_distance }
+-- init_state(seed) -> EvolutionState
+-- evolve_once(state, base, link) -> EvolutionState
+
+use core.group
+use core.num
+use os.target.uefi_x86_64.programs.pauk.body
+use os.target.uefi_x86_64.programs.pauk.genes
+use os.target.uefi_x86_64.programs.pauk.physics
+use os.target.uefi_x86_64.network.remote
+
+EvolutionState = Box {
+    population = [],
+    distances = [],
+    generation = 0,
+    best_distance = 0,
+    best_genome = [],
+    seed = 1,
+    average_distance = 0
+}
+
+skill index_of_max(dists) {
+    @best = 0
+    @bestd = group.get(dists, 0)
+    drum (group.count(dists)) {
+        (group.get(dists, beat) > bestd) {
+            bestd = group.get(dists, beat)
+            best = beat
+        }
+    }
+    out best
+}
+
+skill init_state(seed_in) {
+    @seed = seed_in
+    @pop = []
+    drum (body.POPULATION) {
+        @r = genes.make_random(seed)
+        seed = group.get(r, 0)
+        pop = group.add(pop, group.get(r, 1))
+    }
+    out EvolutionState { population = pop, distances = [], generation = 0, best_distance = 0, best_genome = [], seed = seed, average_distance = 0 }
+}
+
+skill evolve_once(state, base, link) {
+    @seed = state.seed
+    @pop = state.population
+    @n = group.count(pop)
+    @dists = []
+    @sum = 0
+    drum (n) {
+        ((link == none) == no) { remote.serve(link) }
+        @g = group.get(pop, beat)
+        @d = physics.evaluate(g)
+        dists = group.add(dists, d)
+        sum = sum + d
+    }
+    @bi = index_of_max(dists)
+    @best_d = group.get(dists, bi)
+    @best_g = group.get(pop, bi)
+    @best_distance = state.best_distance
+    @best_genome = state.best_genome
+    (best_d > best_distance) {
+        best_distance = best_d
+        best_genome = genes.clamp_genome(best_g)
+    }
+    @avg = sum / n
+    @used = []
+    @elite = []
+    drum (body.ELITE) {
+        @besti = -1
+        @bestdd = 0 - 1000000000
+        drum (n) {
+            (group.contains(used, beat) == no) {
+                (group.get(dists, beat) > bestdd) {
+                    bestdd = group.get(dists, beat)
+                    besti = beat
+                }
+            }
+        }
+        (besti >= 0) {
+            used = group.add(used, besti)
+            elite = group.add(elite, group.get(pop, besti))
+        }
+    }
+    @nextpop = []
+    drum (group.count(elite)) {
+        nextpop = group.add(nextpop, group.get(elite, beat))
+    }
+    @elite_count = group.count(elite)
+    (elite_count < 1) { elite_count = 1 }
+    drum (n - group.count(nextpop)) {
+        @r1 = genes.rng(seed, elite_count)
+        seed = group.get(r1, 0)
+        @i1 = group.get(r1, 1)
+        @r2 = genes.rng(seed, elite_count)
+        seed = group.get(r2, 0)
+        @i2 = group.get(r2, 1)
+        @parent_a = group.get(elite, i1)
+        @parent_b = group.get(elite, i2)
+        @cross = genes.crossover(parent_a, parent_b, seed)
+        seed = group.get(cross, 0)
+        @child = group.get(cross, 1)
+        @mut = genes.mutate(child, seed)
+        seed = group.get(mut, 0)
+        child = group.get(mut, 1)
+        child = genes.clamp_genome(child)
+        nextpop = group.add(nextpop, child)
+    }
+    state.population = nextpop
+    state.distances = dists
+    state.generation = state.generation + 1
+    state.best_distance = best_distance
+    state.best_genome = best_genome
+    state.average_distance = avg
+    state.seed = seed
+    out state
+}
diff --git a/os/target/uefi_x86_64/programs/pauk/genes.saltic b/os/target/uefi_x86_64/programs/pauk/genes.saltic
new file mode 100644
index 0000000..6892c39
--- /dev/null
+++ b/os/target/uefi_x86_64/programs/pauk/genes.saltic
@@ -0,0 +1,122 @@
+-- pauk/genes — геном паука, случайность, скрещивание, мутация.
+--
+-- layout генома (25 чисел): [freq, a0,p0,o0, ..., a7,p7,o7]
+-- make_manual() -> геном        преимущественно ручная походка для этапа 1
+-- make_random(seed) -> [seed, genome]
+-- crossover(a, b, seed) -> [seed, genome]
+-- mutate(genome, seed) -> [seed, genome]
+-- clamp_genome(genome) -> genome
+
+use core.group
+use core.num
+use os.target.uefi_x86_64.programs.pauk.body
+
+FREQ_LOW = 250
+FREQ_HIGH = 900
+AMP_LOW = 0
+AMP_HIGH = 70
+PHASE_TURN = 411775
+
+skill make_manual() {
+    @g = [520]
+    drum (8) {
+        @amp = 40
+        @phase = PHASE_TURN * beat / 8
+        (num.mod(beat, 2) == 1) { phase = phase + PHASE_TURN / 2 }
+        @off = 0
+        g = group.add(g, amp)
+        g = group.add(g, phase)
+        g = group.add(g, off)
+    }
+    out g
+}
+
+skill rng(seed, limit) {
+    (limit <= 0) { out [seed, 0] }
+    @s = seed
+    s = num.mod(s * 1103515245 + 12345, 2147483648)
+    @v = num.mod(s, limit)
+    (v < 0) { v = 0 - v }
+    out [s, v]
+}
+
+skill make_random(seed_in) {
+    @seed = seed_in
+    @g = []
+    @r = rng(seed, FREQ_HIGH - FREQ_LOW + 1)
+    seed = group.get(r, 0)
+    g = group.add(g, FREQ_LOW + group.get(r, 1))
+    drum (8) {
+        @r1 = rng(seed, AMP_HIGH - AMP_LOW + 1)
+        seed = group.get(r1, 0)
+        @r2 = rng(seed, PHASE_TURN)
+        seed = group.get(r2, 0)
+        @r3 = rng(seed, 61)
+        seed = group.get(r3, 0)
+        g = group.add(g, AMP_LOW + group.get(r1, 1))
+        g = group.add(g, group.get(r2, 1))
+        g = group.add(g, group.get(r3, 1) - 30)
+    }
+    out [seed, g]
+}
+
+skill crossover(a, b, seed_in) {
+    @seed = seed_in
+    @g = []
+    g = group.add(g, group.get(a, 0))
+    @flip = 0
+    drum (8) {
+        flip = 1 - flip
+        @base = 1 + beat * 3
+        @src = a
+        (flip == 1) { src = b }
+        g = group.add(g, group.get(src, base))
+        g = group.add(g, group.get(src, base + 1))
+        g = group.add(g, group.get(src, base + 2))
+    }
+    out [seed, g]
+}
+
+skill mutate(genome, seed_in) {
+    @seed = seed_in
+    @g = group.slice(genome, 0, group.count(genome))
+    @n = group.count(g)
+    @changes = 6
+    drum (changes) {
+        @r = rng(seed, n)
+        seed = group.get(r, 0)
+        @idx = group.get(r, 1)
+        (idx < 1) { idx = 1 }
+        @cur = group.get(g, idx)
+        @delta = 0
+        @r2 = rng(seed, 21)
+        seed = group.get(r2, 0)
+        delta = group.get(r2, 1) - 10
+        @nextv = cur + delta
+        (idx == 0) { nextv = body.clamp(nextv, FREQ_LOW, FREQ_HIGH) }
+        (num.mod(idx, 3) == 1) { nextv = body.clamp(nextv, AMP_LOW, AMP_HIGH) }
+        (num.mod(idx, 3) == 2) { 
+            nextv = num.mod(nextv + PHASE_TURN, PHASE_TURN)
+        }
+        (num.mod(idx, 3) == 0) {
+            (idx > 0) { nextv = body.clamp(nextv, 0 - 30, 30) }
+        }
+        g = group.tree_replaced(g, idx, nextv)
+    }
+    out [seed, g]
+}
+
+skill clamp_genome(genome) {
+    @g = group.slice(genome, 0, group.count(genome))
+    g = group.tree_replaced(g, 0, body.clamp(group.get(g, 0), FREQ_LOW, FREQ_HIGH))
+    drum (8) {
+        @base = 1 + beat * 3
+        @a = body.clamp(group.get(g, base), AMP_LOW, AMP_HIGH)
+        @p = num.mod(group.get(g, base + 1) + PHASE_TURN, PHASE_TURN)
+        @o = body.clamp(group.get(g, base + 2), 0 - 30, 30)
+        g = group.tree_replaced(g, base, a)
+        g = group.tree_replaced(g, base + 1, p)
+        g = group.tree_replaced(g, base + 2, o)
+    }
+    out g
+}
diff --git a/os/target/uefi_x86_64/programs/pauk/physics.saltic b/os/target/uefi_x86_64/programs/pauk/physics.saltic
new file mode 100644
index 0000000..3a35f54
--- /dev/null
+++ b/os/target/uefi_x86_64/programs/pauk/physics.saltic
@@ -0,0 +1,219 @@
+-- pauk/physics — упрощённая физика: точки Верле, палки-ограничения, земля.
+--
+-- init_state(genome) -> SpiderState
+-- step(state) -> none (один шаг, использует state.genes и state.t)
+-- evaluate(genome) -> число (дистанция со штрафом)
+-- points getter helpers
+
+use core.group
+use core.num
+use os.target.uefi_x86_64.screen.geometry
+use os.target.uefi_x86_64.programs.pauk.body
+use os.target.uefi_x86_64.programs.pauk.genes
+
+GRAV = body.GRAV
+
+skill body_index() { out 0 }
+skill knee_base() { out 1 }
+skill foot_base() { out 9 }
+
+skill point_get(points, idx, axis) {
+    out group.get(points, idx * 3 + axis)
+}
+
+skill point_set(points, idx, x, y, z) {
+    @p = group.tree_replaced(points, idx * 3, x)
+    p = group.tree_replaced(p, idx * 3 + 1, y)
+    p = group.tree_replaced(p, idx * 3 + 2, z)
+    out p
+}
+
+skill init_points() {
+    @points = []
+    points = group.add(points, 0)
+    points = group.add(points, body.BODY_Y)
+    points = group.add(points, 0)
+    drum (body.LEG_COUNT) {
+        @leg = beat
+        @sx = body.shoulder_x(leg)
+        @sz = body.shoulder_z(leg)
+        points = group.add(points, sx)
+        points = group.add(points, body.BODY_Y - body.UPPER)
+        points = group.add(points, sz)
+    }
+    drum (body.LEG_COUNT) {
+        @leg = beat
+        @sx = body.shoulder_x(leg)
+        @sz = body.shoulder_z(leg)
+        points = group.add(points, sx)
+        points = group.add(points, 0)
+        points = group.add(points, sz)
+    }
+    out points
+}
+
+skill init_state(genome) {
+    @points = init_points()
+    @state = body.SpiderState { genes = genome, points = points, prev = points, t = 0 }
+    out state
+}
+
+skill enforce_legs(state, bodyx, bodyy, bodyz) {
+    @points = state.points
+    @leg_count = body.LEG_COUNT
+    drum (3) {
+        drum (leg_count) {
+            @leg = beat
+            @knee = 1 + leg
+            @foot = 9 + leg
+            @ax = bodyx + body.shoulder_x(leg)
+            @ay = bodyy
+            @az = bodyz + body.shoulder_z(leg)
+            @kx = point_get(points, knee, 0)
+            @ky = point_get(points, knee, 1)
+            @kz = point_get(points, knee, 2)
+            @dx = kx - ax
+            @dy = ky - ay
+            @dz = kz - az
+            @dist = geometry.root(dx * dx + dy * dy + dz * dz)
+            (dist <= 0) { dist = 1 }
+            @nx = ax + dx * body.UPPER / dist
+            @ny = ay + dy * body.UPPER / dist
+            @nz = az + dz * body.UPPER / dist
+            points = point_set(points, knee, nx, ny, nz)
+            @fx = point_get(points, foot, 0)
+            @fy = point_get(points, foot, 1)
+            @fz = point_get(points, foot, 2)
+            @kx2 = point_get(points, knee, 0)
+            @ky2 = point_get(points, knee, 1)
+            @kz2 = point_get(points, knee, 2)
+            @dx2 = fx - kx2
+            @dy2 = fy - ky2
+            @dz2 = fz - kz2
+            @dist2 = geometry.root(dx2 * dx2 + dy2 * dy2 + dz2 * dz2)
+            (dist2 <= 0) { dist2 = 1 }
+            @fxn = kx2 + dx2 * body.LOWER / dist2
+            @fyn = ky2 + dy2 * body.LOWER / dist2
+            @fzn = kz2 + dz2 * body.LOWER / dist2
+            points = point_set(points, foot, fxn, fyn, fzn)
+        }
+    }
+    state.points = points
+    out none
+}
+
+skill muscle_step(state) {
+    @points = state.points
+    @genome = state.genes
+    @freq = group.get(genome, 0)
+    @bodyx = point_get(points, 0, 0)
+    @bodyy = point_get(points, 0, 1)
+    @bodyz = point_get(points, 0, 2)
+    drum (body.LEG_COUNT) {
+        @leg = beat
+        @baseg = 1 + leg * 3
+        @amp = group.get(genome, baseg)
+        @phase = group.get(genome, baseg + 1)
+        @off = group.get(genome, baseg + 2)
+        @angle = phase + state.t * freq
+        @sinv = geometry.sine(num.mod(angle, geometry.TURN))
+        @stride = amp * sinv / geometry.ONE + off
+        @shoulderx = body.shoulder_x(leg)
+        @shoulderz = body.shoulder_z(leg)
+        @targetx = bodyx + shoulderx + stride
+        @targetz = bodyz + shoulderz
+        @targety = 0
+        (sinv > geometry.ONE / 3) { targety = 40 }
+        @foot = 9 + leg
+        @fx = point_get(points, foot, 0)
+        @fy = point_get(points, foot, 1)
+        @fz = point_get(points, foot, 2)
+        @nx = fx + (targetx - fx) / 8
+        @ny = fy + (targety - fy) / 8
+        @nz = fz + (targetz - fz) / 8
+        points = point_set(points, foot, nx, ny, nz)
+    }
+    state.points = points
+    out none
+}
+
+skill ground_collide(state) {
+    @points = state.points
+    @prev = state.prev
+    @leg_count = body.LEG_COUNT
+    drum (leg_count) {
+        @foot = 9 + beat
+        @y = point_get(points, foot, 1)
+        (y < 0) {
+            @x = point_get(points, foot, 0)
+            @z = point_get(points, foot, 2)
+            @px = point_get(prev, foot, 0)
+            @py = point_get(prev, foot, 1)
+            @pz = point_get(prev, foot, 2)
+            points = point_set(points, foot, x, 0, z)
+            @vx = x - px
+            @vz = z - pz
+            @npx = x - vx / 8
+            @npz = z - vz / 8
+            prev = point_set(prev, foot, npx, 0, npz)
+        }
+    }
+    @by = point_get(points, 0, 1)
+    (by < 120) {
+        @bx = point_get(points, 0, 0)
+        @bz = point_get(points, 0, 2)
+        points = point_set(points, 0, bx, 120, bz)
+        @px0 = point_get(prev, 0, 0)
+        @pz0 = point_get(prev, 0, 2)
+        @vx0 = bx - px0
+        @vz0 = bz - pz0
+        prev = point_set(prev, 0, bx - vx0 / 8, point_get(prev,0,1), bz - vz0 / 8)
+    }
+    state.points = points
+    state.prev = prev
+    out none
+}
+
+skill step(state) {
+    @points = state.points
+    @prev = state.prev
+    @old = points
+    @newpoints = []
+    drum (body.POINT_COUNT) {
+        @idx = beat
+        @x = point_get(old, idx, 0)
+        @y = point_get(old, idx, 1)
+        @z = point_get(old, idx, 2)
+        @px = point_get(prev, idx, 0)
+        @py = point_get(prev, idx, 1)
+        @pz = point_get(prev, idx, 2)
+        newpoints = group.add(newpoints, 2 * x - px)
+        newpoints = group.add(newpoints, 2 * y - py - GRAV)
+        newpoints = group.add(newpoints, 2 * z - pz)
+    }
+    state.prev = old
+    state.points = newpoints
+    muscle_step(state)
+    @bx = point_get(state.points, 0, 0)
+    @by = point_get(state.points, 0, 1)
+    @bz = point_get(state.points, 0, 2)
+    enforce_legs(state, bx, by, bz)
+    ground_collide(state)
+    state.t = state.t + 1
+    out none
+}
+
+skill body_x(state) {
+    out point_get(state.points, 0, 0)
+}
+
+skill evaluate(genome) {
+    @state = init_state(genome)
+    @initial_x = point_get(state.points, 0, 0)
+    drum (body.STEPS) { step(state) }
+    @final_x = point_get(state.points, 0, 0)
+    @final_y = point_get(state.points, 0, 1)
+    @distance = final_x - initial_x
+    (final_y < 120) { distance = distance - 100000 }
+    out distance
+}
diff --git a/os/target/uefi_x86_64/programs/pauk/view.saltic b/os/target/uefi_x86_64/programs/pauk/view.saltic
new file mode 100644
index 0000000..ae3aa82
--- /dev/null
+++ b/os/target/uefi_x86_64/programs/pauk/view.saltic
@@ -0,0 +1,110 @@
+-- pauk/view — рисование лучшего паука пластилином и надписи.
+--
+-- render(stage, state, base) — кадр: земля, декорации, паук
+-- overlay(front, gen, best, avg, history) — текст и график
+
+use core.group
+use core.num
+use core.str
+use os.target.uefi_x86_64.screen.graphics
+use os.target.uefi_x86_64.screen.geometry
+use os.target.uefi_x86_64.screen.clay.mesh
+use os.target.uefi_x86_64.screen.clay.forms
+use os.target.uefi_x86_64.screen.clay.scene
+use os.target.uefi_x86_64.screen.clay.stage
+use os.uiengine.canvas
+use os.uiengine.fonts
+use os.target.uefi_x86_64.programs.pauk.body
+use os.target.uefi_x86_64.programs.pauk.physics
+
+SPIDER_COLOR = canvas.Rgb { red = 124, green = 88, blue = 64 }
+JOINT_COLOR = canvas.Rgb { red = 90, green = 60, blue = 40 }
+GRAPH_COLOR = canvas.Rgb { red = 34, green = 197, blue = 94 }
+
+skill add_item(list, item) {
+    out group.add(list, item)
+}
+
+skill build_spider_points(state, back) {
+    @bodies = []
+    @pts = state.points
+    @bx = physics.point_get(pts, 0, 0)
+    @by = physics.point_get(pts, 0, 1)
+    @bz = physics.point_get(pts, 0, 2)
+    @bodypos = [bx, by, bz]
+    bodies = group.add(bodies, forms.ellipsoid(back, bodypos, [44, 34, 44], SPIDER_COLOR, 4))
+    drum (body.LEG_COUNT) {
+        @leg = beat
+        @knee = 1 + leg
+        @foot = 9 + leg
+        @kp = [physics.point_get(pts, knee, 0), physics.point_get(pts, knee, 1), physics.point_get(pts, knee, 2)]
+        @fp = [physics.point_get(pts, foot, 0), physics.point_get(pts, foot, 1), physics.point_get(pts, foot, 2)]
+        bodies = group.add(bodies, forms.ellipsoid(back, kp, [14, 14, 14], JOINT_COLOR, 3))
+        bodies = group.add(bodies, forms.ellipsoid(back, fp, [12, 8, 12], JOINT_COLOR, 3))
+    }
+    out bodies
+}
+
+skill render(podium, state, base) {
+    @back = podium.back
+    drum (back.height) { graphics.copy_span(base, back, podium.sky, beat, 0, back.width) }
+    @camera = podium.camera
+    @pts = state.points
+    @bx = physics.point_get(pts, 0, 0)
+    @by = physics.point_get(pts, 0, 1)
+    @bz = physics.point_get(pts, 0, 2)
+    @from = [bx - 300, by + 320, bz + 700]
+    mesh.look(camera, from, [bx, by, bz])
+    mesh.ground(back, camera, podium.scene.ground, scene.CELLS)
+    @decorations = mesh.order(camera, podium.scene.bodies)
+    drum (group.count(decorations)) { mesh.draw(back, camera, group.get(decorations, beat)) }
+    @spider = build_spider_points(state, back)
+    @sorted = mesh.order(camera, spider)
+    drum (group.count(sorted)) { mesh.draw(back, camera, group.get(sorted, beat)) }
+    drum (back.height) { graphics.copy_span(base, podium.front, back, beat, 0, back.width) }
+    out none
+}
+
+skill overlay(front, gen, best, avg, history) {
+    @ink = canvas.paint(front, canvas.INK)
+    @white = canvas.paint(front, canvas.PAPER)
+    fonts.draw_text(front, 12, 8, "поколение {gen}", canvas.INK, fonts.HEADING)
+    fonts.draw_text(front, 12, 30, "рекорд {best}", canvas.INK, fonts.REGULAR)
+    fonts.draw_text(front, 12, 50, "среднее {avg}", canvas.ZINC_500, fonts.REGULAR)
+    @gw = 240
+    @gh = 80
+    @gx = front.width - gw - 8
+    @gy = front.height - gh - 8
+    graphics.fill(front, gx, gy, gw, gh, canvas.paint(front, canvas.WHITE))
+    @count = group.count(history)
+    (count < 2) { out none }
+    @start = 0
+    (count > gw) { start = count - gw }
+    @mn = group.get(history, start)
+    @mx = mn
+    drum (count - start) {
+        @v = group.get(history, start + beat)
+        (v < mn) { mn = v }
+        (v > mx) { mx = v }
+    }
+    @range = mx - mn
+    (range <= 0) { range = 1 }
+    drum (count - start - 1) {
+        @x0 = gx + beat
+        @x1 = gx + beat + 1
+        @v0 = group.get(history, start + beat)
+        @v1 = group.get(history, start + beat + 1)
+        @y0 = gy + gh - 1 - (v0 - mn) * (gh - 1) / range
+        @y1 = gy + gh - 1 - (v1 - mn) * (gh - 1) / range
+        (y0 < gy) { y0 = gy }
+        (y0 > gy + gh - 1) { y0 = gy + gh - 1 }
+        (y1 < gy) { y1 = gy }
+        (y1 > gy + gh - 1) { y1 = gy + gh - 1 }
+        @lo = y0
+        @hi = y1
+        (y1 < lo) { lo = y1
+            hi = y0 }
+        drum (hi - lo + 1) { graphics.fill(front, x0, lo + beat, 1, 1, canvas.paint(front, GRAPH_COLOR)) }
+    }
+    out none
+}
