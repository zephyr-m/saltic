-- facade — бывший фасад rv32i (до 22.11.2026): свободные обёртки над
-- layout, riscv.emit и rv32i.elf для платформ и тестов. Второй способ того же,
-- что делают хозяева (Program, emit, elf); при переходе горна на СОП
-- вызывающие переведены на хозяев, обёртки сохранены здесь.

Operation = Box {
    kind = Instruction.Kind.UNKNOWN_INSTRUCTION,
    rd = 0,
    rs1 = 0,
    rs2 = 0,
    immediate = 0
}

skill operation(kind, rd, rs1, rs2, immediate) {
    out Operation {
        kind = kind,
        rd = rd,
        rs1 = rs1,
        rs2 = rs2,
        immediate = immediate
    }
}

skill host(entry) {
    out layout.host(entry)
}

skill qemu_virt(entry) {
    out layout.qemu_virt(entry)
}

skill emit(target, value) {
    out emit.op(target, value.kind, value.rd, value.rs1, value.rs2, value.immediate)
}

skill label(target, section, name) {
    target.define_label(section, name)
    out target
}

skill branch(target, kind, rs1, rs2, label_name) {
    out emit.branch(target, kind, rs1, rs2, label_name)
}

skill jump(target, rd, label_name) {
    out emit.jump(target, rd, label_name)
}

skill load_immediate(target, rd, immediate) {
    out emit.load_immediate(target, rd, immediate)
}

skill branch_unsigned_greater(target, rs1, rs2, label_name) {
    out emit.branch_unsigned_greater(target, rs1, rs2, label_name)
}

skill call(target, label_name) {
    out emit.call(target, label_name)
}

skill relative_address(target, rd, label_name, addend) {
    out emit.relative_address(target, rd, label_name, addend)
}

skill absolute_address(target, rd, label_name, addend) {
    out emit.absolute_address(target, rd, label_name, addend)
}

skill resolve(target) {
    out layout.resolve(target)
}

skill executable(target) {
    out elf.executable(target)
}
