-- x86_64.write — узкий ELF x86-64 (до 22.11.2026): его никто не звал (toolchain
-- пишет write_wide / write_uefi); ушёл в архив при переходе x86 на СОП.

skill write(path, machine) {
    machine = linux.append(machine)
    machine = layout.resolve(machine) rescue |failure| { out error.UnresolvedPatch }
    out elf64.write(path, machine)
}

