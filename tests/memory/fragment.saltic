-- fragment — дробление: волны роста и сжатия, мелкие куски вперемешку с
-- большими, поле, которое растёт и обнуляется. Мерка — куча после волн
-- возвращается к уровню до них, а пик в вечном цикле не растёт от волны к волне.
--
-- Holder { items } — поле, которое растёт и обнуляется
-- wave(size) / mixed(turns) / breathe(holder, waves) -> число
-- CASES — случаи; program(chosen) — один случай, "" — все, "список" — имена случаев

use core.str
use core.group
use craft.testing
use tests.memory.meter

CASES = ["волны в вызовах", "мелкие и большие в always", "поле растёт и обнуляется", "пик от волны к волне"]

Holder = Box {
    items = []
}

skill wave(size) {
    @items = []
    drum (size) { items = group.add(items, beat) }
    out group.count(items)
}

skill waves(count) {
    @total = 0
    drum (count) {
        total = total + wave(5000)
        total = total + wave(10)
    }
    out total
}

skill mixed(turns) {
    @n = 0
    @longest = 0
    always {
        n = n + 1
        @small = "м{n}"
        @parts = []
        (n % 7 == 0) { drum (200) { parts = group.add(parts, "большой кусок") } }
        @big = str.join(parts, "")
        (str.bytes(big) > longest) { longest = str.bytes(big) }
        (n == turns) { leave }
    }
    out longest
}

skill breathe(holder, rounds) {
    @n = 0
    always {
        n = n + 1
        holder.items = group.add(holder.items, n)
        (n % 500 == 0) { holder.items = [] }
        (n == rounds) { leave }
    }
    out group.count(holder.items)
}

skill peaks(count) {
    @first = 0
    @last = 0
    drum (count) {
        @before = meter.used()
        wave(2000)
        @after = meter.used() - before
        (beat == 0) { first = after }
        last = after
    }
    out last - first
}

skill run(suite, name) {
    (name == "волны в вызовах") { suite = testing.test_equal(suite, name, waves(40), 40 * 5010) }
    (name == "мелкие и большие в always") { suite = testing.test_equal(suite, name, mixed(200000), 200 * str.bytes("большой кусок")) }
    (name == "поле растёт и обнуляется") {
        @holder = Holder {}
        suite = testing.test_equal(suite, name, breathe(holder, 1000000), 0)
    }
    (name == "пик от волны к волне") { suite = testing.test_equal(suite, name, peaks(30), 0) }
    out suite
}

program(chosen) {
    @suite = testing.test_new()
    @cases = CASES
    (chosen == "список") { out meter.list(CASES) }
    ((chosen == "") == no) { cases = [chosen] }
    drum (cases) {
        @name = beat
        @used = meter.used()
        suite = run(suite, name) rescue |err| {
            meter.metric("дробление, {name}: ошибка", "{err}")
            testing.test_equal(suite, "{name}: без ошибки", "{err}", "без ошибки")
        }
        @left = meter.used() - used
        suite = testing.test_equal(suite, "{name}: куча вернулась к прежней", left, 0)
        meter.metric("дробление, {name}: осталось в куче после выхода, байт", left)
    }
    out testing.test_finish(suite)
}
