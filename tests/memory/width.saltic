-- width — ширина: большие значения под потолком кучи. Большая группа и строка,
-- большой out из навыка снова и снова (копия при выходе из региона), bytes на
-- полкучи, out блока на 40 % кучи (копия при выходе требует столько же
-- свободного). «группа по одному» — group.add копирует всю группу, мусор копий
-- лежит до выхода из навыка: квадрат памяти. После выхода из вызова куча обязана вернуться к прежнему; нехватка
-- места на копию при выходе не должна проходить молча.
--
-- grow(n) / long_text(n) / make_big(n) / again(times, n) / half() / big_block(size)
-- value(name) -> что дал случай; expected(name) -> что должен; right(name) -> yes/no
--     (ошибка и чужое значение — в метрику): ответ не занимает кучу, и замер «куча
--     вернулась к прежней» не видит строк самой проверки (запись провала в suite)
-- CASES — случаи; program(chosen) — один случай, "" — все, "список" — имена случаев

use core.str
use core.group
use core.bytes
use core.mem
use craft.testing
use tests.memory.meter

CASES = ["группа 20000 по одному", "строка 100000", "большой out 50 раз", "bytes на полкучи", "out почти всей кучи"]

skill grow(n) {
    @items = []
    drum (n) { items = group.add(items, beat) }
    out items
}

skill long_text(n) {
    @parts = []
    drum (n / 10) { parts = group.add(parts, "0123456789") }
    out str.join(parts, "")
}

skill make_big(n) {
    out grow(n)
}

skill again(times, n) {
    @total = 0
    drum (times) { total = total + group.count(make_big(n)) }
    out total
}

skill half() {
    @buffer = bytes.new(mem.heap(2) / 2)
    bytes.set(buffer, 0, 7)
    out bytes.get(buffer, 0)
}

skill big_block(size) {
    @block = bytes.new(size)
    bytes.set(block, 1, 9)
    out block
}

skill value(name) {
    (name == "группа 20000 по одному") { out group.count(grow(20000)) }
    (name == "строка 100000") { out str.bytes(long_text(100000)) }
    (name == "большой out 50 раз") { out again(50, 5000) }
    (name == "bytes на полкучи") { out half() }
    @block = big_block(mem.heap(2) * 2 / 5)
    out bytes.get(block, 1)
}

skill expected(name) {
    (name == "группа 20000 по одному") { out 20000 }
    (name == "строка 100000") { out 100000 }
    (name == "большой out 50 раз") { out 250000 }
    (name == "bytes на полкучи") { out 7 }
    out 9
}

skill right(name) {
    @found = value(name) rescue |err| {
        meter.metric("ширина, {name}: ошибка", "{err}")
        out no
    }
    (found == expected(name)) { out yes }
    meter.metric("ширина, {name}: получено", found)
    out no
}

program(chosen) {
    @suite = testing.test_new()
    @cases = CASES
    (chosen == "список") { out meter.list(CASES) }
    ((chosen == "") == no) { cases = [chosen] }
    drum (cases) {
        @name = beat
        @used = meter.used()
        @done = right(name)
        @left = meter.used() - used
        suite = testing.test_equal(suite, "{name}: без ошибки и верно", done, yes)
        suite = testing.test_equal(suite, "{name}: куча вернулась к прежней", left, 0)
        meter.metric("ширина, {name}: осталось в куче после выхода, байт", left)
    }
    out testing.test_finish(suite)
}
