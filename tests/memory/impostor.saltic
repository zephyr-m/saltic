-- impostor — обманщики: значения, чьи сырые биты похожи на указатель кучи —
-- address и u32 с младшими битами 011, числа у края 29 и 61 бита, bits32 со
-- всеми единицами. Объявлены снаружи вечного цикла и живут в нём, пока цикл
-- сорит: уборка не должна принять их за указатель и отключиться, а значения —
-- измениться. Мерка — куча стоит, значения целы.
--
-- Holder { word, flags, number } — фиксированные значения в поле Box (поле
--     отдаёт number, как и группа: тип возвращается через u32.from)
-- spin(turns) -> мусор оборотов; CASES — случаи; program(chosen) — случай, "" или "список"

use core.u32
use core.bits32
use core.address
use core.usize
use core.num
use craft.testing
use tests.memory.meter

CASES = ["address с битами 011", "u32 с битами 011", "bits32 все единицы", "число у края", "фиксированные в поле Box"]

Holder = Box {
    word = u32.from(0),
    flags = bits32.from(0),
    number = 0
}

skill spin(turns, seed) {
    @n = 0
    always {
        n = n + 1
        @junk = [n, seed, n]
        @text = "сор {n}"
        (n == turns) { leave }
    }
    out n
}

skill run(suite, name) {
    @turns = 2000000
    (name == "address с битами 011") {
        @where = address.from(1048579)
        @done = spin(turns, 1)
        suite = testing.test_equal(suite, name, address.add(where, usize.from(0)) == address.from(1048579), yes)
    }
    (name == "u32 с битами 011") {
        @word = u32.from(3221225475)
        @done = spin(turns, 2)
        suite = testing.test_equal(suite, name, word == u32.from(3221225475), yes)
    }
    (name == "bits32 все единицы") {
        @all = bits32.invert(bits32.from(0))
        @done = spin(turns, 3)
        suite = testing.test_equal(suite, name, all == bits32.invert(bits32.from(0)), yes)
    }
    (name == "число у края") {
        @edge = num.MAXIMUM
        @done = spin(turns, 4)
        suite = testing.test_equal(suite, name, edge, num.MAXIMUM)
    }
    (name == "фиксированные в поле Box") {
        @holder = Holder { word = u32.from(3221225475), flags = bits32.invert(bits32.from(0)), number = num.MAXIMUM }
        @done = spin(turns, 5)
        suite = testing.test_equal(suite, name, u32.from(holder.word) == u32.from(3221225475), yes)
    }
    out suite
}

program(chosen) {
    @suite = testing.test_new()
    @cases = CASES
    (chosen == "список") { out meter.list(CASES) }
    ((chosen == "") == no) { cases = [chosen] }
    drum (cases) {
        @name = beat
        @used = meter.used()
        suite = run(suite, name) rescue |err| {
            meter.metric("обманщики, {name}: ошибка", "{err}")
            testing.test_equal(suite, "{name}: без ошибки", "{err}", "без ошибки")
        }
        @left = meter.used() - used
        suite = testing.test_equal(suite, "{name}: куча вернулась к прежней", left, 0)
        meter.metric("обманщики, {name}: осталось в куче после выхода, байт", left)
    }
    out testing.test_finish(suite)
}
