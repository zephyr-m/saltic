-- meter — замеры памяти для набора memory: занято регионами (mem.heap 0), байт
-- страниц хранилища (mem.heap 1), квота (mem.heap 2). Замер снимается между
-- циклами, когда регионы оборотов уже убраны: тогда разница — то, что осталось навсегда.
-- Печатает «метрика: имя = значение» — по этим строкам набор собирает таблицу.
--
-- used() / escapes() (страницы хранилища) -> числа без выделения памяти: снимок не попадает в замер
-- Snapshot { used, escapes }; snap() -> Snapshot; grown(before, after) -> [байт, побегов]
-- per_thousand(bytes, turns) -> байт на 1000 оборотов
-- metric(name, value) — строка метрики; list(cases) — «случай памяти: имя» на каждый

use io
use core.mem

Snapshot = Box {
    used = 0,
    escapes = 0
}

skill used() {
    out mem.heap(0)
}

skill escapes() {
    out mem.heap(1)
}

skill snap() {
    out Snapshot { used = mem.heap(0), escapes = mem.heap(1) }
}

skill grown(before, after) {
    out [after.used - before.used, after.escapes - before.escapes]
}

skill per_thousand(bytes, turns) {
    (turns == 0) { out 0 }
    out bytes * 1000 / turns
}

skill metric(name, value) {
    io.show("метрика: {name} = {value}")
    out none
}

skill list(cases) {
    drum (cases) { io.show("случай памяти: {beat}") }
    out none
}
