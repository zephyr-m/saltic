-- groups — большие группы: с 33-го элемента группа становится деревом
-- (core.group.tree_add), а снаружи остаётся обычной группой. Проверяется на
-- 40 (два уровня), 1 000 и 50 000 (дерево растёт в высоту): каждый элемент
-- на месте, drum по порядку, старая версия после add не меняется, slice,
-- concat, contains, группа Box переживает выход из навыка.

use core.group
use craft.testing

Item = Box {
    label = "",
    weight = 0
}

skill numbers(size) {
    @items = []
    drum (size) { items = group.add(items, beat) }
    out items
}

skill boxes(size) {
    @items = []
    drum (size) { items = group.add(items, Item { label = "№{beat}", weight = beat * 2 }) }
    out items
}

skill misplaced(items, size) {
    @wrong = 0
    drum (size) {
        ((group.get(items, beat) == beat) == no) { wrong = wrong + 1 }
    }
    out wrong
}

skill out_of_order(items) {
    @steps = 0
    @wrong = 0
    drum (items) {
        ((beat == steps) == no) { wrong = wrong + 1 }
        steps = steps + 1
    }
    out wrong
}

skill check(suite, size) {
    @items = numbers(size)
    suite = testing.test_equal(suite, "{size}: число элементов", group.count(items), size)
    suite = testing.test_equal(suite, "{size}: не на месте", misplaced(items, size), 0)
    suite = testing.test_equal(suite, "{size}: drum не по порядку", out_of_order(items), 0)
    @longer = group.add(items, -1)
    suite = testing.test_equal(suite, "{size}: старая цела — число", group.count(items), size)
    suite = testing.test_equal(suite, "{size}: старая цела — последний", group.get(items, size - 1), size - 1)
    suite = testing.test_equal(suite, "{size}: новая — последний", group.get(longer, size), -1)
    @piece = group.slice(items, size / 2, size / 2 + 3)
    suite = testing.test_equal(suite, "{size}: slice", group.get(piece, 2), size / 2 + 2)
    @joined = group.concat(items, [-5, -6])
    suite = testing.test_equal(suite, "{size}: concat", group.get(joined, size + 1), -6)
    suite = testing.test_yes(suite, "{size}: contains", group.contains(items, size - 1))
    @named = boxes(size)
    @middle = group.get(named, size / 2)
    suite = testing.test_equal(suite, "{size}: Box после выхода из навыка", middle.weight, size / 2 * 2)
    out suite
}

program() {
    @suite = testing.test_new()
    suite = check(suite, 40)
    suite = check(suite, 1000)
    suite = check(suite, 50000)
    out testing.test_finish(suite)
}
