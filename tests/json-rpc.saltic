use core
use s2.std.testing
use s2.protocols.data.json
use s2.protocols.data.json.text
use s2.protocols.data.json.value
use s2.protocols.data.json.number
use s2.protocols.data.json.reader
use s2.protocols.data.json.writer
use s2.protocols.data.json_rpc
use s2.protocols.data.json_rpc.decoder
use s2.protocols.data.json_rpc.encoder

skill json_values(suite) {
    @document = "{\"name\":\"Saltic\",\"enabled\":true,\"count\":-12.5e+2,\"nothing\":null,\"items\":[1,\"two\",false],\"unicode\":\"\\u0421\\ud83d\\udc1c\"}"
    @parsed = reader.parse(document)
    suite = testing.test_yes(suite, "json parse", parsed.ok)
    suite = testing.test_yes(suite, "json root object", parsed.value.kind == json.JsonKind.OBJECT)

    @name = value.get(parsed.value, "name")
    @enabled = value.get(parsed.value, "enabled")
    @count = value.get(parsed.value, "count")
    @nothing = value.get(parsed.value, "nothing")
    @items = value.get(parsed.value, "items")
    @unicode = value.get(parsed.value, "unicode")

    suite = testing.test_yes(suite, "json string", value.string_equal(name.value, "Saltic"))
    suite = testing.test_yes(suite, "json answer", enabled.value.answer)
    suite = testing.test_yes(suite, "json number", count.value.number == "-12.5e+2")
    suite = testing.test_yes(suite, "json null", nothing.value.kind == json.JsonKind.NULL)
    suite = testing.test_yes(suite, "json array", items.value.kind == json.JsonKind.ARRAY)
    suite = testing.test_yes(suite, "json array count", core.group.count(items.value.items) == 3)
    suite = testing.test_yes(suite, "json unicode", value.string_equal(unicode.value, "С🐜"))
    suite = testing.test_yes(suite, "json roundtrip", writer.encode(parsed.value) == document)

    @made = value.object([
        value.field("quote", value.string("a\"b\n")),
        value.field("wide", value.string("С🐜")),
    ])
    @made_expected = "{\"quote\":\"a\\\"b\\n\",\"wide\":\"\\u0421\\ud83d\\udc1c\"}"
    suite = testing.test_yes(suite, "json construct", writer.encode(made) == made_expected)
    out suite
}

skill json_numbers(suite) {
    @zero = reader.parse("0")
    @negative = reader.parse("-42")
    @fraction = reader.parse("12.5")
    @exponent = reader.parse("-12.5e+2")
    @leading_zero = reader.parse("01")
    @empty_fraction = reader.parse("1.")
    @empty_exponent = reader.parse("1e")
    suite = testing.test_yes(suite, "number zero", zero.ok)
    suite = testing.test_yes(suite, "number negative", negative.ok)
    suite = testing.test_yes(suite, "number fraction", fraction.ok)
    suite = testing.test_yes(suite, "number exponent", exponent.ok)
    suite = testing.test_yes(suite, "number leading zero", leading_zero.ok == no)
    suite = testing.test_yes(suite, "number empty fraction", empty_fraction.ok == no)
    suite = testing.test_yes(suite, "number empty exponent", empty_exponent.ok == no)
    suite = testing.test_yes(suite, "integer grammar", number.integer_text_valid("-32600"))
    suite = testing.test_yes(suite, "fraction not integer", number.integer_text_valid("1.5") == no)
    out suite
}

skill json_errors(suite) {
    @missing_colon = reader.parse("{\"a\" 1}")
    @trailing_comma = reader.parse("[1,]")
    @unknown_escape = reader.parse("\"\\x\"")
    @high_surrogate = reader.parse("\"\\ud800\"")
    @low_surrogate = reader.parse("\"\\udc00\"")
    @trailing_data = reader.parse("true false")
    suite = testing.test_yes(suite, "json missing colon", missing_colon.ok == no)
    suite = testing.test_yes(suite, "json trailing comma", trailing_comma.ok == no)
    suite = testing.test_yes(suite, "json unknown escape", unknown_escape.ok == no)
    suite = testing.test_yes(suite, "json high surrogate", high_surrogate.ok == no)
    suite = testing.test_yes(suite, "json low surrogate", low_surrogate.ok == no)
    suite = testing.test_yes(suite, "json trailing data", trailing_data.ok == no)
    out suite
}

skill rpc_request(suite) {
    @source = "{\"jsonrpc\":\"2.0\",\"method\":\"subtract\",\"params\":[42,23],\"id\":1}"
    @packet = decoder.decode(source)
    @message = core.group.item(packet.messages, 0)

    suite = testing.test_yes(suite, "rpc request packet", packet.ok)
    suite = testing.test_yes(suite, "rpc request single", packet.batch == no)
    suite = testing.test_yes(suite, "rpc request kind", message.kind == json_rpc.MessageKind.REQUEST)
    suite = testing.test_yes(suite, "rpc request method", json_rpc.method_is(message, "subtract"))
    suite = testing.test_yes(suite, "rpc request params", message.params.kind == json.JsonKind.ARRAY)
    suite = testing.test_yes(suite, "rpc request id", message.id.number == "1")
    suite = testing.test_yes(suite, "rpc request roundtrip", encoder.encode_packet(packet) == source)

    @notification = json_rpc.notification_with_params("update", value.object([value.field("value", value.number(7))]))
    @notification_expected = "{\"jsonrpc\":\"2.0\",\"method\":\"update\",\"params\":{\"value\":7}}"
    suite = testing.test_yes(suite, "rpc notification", encoder.encode(notification) == notification_expected)

    @escaped = decoder.decode("{\"jsonrpc\":\"2.0\",\"method\":\"\\u043c\\u0435\\u0442\\u043e\\u0434\"}")
    @escaped_message = core.group.item(escaped.messages, 0)
    suite = testing.test_yes(suite, "rpc unicode method", json_rpc.method_is(escaped_message, "метод"))
    out suite
}

skill rpc_responses(suite) {
    @success = json_rpc.success(value.number(1), value.string("done"))
    @success_expected = "{\"jsonrpc\":\"2.0\",\"result\":\"done\",\"id\":1}"
    suite = testing.test_yes(suite, "rpc success", encoder.encode(success) == success_expected)

    @failure = json_rpc.failure(value.number(1), 0 - 32601, "Method not found")
    @failure_expected = "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32601,\"message\":\"Method not found\"},\"id\":1}"
    suite = testing.test_yes(suite, "rpc failure", encoder.encode(failure) == failure_expected)

    @source = "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32602,\"message\":\"Invalid params\",\"data\":{\"field\":\"x\"}},\"id\":\"call-1\"}"
    @root = reader.parse(source)
    @raw_result = value.get(root.value, "result")
    @raw_error = value.get(root.value, "error")
    @raw_choices = 0
    (raw_result.found == yes) { raw_choices = raw_choices + 1 }
    (raw_error.found == yes) { raw_choices = raw_choices + 1 }
    suite = testing.test_no(suite, "rpc result absent", raw_result.found)
    suite = testing.test_yes(suite, "rpc error present", raw_error.found)
    suite = testing.test_equal(suite, "rpc exclusive field count", raw_choices, 1)
    @packet = decoder.decode(source)
    @message = core.group.item(packet.messages, 0)
    suite = testing.test_equal(suite, "rpc decoded failure", message.kind, json_rpc.MessageKind.FAILURE)
    suite = testing.test_equal(suite, "rpc failure code", message.error_code, "-32602")
    @failure_message = writer.encode(value.string_text(message.error_message))
    suite = testing.test_equal(suite, "rpc failure message", failure_message, "\"Invalid params\"")
    suite = testing.test_equal(suite, "rpc failure data", message.has_error_data, yes)
    suite = testing.test_equal(suite, "rpc failure roundtrip", encoder.encode_packet(packet), source)
    out suite
}

skill rpc_batch(suite) {
    @source = "[{\"jsonrpc\":\"2.0\",\"method\":\"sum\",\"params\":[1,2],\"id\":\"a\"},{\"jsonrpc\":\"2.0\",\"method\":\"tick\"},{\"jsonrpc\":\"2.0\",\"result\":3,\"id\":\"a\"}]"
    @packet = decoder.decode(source)
    suite = testing.test_yes(suite, "rpc batch packet", packet.ok)
    suite = testing.test_yes(suite, "rpc batch marker", packet.batch)
    suite = testing.test_yes(suite, "rpc batch count", core.group.count(packet.messages) == 3)
    @request = core.group.item(packet.messages, 0)
    @notification = core.group.item(packet.messages, 1)
    @response = core.group.item(packet.messages, 2)
    suite = testing.test_yes(suite, "rpc batch request", request.kind == json_rpc.MessageKind.REQUEST)
    suite = testing.test_yes(suite, "rpc batch notification", notification.kind == json_rpc.MessageKind.NOTIFICATION)
    suite = testing.test_yes(suite, "rpc batch response", response.kind == json_rpc.MessageKind.SUCCESS)
    suite = testing.test_yes(suite, "rpc batch roundtrip", encoder.encode_packet(packet) == source)
    out suite
}

skill rpc_errors(suite) {
    @parse_packet = decoder.decode("{]")
    @parse_error = core.group.item(parse_packet.messages, 0)
    suite = testing.test_yes(suite, "rpc parse status", parse_packet.ok == no)
    suite = testing.test_yes(suite, "rpc parse kind", parse_error.kind == json_rpc.MessageKind.INVALID)
    suite = testing.test_yes(suite, "rpc parse code", parse_error.error_code == json_rpc.PARSE_ERROR)
    @parse_expected = "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32700,\"message\":\"\\u041e\\u0448\\u0438\\u0431\\u043a\\u0430 \\u0440\\u0430\\u0437\\u0431\\u043e\\u0440\\u0430\"},\"id\":null}"
    suite = testing.test_yes(suite, "rpc parse response", encoder.encode_packet(parse_packet) == parse_expected)

    @invalid_packet = decoder.decode("{\"jsonrpc\":\"1.0\",\"method\":\"old\",\"id\":1}")
    @invalid = core.group.item(invalid_packet.messages, 0)
    suite = testing.test_yes(suite, "rpc invalid status", invalid_packet.ok)
    suite = testing.test_yes(suite, "rpc invalid kind", invalid.kind == json_rpc.MessageKind.INVALID)
    suite = testing.test_yes(suite, "rpc invalid code", invalid.error_code == json_rpc.INVALID_REQUEST)

    @empty = decoder.decode("[]")
    @empty_message = core.group.item(empty.messages, 0)
    suite = testing.test_yes(suite, "rpc empty batch shape", empty.batch == no)
    suite = testing.test_yes(suite, "rpc empty batch invalid", empty_message.kind == json_rpc.MessageKind.INVALID)

    @bad_params = decoder.decode("{\"jsonrpc\":\"2.0\",\"method\":\"x\",\"params\":1,\"id\":1}")
    @bad_params_message = core.group.item(bad_params.messages, 0)
    suite = testing.test_yes(suite, "rpc invalid params", bad_params_message.kind == json_rpc.MessageKind.INVALID)

    @bad_response = decoder.decode("{\"jsonrpc\":\"2.0\",\"result\":1,\"error\":{\"code\":-1,\"message\":\"x\"},\"id\":1}")
    @bad_response_message = core.group.item(bad_response.messages, 0)
    suite = testing.test_equal(suite, "rpc exclusive result", bad_response_message.kind, json_rpc.MessageKind.INVALID)
    out suite
}

program() {
    @suite = testing.testing_new()
    suite = json_values(suite)
    suite = json_numbers(suite)
    suite = json_errors(suite)
    suite = rpc_request(suite)
    suite = rpc_responses(suite)
    suite = rpc_batch(suite)
    suite = rpc_errors(suite)
    testing.testing_finish(suite)
    out none
}
