-- bytes — буфер байтов: новый заполнен нулями, set меняет его на месте и
-- изменение видно по любой ссылке, края 0 и 255 проходят, ошибки по имени
-- (ByteOutsideRange, BytesBounds, InvalidSize), буфер на миллион байтов,
-- str.from_bytes — строка-копия буфера.

use core.bytes
use core.str
use core.group
use io.file
use craft.testing

skill wide(buffer) {
    @done = bytes.set(buffer, 2, 300) rescue |err| { out "{err}" }
    out "ok"
}

skill below(buffer) {
    @done = bytes.set(buffer, 2, -1) rescue |err| { out "{err}" }
    out "ok"
}

skill outside(buffer) {
    @value = bytes.get(buffer, bytes.count(buffer)) rescue |err| { out "{err}" }
    out "ok"
}

skill before(buffer) {
    @done = bytes.set(buffer, -1, 1) rescue |err| { out "{err}" }
    out "ok"
}

skill negative() {
    @buffer = bytes.new(-1) rescue |err| { out "{err}" }
    out "ok"
}

skill past_end(buffer) {
    @piece = bytes.slice(buffer, 2, bytes.count(buffer) + 1) rescue |err| { out "{err}" }
    out "ok"
}

skill wide_group() {
    @buffer = bytes.from_group([1, 256]) rescue |err| { out "{err}" }
    out "ok"
}

skill fill(buffer) {
    drum (bytes.count(buffer)) { bytes.set(buffer, beat, beat % 256) }
    out buffer
}

skill misplaced(buffer) {
    @found = 0
    drum (bytes.count(buffer)) {
        ((bytes.get(buffer, beat) == beat % 256) == no) { found = found + 1 }
    }
    out found
}

program() {
    @suite = testing.test_new()
    @empty = bytes.new(0)
    suite = testing.test_equal(suite, "пустой: число", bytes.count(empty), 0)
    @buffer = bytes.new(5)
    suite = testing.test_equal(suite, "новый: число", bytes.count(buffer), 5)
    suite = testing.test_equal(suite, "новый: нули", bytes.get(buffer, 3), 0)
    bytes.set(buffer, 0, 0)
    bytes.set(buffer, 1, 72)
    bytes.set(buffer, 4, 255)
    suite = testing.test_equal(suite, "set: 72", bytes.get(buffer, 1), 72)
    suite = testing.test_equal(suite, "set: край 255", bytes.get(buffer, 4), 255)
    @same = buffer
    bytes.set(same, 2, 9)
    suite = testing.test_equal(suite, "общая ссылка", bytes.get(buffer, 2), 9)
    suite = testing.test_equal(suite, "значение 300", wide(buffer), "ByteOutsideRange")
    suite = testing.test_equal(suite, "значение -1", below(buffer), "ByteOutsideRange")
    suite = testing.test_equal(suite, "индекс за концом", outside(buffer), "BytesBounds")
    suite = testing.test_equal(suite, "индекс -1", before(buffer), "BytesBounds")
    suite = testing.test_equal(suite, "размер -1", negative(), "InvalidSize")
    suite = testing.test_equal(suite, "ошибка не испортила", bytes.get(buffer, 2), 9)
    @piece = bytes.slice(buffer, 1, 3)
    suite = testing.test_equal(suite, "slice: число", bytes.count(piece), 2)
    suite = testing.test_equal(suite, "slice: первый", bytes.get(piece, 0), 72)
    bytes.set(piece, 0, 1)
    suite = testing.test_equal(suite, "slice: копия, исходный цел", bytes.get(buffer, 1), 72)
    suite = testing.test_equal(suite, "slice: за концом", past_end(buffer), "BytesBounds")
    @made = bytes.from_group([10, 0, 255])
    suite = testing.test_equal(suite, "from_group: последний", bytes.get(made, 2), 255)
    suite = testing.test_equal(suite, "from_group: 256", wide_group(), "ByteOutsideRange")
    @back = bytes.to_group(made)
    suite = testing.test_equal(suite, "to_group: число", group.count(back), 3)
    suite = testing.test_equal(suite, "to_group: первый", group.get(back, 0), 10)
    @stored = bytes.from_group([0, 1, 127, 128, 255, 10])
    file.write_bytes(testing.scratch("bytes.bin"), stored)
    @loaded = file.read_bytes(testing.scratch("bytes.bin"))
    suite = testing.test_equal(suite, "файл: число", bytes.count(loaded), 6)
    suite = testing.test_equal(suite, "файл: ноль в начале", bytes.get(loaded, 0), 0)
    suite = testing.test_equal(suite, "файл: 255", bytes.get(loaded, 4), 255)
    suite = testing.test_equal(suite, "файл: перевод строки", bytes.get(loaded, 5), 10)
    @big = fill(bytes.new(1000000))
    suite = testing.test_equal(suite, "миллион: число", bytes.count(big), 1000000)
    suite = testing.test_equal(suite, "миллион: не на месте", misplaced(big), 0)
    @word = bytes.from_group([208, 175, 33])
    @text = str.from_bytes(word)
    suite = testing.test_equal(suite, "from_bytes: текст", text, "Я!")
    bytes.set(word, 2, 63)
    suite = testing.test_equal(suite, "from_bytes: копия", text, "Я!")
    suite = testing.test_equal(suite, "from_bytes: пустой", str.from_bytes(empty), "")
    suite = testing.test_equal(suite, "from_bytes: миллион", str.bytes(str.from_bytes(big)), 1000000)
    out testing.test_finish(suite)
}
