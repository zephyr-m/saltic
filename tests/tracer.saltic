use core

Payload = Box {
    name = ""
    value = 0
}

skill add(left, right) {
    out left + right
}

skill twice(value) {
    out add(value, value)
}

skill identity(text) {
    out text
}

skill payload(name, value) {
    out Payload {
        name = name
        value = value
    }
}

skill expected_failure() {
    out error.TraceFixture
}

skill rescue_probe() {
    @failed = expected_failure() rescue |failure| {
        no
    }
    out failed == no
}

skill pipeline(base) {
    @value = twice(base)
    @name = identity("trace")
    (rescue_probe() == no) { out error.RescueFailed }
    out payload(name, value)
}

program() {
    @result = pipeline(21)
    (result.name == "trace") {
        (result.value == 42) { out none }
    }
    out error.TraceFailed
}
