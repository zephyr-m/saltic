-- dict — словарь: пустой, set/get/has, перезапись ключа, общая ссылка,
-- отсутствующий ключ — UnknownKey по имени, изменение во вложенном навыке
-- видно снаружи (и с ростом таблицы внутри), тысячи ключей.

use core.dict
use core.num
use core.group
use craft.testing

Point = Box {
    x = 0,
    y = 0
}

skill absent(table, key) {
    @value = dict.get(table, key) rescue |err| { out "{err}" }
    out "ok"
}

skill fill(table, count) {
    drum (count) { dict.set(table, "ключ{beat}", beat * 3) }
    out table
}

skill misplaced(table, count) {
    @found = 0
    drum (count) {
        @key = "ключ{beat}"
        ((dict.get(table, key) == beat * 3) == no) { found = found + 1 }
    }
    out found
}

skill inside(table) {
    dict.set(table, "из навыка", "строка из навыка")
    dict.set(table, "точка", Point { x = 7, y = 8 })
    out none
}

skill deeper(table) {
    fill(table, 100)
    out none
}

skill made() {
    @table = dict.new()
    dict.set(table, "один", 1)
    out table
}

program() {
    @suite = testing.test_new()
    @table = dict.new()
    suite = testing.test_equal(suite, "пустой: нет ключа", dict.has(table, "имя"), no)
    suite = testing.test_equal(suite, "пустой: get", absent(table, "имя"), "UnknownKey")
    dict.set(table, "имя", "Зэф")
    suite = testing.test_equal(suite, "set: get", dict.get(table, "имя"), "Зэф")
    suite = testing.test_equal(suite, "set: has", dict.has(table, "имя"), yes)
    suite = testing.test_equal(suite, "пустой ключ: нет", dict.has(table, ""), no)
    dict.set(table, "", 0)
    suite = testing.test_equal(suite, "пустой ключ: есть", dict.get(table, ""), 0)
    dict.set(table, "имя", "Зефир")
    suite = testing.test_equal(suite, "перезапись", dict.get(table, "имя"), "Зефир")
    @same = table
    dict.set(same, "город", "Алматы")
    suite = testing.test_equal(suite, "общая ссылка", dict.get(table, "город"), "Алматы")
    suite = testing.test_equal(suite, "чужой ключ", absent(table, "возраст"), "UnknownKey")
    suite = testing.test_equal(suite, "ошибка не испортила", dict.get(table, "имя"), "Зефир")
    inside(table)
    suite = testing.test_equal(suite, "навык: строка", dict.get(table, "из навыка"), "строка из навыка")
    @point = dict.get(table, "точка")
    suite = testing.test_equal(suite, "навык: Box", point.y, 8)
    @grown = dict.new()
    deeper(grown)
    suite = testing.test_equal(suite, "навык с ростом: ключ 99", dict.get(grown, "ключ99"), 297)
    suite = testing.test_equal(suite, "навык с ростом: не на месте", misplaced(grown, 100), 0)
    @returned = made()
    suite = testing.test_equal(suite, "из out", dict.get(returned, "один"), 1)
    @big = fill(dict.new(), 5000)
    suite = testing.test_equal(suite, "5000: первый", dict.get(big, "ключ0"), 0)
    suite = testing.test_equal(suite, "5000: последний", dict.get(big, "ключ4999"), 14997)
    suite = testing.test_equal(suite, "5000: не на месте", misplaced(big, 5000), 0)
    suite = testing.test_equal(suite, "5000: корзин после роста", group.count(big.buckets), 4096)
    suite = testing.test_equal(suite, "5000: за краем", dict.has(big, "ключ5000"), no)
    dict.set(big, "ключ2500", "заменён")
    suite = testing.test_equal(suite, "5000: перезапись", dict.get(big, "ключ2500"), "заменён")
    @number = num.text(42)
    dict.set(big, number, "число")
    suite = testing.test_equal(suite, "ключ из числа", dict.get(big, "42"), "число")
    out testing.test_finish(suite)
}
