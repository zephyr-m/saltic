-- language — случаи tests/run про язык (набор all): чекер и канон ошибок,
-- фиксированные типы, дробные и канон 64 бит wide (x86-64, rv64, arm64), модули, json-rpc, диагностика, группы, байты, граничные
-- случаи, always, rv64, arm64, кодировщики RVA23, x86 и arm64, словарь, контракты seed и ABI,
-- машина, память, платформа (ошибки, аргументы, часы, stamp), process и родной
-- x86-64. Каждый случай — навык с именем как в наборе; провал — TestFailed.
--
-- run_case(t, name) -> yes, если случай отсюда (и он прошёл); no — чужой
-- Внутри: checker, no_remarks(path, why) — пустой отчёт чекера, иначе печатает
--     замечания и TestFailed; plain(t, name, source, expected, heap), pair(…) — rv32i и
--     x86-64 с одним эталоном, trimmed(text), normalized(text), clock_seconds

use io
use io.file
use core.str
use core.time
use core.group
use core.bytes
use core.process
use workbench.kit
use tests.run.core
use bootstrap.names

HUGE_HEAP = "4831838208"
BIG_NUMBERS = "-268435455 268435455 33554432 -33554433 100000000 33554431 -256 255 4096 -4097 200000001 268435455 4294967296 1099511627784 1152921504606846975 "
SMALL_HEAP = "1048576"
MIDDLE_HEAP = "2097152"
CANON_HEAP = "67108864"

skill trimmed(value) {
    @end = str.bytes(value)
    always {
        (end == 0) { leave }
        ((str.byte(value, end - 1) == 10) == no) { leave }
        end = end - 1
    }
    out str.slice(value, 0, end)
}

skill without_path(value) {
    @result = []
    drum (str.lines(value)) {
        (str.starts_with(beat, "  путь: ") == no) { result = group.add(result, beat) }
    }
    out str.join(result, "\n")
}

skill path_line(value) {
    drum (str.lines(value)) {
        (str.starts_with(beat, "  путь: ") == yes) { out beat }
    }
    out ""
}

skill folder(t, name) {
    @path = "{t.work}/{name}"
    process.run(["mkdir", "-p", path], "", [])
    out path
}

skill checker_program(t) {
    @path = "{t.work}/checker/checker.elf"
    (kit.exists(path) == yes) { out path }
    folder(t, "checker")
    core.build(t, "checker", "tests/checker.saltic", path, core.HEAP, t.host)
    out path
}

skill sorted_cases(path) {
    @found = []
    drum (file.list(path)) {
        (str.ends_with(beat, ".saltic") == yes) { found = group.add(found, beat) }
    }
    out kit.sorted(found)
}

skill no_remarks(path, why) {
    @report = core.contents(path)
    (str.bytes(report) == 0) { out none }
    io.show(why)
    io.show(report)
    out error.TestFailed
}

skill test_checker(t) {
    @checker = checker_program(t)
    @work = folder(t, "checker")
    core.run(t, t.host, [checker, "soul/canonical/main.saltic"], "{work}/canonical.txt")
    no_remarks("{work}/canonical.txt", "чекер: у канона есть замечания")
    core.run(t, t.host, [checker, "soul/canonical/wide.saltic"], "{work}/wide.txt")
    no_remarks("{work}/wide.txt", "чекер: у канона 64 бит есть замечания")
    drum (sorted_cases("soul/canonical/errors")) {
        @name = kit.base_name(beat)
        core.run(t, t.host, [checker, "soul/canonical/errors/{beat}"], "{work}/errors-{name}.txt")
        core.same("soul/canonical/expected/errors/{name}.txt", "{work}/errors-{name}.txt")
    }
    drum (sorted_cases("soul/canonical/errors/parser")) {
        @name = kit.base_name(beat)
        @code = core.run(t, t.host, [checker, "soul/canonical/errors/parser/{beat}"], "{work}/parser-{name}.txt")
        core.expect((code == 0) == no, "чекер: soul/canonical/errors/parser/{beat} разобрался, а должен упасть с ParseFailed")
        core.same("soul/canonical/expected/errors/parser/{name}.txt", "{work}/parser-{name}.txt")
    }
    out io.show("чекер: нативная проверка пройдена")
}

skill normalized(value) {
    @result = ""
    drum (str.lines(value)) {
        @parts = str.split(beat, "|")
        @line = beat
        (group.count(parts) >= 4) {
            @first = group.get(parts, 0)
            @rest = str.slice(beat, str.bytes(first) + str.bytes(group.get(parts, 1)) + str.bytes(group.get(parts, 2)) + 3, str.bytes(beat))
            line = "{first}|{rest}"
        }
        result = str.concat(result, "{line}\n")
    }
    out result
}

skill passed(path) {
    drum (str.lines(core.contents(path))) {
        (str.starts_with(beat, "итог: пройдено ") == yes) { out str.ends_with(beat, ", провалено 0") }
    }
    out no
}

skill test_fixed_types(t) {
    @checker = checker_program(t)
    @work = folder(t, "fixed-types")
    core.run(t, t.host, [checker, "soul/seed/tests/fixed.saltic"], "{work}/valid-diagnostics.txt")
    core.run(t, t.host, [checker, "soul/seed/tests/fixed-errors.saltic"], "{work}/errors.txt")
    core.expect(str.bytes(core.contents("{work}/valid-diagnostics.txt")) == 0, "фиксированные типы: у верного файла есть замечания")
    file.write("{work}/errors-normalized.txt", normalized(core.contents("{work}/errors.txt")))
    core.same("soul/seed/tests/expected/fixed-errors.txt", "{work}/errors-normalized.txt")
    core.build(t, "fixed-types", "soul/seed/tests/fixed.saltic", "{work}/program.elf", core.HEAP, t.host)
    core.run(t, t.host, ["{work}/program.elf"], "{work}/stdout.txt")
    core.expect(passed("{work}/stdout.txt"), "фиксированные типы: не все проверки прошли")
    out io.show("фиксированные типы: нативная проверка пройдена")
}

skill test_fraction(t) {
    @work = folder(t, "fraction")
    core.build(t, "fraction-x86_64", "soul/seed/tests/fraction.saltic", "{work}/x86_64", core.HEAP, "x86_64")
    core.build(t, "fraction-rv64", "soul/seed/tests/fraction.saltic", "{work}/rv64", core.HEAP, "rv64")
    core.build(t, "fraction-arm64", "soul/seed/tests/fraction.saltic", "{work}/arm64", core.HEAP, "arm64")
    core.run(t, "x86_64", ["{work}/x86_64"], "{work}/x86_64.txt")
    core.run(t, "rv64", ["{work}/rv64"], "{work}/rv64.txt")
    core.run(t, "arm64", ["{work}/arm64"], "{work}/arm64.txt")
    core.expect(passed("{work}/x86_64.txt"), "дробные: на x86-64 не все проверки прошли")
    core.expect(passed("{work}/rv64.txt"), "дробные: на rv64 не все проверки прошли")
    core.expect(passed("{work}/arm64.txt"), "дробные: на arm64 не все проверки прошли")
    out io.show("дробные: x86-64, rv64 и arm64 пройдены")
}

skill test_wide(t) {
    @work = folder(t, "wide")
    core.build(t, "wide-x86_64", "soul/canonical/wide.saltic", "{work}/x86_64", CANON_HEAP, "x86_64")
    core.build(t, "wide-rv64", "soul/canonical/wide.saltic", "{work}/rv64", CANON_HEAP, "rv64")
    core.build(t, "wide-arm64", "soul/canonical/wide.saltic", "{work}/arm64", CANON_HEAP, "arm64")
    core.run(t, "x86_64", ["{work}/x86_64"], "{work}/x86_64.txt")
    core.run(t, "rv64", ["{work}/rv64"], "{work}/rv64.txt")
    core.run(t, "arm64", ["{work}/arm64"], "{work}/arm64.txt")
    core.same("soul/canonical/expected/wide.txt", "{work}/x86_64.txt")
    core.same("soul/canonical/expected/wide.txt", "{work}/rv64.txt")
    out core.same("soul/canonical/expected/wide.txt", "{work}/arm64.txt")
}

skill test_modules(t) {
    @checker = checker_program(t)
    @work = folder(t, "modules")
    core.run(t, t.host, [checker, "tests/fixtures/modules/main.saltic"], "{work}/main-diagnostics.txt")
    core.run(t, t.host, [checker, "tests/fixtures/modules/errors.saltic"], "{work}/errors.txt")
    core.expect(str.bytes(core.contents("{work}/main-diagnostics.txt")) == 0, "модули: у main.saltic есть замечания")
    core.same("tests/expected/module-errors.txt", "{work}/errors.txt")
    core.build(t, "modules", "tests/fixtures/modules/main.saltic", "{work}/program.elf", core.HEAP, t.host)
    core.run(t, t.host, ["{work}/program.elf"], "{work}/stdout.txt")
    core.same("tests/expected/modules.txt", "{work}/stdout.txt")
    out io.show("модули: нативная проверка пройдена")
}

skill plain(t, name, source, expected, heap) {
    @work = folder(t, name)
    core.build(t, name, source, "{work}/program.elf", heap, t.host)
    (str.bytes(expected) == 0) {
        out core.must(core.run(t, t.host, ["{work}/program.elf"], ""), "{name}: программа упала")
    }
    core.run(t, t.host, ["{work}/program.elf"], "{work}/stdout.txt")
    out core.same(expected, "{work}/stdout.txt")
}

skill pair(t, name, source, expected, heap) {
    @work = folder(t, name)
    core.build(t, "{name}-rv32i", source, "{work}/rv32i.elf", heap, "rv32i")
    core.build(t, "{name}-x86_64", source, "{work}/x86_64", heap, "x86_64")
    core.run(t, "rv32i", ["{work}/rv32i.elf"], "{work}/rv32i.txt")
    core.run(t, "x86_64", ["{work}/x86_64"], "{work}/x86_64.txt")
    core.same(expected, "{work}/rv32i.txt")
    out core.same(expected, "{work}/x86_64.txt")
}

skill test_rva23(t) {
    @work = folder(t, "rva23")
    core.build(t, "rva23", "tests/rva23.saltic", "{work}/program", core.HEAP, "x86_64")
    core.run(t, "x86_64", ["{work}/program"], "{work}/lines.txt")
    core.must(process.run(["python3", "workbench/check/rva23/verify.py", "{work}/lines.txt"], "", []), "rva23: сверка с GNU-ассемблером не сошлась")
    out io.show("rva23: кодировщик RV64 сошёлся с GNU-ассемблером на всех командах таблицы")
}

skill canon_run(t, target, binary, work, prefix) {
    process.run(["cp", "tests/fixtures/input.txt", "{work}/input.txt"], "", [])
    core.run(t, target, [binary, "{work}/input.txt", "{work}/{prefix}output.txt"], "{work}/{prefix}stdout.txt")
    core.same("soul/canonical/expected/output.txt", "{work}/{prefix}stdout.txt")
    out core.expect(trimmed(core.contents("{work}/{prefix}output.txt")) == "pip:0", "канон: в файле вывода не pip:0")
}

skill numbers_line(t, target, binary, work) {
    core.run(t, target, [binary], "{work}/big-numbers.txt")
    @joined = str.concat(str.join(str.lines(core.contents("{work}/big-numbers.txt")), " "), " ")
    out core.expect(joined == BIG_NUMBERS, "большие числа: {joined}")
}

skill wide_target(t, target) {
    @work = folder(t, target)
    core.build(t, "edges-{target}", "soul/canonical/edges.saltic", "{work}/edges", core.HEAP, target)
    core.build(t, "always-{target}", "tests/always.saltic", "{work}/always", SMALL_HEAP, target)
    core.run(t, target, ["{work}/edges"], "{work}/edges.txt")
    core.run(t, target, ["{work}/always"], "{work}/always.txt")
    core.same("soul/canonical/expected/edges.txt", "{work}/edges.txt")
    core.same("tests/expected/always.txt", "{work}/always.txt")
    core.build(t, "canonical-{target}", "soul/canonical/main.saltic", "{work}/canonical", CANON_HEAP, target)
    canon_run(t, target, "{work}/canonical", work, "")
    core.build(t, "big-numbers-{target}", "tests/fixtures/big-numbers.saltic", "{work}/big-numbers", SMALL_HEAP, target)
    numbers_line(t, target, "{work}/big-numbers", work)
    core.build(t, "huge-heap-{target}", "soul/canonical/main.saltic", "{work}/huge-heap", HUGE_HEAP, target)
    canon_run(t, target, "{work}/huge-heap", work, "huge-")
    out io.show("{target}: канон (и с кучей 4,5 ГБ), edges, always и большие числа под qemu — те же выводы, что у rv32i и x86_64")
}

skill per_target(t, name, source, expected) {
    @work = folder(t, name)
    drum (["rv32i", "x86_64", "rv64"]) {
        core.build(t, "{name}-{beat}", source, "{work}/{beat}", core.HEAP, beat)
        core.run(t, beat, ["{work}/{beat}"], "{work}/{beat}.txt")
        core.same(expected, "{work}/{beat}.txt")
    }
    out none
}

skill clock_seconds(text) {
    @parts = str.split(text, ":")
    ((group.count(parts) == 3) == no) { out 0 }
    @result = 0
    drum (parts) { result = result * 60 + core.hundredths(beat) / 100 }
    out result
}

skill platform_target(t, target, work) {
    core.build(t, "platform-{target}", "tests/platform.saltic", "{work}/{target}", core.HEAP, target)
    core.build(t, "uncaught-{target}", "tests/fixtures/uncaught.saltic", "{work}/uncaught-{target}", core.HEAP, target)
    core.build(t, "needs-args-{target}", "tests/fixtures/needs-args.saltic", "{work}/needs-args-{target}", core.HEAP, target)
    core.run(t, target, ["{work}/{target}"], "{work}/{target}.txt")
    core.same("tests/expected/platform.txt", "{work}/{target}.txt")
    @uncaught = core.run(t, target, ["{work}/uncaught-{target}"], "{work}/uncaught-{target}.txt")
    core.expect((uncaught == 0) == no, "платформа: непойманная ошибка не стала кодом выхода ({target})")
    @uncaught_text = core.contents("{work}/uncaught-{target}.txt")
    core.expect(without_path(uncaught_text) == "до ошибки\nошибка: Boom", "платформа: вывод непойманной ошибки ({target})")
    @trail = path_line(uncaught_text)
    (str.bytes(trail) > 0) { core.expect(trail == "  путь: explode ← program", "платформа: путь ошибки — {trail} ({target})") }
    @short = core.run(t, target, ["{work}/needs-args-{target}"], "{work}/needs-args-{target}.txt")
    core.expect((short == 0) == no, "платформа: нехватка аргументов не стала кодом выхода ({target})")
    core.expect(trimmed(core.contents("{work}/needs-args-{target}.txt")) == "нужно 2 аргументов", "платформа: вывод нехватки аргументов ({target})")
    core.run(t, target, ["{work}/needs-args-{target}", "раз", "два"], "{work}/args-{target}.txt")
    core.expect(trimmed(core.contents("{work}/args-{target}.txt")) == "раз два", "платформа: аргументы не дошли ({target})")
    core.build(t, "stamp-{target}", "workbench/stamp.saltic", "{work}/stamp-{target}", core.HEAP, target)
    @before = clock_seconds(time.text(time.now() + t.zone))
    @stamped = core.run(t, target, ["{work}/stamp-{target}", "echo \"раз два\"; exit 3"], "{work}/stamp-{target}.txt")
    @after = clock_seconds(time.text(time.now() + t.zone))
    core.expect((stamped == 0) == no, "платформа: stamp не передал провал команды ({target})")
    @lines = str.lines(without_path(core.contents("{work}/stamp-{target}.txt")))
    core.expect(group.count(lines) == 2, "платформа: stamp — не две строки ({target})")
    @first = group.get(lines, 0)
    core.expect(str.slice(first, 11, str.bytes(first)) == "раз два", "платформа: stamp — строка без времени ({target})")
    core.expect(group.get(lines, 1) == "ошибка: StampedFailed", "платформа: stamp — нет StampedFailed ({target})")
    @moment = clock_seconds(str.slice(first, 1, 9))
    core.expect(moment >= before, "платформа: время stamp раньше запуска ({target})")
    out core.expect(moment <= after, "платформа: время stamp позже конца ({target})")
}

skill test_platform(t) {
    @work = folder(t, "platform")
    drum (["rv32i", "x86_64", "rv64", "arm64"]) { platform_target(t, beat, work) }
    out io.show("платформа: NotSupported ловится, непойманная ошибка и нехватка аргументов печатаются, часы и stamp идут — одинаково под rv32i, x86_64, rv64 и arm64")
}

skill shell_output(t, script, args) {
    @done = process.capture(group.concat(["bash", "-c", script], args), "", t.env)
    out done
}

skill test_native(t) {
    @work = folder(t, "native")
    core.build(t, "native-canonical", "soul/canonical/main.saltic", "{work}/canonical", CANON_HEAP, "x86_64")
    canon_run(t, "x86_64", "{work}/canonical", work, "")
    core.build(t, "native-memory", "soul/seed/tests/memory.saltic", "{work}/memory", MIDDLE_HEAP, "x86_64")
    core.must(core.run(t, "x86_64", ["{work}/memory"], ""), "x86-64: память упала")
    core.build(t, "native-deep", "tests/fixtures/deep-recursion.saltic", "{work}/deep", SMALL_HEAP, "x86_64")
    @deep = shell_output(t, "(ulimit -c 0; \"$0\") > \"$1\" 2>&1", ["{work}/deep", "{work}/deep.txt"])
    core.expect((deep.code == 0) == no, "x86-64: переполнение стека прошло молча")
    core.expect(str.contains(core.contents("{work}/deep.txt"), "вынырнул") == no, "x86-64: переполненный стек вернулся из рекурсии")
    core.build(t, "native-keys", "tests/fixtures/keys.saltic", "{work}/keys", SMALL_HEAP, "x86_64")
    @keys = shell_output(t, "printf 'a\\t\\177 z\\nq' | \"$0\"", ["{work}/keys"])
    core.expect(trimmed(keys.output) == "[a][tab][backspace][ ][z][enter]", "x86-64: нажатия — {keys.output}")
    core.build(t, "native-imports", "tests/fixtures/imports.saltic", "{work}/imports", CANON_HEAP, "x86_64")
    core.run(t, "x86_64", ["{work}/imports"], "{work}/imports.txt")
    core.expect(trimmed(core.contents("{work}/imports.txt")) == "длина: 6\nпусто: yes\nстрок: 3\nфайл прочитан: yes\nбайт 259: ByteOutsideRange", "x86-64: импорт")
    core.build(t, "native-big-numbers", "tests/fixtures/big-numbers.saltic", "{work}/big-numbers", SMALL_HEAP, "x86_64")
    numbers_line(t, "x86_64", "{work}/big-numbers", work)
    core.build(t, "native-huge-heap", "soul/canonical/main.saltic", "{work}/huge-heap", HUGE_HEAP, "x86_64")
    canon_run(t, "x86_64", "{work}/huge-heap", work, "huge-")
    @huge = HUGE_HEAP
    @narrow = process.capture(["bash", "-c", "\"$0\" \"$1\" \"$2\" \"$3\" rv32i > \"$4\" 2>&1", names.native_compiler(), "soul/canonical/main.saltic", "{work}/narrow-huge", huge, "{work}/narrow-huge.txt"], "", t.env)
    core.expect((narrow.code == 0) == no, "x86-64: куча {huge} на 4-байтном слове должна быть отвергнута")
    core.expect(str.contains(core.contents("{work}/narrow-huge.txt"), "ValueOutsideRange"), "x86-64: нет ValueOutsideRange")
    out io.show("x86-64 (x86_64): канон и память работают на родном процессоре, переполнение стека падает сразу, нажатия читаются, импорт работает, большие числа точны, куча 4,5 ГБ работает, на rv32i отвергается")
}

skill test_machine(t) {
    @work = folder(t, "machine")
    core.build(t, "machine", "soul/seed/tests/machine.saltic", "{work}/program.elf", core.HEAP, t.host)
    core.must(core.run(t, t.host, ["{work}/program.elf", "{work}/ordinary.elf"], ""), "машина: проверки упали")
    core.expect(kit.size("{work}/ordinary.elf") > 0, "машина: образ ordinary.elf пуст")
    core.must(process.run(["qemu-riscv32", "-B", core.QEMU_BASE, "{work}/ordinary.elf"], "", []), "машина: ordinary.elf упал")
    core.build(t, "testing-failure", "tests/fixtures/testing-failure.saltic", "{work}/testing-failure.elf", core.HEAP, t.host)
    @code = core.run(t, t.host, ["{work}/testing-failure.elf"], "{work}/testing-failure.txt")
    core.expect((code == 0) == no, "проверка: намеренно проваленный тест завершился успешно")
    @shown = without_path(core.contents("{work}/testing-failure.txt"))
    core.expect(str.contains(shown, "контроль провала -> 1  [FAIL]"), "проверка: нет строки провала")
    core.expect(str.contains(shown, "итог: пройдено 0, провалено 1"), "проверка: нет итога")
    core.expect(str.contains(shown, "проваленные проверки:"), "проверка: нет списка провалов")
    @lines = str.lines(shown)
    @count = group.count(lines)
    core.expect(count >= 2, "проверка: вывод короче двух строк")
    core.expect(str.contains(group.get(lines, count - 2), "- контроль провала -> 1  [FAIL] (ожидалось 2)"), "проверка: нет строки «ожидалось 2»")
    core.expect(group.get(lines, count - 1) == "ошибка: TestsFailed", "проверка: последняя строка не TestsFailed")
    out io.show("машина: кодирование и образ подтверждены")
}

skill run_case(t, name) {
    (name == "checker") {
        test_checker(t)
        out yes
    }
    (name == "fixed-types") {
        test_fixed_types(t)
        out yes
    }
    (name == "fraction") {
        test_fraction(t)
        out yes
    }
    (name == "wide") {
        test_wide(t)
        io.show("канон 64 бит: x86-64 и rv64 — один вывод")
        out yes
    }
    (name == "modules") {
        test_modules(t)
        out yes
    }
    (name == "json-rpc") {
        plain(t, name, "tests/json-rpc.saltic", "tests/expected/json-rpc.txt", core.HEAP)
        io.show("json-rpc: ok")
        out yes
    }
    (name == "diagnostics") {
        plain(t, name, "tests/diagnostics.saltic", "tests/expected/diagnostics.txt", core.HEAP)
        io.show("диагностика: всё согласовано")
        out yes
    }
    (name == "groups") {
        plain(t, name, "tests/groups.saltic", "tests/expected/groups.txt", core.HEAP)
        io.show("группы: деревья от 33 элементов подтверждены")
        out yes
    }
    (name == "bytes") {
        plain(t, name, "tests/bytes.saltic", "tests/expected/bytes.txt", core.HEAP)
        io.show("буфер байтов: нули, запись на месте, ошибки по имени подтверждены")
        out yes
    }
    (name == "edges") {
        pair(t, name, "soul/canonical/edges.saltic", "soul/canonical/expected/edges.txt", core.HEAP)
        io.show("граничные случаи: ошибки по имени, дерево Box, строки — одинаково под rv32i и x86_64")
        out yes
    }
    (name == "always") {
        pair(t, name, "tests/always.saltic", "tests/expected/always.txt", SMALL_HEAP)
        io.show("always: регион на оборот — 200 000 оборотов в 1 МБ, внешнее переживает уборку, под rv32i и x86_64")
        out yes
    }
    (name == "rva23") {
        test_rva23(t)
        out yes
    }
    (name == "rv64") {
        wide_target(t, "rv64")
        out yes
    }
    (name == "arm64") {
        wide_target(t, "arm64")
        out yes
    }
    (name == "arm64-encoder") {
        pair(t, name, "tests/arm64-encoder.saltic", "tests/expected/arm64-encoder.txt", core.HEAP)
        io.show("кодировщик arm64: слова команд совпадают с эталоном — одинаково под rv32i и x86_64")
        out yes
    }
    (name == "xtensa-encoder") {
        pair(t, name, "tests/xtensa-encoder.saltic", "tests/expected/xtensa-encoder.txt", core.HEAP)
        io.show("кодировщик xtensa: байты команд совпадают с GNU as Espressif — одинаково под rv32i и x86_64")
        out yes
    }
    (name == "x86-encoder") {
        pair(t, name, "tests/x86-encoder.saltic", "tests/expected/x86-encoder.txt", core.HEAP)
        io.show("кодировщик x86-64: байты команд совпадают с GNU as — одинаково под rv32i и x86_64")
        out yes
    }
    (name == "apk") {
        plain(t, name, "tests/apk.saltic", "", core.HEAP)
        io.show("apk: zip с выравниванием Android и CRC32")
        out yes
    }
    (name == "crypto") {
        plain(t, name, "tests/crypto.saltic", "", core.HEAP)
        io.show("crypto: сравнение секретов за постоянное время")
        out yes
    }
    (name == "dict") {
        pair(t, name, "tests/dict.saltic", "tests/expected/dict.txt", core.HEAP)
        io.show("словарь: запись на месте, UnknownKey, вложенный навык, рост таблицы — одинаково под rv32i и x86_64")
        out yes
    }
    (name == "seed-contract") {
        plain(t, name, "soul/seed/tests/contract.saltic", "", core.HEAP)
        io.show("seed: единый контракт подтверждён")
        out yes
    }
    (name == "machine") {
        test_machine(t)
        out yes
    }
    (name == "abi") {
        plain(t, name, "soul/seed/tests/abi.saltic", "", core.HEAP)
        io.show("ABI: единый контракт подтверждён")
        out yes
    }
    (name == "memory") {
        plain(t, name, "soul/seed/tests/memory.saltic", "", MIDDLE_HEAP)
        io.show("память: регионы освобождают мусор на куче 1 МБ")
        out yes
    }
    (name == "platform") {
        test_platform(t)
        out yes
    }
    (name == "process") {
        per_target(t, name, "tests/process.saltic", "tests/expected/process.txt")
        io.show("process: run, capture, lines, папка, PATH, окружение, список файлов — одинаково под rv32i, x86_64 и rv64")
        out yes
    }
    (name == "native") {
        test_native(t)
        out yes
    }
    out no
}
