-- events — тест ядра событий os.input.events: изменение и номер, то же значение
-- не повторяется, счётчик нажатий, пара указателя одним номером, такт,
-- очередь по порядку и пустая очередь; ядро жестов os.input.gestures: клик на
-- месте указателя, двойной — рядом и вскоре, далеко или поздно — нет, колесо
-- шагами, набор текста, нажатие клавиши без знака, Ctrl: знак с ним — нажатие,
-- клик с ним — с пометкой.
-- Запуск: tests/run.sh (events); эталона нет — только проверки.
--
-- program() -> none; TestsFailed

use core.group
use craft.testing
use os.input.events
use os.input.gestures

program() {
    @suite = testing.test_new()
    @kernel = events.Core {}

    kernel = events.change(kernel, "name", 0, "Зефир", 10)
    kernel = events.change(kernel, "volume", 40, "", 11)
    kernel = events.change(kernel, "volume", 40, "", 12)
    suite = testing.test_equal(suite, "events: то же значение — не изменение", group.count(kernel.queue), 2)
    suite = testing.test_equal(suite, "events: два номера выдано", kernel.next, 2)
    @name = events.current(kernel, "name")
    suite = testing.test_yes(suite, "events: имя помнится", name.found)
    suite = testing.test_equal(suite, "events: текст поля", name.change.text, "Зефир")
    suite = testing.test_equal(suite, "events: время изменения", name.change.time, 10)

    kernel = events.change(kernel, "volume", 57, "", 13)
    @volume = events.current(kernel, "volume")
    suite = testing.test_equal(suite, "events: последнее значение", volume.change.number, 57)
    suite = testing.test_equal(suite, "events: номер последнего", volume.change.order, 2)
    suite = testing.test_equal(suite, "events: имён два", group.count(kernel.values), 2)

    kernel = events.bump(kernel, "run", 14)
    kernel = events.bump(kernel, "run", 15)
    @run = events.current(kernel, "run")
    suite = testing.test_equal(suite, "events: два нажатия — счётчик 2", run.change.number, 2)

    kernel = events.pair(kernel, "pointer.x", 100, "pointer.y", 200, 16)
    kernel = events.pair(kernel, "pointer.x", 100, "pointer.y", 210, 17)
    kernel = events.pair(kernel, "pointer.x", 100, "pointer.y", 210, 18)
    @x = events.current(kernel, "pointer.x")
    @y = events.current(kernel, "pointer.y")
    suite = testing.test_equal(suite, "events: пара одним номером", x.change.order, 5)
    suite = testing.test_equal(suite, "events: сдвиг по y — новый номер", y.change.order, 6)
    suite = testing.test_equal(suite, "events: стоящий указатель — без номера", kernel.next, 7)

    kernel = events.tick(kernel, 19)
    @tick = events.current(kernel, events.TICK)
    suite = testing.test_equal(suite, "events: такт", tick.change.number, 19)
    suite = testing.test_equal(suite, "events: в очереди всё по порядку", group.count(kernel.queue), 9)

    @orders = []
    @ids = []
    drum (group.count(kernel.queue)) {
        @taken = events.take(kernel)
        orders = group.add(orders, taken.change.order)
        ids = group.add(ids, taken.change.id)
        kernel = taken.core
    }
    suite = testing.test_equal(suite, "events: первое из очереди", group.get(ids, 0), "name")
    suite = testing.test_equal(suite, "events: номера по возрастанию", group.get(orders, 8), 7)
    suite = testing.test_equal(suite, "events: пара подряд", group.get(ids, 5), "pointer.x")
    @empty = events.take(kernel)
    suite = testing.test_no(suite, "events: пустая очередь", empty.found)
    suite = testing.test_equal(suite, "events: значения остаются", group.count(empty.core.values), 6)

    @input = events.Core {}
    input = events.pair(input, gestures.POINTER_X, 40, gestures.POINTER_Y, 60, 100)
    input = events.bump(input, gestures.POINTER_LEFT, 100)
    input = events.bump(input, gestures.POINTER_LEFT, 300)
    input = events.bump(input, gestures.POINTER_LEFT, 1000)
    input = events.pair(input, gestures.POINTER_X, 90, gestures.POINTER_Y, 60, 1100)
    input = events.bump(input, gestures.POINTER_LEFT, 1200)
    input = events.change(input, gestures.POINTER_WHEEL, 2, "", 1300)
    input = events.change(input, gestures.POINTER_WHEEL, 1, "", 1400)
    input = events.change(input, gestures.TYPED, 1, "ж", 1500)
    input = events.change(input, gestures.TYPED, 2, "ж", 1600)
    @reader = gestures.Reader {}
    @drained = reader.drain(input)
    @made = drained.gestures
    @kinds = []
    drum (made) { kinds = group.add(kinds, beat.kind) }
    suite = testing.test_equal(suite, "gestures: жестов девять", group.count(made), 9)
    @first = group.get(made, 0)
    suite = testing.test_yes(suite, "gestures: клик", first.kind == gestures.Kind.CLICK)
    suite = testing.test_equal(suite, "gestures: клик на месте указателя", first.x, 40)
    suite = testing.test_yes(suite, "gestures: второй вскоре — двойной", group.get(kinds, 2) == gestures.Kind.DOUBLE)
    suite = testing.test_yes(suite, "gestures: поздний — просто клик", group.get(kinds, 3) == gestures.Kind.CLICK)
    suite = testing.test_yes(suite, "gestures: далёкий — просто клик", group.get(kinds, 4) == gestures.Kind.CLICK)
    @down = group.get(made, 5)
    @up = group.get(made, 6)
    suite = testing.test_equal(suite, "gestures: колесо вниз на 2", down.amount, 2)
    suite = testing.test_equal(suite, "gestures: колесо вверх на 1", up.amount, -1)
    @again = group.get(made, 8)
    suite = testing.test_equal(suite, "gestures: тот же знак ещё раз — набран", again.text, "ж")
    suite = testing.test_equal(suite, "gestures: очередь прочитана", group.count(drained.core.queue), 0)

    @keys = events.Core {}
    keys = events.bump(keys, "{gestures.KEY}left", 100)
    keys = events.change(keys, gestures.CTRL, 1, "", 200)
    keys = events.change(keys, gestures.TYPED, 1, "s", 300)
    keys = events.bump(keys, gestures.POINTER_LEFT, 400)
    keys = events.change(keys, gestures.CTRL, 0, "", 500)
    keys = events.change(keys, gestures.TYPED, 2, "s", 600)
    @pressing = gestures.Reader {}
    @read = pressing.drain(keys)
    @pressed = read.gestures
    suite = testing.test_equal(suite, "gestures: Ctrl сам жестом не стал", group.count(pressed), 4)
    @arrow = group.get(pressed, 0)
    suite = testing.test_yes(suite, "gestures: стрелка — нажатие", arrow.kind == gestures.Kind.PRESS)
    suite = testing.test_equal(suite, "gestures: имя клавиши без key.", arrow.text, "left")
    @saving = group.get(pressed, 1)
    suite = testing.test_yes(suite, "gestures: знак с Ctrl — нажатие", saving.kind == gestures.Kind.PRESS)
    suite = testing.test_yes(suite, "gestures: у нажатия Ctrl", saving.ctrl)
    @aiming = group.get(pressed, 2)
    suite = testing.test_yes(suite, "gestures: клик с Ctrl", aiming.ctrl)
    @plain = group.get(pressed, 3)
    suite = testing.test_yes(suite, "gestures: Ctrl отпущен — снова набор", plain.kind == gestures.Kind.TYPE)

    out testing.test_finish(suite)
}
