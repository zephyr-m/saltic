-- events — тест ядра событий os.ui.events: изменение и номер, то же значение
-- не повторяется, счётчик нажатий, пара указателя одним номером, такт,
-- очередь по порядку и пустая очередь.
-- Запуск: tests/run.sh (events); эталона нет — только проверки.
--
-- program() -> none; TestsFailed

use core.group
use craft.testing
use os.ui.events

program() {
    @suite = testing.test_new()
    @core = events.Core {}

    core = events.change(core, "name", 0, "Зефир", 10)
    core = events.change(core, "volume", 40, "", 11)
    core = events.change(core, "volume", 40, "", 12)
    suite = testing.test_equal(suite, "events: то же значение — не изменение", group.count(core.queue), 2)
    suite = testing.test_equal(suite, "events: два номера выдано", core.next, 2)
    @name = events.current(core, "name")
    suite = testing.test_yes(suite, "events: имя помнится", name.found)
    suite = testing.test_equal(suite, "events: текст поля", name.change.text, "Зефир")
    suite = testing.test_equal(suite, "events: время изменения", name.change.time, 10)

    core = events.change(core, "volume", 57, "", 13)
    @volume = events.current(core, "volume")
    suite = testing.test_equal(suite, "events: последнее значение", volume.change.number, 57)
    suite = testing.test_equal(suite, "events: номер последнего", volume.change.order, 2)
    suite = testing.test_equal(suite, "events: имён два", group.count(core.values), 2)

    core = events.bump(core, "run", 14)
    core = events.bump(core, "run", 15)
    @run = events.current(core, "run")
    suite = testing.test_equal(suite, "events: два нажатия — счётчик 2", run.change.number, 2)

    core = events.pair(core, "pointer.x", 100, "pointer.y", 200, 16)
    core = events.pair(core, "pointer.x", 100, "pointer.y", 210, 17)
    core = events.pair(core, "pointer.x", 100, "pointer.y", 210, 18)
    @x = events.current(core, "pointer.x")
    @y = events.current(core, "pointer.y")
    suite = testing.test_equal(suite, "events: пара одним номером", x.change.order, 5)
    suite = testing.test_equal(suite, "events: сдвиг по y — новый номер", y.change.order, 6)
    suite = testing.test_equal(suite, "events: стоящий указатель — без номера", core.next, 7)

    core = events.tick(core, 19)
    @tick = events.current(core, events.TICK)
    suite = testing.test_equal(suite, "events: такт", tick.change.number, 19)
    suite = testing.test_equal(suite, "events: в очереди всё по порядку", group.count(core.queue), 9)

    @orders = []
    @ids = []
    drum (group.count(core.queue)) {
        @taken = events.take(core)
        orders = group.add(orders, taken.change.order)
        ids = group.add(ids, taken.change.id)
        core = taken.core
    }
    suite = testing.test_equal(suite, "events: первое из очереди", group.get(ids, 0), "name")
    suite = testing.test_equal(suite, "events: номера по возрастанию", group.get(orders, 8), 7)
    suite = testing.test_equal(suite, "events: пара подряд", group.get(ids, 5), "pointer.x")
    @empty = events.take(core)
    suite = testing.test_no(suite, "events: пустая очередь", empty.found)
    suite = testing.test_equal(suite, "events: значения остаются", group.count(empty.core.values), 6)

    out testing.test_finish(suite)
}
