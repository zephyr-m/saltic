-- platform — договор платформы на Linux (rv32i, x86_64 и rv64): чего цель не
-- умеет, то отвечает ошибкой NotSupported по имени и ловится rescue;
-- файлы и вывод работают как раньше; файл больше 1 МиБ читается целиком
-- (read и read_bytes); файл /proc (размер 0, lseek в конец не умеет) — тоже
-- целиком; write_program поверх обычного файла даёт исполняемый (Q-027); часы core.time.now — в пределах суток, текст и пояса
-- io.clock — по примерам. Эталон — tests/expected/platform.txt.
--
-- program() — печатает ответы платформы

use io
use craft.testing
use io.file
use core.cpu
use core.str
use core.group
use core.bytes
use core.time
use core.process
use io.clock

skill waited() {
    @result = cpu.wait() rescue |err| { out "wait: {err}" }
    out "wait: вернулся"
}

skill firmware_piece() {
    @piece = cpu.firmware(0) rescue |err| { out "firmware: {err}" }
    out "firmware: {piece}"
}

skill called() {
    @answer = cpu.call(0, 0) rescue |err| { out "call: {err}" }
    out "call: {answer}"
}

skill missing_file() {
    @text = file.read(testing.scratch("нет-такого-файла.txt")) rescue |err| { out "файл: {err}" }
    out "файл: прочитан"
}

skill round_trip() {
    file.write(testing.scratch("platform.txt"), "привет\n")
    @text = file.read(testing.scratch("platform.txt"))
    out "запись и чтение: {text}"
}

skill big_file() {
    @text = "abcdefgh"
    drum (19) { text = str.concat(text, text) }
    file.write(testing.scratch("platform-big.txt"), text)
    @back = file.read(testing.scratch("platform-big.txt"))
    @raw = file.read_bytes(testing.scratch("platform-big.txt"))
    @size = str.bytes(back)
    @count = bytes.count(raw)
    @last = str.get(back, size - 1)
    out "большой файл: {size} байт, read_bytes {count}, последняя буква {last}"
}

skill proc_file() {
    @status = file.read("/proc/self/status")
    @named = str.starts_with(status, "Name:")
    @maps = file.read("/proc/self/smaps")
    @lines = str.lines(maps)
    @grown = str.bytes(maps) > 4096
    @whole = str.starts_with(group.get(lines, group.count(lines) - 1), "VmFlags:")
    out "файл /proc: Name {named}, больше куска {grown}, конец VmFlags {whole}"
}

skill program_file() {
    @path = testing.scratch("platform-program.sh")
    @script = bytes.from_group([35, 33, 47, 98, 105, 110, 47, 115, 104, 10, 101, 120, 105, 116, 32, 55, 10])
    process.run(["rm", "-f", path], "", [])
    file.write_bytes(path, script)
    @before = process.run(["test", "-x", path], "", [])
    file.write_program(path, script)
    @after = process.run(["test", "-x", path], "", [])
    @code = process.run([path], "", [])
    out "write_program: до {before}, после {after}, код программы {code}"
}

skill clock_check() {
    @now = time.now()
    @inside = "вне суток"
    (now > -1) {
        (now < time.DAY_MILLISECONDS) { inside = "в сутках" }
    }
    @text = time.text(5 * time.HOUR_MILLISECONDS + 4 * 60000 + 3999)
    @back = time.text(-1000)
    @moscow = clock.zone_of("MSK-3")
    @newfoundland = clock.zone_of("<-0330>3:30")
    @berlin = clock.zone_of("CET-1CEST,M3.5.0")
    @utc = clock.zone_of("UTC0")
    out "часы: now {inside}, {text}, {back}, пояса {moscow} {newfoundland} {berlin} {utc}"
}

program() {
    io.show(waited())
    io.show(firmware_piece())
    io.show(called())
    io.show(missing_file())
    io.show(round_trip())
    io.show(big_file())
    io.show(proc_file())
    io.show(program_file())
    cpu.fence()
    io.show("fence: ok")
    io.show(clock_check())
    out none
}
