-- platform — договор платформы на Linux (rv32i, x86_64 и rv64): чего цель не
-- умеет, то отвечает ошибкой NotSupported по имени и ловится rescue;
-- файлы и вывод работают как раньше; файл больше 1 МиБ читается целиком
-- (read и read_bytes); часы core.time.now — в пределах суток, текст и пояса
-- io.clock — по примерам. Эталон — tests/expected/platform.txt.
--
-- program() — печатает ответы платформы

use io
use craft.testing
use io.file
use core.cpu
use core.str
use core.bytes
use core.time
use io.clock

skill waited() {
    @result = cpu.wait() rescue |err| { out "wait: {err}" }
    out "wait: вернулся"
}

skill firmware_piece() {
    @piece = cpu.firmware(0) rescue |err| { out "firmware: {err}" }
    out "firmware: {piece}"
}

skill called() {
    @answer = cpu.call(0, 0) rescue |err| { out "call: {err}" }
    out "call: {answer}"
}

skill missing_file() {
    @text = file.read(testing.scratch("нет-такого-файла.txt")) rescue |err| { out "файл: {err}" }
    out "файл: прочитан"
}

skill round_trip() {
    file.write(testing.scratch("platform.txt"), "привет\n")
    @text = file.read(testing.scratch("platform.txt"))
    out "запись и чтение: {text}"
}

skill big_file() {
    @text = "abcdefgh"
    drum (19) { text = str.concat(text, text) }
    file.write(testing.scratch("platform-big.txt"), text)
    @back = file.read(testing.scratch("platform-big.txt"))
    @raw = file.read_bytes(testing.scratch("platform-big.txt"))
    @size = str.bytes(back)
    @count = bytes.count(raw)
    @last = str.get(back, size - 1)
    out "большой файл: {size} байт, read_bytes {count}, последняя буква {last}"
}

skill clock_check() {
    @now = time.now()
    @inside = "вне суток"
    (now > 0 - 1) {
        (now < time.DAY_MILLISECONDS) { inside = "в сутках" }
    }
    @text = time.text(5 * time.HOUR_MILLISECONDS + 4 * 60000 + 3999)
    @back = time.text(0 - 1000)
    @moscow = clock.zone_of("MSK-3")
    @newfoundland = clock.zone_of("<-0330>3:30")
    @berlin = clock.zone_of("CET-1CEST,M3.5.0")
    @utc = clock.zone_of("UTC0")
    out "часы: now {inside}, {text}, {back}, пояса {moscow} {newfoundland} {berlin} {utc}"
}

program() {
    io.show(waited())
    io.show(firmware_piece())
    io.show(called())
    io.show(missing_file())
    io.show(round_trip())
    io.show(big_file())
    cpu.fence()
    io.show("fence: ok")
    io.show(clock_check())
    out none
}
