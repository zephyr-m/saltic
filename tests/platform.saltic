-- platform — договор платформы на Linux (rv32i и x86_64): чего цель не
-- умеет, то отвечает ошибкой NotSupported по имени и ловится rescue;
-- файлы и вывод работают как раньше; файл больше 1 МиБ читается целиком
-- (read и read_bytes). Эталон — tests/expected/platform.txt.
--
-- program() — печатает ответы платформы

use io
use io.file
use core.cpu
use core.str
use core.bytes

skill waited() {
    @result = cpu.wait() rescue |err| { out "wait: {err}" }
    out "wait: вернулся"
}

skill firmware_piece() {
    @piece = cpu.firmware(0) rescue |err| { out "firmware: {err}" }
    out "firmware: {piece}"
}

skill called() {
    @answer = cpu.call(0, 0) rescue |err| { out "call: {err}" }
    out "call: {answer}"
}

skill missing_file() {
    @text = file.read(".cache/build/tests/нет-такого-файла.txt") rescue |err| { out "файл: {err}" }
    out "файл: прочитан"
}

skill round_trip() {
    file.write(".cache/build/tests/platform.txt", "привет\n")
    @text = file.read(".cache/build/tests/platform.txt")
    out "запись и чтение: {text}"
}

skill big_file() {
    @text = "abcdefgh"
    drum (19) { text = str.concat(text, text) }
    file.write(".cache/build/tests/platform-big.txt", text)
    @back = file.read(".cache/build/tests/platform-big.txt")
    @raw = file.read_bytes(".cache/build/tests/platform-big.txt")
    @size = str.bytes(back)
    @count = bytes.count(raw)
    @last = str.get(back, size - 1)
    out "большой файл: {size} байт, read_bytes {count}, последняя буква {last}"
}

program() {
    io.show(waited())
    io.show(firmware_piece())
    io.show(called())
    io.show(missing_file())
    io.show(round_trip())
    io.show(big_file())
    cpu.fence()
    io.show("fence: ok")
    out none
}
