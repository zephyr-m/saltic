use seed
use seed.parser
use craft.testing
use craft.minifier

SOURCE = "\n\nuse   seed\n\nValue   =   Box   {\n    text   =   \"two  spaces\"\n    count = 1\n}\n\nskill   make   ( text , count )   {\n    out   Value   {\n        text = text\n        count = count\n    }\n}\n"

EXPECTED = "use seed\nValue=Box{\ntext=\"two  spaces\"\ncount=1\n}\nskill make(text,count){\nout Value{\ntext=text\ncount=count\n}\n}"

program() {
    @suite = testing.test_new()
    @compact = minifier.minify(SOURCE)
    @original = parser.parse_string(SOURCE, "original.saltic")
    @minified = parser.parse_string(compact, "minified.saltic")

    suite = testing.test_equal(suite, "минификатор: точная форма", compact, EXPECTED)
    suite = testing.test_equal(suite, "минификатор: пустой исходник", minifier.minify(""), "")
    suite = testing.test_equal(suite, "минификатор: пробелы без кода", minifier.minify("  \n\t\n  "), "")
    suite = testing.test_yes(suite, "минификатор: результат меньше", seed.str.len(compact) < seed.str.len(SOURCE))
    suite = testing.test_yes(suite, "минификатор: исходник корректен", seed.group.count(original.diagnostics) == 0)
    suite = testing.test_yes(suite, "минификатор: результат корректен", seed.group.count(minified.diagnostics) == 0)
    suite = testing.test_equal(suite, "минификатор: число узлов сохранено", seed.group.count(original.ast), seed.group.count(minified.ast))

    out testing.test_finish(suite)
}
