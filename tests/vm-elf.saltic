use seed.io.file
use seed.str
use seed.group
use seed.num
use seed.vm
use seed.vm.state

skill vm_elf_chunks(text) {
    @chunks = []
    @chunk = []
    @index = 0
    @length = str.len(text)
    drum (length) {
        chunk = group.add(chunk, str.byte(text, index))
        index = index + 1
        (group.count(chunk) == state.PAGE_SIZE) {
            chunks = group.add(chunks, chunk)
            chunk = []
        }
    }
    (group.count(chunk) > 0) { chunks = group.add(chunks, chunk) }
    out chunks
}

skill vm_elf_bytes(text) {
    @bytes = []
    @index = 0
    @length = str.len(text)
    drum (length) {
        bytes = group.add(bytes, str.byte(text, index))
        index = index + 1
    }
    out bytes
}

program(elf_path, input_path, report_path) {
    @options = state.Options {
        load_address = 4096,
        memory_size = 16777216 * 8,
        step_limit = 100000,
        program_name = "canonical",
        arguments = ["input.txt", "output.txt"],
        files = [state.File { path = "input.txt", data = vm_elf_bytes(file.read(input_path)) }]
    }
    @result = vm.run(vm_elf_chunks(file.read(elf_path)), options)
    file.write(report_path, "{result.reason}\n{result.steps}\n{result.trap}\n")
    out none
}
