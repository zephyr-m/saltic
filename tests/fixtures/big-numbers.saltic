-- big-numbers — фикстура test_native и test_rv64 (tests/run.sh): печать чисел
-- у границ 29-битного диапазона и i32; usize и address больше 2^32 (на
-- 64-битной цели — всё слово, литерал до 2^60 - 1); ожидаемый вывод зашит в
-- run.sh (BIG_NUMBERS).
--
-- program() -> none

use io
use core.i32
use core.usize
use core.address

program() {
    drum ([-268435455, 268435455, 33554432, -33554433, 100000000, 33554431, -256, 255, 4096, -4097]) {
        io.show("{beat}")
    }
    @x = 200000000
    @next = x + 1
    io.show("{next}")
    @signed = i32.from(268435455)
    io.show("{signed}")
    @size = usize.from(4294967296)
    io.show("{size}")
    @far = address.add(address.from(1099511627776), usize.from(8))
    io.show("{far}")
    @largest = usize.from(1152921504606846975)
    io.show("{largest}")
    out none
}
