-- big-numbers — фикстура test_native и test_rv64 (tests/run.sh): печать чисел
-- у границ 29-битного диапазона и i32; usize и address больше 2^32 (на
-- 64-битной цели — всё слово, литерал до 2^60 - 1); ожидаемый вывод зашит в
-- run.sh (BIG_NUMBERS).
--
-- program() -> none

use io
use core.i32
use core.usize
use core.address

program() {
    io.show(-268435455)
    io.show(268435455)
    io.show(33554432)
    io.show(-33554433)
    io.show(100000000)
    io.show(33554431)
    io.show(-256)
    io.show(255)
    io.show(4096)
    io.show(-4097)
    @x = 200000000
    io.show(x + 1)
    io.show(i32.from(268435455))
    io.show(usize.from(4294967296))
    io.show(address.add(address.from(1099511627776), usize.from(8)))
    io.show(usize.from(1152921504606846975))
    out none
}
