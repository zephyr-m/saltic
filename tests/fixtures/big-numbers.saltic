-- big-numbers — фикстура test_native (tests/run.sh): печать чисел у границ
-- 29-битного диапазона и i32; ожидаемый вывод зашит в run.sh.
--
-- program() -> none

use io

program() {
    io.show(-268435455)
    io.show(268435455)
    io.show(33554432)
    io.show(-33554433)
    io.show(100000000)
    io.show(33554431)
    io.show(-256)
    io.show(255)
    io.show(4096)
    io.show(-4097)
    @x = 200000000
    io.show(x + 1)
    io.show(i32(268435455))
    out none
}
