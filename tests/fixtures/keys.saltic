-- keys — фикстура test_native (tests/run.sh): читает нажатия io.key()
-- до «q» или конца ввода и печатает их в скобках; ожидаемый вывод зашит
-- в run.sh.
--
-- program() -> none

use core.str
use io

program() {
    @line = ""
    drum (100) {
        @key = io.key()
        (key == "q") { leave }
        (key == "") { leave }
        line = "{line}[{key}]"
    }
    io.show(line)
    out none
}
