-- testing-failure — фикстура test_machine (tests/run.sh): один намеренно
-- проваленный test_equal; программа должна завершиться ошибкой
-- TestsFailed и напечатать итог «пройдено 0, провалено 1».
--
-- program() -> TestsFailed

use craft.testing

program() {
    @suite = testing.test_new()
    suite = testing.test_equal(suite, "контроль провала", 1, 2)
    out testing.test_finish(suite)
}
