-- memory-type — фикстура с намеренной ошибкой типов: переменной u8 от
-- mem.load8 присваивается u16. soul/seed/tests/contract.saltic ждёт от
-- чекера ровно одну диагностику type_mismatch. Не собирается.
--
-- program() -> none

use core.mem
use core.u16
use core.u32
use core.address
use core.usize

program() {
    @memory = address.from(u32.from(4096))
    @byte = mem.load8(memory, usize.from(0))
    byte = u16.from(1)
    out none
}
