-- deep-recursion — фикстура test_native (tests/run.sh): рекурсия на
-- 280000 уровней; на x86-64 программа должна упасть от переполнения
-- стека, а не «вынырнуть».
--
-- dive(depth, limit) -> limit, рекурсией
-- program() -> none

use io

skill dive(depth, limit) {
    (depth == limit) { out depth }
    @next = dive(depth + 1, limit)
    out next
}

program() {
    @reached = dive(0, 280000)
    io.show("вынырнул с глубины {reached}")
    out none
}
