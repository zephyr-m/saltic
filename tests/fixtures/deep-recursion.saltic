-- deep-recursion — фикстура test_native (tests/run): рекурсия на
-- 280000 уровней; на x86-64 у программы свой стек (rt_platform_stack, 1 ГБ),
-- поэтому она проходит и «выныривает» с верной глубиной.
--
-- dive(depth, limit) -> limit, рекурсией
-- program() -> none

use io

skill dive(depth, limit) {
    (depth == limit) { out depth }
    @next = dive(depth + 1, limit)
    out next
}

program() {
    @reached = dive(0, 280000)
    io.show("вынырнул с глубины {reached}")
    out none
}
