-- needs-args — фикстура test_platform (tests/run.sh): program с двумя
-- параметрами без аргументов печатает «нужно 2 аргументов» и выходит с
-- кодом 64; с аргументами — печатает их.
--
-- program(first, second) — печатает аргументы

use io

program(first, second) {
    io.show("{first} {second}")
    out none
}
