use seed.io { show }
use seed.str
use seed.group { count }
use seed.io.file { read }

program() {
    show("длина: ", str.len("spider"))
    show("пусто: ", str.is_empty(""))
    show("строк: ", count(str.lines("a\nb\nc")))
    show("файл прочитан: ", str.len(read("tests/fixtures/input.txt")) > 0)
    out none
}
