-- imports — фикстура test_native (tests/run.sh): подключение core.str,
-- core.group и io.file, чтение tests/fixtures/input.txt и ошибка
-- ByteOutsideRange от file.write_bytes; ожидаемый вывод зашит в run.sh.
--
-- program() -> none

use io
use core.str
use core.group
use io.file

program() {
    io.show("длина: ", str.len("spider"))
    io.show("пусто: ", str.is_empty(""))
    io.show("строк: ", group.count(str.lines("a\nb\nc")))
    io.show("файл прочитан: ", str.len(file.read("tests/fixtures/input.txt")) > 0)
    @written = file.write_bytes("/dev/null", [1, 259]) rescue |err| {
        io.show("байт 259: ", err)
        out none
    }
    out none
}
