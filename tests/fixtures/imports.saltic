-- imports — фикстура test_native (tests/run.sh): подключение core.str,
-- core.group и io.file, чтение tests/fixtures/input.txt и ошибка
-- ByteOutsideRange от bytes.from_group для file.write_bytes; ожидаемый вывод зашит в run.sh.
--
-- program() -> none

use io
use core.str
use core.group
use io.file
use core.bytes

program() {
    @shown_1 = str.bytes("spider")
    io.show("длина: {shown_1}")
    @shown_2 = str.is_empty("")
    io.show("пусто: {shown_2}")
    @shown_3 = group.count(str.lines("a\nb\nc"))
    io.show("строк: {shown_3}")
    @shown_4 = str.bytes(file.read("tests/fixtures/input.txt")) > 0
    io.show("файл прочитан: {shown_4}")
    @written = file.write_bytes("/dev/null", bytes.from_group([1, 259])) rescue |err| {
        io.show("байт 259: {err}")
        out none
    }
    out none
}
