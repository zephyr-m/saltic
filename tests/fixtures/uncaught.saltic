-- uncaught — фикстура test_platform (tests/run.sh): непойманная ошибка
-- доходит до входа программы, который печатает «ошибка: Boom» и выходит
-- с кодом 1.
--
-- program() — поднимает error.Boom

use io

skill explode() {
    out error.Boom
}

program() {
    io.show("до ошибки")
    @value = explode()
    io.show("после ошибки: ", value)
    out none
}
