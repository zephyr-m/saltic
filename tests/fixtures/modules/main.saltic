use io
use tests.fixtures.modules.nested.greeting

program() {
    io.show(greeting.module_greeting("short"))
    io.show(greeting.GreetingPrefix, "constant")
    io.show(greeting.module_mood() == greeting.Mood.HAPPY)

    @short_box = greeting.Greeter { prefix = "short box: " }
    io.show(short_box.message("ok"))
    out none
}
