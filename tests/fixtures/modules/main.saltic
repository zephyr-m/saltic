-- main — фикстура test_modules (tests/run.sh): главная программа с
-- вложенными модулями greeting и shape — навыки, константа, enum и Box
-- соседа через короткое имя; свои start, reply и Point не путаются с
-- одноимёнными в shape. Эталон вывода — tests/expected/modules.txt;
-- чекер не должен дать ни одной диагностики.
--
-- Point — Box { x }
-- start() -> "nam"; reply() -> 1
-- program() -> none

use io
use core.str
use tests.fixtures.modules.nested.greeting
use tests.fixtures.modules.nested.shape

Point = Box {
    x = 0
}

skill start() {
    out str.slice("names", 0, 3)
}

skill reply() {
    out 1
}

program() {
    io.show(greeting.module_greeting("short"))
    io.show(greeting.GreetingPrefix, "constant")
    io.show(greeting.module_mood() == greeting.Mood.HAPPY)

    @short_box = greeting.Greeter { prefix = "short box: " }
    io.show(short_box.message("ok"))

    @point = Point { x = 5 }
    io.show(start(), " ", reply(), " ", point.x, " ", shape.make(3))
    out none
}
