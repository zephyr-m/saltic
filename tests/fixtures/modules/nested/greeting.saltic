-- greeting — вложенный модуль фикстуры test_modules: константа, enum,
-- Box с методом и навыки, которые main зовёт через greeting.…
--
-- GreetingPrefix — константа "hello, "
-- Mood — enum HAPPY, QUIET
-- Greeter — Box { prefix, mood } с методом message(name) -> prefix + name
-- greeting_text / module_greeting(name) -> "hello, " + name
-- module_mood() -> Mood.HAPPY

use core.str

GreetingPrefix = "hello, "

Mood = enum {
    HAPPY,
    QUIET
}

Greeter = Box {
    prefix = GreetingPrefix,
    mood = Mood.HAPPY

    skill message(name) {
        out str.add(prefix, name)
    }
}

skill greeting_text(name) {
    out str.add(GreetingPrefix, name)
}

skill module_greeting(name) {
    out greeting_text(name)
}

skill module_mood() {
    out Mood.HAPPY
}
