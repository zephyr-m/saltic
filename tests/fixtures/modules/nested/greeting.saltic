use seed

GreetingPrefix = "hello, "

Mood = enum {
    HAPPY,
    QUIET,
}

Greeter = Box {
    prefix = GreetingPrefix
    mood = Mood.HAPPY

    skill message(name) {
        out seed.str.add(prefix, name)
    }
}

skill greeting_text(name) {
    out seed.str.add(GreetingPrefix, name)
}

skill module_greeting(name) {
    out greeting_text(name)
}

skill module_mood() {
    out Mood.HAPPY
}
