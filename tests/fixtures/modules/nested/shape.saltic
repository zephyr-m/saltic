-- shape — модуль с теми же именами, что у главной программы: локальные
-- start и reply и свой Box Point. Имена главной программы сюда не видны.
--
-- Point — Box с полем value
-- make(amount) -> число: (amount + 1) * 2 через Point

Point = Box {
    value = 0
}

skill make(amount) {
    @reply = amount + 1
    @start = reply * 2
    @point = Point { value = start }
    out point.value
}
