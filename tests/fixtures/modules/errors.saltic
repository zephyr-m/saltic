-- errors — фикстура test_modules (tests/run.sh) с намеренными ошибками чекера:
-- навык соседа без префикса, несуществующий экспорт, неизвестное пространство
-- имён, длинные пути к Box и константе. Эталон — tests/expected/module-errors.txt,
-- номера строк в нём считают и эту шапку.
--
-- broken_module_access / missing_module_export / missing_namespace /
--     long_box_path / long_constant_path() — по одной ошибке на навык
-- program() -> none

use io
use tests.fixtures.modules.nested.greeting

skill broken_module_access() {
    @message = module_greeting("hidden")
    out message
}

skill missing_module_export() {
    @message = greeting.missing("hidden")
    out message
}

skill missing_namespace() {
    @message = ghost.missing("hidden")
    out message
}

skill long_box_path() {
    out tests.fixtures.modules.nested.greeting.Greeter { prefix = "long: " }
}

skill long_constant_path() {
    out tests.fixtures.modules.nested.greeting.GreetingPrefix
}

program() {
    io.show(broken_module_access())
    out none
}
