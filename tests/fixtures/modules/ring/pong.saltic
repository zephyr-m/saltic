-- pong — вторая половина розыгрыша: отбивает мяч обратно в ping.
--
-- Pong — Box {}; hit(left) -> строка розыгрыша: «pong», дальше отдаёт ping

use tests.fixtures.modules.ring.ping

Pong = Box {
    skill hit(left) {
        (left == 0) {
            out "pong"
        }
        @other = Ping {}
        @back = other.hit(left - 1)
        out "pong {back}"
    }
}
