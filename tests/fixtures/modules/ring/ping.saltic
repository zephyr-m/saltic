-- ping — половина розыгрыша по кругу: ping и pong знают друг друга (use по
-- кругу, решение автора 21.11.2026) и перекидывают мяч, пока удары не кончатся.
--
-- Ping — Box {}; hit(left) -> строка розыгрыша: «ping», дальше отдаёт pong

use tests.fixtures.modules.ring.pong

Ping = Box {
    skill hit(left) {
        (left == 0) {
            out "ping"
        }
        @other = Pong {}
        @back = other.hit(left - 1)
        out "ping {back}"
    }
}
