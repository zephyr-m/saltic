-- rva23 — сверка кодировщика RVA23 с GNU-ассемблером: для каждой команды
-- таблицы печатает строки «текст ассемблера<TAB>байты hex» — с базовыми
-- операндами и с псевдослучайными допустимыми; workbench/rva23/verify.py
-- собирает тексты ассемблером и сравнивает байты.
--
-- next_seed(seed) -> следующее псевдослучайное число
-- sample(kind, seed) -> допустимое значение вида
-- hex(bytes) -> текст байтов, старший первый
-- program() -> none

use io
use core.str
use core.num
use core.group
use selfhost.compiler.backend.rv64.machine.codec

skill next_seed(seed) {
    out num.mod(seed * 1103 + 12345, 65521)
}

skill sample(kind, seed) {
    @range = codec.limits(kind)
    @least = group.get(range, 0)
    @step = group.get(range, 2)
    @span = (group.get(range, 1) - least) / step + 1
    @value = least + num.mod(seed, span) * step
    drum (codec.forbidden(kind)) {
        (value == beat) { value = value + step }
    }
    (value > group.get(range, 1)) { value = least }
    drum (codec.forbidden(kind)) {
        (value == beat) { value = value + step }
    }
    out value
}

skill hex(bytes) {
    @text = ""
    @digits = "0123456789abcdef"
    drum (group.count(bytes)) {
        @b = group.get(bytes, group.count(bytes) - 1 - beat)
        @high = str.get(digits, b / 16)
        @low = str.get(digits, num.mod(b, 16))
        text = "{text}{high}{low}"
    }
    out text
}

program() {
    @seed = 7
    drum (codec.count()) {
        @name = codec.name_at(beat)
        @form = codec.form_at(beat)
        @base = []
        drum (form) { base = group.add(base, group.get(beat, 1)) }
        @encoded = codec.encode(name, base)
        @line = codec.render(name, base)
        @bytes = hex(encoded.bytes)
        io.show("{line}\t{bytes}")
        drum (3) {
            @values = []
            drum (form) {
                seed = next_seed(seed)
                values = group.add(values, sample(group.get(beat, 0), seed))
            }
            @random = codec.encode(name, values)
            @text = codec.render(name, values)
            @random_bytes = hex(random.bytes)
            io.show("{text}\t{random_bytes}")
        }
    }
}
