-- ttf — проверка шрифтов TTF (os/fonts/ttf, os/fonts/raster) на Inter:
-- таблицы, коды букв, ширины, контуры простой и составной буквы, маска со
-- сглаживанием; строка «Привет, Saltic · 67 404.75» пишется картинкой PGM в
-- .cache/build/ttf-line.pgm — её смотрят глазами.
--
-- program() -> none; TestsFailed

use core.str
use core.group
use core.bytes
use io.file
use craft.testing
use os.fonts.ttf
use os.fonts.raster

FONT = "os/fonts/inter/Inter-Regular.ttf"
PICTURE = ".cache/build/ttf-line.pgm"

program() {
    @suite = testing.test_new()
    @font = ttf.open(ttf.from_bytes(file.read_bytes(FONT)))
    suite = testing.test_equal(suite, "ttf: единиц на кегль у Inter", font.units, 2048)
    suite = testing.test_yes(suite, "ttf: букв больше тысячи", font.glyphs > 1000)
    @a = ttf.glyph_of(font, 65)
    @zhe = ttf.glyph_of(font, 1046)
    suite = testing.test_yes(suite, "ttf: у A и Ж есть буквы", a > 0)
    suite = testing.test_yes(suite, "ttf: кириллица есть", zhe > 0)
    suite = testing.test_equal(suite, "ttf: неизвестный код — буква 0", ttf.glyph_of(font, 2160), 0)
    suite = testing.test_yes(suite, "ttf: ширина A положительная", ttf.advance(font, a) > 0)
    suite = testing.test_equal(suite, "ttf: у O два контура", group.count(ttf.outline(font, ttf.glyph_of(font, 79))), 2)
    suite = testing.test_yes(suite, "ttf: у Й есть контуры (составная)", group.count(ttf.outline(font, ttf.glyph_of(font, 1049))) > 1)
    @glyph = raster.render(font, 72, 32)
    suite = testing.test_yes(suite, "растр: H 32 пикселя — выше 20 точек", glyph.height > 20)
    @solid = 0
    @smooth = 0
    drum (bytes.count(glyph.mask)) {
        @value = bytes.get(glyph.mask, beat)
        (value == 255) { solid = solid + 1 }
        (value > 0) { (value < 255) { smooth = smooth + 1 } }
    }
    suite = testing.test_yes(suite, "растр: у H есть сплошные точки", solid > 0)
    suite = testing.test_yes(suite, "растр: у H есть сглаженные края", smooth > 0)
    @line = raster.line_image(font, "Привет, Saltic · 67 404.75", 32)
    @head = "P5\n{line.width} {line.height}\n255\n"
    @header = []
    drum (str.bytes(head)) { header = group.add(header, str.byte(head, beat)) }
    @picture = bytes.new(group.count(header) + bytes.count(line.pixels))
    drum (group.count(header)) { bytes.set(picture, beat, group.get(header, beat)) }
    drum (bytes.count(line.pixels)) { bytes.set(picture, group.count(header) + beat, 255 - bytes.get(line.pixels, beat)) }
    file.write_bytes(PICTURE, picture)
    out testing.test_finish(suite)
}
