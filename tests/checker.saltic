-- checker — программа-обёртка над selfhost.checker для tests/run.sh:
-- загружает файл с модулями и печатает диагностики чекера по одной на
-- строку в виде «код|строка|столбец|сообщение». Эталоны — в
-- soul/canonical/expected/errors и tests/expected/module-errors.txt.
--
-- program(path) -> none; ParseFailed, если не разобрался

use core.group
use io
use selfhost.parser
use selfhost.checker

program(path) {
    @loaded = parser.load_file_loc(path, ".")
    (group.count(loaded.diagnostics) > 0) {
        out error.ParseFailed
    }
    @result = checker.check(loaded.ast)
    @index = 0
    @count = group.count(result.diagnostics)
    drum (count) {
        @item = group.get(result.diagnostics, index)
        io.show(item.code, "|", item.line, "|", item.col, "|", item.message)
        index = index + 1
    }
    out none
}
