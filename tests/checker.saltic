use seed
use seed.parser
use seed.checker

program(path) {
    @loaded = parser.load_file_loc(path, ".")
    (seed.group.count(loaded.diagnostics) > 0) {
        out error.ParseFailed
    }
    @result = checker.check(loaded.ast)
    @index = 0
    @count = seed.group.count(result.diagnostics)
    drum (count) {
        @item = seed.group.item(result.diagnostics, index)
        seed.io.show(item.code, "|", item.line, "|", item.col, "|", item.message)
        index = index + 1
    }
    out none
}
