-- checker — программа-обёртка над selfhost.checker для tests/run.sh:
-- загружает файл с модулями и печатает диагностики по одной на строку в
-- виде «код|строка|столбец|сообщение». Не разобрался — печатает диагностики
-- парсера и выходит с ParseFailed; разобрался — диагностики чекера.
-- Эталоны — в soul/canonical/expected/errors и tests/expected/module-errors.txt.
--
-- show(items) — печатает группу диагностик, по одной на строку
-- program(path) -> none; ParseFailed, если не разобрался

use core.group
use io
use selfhost.parser
use selfhost.checker

skill show(items) {
    @index = 0
    @count = group.count(items)
    drum (count) {
        @item = group.get(items, index)
        io.show(item.code, "|", item.line, "|", item.col, "|", item.message)
        index = index + 1
    }
    out none
}

program(path) {
    @loaded = parser.load_file_loc(path, ".")
    (group.count(loaded.diagnostics) > 0) {
        show(loaded.diagnostics)
        out error.ParseFailed
    }
    @result = checker.check(loaded.ast)
    show(result.diagnostics)
    out none
}
