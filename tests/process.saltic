-- process — core.process на Linux (rv32i, x86_64, rv64): run с кодом выхода,
-- capture с выводом, lines построчно и код после конца, папка ребёнка
-- параметром, поиск по PATH и ProgramNotFound, окружение и env ребёнка
-- (добавить и заменить переменную), io.file.list.
-- Эталон — tests/expected/process.txt.
--
-- program() -> none

use io
use io.file
use core.str
use core.group
use core.process

skill has_path(entries) {
    drum (entries) {
        (str.starts_with(beat, "PATH=") == yes) { out yes }
    }
    out no
}

skill contains(names, wanted) {
    drum (names) {
        (beat == wanted) { out yes }
    }
    out no
}

program() {
    @shown_1 = process.run(["true"], "", [])
    io.show("run true: {shown_1}")
    @shown_2 = process.run(["false"], "", [])
    io.show("run false: {shown_2}")
    @shown_3 = process.run(["sh", "-c", "exit 7"], "", [])
    io.show("run exit 7: {shown_3}")
    @captured = process.capture(["echo", "привет, мир"], "", [])
    io.show("capture: {captured.output}код {captured.code}")
    @folder = process.capture(["sh", "-c", "pwd"], "/tmp", [])
    io.show("folder: {folder.output}")
    @lines = process.lines(["printf", "один\\nдва\\nтри"], "", [])
    always {
        @line = lines.next() rescue |err| {
            @shown_4 = lines.code()
            io.show("lines: {err}, код {shown_4}")
            leave
        }
        io.show("line: {line}")
    }
    @missing = process.run(["нет-такой-программы-saltic"], "", []) rescue |err| {
        io.show("missing: {err}")
        -1
    }
    @by_path = process.run(["/bin/sh", "-c", "exit 3"], "", [])
    io.show("by path: {by_path}")
    @shown_5 = has_path(process.environment())
    io.show("environment has PATH: {shown_5}")
    @given = process.capture(["sh", "-c", "echo $SALTIC_PROCESS_X"], "", ["SALTIC_PROCESS_X=привет"])
    io.show("env added: {given.output}")
    @replaced = process.capture(["sh", "-c", "echo $HOME"], "", ["HOME=/saltic-home"])
    io.show("env replaced: {replaced.output}")
    @homes = 0
    drum (process.environment_with(["HOME=/saltic-home"])) {
        (str.starts_with(beat, "HOME=") == yes) { homes = homes + 1 }
    }
    io.show("env HOME entries: {homes}")
    @names = file.list("tests/fixtures/modules")
    @shown_6 = contains(names, "main.saltic")
    @shown_7 = contains(names, ".")
    io.show("list has main.saltic: {shown_6}, dots: {shown_7}")
    @no_folder = file.list("tests/fixtures/нет-такой-папки") rescue |err| {
        io.show("list missing: {err}")
        []
    }
    out none
}
