use seed
use craft.testing
use os.apps.tasks
use os.drivers.graphics
use os.ui.jtml

program() {
    @suite = testing.test_new()
    @model = tasks.new()
    suite = testing.test_equal(suite, "tasks: пустой список", seed.group.count(model.tasks), 0)

    model = tasks.add(model, "")
    suite = testing.test_equal(suite, "tasks: пустая задача не добавлена", seed.group.count(model.tasks), 0)

    model = tasks.add(model, "write Saltic")
    model = tasks.add(model, "touch bare metal")
    suite = testing.test_equal(suite, "tasks: две задачи добавлены", seed.group.count(model.tasks), 2)
    suite = testing.test_equal(suite, "tasks: новая задача выбрана", model.selected, 2)
    suite = testing.test_equal(suite, "tasks: обе задачи активны", tasks.active_count(model), 2)

    model = tasks.activate(model, tasks.target_id(1))
    suite = testing.test_equal(suite, "tasks: первый клик выбирает", model.selected, 1)
    model = tasks.activate(model, tasks.target_id(1))
    suite = testing.test_equal(suite, "tasks: повторный клик завершает", tasks.done_count(model), 1)

    model = tasks.activate(model, tasks.FILTER_DONE_ID)
    suite = testing.test_equal(suite, "tasks: фильтр DONE", model.filter, tasks.Filter.DONE)
    suite = testing.test_equal(suite, "tasks: видна завершённая задача", tasks.visible_count(model), 1)

    model = tasks.activate(model, tasks.ACTION_TOGGLE_ID)
    suite = testing.test_equal(suite, "tasks: действие возвращает задачу", tasks.active_count(model), 2)
    suite = testing.test_equal(suite, "tasks: DONE стал пустым", tasks.visible_count(model), 0)

    model = tasks.activate(model, tasks.ACTION_DELETE_ID)
    suite = testing.test_equal(suite, "tasks: выбранная задача удалена", seed.group.count(model.tasks), 1)
    suite = testing.test_equal(suite, "tasks: выбор очищен", model.selected, 0)

    @screen = graphics.Screen { width = 1280 height = 720 }
    @runtime = jtml.mount(screen, tasks.view(model, "draft"))
    @draft = jtml.value(runtime, "command")
    suite = testing.test_equal(suite, "tasks: черновик попал в поле", draft.value, "draft")
    suite = testing.test_equal(suite, "tasks: фильтры кликабельны", seed.group.count(runtime.targets), 3)

    @limited = tasks.new()
    @index = 0
    drum (10) {
        limited = tasks.add(limited, seed.num.text(index))
        index = index + 1
    }
    suite = testing.test_equal(suite, "tasks: лимит задач", seed.group.count(limited.tasks), tasks.TASK_LIMIT)
    out testing.test_finish(suite)
}
