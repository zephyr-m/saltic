-- tasks — тест os.apps.tasks: модель списка задач (добавление, выбор,
-- завершение, фильтр, удаление, лимит) и её вид через jtml.mount.
-- Запуск: tests/run.sh (test_tasks); эталона нет — только проверки.
--
-- program() -> none; TestsFailed

use core.group
use core.num
use craft.testing
use soft.work.todo
use tarantul.ink.graphics
use tarantul.uiengine.jtml

program() {
    @suite = testing.test_new()
    @model = todo.new()
    suite = testing.test_equal(suite, "tasks: пустой список", group.count(model.tasks), 0)

    model = todo.add(model, "")
    suite = testing.test_equal(suite, "tasks: пустая задача не добавлена", group.count(model.tasks), 0)

    model = todo.add(model, "write Saltic")
    model = todo.add(model, "touch bare metal")
    suite = testing.test_equal(suite, "tasks: две задачи добавлены", group.count(model.tasks), 2)
    suite = testing.test_equal(suite, "tasks: новая задача выбрана", model.selected, 2)
    suite = testing.test_equal(suite, "tasks: обе задачи активны", todo.active_count(model), 2)

    model = todo.activate(model, todo.target_id(1))
    suite = testing.test_equal(suite, "tasks: первый клик выбирает", model.selected, 1)
    model = todo.activate(model, todo.target_id(1))
    suite = testing.test_equal(suite, "tasks: повторный клик завершает", todo.done_count(model), 1)

    model = todo.activate(model, todo.FILTER_DONE_ID)
    suite = testing.test_equal(suite, "tasks: фильтр DONE", model.filter, todo.Filter.DONE)
    suite = testing.test_equal(suite, "tasks: видна завершённая задача", todo.visible_count(model), 1)

    model = todo.activate(model, todo.ACTION_TOGGLE_ID)
    suite = testing.test_equal(suite, "tasks: действие возвращает задачу", todo.active_count(model), 2)
    suite = testing.test_equal(suite, "tasks: DONE стал пустым", todo.visible_count(model), 0)

    model = todo.activate(model, todo.ACTION_DELETE_ID)
    suite = testing.test_equal(suite, "tasks: выбранная задача удалена", group.count(model.tasks), 1)
    suite = testing.test_equal(suite, "tasks: выбор очищен", model.selected, 0)

    @screen = graphics.Screen { width = 1280, height = 720 }
    @runtime = jtml.mount(screen, todo.view(model, "draft"))
    @draft = jtml.value(runtime, "command")
    suite = testing.test_equal(suite, "tasks: черновик попал в поле", draft.value, "draft")
    suite = testing.test_equal(suite, "tasks: фильтры кликабельны", group.count(runtime.targets), 3)

    @limited = todo.new()
    drum (10) {
        limited = todo.add(limited, num.text(beat))
    }
    suite = testing.test_equal(suite, "tasks: лимит задач", group.count(limited.tasks), todo.TASK_LIMIT)
    out testing.test_finish(suite)
}
