-- jtml — тест registry.libraries.uiengine.jtml на экране 1280×720: дерево рамок и текста,
-- раскладка поля, фокус по клику, ввод и удаление знаков; попутно —
-- размеры заголовков в os.drivers.font и шкала указателя pointer; атомы из
-- текста JTML (jtml/read): ползунок, Tab, стрелка, щелчок, чужой тег; слои:
-- каждый на всю площадь, поле внутри слоя, ошибки разбора слоёв; текст:
-- размер, жирность, обрезка и ошибки их значений; стили по имени, justify,
-- align, padding по сторонам и ошибки; жители закрытой библиотеки: кнопка,
-- слот детей у карточки, чужой параметр и чужое имя; кегль числом, интервал,
-- переливание, мягкая и внутренняя тень, значок box (icon, ink), углы (corners);
-- box с id — цель щелчка по всей площади, текст с id внутри — раньше него;
-- свободное место box (at): на своём месте, вне раскладки, щелчок по нему.
-- Запуск: tests/run.sh (test_jtml); эталона нет — только проверки.
--
-- program() -> none; TestsFailed

use core.group
use craft.testing
use os.drivers.graphics
use os.drivers.font
use os.drivers.keymap_us
use os.drivers.pointer
use registry.libraries.uiengine.jtml
use registry.libraries.uiengine.jtml.atom
use registry.libraries.uiengine.jtml.read
use registry.libraries.uiengine.jtml.slider
use registry.libraries.uiengine.jtml.measure

LAYERED = "\{\"box\": \{\"width\": 300, \"height\": 40, \"padding\": 5, \"layers\": [\{\"layer\": \{\"name\": \"фон\", \"children\": [\{\"text\": \{\"value\": \"сетка\"\}\}]\}\}, \{\"layer\": \{\"name\": \"поле\", \"children\": [\{\"field\": \{\"id\": \"price\", \"value\": \"67\"\}\}]\}\}]\}\}"
ROWS = "\{\"box\": \{\"gap\": 0, \"children\": [\{\"box\": \{\"id\": \"line-1\", \"flow\": \"row\", \"height\": 20, \"children\": [\{\"text\": \{\"id\": \"mark\", \"value\": \"•\"\}\}, \{\"text\": \{\"value\": \"первая\"\}\}]\}\}, \{\"box\": \{\"id\": \"line-2\", \"flow\": \"row\", \"height\": 20, \"children\": [\{\"text\": \{\"value\": \"вторая\"\}\}]\}\}]\}\}"
CANVAS = "\{\"box\": \{\"gap\": 0, \"padding\": 10, \"children\": [\{\"text\": \{\"value\": \"холст\"\}\}, \{\"box\": \{\"id\": \"node-1\", \"at\": [200, 300], \"width\": 120, \"height\": 60\}\}, \{\"box\": \{\"id\": \"node-2\", \"at\": [5, 0], \"width\": 30, \"height\": 30\}\}]\}\}"
PAGE = "\{\"box\": \{\"flow\": \"row\", \"children\": [\{\"text\": \{\"value\": \"Громкость\"\}\}, \{\"slider\": \{\"id\": \"volume\", \"value\": 40, \"min\": 0, \"max\": 100\}\}, \{\"field\": \{\"id\": \"name\", \"value\": \"Зефир\"\}\}]\}\}"

program() {
    @suite = testing.test_new()
    @screen = graphics.Screen { width = 1280, height = 720 }
    @header = atom.frame(atom.Flow.ROW, 0, 68, 0, 12, 16, 2, [
        atom.text("## SALTIC"),
        atom.space(1),
        atom.text("CELL 01  ALIVE")
    ])
    @body = atom.frame(atom.Flow.ROW, 0, 0, 1, 0, 16, 0, [
        atom.frame(atom.Flow.COLUMN, 224, 0, 0, 16, 20, 2, [
            atom.text("CELLS")
        ]),
        atom.frame(atom.Flow.COLUMN, 0, 0, 1, 24, 16, 2, [
            atom.label("## CELL 01 IS ALIVE", atom.Align.CENTER)
        ])
    ])
    @command = atom.frame(atom.Flow.ROW, 0, 87, 0, 8, 12, 2, [
        atom.text("## >"),
        atom.field_grow("command", ""),
        atom.text("PULSE 000001")
    ])
    @view = atom.frame(atom.Flow.COLUMN, 0, 0, 0, 32, 16, 0, [
        header,
        body,
        command
    ])
    @runtime = jtml.mount(screen, view)

    suite = testing.test_equal(suite, "JTML: ширина платформы", runtime.width, 1280)
    suite = testing.test_equal(suite, "JTML: высота платформы", runtime.height, 720)
    suite = testing.test_equal(suite, "JTML: одно поле", group.count(runtime.fields), 1)
    suite = testing.test_equal(suite, "JTML: командная строка активна", runtime.focused, "command")

    @slot = jtml.find_field(runtime, "command")
    suite = testing.test_yes(suite, "JTML: поле найдено", slot.found)
    suite = testing.test_equal(suite, "JTML: поле выровнено по X", slot.slot.field.x, 70)
    suite = testing.test_equal(suite, "JTML: поле выровнено по Y", slot.slot.field.y, 623)
    suite = testing.test_equal(suite, "JTML: поле заняло свободную ширину", slot.slot.field.width, 1060)

    suite = testing.test_equal(suite, "MD: H1 имеет родную ширину", font.font_text_width("# A"), 32)
    suite = testing.test_equal(suite, "MD: H2 имеет родную высоту", font.font_text_height("## A"), 32)
    suite = testing.test_equal(suite, "MD: H3 имеет родную высоту", font.font_text_height("### A"), 24)
    suite = testing.test_equal(suite, "MD: H4 имеет родную высоту", font.font_text_height("#### A"), 16)
    suite = testing.test_equal(suite, "MD: H5 имеет родную высоту", font.font_text_height("##### A"), 12)
    suite = testing.test_equal(suite, "MD: H6 имеет родную высоту", font.font_text_height("###### A"), 8)
    suite = testing.test_equal(suite, "MD: обычный текст компактен", font.font_text_width("SALTIC"), 48)
    suite = testing.test_equal(suite, "MD: префикс не входит в ширину", font.font_text_width("###### A"), 5)

    @clicked = jtml.focus_at(runtime, 100, 630)
    suite = testing.test_equal(suite, "JTML: клик фокусирует поле", clicked.focused, "command")
    clicked = jtml.focus_at(clicked, 10, 10)
    suite = testing.test_equal(suite, "JTML: клик мимо сохраняет фокус", clicked.focused, "command")
    suite = testing.test_equal(suite, "мышь: левая граница", pointer.pointer_scale(0, 1280), 0)
    suite = testing.test_equal(suite, "мышь: правая граница", pointer.pointer_scale(32767, 1280), 1279)

    @typed = jtml.key(runtime, 30, no)
    typed = jtml.key(typed, 30, yes)
    @typed_command = jtml.value(typed, "command")
    suite = testing.test_equal(suite, "JTML: ввод идёт в активное поле", typed_command.value, "aA")

    @original_command = jtml.value(runtime, "command")
    suite = testing.test_equal(suite, "JTML: исходное дерево не изменилось", original_command.value, "")

    typed = jtml.key(typed, keymap_us.KEY_BACKSPACE, no)
    typed_command = jtml.value(typed, "command")
    suite = testing.test_equal(suite, "JTML: удаление символа", typed_command.value, "a")

    @absent = jtml.value(runtime, "absent")
    suite = testing.test_no(suite, "JTML: отсутствующее поле явно отмечено", absent.found)

    @page = read.page(PAGE)
    @ui = jtml.mount(screen, page)
    suite = testing.test_equal(suite, "атомы: один ползунок", group.count(ui.sliders), 1)
    suite = testing.test_equal(suite, "атомы: фокус сначала на поле", ui.focused, "name")
    @volume = jtml.value(ui, "volume")
    suite = testing.test_equal(suite, "атомы: ползунок из текста", volume.value, "40")
    @tabbed = jtml.key(ui, jtml.KEY_TAB, no)
    suite = testing.test_equal(suite, "атомы: Tab — на ползунок", tabbed.focused, "volume")
    @louder = jtml.value(jtml.key(tabbed, slider.KEY_RIGHT, no), "volume")
    suite = testing.test_equal(suite, "атомы: стрелка вправо — шаг", louder.value, "45")
    @knob = jtml.find_slider(ui, "volume")
    @clicked_end = jtml.value(jtml.focus_at(ui, knob.slot.x + knob.slot.width - 1, knob.slot.y + 4), "volume")
    suite = testing.test_equal(suite, "атомы: щелчок у конца дорожки", clicked_end.value, "99")
    suite = testing.test_equal(suite, "атомы: чужой тег — не житель библиотеки", refused("\{\"кнопочка\": \{\}\}"), "UnknownComponent")

    @layered = read.page(LAYERED)
    suite = testing.test_equal(suite, "слои: два слоя по порядку", group.count(layered.layers), 2)
    @bottom = group.get(layered.layers, 0)
    suite = testing.test_equal(suite, "слои: первый — нижний, по имени", bottom.id, "фон")
    @places = jtml.children_layout(layered, 10, 20, 300, 40)
    @under = group.get(places, 0)
    @over = group.get(places, 1)
    suite = testing.test_equal(suite, "слои: оба на одной площади", "{under.x} {under.y} {under.width} {under.height}", "{over.x} {over.y} {over.width} {over.height}")
    suite = testing.test_equal(suite, "слои: площадь — внутри отступа", "{under.x} {under.y} {under.width} {under.height}", "15 25 290 30")
    @inside = jtml.mount(screen, layered)
    @price = jtml.value(inside, "price")
    suite = testing.test_equal(suite, "слои: поле внутри слоя найдено", price.value, "67")
    suite = testing.test_equal(suite, "слои: дети и слои вместе — нельзя", refused("\{\"box\": \{\"children\": [\{\"text\": \{\}\}], \"layers\": [\{\"layer\": \{\"name\": \"а\"\}\}]\}\}"), "ChildrenAndLayers")
    suite = testing.test_equal(suite, "слои: слой без имени", refused("\{\"box\": \{\"layers\": [\{\"layer\": \{\}\}]\}\}"), "NamelessLayer")
    suite = testing.test_equal(suite, "слои: в layers не слой", refused("\{\"box\": \{\"layers\": [\{\"text\": \{\}\}]\}\}"), "NotLayer")

    @big = read.page("\{\"text\": \{\"value\": \"67 404\", \"size\": \"big\", \"weight\": \"bold\", \"cut\": \"yes\"\}\}")
    suite = testing.test_equal(suite, "текст: размер и жирность из JTML", "{big.size} {big.weight} {big.cut}", "big bold yes")
    @plain = read.page("\{\"text\": \{\"value\": \"67 404\"\}\}")
    suite = testing.test_yes(suite, "текст: крупный выше обычного", measure.node_intrinsic_height(big) > measure.node_intrinsic_height(plain))
    suite = testing.test_equal(suite, "текст: чужой размер", refused("\{\"text\": \{\"size\": \"giant\"\}\}"), "UnknownSize")
    suite = testing.test_equal(suite, "текст: чужая жирность", refused("\{\"text\": \{\"weight\": \"heavy\"\}\}"), "UnknownWeight")

    @dressed = read.page("\{\"box\": \{\"flow\": \"row\", \"width\": 200, \"height\": 40, \"padding\": [1, 2, 3, 4], \"justify\": \"end\", \"align\": \"center\", \"gap\": 0, \"styles\": \{\"кнопка\": \{\"fill\": \"accent\", \"radius\": 6, \"width\": 50, \"height\": 20\}\}, \"children\": [\{\"box\": \{\"style\": \"кнопка\", \"radius\": 9\}\}]\}\}")
    @button = group.get(dressed.children, 0)
    suite = testing.test_equal(suite, "стили: свойства стиля, свои важнее", "{button.fill} {button.radius} {button.width}", "accent 9 50")
    @spots = jtml.children_layout(dressed, 0, 0, 200, 40)
    @spot = group.get(spots, 0)
    suite = testing.test_equal(suite, "раскладка: justify end и align center, отступы по сторонам", "{spot.x} {spot.y} {spot.width} {spot.height}", "148 9 50 20")
    suite = testing.test_equal(suite, "стили: нет такого стиля", refused("\{\"box\": \{\"style\": \"нет\"\}\}"), "UnknownStyle")
    suite = testing.test_equal(suite, "раскладка: чужой justify", refused("\{\"box\": \{\"justify\": \"around\"\}\}"), "UnknownJustify")
    suite = testing.test_equal(suite, "раскладка: чужой align у box", refused("\{\"box\": \{\"align\": \"baseline\"\}\}"), "UnknownAlign")
    suite = testing.test_equal(suite, "отступ: не четыре числа", refused("\{\"box\": \{\"padding\": [1, 2]\}\}"), "BadPadding")
    @between = read.page("\{\"box\": \{\"flow\": \"row\", \"justify\": \"between\", \"gap\": 0, \"children\": [\{\"box\": \{\"width\": 10\}\}, \{\"box\": \{\"width\": 10\}\}, \{\"box\": \{\"width\": 10\}\}]\}\}")
    @apart = jtml.children_layout(between, 0, 0, 100, 10)
    @last = group.get(apart, 2)
    suite = testing.test_equal(suite, "раскладка: between — крайний у правого края", last.x, 90)

    @bought = read.page("\{\"button\": \{\"text\": \"Купить\", \"fill\": \"up\"\}\}")
    @caption = group.get(bought.children, 0)
    suite = testing.test_equal(suite, "библиотека: кнопка развернулась в атомы", "{bought.fill} {bought.radius} {caption.value} {caption.weight}", "up 8 Купить bold")
    @card = read.page("\{\"card\": \{\"padding\": 4, \"children\": [\{\"label\": \{\"text\": \"а\"\}\}, \{\"label\": \{\"text\": \"б\"\}\}]\}\}")
    suite = testing.test_equal(suite, "библиотека: список детей вклеен в слот", group.count(card.children), 2)
    @share = read.page("\{\"labeled-slider\": \{\"label\": \"доля\", \"id\": \"share\", \"value\": 25, \"min\": 0, \"max\": 100, \"unit\": \"\{share\} %\"\}\}")
    suite = testing.test_equal(suite, "библиотека: уровень 2 собран из атомов", group.count(share.children), 2)
    suite = testing.test_equal(suite, "библиотека: чужой параметр", refused("\{\"button\": \{\"цвет\": \"up\"\}\}"), "UnknownParam")

    @fine = read.page("\{\"text\": \{\"value\": \"x\", \"size\": 13, \"leading\": 20, \"fade\": \"ink\"\}\}")
    suite = testing.test_equal(suite, "текст: кегль числом, интервал и переливание", "{fine.pixels} {fine.leading} {fine.fade} {fine.size}", "13 20 ink normal")
    @sunk = read.page("\{\"box\": \{\"shadow\": 12, \"inset\": 2\}\}")
    suite = testing.test_equal(suite, "вид: мягкая и внутренняя тень", "{sunk.shadow} {sunk.inset}", "12 2")
    @marked = read.page("\{\"box\": \{\"icon\": \"house\", \"ink\": \"accent\"\}\}")
    suite = testing.test_equal(suite, "вид: значок и его цвет", "{marked.icon} {marked.ink}", "house accent")
    @capped = read.page("\{\"box\": \{\"radius\": 8, \"corners\": \"top\"\}\}")
    suite = testing.test_equal(suite, "вид: скругление только сверху", capped.corners, "top")
    suite = testing.test_equal(suite, "вид: чужие углы", refused("\{\"box\": \{\"corners\": \"middle\"\}\}"), "UnknownCorners")
    @rows = jtml.mount(screen, read.page(ROWS))
    @second = jtml.hit(rows, 600, 30)
    suite = testing.test_equal(suite, "jtml: box с id — цель по всей площади", second.id, "line-2")
    @first = jtml.hit(rows, 600, 5)
    suite = testing.test_equal(suite, "jtml: щелчок мимо текста — строка", first.id, "line-1")
    @mark = jtml.hit(rows, 2, 5)
    suite = testing.test_equal(suite, "jtml: текст с id внутри — раньше строки", mark.id, "mark")

    @canvas = read.page(CANVAS)
    @free = jtml.mount(screen, canvas)
    @placed = jtml.hit(free, 250, 330)
    suite = testing.test_equal(suite, "jtml: свободный box на своём месте", placed.id, "node-1")
    suite = testing.test_equal(suite, "jtml: место — от угла внутренности", placed.x, 210)
    suite = testing.test_equal(suite, "jtml: и по вертикали", placed.y, 310)
    @corner = jtml.hit(free, 20, 15)
    suite = testing.test_equal(suite, "jtml: свободные — поверх раскладки", corner.id, "node-2")
    suite = testing.test_equal(suite, "jtml: свободные не раздувают родителя", measure.node_intrinsic_height(canvas), measure.node_intrinsic_height(read.page("\{\"box\": \{\"gap\": 0, \"padding\": 10, \"children\": [\{\"text\": \{\"value\": \"холст\"\}\}]\}\}")))
    suite = testing.test_equal(suite, "jtml: at не из двух чисел — ошибка", refused("\{\"box\": \{\"at\": [1]\}\}"), "BadAt")

    out testing.test_finish(suite)
}

skill refused(source) {
    read.page(source) rescue |err| { out "{err}" }
    out "принято"
}
