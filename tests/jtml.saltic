use seed
use craft.testing
use os.drivers.graphics
use os.drivers.font
use os.drivers.keymap_us
use os.drivers.pointer
use os.ui.jtml

program() {
    @suite = testing.test_new()
    @screen = graphics.Screen { width = 1280 height = 720 }
    @header = jtml.frame(jtml.Flow.ROW, 0, 68, 0, 12, 16, 2, [
        jtml.text("## SALTIC"),
        jtml.space(1),
        jtml.text("CELL 01  ALIVE")
    ])
    @body = jtml.frame(jtml.Flow.ROW, 0, 0, 1, 0, 16, 0, [
        jtml.frame(jtml.Flow.COLUMN, 224, 0, 0, 16, 20, 2, [
            jtml.text("CELLS")
        ]),
        jtml.frame(jtml.Flow.COLUMN, 0, 0, 1, 24, 16, 2, [
            jtml.label("## CELL 01 IS ALIVE", jtml.Align.CENTER)
        ])
    ])
    @command = jtml.frame(jtml.Flow.ROW, 0, 87, 0, 8, 12, 2, [
        jtml.text("## >"),
        jtml.field_grow("command", ""),
        jtml.text("PULSE 000001")
    ])
    @view = jtml.frame(jtml.Flow.COLUMN, 0, 0, 0, 32, 16, 0, [
        header,
        body,
        command
    ])
    @runtime = jtml.mount(screen, view)

    suite = testing.test_equal(suite, "JTML: ширина платформы", runtime.width, 1280)
    suite = testing.test_equal(suite, "JTML: высота платформы", runtime.height, 720)
    suite = testing.test_equal(suite, "JTML: одно поле", seed.group.count(runtime.fields), 1)
    suite = testing.test_equal(suite, "JTML: командная строка активна", runtime.focused, "command")

    @slot = jtml.find_field(runtime, "command")
    suite = testing.test_yes(suite, "JTML: поле найдено", slot.found)
    suite = testing.test_equal(suite, "JTML: поле выровнено по X", slot.slot.field.x, 70)
    suite = testing.test_equal(suite, "JTML: поле выровнено по Y", slot.slot.field.y, 623)
    suite = testing.test_equal(suite, "JTML: поле заняло свободную ширину", slot.slot.field.width, 1060)

    suite = testing.test_equal(suite, "MD: H1 имеет родную ширину", font.font_text_width("# A"), 32)
    suite = testing.test_equal(suite, "MD: H2 имеет родную высоту", font.font_text_height("## A"), 32)
    suite = testing.test_equal(suite, "MD: H3 имеет родную высоту", font.font_text_height("### A"), 24)
    suite = testing.test_equal(suite, "MD: H4 имеет родную высоту", font.font_text_height("#### A"), 16)
    suite = testing.test_equal(suite, "MD: H5 имеет родную высоту", font.font_text_height("##### A"), 12)
    suite = testing.test_equal(suite, "MD: H6 имеет родную высоту", font.font_text_height("###### A"), 8)
    suite = testing.test_equal(suite, "MD: обычный текст компактен", font.font_text_width("SALTIC"), 48)
    suite = testing.test_equal(suite, "MD: префикс не входит в ширину", font.font_text_width("###### A"), 5)

    @clicked = jtml.focus_at(runtime, 100, 630)
    suite = testing.test_equal(suite, "JTML: клик фокусирует поле", clicked.focused, "command")
    clicked = jtml.focus_at(clicked, 10, 10)
    suite = testing.test_equal(suite, "JTML: клик мимо сохраняет фокус", clicked.focused, "command")
    suite = testing.test_equal(suite, "мышь: левая граница", pointer.pointer_scale(0, 1280), 0)
    suite = testing.test_equal(suite, "мышь: правая граница", pointer.pointer_scale(32767, 1280), 1279)

    @typed = jtml.key(runtime, 30, no)
    typed = jtml.key(typed, 30, yes)
    @typed_command = jtml.value(typed, "command")
    suite = testing.test_equal(suite, "JTML: ввод идёт в активное поле", typed_command.value, "aA")

    @original_command = jtml.value(runtime, "command")
    suite = testing.test_equal(suite, "JTML: исходное дерево не изменилось", original_command.value, "")

    typed = jtml.key(typed, keymap_us.KEY_BACKSPACE, no)
    typed_command = jtml.value(typed, "command")
    suite = testing.test_equal(suite, "JTML: удаление символа", typed_command.value, "a")

    @absent = jtml.value(runtime, "absent")
    suite = testing.test_no(suite, "JTML: отсутствующее поле явно отмечено", absent.found)
    out testing.test_finish(suite)
}
