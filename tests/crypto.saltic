-- crypto test — craft.protocols.security.crypto: сравнение секретов за
-- постоянное время (Q-023: проверка своя, не в контракте ядра). Гоняет
-- tests/run.saltic (crypto) на цели прогона.
--
-- program() -> none; TestsFailed, если есть провалы

use craft.testing
use craft.protocols.security.crypto

program() {
    @suite = testing.test_new()
    suite = testing.test_yes(suite, "crypto: равные строки", crypto.equal("secret", "secret"))
    suite = testing.test_no(suite, "crypto: другая буква", crypto.equal("secret", "secreT"))
    suite = testing.test_no(suite, "crypto: другая длина", crypto.equal("secret", "secre"))
    out testing.test_finish(suite)
}
