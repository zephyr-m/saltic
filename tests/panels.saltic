-- panels — тест боковых панелей UEFI без железа: строки сетевого журнала
-- (netlog.journal — знаки, первая строка, счёт строк, обрезка и перенос UTF-8)
-- и подписи системной панели (system_panel.sizes — размеры, скорости, доли).
-- Запуск: tests/run.sh panels; эталона нет — только проверки.
--
-- same(a, b) -> yes/no — группы байтов равны поэлементно (== сравнивает ссылки)
-- program() -> none; TestsFailed

use core.group
use craft.testing
use os.target.uefi_x86_64.network.netlog.journal
use os.target.uefi_x86_64.screen.system_panel.sizes

skill same(a, b) {
    ((group.count(a) == group.count(b)) == no) { out no }
    drum (group.count(a)) {
        ((group.get(a, beat) == group.get(b, beat)) == no) { out no }
    }
    out yes
}

program() {
    @suite = testing.test_new()
    @ask = journal.entry(journal.ASK, "12:03:44", journal.bytes_of("info"), 100)
    suite = testing.test_yes(suite, "journal: запрос со знаком >", same(ask, journal.bytes_of("12:03:44 > info")))
    @say = journal.entry(journal.SAY, "12:03:45", journal.bytes_of("ok"), 100)
    suite = testing.test_yes(suite, "journal: ответ со знаком <", same(say, journal.bytes_of("12:03:45 < ok")))

    @lines = journal.bytes_of("первая\nвторая\nтретья\n")
    suite = testing.test_yes(suite, "journal: первая строка", same(journal.first_line(lines), journal.bytes_of("первая")))
    suite = testing.test_equal(suite, "journal: три строки, хвостовой перевод не в счёт", journal.line_count(lines), 3)
    suite = testing.test_equal(suite, "journal: пустой текст — одна строка", journal.line_count([]), 1)
    @long = journal.entry(journal.SAY, "00:00:00", lines, 100)
    suite = testing.test_yes(suite, "journal: остальные строки счётом", same(long, journal.bytes_of("00:00:00 < первая (+2 строк)")))

    @word = journal.bytes_of("жук")
    suite = testing.test_yes(suite, "journal: обрезка не рвёт букву", same(journal.cut(word, 3), journal.bytes_of("ж")))
    suite = testing.test_yes(suite, "journal: обрезка по границе буквы", same(journal.cut(word, 4), journal.bytes_of("жу")))
    suite = testing.test_yes(suite, "journal: короткое не режется", same(journal.cut(word, 6), word))
    suite = testing.test_yes(suite, "journal: нет места — пусто", same(journal.cut(word, 0), []))
    @tight = journal.entry(journal.ASK, "00:00:00", journal.bytes_of("abcdef"), 14)
    suite = testing.test_equal(suite, "journal: строка не длиннее предела", group.count(tight), 14)

    @rows = journal.wrap(journal.bytes_of("один два три"), 7)
    suite = testing.test_equal(suite, "journal: перенос по пробелу — два ряда", group.count(rows), 2)
    suite = testing.test_yes(suite, "journal: первый ряд до пробела", same(group.get(rows, 0), journal.bytes_of("один ")))
    suite = testing.test_yes(suite, "journal: второй ряд", same(group.get(rows, 1), journal.bytes_of("два три")))
    @solid = journal.wrap(journal.bytes_of("абвгде"), 4)
    suite = testing.test_yes(suite, "journal: слово без пробела рвётся по буквам", same(group.get(solid, 0), journal.bytes_of("абвг")))
    suite = testing.test_equal(suite, "journal: пустой текст — один ряд", group.count(journal.wrap([], 10)), 1)

    suite = testing.test_equal(suite, "sizes: килобайты", sizes.kb_text(512), "512 КБ")
    suite = testing.test_equal(suite, "sizes: мегабайты с запятой", sizes.kb_text(3482), "3,4 МБ")
    suite = testing.test_equal(suite, "sizes: гигабайты", sizes.kb_text(1258292), "1,2 ГБ")
    suite = testing.test_equal(suite, "sizes: целые мегабайты", sizes.mb_text(512), "512 МБ")
    suite = testing.test_equal(suite, "sizes: гигабайты памяти", sizes.mb_text(7782), "7,5 ГБ")
    suite = testing.test_equal(suite, "sizes: десятки гигабайт целыми", sizes.mb_text(30720), "30 ГБ")
    suite = testing.test_equal(suite, "sizes: байты в секунду", sizes.speed_text(300), "300 Б/с")
    suite = testing.test_equal(suite, "sizes: килобайты в секунду", sizes.speed_text(12800), "12 КБ/с")
    suite = testing.test_equal(suite, "sizes: мегабайты в секунду", sizes.speed_text(1572864), "1,5 МБ/с")
    suite = testing.test_equal(suite, "sizes: доля", sizes.percent(1, 4), 25)
    suite = testing.test_equal(suite, "sizes: доля от нуля", sizes.percent(5, 0), 0)
    out testing.test_finish(suite)
}
