use core.str
use core.group
use craft.testing
use selfhost.parser
use selfhost.checker

skill diagnostic_first(items) {
    out group.item(items, 0)
}

skill lexer_diagnostics(suite) {
    @parsed = parser.parse_string("\"незавершённая строка", "lexer.case")
    suite = testing.test_equal(suite, "лексер: одна диагностика", group.count(parsed.diagnostics), 1)
    @item = diagnostic_first(parsed.diagnostics)
    suite = testing.test_equal(suite, "лексер: код", item.code, "lexer_error")
    suite = testing.test_equal(suite, "лексер: строка", item.line, 1)
    suite = testing.test_equal(suite, "лексер: столбец", item.col, 1)
    suite = testing.test_yes(suite, "лексер: сообщение", str.contains(item.message, "незавершённая строка"))
    out suite
}

skill parser_diagnostics(suite) {
    @parsed = parser.parse_string("skill broken(", "parser.case")
    suite = testing.test_equal(suite, "парсер: одна диагностика", group.count(parsed.diagnostics), 1)
    @item = diagnostic_first(parsed.diagnostics)
    suite = testing.test_equal(suite, "парсер: код", item.code, "parser_error")
    suite = testing.test_equal(suite, "парсер: строка", item.line, 1)
    suite = testing.test_yes(suite, "парсер: столбец", item.col > 0)
    suite = testing.test_yes(suite, "парсер: сообщение", str.contains(item.message, "ожидалось"))
    out suite
}

skill comma_diagnostics(suite) {
    @missing = parser.parse_string("P = Box \{\n    x = 0\n    y = 0\n\}\n", "comma.case")
    @item = diagnostic_first(missing.diagnostics)
    suite = testing.test_yes(suite, "запятые: между полями", str.contains(item.message, "между полями нужна запятая"))
    @trailing = parser.parse_string("program() \{\n    @p = P \{ x = 1, \}\n    out none\n\}\n", "comma.case")
    item = diagnostic_first(trailing.diagnostics)
    suite = testing.test_yes(suite, "запятые: после последнего поля", str.contains(item.message, "после последнего поля её нет"))
    out suite
}

skill module_diagnostics(suite) {
    @loaded = parser.load_modules("tests/fixtures/diagnostics-absent.saltic", ".")
    suite = testing.test_equal(suite, "модули: одна диагностика", group.count(loaded.diagnostics), 1)
    @item = diagnostic_first(loaded.diagnostics)
    suite = testing.test_equal(suite, "модули: код", item.code, "module_error")
    suite = testing.test_equal(suite, "модули: строка неизвестна", item.line, 0)
    suite = testing.test_equal(suite, "модули: столбец неизвестен", item.col, 0)
    suite = testing.test_yes(suite, "модули: сообщение", str.contains(item.message, "модуль не найден"))
    suite = testing.test_yes(suite, "модули: имя в сообщении", str.contains(item.message, "diagnostics-absent.saltic"))
    out suite
}

skill checker_diagnostics(suite) {
    @source = "use seed\nprogram() \{\n    missing()\n    out none\n\}\n"
    @parsed = parser.parse_string_loc(source, "checker.case")
    @checked = checker.check(parsed.ast)
    suite = testing.test_equal(suite, "чекер: одна диагностика", group.count(checked.diagnostics), 1)
    @item = diagnostic_first(checked.diagnostics)
    suite = testing.test_equal(suite, "чекер: код", item.code, "unknown_name")
    suite = testing.test_equal(suite, "чекер: строка", item.line, 3)
    suite = testing.test_equal(suite, "чекер: столбец", item.col, 5)
    suite = testing.test_yes(suite, "чекер: сообщение", str.contains(item.message, "неизвестное имя"))
    out suite
}

skill module_name_diagnostics(suite) {
    @source = "use io.file\nskill take(file) \{\n    out none\n\}\nprogram() \{\n    @file = 1\n    @n = take(1) rescue |file| \{\n        out none\n    \}\n    out none\n\}\n"
    @parsed = parser.parse_string_loc(source, "module-name.case")
    @checked = checker.check(parsed.ast)
    suite = testing.test_equal(suite, "имя модуля: три диагностики", group.count(checked.diagnostics), 3)
    @item = diagnostic_first(checked.diagnostics)
    suite = testing.test_yes(suite, "имя модуля: сообщение", str.contains(item.message, "занято модулем 'io.file'"))
    out suite
}

program() {
    @suite = testing.test_new()
    suite = lexer_diagnostics(suite)
    suite = parser_diagnostics(suite)
    suite = comma_diagnostics(suite)
    suite = module_diagnostics(suite)
    suite = checker_diagnostics(suite)
    suite = module_name_diagnostics(suite)
    out testing.test_finish(suite)
}
