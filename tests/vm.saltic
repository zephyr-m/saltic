use seed.io.file
use seed.str
use seed.group
use seed.num
use seed.vm
use seed.vm.state

skill vm_test_image(text) {
    @chunks = []
    @chunk = []
    @index = 0
    @length = str.len(text)
    drum (length) {
        chunk = group.add(chunk, str.byte(text, index))
        index = index + 1
        (group.count(chunk) == state.PAGE_SIZE) {
            chunks = group.add(chunks, chunk)
            chunk = []
        }
    }
    (group.count(chunk) > 0) { chunks = group.add(chunks, chunk) }
    out chunks
}

skill vm_test_bytes(text) {
    @bytes = []
    @index = 0
    @length = str.len(text)
    drum (length) {
        bytes = group.add(bytes, str.byte(text, index))
        index = index + 1
    }
    out bytes
}

skill vm_test_numbers(values) {
    @text = ""
    @index = 0
    @count = group.count(values)
    drum (count) {
        (index > 0) { text = "{text}," }
        text = str.add(text, num.text(group.at(values, index)))
        index = index + 1
    }
    out text
}

skill vm_test_strings(values) {
    @text = ""
    @index = 0
    @count = group.count(values)
    drum (count) {
        (index > 0) { text = "{text}," }
        text = str.add(text, group.at(values, index))
        index = index + 1
    }
    out text
}

skill vm_test_output(files) {
    @bytes = []
    @index = 0
    @count = group.count(files)
    drum (count) {
        @entry = group.at(files, index)
        (entry.path == "output.txt") { bytes = entry.data }
        index = index + 1
    }
    out bytes
}

skill vm_test_snapshot(name, result) {
    @registers = vm_test_strings(result.registers)
    @stdout = vm_test_numbers(result.stdout)
    @stderr = vm_test_numbers(result.stderr)
    @output = vm_test_numbers(vm_test_output(result.files))
    out "scenario={name}\nexit_code={result.exit_code}\nreason={result.reason}\npc={result.pc}\nsteps={result.steps}\nregisters={registers}\nstdout={stdout}\nstderr={stderr}\noutput={output}\ntrap={result.trap}\n"
}

skill vm_test_run(name, image, input, scenario) {
    @arguments = [scenario]
    (scenario == "normal") { arguments = ["normal", "input.txt", "output.txt"] }
    @limit = 100000
    (scenario == "timeout") { limit = 32 }
    @options = state.Options {
        load_address = 4096
        memory_size = 16777216 * 2
        step_limit = limit
        program_name = "vm-canonical"
        arguments = arguments
        files = [state.File { path = "input.txt" data = input }]
    }
    out vm_test_snapshot(name, vm.run(image, options))
}

program(elf_path, output_path) {
    @elf = vm_test_image(file.read(elf_path))
    @options = state.Options {
        load_address = 4096
        memory_size = 16777216 * 2
        step_limit = 100000
        program_name = "guest"
        arguments = []
        files = []
    }
    @result = vm.run(elf, options)
    file.write(output_path, "reason={result.reason}\nexit_code={result.exit_code}\ntrap={result.trap}\n")
    out none
}
