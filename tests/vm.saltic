use seed.io.file
use seed.str
use seed.group
use seed.num
use seed.vm
use seed.vm.state

skill vm_test_image(text) {
    @chunks = []
    @chunk = []
    @index = 0
    @length = str.len(text)
    drum (length) {
        chunk = group.add(chunk, str.byte(text, index))
        index = index + 1
        (group.count(chunk) == state.PAGE_SIZE) {
            chunks = group.add(chunks, chunk)
            chunk = []
        }
    }
    (group.count(chunk) > 0) { chunks = group.add(chunks, chunk) }
    out chunks
}

skill vm_test_bytes(text) {
    @bytes = []
    @index = 0
    @length = str.len(text)
    drum (length) {
        bytes = group.add(bytes, str.byte(text, index))
        index = index + 1
    }
    out bytes
}

skill vm_test_numbers(values) {
    @text = ""
    @index = 0
    @count = group.count(values)
    drum (count) {
        (index > 0) { text = str.add(text, ",") }
        text = str.add(text, num.text(group.at(values, index)))
        index = index + 1
    }
    out text
}

skill vm_test_strings(values) {
    @text = ""
    @index = 0
    @count = group.count(values)
    drum (count) {
        (index > 0) { text = str.add(text, ",") }
        text = str.add(text, group.at(values, index))
        index = index + 1
    }
    out text
}

skill vm_test_output(files) {
    @bytes = []
    @index = 0
    @count = group.count(files)
    drum (count) {
        @file = group.at(files, index)
        (file.path == "output.txt") { bytes = file.data }
        index = index + 1
    }
    out bytes
}

skill vm_test_snapshot(name, result) {
    @text = str.add("scenario=", name)
    text = str.add(text, "\nexit_code=")
    text = str.add(text, num.text(result.exit_code))
    text = str.add(text, "\nreason=")
    text = str.add(text, result.reason)
    text = str.add(text, "\npc=")
    text = str.add(text, result.pc)
    text = str.add(text, "\nsteps=")
    text = str.add(text, num.text(result.steps))
    text = str.add(text, "\nregisters=")
    text = str.add(text, vm_test_strings(result.registers))
    text = str.add(text, "\nstdout=")
    text = str.add(text, vm_test_numbers(result.stdout))
    text = str.add(text, "\nstderr=")
    text = str.add(text, vm_test_numbers(result.stderr))
    text = str.add(text, "\noutput=")
    text = str.add(text, vm_test_numbers(vm_test_output(result.files)))
    text = str.add(text, "\ntrap=")
    text = str.add(text, result.trap)
    out str.add(text, "\n")
}

skill vm_test_run(name, image, input, scenario) {
    @arguments = [scenario]
    (scenario == "normal") { arguments = ["normal", "input.txt", "output.txt"] }
    @limit = 100000
    (scenario == "timeout") { limit = 32 }
    @options = state.Options {
        load_address = 4096
        memory_size = 16777216 * 2
        step_limit = limit
        program_name = "vm-canonical"
        arguments = arguments
        files = [state.File { path = "input.txt" data = input }]
    }
    out vm_test_snapshot(name, vm.run(image, options))
}

program(elf_path, output_path) {
    @elf = vm_test_image(file.read(elf_path))
    @options = state.Options {
        load_address = 4096
        memory_size = 16777216 * 2
        step_limit = 100000
        program_name = "guest"
        arguments = []
        files = []
    }
    @result = vm.run(elf, options)
    @report = str.add("reason=", result.reason)
    report = str.add(report, "\nexit_code=")
    report = str.add(report, num.text(result.exit_code))
    report = str.add(report, "\ntrap=")
    report = str.add(report, result.trap)
    report = str.add(report, "\n")
    file.write(output_path, report)
    out none
}
