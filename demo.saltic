use seed

Title = "демо"

Mood = enum {
    CALM,
    AWAKE,
    TIRED,
}

Place = Box {
    x = 0
    y = 0
}

Walker = Box {
    name = ""
    mood = Mood.CALM
    steps_left = 0
    place = Place {}
}

skill step(walker) {
    (walker.steps_left == 0) {
        out error.NotEnoughEnergy
    }

    out Walker {
        name = walker.name
        mood = Mood.AWAKE
        steps_left = walker.steps_left - 1
        place = Place {
            x = walker.place.x + 1
            y = walker.place.y
        }
    }
}

skill say(walker) {
    (walker.mood) {
        .CALM => seed.io.show(walker.name, " спокоен"),
        .AWAKE => seed.io.show(walker.name, " идёт"),
        .TIRED => seed.io.show(walker.name, " устал"),
    }

    seed.io.show(Title, " x:", walker.place.x, " осталось:", walker.steps_left)
    out none
}

program() {
    @walker = Walker {
        name = "pip"
        steps_left = 2
        place = Place { x = 0 y = 1 }
    }
    @plan = [1, 1, 1]
    @index = 0

    drum (seed.group.count(plan)) {
        walker = step(walker) rescue |err| {
            seed.io.show("стоп: ", err)
            Walker {
                name = walker.name
                mood = Mood.TIRED
                steps_left = 0
                place = walker.place
            }
        }
        say(walker)
        index = index + 1
    }

    out none
}
