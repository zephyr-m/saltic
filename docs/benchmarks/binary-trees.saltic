-- binary-trees — замер из Benchmarks Game: миллионы мелких деревьев (группы
-- из двух детей, лист — пустая группа), проверка выделения памяти и сборки
-- мусора. Глубина — top в program(); вывод сверяется с binary-trees.expected.

use io
use core.group

skill make(depth) {
    (depth == 0) { out [] }
    out [make(depth - 1), make(depth - 1)]
}

skill check(tree) {
    (group.count(tree) == 0) { out 1 }
    out 1 + check(group.get(tree, 0)) + check(group.get(tree, 1))
}

skill one(depth) {
    out check(make(depth))
}

skill power2(n) {
    @value = 1
    drum (n) { value = value * 2 }
    out value
}

skill many(depth, iterations) {
    @sum = 0
    drum (iterations) { sum = sum + one(depth) }
    out sum
}

program() {
    @top = 16
    @low = 4
    @stretch = top + 1
    @stretch_check = one(stretch)
    io.show("stretch tree of depth {stretch} check: {stretch_check}")
    @long = make(top)
    @depth = low
    drum ((top - low) / 2 + 1) {
        @iterations = power2(top - depth + low)
        @sum = many(depth, iterations)
        io.show("{iterations} trees of depth {depth} check: {sum}")
        depth = depth + 2
    }
    @long_check = check(long)
    io.show("long lived tree of depth {top} check: {long_check}")
}
