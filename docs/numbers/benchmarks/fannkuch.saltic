-- fannkuch — замер fannkuch-redux из Benchmarks Game: перестановки и
-- «переворачивание блинов», целые числа, массивы на core.bytes. n — в
-- program(); вывод сверяется с fannkuch.expected (73196, 38 при n = 10).

use io
use core.bytes


State = Box {
    r = 0,
    checksum = 0,
    maxflips = 0,
    turn = 0
}

skill flips_of(perm1, perm, n) {
    drum (n) { bytes.set(perm, beat, bytes.get(perm1, beat)) }
    @flips = 0
    always {
        @k = bytes.get(perm, 0)
        (k == 0) { leave }
        @i = 0
        @j = k
        always {
            (j <= i) { leave }
            @kept = bytes.get(perm, i)
            bytes.set(perm, i, bytes.get(perm, j))
            bytes.set(perm, j, kept)
            i = i + 1
            j = j - 1
        }
        flips = flips + 1
    }
    out flips
}

skill advance(state, perm1, count, n) {
    always {
        (state.r == n) { out no }
        @first = bytes.get(perm1, 0)
        drum (state.r) { bytes.set(perm1, beat, bytes.get(perm1, beat + 1)) }
        bytes.set(perm1, state.r, first)
        @left = bytes.get(count, state.r) - 1
        bytes.set(count, state.r, left)
        (left > 0) { out yes }
        state.r = state.r + 1
    }
    out no
}

program() {
    @n = 10
    @perm1 = bytes.new(n)
    @perm = bytes.new(n)
    @count = bytes.new(n)
    drum (n) { bytes.set(perm1, beat, beat) }
    @state = State { r = n }
    always {
        drum (state.r - 1) {
            bytes.set(count, state.r - 1, state.r)
            state.r = state.r - 1
        }
        @flips = flips_of(perm1, perm, n)
        (flips > state.maxflips) { state.maxflips = flips }
        pick {
            (state.turn % 2 == 0) { state.checksum = state.checksum + flips }
            { state.checksum = state.checksum - flips }
        }
        (advance(state, perm1, count, n) == no) { leave }
        state.turn = state.turn + 1
    }
    @checksum = state.checksum
    @maxflips = state.maxflips
    io.show("{checksum}")
    io.show("Pfannkuchen({n}) = {maxflips}")
}
