-- armor — «Броня» пульта: холодный неон на почти чёрном
-- (docs/site/private/CONSOLE-LOOK.html, :root); без щепоток языка (lit — no).
--
-- palette(screen) -> atoms.Palette

use registry.libraries.uiengine.themes.soft
use os.target.uefi_x86_64.screen.graphics

skill palette(screen) {
    @armor = soft.palette(screen)
    armor.lit = no
    armor.ground = graphics.color(screen, 1, 6, 8)
    armor.panel = graphics.color(screen, 0, 14, 18)
    armor.well = graphics.color(screen, 1, 9, 12)
    armor.raise = graphics.color(screen, 0, 24, 30)
    armor.select = graphics.color(screen, 1, 57, 62)
    armor.line = graphics.color(screen, 1, 57, 62)
    armor.ink = graphics.color(screen, 223, 252, 255)
    armor.quiet = graphics.color(screen, 79, 163, 179)
    armor.gutter = graphics.color(screen, 29, 74, 84)
    armor.accent = graphics.color(screen, 0, 225, 255)
    armor.up = graphics.color(screen, 93, 255, 176)
    armor.down = graphics.color(screen, 255, 90, 54)
    armor.shadow = graphics.color(screen, 0, 0, 0)
    out armor
}
