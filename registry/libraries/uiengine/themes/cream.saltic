-- cream — дневная тема публичного сайта (docs/site/public/site.css: питч,
-- пирог, дерево): тёплый крем, коралл (accent), песок — выбор (mustard),
-- бирюза (info); песок для текста на креме не читается — выбор охрой
-- (песок сайта темнее); от светлой темы, без щепоток языка (lit — no: свет сверху
-- на светлом не виден).
--
-- palette(screen) -> atoms.Palette

use registry.libraries.uiengine.themes.light
use os.target.uefi_x86_64.screen.graphics

skill palette(screen) {
    @cream = light.palette(screen)
    cream.lit = no
    cream.ground = graphics.color(screen, 246, 238, 227)
    cream.side = graphics.color(screen, 239, 227, 210)
    cream.panel = graphics.color(screen, 253, 248, 241)
    cream.well = graphics.color(screen, 239, 227, 210)
    cream.raise = graphics.color(screen, 239, 227, 210)
    cream.select = graphics.color(screen, 239, 227, 210)
    cream.line = graphics.color(screen, 226, 210, 189)
    cream.rim = graphics.color(screen, 205, 184, 159)
    cream.ink = graphics.color(screen, 58, 46, 38)
    cream.quiet = graphics.color(screen, 125, 106, 92)
    cream.gutter = graphics.color(screen, 168, 150, 138)
    cream.accent = graphics.color(screen, 233, 128, 95)
    cream.info = graphics.color(screen, 63, 166, 184)
    cream.mustard = graphics.color(screen, 184, 134, 52)
    cream.mustard_edge = graphics.color(screen, 150, 106, 36)
    cream.up = graphics.color(screen, 63, 143, 90)
    cream.up_soft = graphics.color(screen, 226, 234, 218)
    cream.down = graphics.color(screen, 194, 86, 60)
    cream.down_soft = graphics.color(screen, 244, 222, 212)
    cream.shadow = graphics.color(screen, 220, 205, 188)
    out cream
}
