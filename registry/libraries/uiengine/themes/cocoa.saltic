-- cocoa — ночная тема публичного сайта (docs/site/public/site.css, тёмный
-- режим): какао вместо графита, коралл (accent), песок — выбор (mustard),
-- бирюза (info), цвета кода — как в блоках кода сайта; щепотки языка — в
-- тёплых тонах.
--
-- palette(screen) -> atoms.Palette

use registry.libraries.uiengine.themes.soft
use os.screen.graphics

skill palette(screen) {
    @cocoa = soft.palette(screen)
    cocoa.lit = yes
    cocoa.ground = graphics.color(screen, 29, 24, 20)
    cocoa.side = graphics.color(screen, 25, 20, 16)
    cocoa.panel = graphics.color(screen, 39, 32, 27)
    cocoa.well = graphics.color(screen, 20, 17, 16)
    cocoa.raise = graphics.color(screen, 50, 41, 34)
    cocoa.select = graphics.color(screen, 50, 41, 34)
    cocoa.line = graphics.color(screen, 63, 52, 43)
    cocoa.rim = graphics.color(screen, 90, 74, 61)
    cocoa.ink = graphics.color(screen, 241, 230, 216)
    cocoa.quiet = graphics.color(screen, 179, 160, 144)
    cocoa.gutter = graphics.color(screen, 138, 119, 104)
    cocoa.accent = graphics.color(screen, 241, 150, 122)
    cocoa.info = graphics.color(screen, 99, 193, 207)
    cocoa.mustard = graphics.color(screen, 216, 181, 119)
    cocoa.mustard_edge = graphics.color(screen, 170, 138, 84)
    cocoa.up = graphics.color(screen, 124, 196, 143)
    cocoa.up_soft = graphics.color(screen, 43, 48, 36)
    cocoa.down = graphics.color(screen, 240, 138, 112)
    cocoa.down_soft = graphics.color(screen, 56, 36, 30)
    cocoa.shadow = graphics.color(screen, 10, 8, 6)
    cocoa.keyword = graphics.color(screen, 243, 155, 125)
    cocoa.string = graphics.color(screen, 234, 201, 143)
    cocoa.number = graphics.color(screen, 201, 178, 232)
    cocoa.comment = graphics.color(screen, 168, 150, 138)
    cocoa.name = graphics.color(screen, 116, 203, 216)
    out cocoa
}
