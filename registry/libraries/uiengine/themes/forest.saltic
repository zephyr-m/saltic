-- forest — «лес»: тёмная зелень вместо дерева алхимии, изумруд вместо латуни
-- (accent), светлая хвоя — текст; щепотки языка (рамка панели, свет сверху,
-- сетка) — в зелёных тонах. Проба автора 18.11.2026 на Алхимии в телефоне.
--
-- palette(screen) -> atoms.Palette

use registry.libraries.uiengine.themes.soft
use os.screen.graphics

skill palette(screen) {
    @forest = soft.palette(screen)
    forest.ground = graphics.color(screen, 10, 17, 13)
    forest.side = graphics.color(screen, 8, 14, 10)
    forest.panel = graphics.color(screen, 17, 29, 22)
    forest.well = graphics.color(screen, 9, 15, 11)
    forest.raise = graphics.color(screen, 26, 42, 32)
    forest.select = graphics.color(screen, 26, 42, 32)
    forest.line = graphics.color(screen, 32, 54, 40)
    forest.rim = graphics.color(screen, 48, 82, 60)
    forest.ink = graphics.color(screen, 230, 242, 233)
    forest.quiet = graphics.color(screen, 143, 166, 152)
    forest.gutter = graphics.color(screen, 95, 117, 104)
    forest.accent = graphics.color(screen, 92, 214, 150)
    forest.mustard = graphics.color(screen, 92, 214, 150)
    forest.mustard_edge = graphics.color(screen, 52, 150, 98)
    forest.up = graphics.color(screen, 92, 214, 150)
    forest.up_soft = graphics.color(screen, 22, 48, 34)
    forest.shadow = graphics.color(screen, 3, 6, 4)
    out forest
}
