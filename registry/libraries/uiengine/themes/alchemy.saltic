-- alchemy — алхимия языка: тёмное дерево, пергамент (ink), латунь (accent),
-- изумруд (up); без щепоток языка (lit — no).
--
-- palette(screen) -> atoms.Palette

use registry.libraries.uiengine.themes.soft
use os.screen.graphics

skill palette(screen) {
    @guild = soft.palette(screen)
    guild.lit = no
    guild.ground = graphics.color(screen, 33, 24, 20)
    guild.panel = graphics.color(screen, 47, 35, 29)
    guild.well = graphics.color(screen, 26, 18, 16)
    guild.raise = graphics.color(screen, 62, 45, 35)
    guild.select = graphics.color(screen, 62, 45, 35)
    guild.line = graphics.color(screen, 92, 70, 42)
    guild.ink = graphics.color(screen, 243, 228, 188)
    guild.quiet = graphics.color(screen, 186, 170, 140)
    guild.accent = graphics.color(screen, 242, 203, 115)
    guild.up = graphics.color(screen, 87, 181, 134)
    guild.up_soft = graphics.color(screen, 38, 56, 44)
    guild.down = graphics.color(screen, 180, 76, 62)
    guild.shadow = graphics.color(screen, 12, 8, 7)
    out guild
}
