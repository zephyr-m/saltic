-- soft — тёмная тема, язык вида автора (docs/design/LANGUAGE.md, кожа «Мягкая»):
-- три ступени тьмы, цвета смысла одной светлоты, высота светом; lit — рамка
-- панели, свет сверху и сетка точек (atoms). Основа прочих тем.
--
-- palette(screen) -> atoms.Palette

use registry.libraries.uiengine.draw.atoms
use os.target.uefi_x86_64.screen.graphics

skill palette(screen) {
    out atoms.Palette { ground = graphics.color(screen, 7, 9, 13), line = graphics.color(screen, 34, 42, 55), ink = graphics.color(screen, 238, 241, 246), quiet = graphics.color(screen, 139, 148, 164), accent = graphics.color(screen, 76, 205, 255), up = graphics.color(screen, 71, 222, 124), down = graphics.color(screen, 255, 155, 160), info = graphics.color(screen, 204, 169, 255), panel = graphics.color(screen, 17, 23, 35), select = graphics.color(screen, 34, 42, 55), well = graphics.color(screen, 9, 12, 18), mustard = graphics.color(screen, 228, 183, 64), mustard_edge = graphics.color(screen, 178, 138, 36), watermelon = graphics.color(screen, 236, 78, 98), watermelon_edge = graphics.color(screen, 190, 44, 68), keyword = graphics.color(screen, 197, 134, 192), string = graphics.color(screen, 206, 145, 120), number = graphics.color(screen, 181, 206, 168), comment = graphics.color(screen, 106, 153, 85), name = graphics.color(screen, 78, 201, 176), raise = graphics.color(screen, 24, 32, 44), gutter = graphics.color(screen, 93, 102, 117), up_soft = graphics.color(screen, 17, 43, 31), down_soft = graphics.color(screen, 47, 32, 37), shadow = graphics.color(screen, 3, 4, 6), rim = graphics.color(screen, 51, 64, 90), lit = yes, side = graphics.color(screen, 12, 16, 24) }
}
