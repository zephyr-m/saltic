            \{                         \"layer\": \{                           \"name\": \"метки\",                           \"gap\": 0,                           \"children\": [                             \"\{labels\}\"                           ]                         \}                       \},                       \{                         \"layer\": \{                           \"name\": \"цена\",                           \"gap\": 0,                           \"children\": [                             \"\{mark\}\"                           ]                         \}                       \}                     ]                   \}                 \}               ]             \}           \},           \{             \"caption\": \{               \"text\": \"объём\"             \}           \},           \{             \"box\": \{               \"flow\": \"row\",               \"gap\": 3,               \"height\": \"\{volume\}\",               \"children\": [                 \"\{volumes\}\"               ]             \}           \}         ]       \}     \}   \} \} ",
    "\{   \"component\": \{     \"name\": \"balance\",     \"params\": [       \"usdt\",       \"btc\",       \"eth\",       \"held\"     ],     \"body\": \{       \"card\": \{         \"gap\": 8,         \"padding\": 12,         \"grow\": 1,         \"children\": [           \{             \"caption\": \{               \"text\": \"баланс\"             \}           \},           \{             \"box\": \{               \"flow\": \"row\",               \"gap\": 32,               \"children\": [                 \{                   \"number\": \{                     \"text\": \"USDT  \{usdt\}\",                     \"tone\": \"up\"                   \}                 \},                 \{                   \"number\": \{                     \"text\": \"BTC  \{btc\}\",                     \"tone\": \"accent\"                   \}                 \},                 \{                   \"number\": \{                     \"text\": \"ETH  \{eth\}\",                     \"tone\": \"info\"                   \}                 \}               ]             \}           \},           \{             \"label\": \{               \"text\": \"в ордерах  \{held\}\"             \}           \},           \{             \"tinted\": \{               \"text\": \"собрано из закрытой библиотеки: уровни 1—4\",               \"tone\": \"info\"             \}           \}         ]       \}     \}   \} \} ",
    "\{   \"component\": \{     \"name\": \"side-deck\",     \"params\": [       \"panel\"     ],     \"body\": \{       \"box\": \{         \"fill\": \"ground\",         \"padding\": 12,         \"gap\": 0,         \"align\": \"stretch\",         \"children\": [           \"\{panel\}\"         ]       \}     \}   \} \}",
    "\{   \"component\": \{     \"name\": \"task-column\",     \"params\": [       \"title\",       \"count\",       \"width\",       \"cards\"     ],     \"body\": \{       \"box\": \{         \"fill\": \"panel\",         \"radius\": 12,         \"padding\": 12,         \"gap\": 8,         \"width\": \"\{width\}\",         \"children\": [           \{             \"column-head\": \{               \"title\": \"\{title\}\",               \"count\": \"\{count\}\"             \}           \},           \"\{cards\}\"         ]       \}     \}   \} \} ",
    "\{   \"component\": \{     \"name\": \"order-book\",     \"params\": [       \"asks\",       \"mid\",       \"bids\"     ],     \"body\": \{       \"card\": \{         \"gap\": 8,         \"padding\": 12,         \"width\": 250,         \"children\": [           \{             \"caption\": \{               \"text\": \"стакан\"             \}           \},           \{             \"box\": \{               \"flow\": \"row\",               \"gap\": 8,               \"children\": [                 \{                   \"caption\": \{                     \"text\": \"цена\"                   \}                 \},                 \{                   \"gap\": \{                     \"grow\": 1                   \}                 \},                 \{                   \"caption\": \{                     \"text\": \"кол-во\"                   \}                 \}               ]             \}           \},           \{             \"box\": \{               \"fill\": \"well\",               \"radius\": 6,               \"padding\": 6,               \"gap\": 3,               \"children\": [                 \"\{asks\}\",                 \{                   \"number\": \{                     \"text\": \"\{mid\}\",                     \"tone\": \"accent\",                     \"align\": \"center\"                   \}                 \},                 \"\{bids\}\"               ]             \}           \}         ]       \}     \}   \} \} ",
