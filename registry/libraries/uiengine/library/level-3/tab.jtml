{
  "component": {
    "name": "tab",
    "params": [
      "id",
      "text",
      "close"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "flow": "row",
        "height": 36,
        "padding": [
          0,
          14,
          0,
          14
        ],
        "gap": 8,
        "align": "center",
        "children": [
          {
            "coin": {}
          },
          {
            "words": {
              "text": "{text}",
              "tone": "quiet"
            }
          },
          {
            "box": {
              "id": "{close}",
              "padding": [
                2,
                2,
                2,
                2
              ],
              "gap": 0,
              "children": [
                {
                  "glyph": {
                    "icon": "x",
                    "tone": "quiet",
                    "size": 12
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}