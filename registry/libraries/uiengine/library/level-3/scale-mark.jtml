{
  "component": {
    "name": "scale-mark",
    "params": [
      "text",
      "height"
    ],
    "body": {
      "box": {
        "height": "{height}",
        "gap": 0,
        "children": [
          {
            "number": {
              "text": "{text}",
              "tone": "quiet"
            }
          }
        ]
      }
    }
  }
}
