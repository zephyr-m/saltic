{
  "component": {
    "name": "console-panel",
    "params": [
      "title",
      "note",
      "width",
      "radius",
      "grow",
      "children"
    ],
    "body": {
      "box": {
        "fill": "panel",
        "edge": "line",
        "border": 1,
        "radius": "{radius}",
        "padding": 14,
        "gap": 12,
        "width": "{width}",
        "cross": "stretch",
        "children": [
          {
            "box": {
              "flow": "row",
              "justify": "between",
              "cross": "center",
              "gap": 8,
              "children": [
                {
                  "caption": {
                    "text": "{title}"
                  }
                },
                {
                  "text": {
                    "value": "{note}",
                    "tone": "quiet",
                    "size": 11
                  }
                }
              ]
            }
          },
          "{children}"
        ],
        "grow": "{grow}"
      }
    }
  }
}
