{
  "component": {
    "name": "console-panel",
    "params": [
      "title",
      "note",
      "width",
      "radius",
      "grow",
      "children"
    ],
    "body": {
      "pane": {
        "radius": "{radius}",
        "width": "{width}",
        "grow": "{grow}",
        "children": [
          {
            "box": {
              "padding": 14,
              "gap": 12,
              "grow": 1,
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "justify": "between",
                    "align": "center",
                    "gap": 8,
                    "children": [
                      {
                        "caption": {
                          "text": "{title}"
                        }
                      },
                      {
                        "console-line": {
                          "text": "{note}",
                          "tone": "quiet",
                          "size": 11
                        }
                      }
                    ]
                  }
                },
                "{children}"
              ]
            }
          }
        ]
      }
    }
  }
}