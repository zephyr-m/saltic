{
  "component": {
    "name": "mode-active",
    "params": [
      "text",
      "icon"
    ],
    "body": {
      "cell": {
        "children": [
          {
            "box": {
              "flow": "row",
              "height": 30,
              "padding": [
                0,
                12,
                0,
                12
              ],
              "gap": 8,
              "align": "center",
              "children": [
                {
                  "glyph": {
                    "icon": "{icon}",
                    "tone": "accent",
                    "size": 15
                  }
                },
                {
                  "words": {
                    "text": "{text}",
                    "weight": "bold"
                  }
                }
              ]
            }
          }
        ],
        "fill": "accent_soft",
        "edge": "accent_rim"
      }
    }
  }
}