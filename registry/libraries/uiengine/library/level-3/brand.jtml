          6
        ],
        "children": [
          {
            "cell": {
              "fill": "mustard",
              "children": [
                {
                  "box": {
                    "width": 26,
                    "height": 26,
                    "justify": "center",
                    "align": "center",
                    "gap": 0,
                    "children": [
                      {
                        "words": {
