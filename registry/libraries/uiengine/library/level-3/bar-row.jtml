{
  "component": {
    "name": "bar-row",
    "params": [
      "label",
      "value",
      "width",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 12,
        "align": "center",
        "height": 28,
        "children": [
          {
            "box": {
              "width": 120,
              "gap": 0,
              "children": [
                {
                  "words": {
                    "text": "{label}"
                  }
                }
              ]
            }
          },
          {
            "box": {
              "grow": 1,
              "flow": "row",
              "align": "center",
              "gap": 0,
              "children": [
                {
                  "bar": {
                    "width": "{width}",
                    "height": 10,
                    "tone": "{tone}",
                    "radius": 5
                  }
                }
              ]
            }
          },
          {
            "box": {
              "width": 80,
              "flow": "row",
              "justify": "end",
              "gap": 0,
              "children": [
                {
                  "console-line": {
                    "text": "{value}",
                    "tone": "quiet",
                    "size": 12
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}