{
  "component": {
    "name": "guild-head",
    "params": [
      "title",
      "note",
      "amount"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 16,
        "align": "center",
        "children": [
          {
            "crest": {
              "icon": "shield"
            }
          },
          {
            "box": {
              "gap": 4,
              "children": [
                {
                  "scaled": {
                    "text": "{title}",
                    "tone": "ink",
                    "size": 22
                  }
                },
                {
                  "words": {
                    "text": "{note}",
                    "tone": "quiet"
                  }
                }
              ]
            }
          },
          {
            "box": {
              "grow": 1,
              "gap": 0
            }
          },
          {
            "gold-pill": {
              "icon": "coins",
              "text": "{amount}"
            }
          }
        ]
      }
    }
  }
}