{
  "component": {
    "name": "guild-head",
    "params": [
      "title",
      "note",
      "amount"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 16,
        "align": "center",
        "children": [
          {
            "crest": {
              "icon": "shield"
            }
          },
          {
            "box": {
              "gap": 4,
              "children": [
                {
                  "text": {
                    "value": "{title}",
                    "size": 22,
                    "tone": "ink"
                  }
                },
                {
                  "text": {
                    "value": "{note}",
                    "size": 14,
                    "tone": "quiet"
                  }
                }
              ]
            }
          },
          {
            "gap": {
              "grow": 1
            }
          },
          {
            "gold-pill": {
              "icon": "coins",
              "text": "{amount}"
            }
          }
        ]
      }
    }
  }
}
