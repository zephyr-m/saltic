{
  "component": {
    "name": "stat-panel",
    "params": [
      "label",
      "value",
      "tone",
      "size",
      "note",
      "grow",
      "extra"
    ],
    "body": {
      "card": {
        "gap": 0,
        "padding": 16,
        "grow": "{grow}",
        "children": [
          {
            "box": {
              "grow": 1,
              "justify": "between",
              "gap": 12,
              "children": [
                {
                  "box": {
                    "gap": 10,
                    "children": [
                      {
                        "caption": {
                          "text": "{label}"
                        }
                      },
                      {
                        "readout": {
                          "text": "{value}",
                          "tone": "{tone}",
                          "size": "{size}"
                        }
                      }
                    ]
                  }
                },
                {
                  "box": {
                    "gap": 10,
                    "children": [
                      "{extra}",
                      {
                        "hint": {
                          "text": "{note}"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}