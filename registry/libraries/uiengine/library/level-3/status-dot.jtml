{
  "component": {
    "name": "status-dot",
    "params": [
      "tone"
    ],
    "body": {
      "ring": {
        "size": 18,
        "tone": "{tone}_rim",
        "border": 3,
        "children": [
          {
            "disc": {
              "size": 8,
              "tone": "{tone}"
            }
          }
        ]
      }
    }
  }
}