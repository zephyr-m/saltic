{
  "component": {
    "name": "link-row",
    "params": [
      "icon",
      "tone",
      "title",
      "text",
      "size",
      "small"
    ],
    "body": {
      "box": {
        "gap": 3,
        "children": [
          {
            "box": {
              "flow": "row",
              "gap": 8,
              "align": "center",
              "children": [
                {
                  "glyph": {
                    "icon": "{icon}",
                    "tone": "{tone}",
                    "size": 16
                  }
                },
                {
                  "figure": {
                    "text": "{title}",
                    "size": "{size}",
                    "tone": "ink"
                  }
                }
              ]
            }
          },
          {
            "scaled": {
              "text": "{text}",
              "tone": "quiet",
              "size": "{small}"
            }
          }
        ]
      }
    }
  }
}