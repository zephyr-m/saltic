{
  "component": {
    "name": "link-row",
    "params": [
      "icon",
      "tone",
      "title",
      "text",
      "size",
      "small"
    ],
    "body": {
      "box": {
        "gap": 3,
        "cross": "stretch",
        "children": [
          {
            "box": {
              "flow": "row",
              "gap": 8,
              "cross": "center",
              "children": [
                {
                  "box": {
                    "width": 16,
                    "height": 16,
                    "icon": "{icon}",
                    "ink": "{tone}",
                    "gap": 0
                  }
                },
                {
                  "text": {
                    "value": "{title}",
                    "weight": "bold",
                    "tone": "ink",
                    "size": "{size}"
                  }
                }
              ]
            }
          },
          {
            "text": {
              "value": "{text}",
              "tone": "quiet",
              "size": "{small}"
            }
          }
        ]
      }
    }
  }
}
