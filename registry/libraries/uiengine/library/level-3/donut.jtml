{
  "component": {
    "name": "donut",
    "params": [
      "size",
      "first",
      "second",
      "third",
      "note"
    ],
    "body": {
      "box": {
        "width": "{size}",
        "height": "{size}",
        "gap": 0,
        "layers": [
          {
            "layer": {
              "name": "первая",
              "gap": 0,
              "justify": "center",
              "align": "center",
              "children": [
                {
                  "arc": {
                    "size": "{size}",
                    "tone": "accent",
                    "border": 18,
                    "sweep": "{first}",
                    "start": -90
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "вторая",
              "gap": 0,
              "justify": "center",
              "align": "center",
              "children": [
                {
                  "arc": {
                    "size": "{size}",
                    "tone": "up",
                    "border": 18,
                    "sweep": "{second}",
                    "start": "{third}"
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "подпись",
              "gap": 0,
              "justify": "center",
              "align": "center",
              "children": [
                {
                  "hint": {
                    "text": "{note}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}