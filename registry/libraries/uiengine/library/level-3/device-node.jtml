{
  "component": {
    "name": "device-node",
    "params": [
      "id",
      "x",
      "y",
      "icon",
      "name",
      "kind",
      "state",
      "tone",
      "first",
      "second"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "at": [
          "{x}",
          "{y}"
        ],
        "width": 280,
        "gap": 0,
        "children": [
          {
            "pane": {
              "radius": 14,
              "children": [
                {
                  "box": {
                    "padding": 16,
                    "gap": 8,
                    "children": [
                      {
                        "box": {
                          "flow": "row",
                          "gap": 10,
                          "align": "center",
                          "children": [
                            {
                              "glyph": {
                                "icon": "{icon}",
                                "tone": "{tone}",
                                "size": 20
                              }
                            },
                            {
                              "headline": {
                                "text": "{name}",
                                "grow": 1
                              }
                            },
                            {
                              "badge": {
                                "text": "{state}",
                                "tone": "{tone}"
                              }
                            }
                          ]
                        }
                      },
                      {
                        "hint": {
                          "text": "{kind}"
                        }
                      },
                      {
                        "console-line": {
                          "text": "{first}",
                          "tone": "ink",
                          "size": 12
                        }
                      },
                      {
                        "console-line": {
                          "text": "{second}",
                          "tone": "quiet",
                          "size": 11
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}