              "tone": "{tone}"
            }
          },
          {
            "number": {
              "text": "{amount}",
              "tone": "ink"
            }
          },
          {
            "tinted": {
              "text": "{side}",
              "tone": "{tone}"
            }
          }
        ]
      }
    }
  }
}
