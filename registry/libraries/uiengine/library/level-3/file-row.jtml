{
  "component": {
    "name": "file-row",
    "params": [
      "id",
      "name",
      "indent"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "flow": "row",
        "height": 26,
        "gap": 8,
        "align": "center",
        "children": [
          {
            "box": {
              "width": "{indent}",
              "gap": 0
            }
          },
          {
            "coin": {}
          },
          {
            "words": {
              "text": "{name}"
            }
          }
        ]
      }
    }
  }
}