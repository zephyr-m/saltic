{
  "component": {
    "name": "file-row",
    "params": [
      "id",
      "name",
      "indent"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "flow": "row",
        "height": 26,
        "gap": 8,
        "align": "center",
        "children": [
          {
            "gap": {
              "width": "{indent}"
            }
          },
          {
            "coin": {}
          },
          {
            "text": {
              "value": "{name}",
              "size": 13
            }
          }
        ]
      }
    }
  }
}
