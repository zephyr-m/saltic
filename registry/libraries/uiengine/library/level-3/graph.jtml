{
  "component": {
    "name": "graph",
    "params": [
      "title",
      "bars",
      "note",
      "size",
      "small"
    ],
    "body": {
      "box": {
        "gap": 5,
        "children": [
          {
            "scaled": {
              "text": "{title}",
              "tone": "ink",
              "size": "{size}"
            }
          },
          {
            "cell": {
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "height": 56,
                    "padding": [
                      4,
                      4,
                      0,
                      4
                    ],
                    "gap": 1,
                    "align": "end",
                    "children": [
                      "{bars}"
                    ]
                  }
                }
              ],
              "fill": "well"
            }
          },
          {
            "scaled": {
              "text": "{note}",
              "tone": "quiet",
              "size": "{small}"
            }
          }
        ]
      }
    }
  }
}