{
  "component": {
    "name": "graph",
    "params": [
      "title",
      "bars",
      "note",
      "size",
      "small"
    ],
    "body": {
      "box": {
        "gap": 5,
        "cross": "stretch",
        "children": [
          {
            "text": {
              "value": "{title}",
              "tone": "ink",
              "size": "{size}"
            }
          },
          {
            "box": {
              "flow": "row",
              "fill": "well",
              "radius": 6,
              "height": 56,
              "padding": [
                4,
                4,
                0,
                4
              ],
              "gap": 1,
              "cross": "end",
              "children": [
                "{bars}"
              ]
            }
          },
          {
            "text": {
              "value": "{note}",
              "tone": "quiet",
              "size": "{small}"
            }
          }
        ]
      }
    }
  }
}
