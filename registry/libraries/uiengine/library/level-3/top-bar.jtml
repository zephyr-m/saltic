{
  "component": {
    "name": "top-bar",
    "params": [
      "height",
      "children"
    ],
    "body": {
      "box": {
        "gap": 0,
        "children": [
          {
            "plate": {
              "tone": "ground",
              "children": [
                {
                  "box": {
                    "height": "{height}",
                    "padding": [
                      0,
                      16,
                      0,
                      16
                    ],
                    "justify": "center",
                    "gap": 0,
                    "children": [
                      "{children}"
                    ]
                  }
                }
              ]
            }
          },
          {
            "bar": {
              "height": 1,
              "tone": "line"
            }
          }
        ]
      }
    }
  }
}