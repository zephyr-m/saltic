{
  "component": {
    "name": "mode-bar",
    "params": [
      "modes",
      "branch",
      "target",
      "place",
      "errors"
    ],
    "body": {
      "plate": {
        "tone": "panel",
        "children": [
          {
            "box": {
              "flow": "row",
              "height": 46,
              "padding": [
                0,
                14,
                0,
                14
              ],
              "gap": 16,
              "align": "center",
              "children": [
                {
                  "cell": {
                    "children": [
                      {
                        "box": {
                          "flow": "row",
                          "padding": 3,
                          "gap": 2,
                          "children": [
                            "{modes}"
                          ]
                        }
                      }
                    ],
                    "fill": "raise"
                  }
                },
                {
                  "box": {
                    "grow": 1,
                    "gap": 0
                  }
                },
                {
                  "status": {
                    "icon": "git-branch",
                    "text": "{branch}",
                    "tone": "quiet",
                    "mono": "yes"
                  }
                },
                {
                  "status": {
                    "icon": "target",
                    "text": "{target}",
                    "tone": "quiet",
                    "mono": "yes"
                  }
                },
                {
                  "status": {
                    "icon": "text-cursor",
                    "text": "{place}",
                    "tone": "quiet",
                    "mono": "yes"
                  }
                },
                {
                  "status": {
                    "icon": "circle-alert",
                    "text": "{errors}",
                    "tone": "down",
                    "mono": "no"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}