{
  "component": {
    "name": "mode-bar",
    "params": [
      "modes",
      "branch",
      "target",
      "place",
      "errors"
    ],
    "body": {
      "box": {
        "flow": "row",
        "height": 46,
        "fill": "panel",
        "padding": [
          0,
          14,
          0,
          14
        ],
        "gap": 16,
        "align": "center",
        "children": [
          {
            "box": {
              "flow": "row",
              "fill": "raise",
              "radius": 10,
              "padding": 3,
              "gap": 2,
              "children": [
                "{modes}"
              ],
              "inset": 2
            }
          },
          {
            "gap": {
              "grow": 1
            }
          },
          {
            "status": {
              "icon": "git-branch",
              "text": "{branch}",
              "tone": "quiet",
              "mono": "yes"
            }
          },
          {
            "status": {
              "icon": "target",
              "text": "{target}",
              "tone": "quiet",
              "mono": "yes"
            }
          },
          {
            "status": {
              "icon": "text-cursor",
              "text": "{place}",
              "tone": "quiet",
              "mono": "yes"
            }
          },
          {
            "status": {
              "icon": "circle-alert",
              "text": "{errors}",
              "tone": "down",
              "mono": "no"
            }
          }
        ]
      }
    }
  }
}
