{
  "component": {
    "name": "wire",
    "params": [
      "x",
      "y",
      "width",
      "height",
      "tone"
    ],
    "body": {
      "box": {
        "at": [
          "{x}",
          "{y}"
        ],
        "gap": 0,
        "children": [
          {
            "bar": {
              "width": "{width}",
              "height": "{height}",
              "tone": "{tone}",
              "radius": 1
            }
          }
        ]
      }
    }
  }
}