{
  "component": {
    "name": "program-tile",
    "params": [
      "name",
      "icon",
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "fill": "{fill}",
        "edge": "line",
        "border": 1,
        "radius": 10,
        "padding": [
          7,
          12,
          7,
          10
        ],
        "gap": 8,
        "align": "center",
        "children": [
          {
            "box": {
              "width": 16,
              "height": 16,
              "icon": "{icon}",
              "ink": "{tone}",
              "gap": 0
            }
          },
          {
            "text": {
              "value": "{name}",
              "size": 13,
              "tone": "{tone}"
            }
          }
        ]
      }
    }
  }
}
