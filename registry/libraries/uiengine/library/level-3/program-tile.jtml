{
  "component": {
    "name": "program-tile",
    "params": [
      "name",
      "icon",
      "fill",
      "tone"
    ],
    "body": {
      "cell": {
        "children": [
          {
            "box": {
              "flow": "row",
              "padding": [
                7,
                12,
                7,
                10
              ],
              "gap": 8,
              "align": "center",
              "children": [
                {
                  "glyph": {
                    "icon": "{icon}",
                    "tone": "{tone}",
                    "size": 16
                  }
                },
                {
                  "words": {
                    "text": "{name}",
                    "tone": "{tone}"
                  }
                }
              ]
            }
          }
        ],
        "fill": "{fill}",
        "edge": "line"
      }
    }
  }
}