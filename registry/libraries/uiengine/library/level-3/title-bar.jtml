{
  "component": {
    "name": "title-bar",
    "params": [
      "path"
    ],
    "body": {
      "plate": {
        "tone": "panel",
        "children": [
          {
            "box": {
              "flow": "row",
              "height": 42,
              "padding": [
                0,
                14,
                0,
                14
              ],
              "gap": 10,
              "align": "center",
              "children": [
                {
                  "coin": {}
                },
                {
                  "console-line": {
                    "text": "{path}",
                    "tone": "quiet",
                    "size": 13
                  }
                },
                {
                  "box": {
                    "grow": 1,
                    "gap": 0
                  }
                },
                {
                  "pill": {
                    "text": "тема"
                  }
                },
                {
                  "pill": {
                    "text": "весь экран"
                  }
                },
                {
                  "box": {
                    "width": 10,
                    "gap": 0
                  }
                },
                {
                  "window-button": {
                    "id": "minimize",
                    "icon": "arrow-down",
                    "tone": "mustard"
                  }
                },
                {
                  "box": {
                    "width": 2,
                    "gap": 0
                  }
                },
                {
                  "window-button": {
                    "id": "close",
                    "icon": "x",
                    "tone": "watermelon"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}