{
  "component": {
    "name": "title-bar",
    "params": [
      "path"
    ],
    "body": {
      "box": {
        "flow": "row",
        "height": 42,
        "fill": "panel",
        "padding": [
          0,
          14,
          0,
          14
        ],
        "gap": 10,
        "align": "center",
        "children": [
          {
            "coin": {}
          },
          {
            "text": {
              "value": "{path}",
              "mono": "yes",
              "size": 13,
              "tone": "quiet"
            }
          },
          {
            "gap": {
              "grow": 1
            }
          },
          {
            "pill": {
              "text": "тема"
            }
          },
          {
            "pill": {
              "text": "весь экран"
            }
          },
          {
            "gap": {
              "width": 10
            }
          },
          {
            "window-button": {
              "id": "minimize",
              "icon": "arrow-down",
              "tone": "mustard"
            }
          },
          {
            "gap": {
              "width": 2
            }
          },
          {
            "window-button": {
              "id": "close",
              "icon": "x",
              "tone": "watermelon"
            }
          }
        ]
      }
    }
  }
}
