{
  "component": {
    "name": "column-head",
    "params": [
      "title",
      "count"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 8,
        "align": "center",
        "children": [
          {
            "headline": {
              "text": "{title}",
              "grow": 1
            }
          },
          {
            "number-badge": {
              "text": "{count}",
              "fill": "well",
              "tone": "quiet"
            }
          }
        ]
      }
    }
  }
}