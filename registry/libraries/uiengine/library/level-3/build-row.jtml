{
  "component": {
    "name": "build-row",
    "params": [
      "name",
      "target",
      "state",
      "tone",
      "author",
      "time"
    ],
    "body": {
      "box": {
        "gap": 0,
        "children": [
          {
            "bar": {
              "height": 1,
              "tone": "line"
            }
          },
          {
            "box": {
              "flow": "row",
              "height": 40,
              "padding": [
                0,
                10,
                0,
                10
              ],
              "align": "center",
              "gap": 0,
              "children": [
                {
                  "box": {
                    "width": 260,
                    "gap": 0,
                    "children": [
                      {
                        "words": {
                          "text": "{name}",
                          "weight": "bold"
                        }
                      }
                    ]
                  }
                },
                {
                  "box": {
                    "width": 250,
                    "gap": 0,
                    "children": [
                      {
                        "console-line": {
                          "text": "{target}",
                          "tone": "quiet",
                          "size": 12
                        }
                      }
                    ]
                  }
                },
                {
                  "box": {
                    "width": 200,
                    "align": "start",
                    "gap": 0,
                    "children": [
                      {
                        "badge": {
                          "text": "{state}",
                          "tone": "{tone}"
                        }
                      }
                    ]
                  }
                },
                {
                  "box": {
                    "grow": 1,
                    "gap": 0,
                    "children": [
                      {
                        "console-line": {
                          "text": "{author}",
                          "tone": "quiet",
                          "size": 12
                        }
                      }
                    ]
                  }
                },
                {
                  "console-line": {
                    "text": "{time}",
                    "size": 12
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}