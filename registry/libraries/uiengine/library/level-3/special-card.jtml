{
  "component": {
    "name": "special-card",
    "params": [
      "title",
      "note",
      "width",
      "height"
    ],
    "body": {
      "pane": {
        "radius": 14,
        "width": "{width}",
        "children": [
          {
            "box": {
              "height": "{height}",
              "padding": [
                0,
                14,
                14,
                14
              ],
              "gap": 6,
              "justify": "end",
              "children": [
                {
                  "headline": {
                    "text": "{title}"
                  }
                },
                {
                  "words": {
                    "text": "{note}",
                    "tone": "quiet"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}