{
  "component": {
    "name": "special-card",
    "params": [
      "title",
      "note",
      "width",
      "height"
    ],
    "body": {
      "box": {
        "width": "{width}",
        "height": "{height}",
        "radius": 14,
        "fill": "panel",
        "edge": "line",
        "shadow": 6,
        "padding": [
          0,
          14,
          14,
          14
        ],
        "gap": 6,
        "justify": "end",
        "children": [
          {
            "text": {
              "value": "{title}",
              "size": 15,
              "tone": "ink",
              "cut": "yes"
            }
          },
          {
            "text": {
              "value": "{note}",
              "size": 13,
              "tone": "quiet"
            }
          }
        ]
      }
    }
  }
}
