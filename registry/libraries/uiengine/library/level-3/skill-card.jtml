{
  "component": {
    "name": "skill-card",
    "params": [
      "name",
      "signature",
      "about",
      "errors",
      "line"
    ],
    "body": {
      "cell": {
        "children": [
          {
            "box": {
              "padding": 14,
              "gap": 6,
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "gap": 0,
                    "children": [
                      {
                        "console-line": {
                          "text": "{name}",
                          "tone": "up",
                          "size": 13
                        }
                      },
                      {
                        "console-line": {
                          "text": "{signature}",
                          "size": 13
                        }
                      }
                    ]
                  }
                },
                {
                  "label": {
                    "text": "{about}"
                  }
                },
                {
                  "words": {
                    "text": "{errors}",
                    "tone": "down"
                  }
                },
                {
                  "console-line": {
                    "text": "{line}",
                    "tone": "gutter",
                    "size": 13
                  }
                }
              ]
            }
          }
        ],
        "fill": "ground",
        "edge": "line"
      }
    }
  }
}