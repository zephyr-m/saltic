{
  "component": {
    "name": "skill-card",
    "params": [
      "name",
      "signature",
      "about",
      "errors",
      "line"
    ],
    "body": {
      "box": {
        "edge": "line",
        "radius": 10,
        "fill": "ground",
        "padding": 14,
        "gap": 6,
        "children": [
          {
            "box": {
              "flow": "row",
              "gap": 0,
              "children": [
                {
                  "text": {
                    "value": "{name}",
                    "mono": "yes",
                    "tone": "up",
                    "weight": "bold",
                    "size": 13
                  }
                },
                {
                  "text": {
                    "value": "{signature}",
                    "mono": "yes",
                    "size": 13
                  }
                }
              ]
            }
          },
          {
            "label": {
              "text": "{about}"
            }
          },
          {
            "text": {
              "value": "{errors}",
              "tone": "down",
              "size": 13
            }
          },
          {
            "text": {
              "value": "{line}",
              "mono": "yes",
              "tone": "gutter",
              "size": 13
            }
          }
        ],
        "shadow": 14
      }
    }
  }
}
