{
  "component": {
    "name": "event-row",
    "params": [
      "time",
      "text"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 10,
        "align": "center",
        "children": [
          {
            "text": {
              "value": "{time}",
              "size": 12,
              "tone": "quiet",
              "width": 82
            }
          },
          {
            "text": {
              "value": "{text}",
              "size": 13,
              "grow": 1,
              "cut": "yes"
            }
          }
        ]
      }
    }
  }
}
