{
  "component": {
    "name": "detail-row",
    "params": [
      "label",
      "value"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 12,
        "align": "center",
        "padding": [
          3,
          0,
          3,
          0
        ],
        "children": [
          {
            "box": {
              "width": 150,
              "gap": 0,
              "children": [
                {
                  "hint": {
                    "text": "{label}"
                  }
                }
              ]
            }
          },
          {
            "words": {
              "text": "{value}",
              "grow": 1
            }
          }
        ]
      }
    }
  }
}