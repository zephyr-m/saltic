{
  "component": {
    "name": "order-book",
    "params": [
      "asks",
      "mid",
      "bids"
    ],
    "body": {
      "card": {
        "gap": 8,
        "padding": 12,
        "width": 250,
        "children": [
          {
            "caption": {
              "text": "стакан"
            }
          },
          {
            "box": {
              "flow": "row",
              "gap": 8,
              "children": [
                {
                  "caption": {
                    "text": "цена"
                  }
                },
                {
                  "box": {
                    "grow": 1,
                    "gap": 0
                  }
                },
                {
                  "caption": {
                    "text": "кол-во"
                  }
                }
              ]
            }
          },
          {
            "cell": {
              "fill": "well",
              "children": [
                {
                  "box": {
                    "padding": 6,
                    "gap": 3,
                    "children": [
                      "{asks}",
                      {
                        "number": {
                          "text": "{mid}",
                          "tone": "accent",
                          "align": "center"
                        }
                      },
                      "{bids}"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}