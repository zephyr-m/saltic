{
  "component": {
    "name": "pie",
    "params": [
      "size",
      "first",
      "second",
      "third"
    ],
    "body": {
      "box": {
        "width": "{size}",
        "height": "{size}",
        "gap": 0,
        "layers": [
          {
            "layer": {
              "name": "основа",
              "gap": 0,
              "justify": "center",
              "align": "center",
              "children": [
                {
                  "disc": {
                    "size": "{size}",
                    "tone": "raise"
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "первая",
              "gap": 0,
              "justify": "center",
              "align": "center",
              "children": [
                {
                  "sector": {
                    "size": "{size}",
                    "tone": "accent",
                    "sweep": "{first}",
                    "start": -90
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "вторая",
              "gap": 0,
              "justify": "center",
              "align": "center",
              "children": [
                {
                  "sector": {
                    "size": "{size}",
                    "tone": "up",
                    "sweep": "{second}",
                    "start": "{third}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}