{
  "component": {
    "name": "item-row",
    "params": [
      "id",
      "number",
      "mark",
      "text",
      "time",
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 8,
        "align": "center",
        "children": [
          {
            "number-badge": {
              "text": "{number}",
              "fill": "{fill}",
              "tone": "{tone}"
            }
          },
          {
            "box": {
              "id": "{id}",
              "grow": 1,
              "gap": 0,
              "children": [
                {
                  "words": {
                    "text": "{mark} {text}"
                  }
                }
              ]
            }
          },
          {
            "hint": {
              "text": "{time}"
            }
          }
        ]
      }
    }
  }
}