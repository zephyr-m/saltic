{
  "component": {
    "name": "item-row",
    "params": [
      "id",
      "number",
      "mark",
      "text",
      "time",
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 8,
        "align": "center",
        "children": [
          {
            "number-badge": {
              "text": "{number}",
              "fill": "{fill}",
              "tone": "{tone}"
            }
          },
          {
            "text": {
              "value": "{mark} {text}",
              "id": "{id}",
              "size": 13,
              "grow": 1,
              "cut": "yes"
            }
          },
          {
            "text": {
              "value": "{time}",
              "size": 12,
              "tone": "quiet"
            }
          }
        ]
      }
    }
  }
}
