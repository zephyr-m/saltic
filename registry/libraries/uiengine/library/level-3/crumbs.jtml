{
  "component": {
    "name": "crumbs",
    "params": [
      "path",
      "badge",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 10,
        "align": "center",
        "children": [
          {
            "console-line": {
              "text": "{path}",
              "tone": "quiet",
              "size": 12
            }
          },
          {
            "box": {
              "grow": 1,
              "gap": 0
            }
          },
          {
            "badge": {
              "text": "{badge}",
              "tone": "{tone}"
            }
          }
        ]
      }
    }
  }
}