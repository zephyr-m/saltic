{
  "component": {
    "name": "floor-bar",
    "params": [
      "label",
      "count",
      "width",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 12,
        "align": "center",
        "height": 36,
        "children": [
          {
            "box": {
              "width": 120,
              "gap": 0,
              "children": [
                {
                  "hint": {
                    "text": "{label}"
                  }
                }
              ]
            }
          },
          {
            "box": {
              "grow": 1,
              "flow": "row",
              "justify": "center",
              "align": "center",
              "gap": 0,
              "children": [
                {
                  "bar": {
                    "width": "{width}",
                    "height": 28,
                    "tone": "{tone}",
                    "radius": 6
                  }
                }
              ]
            }
          },
          {
            "box": {
              "width": 50,
              "flow": "row",
              "justify": "end",
              "gap": 0,
              "children": [
                {
                  "readout": {
                    "text": "{count}",
                    "tone": "{tone}",
                    "size": 15
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}