{
  "component": {
    "name": "search-box",
    "params": [
      "text",
      "hint",
      "tone"
    ],
    "body": {
      "cell": {
        "fill": "well",
        "edge": "{tone}",
        "children": [
          {
            "box": {
              "flow": "row",
              "height": 40,
              "padding": [
                0,
                14,
                0,
                14
              ],
              "gap": 10,
              "align": "center",
              "children": [
                {
                  "glyph": {
                    "icon": "search",
                    "tone": "quiet",
                    "size": 16
                  }
                },
                {
                  "words": {
                    "text": "{text}",
                    "grow": 1
                  }
                },
                {
                  "hint": {
                    "text": "{hint}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}