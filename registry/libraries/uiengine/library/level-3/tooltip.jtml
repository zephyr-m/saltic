{
  "component": {
    "name": "tooltip",
    "params": [
      "text",
      "note",
      "x",
      "y"
    ],
    "body": {
      "box": {
        "at": [
          "{x}",
          "{y}"
        ],
        "gap": 0,
        "children": [
          {
            "cell": {
              "fill": "raise",
              "edge": "line",
              "children": [
                {
                  "box": {
                    "padding": [
                      8,
                      12,
                      8,
                      12
                    ],
                    "gap": 2,
                    "children": [
                      {
                        "words": {
                          "text": "{text}",
                          "weight": "bold"
                        }
                      },
                      {
                        "hint": {
                          "text": "{note}"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}