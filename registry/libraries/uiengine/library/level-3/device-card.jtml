{
  "component": {
    "name": "device-card",
    "params": [
      "name",
      "kind",
      "state",
      "tone",
      "grow",
      "one",
      "one_value",
      "one_fill",
      "one_tone",
      "two",
      "two_value",
      "two_fill",
      "two_tone"
    ],
    "body": {
      "card": {
        "gap": 12,
        "padding": 16,
        "grow": "{grow}",
        "children": [
          {
            "box": {
              "flow": "row",
              "gap": 8,
              "align": "center",
              "children": [
                {
                  "headline": {
                    "text": "{name}",
                    "grow": 1
                  }
                },
                {
                  "badge": {
                    "text": "{state}",
                    "tone": "{tone}"
                  }
                }
              ]
            }
          },
          {
            "hint": {
              "text": "{kind}"
            }
          },
          {
            "box": {
              "gap": 6,
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "align": "center",
                    "gap": 0,
                    "children": [
                      {
                        "words": {
                          "text": "{one}",
                          "grow": 1
                        }
                      },
                      {
                        "console-line": {
                          "text": "{one_value}",
                          "tone": "quiet",
                          "size": 11
                        }
                      }
                    ]
                  }
                },
                {
                  "meter": {
                    "fill": "{one_fill}",
                    "tone": "{one_tone}"
                  }
                }
              ]
            }
          },
          {
            "box": {
              "gap": 6,
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "align": "center",
                    "gap": 0,
                    "children": [
                      {
                        "words": {
                          "text": "{two}",
                          "grow": 1
                        }
                      },
                      {
                        "console-line": {
                          "text": "{two_value}",
                          "tone": "quiet",
                          "size": 11
                        }
                      }
                    ]
                  }
                },
                {
                  "meter": {
                    "fill": "{two_fill}",
                    "tone": "{two_tone}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}