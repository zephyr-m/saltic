{
  "component": {
    "name": "dial",
    "params": [
      "size",
      "sweep",
      "tone",
      "value",
      "note"
    ],
    "body": {
      "box": {
        "gap": 4,
        "align": "center",
        "children": [
          {
            "box": {
              "width": "{size}",
              "height": "{size}",
              "gap": 0,
              "layers": [
                {
                  "layer": {
                    "name": "дорожка",
                    "gap": 0,
                    "justify": "center",
                    "align": "center",
                    "children": [
                      {
                        "arc": {
                          "size": "{size}",
                          "tone": "raise",
                          "border": 12,
                          "sweep": 180,
                          "start": 180
                        }
                      }
                    ]
                  }
                },
                {
                  "layer": {
                    "name": "дуга",
                    "gap": 0,
                    "justify": "center",
                    "align": "center",
                    "children": [
                      {
                        "arc": {
                          "size": "{size}",
                          "tone": "{tone}",
                          "border": 12,
                          "sweep": "{sweep}",
                          "start": 180
                        }
                      }
                    ]
                  }
                },
                {
                  "layer": {
                    "name": "число",
                    "gap": 0,
                    "justify": "center",
                    "align": "center",
                    "children": [
                      {
                        "readout": {
                          "text": "{value}",
                          "tone": "{tone}",
                          "size": 22
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "hint": {
              "text": "{note}"
            }
          }
        ]
      }
    }
  }
}