{
  "component": {
    "name": "side-plate",
    "params": [
      "width",
      "children"
    ],
    "body": {
      "plate": {
        "tone": "side",
        "children": [
          {
            "box": {
              "width": "{width}",
              "padding": [
                16,
                12,
                16,
                12
              ],
              "gap": 4,
              "grow": 1,
              "children": [
                "{children}"
              ]
            }
          }
        ]
      }
    }
  }
}