{
  "component": {
    "name": "message-row",
    "params": [
      "time",
      "author",
      "text"
    ],
    "body": {
      "box": {
        "gap": 2,
        "children": [
          {
            "hint": {
              "text": "{time} · {author}"
            }
          },
          {
            "words": {
              "text": "{text}"
            }
          }
        ]
      }
    }
  }
}