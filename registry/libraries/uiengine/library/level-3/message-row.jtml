{
  "component": {
    "name": "message-row",
    "params": [
      "time",
      "author",
      "text"
    ],
    "body": {
      "box": {
        "gap": 2,
        "children": [
          {
            "text": {
              "value": "{time} · {author}",
              "size": 12,
              "tone": "quiet"
            }
          },
          {
            "text": {
              "value": "{text}",
              "size": 13,
              "cut": "yes"
            }
          }
        ]
      }
    }
  }
}
