{
  "component": {
    "name": "avatar",
    "params": [
      "letters",
      "tone"
    ],
    "body": {
      "ring": {
        "size": 48,
        "tone": "{tone}_rim",
        "border": 2,
        "children": [
          {
            "disc": {
              "size": 40,
              "tone": "{tone}_soft",
              "children": [
                {
                  "words": {
                    "text": "{letters}",
                    "tone": "{tone}",
                    "weight": "bold"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}