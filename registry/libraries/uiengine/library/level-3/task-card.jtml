{
  "component": {
    "name": "task-card",
    "params": [
      "id",
      "number",
      "name",
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "gap": 0,
        "children": [
          {
            "cell": {
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "padding": [
                      9,
                      12,
                      9,
                      10
                    ],
                    "gap": 10,
                    "align": "center",
                    "children": [
                      {
                        "number-badge": {
                          "text": "{number}",
                          "fill": "{fill}",
                          "tone": "{tone}"
                        }
                      },
                      {
                        "words": {
                          "text": "{name}",
                          "grow": 1
                        }
                      }
                    ]
                  }
                }
              ],
              "fill": "well",
              "edge": "line"
            }
          }
        ]
      }
    }
  }
}