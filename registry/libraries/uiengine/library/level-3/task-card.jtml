{
  "component": {
    "name": "task-card",
    "params": [
      "id",
      "number",
      "name",
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "fill": "ground",
        "edge": "line",
        "radius": 10,
        "shadow": 3,
        "padding": [
          9,
          12,
          9,
          10
        ],
        "gap": 10,
        "align": "center",
        "children": [
          {
            "number-badge": {
              "text": "{number}",
              "fill": "{fill}",
              "tone": "{tone}"
            }
          },
          {
            "text": {
              "value": "{name}",
              "id": "{id}",
              "size": 14,
              "grow": 1,
              "cut": "yes"
            }
          }
        ]
      }
    }
  }
}
