{
  "component": {
    "name": "target",
    "params": [
      "size",
      "tone"
    ],
    "body": {
      "ring": {
        "size": "{size}",
        "tone": "{tone}_rim",
        "border": 2,
        "children": [
          {
            "ring": {
              "size": 96,
              "tone": "{tone}_mid",
              "border": 2,
              "children": [
                {
                  "ring": {
                    "size": 56,
                    "tone": "{tone}",
                    "border": 2,
                    "children": [
                      {
                        "disc": {
                          "size": 16,
                          "tone": "{tone}"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}