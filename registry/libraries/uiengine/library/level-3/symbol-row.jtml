{
  "component": {
    "name": "symbol-row",
    "params": [
      "name",
      "tone",
      "at"
    ],
    "body": {
      "box": {
        "flow": "row",
        "height": 24,
        "padding": [
          0,
          6,
          0,
          10
        ],
        "gap": 8,
        "align": "center",
        "children": [
          {
            "words": {
              "text": "{name}",
              "tone": "{tone}"
            }
          },
          {
            "box": {
              "grow": 1,
              "gap": 0
            }
          },
          {
            "console-line": {
              "text": "{at}",
              "tone": "gutter",
              "size": 13
            }
          }
        ]
      }
    }
  }
}