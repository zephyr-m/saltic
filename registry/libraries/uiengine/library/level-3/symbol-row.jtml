{
  "component": {
    "name": "symbol-row",
    "params": [
      "name",
      "tone",
      "at"
    ],
    "body": {
      "box": {
        "flow": "row",
        "height": 24,
        "padding": [
          0,
          6,
          0,
          10
        ],
        "gap": 8,
        "align": "center",
        "children": [
          {
            "text": {
              "value": "{name}",
              "tone": "{tone}",
              "size": 13
            }
          },
          {
            "gap": {
              "grow": 1
            }
          },
          {
            "text": {
              "value": "{at}",
              "mono": "yes",
              "tone": "gutter",
              "size": 13
            }
          }
        ]
      }
    }
  }
}
