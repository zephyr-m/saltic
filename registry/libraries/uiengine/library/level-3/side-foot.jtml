{
  "component": {
    "name": "side-foot",
    "params": [
      "text",
      "note"
    ],
    "body": {
      "cell": {
        "fill": "well",
        "children": [
          {
            "box": {
              "padding": [
                10,
                12,
                10,
                12
              ],
              "gap": 4,
              "children": [
                {
                  "console-line": {
                    "text": "{text}",
                    "tone": "quiet",
                    "size": 11
                  }
                },
                {
                  "console-line": {
                    "text": "{note}",
                    "tone": "quiet",
                    "size": 11
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}