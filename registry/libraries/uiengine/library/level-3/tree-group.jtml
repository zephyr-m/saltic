{
  "component": {
    "name": "tree-group",
    "params": [
      "id",
      "chevron",
      "text",
      "count"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "flow": "row",
        "height": 34,
        "padding": [
          0,
          8,
          0,
          8
        ],
        "gap": 8,
        "align": "center",
        "children": [
          {
            "glyph": {
              "icon": "{chevron}",
              "tone": "quiet",
              "size": 14
            }
          },
          {
            "caption": {
              "text": "{text}"
            }
          },
          {
            "box": {
              "grow": 1,
              "gap": 0
            }
          },
          {
            "hint": {
              "text": "{count}"
            }
          }
        ]
      }
    }
  }
}