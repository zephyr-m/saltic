{
  "component": {
    "name": "page-head",
    "params": [
      "title",
      "note",
      "badge",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 12,
        "align": "end",
        "children": [
          {
            "box": {
              "grow": 1,
              "gap": 4,
              "children": [
                {
                  "figure": {
                    "text": "{title}",
                    "size": 26,
                    "tone": "ink"
                  }
                },
                {
                  "words": {
                    "text": "{note}",
                    "tone": "quiet"
                  }
                }
              ]
            }
          },
          {
            "badge": {
              "text": "{badge}",
              "tone": "{tone}"
            }
          }
        ]
      }
    }
  }
}