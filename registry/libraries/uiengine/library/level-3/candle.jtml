{
  "component": {
    "name": "candle",
    "params": [
      "space",
      "size",
      "tone",
      "height"
    ],
    "body": {
      "box": {
        "width": 9,
        "height": "{height}",
        "gap": 0,
        "children": [
          {
            "gap": {
              "height": "{space}"
            }
          },
          {
            "bar": {
              "width": 7,
              "height": "{size}",
              "tone": "{tone}"
            }
          }
        ]
      }
    }
  }
}
