{
  "component": {
    "name": "chart",
    "params": [
      "title",
      "height",
      "grid",
      "candles",
      "line",
      "mark",
      "labels",
      "volume",
      "volumes"
    ],
    "body": {
      "card": {
        "gap": 6,
        "padding": 12,
        "grow": 1,
        "children": [
          {
            "caption": {
              "text": "{title}"
            }
          },
          {
            "box": {
              "flow": "row",
              "gap": 6,
              "height": "{height}",
              "children": [
                {
                  "cell": {
                    "fill": "well",
                    "grow": 1,
                    "children": [
                      {
                        "box": {
                          "grow": 1,
                          "layers": [
                            {
                              "layer": {
                                "name": "сетка",
                                "gap": 0,
                                "children": [
                                  "{grid}"
                                ]
                              }
                            },
                            {
                              "layer": {
                                "name": "свечи",
                                "flow": "row",
                                "gap": 3,
                                "children": [
                                  "{candles}"
                                ]
                              }
                            },
                            {
                              "layer": {
                                "name": "цена",
                                "gap": 0,
                                "children": [
                                  "{line}"
                                ]
                              }
                            }
                          ],
                          "gap": 0
                        }
                      }
                    ]
                  }
                },
                {
                  "box": {
                    "width": 84,
                    "layers": [
                      {
                        "layer": {
                          "name": "метки",
                          "gap": 0,
                          "children": [
                            "{labels}"
                          ]
                        }
                      },
                      {
                        "layer": {
                          "name": "цена",
                          "gap": 0,
                          "children": [
                            "{mark}"
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "caption": {
              "text": "объём"
            }
          },
          {
            "box": {
              "flow": "row",
              "gap": 3,
              "height": "{volume}",
              "children": [
                "{volumes}"
              ]
            }
          }
        ]
      }
    }
  }
}