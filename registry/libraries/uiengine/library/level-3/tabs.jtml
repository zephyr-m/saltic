{
  "component": {
    "name": "tabs",
    "params": [
      "active",
      "other"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 8,
        "children": [
          {
            "chip": {
              "text": "{active}",
              "fill": "up_soft",
              "tone": "up"
            }
          },
          {
            "chip": {
              "text": "{other}",
              "fill": "panel",
              "tone": "quiet"
            }
          }
        ]
      }
    }
  }
}
