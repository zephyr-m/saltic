{
  "component": {
    "name": "book-row",
    "params": [
      "price",
      "amount",
      "tone",
      "bar"
    ],
    "body": {
      "box": {
        "layers": [
          {
            "layer": {
              "name": "глубина",
              "flow": "row",
              "gap": 0,
              "children": [
                {
                  "gap": {
                    "grow": 1
                  }
                },
                {
                  "bar": {
                    "width": "{bar}",
                    "tone": "{tone}_soft"
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "цифры",
              "flow": "row",
              "gap": 8,
              "children": [
                {
                  "number": {
                    "text": "{price}",
                    "tone": "{tone}",
                    "grow": 1
                  }
                },
                {
                  "number": {
                    "text": "{amount}",
                    "tone": "ink"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
