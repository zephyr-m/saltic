{
  "component": {
    "name": "file-row-current",
    "params": [
      "id",
      "name",
      "indent"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "gap": 0,
        "children": [
          {
            "cell": {
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "height": 26,
                    "gap": 8,
                    "align": "center",
                    "children": [
                      {
                        "box": {
                          "width": "{indent}",
                          "gap": 0
                        }
                      },
                      {
                        "coin": {}
                      },
                      {
                        "words": {
                          "text": "{name}",
                          "weight": "bold"
                        }
                      }
                    ]
                  }
                }
              ],
              "fill": "mustard_soft",
              "edge": "mustard_rim"
            }
          }
        ]
      }
    }
  }
}