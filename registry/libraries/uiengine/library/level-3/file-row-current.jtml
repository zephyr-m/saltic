{
  "component": {
    "name": "file-row-current",
    "params": [
      "id",
      "name",
      "indent"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "height": 26,
        "layers": [
          {
            "layer": {
              "name": "акцент",
              "gap": 0,
              "children": [
                {
                  "box": {
                    "grow": 1,
                    "fill": "accent",
                    "radius": 6,
                    "gap": 0
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "подложка",
              "padding": [
                0,
                0,
                0,
                3
              ],
              "gap": 0,
              "children": [
                {
                  "box": {
                    "grow": 1,
                    "fill": "raise",
                    "radius": 6,
                    "gap": 0
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "файл",
              "flow": "row",
              "gap": 8,
              "align": "center",
              "children": [
                {
                  "gap": {
                    "width": "{indent}"
                  }
                },
                {
                  "coin": {}
                },
                {
                  "text": {
                    "value": "{name}",
                    "weight": "bold",
                    "size": 13
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
