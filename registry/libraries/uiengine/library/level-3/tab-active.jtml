{
  "component": {
    "name": "tab-active",
    "params": [
      "id",
      "text"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "height": 36,
        "padding": [
          2,
          0,
          0,
          0
        ],
        "gap": 0,
        "children": [
          {
            "cell": {
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "height": 34,
                    "padding": [
                      0,
                      14,
                      0,
                      14
                    ],
                    "gap": 8,
                    "align": "center",
                    "children": [
                      {
                        "coin": {}
                      },
                      {
                        "words": {
                          "text": "{text}"
                        }
                      }
                    ]
                  }
                }
              ],
              "fill": "mustard_soft",
              "edge": "mustard_rim"
            }
          }
        ]
      }
    }
  }
}