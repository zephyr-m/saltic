{
  "component": {
    "name": "tab-active",
    "params": [
      "id",
      "text",
      "close"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "height": 36,
        "padding": [
          2,
          0,
          0,
          0
        ],
        "gap": 0,
        "children": [
          {
            "cell": {
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "height": 34,
                    "padding": [
                      0,
                      14,
                      0,
                      14
                    ],
                    "gap": 8,
                    "align": "center",
                    "children": [
                      {
                        "coin": {}
                      },
                      {
                        "words": {
                          "text": "{text}"
                        }
                      },
                      {
                        "box": {
                          "id": "{close}",
                          "padding": [
                            2,
                            2,
                            2,
                            2
                          ],
                          "gap": 0,
                          "children": [
                            {
                              "glyph": {
                                "icon": "x",
                                "tone": "quiet",
                                "size": 12
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ],
              "fill": "mustard_soft",
              "edge": "mustard_rim"
            }
          }
        ]
      }
    }
  }
}