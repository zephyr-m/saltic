{
  "component": {
    "name": "tab-active",
    "params": [
      "id",
      "text"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "height": 36,
        "layers": [
          {
            "layer": {
              "name": "акцент",
              "gap": 0,
              "children": [
                {
                  "box": {
                    "grow": 1,
                    "fill": "accent",
                    "radius": 8,
                    "corners": "top",
                    "gap": 0
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "вкладка",
              "padding": [
                3,
                0,
                0,
                0
              ],
              "gap": 0,
              "children": [
                {
                  "box": {
                    "grow": 1,
                    "fill": "ground",
                    "radius": 8,
                    "corners": "top",
                    "gap": 0
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "имя",
              "flow": "row",
              "padding": [
                0,
                14,
                0,
                14
              ],
              "gap": 8,
              "align": "center",
              "children": [
                {
                  "coin": {}
                },
                {
                  "text": {
                    "value": "{text}",
                    "size": 13
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
