{
  "component": {
    "name": "location-card",
    "params": [
      "title",
      "note",
      "rank",
      "width",
      "height"
    ],
    "body": {
      "box": {
        "width": "{width}",
        "height": "{height}",
        "radius": 14,
        "fill": "panel",
        "edge": "line",
        "shadow": 6,
        "padding": [
          0,
          14,
          14,
          14
        ],
        "gap": 6,
        "justify": "end",
        "children": [
          {
            "box": {
              "flow": "row",
              "gap": 10,
              "align": "center",
              "children": [
                {
                  "text": {
                    "value": "{title}",
                    "size": 15,
                    "tone": "ink",
                    "grow": 1,
                    "cut": "yes"
                  }
                },
                {
                  "rank-coin": {
                    "text": "{rank}"
                  }
                }
              ]
            }
          },
          {
            "text": {
              "value": "{note}",
              "size": 13,
              "tone": "quiet"
            }
          }
        ]
      }
    }
  }
}
