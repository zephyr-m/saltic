{
  "component": {
    "name": "location-card",
    "params": [
      "title",
      "note",
      "rank",
      "width",
      "height"
    ],
    "body": {
      "pane": {
        "radius": 14,
        "width": "{width}",
        "children": [
          {
            "box": {
              "height": "{height}",
              "padding": [
                0,
                14,
                14,
                14
              ],
              "gap": 6,
              "justify": "end",
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "gap": 10,
                    "align": "center",
                    "children": [
                      {
                        "headline": {
                          "text": "{title}",
                          "grow": 1
                        }
                      },
                      {
                        "rank-coin": {
                          "text": "{rank}"
                        }
                      }
                    ]
                  }
                },
                {
                  "words": {
                    "text": "{note}",
                    "tone": "quiet"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}