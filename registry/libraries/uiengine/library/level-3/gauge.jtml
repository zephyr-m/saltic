{
  "component": {
    "name": "gauge",
    "params": [
      "label",
      "fill",
      "tone",
      "text",
      "size",
      "small"
    ],
    "body": {
      "box": {
        "gap": 5,
        "cross": "stretch",
        "children": [
          {
            "text": {
              "value": "{label}",
              "tone": "ink",
              "size": "{size}"
            }
          },
          {
            "meter": {
              "fill": "{fill}",
              "tone": "{tone}"
            }
          },
          {
            "text": {
              "value": "{text}",
              "tone": "quiet",
              "size": "{small}"
            }
          }
        ]
      }
    }
  }
}
