{
  "component": {
    "name": "editor",
    "params": [
      "tabs",
      "lines",
      "scroll"
    ],
    "body": {
      "box": {
        "grow": 1,
        "fill": "ground",
        "gap": 0,
        "children": [
          {
            "box": {
              "flow": "row",
              "height": 36,
              "fill": "panel",
              "gap": 0,
              "children": [
                "{tabs}",
                {
                  "gap": {
                    "grow": 1
                  }
                }
              ]
            }
          },
          {
            "bar": {
              "height": 1,
              "tone": "line"
            }
          },
          {
            "box": {
              "flow": "row",
              "grow": 1,
              "gap": 6,
              "cross": "stretch",
              "padding": [
                10,
                6,
                10,
                0
              ],
              "children": [
                {
                  "box": {
                    "grow": 1,
                    "gap": 0,
                    "children": [
                      "{lines}"
                    ]
                  }
                },
                "{scroll}"
              ]
            }
          }
        ]
      }
    }
  }
}
