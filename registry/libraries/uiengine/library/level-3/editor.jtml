{
  "component": {
    "name": "editor",
    "params": [
      "tabs",
      "lines",
      "scroll"
    ],
    "body": {
      "plate": {
        "tone": "ground",
        "grow": 1,
        "children": [
          {
            "plate": {
              "tone": "panel",
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "height": 36,
                    "gap": 0,
                    "children": [
                      "{tabs}",
                      {
                        "box": {
                          "grow": 1,
                          "gap": 0
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "bar": {
              "height": 1,
              "tone": "line"
            }
          },
          {
            "box": {
              "flow": "row",
              "grow": 1,
              "gap": 6,
              "padding": [
                10,
                6,
                10,
                0
              ],
              "children": [
                {
                  "box": {
                    "grow": 1,
                    "gap": 0,
                    "children": [
                      "{lines}"
                    ]
                  }
                },
                "{scroll}"
              ]
            }
          }
        ]
      }
    }
  }
}