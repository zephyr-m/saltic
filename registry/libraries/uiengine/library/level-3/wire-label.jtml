{
  "component": {
    "name": "wire-label",
    "params": [
      "x",
      "y",
      "text"
    ],
    "body": {
      "box": {
        "at": [
          "{x}",
          "{y}"
        ],
        "gap": 0,
        "children": [
          {
            "console-line": {
              "text": "{text}",
              "tone": "quiet",
              "size": 11
            }
          }
        ]
      }
    }
  }
}