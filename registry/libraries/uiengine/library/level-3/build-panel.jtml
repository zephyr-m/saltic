{
  "component": {
    "name": "build-panel",
    "params": [
      "summary",
      "log",
      "card"
    ],
    "body": {
      "plate": {
        "tone": "panel",
        "children": [
          {
            "box": {
              "width": 480,
              "grow": 1,
              "gap": 0,
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "padding": 12,
                    "gap": 8,
                    "children": [
                      {
                        "pill-go": {
                          "text": "собрать"
                        }
                      },
                      {
                        "pill": {
                          "text": "запустить"
                        }
                      },
                      {
                        "pill": {
                          "text": "x86_64"
                        }
                      }
                    ]
                  }
                },
                {
                  "box": {
                    "padding": [
                      0,
                      12,
                      10,
                      12
                    ],
                    "gap": 0,
                    "children": [
                      {
                        "label": {
                          "text": "{summary}"
                        }
                      }
                    ]
                  }
                },
                {
                  "bar": {
                    "height": 1,
                    "tone": "line"
                  }
                },
                {
                  "plate": {
                    "tone": "ground",
                    "grow": 1,
                    "children": [
                      {
                        "box": {
                          "padding": 16,
                          "gap": 6,
                          "grow": 1,
                          "children": [
                            "{log}",
                            {
                              "box": {
                                "grow": 1,
                                "gap": 0
                              }
                            },
                            {
                              "caption": {
                                "text": "карточка навыка"
                              }
                            },
                            "{card}"
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}