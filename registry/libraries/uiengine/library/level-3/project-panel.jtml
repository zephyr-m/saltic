{
  "component": {
    "name": "project-panel",
    "params": [
      "files",
      "skills",
      "types"
    ],
    "body": {
      "box": {
        "width": 230,
        "fill": "panel",
        "padding": [
          12,
          10,
          12,
          10
        ],
        "gap": 3,
        "children": [
          {
            "caption": {
              "text": "проект"
            }
          },
          "{files}",
          {
            "gap": {
              "height": 8
            }
          },
          {
            "caption": {
              "text": "навыки"
            }
          },
          "{skills}",
          {
            "gap": {
              "height": 8
            }
          },
          {
            "caption": {
              "text": "типы"
            }
          },
          "{types}"
        ]
      }
    }
  }
}
