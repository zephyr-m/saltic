{
  "component": {
    "name": "project-panel",
    "params": [
      "files",
      "skills",
      "types"
    ],
    "body": {
      "plate": {
        "tone": "panel",
        "children": [
          {
            "box": {
              "width": 230,
              "padding": [
                12,
                10,
                12,
                10
              ],
              "gap": 3,
              "children": [
                {
                  "caption": {
                    "text": "проект"
                  }
                },
                "{files}",
                {
                  "box": {
                    "height": 8,
                    "gap": 0
                  }
                },
                {
                  "caption": {
                    "text": "навыки"
                  }
                },
                "{skills}",
                {
                  "box": {
                    "height": 8,
                    "gap": 0
                  }
                },
                {
                  "caption": {
                    "text": "типы"
                  }
                },
                "{types}"
              ]
            }
          }
        ]
      }
    }
  }
}