{
  "component": {
    "name": "status-bar",
    "params": [
      "text",
      "height"
    ],
    "body": {
      "box": {
        "height": "{height}",
        "fill": "panel",
        "padding": [
          0,
          12,
          0,
          12
        ],
        "gap": 0,
        "justify": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "tone": "quiet",
              "cut": "yes"
            }
          }
        ]
      }
    }
  }
}
