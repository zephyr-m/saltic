{
  "component": {
    "name": "status-bar",
    "params": [
      "text",
      "height"
    ],
    "body": {
      "plate": {
        "tone": "panel",
        "children": [
          {
            "box": {
              "height": "{height}",
              "padding": [
                0,
                12,
                0,
                12
              ],
              "justify": "center",
              "gap": 0,
              "children": [
                {
                  "words": {
                    "text": "{text}",
                    "tone": "quiet"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}