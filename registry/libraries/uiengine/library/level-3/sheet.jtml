{
  "component": {
    "name": "sheet",
    "params": [
      "radius",
      "width",
      "grow",
      "children"
    ],
    "body": {
      "pane": {
        "radius": "{radius}",
        "width": "{width}",
        "grow": "{grow}",
        "children": [
          "{children}"
        ]
      }
    }
  }
}