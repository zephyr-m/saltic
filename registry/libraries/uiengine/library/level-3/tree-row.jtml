{
  "component": {
    "name": "tree-row",
    "params": [
      "id",
      "chevron",
      "icon",
      "tone",
      "name",
      "title",
      "version",
      "state"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "flow": "row",
        "height": 38,
        "padding": [
          0,
          8,
          0,
          8
        ],
        "gap": 10,
        "align": "center",
        "children": [
          {
            "box": {
              "width": 14,
              "gap": 0
            }
          },
          {
            "glyph": {
              "icon": "{chevron}",
              "tone": "quiet",
              "size": 14
            }
          },
          {
            "glyph": {
              "icon": "{icon}",
              "tone": "{tone}",
              "size": 16
            }
          },
          {
            "box": {
              "width": 150,
              "gap": 0,
              "children": [
                {
                  "console-line": {
                    "text": "{name}",
                    "tone": "ink",
                    "size": 13
                  }
                }
              ]
            }
          },
          {
            "words": {
              "text": "{title}",
              "tone": "quiet",
              "grow": 1
            }
          },
          {
            "badge": {
              "text": "{version}",
              "tone": "quiet"
            }
          },
          {
            "box": {
              "width": 260,
              "gap": 0,
              "children": [
                {
                  "words": {
                    "text": "{state}",
                    "tone": "quiet"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}