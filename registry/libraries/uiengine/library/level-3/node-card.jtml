{
  "component": {
    "name": "node-card",
    "params": [
      "id",
      "x",
      "y",
      "width",
      "rim",
      "border",
      "header",
      "head",
      "rows",
      "footer"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "at": [
          "{x}",
          "{y}"
        ],
        "width": "{width}",
        "gap": 0,
        "children": [
          {
            "cell": {
              "fill": "panel",
              "edge": "{rim}",
              "border": "{border}",
              "children": [
                {
                  "box": {
                    "padding": [
                      0,
                      6,
                      6,
                      6
                    ],
                    "gap": 0,
                    "children": [
                      {
                        "box": {
                          "flow": "row",
                          "height": "{header}",
                          "padding": [
                            0,
                            6,
                            0,
                            6
                          ],
                          "gap": 8,
                          "align": "center",
                          "children": [
                            "{head}"
                          ]
                        }
                      },
                      {
                        "cell": {
                          "fill": "well",
                          "children": [
                            {
                              "box": {
                                "padding": [
                                  4,
                                  0,
                                  0,
                                  0
                                ],
                                "gap": 0,
                                "children": [
                                  "{rows}",
                                  "{footer}"
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}