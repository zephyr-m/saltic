{
  "component": {
    "name": "menu-row-current",
    "params": [
      "id",
      "icon",
      "text",
      "count"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "gap": 0,
        "children": [
          {
            "cell": {
              "fill": "mustard_soft",
              "edge": "mustard_rim",
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "height": 36,
                    "padding": [
                      0,
                      10,
                      0,
                      10
                    ],
                    "gap": 10,
                    "align": "center",
                    "children": [
                      {
                        "glyph": {
                          "icon": "{icon}",
                          "tone": "mustard",
                          "size": 16
                        }
                      },
                      {
                        "words": {
                          "text": "{text}",
                          "tone": "mustard",
                          "grow": 1
                        }
                      },
                      {
                        "hint": {
                          "text": "{count}"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}