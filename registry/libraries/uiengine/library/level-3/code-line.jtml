{
  "component": {
    "name": "code-line",
    "params": [
      "id",
      "number",
      "tokens",
      "tone"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "gap": 0,
        "children": [
          {
            "plate": {
              "tone": "{tone}",
              "children": [
                {
                  "box": {
                    "flow": "row",
                    "height": 20,
                    "align": "center",
                    "gap": 0,
                    "children": [
                      {
                        "box": {
                          "flow": "row",
                          "width": 40,
                          "justify": "end",
                          "gap": 0,
                          "children": [
                            {
                              "console-line": {
                                "text": "{number}",
                                "tone": "gutter",
                                "size": 13
                              }
                            }
                          ]
                        }
                      },
                      {
                        "box": {
                          "width": 18,
                          "gap": 0
                        }
                      },
                      {
                        "box": {
                          "flow": "row",
                          "grow": 1,
                          "gap": 0,
                          "children": [
                            "{tokens}"
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}