{
  "component": {
    "name": "code-line",
    "params": [
      "id",
      "number",
      "tokens",
      "tone"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "flow": "row",
        "height": 20,
        "fill": "{tone}",
        "gap": 0,
        "align": "center",
        "children": [
          {
            "box": {
              "width": 40,
              "gap": 0,
              "children": [
                {
                  "text": {
                    "value": "{number}",
                    "mono": "yes",
                    "tone": "gutter",
                    "align": "end",
                    "size": 13
                  }
                }
              ]
            }
          },
          {
            "gap": {
              "width": 18
            }
          },
          {
            "box": {
              "flow": "row",
              "grow": 1,
              "gap": 0,
              "children": [
                "{tokens}"
              ]
            }
          }
        ]
      }
    }
  }
}
