{
  "component": {
    "name": "menu-row",
    "params": [
      "id",
      "icon",
      "text",
      "count"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "flow": "row",
        "height": 36,
        "padding": [
          0,
          10,
          0,
          10
        ],
        "gap": 10,
        "align": "center",
        "children": [
          {
            "glyph": {
              "icon": "{icon}",
              "tone": "quiet",
              "size": 16
            }
          },
          {
            "words": {
              "text": "{text}",
              "tone": "quiet",
              "grow": 1
            }
          },
          {
            "hint": {
              "text": "{count}"
            }
          }
        ]
      }
    }
  }
}