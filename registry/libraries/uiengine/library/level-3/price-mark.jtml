{
  "component": {
    "name": "price-mark",
    "params": [
      "space",
      "price"
    ],
    "body": {
      "box": {
        "gap": 0,
        "children": [
          {
            "gap": {
              "height": "{space}"
            }
          },
          {
            "tag": {
              "text": "{price}",
              "fill": "accent",
              "tone": "ground"
            }
          }
        ]
      }
    }
  }
}
