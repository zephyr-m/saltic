{
  "component": {
    "name": "heat-cell",
    "params": [
      "id",
      "tone"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "gap": 0,
        "children": [
          {
            "bar": {
              "width": 16,
              "height": 16,
              "tone": "{tone}",
              "radius": 4
            }
          }
        ]
      }
    }
  }
}