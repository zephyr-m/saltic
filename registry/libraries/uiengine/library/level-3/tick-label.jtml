{
  "component": {
    "name": "tick-label",
    "params": [
      "text",
      "width",
      "height"
    ],
    "body": {
      "box": {
        "width": "{width}",
        "gap": 0,
        "children": [
          {
            "hint": {
              "text": "{text}"
            }
          }
        ],
        "height": "{height}",
        "justify": "center"
      }
    }
  }
}