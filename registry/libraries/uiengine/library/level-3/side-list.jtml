{
  "component": {
    "name": "side-list",
    "params": [
      "title",
      "rows",
      "hint",
      "width"
    ],
    "body": {
      "box": {
        "width": "{width}",
        "fill": "panel",
        "padding": [
          12,
          8,
          12,
          8
        ],
        "gap": 2,
        "align": "stretch",
        "children": [
          {
            "caption": {
              "text": "{title}"
            }
          },
          {
            "gap": {
              "height": 8
            }
          },
          "{rows}",
          {
            "gap": {
              "grow": 1
            }
          },
          {
            "label": {
              "text": "{hint}"
            }
          }
        ]
      }
    }
  }
}
