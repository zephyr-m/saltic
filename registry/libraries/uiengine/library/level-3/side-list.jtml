{
  "component": {
    "name": "side-list",
    "params": [
      "title",
      "rows",
      "hint",
      "width"
    ],
    "body": {
      "plate": {
        "tone": "panel",
        "children": [
          {
            "box": {
              "width": "{width}",
              "padding": [
                12,
                8,
                12,
                8
              ],
              "gap": 2,
              "grow": 1,
              "children": [
                {
                  "caption": {
                    "text": "{title}"
                  }
                },
                {
                  "box": {
                    "height": 8,
                    "gap": 0
                  }
                },
                "{rows}",
                {
                  "box": {
                    "grow": 1,
                    "gap": 0
                  }
                },
                {
                  "label": {
                    "text": "{hint}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}