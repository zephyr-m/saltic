{
  "component": {
    "name": "port-row",
    "params": [
      "left",
      "right",
      "left_tone",
      "right_tone",
      "label",
      "height",
      "lead",
      "wide",
      "size"
    ],
    "body": {
      "box": {
        "flow": "row",
        "height": "{height}",
        "padding": [
          0,
          12,
          0,
          12
        ],
        "gap": 8,
        "justify": "between",
        "align": "center",
        "children": [
          {
            "console-line": {
              "text": "{left}",
              "tone": "{label}",
              "size": "{size}"
            }
          },
          {
            "console-line": {
              "text": "{right}",
              "tone": "{label}",
              "size": "{size}"
            }
          },
          {
            "box": {
              "at": [
                "{lead}",
                5
              ],
              "width": 11,
              "height": 11,
              "gap": 0,
              "children": [
                {
                  "dot": {
                    "tone": "{left_tone}"
                  }
                }
              ]
            }
          },
          {
            "box": {
              "at": [
                "{wide}",
                5
              ],
              "width": 11,
              "height": 11,
              "gap": 0,
              "children": [
                {
                  "dot": {
                    "tone": "{right_tone}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
