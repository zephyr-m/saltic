{
  "component": {
    "name": "board-head",
    "params": [
      "title",
      "note"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 12,
        "align": "center",
        "children": [
          {
            "figure": {
              "text": "{title}",
              "size": 22,
              "tone": "ink"
            }
          },
          {
            "number-badge": {
              "text": "{note}",
              "fill": "well",
              "tone": "quiet"
            }
          }
        ]
      }
    }
  }
}