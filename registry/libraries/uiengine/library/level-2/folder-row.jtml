{
  "component": {
    "name": "folder-row",
    "params": [
      "id",
      "name",
      "indent",
      "icon"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "flow": "row",
        "height": 24,
        "gap": 6,
        "align": "center",
        "children": [
          {
            "box": {
              "width": "{indent}",
              "gap": 0
            }
          },
          {
            "box": {
              "width": 14,
              "height": 14,
              "icon": "{icon}",
              "ink": "quiet",
              "gap": 0
            }
          },
          {
            "text": {
              "value": "{name}",
              "tone": "quiet",
              "size": 13
            }
          }
        ]
      }
    }
  }
}
