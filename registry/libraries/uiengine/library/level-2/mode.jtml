{
  "component": {
    "name": "mode",
    "params": [
      "text",
      "icon"
    ],
    "body": {
      "box": {
        "flow": "row",
        "height": 30,
        "padding": [
          0,
          12,
          0,
          12
        ],
        "gap": 8,
        "align": "center",
        "children": [
          {
            "box": {
              "width": 15,
              "height": 15,
              "icon": "{icon}",
              "ink": "quiet",
              "gap": 0
            }
          },
          {
            "text": {
              "value": "{text}",
              "tone": "quiet",
              "size": 13
            }
          }
        ]
      }
    }
  }
}
