{
  "component": {
    "name": "rail-button",
    "params": [
      "icon"
    ],
    "body": {
      "box": {
        "width": 52,
        "height": 52,
        "radius": 13,
        "fill": "well",
        "edge": "line",
        "padding": 15,
        "icon": "{icon}",
        "ink": "quiet",
        "gap": 0
      }
    }
  }
}
