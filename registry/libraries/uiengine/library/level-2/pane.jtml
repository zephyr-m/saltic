{
  "component": {
    "name": "pane",
    "params": [
      "radius",
      "width",
      "grow",
      "children"
    ],
    "body": {
      "box": {
        "fill": "panel",
        "edge": "line",
        "radius": "{radius}",
        "width": "{width}",
        "grow": "{grow}",
        "gap": 0,
        "children": [
          "{children}"
        ]
      }
    }
  }
}