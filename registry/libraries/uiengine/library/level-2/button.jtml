{
  "component": {
    "name": "button",
    "params": [
      "text",
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "fill": "{fill}",
        "radius": 8,
        "padding": [
          8,
          14,
          8,
          14
        ],
        "gap": 0,
        "justify": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "weight": "bold",
              "tone": "{tone}"
            }
          }
        ]
      }
    }
  }
}
