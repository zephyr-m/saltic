{
  "component": {
    "name": "labeled-slider",
    "params": [
      "label",
      "id",
      "value",
      "min",
      "max",
      "unit"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 10,
        "align": "center",
        "children": [
          {
            "box": {
              "width": 64,
              "gap": 0,
              "children": [
                {
                  "text": {
                    "value": "{label}"
                  }
                }
              ]
            }
          },
          {
            "box": {
              "flow": "row",
              "gap": 10,
              "grow": 1,
              "align": "center",
              "children": [
                {
                  "slider": {
                    "id": "{id}",
                    "value": "{value}",
                    "min": "{min}",
                    "max": "{max}"
                  }
                },
                {
                  "text": {
                    "value": "{unit}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
