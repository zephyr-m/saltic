{
  "component": {
    "name": "section-title",
    "params": [
      "text"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 12,
        "align": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "caps": "yes",
              "tone": "quiet"
            }
          },
          {
            "box": {
              "grow": 1,
              "height": 1,
              "fill": "line",
              "gap": 0
            }
          }
        ]
      }
    }
  }
}