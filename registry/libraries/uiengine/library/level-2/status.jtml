{
  "component": {
    "name": "status",
    "params": [
      "icon",
      "text",
      "tone",
      "mono"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 6,
        "align": "center",
        "children": [
          {
            "box": {
              "width": 14,
              "height": 14,
              "icon": "{icon}",
              "ink": "{tone}",
              "gap": 0
            }
          },
          {
            "text": {
              "value": "{text}",
              "mono": "{mono}",
              "tone": "{tone}",
              "size": 13
            }
          }
        ]
      }
    }
  }
}
