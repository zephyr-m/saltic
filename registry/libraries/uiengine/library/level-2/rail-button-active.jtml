{
  "component": {
    "name": "rail-button-active",
    "params": [
      "icon"
    ],
    "body": {
      "box": {
        "width": 52,
        "height": 52,
        "radius": 13,
        "fill": "accent",
        "inset": 2,
        "shadow": 4,
        "padding": 15,
        "icon": "{icon}",
        "ink": "ground",
        "gap": 0
      }
    }
  }
}
