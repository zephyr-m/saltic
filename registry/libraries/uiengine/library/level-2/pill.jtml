{
  "component": {
    "name": "pill",
    "params": [
      "text"
    ],
    "body": {
      "box": {
        "flow": "row",
        "height": 30,
        "padding": [
          0,
          12,
          0,
          12
        ],
        "edge": "line",
        "radius": 9,
        "gap": 0,
        "align": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "size": 13
            }
          }
        ],
        "fill": "raise"
      }
    }
  }
}