{
  "component": {
    "name": "badge",
    "params": [
      "text",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "edge": "{tone}",
        "border": 1,
        "radius": 6,
        "padding": [
          1,
          6,
          1,
          6
        ],
        "gap": 0,
        "align": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "mono": "yes",
              "size": 11,
              "tone": "{tone}"
            }
          }
        ]
      }
    }
  }
}
