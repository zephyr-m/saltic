{
  "component": {
    "name": "gold-pill",
    "params": [
      "icon",
      "text"
    ],
    "body": {
      "box": {
        "flow": "row",
        "height": 40,
        "padding": [
          0,
          16,
          0,
          14
        ],
        "radius": 20,
        "fill": "accent",
        "shadow": 4,
        "gap": 8,
        "align": "center",
        "children": [
          {
            "box": {
              "width": 16,
              "height": 16,
              "icon": "{icon}",
              "ink": "ground",
              "gap": 0
            }
          },
          {
            "text": {
              "value": "{text}",
              "size": 14,
              "weight": "bold",
              "tone": "ground"
            }
          }
        ]
      }
    }
  }
}
