{
  "component": {
    "name": "value-line",
    "params": [
      "text",
      "tone",
      "height"
    ],
    "body": {
      "box": {
        "height": "{height}",
        "padding": [
          0,
          12,
          0,
          12
        ],
        "gap": 0,
        "justify": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "tone": "{tone}",
              "mono": "yes",
              "size": 12,
              "cut": "yes"
            }
          }
        ]
      }
    }
  }
}