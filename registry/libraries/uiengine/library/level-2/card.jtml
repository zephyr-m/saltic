{
  "component": {
    "name": "card",
    "params": [
      "gap",
      "padding",
      "width",
      "grow",
      "children"
    ],
    "body": {
      "box": {
        "fill": "panel",
        "radius": 16,
        "gap": "{gap}",
        "padding": "{padding}",
        "width": "{width}",
        "grow": "{grow}",
        "children": [
          "{children}"
        ]
      }
    }
  }
}