{
  "component": {
    "name": "window-button",
    "params": [
      "id",
      "icon",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "width": 28,
        "height": 28,
        "radius": 7,
        "fill": "{tone}",
        "edge": "{tone}_edge",
        "shadow": 4,
        "padding": 6,
        "icon": "{icon}",
        "ink": "ground",
        "gap": 0,
        "align": "center",
        "children": [
          {
            "text": {
              "id": "{id}",
              "value": "",
              "width": 16
            }
          }
        ]
      }
    }
  }
}
