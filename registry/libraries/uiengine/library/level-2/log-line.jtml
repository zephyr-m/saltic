{
  "component": {
    "name": "log-line",
    "params": [
      "time",
      "text",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 10,
        "children": [
          {
            "text": {
              "value": "{time}",
              "mono": "yes",
              "tone": "gutter",
              "size": 13
            }
          },
          {
            "text": {
              "value": "{text}",
              "mono": "yes",
              "tone": "{tone}",
              "size": 13
            }
          }
        ]
      }
    }
  }
}
