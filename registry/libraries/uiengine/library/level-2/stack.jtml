{
  "component": {
    "name": "stack",
    "params": [
      "gap",
      "justify",
      "grow",
      "children"
    ],
    "body": {
      "box": {
        "gap": "{gap}",
        "justify": "{justify}",
        "grow": "{grow}",
        "cross": "stretch",
        "children": [
          "{children}"
        ]
      }
    }
  }
}
