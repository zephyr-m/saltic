{
  "component": {
    "name": "scrollbar",
    "params": [
      "id",
      "offset",
      "size",
      "height"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "width": 10,
        "height": "{height}",
        "fill": "well",
        "radius": 5,
        "gap": 0,
        "children": [
          {
            "box": {
              "height": "{offset}",
              "gap": 0
            }
          },
          {
            "box": {
              "height": "{size}",
              "fill": "quiet",
              "radius": 5,
              "gap": 0
            }
          }
        ],
        "align": "stretch"
      }
    }
  }
}