{
  "component": {
    "name": "labeled-field",
    "params": [
      "label",
      "id",
      "value"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 10,
        "align": "center",
        "children": [
          {
            "box": {
              "width": 64,
              "gap": 0,
              "children": [
                {
                  "text": {
                    "value": "{label}"
                  }
                }
              ]
            }
          },
          {
            "field": {
              "id": "{id}",
              "value": "{value}",
              "grow": 1
            }
          }
        ]
      }
    }
  }
}
