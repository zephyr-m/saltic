{
  "component": {
    "name": "meter",
    "params": [
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "fill": "well",
        "height": 6,
        "radius": 3,
        "gap": 0,
        "children": [
          {
            "box": {
              "fill": "{tone}",
              "width": "{fill}",
              "height": 6,
              "radius": 3,
              "gap": 0
            }
          }
        ]
      }
    }
  }
}
