{
  "component": {
    "name": "chip",
    "params": [
      "text",
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "fill": "{fill}",
        "radius": 6,
        "padding": 6,
        "gap": 0,
        "justify": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "tone": "{tone}"
            }
          }
        ]
      }
    }
  }
}
