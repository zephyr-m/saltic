{
  "component": {
    "name": "chip",
    "params": [
      "text",
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "fill": "{fill}",
        "radius": 9,
        "padding": [
          6,
          10,
          6,
          10
        ],
        "gap": 0,
        "justify": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "tone": "{tone}",
              "size": 13
            }
          }
        ]
      }
    }
  }
}