{
  "component": {
    "name": "tag",
    "params": [
      "text",
      "fill",
      "tone"
    ],
    "body": {
      "box": {
        "flow": "row",
        "fill": "{fill}",
        "radius": 7,
        "padding": [
          1,
          7,
          1,
          7
        ],
        "gap": 0,
        "justify": "center",
        "children": [
          {
            "text": {
              "value": "{text}",
              "tone": "{tone}",
              "size": 12,
              "mono": "yes"
            }
          }
        ]
      }
    }
  }
}