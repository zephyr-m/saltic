{
  "component": {
    "name": "nav-item-active",
    "params": [
      "icon",
      "text",
      "width"
    ],
    "body": {
      "box": {
        "width": "{width}",
        "height": 60,
        "radius": 12,
        "fill": "mustard_soft",
        "edge": "mustard_rim",
        "gap": 4,
        "justify": "center",
        "align": "center",
        "children": [
          {
            "box": {
              "width": 20,
              "height": 20,
              "icon": "{icon}",
              "ink": "mustard",
              "gap": 0
            }
          },
          {
            "text": {
              "value": "{text}",
              "size": 13,
              "tone": "mustard",
              "align": "center"
            }
          }
        ]
      }
    }
  }
}