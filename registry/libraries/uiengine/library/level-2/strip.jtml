{
  "component": {
    "name": "strip",
    "params": [
      "gap",
      "justify",
      "grow",
      "children"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": "{gap}",
        "justify": "{justify}",
        "grow": "{grow}",
        "children": [
          "{children}"
        ],
        "align": "stretch"
      }
    }
  }
}