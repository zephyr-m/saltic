{
  "component": {
    "name": "bar",
    "params": [
      "width",
      "height",
      "tone",
      "radius"
    ],
    "body": {
      "box": {
        "fill": "{tone}",
        "width": "{width}",
        "height": "{height}",
        "gap": 0,
        "radius": "{radius}"
      }
    }
  }
}
