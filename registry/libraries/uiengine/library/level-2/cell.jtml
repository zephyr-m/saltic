{
  "component": {
    "name": "cell",
    "params": [
      "fill",
      "edge",
      "border",
      "grow",
      "children"
    ],
    "body": {
      "box": {
        "fill": "{fill}",
        "edge": "{edge}",
        "border": "{border}",
        "grow": "{grow}",
        "radius": 10,
        "gap": 0,
        "children": [
          "{children}"
        ]
      }
    }
  }
}