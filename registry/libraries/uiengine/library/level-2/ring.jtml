{
  "component": {
    "name": "ring",
    "params": [
      "size",
      "tone",
      "border",
      "children"
    ],
    "body": {
      "circle": {
        "size": "{size}",
        "edge": "{tone}",
        "border": "{border}",
        "children": [
          "{children}"
        ]
      }
    }
  }
}