{
  "component": {
    "name": "polygon-deck",
    "params": [
      "side",
      "top",
      "content"
    ],
    "body": {
      "box": {
        "flow": "row",
        "gap": 0,
        "children": [
          {
            "side-plate": {
              "width": 232,
              "children": [
                "{side}"
              ]
            }
          },
          {
            "divider": {
              "width": 1
            }
          },
          {
            "box": {
              "grow": 1,
              "gap": 0,
              "children": [
                {
                  "top-bar": {
                    "height": 58,
                    "children": [
                      "{top}"
                    ]
                  }
                },
                {
                  "box": {
                    "grow": 1,
                    "padding": [
                      22,
                      24,
                      22,
                      24
                    ],
                    "gap": 22,
                    "children": [
                      "{content}"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}