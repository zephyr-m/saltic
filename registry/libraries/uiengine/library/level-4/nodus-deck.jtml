{
  "component": {
    "name": "nodus-deck",
    "params": [
      "list",
      "cards",
      "bar"
    ],
    "body": {
      "box": {
        "gap": 0,
        "align": "stretch",
        "children": [
          {
            "box": {
              "flow": "row",
              "grow": 1,
              "gap": 0,
              "align": "stretch",
              "children": [
                "{list}",
                {
                  "bar": {
                    "width": 1,
                    "tone": "line"
                  }
                },
                {
                  "box": {
                    "grow": 1,
                    "gap": 0,
                    "children": [
                      "{cards}"
                    ]
                  }
                }
              ]
            }
          },
          {
            "bar": {
              "height": 1,
              "tone": "line"
            }
          },
          "{bar}"
        ]
      }
    }
  }
}
