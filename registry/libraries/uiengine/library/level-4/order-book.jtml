{
  "component": {
    "name": "order-book",
    "params": [
      "asks",
      "mid",
      "bids"
    ],
    "body": {
      "card": {
        "gap": 8,
        "padding": 12,
        "width": 250,
        "children": [
          {
            "caption": {
              "text": "стакан"
            }
          },
          {
            "box": {
              "flow": "row",
              "gap": 8,
              "children": [
                {
                  "caption": {
                    "text": "цена"
                  }
                },
                {
                  "gap": {
                    "grow": 1
                  }
                },
                {
                  "caption": {
                    "text": "кол-во"
                  }
                }
              ]
            }
          },
          {
            "box": {
              "fill": "well",
              "radius": 6,
              "padding": 6,
              "gap": 3,
              "children": [
                "{asks}",
                {
                  "number": {
                    "text": "{mid}",
                    "tone": "accent",
                    "align": "center"
                  }
                },
                "{bids}"
              ]
            }
          }
        ]
      }
    }
  }
}
