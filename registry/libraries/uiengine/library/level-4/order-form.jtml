{
  "component": {
    "name": "order-form",
    "params": [
      "price",
      "amount",
      "share",
      "leverage",
      "total"
    ],
    "body": {
      "card": {
        "gap": 8,
        "padding": 14,
        "width": 330,
        "children": [
          {
            "tabs": {
              "active": "купить",
              "other": "продать"
            }
          },
          {
            "labeled-field": {
              "label": "цена",
              "id": "price",
              "value": "{price}"
            }
          },
          {
            "labeled-field": {
              "label": "кол-во",
              "id": "amount",
              "value": "{amount}"
            }
          },
          {
            "labeled-slider": {
              "label": "доля",
              "id": "share",
              "value": "{share}",
              "min": 0,
              "max": 100,
              "unit": "{share} %"
            }
          },
          {
            "labeled-slider": {
              "label": "плечо",
              "id": "leverage",
              "value": "{leverage}",
              "min": 1,
              "max": 10,
              "unit": "{leverage}x"
            }
          },
          {
            "label": {
              "text": "{total}"
            }
          },
          {
            "button": {
              "text": "КУПИТЬ BTC",
              "fill": "up",
              "tone": "ground"
            }
          },
          {
            "label": {
              "text": "Tab — дальше, стрелки — ползунок"
            }
          }
        ]
      }
    }
  }
}
