{
  "component": {
    "name": "task-column",
    "params": [
      "title",
      "count",
      "width",
      "cards"
    ],
    "body": {
      "box": {
        "fill": "panel",
        "radius": 12,
        "padding": 12,
        "gap": 8,
        "width": "{width}",
        "children": [
          {
            "column-head": {
              "title": "{title}",
              "count": "{count}"
            }
          },
          "{cards}"
        ]
      }
    }
  }
}
