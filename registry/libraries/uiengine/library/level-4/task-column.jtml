{
  "component": {
    "name": "task-column",
    "params": [
      "title",
      "count",
      "width",
      "cards"
    ],
    "body": {
      "sheet": {
        "radius": 12,
        "width": "{width}",
        "children": [
          {
            "box": {
              "padding": 12,
              "gap": 8,
              "children": [
                {
                  "column-head": {
                    "title": "{title}",
                    "count": "{count}"
                  }
                },
                "{cards}"
              ]
            }
          }
        ]
      }
    }
  }
}