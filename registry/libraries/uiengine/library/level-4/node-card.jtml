{
  "component": {
    "name": "node-card",
    "params": [
      "id",
      "x",
      "y",
      "width",
      "rim",
      "border",
      "header",
      "head",
      "rows",
      "footer"
    ],
    "body": {
      "box": {
        "id": "{id}",
        "at": [
          "{x}",
          "{y}"
        ],
        "width": "{width}",
        "fill": "panel",
        "edge": "{rim}",
        "border": "{border}",
        "radius": 12,
        "shadow": 8,
        "padding": [
          0,
          6,
          6,
          6
        ],
        "gap": 0,
        "align": "stretch",
        "children": [
          {
            "box": {
              "flow": "row",
              "height": "{header}",
              "padding": [
                0,
                6,
                0,
                6
              ],
              "gap": 8,
              "align": "center",
              "children": [
                "{head}"
              ]
            }
          },
          {
            "box": {
              "fill": "well",
              "radius": 8,
              "padding": [
                4,
                0,
                0,
                0
              ],
              "gap": 0,
              "align": "stretch",
              "children": [
                "{rows}",
                "{footer}"
              ]
            }
          }
        ]
      }
    }
  }
}
