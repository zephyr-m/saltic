{
  "component": {
    "name": "balance",
    "params": [
      "usdt",
      "btc",
      "eth",
      "held"
    ],
    "body": {
      "card": {
        "gap": 8,
        "padding": 12,
        "grow": 1,
        "children": [
          {
            "caption": {
              "text": "баланс"
            }
          },
          {
            "box": {
              "flow": "row",
              "gap": 32,
              "children": [
                {
                  "number": {
                    "text": "USDT  {usdt}",
                    "tone": "up"
                  }
                },
                {
                  "number": {
                    "text": "BTC  {btc}",
                    "tone": "accent"
                  }
                },
                {
                  "number": {
                    "text": "ETH  {eth}",
                    "tone": "info"
                  }
                }
              ]
            }
          },
          {
            "label": {
              "text": "в ордерах  {held}"
            }
          },
          {
            "tinted": {
              "text": "собрано из закрытой библиотеки: уровни 1—4",
              "tone": "info"
            }
          }
        ]
      }
    }
  }
}
