{
  "component": {
    "name": "console-deck",
    "params": [
      "top",
      "left",
      "middle",
      "right"
    ],
    "body": {
      "box": {
        "padding": 12,
        "gap": 12,
        "children": [
          "{top}",
          {
            "box": {
              "flow": "row",
              "grow": 1,
              "gap": 12,
              "children": [
                "{left}",
                "{middle}",
                "{right}"
              ]
            }
          }
        ]
      }
    }
  }
}