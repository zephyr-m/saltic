{
  "component": {
    "name": "ticker",
    "params": [
      "price",
      "change",
      "tone",
      "high",
      "low",
      "volume",
      "user"
    ],
    "body": {
      "card": {
        "gap": 0,
        "padding": 12,
        "children": [
          {
            "box": {
              "flow": "row",
              "gap": 24,
              "align": "center",
              "children": [
                {
                  "figure": {
                    "text": "SALTIC EX",
                    "size": "big",
                    "tone": "ink"
                  }
                },
                {
                  "caption": {
                    "text": "BTC/USDT"
                  }
                },
                {
                  "figure": {
                    "text": "{price}",
                    "size": "huge",
                    "tone": "{tone}"
                  }
                },
                {
                  "figure": {
                    "text": "{change}",
                    "size": "big",
                    "tone": "{tone}"
                  }
                },
                {
                  "label": {
                    "text": "макс {high}"
                  }
                },
                {
                  "label": {
                    "text": "мин {low}"
                  }
                },
                {
                  "label": {
                    "text": "объём {volume}"
                  }
                },
                {
                  "gap": {
                    "grow": 1
                  }
                },
                {
                  "tinted": {
                    "text": "{user}",
                    "tone": "info"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
