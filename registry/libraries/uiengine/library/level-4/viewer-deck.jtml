{
  "component": {
    "name": "viewer-deck",
    "params": [
      "side",
      "head",
      "content",
      "offset",
      "wide"
    ],
    "body": {
      "box": {
        "gap": 0,
        "layers": [
          {
            "layer": {
              "name": "содержимое",
              "padding": [
                76,
                16,
                16,
                248
              ],
              "gap": 0,
              "children": [
                {
                  "box": {
                    "at": [
                      0,
                      "{offset}"
                    ],
                    "width": "{wide}",
                    "gap": 0,
                    "align": "stretch",
                    "children": [
                      "{content}"
                    ]
                  }
                }
              ]
            }
          },
          {
            "layer": {
              "name": "рамка",
              "flow": "row",
              "gap": 0,
              "children": [
                "{side}",
                {
                  "box": {
                    "grow": 1,
                    "gap": 0,
                    "align": "stretch",
                    "children": [
                      {
                        "top-bar": {
                          "height": 60,
                          "children": [
                            "{head}"
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}