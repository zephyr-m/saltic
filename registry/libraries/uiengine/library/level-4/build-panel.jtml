{
  "component": {
    "name": "build-panel",
    "params": [
      "summary",
      "log",
      "card"
    ],
    "body": {
      "box": {
        "width": 480,
        "fill": "panel",
        "gap": 0,
        "children": [
          {
            "box": {
              "flow": "row",
              "padding": 12,
              "gap": 8,
              "children": [
                {
                  "pill-go": {
                    "text": "собрать"
                  }
                },
                {
                  "pill": {
                    "text": "запустить"
                  }
                },
                {
                  "pill": {
                    "text": "x86_64"
                  }
                }
              ]
            }
          },
          {
            "box": {
              "padding": [
                0,
                12,
                10,
                12
              ],
              "gap": 0,
              "children": [
                {
                  "label": {
                    "text": "{summary}"
                  }
                }
              ]
            }
          },
          {
            "bar": {
              "height": 1,
              "tone": "line"
            }
          },
          {
            "box": {
              "grow": 1,
              "fill": "ground",
              "padding": 16,
              "gap": 6,
              "children": [
                "{log}",
                {
                  "gap": {
                    "grow": 1
                  }
                },
                {
                  "caption": {
                    "text": "карточка навыка"
                  }
                },
                "{card}"
              ]
            }
          }
        ]
      }
    }
  }
}
