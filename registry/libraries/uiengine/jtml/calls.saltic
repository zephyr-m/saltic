-- calls — текст JTML вызова жителя закрытой библиотеки (registry/libraries/uiengine/library):
-- {"имя": {"параметр": значение, …}}. Компоненты программ пишут ими свои данные.
--
-- call(name, pairs) -> текст вызова; pairs — [[параметр, значение JTML], …]
-- quoted(text) -> строка JTML в кавычках, «\» и «"» внутри экранированы;
-- listed(items) -> "[…]" — список
-- join(items) -> через запятую

use core.str
use core.group
use registry.libraries.uiengine.jtml.reader

skill join(items) {
    out str.join(items, ", ")
}

skill quoted(text) {
    @safe = reader.replaced(reader.replaced(text, "\\", "\\\\"), "\"", "\\\"")
    out "\"{safe}\""
}

skill listed(items) {
    @inside = join(items)
    out "[{inside}]"
}

skill call(name, pairs) {
    @parts = []
    drum (pairs) {
        @key = group.get(beat, 0)
        @raw = group.get(beat, 1)
        parts = group.add(parts, "\"{key}\": {raw}")
    }
    @inside = join(parts)
    out "\{\"{name}\": \{{inside}\}\}"
}
