-- atom — четыре атома JTML, из которых собирается любой интерфейс (атомарный
-- дизайн, решение автора 08.11.2026): BOX компонует и хранит в себе что
-- угодно (колонка или ряд с отступами, рамкой и grow), TEXT — текст, FIELD —
-- поле для текста, SLIDER — ползунок. Кнопки, вкладки, флажки — не атомы, а
-- сборки из этих четырёх; рисующего кода у них нет.
--
-- Kind — UNKNOWN, BOX, TEXT, FIELD, SLIDER; Flow — COLUMN, ROW; Align — START,
--     CENTER, END
-- Node { kind, id, value, align, flow, width, height, grow, padding, gap,
--     border, children, layers, level, least, most, size, weight, cut } —
--     value — текст TEXT и FIELD; size (normal, big, huge), weight (regular,
--     bold), cut (обрезать с «...», если не влезает), caps (прописные мелким
--     кеглем с разрядкой — подписи) и mono (моноширинный шрифт — цифры), pixels —
--     кегль числом (0 — по size), leading — высота строки (0 — по шрифту), fade —
--     второй цвет: буквы переливаются от tone к fade слева направо — у TEXT; у BOX: sides —
--     padding по сторонам [верх, право, низ, лево] (пусто — padding со всех),
--     fill / edge — имена цветов фона и рамки, radius; shadow — мягкая тень
--     (размытие в пикселях, сдвиг вниз — треть), inset — внутренняя тень сверху
--     (глубина в пикселях), icon — значок Lucide по имени (os/icons) посреди
--     box, кегль — меньшая сторона внутри padding, ink — его цвет (имя тона);
--     corners — какие углы скругляет radius у fill: all, top, bottom, left, right;
--     justify (start, center, end, between) — вдоль flow, cross (start, center,
--     end, stretch) — поперёк; natural — ширина текста по шрифту экрана
--     (ставит рисовальщик, не JTML);
--     level, least, most — положение и пределы SLIDER; tone — имя цвета из
--     палитры экрана (у TEXT — буквы, у BOX — рамка или заливка), "" — свой;
--     layers — слои BOX (решение автора 16.11.2026): каждый — BOX с именем в id,
--     на всю внутреннюю площадь, рисуются по порядку (первый — внизу); у BOX
--     либо дети (рядом), либо слои (друг на друге), не вместе
-- frame(flow, width, height, grow, padding, gap, border, children) -> BOX
-- form(children) / row(children) / space(grow) -> BOX
-- text(value) / label(value, align) / target_text(id, value) -> TEXT
-- field(id, value) / field_grow(id, value) -> FIELD
-- slider(id, level, least, most) -> SLIDER, растягивается по главной оси

DEFAULT_GAP = 20

Kind = enum {
    UNKNOWN,
    BOX,
    TEXT,
    FIELD,
    SLIDER
}

Flow = enum {
    COLUMN,
    ROW
}

Align = enum {
    START,
    CENTER,
    END
}

Node = Box {
    kind = Kind.UNKNOWN,
    id = "",
    value = "",
    align = Align.START,
    flow = Flow.COLUMN,
    width = 0,
    height = 0,
    grow = 0,
    padding = 0,
    gap = 0,
    border = 0,
    children = [],
    layers = [],
    level = 0,
    least = 0,
    most = 100,
    tone = "",
    size = "normal",
    weight = "regular",
    cut = no,
    caps = no,
    mono = no,
    pixels = 0,
    leading = 0,
    fade = "",
    inset = 0,
    sides = [],
    fill = "",
    edge = "",
    radius = 0,
    shadow = 0,
    icon = "",
    ink = "",
    corners = "all",
    justify = "start",
    cross = "stretch",
    natural = 0
}

skill frame(flow, width, height, grow, padding, gap, border, children) {
    out Node {
        kind = Kind.BOX,
        flow = flow,
        width = width,
        height = height,
        grow = grow,
        padding = padding,
        gap = gap,
        border = border,
        children = children
    }
}

skill form(children) {
    out frame(Flow.COLUMN, 0, 0, 0, 0, DEFAULT_GAP, 0, children)
}

skill row(children) {
    out frame(Flow.ROW, 0, 0, 0, 0, DEFAULT_GAP, 0, children)
}

skill space(grow) {
    out frame(Flow.COLUMN, 0, 0, grow, 0, 0, 0, [])
}

skill text(value) {
    out Node { kind = Kind.TEXT, value = value }
}

skill target_text(id, value) {
    out Node { kind = Kind.TEXT, id = id, value = value }
}

skill label(value, align) {
    out Node { kind = Kind.TEXT, value = value, align = align }
}

skill field(id, value) {
    out Node { kind = Kind.FIELD, id = id, value = value }
}

skill field_grow(id, value) {
    out Node { kind = Kind.FIELD, id = id, value = value, grow = 1 }
}

skill slider(id, level, least, most) {
    out Node { kind = Kind.SLIDER, id = id, level = level, least = least, most = most, grow = 1 }
}
