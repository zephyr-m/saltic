-- measure — мерки узлов JTML для раскладки (registry/libraries/uiengine/jtml): свой размер узла по
-- шрифту qemu (у экрана Acer — natural, его ставит screen/atoms), отступы сторон
-- и место ребёнка поперёк flow.
--
-- sized(node) -> текст TEXT с префиксом шрифта по size (big — «### », huge — «## »);
--     weight и cut рисует только экран Acer (screen/atoms)
-- side(node, index) -> отступ стороны с рамкой: 0 верх, 1 право, 2 низ, 3 лево
-- node_intrinsic_width / node_intrinsic_height / node_height(node) -> пиксели
-- flowing(node) -> дети в раскладке (без at — у тех свободное место)
-- child_main_size(child, flow) -> размер ребёнка вдоль flow
-- cross_place(node, child, start, room) -> [начало, размер] поперёк flow: cross
--     stretch — на всю ширину (заданный размер ребёнка — по центру), иначе
--     свой размер у start, center или end

use core.group
use os.drivers.font
use os.drivers.text_field
use registry.libraries.uiengine.jtml.atom
use registry.libraries.uiengine.jtml.slider

skill sized(node) {
    (node.size == "big") { out "### {node.value}" }
    (node.size == "huge") { out "## {node.value}" }
    out node.value
}

skill side(node, index) {
    (group.count(node.sides) == 4) { out group.get(node.sides, index) + node.border }
    out node.padding + node.border
}

skill flowing(node) {
    @found = []
    drum (node.children) {
        (group.count(beat.at) == 0) { found = group.add(found, beat) }
    }
    out found
}

skill node_intrinsic_width(node) {
    (node.width > 0) { out node.width }
    (node.kind == atom.Kind.TEXT) {
        (node.natural > 0) { out node.natural }
        out font.font_text_width(sized(node))
    }
    (node.kind == atom.Kind.FIELD) { out 0 }
    (node.kind == atom.Kind.SLIDER) { out 0 }
    (atom.holds(node) == yes) {
        (group.count(node.layers) > 0) {
            @widest = 0
            drum (node.layers) {
                @layer_width = node_intrinsic_width(beat)
                (layer_width > widest) { widest = layer_width }
            }
            out widest + side(node, 1) + side(node, 3)
        }
        @width = 0
        @index = 0
        @children = flowing(node)
        @count = group.count(children)
        (node.flow == atom.Flow.ROW) {
            drum (count) {
                width = width + node_intrinsic_width(group.get(children, index))
                (index + 1 < count) { width = width + node.gap }
                index = index + 1
            }
        }
        (node.flow == atom.Flow.COLUMN) {
            drum (count) {
                @child_width = node_intrinsic_width(group.get(children, index))
                (child_width > width) { width = child_width }
                index = index + 1
            }
        }
        out width + side(node, 1) + side(node, 3)
    }
    out 0
}

skill node_intrinsic_height(node) {
    (node.height > 0) { out node.height }
    (node.kind == atom.Kind.TEXT) {
        out font.font_text_height(sized(node))
    }
    (node.kind == atom.Kind.FIELD) { out text_field.TEXT_FIELD_HEIGHT }
    (node.kind == atom.Kind.SLIDER) { out slider.HEIGHT }
    (atom.holds(node) == yes) {
        (group.count(node.layers) > 0) {
            @tallest = 0
            drum (node.layers) {
                @layer_height = node_intrinsic_height(beat)
                (layer_height > tallest) { tallest = layer_height }
            }
            out tallest + side(node, 0) + side(node, 2)
        }
        @height = 0
        @index = 0
        @children = flowing(node)
        @count = group.count(children)
        (node.flow == atom.Flow.COLUMN) {
            drum (count) {
                height = height + node_intrinsic_height(group.get(children, index))
                (index + 1 < count) { height = height + node.gap }
                index = index + 1
            }
        }
        (node.flow == atom.Flow.ROW) {
            drum (count) {
                @child_height = node_intrinsic_height(group.get(children, index))
                (child_height > height) { height = child_height }
                index = index + 1
            }
        }
        out height + side(node, 0) + side(node, 2)
    }
    out 0
}

skill node_height(node) {
    out node_intrinsic_height(node)
}

skill child_main_size(child, flow) {
    (flow == atom.Flow.ROW) { out node_intrinsic_width(child) }
    out node_intrinsic_height(child)
}

skill cross_place(node, child, start, room) {
    @size = room
    (node.flow == atom.Flow.ROW) {
        (child.height > 0) { size = child.height }
        ((node.cross == "stretch") == no) { (child.height == 0) { size = node_intrinsic_height(child) } }
    }
    (node.flow == atom.Flow.COLUMN) {
        (child.width > 0) { size = child.width }
        ((node.cross == "stretch") == no) { (child.width == 0) { size = node_intrinsic_width(child) } }
    }
    (size > room) { size = room }
    @at = start + (room - size) / 2
    (node.cross == "start") { at = start }
    (node.cross == "end") { at = start + room - size }
    out [at, size]
}
