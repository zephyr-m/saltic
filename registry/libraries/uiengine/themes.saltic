-- themes — темы UIEngine, по файлу на тему в папке themes/ (решение автора
-- 18.11.2026): программа выбирает тему одним словом, свой цвет отдельному
-- жителю дать не может. Новая тема — файл здесь и строка в NAMES и named.
--
-- NAMES — имена тем: soft (тёмная, язык вида), light, site, alchemy, armor,
--     forest, cream и cocoa (день и ночь публичного сайта)
-- named(name, screen) -> atoms.Palette темы; нет такой — UnknownTheme

use registry.libraries.uiengine.themes.soft
use registry.libraries.uiengine.themes.light
use registry.libraries.uiengine.themes.site
use registry.libraries.uiengine.themes.alchemy
use registry.libraries.uiengine.themes.armor
use registry.libraries.uiengine.themes.forest
use registry.libraries.uiengine.themes.cream
use registry.libraries.uiengine.themes.cocoa

NAMES = ["soft", "light", "site", "alchemy", "armor", "forest", "cream", "cocoa"]

skill named(name, screen) {
    (name == "soft") { out soft.palette(screen) }
    (name == "light") { out light.palette(screen) }
    (name == "site") { out site.palette(screen) }
    (name == "alchemy") { out alchemy.palette(screen) }
    (name == "armor") { out armor.palette(screen) }
    (name == "forest") { out forest.palette(screen) }
    (name == "cream") { out cream.palette(screen) }
    (name == "cocoa") { out cocoa.palette(screen) }
    out error.UnknownTheme
}
