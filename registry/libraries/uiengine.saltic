-- uiengine — UIEngine Saltic (решение автора 16.11.2026): движок и закрытая
-- библиотека — одно. Движок — атомы JTML (jtml: разбор, раскладка, цели
-- касания, ползунок) и рисовальщик (draw: atoms — атомы на экране, shapes —
-- сглаженные фигуры и тени, typeface — шрифты TTF); библиотека — жители по
-- уровням (library: 1–4, программа — уровень 5, зовёт их через jtml.calls).
-- Этот файл — вход для программы: страница текстом JTML → на экран.
--
-- mount(screen, source, palette) -> runtime: страница source (жители
--     разворачиваются, тексты меряются шрифтами палитры) на screen
-- draw(screen, runtime, palette) — нарисовать; hit(runtime, x, y) -> jtml.Hit —
--     что под точкой (по id)

use registry.libraries.uiengine.jtml
use registry.libraries.uiengine.jtml.read
use registry.libraries.uiengine.draw.atoms

skill mount(screen, source, palette) {
    out jtml.mount(screen, atoms.fitted(read.page(source), no, palette))
}

skill draw(screen, runtime, palette) {
    out atoms.draw(screen, runtime, palette)
}

skill hit(runtime, x, y) {
    out jtml.hit(runtime, x, y)
}
