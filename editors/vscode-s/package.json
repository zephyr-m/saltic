{
  "name": "s-language",
  "displayName": "S Language",
  "description": "Syntax highlighting and file icons for the S language.",
  "version": "0.1.4",
  "publisher": "s-language",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icons/icon.svg",
  "contributes": {
    "languages": [
      {
        "id": "s",
        "aliases": [
          "S",
          "s"
        ],
        "extensions": [
          ".s"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/icon.svg",
          "dark": "./icons/icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "s",
        "scopeName": "source.s",
        "path": "./syntaxes/s.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "s-language-icons",
        "label": "S Language Icons",
        "path": "./icons/s-icon-theme.json"
      }
    ]
  }
}
