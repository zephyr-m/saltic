{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "S",
  "scopeName": "source.s",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#notes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#enumValues"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.s",
          "match": "//.*$"
        },
        {
          "name": "comment.block.s",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.s",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.s",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "notes": {
      "patterns": [
        {
          "name": "comment.block.note.s",
          "begin": "\\B(@note)\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.note.s"
            },
            "2": {
              "name": "punctuation.section.block.begin.s"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.s"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.s",
          "match": "\\b(skill|out|drum|stop|rescue|try|use)\\b"
        },
        {
          "name": "keyword.declaration.s",
          "match": "\\b(enum|union|Box)\\b"
        },
        {
          "name": "constant.language.s",
          "match": "\\b(none|error)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.declaration.s",
          "match": "\\b(skill)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.skill.s"
            },
            "2": {
              "name": "entity.name.function.s"
            }
          }
        },
        {
          "name": "meta.import.s",
          "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.s"
            },
            "2": {
              "name": "entity.name.namespace.s"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.s",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.s",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|str)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.call.s",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "support.function.core.s",
          "match": "\\bstd(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b"
        },
        {
          "name": "support.function.core.s",
          "match": "\\bcore(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b"
        }
      ]
    },
    "enumValues": {
      "patterns": [
        {
          "name": "constant.other.enum.s",
          "match": "\\.[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.s",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.s",
          "match": "=>|==|!=|<=|>=|\\+=|-=|\\*=|/=|[=+\\-*/<>]"
        },
        {
          "name": "punctuation.definition.variable.s",
          "match": "@(?=[A-Za-z_])"
        },
        {
          "name": "punctuation.separator.pipe.s",
          "match": "\\|"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.s",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
