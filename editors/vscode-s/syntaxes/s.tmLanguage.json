{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "S",
  "scopeName": "source.saltic",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#notes"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#enumValues"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.saltic",
          "match": "//.*$"
        },
        {
          "name": "comment.block.saltic",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.saltic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.saltic",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "notes": {
      "patterns": [
        {
          "name": "comment.block.note.saltic",
          "begin": "\\B(@note)\\s*(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.note.saltic"
            },
            "2": {
              "name": "punctuation.section.block.begin.saltic"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.saltic"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.saltic",
          "match": "\\b(skill|out|drum|stop|rescue|try|use)\\b"
        },
        {
          "name": "keyword.declaration.saltic",
          "match": "\\b(enum|union|Box)\\b"
        },
        {
          "name": "constant.language.saltic",
          "match": "\\b(none|error)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.declaration.saltic",
          "match": "\\b(skill)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.skill.saltic"
            },
            "2": {
              "name": "entity.name.function.saltic"
            }
          }
        },
        {
          "name": "meta.import.saltic",
          "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.saltic"
            },
            "2": {
              "name": "entity.name.namespace.saltic"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.saltic",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.saltic",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|str)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.call.saltic",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "support.function.core.saltic",
          "match": "\\bstd(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b"
        },
        {
          "name": "support.function.core.saltic",
          "match": "\\bcore(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b"
        }
      ]
    },
    "enumValues": {
      "patterns": [
        {
          "name": "constant.other.enum.saltic",
          "match": "\\.[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.saltic",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.saltic",
          "match": "=>|==|!=|<=|>=|\\+=|-=|\\*=|/=|[=+\\-*/<>]"
        },
        {
          "name": "punctuation.definition.variable.saltic",
          "match": "@(?=[A-Za-z_])"
        },
        {
          "name": "punctuation.separator.pipe.saltic",
          "match": "\\|"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.saltic",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
