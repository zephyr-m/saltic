{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Saltic",
  "scopeName": "source.saltic",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#rescueParameters"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#languageConstants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#enumMembers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.saltic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.saltic",
              "match": "\\\\(?:[nt\"\\\\]|.)"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.saltic",
          "match": "\\b(out|drum|rescue)\\b"
        },
        {
          "name": "keyword.declaration.saltic",
          "match": "\\b(skill|program|use|Box|enum)\\b"
        }
      ]
    },
    "languageConstants": {
      "patterns": [
        {
          "name": "constant.language.answer.saltic",
          "match": "\\b(yes|no)\\b"
        },
        {
          "name": "constant.language.none.saltic",
          "match": "\\bnone\\b"
        },
        {
          "name": "support.type.error.saltic",
          "match": "\\berror\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.declaration.saltic",
          "match": "\\b(skill)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.skill.saltic"
            },
            "2": {
              "name": "entity.name.function.saltic"
            }
          }
        },
        {
          "name": "meta.import.saltic",
          "match": "\\b(use)\\s+([\\p{L}_][\\p{L}\\p{N}_]*(?:\\.[\\p{L}_][\\p{L}\\p{N}_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.saltic"
            },
            "2": {
              "name": "entity.name.namespace.saltic"
            }
          }
        },
        {
          "name": "meta.type.box.declaration.saltic",
          "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(=)\\s*(Box)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.box.saltic"
            },
            "2": {
              "name": "keyword.operator.assignment.saltic"
            },
            "3": {
              "name": "keyword.declaration.box.saltic"
            }
          }
        },
        {
          "name": "meta.type.enum.declaration.saltic",
          "match": "\\b([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(=)\\s*(enum)\\b",
          "captures": {
            "1": {
              "name": "entity.name.type.enum.saltic"
            },
            "2": {
              "name": "keyword.operator.assignment.saltic"
            },
            "3": {
              "name": "keyword.declaration.enum.saltic"
            }
          }
        }
      ]
    },
    "rescueParameters": {
      "patterns": [
        {
          "name": "meta.rescue.parameter.saltic",
          "match": "(\\|)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(\\|)",
          "captures": {
            "1": {
              "name": "punctuation.definition.parameters.begin.saltic"
            },
            "2": {
              "name": "variable.parameter.saltic"
            },
            "3": {
              "name": "punctuation.definition.parameters.end.saltic"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "variable.other.constant.saltic",
          "match": "\\b[\\p{Lu}][\\p{L}\\p{N}_]*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.saltic",
          "match": "\\b(u8|u16|u32|i32|usize|bits32|address)\\b"
        },
        {
          "name": "entity.name.type.saltic",
          "match": "\\b[\\p{Lu}][\\p{L}\\p{N}_]*(?=\\s*[({])"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function-call.qualified.saltic",
          "match": "\\b((?:[\\p{L}_][\\p{L}\\p{N}_]*\\.)+)([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.namespace.saltic"
            },
            "2": {
              "name": "entity.name.function.call.saltic"
            }
          }
        },
        {
          "name": "entity.name.function.call.saltic",
          "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
        }
      ]
    },
    "enumMembers": {
      "patterns": [
        {
          "name": "constant.other.enum.saltic",
          "match": "(?<=\\.)[\\p{Lu}][\\p{L}\\p{N}_]*\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.saltic",
          "match": "(?<=\\.)[\\p{Ll}_][\\p{L}\\p{N}_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.saltic",
          "match": "(?<![\\p{L}\\p{N}_])\\d+(?:\\.\\d+)?(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.saltic",
          "match": "=>|==|[=+\\-*/<>]"
        },
        {
          "name": "punctuation.separator.pipe.saltic",
          "match": "\\|"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "punctuation.definition.variable.saltic",
          "match": "@[\\p{L}_][\\p{L}\\p{N}_]*"
        },
        {
          "name": "variable.other.saltic",
          "match": "\\b[\\p{Ll}_][\\p{L}\\p{N}_]*\\b"
        }
      ]
    }
  }
}
